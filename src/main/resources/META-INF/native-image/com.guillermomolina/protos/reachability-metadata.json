{
  "reflection": [
    {
      "type": {
        "proxy": [
          "org.eclipse.lsp4j.services.LanguageClient",
          "org.eclipse.lsp4j.jsonrpc.Endpoint"
        ]
      }
    }
  ],
  "foreign": {
    "downcalls": [
      {"returnType": "void*", "parameterTypes": ["void*", "void*", "void*", "void*", "void*"]},
      {"returnType": "jint", "parameterTypes": ["void*", "void*"]},
      {"returnType": "jint", "parameterTypes": ["void*", "jint"]},
      {"returnType": "jlong", "parameterTypes": ["void*", "jint", "void*", "jlong"]},
      {"returnType": "jlong", "parameterTypes": ["void*", "void*", "jlong"]},
      {"returnType": "jint", "parameterTypes": ["void*"]},
      {"returnType": "jint", "parameterTypes": ["jint"]},
      {
        "returnType": "jlong",
        "parameterTypes": ["jlong", "jlong", "jlong", "jlong", "jlong", "jlong", "jlong"],
        "options": {
          "firstVariadicArg": 1,
          "captureCallState": true
        }
      }
    ]
  },
  "resources": [
    {"glob": "META-INF/protos/native/**"},
    {
      "glob": "com/ibm/icu/ICUConfig.properties"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/*.icu"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/nfc.nrm"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/nfkc.nrm"
    }
  ]
}
