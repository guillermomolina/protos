{
  "reflection": [
    {
      "type": {
        "proxy": [
          "org.eclipse.lsp4j.services.LanguageClient",
          "org.eclipse.lsp4j.jsonrpc.Endpoint"
        ]
      }
    }
  ],
  "foreign": {
    "downcalls": [
      {
        "returnType": "jlong",
        "parameterTypes": ["jlong", "jlong", "jlong", "jlong", "jlong", "jlong", "jlong"],
        "options": {
          "firstVariadicArg": 1,
          "captureCallState": true
        }
      }
    ]
  },
  "resources": [
    {
      "glob": "com/ibm/icu/ICUConfig.properties"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/*.icu"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/nfc.nrm"
    },
    {
      "glob": "com/ibm/icu/impl/data/icudata/nfkc.nrm"
    }
  ]
}
