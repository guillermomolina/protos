hits: 0
handle: (request) => {
    hits = hits + 1
    status: 404
    body: "module-reference-missing"
    if(Encoding.Latin1.decode(request.target) == "/") {
        status = 200
        body = "module-reference-ok"
    }
    response: {
        status: status
        headers: [["Content-Type", Encoding.Latin1.encode("text/plain")]]
        body: Encoding.UTF8.encode(body)
    }
    response
}

this.handle: handle

this.make: (initialization) => {
    label: initialization.label
    if(label != "module-reference") {
        Error().signal()
    }
    (request) => handle(request)
}
