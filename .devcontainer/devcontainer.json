{
  "name": "Protos Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/protos,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/protos",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/graalvm-community-java25"
      }
    }
  },
  "runArgs": [
    "--userns=host"
  ]
}
