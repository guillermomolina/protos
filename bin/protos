#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JAR=$(find "$ROOT/target" -maxdepth 1 -type f -name 'protos-*.jar' ! -name 'original-*' | sort | tail -n 1)
[ -n "${JAR:-}" ] || { echo "protos: built jar not found; run 'mvn package' in $ROOT" >&2; exit 1; }
cd "$ROOT"; exec java --enable-native-access=ALL-UNNAMED -jar "$JAR" "$@"
