#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${PROTOS_JAVA:-}" ]; then
    JAVA_BIN=$PROTOS_JAVA
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_BIN=$JAVA_HOME/bin/java
else
    JAVA_BIN=java
fi

if [ -f "$ROOT/lib/protos.jar" ]; then
    MODE=distribution
    JAR=$ROOT/lib/protos.jar
else
    MODE=checkout

    POM_PROPERTIES=$ROOT/target/maven-archiver/pom.properties
    [ -f "$POM_PROPERTIES" ] || {
        echo "protos: Maven build metadata not found; run 'mvn package' in $ROOT" >&2
        exit 1
    }

    artifact_id=$(sed -n 's/^artifactId=//p' "$POM_PROPERTIES" | head -n 1)
    version=$(sed -n 's/^version=//p' "$POM_PROPERTIES" | head -n 1)

    [ -n "$artifact_id" ] && [ -n "$version" ] || {
        echo "protos: incomplete Maven build metadata: $POM_PROPERTIES" >&2
        exit 1
    }

    JAR=$ROOT/target/$artifact_id-$version.jar
    [ -f "$JAR" ] || {
        echo "protos: expected built jar not found: $JAR; run 'mvn package' in $ROOT" >&2
        exit 1
    }
fi

PROTOS_HOME=$ROOT
export PROTOS_HOME

if [ "$MODE" = distribution ]; then
    RUNTIME_META=$ROOT/RUNTIME.txt
    [ -f "$RUNTIME_META" ] || {
        echo "protos: distribution runtime metadata is missing: $RUNTIME_META" >&2
        exit 1
    }

    expected_feature=$(sed -n 's/^java_feature=//p' "$RUNTIME_META")
    expected_version=$(sed -n 's/^java_version=//p' "$RUNTIME_META")
    expected_vendor=$(sed -n 's/^java_vendor_contains=//p' "$RUNTIME_META")
    [ -n "$expected_feature" ] && [ -n "$expected_version" ] && [ -n "$expected_vendor" ] || {
        echo "protos: incomplete distribution runtime metadata" >&2
        exit 1
    }

    runtime_properties=$("$JAVA_BIN" -XshowSettings:properties -version 2>&1) || {
        echo "protos: cannot execute Java runtime: $JAVA_BIN" >&2
        exit 1
    }
    actual_feature=$(printf '%s\n' "$runtime_properties" | sed -n 's/^[[:space:]]*java\.specification\.version = //p' | head -n 1)
    actual_version=$(printf '%s\n' "$runtime_properties" | sed -n 's/^[[:space:]]*java\.version = //p' | head -n 1)
    actual_vendor=$(printf '%s\n' "$runtime_properties" | sed -n 's/^[[:space:]]*java\.vendor = //p' | head -n 1)
    actual_vendor_version=$(printf '%s\n' "$runtime_properties" | sed -n 's/^[[:space:]]*java\.vendor\.version = //p' | head -n 1)

    supported=1
    [ "$actual_feature" = "$expected_feature" ] || supported=0
    [ "$actual_version" = "$expected_version" ] || supported=0
    printf '%s\n%s\n' "$actual_vendor" "$actual_vendor_version" | grep -Fqi "$expected_vendor" || supported=0

    if [ "$supported" -ne 1 ]; then
        if [ "${PROTOS_ALLOW_UNSUPPORTED_RUNTIME:-0}" = 1 ]; then
            echo "protos: WARNING: unsupported runtime override enabled" >&2
            echo "protos: expected Java $expected_feature ($expected_version) / vendor containing '$expected_vendor'" >&2
            echo "protos: actual Java ${actual_feature:-unknown} (${actual_version:-unknown}) / ${actual_vendor:-unknown} ${actual_vendor_version:-}" >&2
        else
            echo "protos: unsupported runtime" >&2
            echo "protos: expected Java $expected_feature ($expected_version) / vendor containing '$expected_vendor'" >&2
            echo "protos: actual Java ${actual_feature:-unknown} (${actual_version:-unknown}) / ${actual_vendor:-unknown} ${actual_vendor_version:-}" >&2
            echo "protos: see RUNTIME.txt; PROTOS_ALLOW_UNSUPPORTED_RUNTIME=1 is an unsupported override" >&2
            exit 1
        fi
    fi

    exec "$JAVA_BIN" --enable-native-access=ALL-UNNAMED \
        -cp "$JAR:$ROOT/lib/runtime/*" \
        com.guillermomolina.protos.cli.ProtosCli "$@"
fi

RUNTIME_DIR=$ROOT/target/runtime
[ -d "$RUNTIME_DIR" ] || {
    echo "protos: checkout runtime plane is missing; run 'mvn package' in $ROOT" >&2
    exit 1
}

runtime_count=$(find "$RUNTIME_DIR" -maxdepth 1 -type f -name '*truffle-runtime-*.jar' | wc -l | tr -d '[:space:]')
compiler_count=$(find "$RUNTIME_DIR" -maxdepth 1 -type f -name '*truffle-compiler-*.jar' | wc -l | tr -d '[:space:]')
[ "$runtime_count" = 1 ] || {
    echo "protos: checkout runtime plane must contain exactly one Truffle runtime jar; run 'mvn package' in $ROOT" >&2
    exit 1
}
[ "$compiler_count" = 1 ] || {
    echo "protos: checkout runtime plane must contain exactly one Truffle compiler jar; run 'mvn package' in $ROOT" >&2
    exit 1
}

exec "$JAVA_BIN" --enable-native-access=ALL-UNNAMED \
    -cp "$JAR:$RUNTIME_DIR/*" \
    com.guillermomolina.protos.cli.ProtosCli "$@"
