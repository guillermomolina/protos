<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.guillermomolina</groupId>
    <artifactId>protos</artifactId>
    <version>0.4.198-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Protos</name>
    <description>Initial Maven project structure for the Protos language implementation.</description>

    <licenses>
        <license>
            <name>Adaptive Public License 1.0</name>
            <url>https://opensource.org/license/apl-1-0</url>
            <distribution>repo</distribution>
            <comments>SPDX identifier: APL-1.0. The complete Protos-specific license, including the completed Exhibit A, is in LICENSE.TXT at the repository root.</comments>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <graalvm.version>25.5.5.0.3</graalvm.version>
        <lsp4j.version>1.0.0</lsp4j.version>
        <protos.shade.skip>false</protos.shade.skip>
        <!-- TEST008: the slow-test confirmation run reports separately. -->
        <protos.surefire.reports>${project.build.directory}/surefire-reports</protos.surefire.reports>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.30.6</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>78.1</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <!-- PERF006-C1 / PLAT033: optimizer runtime is present for Maven/Surefire
             but remains external to the shaded Protos application JAR. -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graalvm.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- LM009-D: real GraalVM DAP instrument, activated only by a debug RuntimeHost. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>dap</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>runtime</scope>
        </dependency>
        <!-- LM009-F3: standard LSP protocol/stdio host; loaded only by language-server use. -->
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${lsp4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow</argLine>
                    <reportsDirectory>${protos.surefire.reports}</reportsDirectory>
                    <systemPropertyVariables>
                        <!-- Unpack Truffle internal resources (packaged Core) below target,
                             not into the user's home cache. -->
                        <polyglot.engine.userResourceCache>${project.build.directory}/polyglot-resource-cache</polyglot.engine.userResourceCache>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.graalvm.truffle</groupId>
                            <artifactId>truffle-dsl-processor</artifactId>
                            <version>${graalvm.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <!-- Test sources declare no Truffle DSL elements, so the
                         processor has nothing to generate for them. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-license</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>LICENSE.TXT</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!--
                        Shade post-processes the main JAR in ordinary JVM builds.
                        Always recreate the thin JAR first so repeated package
                        invocations cannot feed a previously shaded JAR back
                        into Shade or Native Image.
                    -->
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest>
                            <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- PERF006-C2 / PLAT033: target/runtime is a generated projection of the
                 Graal/Truffle/Polyglot roots already declared by this root POM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <!-- PLAT054-3C: package protos/lib as the Truffle internal resource
                         ProtosCoreResource (file list + content hash), so a standard
                         Polyglot embedding needs no protos.CoreRoot or language home. -->
                    <execution>
                        <id>package-core-internal-resource</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="core.resource.root" value="${project.build.outputDirectory}/META-INF/resources/protos/core"/>
                                <property name="core.resource.checksums" value="${project.build.directory}/core-resource-checksums"/>
                                <delete dir="${core.resource.root}" quiet="true"/>
                                <delete dir="${core.resource.checksums}" quiet="true"/>
                                <copy todir="${core.resource.root}/lib">
                                    <fileset dir="${project.basedir}/protos/lib"/>
                                </copy>
                                <pathconvert property="core.resource.files" pathsep="&#10;" dirsep="/">
                                    <fileset dir="${core.resource.root}" includes="lib/**"/>
                                    <globmapper from="${core.resource.root}/*" to="META-INF/resources/protos/core/*=rw-r--r--" handledirsep="true"/>
                                </pathconvert>
                                <echo file="${core.resource.root}/files" message="${core.resource.files}&#10;"/>
                                <checksum algorithm="SHA-256" todir="${core.resource.checksums}" totalproperty="core.resource.sha256" forceoverwrite="yes">
                                    <fileset dir="${core.resource.root}" includes="lib/**"/>
                                </checksum>
                                <echo file="${core.resource.root}/sha256" message="${core.resource.sha256}&#10;"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>reset-canonical-graal-runtime-plane</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/runtime" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>materialize-canonical-graal-runtime-plane</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <graphRoots>
                                <graphRoot>
                                    <groupId>org.graalvm.sdk</groupId>
                                    <artifactId>graal-sdk</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.polyglot</groupId>
                                    <artifactId>polyglot</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.truffle</groupId>
                                    <artifactId>truffle-api</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.truffle</groupId>
                                    <artifactId>truffle-runtime</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.polyglot</groupId>
                                    <artifactId>dap</artifactId>
                                </graphRoot>
                            </graphRoots>
                            <includeTypes>jar</includeTypes>
                            <outputDirectory>${project.build.directory}/runtime</outputDirectory>
                            <prependGroupId>true</prependGroupId>
                            <stripVersion>false</stripVersion>
                            <useBaseVersion>true</useBaseVersion>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <skip>${protos.shade.skip}</skip>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- The complete Graal-owned runtime/tool plane is external. -->
                                    <exclude>org.graalvm.*:*</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*:*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <profile>
            <id>linux-posix-process</id>
            <activation>
                <os><name>Linux</name></os>
            </activation>
            <properties>
                <protos.native.cc>cc</protos.native.cc>
                <protos.native.make>make</protos.native.make>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-posix-process-provider</id>
                                <phase>process-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <exec executable="${protos.native.make}" dir="${project.basedir}" failonerror="true">
                                            <arg value="build-posix-process-library"/>
                                            <arg value="CC=${protos.native.cc}"/>
                                        </exec>
                                        <mkdir dir="${project.build.outputDirectory}/META-INF/protos/native"/>
                                        <copy file="${project.basedir}/target/native-libs/libprotos_posix_process.so"
                                              todir="${project.build.outputDirectory}/META-INF/protos/native"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <properties>
                <protos.native.classes>${project.build.directory}/native-classes</protos.native.classes>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <!--
                                Native-only classes staging directory: the
                                application classes and resources plus the
                                generic FFM provider compiled from its own
                                sources against the public SPI. target/classes
                                and the portable JAR never contain the
                                provider; only the Native Image consumes this
                                directory.
                            -->
                            <execution>
                                <id>stage-native-image-classes</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${protos.native.classes}" quiet="true"/>
                                        <mkdir dir="${protos.native.classes}"/>
                                        <copy todir="${protos.native.classes}">
                                            <fileset dir="${project.build.outputDirectory}"/>
                                        </copy>
                                        <javac srcdir="${project.basedir}/providers/ffm/src/main/java"
                                               destdir="${protos.native.classes}"
                                               release="25"
                                               encoding="UTF-8"
                                               includeantruntime="false"
                                               failonerror="true">
                                            <classpath>
                                                <pathelement location="${project.build.outputDirectory}"/>
                                                <path refid="maven.compile.classpath"/>
                                            </classpath>
                                            <compilerarg value="-proc:none"/>
                                        </javac>
                                        <copy todir="${protos.native.classes}/META-INF/services">
                                            <fileset dir="${project.basedir}/providers/ffm/src/main/resources/META-INF/services"
                                                     includes="com.guillermomolina.protos.spi.foreign.ProtosForeignProviderPlugin"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-native-image-init-args</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="bash" failonerror="true">
                                            <arg value="${project.basedir}/scripts/native-generate-init-args.sh"/>
                                            <arg value="${protos.native.classes}"/>
                                            <arg value="${project.build.directory}/native-image-init.args"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.14</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-stage1-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                            <imageName>protos</imageName>
                            <outputDirectory>${project.build.directory}/native</outputDirectory>
                            <!--
                                Native Image consumes the Native-only staged
                                classes (application classes, resources and the
                                generic FFM provider) plus the resolved
                                dependency graph directly. Keep the ordinary
                                shaded checkout JAR intact.
                            -->
                            <classesDirectory>${protos.native.classes}</classesDirectory>
                            <!--
                                Native guest execution keeps the optimizing
                                Truffle runtime; implementation packages are
                                initialized at build time by native-image-init.args.
                            -->
                            <buildArgs>
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>@${project.build.directory}/native-image-init.args</buildArg>
                                <!--
                                    I156 / PLAT073-C: the confined Filesystem grant
                                    calls libc syscall through Java FFM downcalls
                                    registered in reachability-metadata.json
                                    (foreign.downcalls). FFM is enabled by
                                    default in GraalVM 25. No JNI library or C
                                    compilation step is involved.
                                -->
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <!--
                                    The captured-tree filesystem backend owns a
                                    static java.lang.ref.Cleaner, which must not
                                    be stored in the image heap.
                                -->
                                <buildArg>--initialize-at-run-time=com.guillermomolina.protos.execution.ProtosNioCapturedTreeFilesystemBackend</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Global Native Image runtime-compilation analysis. Activate only
            together with the native profile (-Pnative,native-analysis): it
            reuses that profile's execution, classpath, reachability metadata,
            class initialization and optimizing runtime, appends the analysis
            options to its buildArgs, stops after the points-to analysis and
            writes into a separate output directory; no executable is produced.
            -TruffleCheckBlockListMethods keeps GraalVM from aborting on the
            blocklist check; with +PrintRuntimeCompileMethods GraalVM still
            enumerates every blocklist violation. neverPartOfCompilation stays
            checked (strict inventory) and tools/native_runtime_compilation_gate.py
            fails on any violation of either category.
        -->
        <profile>
            <id>native-analysis</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <imageName>protos-native-analysis</imageName>
                            <outputDirectory>${project.build.directory}/native-analysis/image</outputDirectory>
                            <buildArgs combine.children="append">
                                <buildArg>-H:+ReturnAfterAnalysis</buildArg>
                                <buildArg>-H:-TruffleCheckBlockListMethods</buildArg>
                                <buildArg>-H:+PrintRuntimeCompileMethods</buildArg>
                                <buildArg>-H:+PrintRuntimeCompilationCallTree</buildArg>
                                <buildArg>-H:+TruffleCheckNeverPartOfCompilation</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Diagnostic graph phase of the runtime-compilation analysis.
            Activate only together with both previous profiles
            (-Pnative,native-analysis,native-analysis-graph). It appends
            -TruffleCheckNeverPartOfCompilation after native-analysis's
            +TruffleCheckNeverPartOfCompilation (the later option wins) so the
            analysis completes and prints the full call tree. Used only when
            the strict phase was stopped by neverPartOfCompilation violations;
            violation results always come from the strict phase.
        -->
        <profile>
            <id>native-analysis-graph</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <imageName>protos-native-analysis-graph</imageName>
                            <outputDirectory>${project.build.directory}/native-analysis/graph-image</outputDirectory>
                            <buildArgs combine.children="append">
                                <buildArg>-H:-TruffleCheckNeverPartOfCompilation</buildArg>
                                <!-- Assertions only for jdk.graal.compiler.debug.Assertions:
                                     MethodTypeFlow.sealFlowsGraph() keeps the seal stack
                                     trace when Assertions.assertionsEnabled() is true. -->
                                <buildArg>-J-ea:jdk.graal.compiler.debug.Assertions</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            I130-C2: compile the selected JUnit classes (-Dtest=...) into a
            separate Native Image test executable and run it. Never part of
            target/native/protos; test-only resources stay in the test image.
        -->
        <profile>
            <id>native-tls-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-native-tls-tests-init-args</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!-- The native test goal reads the JUnit unique IDs that
                                             Surefire writes here; a previous run's selection must
                                             never reach this image. -->
                                        <delete dir="${project.build.directory}/maven-surefire-plugin-test-ids" quiet="true"/>
                                        <exec executable="bash" failonerror="true">
                                            <arg value="${project.basedir}/scripts/native-generate-init-args.sh"/>
                                            <arg value="${project.build.outputDirectory}"/>
                                            <arg value="${project.build.directory}/native-image-init.args"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Profile-local selection: exactly the two TLS classes, independent of
                             any -Dtest on the command line. Merged into the global Surefire
                             configuration, whose argLine, reports directory and system
                             properties are kept. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/ProtosTlsClientIntegrationTest.java</include>
                                <include>**/ProtosTlsTrustTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.14</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>native-tls-tests</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <buildArgs>
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>@${project.build.directory}/native-image-init.args</buildArg>
                                <!-- Test-only owner of the shared entered Polyglot context. Its
                                     static initializer opens an Engine/Context, which must never
                                     run in the image builder (it would retain the builder's
                                     thread through Engine.ENGINES). Production policy unchanged. -->
                                <buildArg>--initialize-at-run-time=com.guillermomolina.protos.execution.ProtosTestExecutionSupport</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
