//! Explicit-input evidence runner. The caller owns document acquisition,
//! revision identity, measurement, warmup, CPU and allocation observations.
Markdown: import("std:markdown")

run: (documents, revision) => {
    String.recognizes(revision).ifFalse(() => { Error().signal() })
    count: 0
    scalars: 0
    largest: 0
    parses: 0
    for(document in documents) {
        String.recognizes(document.source).ifFalse(() => { Error().signal() })
        count = count + 1
        scalars = scalars + document.source.size()
        octets: Encoding.UTF8.encode(document.source).size()
        if(octets > largest) { largest = octets }
        for(profile in ["commonmark-0.31.2", "commonmark-0.31.2-gfm-extensions"]) {
            for(positions in [false, true]) {
                tree: Markdown.parse(document.source, profile: profile, positions: positions)
                (tree.kind == "document").ifFalse(() => { Error().signal() })
                parses = parses + 1
            }
        }
    }
    { revision: revision; documents: count; scalars: scalars; largestBytes: largest; parses: parses
      matchesBaselineDimensions: (count == 90) && (largest == 259013) }
}
