first: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
second: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
third: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
fourth: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
fifth: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
sixth: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
seventh: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)
eighth: Actor.spawn("std:collections/Set", "call", 1, 2, 3, 4)

Future.all(
    first.request("size"),
    second.request("size"),
    third.request("size"),
    fourth.request("size"),
    fifth.request("size"),
    sixth.request("size"),
    seventh.request("size"),
    eighth.request("size")
).value()

run: () => {
    total: 0
    batch: 0
    (() => { batch < 128 }).while() {
        values: Future.all(
            first.request("size"),
            second.request("size"),
            third.request("size"),
            fourth.request("size"),
            fifth.request("size"),
            sixth.request("size"),
            seventh.request("size"),
            eighth.request("size")
        ).value()
        values.each((value) => {
            total = total + value
        })
        batch = batch + 1
    }
    total
}

run()
