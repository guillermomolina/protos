work: (seed, count) => {
    result: seed
    round: 0
    (() => { round < count }).while() {
        result = (result * 7 + 11).mod(1000003)
        round = round + 1
    }
    result
}

run: () => {
    total: 0
    iteration: 0
    (() => { iteration < 100 }).while() {
        total = total + work.parallel(17, 64).value()
        iteration = iteration + 1
    }
    total
}

run()
