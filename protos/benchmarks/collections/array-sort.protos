repeat: (count, operation) => {
    (count > 0).ifTrue() {
        operation()
        repeat(count - 1, operation)
    }
}

Arrays: import("std:collections/Array")
source: Array(
    17, 4, 29, 8, 1, 24, 12, 31,
    6, 20, 15, 3, 27, 10, 32, 14,
    22, 7, 18, 25, 2, 30, 11, 16,
    28, 5, 21, 9, 26, 13, 23, 19
)
result: Array()

repeat(100, () => {
    result = Arrays.sort(source, (left, right) => { left < right })
})

result[0] + (result[15] * 100) + (result[31] * 10000)
