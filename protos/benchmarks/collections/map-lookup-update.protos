repeat: (count, operation) => {
    (count > 0).ifTrue() {
        operation()
        repeat(count - 1, operation)
    }
}

values: Map()
values[1] = 10
values[2] = 20
values[3] = 30
values[4] = 40
values[5] = 50
values[6] = 60
values[7] = 70
values[8] = 80
values[9] = 90
values[10] = 100
values[11] = 110
values[12] = 120
values[13] = 130
values[14] = 140
values[15] = 150
values[16] = 160

sink: 0
repeat(1000, () => {
    values[8] = values[8] + 1
    sink = values[1] + values[8] + values[16]
})

sink
