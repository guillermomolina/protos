//! SQLite C ABI declarations. Source dependency of std:sqlite; not its public API.
FFI: import("std:ffi")
sqlite: import("ffi:sqlite3")
Borrowed: import("./internal/Borrowed.protos")

SQLITE_OK: 0
SQLITE_ROW: 100
SQLITE_DONE: 101
SQLITE_INTEGER: 1
SQLITE_FLOAT: 2
SQLITE_TEXT: 3
SQLITE_BLOB: 4
SQLITE_NULL: 5
SQLITE_OPEN_READONLY: 1
SQLITE_OPEN_READWRITE: 2
SQLITE_OPEN_CREATE: 4
SQLITE_OPEN_MEMORY: 128

database: FFI.opaque(sqlite, "sqlite3")
statement: FFI.opaque(sqlite, "sqlite3_stmt")
ownedDatabase: FFI.owned(database, "sqlite3_close_v2", FFI.i32)
ownedStatement: FFI.owned(statement, "sqlite3_finalize", FFI.i32)
// These private types have no producers: only null can be supplied. pzTail
// is passed as NULL, never retained or read after utf8z call storage expires.
vfs: FFI.nullable(FFI.opaque(sqlite, "sqlite3_vfs_name"))
tail: FFI.nullable(FFI.opaque(sqlite, "sqlite3_sql_tail"))
bind: (symbol, returns, parameters) => FFI.bind(sqlite, symbol, returns, parameters)
libversion: bind("sqlite3_libversion_number", FFI.i32, Array())
open: bind("sqlite3_open_v2", FFI.i32, Array(FFI.utf8z, FFI.out(ownedDatabase), FFI.i32, vfs))
prepare: bind("sqlite3_prepare_v2", FFI.i32,
    Array(database, FFI.utf8z, FFI.i32, FFI.out(ownedStatement), tail))
bindInteger: bind("sqlite3_bind_int64", FFI.i32, Array(statement, FFI.i32, FFI.i64))
bindFloat: bind("sqlite3_bind_double", FFI.i32, Array(statement, FFI.i32, FFI.f64))
bindNull: bind("sqlite3_bind_null", FFI.i32, Array(statement, FFI.i32))
step: bind("sqlite3_step", FFI.i32, Array(statement))
columnCount: bind("sqlite3_column_count", FFI.i32, Array(statement))
columnType: bind("sqlite3_column_type", FFI.i32, Array(statement, FFI.i32))
columnInteger: bind("sqlite3_column_int64", FFI.i64, Array(statement, FFI.i32))
columnFloat: bind("sqlite3_column_double", FFI.f64, Array(statement, FFI.i32))
errcode: bind("sqlite3_errcode", FFI.i32, Array(database))
release: (handle) => FFI.release(handle)
// Only independent Bytes cross this adapter boundary, never borrowed regions.
copyColumn: Borrowed.columnReader(sqlite)
// sqlite3_errmsg is intentionally omitted: R1 has no bounded C-string length
// operation. Numeric SQLite statuses supply safe diagnostics without scanning.
