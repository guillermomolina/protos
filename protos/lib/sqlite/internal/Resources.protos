//! SQLite resources and state transitions. All native policy lives here.
Arrays: import("std:collections/array")

// std:sqlite input policy: one TEXT (strict UTF-8 octets) or BLOB value is at
// most 16 MiB, the same bound as the R1 column copy, so every accepted input can
// also be read back by column(). It is checked here, before native entry; the
// generic provider bound is only the C int length domain.
inputLimit: 16777216

// Strict UTF-8 octet length of a String, or an ordinary Error when the String
// is not valid Unicode. The provider re-validates the same encoding.
textLength: (text) => {
    size: null
    Error.handle(() => { size = Encoding.UTF8.encode(text).size() }, (error) => null)
    if(size === null) { Error().signal() }
    size
}

// Argument-domain admission before SQLite. NUL cannot reach utf8z; every other
// character, including semicolons in strings, comments or separating statements,
// is judged by SQLite's own parser in prepare below. Answers the exact octets.
admitSql: (sql) => {
    String.recognizes(sql).ifFalse(() => Error().signal())
    octets: Encoding.UTF8.encode(sql)
    for(octet in octets) {
        if(octet == 0) { Error().signal() }
    }
    octets
}

// The SQL text after the first (size - remaining) octets. SQLite's tail always
// lies on a token boundary, so the suffix is complete UTF-8.
suffix: (octets, remaining) => {
    rest: Encoding.UTF8.encode("")
    position: octets.size() - remaining
    while(position < octets.size()) {
        rest.add(octets[position])
        position = position + 1
    }
    decoded: Encoding.UTF8.decode(rest)
    // The standard decoder consumes an initial BOM; here U+FEFF is SQL source
    // that SQLite must still judge, so restore it after strict validation.
    if(remaining >= 3) {
        if(((rest[0] == 239) && (rest[1] == 187)) && (rest[2] == 191)) {
            decoded = "\u{FEFF}" + decoded
        }
    }
    decoded
}

// Recognizes a standard Bytes value. Latin1 accepts every octet sequence and
// rejects every non-Bytes value, so it is exact Bytes-domain validation.
isBytes: (value) => {
    recognized: false
    Error.handle(() => {
        Encoding.Latin1.decode(value)
        recognized = true
    }, (error) => null)
    recognized
}

// The ABI and terminal-Future facility are injected privately. This also lets
// deterministic Protos fixtures exercise acquisition and destructor failures.
openMemory: (abi, terminal, SQLiteError) => {
    failure: (operation, code) => SQLiteError {
        operation: operation
        code: code
    }
    check: (operation, code) => {
        if(code != abi.SQLITE_OK) { failure(operation, code).signal() }
    }
    // Attempts cleanup without replacing an already established primary error.
    discard: (handle, release) => {
        if(handle !== null) {
            Error.handle(() => release(handle), (error) => null)
        }
    }
    opened: abi.open(":memory:", abi.SQLITE_OPEN_READWRITE + abi.SQLITE_OPEN_CREATE + abi.SQLITE_OPEN_MEMORY, null)
    native: opened[1]
    published: false
    (() => {
        if(opened[0] != abi.SQLITE_OK) {
            primary: failure("open", opened[0])
            primary.signal()
        }
        if(native === null) { failure("open", abi.SQLITE_OK).signal() }

        closing: false
        closeError: null
        children: Array()
        connection: null
        requireOpen: () => {
            if(closing) { IOLifecycleError().signal() }
        }
        observe: (receiver, error) => {
            if(error === null) { terminal.resolved(receiver) } else { terminal.failed(error) }
        }
        retire: (handle, operation, release) => {
            error: null
            Error.handle(
                () => check(operation, release(handle)),
                (caught) => { error = caught }
            )
            error
        }

        prepare: (sql) => {
            requireOpen()
            octets: admitSql(sql)
            // The single native statement found in sql, or null for blank SQL.
            handle: null
            admitted: false
            (() => {
                // SQLite parses one statement per call and reports the unconsumed
                // octets, measured while its input copy is alive. Each remainder is
                // parsed again by SQLite: trailing separators, whitespace and
                // comments yield no statement; a second statement or invalid
                // trailing SQL is rejected, so a prefix never runs silently.
                source: sql
                remaining: octets.size()
                parsing: true
                while(parsing) {
                    prepared: abi.prepare(native, source)
                    if(prepared[1] !== null) {
                        if(handle === null) {
                            handle = prepared[1]
                        } else {
                            // Finalize the extra statement once, then reject the input.
                            // The first statement is finalized by the ensure below.
                            discard(prepared[1], abi.finalize)
                            Error().signal()
                        }
                    }
                    if(prepared[0] != abi.SQLITE_OK) {
                        primary: failure("prepare", prepared[0])
                        primary.signal()
                    }
                    rest: prepared[2]
                    // An unknown or non-advancing tail cannot prove complete admission.
                    if(rest === null) { failure("prepare", abi.SQLITE_OK).signal() }
                    // Strict progress: the remainder must shrink, or already be zero.
                    if((rest < 0) || (rest > remaining) || ((rest == remaining) && (rest > 0))) {
                        failure("prepare", abi.SQLITE_OK).signal()
                    }
                    if(rest == 0) {
                        parsing = false
                    } else {
                        remaining = rest
                        source = suffix(octets, remaining)
                    }
                }
                statement: null
                if(handle !== null) {
                    // State: prepared/reset (all flags false), row available, done
                    // (finished), failed, or permanently closed. Only reset() leaves
                    // done or failed, and only when SQLite confirms SQLITE_OK.
                    closed: false
                    terminalError: null
                    rowAvailable: false
                    finished: false
                    failed: false
                    usable: () => {
                        requireOpen()
                        if(closed) { IOLifecycleError().signal() }
                    }
                    close: () => {
                        if((!closed && !closing) && !terminal.closeAllowed()) {
                            terminal.failed(IOLifecycleError())
                        } else {
                            if(!closed) {
                                // Cutover and retirement precede the native release, which may
                                // fail after retiring the provider token. Never retry it.
                                closed = true
                                rowAvailable = false
                                retired: handle
                                handle = null
                                terminalError = retire(retired, "finalize", abi.finalize)
                                // Unregistration may fail independently; it must never prevent
                                // native finalization or replace an earlier release failure.
                                Error.handle(
                                    () => { children = Arrays.filter(children, (child) => child !== close) },
                                    (error) => {
                                        if(terminalError === null) { terminalError = error }
                                    }
                                )
                            }
                            observe(statement, terminalError)
                        }
                    }
                    bind: (index, value) => {
                        usable()
                        // SQLite accepts bindings only before the first step or after reset.
                        if(finished || failed || rowAvailable) { Error().signal() }
                        Integer.recognizes(index).ifFalse(() => Error().signal())
                        if((index < 1) || (index > 2147483647)) { Error().signal() }
                        code: null
                        if(value === null) { code = abi.bindNull(handle, index) }
                        if(Integer.recognizes(value)) {
                            if((value < -9223372036854775808) || (value > 9223372036854775807)) {
                                Error().signal()
                            }
                            code = abi.bindInteger(handle, index, value)
                        }
                        if(Float.recognizes(value)) { code = abi.bindFloat(handle, index, value) }
                        if(String.recognizes(value)) {
                            // Interior NUL is data; only the octet bound is policy here.
                            if(textLength(value) > inputLimit) { Error().signal() }
                            code = abi.bindText(handle, index, value)
                        }
                        if(code === null) {
                            if(!isBytes(value)) { Error().signal() }
                            if(value.size() > inputLimit) { Error().signal() }
                            code = abi.bindBlob(handle, index, value)
                        }
                        check("bind", code)
                        statement
                    }
                    // These helpers are also invoked as lexical blocks by each/row.
                    // They must not use ^: their captured prepare return home has ended.
                    step: () => {
                        usable()
                        rowAvailable = false
                        if(failed) { Error().signal() }
                        if(!finished) {
                            // An entered provider failure may leave an uncertain execution
                            // position; do not permit another step to replay that work.
                            failed = true
                            code: abi.step(handle)
                            if(code == abi.SQLITE_ROW) {
                                failed = false
                                rowAvailable = true
                            }
                            if(code == abi.SQLITE_DONE) {
                                failed = false
                                finished = true
                            }
                            if(failed) { failure("step", code).signal() }
                        }
                        rowAvailable
                    }
                    reset: () => {
                        usable()
                        // The current row is invalid from here on, whatever the outcome.
                        rowAvailable = false
                        // Until SQLite confirms SQLITE_OK the statement is not reusable;
                        // an entered provider failure therefore also leaves it failed.
                        failed = true
                        code: abi.reset(handle)
                        if(code != abi.SQLITE_OK) { failure("reset", code).signal() }
                        failed = false
                        finished = false
                        statement
                    }
                    clearBindings: () => {
                        usable()
                        check("clearBindings", abi.clearBindings(handle))
                        statement
                    }
                    column: (index) => {
                        usable()
                        if(!rowAvailable) { Error().signal() }
                        Integer.recognizes(index).ifFalse(() => Error().signal())
                        count: abi.columnCount(handle)
                        if((index < 0) || (index >= count)) { Error().signal() }
                        kind: abi.columnType(handle, index)
                        value: null
                        known: false
                        if(kind == abi.SQLITE_INTEGER) {
                            value = abi.columnInteger(handle, index)
                            known = true
                        }
                        if(kind == abi.SQLITE_FLOAT) {
                            value = abi.columnFloat(handle, index)
                            known = true
                        }
                        if(kind == abi.SQLITE_NULL) { known = true }
                        if((kind == abi.SQLITE_TEXT) || (kind == abi.SQLITE_BLOB)) {
                            value = abi.copyColumn(native, handle, index, kind == abi.SQLITE_TEXT,
                                (code) => failure("column", code))
                            known = true
                        }
                        if(!known) { failure("column", kind).signal() }
                        value
                    }
                    row: () => {
                        usable()
                        if(!rowAvailable) { Error().signal() }
                        count: abi.columnCount(handle)
                        result: Array()
                        index: 0
                        while(index < count) {
                            result = Arrays.append(result, column(index))
                            index = index + 1
                        }
                        result
                    }
                    statement = {
                        /// Binds an Integer, Float, String (TEXT), Bytes (BLOB) or null at
                        /// SQLite's one-based index; only before the first step or after reset.
                        bind: bind
                        /// Synchronously advances; true means row, false means done.
                        step: step
                        /// Resets execution, keeping bindings; required to run again.
                        reset: reset
                        /// Replaces every binding with SQL NULL; does not reset or execute.
                        clearBindings: clearBindings
                        /// Copies a zero-based current column into ordinary Protos data.
                        column: column
                        /// Copies all current columns into a fresh ordinary Array.
                        row: row
                        /// Invokes an ordinary callback only after the complete row is copied.
                        each: (callback) => {
                            while(step()) { callback(row()) }
                            statement
                        }
                        /// Retires once; each call answers a fresh terminal standard Future.
                        close: close
                    }
                    children = Arrays.append(children, close)
                    admitted = true
                }
                statement
            }).ensure(() => {
                if(!admitted) { discard(handle, abi.finalize) }
            })
        }
        connection = {
            /// Prepares exactly one SQL statement, optionally terminated by semicolons
            /// and followed by comments; blank/comment SQL yields null.
            prepare: prepare
            /// Closes every child and then the database, preserving the first failure.
            close: () => {
                if(!closing && !terminal.closeAllowed()) {
                    terminal.failed(IOLifecycleError())
                } else {
                    if(!closing) {
                        closing = true
                        // Iterate a snapshot: child close unregisters itself.
                        for(child in Array(...children)) {
                            Error.handle(() => child().value(), (error) => {
                                if(closeError === null) { closeError = error }
                            })
                        }
                        retired: native
                        native = null
                        parentError: retire(retired, "close", abi.release)
                        if(closeError === null) { closeError = parentError }
                    }
                    observe(connection, closeError)
                }
            }
        }
        published = true
        connection
    }).ensure(() => {
        if(!published) { discard(native, abi.release) }
    })
}
