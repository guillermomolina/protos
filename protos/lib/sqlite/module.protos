//! Protos-first in-memory SQLite. Native authority is required only by openMemory.
//! prepare admits exactly one SQL statement; conventional ";" terminators and
//! trailing comments are accepted, a second statement or NUL is rejected.
//! bind accepts an exact i64 Integer, Float, String (TEXT), Bytes (BLOB) or null;
//! Statement.reset() reruns a statement keeping its bindings and
//! Statement.clearBindings() sets every binding to SQL NULL. Copied output
//! columns are Integer/Float/String/Bytes/null. Calls are synchronous.
Resources: import("./internal/Resources.protos")
terminal: _terminalFutureFacility
context.removeSlot("_terminalFutureFacility")

/// Ordinary library error with safe operation and SQLite status code slots.
this.SQLiteError: Error {}
SQLiteError: this.SQLiteError

/// Opens a private :memory: connection using the host-authorized ffi:sqlite3 provider.
/// Importing this module grants no authority and loads no native library.
this.openMemory: () => {
    ABI: import("./abi.protos")
    Resources.openMemory(ABI, terminal, SQLiteError)
}
