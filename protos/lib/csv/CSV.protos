//! Comma-separated values over String fields: comma separators, double-quote
//! quoting with doubled quotes, and CR, LF, or CRLF row terminators.

/// Answers an incremental parser whose `feed(text)` consumes CSV text and whose
/// `finish()` ends the input, calling `emit(row)` with each completed row as an
/// Array of Strings. Malformed input, an `emit` failure, or use after `finish()`
/// signals an Error and leaves the parser terminal.
rowParser: (emit) => {
    failed: false
    finished: false
    parser: null

    fail: () => {
        failed = true
        Error().signal()
    }

    fieldBuffer: Encoding.UTF8.encode("")
    fieldChunks: Map()
    fieldMaxLevel: -1

    carryFieldChunk: null
    carryFieldChunk = (chunk, level) => {
        present: fieldChunks.containsKey(level)

        present.ifTrue(() => {
            left: fieldChunks[level]
            fieldChunks.remove(level)
            carryFieldChunk(Array(...left, ...chunk), level + 1)
        })

        present.ifFalse(() => {
            fieldChunks[level] = chunk
            (level > fieldMaxLevel).ifTrue(() => {
                fieldMaxLevel = level
            })
        })
    }

    collectFieldChunks: null
    collectFieldChunks = (level, result) => {
        finalResult: result

        (level >= 0).ifTrue(() => {
            nextResult: result
            fieldChunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...fieldChunks[level])
            })
            finalResult = collectFieldChunks(level - 1, nextResult)
        })

        finalResult
    }

    publishRow: (row) => {
        // Mirror the established incremental JSON lifecycle: callbacks are
        // non-reentrant and any consumer failure leaves this parser terminal.
        failed = true
        emit(row)
        failed = false
    }

    finishField: () => {
        field: Encoding.UTF8.decode(fieldBuffer)
        carryFieldChunk(Array(field), 0)
        fieldBuffer = Encoding.UTF8.encode("")
    }

    finishRow: () => {
        row: collectFieldChunks(fieldMaxLevel, Array())

        fieldChunks = Map()
        fieldMaxLevel = -1

        publishRow(row)
    }

    mode: "fieldStart"
    rowActive: false
    skipLfAfterCr: false

    consumeOctet: (octet) => {
        skipped: false

        skipLfAfterCr.ifTrue(() => {
            skipLfAfterCr = false
            (octet == 10).ifTrue(() => {
                skipped = true
            })
        })

        skipped.ifFalse(() => {
            previousMode: mode

            (previousMode == "fieldStart").ifTrue(() => {
                handled: false

                (octet == 44).ifTrue(() => {
                    finishField()
                    rowActive = true
                    handled = true
                })

                handled.ifFalse(() => {
                    (octet == 34).ifTrue(() => {
                        mode = "quoted"
                        rowActive = true
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    (octet == 13).ifTrue(() => {
                        finishField()
                        finishRow()
                        rowActive = false
                        skipLfAfterCr = true
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    (octet == 10).ifTrue(() => {
                        finishField()
                        finishRow()
                        rowActive = false
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    fieldBuffer.add(octet)
                    mode = "unquoted"
                    rowActive = true
                })
            })

            (previousMode == "unquoted").ifTrue(() => {
                handled: false

                (octet == 44).ifTrue(() => {
                    finishField()
                    mode = "fieldStart"
                    handled = true
                })

                handled.ifFalse(() => {
                    (octet == 34).ifTrue(() => {
                        fail()
                    })
                })

                handled.ifFalse(() => {
                    (octet == 13).ifTrue(() => {
                        finishField()
                        finishRow()
                        mode = "fieldStart"
                        rowActive = false
                        skipLfAfterCr = true
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    (octet == 10).ifTrue(() => {
                        finishField()
                        finishRow()
                        mode = "fieldStart"
                        rowActive = false
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    fieldBuffer.add(octet)
                })
            })

            (previousMode == "quoted").ifTrue(() => {
                (octet == 34).ifTrue(() => {
                    mode = "afterQuote"
                })
                (octet == 34).ifFalse(() => {
                    fieldBuffer.add(octet)
                })
            })

            (previousMode == "afterQuote").ifTrue(() => {
                handled: false

                (octet == 34).ifTrue(() => {
                    fieldBuffer.add(34)
                    mode = "quoted"
                    handled = true
                })

                handled.ifFalse(() => {
                    (octet == 44).ifTrue(() => {
                        finishField()
                        mode = "fieldStart"
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    (octet == 13).ifTrue(() => {
                        finishField()
                        finishRow()
                        mode = "fieldStart"
                        rowActive = false
                        skipLfAfterCr = true
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    (octet == 10).ifTrue(() => {
                        finishField()
                        finishRow()
                        mode = "fieldStart"
                        rowActive = false
                        handled = true
                    })
                })

                handled.ifFalse(() => {
                    fail()
                })
            })
        })
    }

    parser = {
        feed: (text) => {
            failed.ifTrue(() => {
                Error().signal()
            })
            finished.ifTrue(() => {
                fail()
            })

            Encoding.UTF8.encode(text).each((octet) => {
                consumeOctet(octet)
            })

            parser
        }

        finish: () => {
            failed.ifTrue(() => {
                Error().signal()
            })
            finished.ifTrue(() => {
                fail()
            })

            (mode == "quoted").ifTrue(() => {
                fail()
            })

            (mode == "afterQuote").ifTrue(() => {
                finishField()
                finishRow()
                rowActive = false
            })

            (mode == "unquoted").ifTrue(() => {
                finishField()
                finishRow()
                rowActive = false
            })

            (mode == "fieldStart").ifTrue(() => {
                rowActive.ifTrue(() => {
                    finishField()
                    finishRow()
                    rowActive = false
                })
            })

            finished = true
            parser
        }
    }

    parser
}

/// Parses complete CSV `text` and answers an Array of rows, each an Array of Strings.
parse: (text) => {
    tableChunks: Map()
    tableMaxLevel: -1

    carryTableChunk: null
    carryTableChunk = (chunk, level) => {
        present: tableChunks.containsKey(level)

        present.ifTrue(() => {
            left: tableChunks[level]
            tableChunks.remove(level)
            carryTableChunk(Array(...left, ...chunk), level + 1)
        })

        present.ifFalse(() => {
            tableChunks[level] = chunk
            (level > tableMaxLevel).ifTrue(() => {
                tableMaxLevel = level
            })
        })
    }

    collectTableChunks: null
    collectTableChunks = (level, result) => {
        finalResult: result

        (level >= 0).ifTrue(() => {
            nextResult: result
            tableChunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...tableChunks[level])
            })
            finalResult = collectTableChunks(level - 1, nextResult)
        })

        finalResult
    }

    parser: rowParser((row) => {
        carryTableChunk(Array(row), 0)
    })
    parser.feed(text)
    parser.finish()

    collectTableChunks(tableMaxLevel, Array())
}

/// Encodes `rows` as CSV text, quoting fields that contain a comma, quote, CR, or
/// LF and ending every row with CRLF. An empty row signals an Error.
encode: (rows) => {
    table: Array(...rows)
    output: Encoding.UTF8.encode("")

    appendByte: (octet) => {
        output.add(octet)
    }

    table.each((row) => {
        fields: Array(...row)

        (fields.size() == 0).ifTrue(() => {
            Error().signal()
        })

        index: 0

        fields.each((field) => {
            (index > 0).ifTrue(() => {
                appendByte(44)
            })

            bytes: Encoding.UTF8.encode(field)
            quoteNeeded: false

            bytes.each((octet) => {
                ((octet == 44) || (octet == 34) || (octet == 13) || (octet == 10)).ifTrue(() => {
                    quoteNeeded = true
                })
            })

            quoteNeeded.ifTrue(() => {
                appendByte(34)
            })

            bytes.each((octet) => {
                (quoteNeeded && (octet == 34)).ifTrue(() => {
                    appendByte(34)
                })
                appendByte(octet)
            })

            quoteNeeded.ifTrue(() => {
                appendByte(34)
            })

            index = index + 1
        })

        appendByte(13)
        appendByte(10)
    })

    Encoding.UTF8.decode(output)
}

/// Answers an adapter whose `read()` reads one chunk from `textReader`, feeds it to
/// a `rowParser(emit)`, and answers a Future of `true`, or of `false` once the
/// input has ended and been finished. Calling `read()` while a read is pending
/// or after the end signals an Error.
readRows: (textReader, emit) => {
    parser: rowParser(emit)
    busy: false
    finished: false
    adapter: null

    ensureReady: () => {
        busy.ifTrue(() => {
            Error().signal()
        })
        finished.ifTrue(() => {
            Error().signal()
        })
    }

    adapter = {
        read: () => {
            ensureReady()

            // Enter the operation before crossing the supplied capability
            // boundary so synchronous reader failure is terminal as well.
            busy = true
            readFuture: textReader.readText()
            completion: readFuture.then((chunk) => {
                more: true

                (chunk === null).ifTrue(() => {
                    parser.finish()
                    finished = true
                    more = false
                })

                (chunk === null).ifFalse(() => {
                    parser.feed(chunk)
                })

                busy = false
                more
            })

            completion
        }
    }

    adapter
}

/// Answers an adapter whose `feed(row)` encodes one row and writes it to
/// `textWriter`, and whose `finish()` is an ordered zero-output barrier; both
/// answer a Future of the adapter. The adapter does not flush, close, or take
/// ownership of `textWriter`.
writeRows: (textWriter) => {
    busy: false
    finished: false
    adapter: null

    ensureReady: () => {
        busy.ifTrue(() => {
            Error().signal()
        })
        finished.ifTrue(() => {
            Error().signal()
        })
    }

    adapter = {
        feed: (row) => {
            ensureReady()

            // Keep validation/encoding and downstream writing in one terminal
            // operation, mirroring JSON.writeEvents.
            busy = true
            chunk: encode(Array(row))
            writeFuture: textWriter.writeText(chunk)
            completion: writeFuture.then((ignored) => {
                busy = false
                adapter
            })

            completion
        }

        finish: () => {
            ensureReady()

            // Ordered zero-output Future barrier. It adds no CSV bytes and does
            // not flush, close, or take ownership of the supplied writer.
            busy = true
            barrier: textWriter.writeText("")
            completion: barrier.then((ignored) => {
                finished = true
                busy = false
                adapter
            })

            completion
        }
    }

    adapter
}
