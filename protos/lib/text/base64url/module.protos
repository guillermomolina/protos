//! Strict unpadded RFC 4648 Base64url encoding.
//!
//! Binary-to-ASCII conversion without implicit Unicode interpretation.
//! Both operations are synchronous and require no ambient authority.

alphabet: Encoding.Latin1.encode(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
)

// Decoding table built once at module initialization: entry o is the 6-bit
// value of alphabet octet o (0..63), and INVALID for every other octet,
// including '=', '+', '/', whitespace and all non-ASCII octets.
INVALID: 255
values: (() => {
    table: Encoding.Latin1.encode("")
    octet: 0
    while(octet < 256) {
        table.add(INVALID)
        octet = octet + 1
    }
    index: 0
    while(index < 64) {
        table[alphabet[index]] = index
        index = index + 1
    }
    table
})()

snapshot: (value) => {
    copy: null

    Error.handle(
        () => {
            copy = Encoding.Latin1.encode(
                Encoding.Latin1.decode(value)
            )
        },
        (error) => {
            Error().signal()
        }
    )

    copy
}

/// Encodes genuine standard Bytes as canonical unpadded Base64url.
/// The source is copied without retaining or modifying it.
encode: (bytes) => {
    source: snapshot(bytes)
    output: Encoding.UTF8.encode("")
    count: source.size()
    index: 0

    while((index + 3) <= count) {
        a: source[index]
        b: source[index + 1]
        c: source[index + 2]

        output.add(alphabet[a >> 2])
        output.add(alphabet[((a & 3) << 4) | (b >> 4)])
        output.add(alphabet[((b & 15) << 2) | (c >> 6)])
        output.add(alphabet[c & 63])

        index = index + 3
    }

    remaining: count - index

    if(remaining == 1) {
        a: source[index]

        output.add(alphabet[a >> 2])
        output.add(alphabet[(a & 3) << 4])
    }

    if(remaining == 2) {
        a: source[index]
        b: source[index + 1]

        output.add(alphabet[a >> 2])
        output.add(alphabet[((a & 3) << 4) | (b >> 4)])
        output.add(alphabet[(b & 15) << 2])
    }

    Encoding.Latin1.decode(output)
}

/// Decodes canonical unpadded Base64url into fresh standard Bytes.
/// Invalid characters, lengths and unused trailing bits signal Error.
decode: (text) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })

    source: Encoding.UTF8.encode(text)
    count: source.size()

    ((count % 4) == 1).ifTrue(() => {
        Error().signal()
    })

    // One pass: each quartet is read once and translated through the table.
    // An INVALID entry makes the OR of the four values exceed 63.
    output: Encoding.Latin1.encode("")
    index: 0

    while((index + 4) <= count) {
        a: values[source[index]]
        b: values[source[index + 1]]
        c: values[source[index + 2]]
        d: values[source[index + 3]]

        ((a | b | c | d) > 63).ifTrue(() => {
            Error().signal()
        })

        output.add((a << 2) | (b >> 4))
        output.add(((b & 15) << 4) | (c >> 2))
        output.add(((c & 3) << 6) | d)

        index = index + 4
    }

    remaining: count - index

    if(remaining == 2) {
        a: values[source[index]]
        b: values[source[index + 1]]

        (((a | b) > 63) || ((b & 15) != 0)).ifTrue(() => {
            Error().signal()
        })

        output.add((a << 2) | (b >> 4))
    }

    if(remaining == 3) {
        a: values[source[index]]
        b: values[source[index + 1]]
        c: values[source[index + 2]]

        (((a | b | c) > 63) || ((c & 3) != 0)).ifTrue(() => {
            Error().signal()
        })

        output.add((a << 2) | (b >> 4))
        output.add(((b & 15) << 4) | (c >> 2))
    }

    output
}

// Publish only the two supported operations.
/// Encode standard Bytes as canonical unpadded Base64url text.
this.encode: encode
/// Decode canonical unpadded Base64url text to fresh Bytes.
this.decode: decode

// The helpers remain private initializer bindings, captured by the
// exported operations. They are not public module slots.
