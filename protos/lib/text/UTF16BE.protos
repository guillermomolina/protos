encode: (text) => {
    Encoding.UTF16BE.encode(text)
}

decode: (bytes) => {
    Encoding.UTF16BE.decode(bytes)
}

reader: (source) => {
    TextReader(source, Encoding.UTF16BE)
}

owningReader: (source) => {
    TextReader.owning(source, Encoding.UTF16BE)
}

writer: (target) => {
    TextWriter(target, Encoding.UTF16BE)
}

owningWriter: (target) => {
    TextWriter.owning(target, Encoding.UTF16BE)
}
