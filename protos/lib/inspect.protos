//! Explicit, implementation-specific runtime inspection.
//!
//! This module is available only when the host enabled the Context option
//! `protos.Inspect`; it is disabled by default and is independent of DEBUG.
//! Without that authority, importing the module signals an ordinary Error,
//! and every operation re-checks the authority of the currently entered
//! Context.
//!
//! Every operation accepts exactly one argument and answers a non-empty
//! diagnostic String. The text is implementation-specific and has no stable
//! format across versions. Wrong arity, a wrong argument type, missing
//! authority, or an unavailable representation signals a fresh ordinary
//! Error. No operation calls the inspected Closure.

/// Answers a shallow classification of `value` without its contents.
representation: ((facility) => (...arguments) => {
    facility.representation(...arguments)
})(_inspectFacility)

/// Describes a Closure: native or source-backed, its definition span, and
/// whether its execution plan is prepared.
callableInfo: ((facility) => (...arguments) => {
    facility.callableInfo(...arguments)
})(_inspectFacility)

/// Answers the physical Bytecode DSL instructions of a source-backed Closure
/// in the current Context, without operand constant values.
bytecode: ((facility) => (...arguments) => {
    facility.bytecode(...arguments)
})(_inspectFacility)

/// Answers the physical Truffle node tree of a source-backed Closure in the
/// current Context. It is neither the semantic AST nor Graal compiler IR.
truffleTree: ((facility) => (...arguments) => {
    facility.truffleTree(...arguments)
})(_inspectFacility)

// The runtime-provisioned facility is captured privately above; it is not
// module surface.
context.removeSlot("_inspectFacility")
