//! CommonMark 0.31.2 and selected published GFM parsing into mutable semantic trees.
//! Parsing grants no authority. Raw HTML and destinations remain untrusted data.

/// Prototype for a fresh Markdown resource-limit failure.
this.MarkdownLimitError: Error {}

/// Parses a String with the exact CommonMark or CommonMark-plus-GFM profile.
/// Optional spans are half-open original Unicode scalar intervals. Results are
/// fresh open ordinary nodes and Arrays. Limits are inclusive: 1048576 input
/// scalars, 262144 final nodes, depth 128 and 8388608 logical text scalars.
this.parse: (
    source,
    profile: "commonmark-0.31.2",
    positions: false
) => {
    String.recognizes(source).ifFalse(() => { Error().signal() })
    String.recognizes(profile).ifFalse(() => { Error().signal() })
    ((profile == "commonmark-0.31.2") || (profile == "commonmark-0.31.2-gfm-extensions")).ifFalse(() => { Error().signal() })
    ((positions === true) || (positions === false)).ifFalse(() => { Error().signal() })
    Limits: import("./internal/Limits.protos")
    Limits.input(source, MarkdownLimitError)
    Parser: import("./internal/Parser.protos")
    Parser.parse(source, profile, positions, MarkdownLimitError)
}
