//! Original scalar intervals; no public source-map descriptors.
Source: import("./Source.protos")

span: (subject, start, end) => {
    if(start >= end) { ^null }
    { start: Source.entry(subject, start).start; end: Source.entry(subject, end - 1).end }
}

attach: (node, enabled, extent) => {
    if(enabled) {
        copied: null
        if(extent !== null) { copied = { start: extent.start; end: extent.end } }
        node.span: copied
    }
    node
}

union: (left, right) => {
    if(left === null) { ^right }
    if(right === null) { ^left }
    start: left.start
    end: left.end
    if(right.start < start) { start = right.start }
    if(right.end > end) { end = right.end }
    { start: start; end: end }
}
