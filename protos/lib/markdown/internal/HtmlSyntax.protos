//! CommonMark raw-token scanners. No DOM, sanitization or URL interpretation.
Source: import("./Source.protos")
Characters: import("./Characters.protos")
Builders: import("./Builders.protos")

lower: (s, start, end) => {
    output: Builders.text()
    i: start
    while(i < end) {
        c: Source.entry(s, i).scalar
        if((c >= 65) && (c <= 90)) { c = c + 32 }
        Builders.scalar(output, c)
        i = i + 1
    }
    Builders.string(output)
}

state: () => { Map() }

find: (s, start, spelling, failures: null) => {
    if(failures !== null) {
        if(failures.containsKey(spelling)) {
            cached: failures[spelling]
            if(start >= cached.begin) {
                if(cached.end === null) { ^null }
                if(start <= cached.end - spelling.size()) { ^cached.end }
            }
        }
    }
    i: start
    while(i < Source.size(s)) {
        if(Source.matches(s, i, spelling)) {
            end: i + spelling.size()
            if(failures !== null) { failures[spelling] = { begin: start; end: end } }
            ^end
        }
        i = i + 1
    }
    if(failures !== null) { failures[spelling] = { begin: start; end: null } }
    null
}

nameEnd: (s, start) => {
    if(Characters.alpha(Source.at(s, start)) === false) { ^start }
    i: start + 1
    while(Characters.alpha(Source.at(s, i)) || Characters.digit(Source.at(s, i)) || (Source.at(s, i) == 45)) { i = i + 1 }
    i
}

attributeStart: (c) => { Characters.alpha(c) || (c == 95) || (c == 58) }
attributePart: (c) => { attributeStart(c) || Characters.digit(c) || (c == 46) || (c == 45) }

recognize: (s, start, failures: null) => {
    if(Source.at(s, start) != 60) { ^null }
    if(Source.matches(s, start, "<!--")) {
        // CommonMark 0.31.2 admits short comments and internal double hyphens.
        if(Source.matches(s, start, "<!-->")) { ^(start + 5) }
        if(Source.matches(s, start, "<!--->")) { ^(start + 6) }
        ^find(s, start + 4, "-->", failures)
    }
    if(Source.matches(s, start, "<?")) { ^find(s, start + 2, "?>", failures) }
    if(Source.matches(s, start, "<![CDATA[")) { ^find(s, start + 9, "]]>", failures) }
    if(Source.matches(s, start, "<!") && Characters.alpha(Source.at(s, start + 2))) {
        ^find(s, start + 3, ">", failures)
    }
    if(find(s, start + 1, ">", failures) === null) { ^null }
    i: start + 1
    closing: false
    if(Source.at(s, i) == 47) { closing = true; i = i + 1 }
    end: nameEnd(s, i)
    if(end == i) { ^null }
    i = end
    while(i < Source.size(s)) {
        before: i
        while(Characters.asciiSpace(Source.at(s, i))) { i = i + 1 }
        if(Source.at(s, i) == 62) { ^(i + 1) }
        if((closing === false) && Source.matches(s, i, "/>")) { ^(i + 2) }
        if(closing || (i == before) || (attributeStart(Source.at(s, i)) === false)) { ^null }
        i = i + 1
        while(attributePart(Source.at(s, i))) { i = i + 1 }
        afterName: i
        while(Characters.asciiSpace(Source.at(s, i))) { i = i + 1 }
        hasValue: Source.at(s, i) == 61
        if(hasValue) {
            i = i + 1
            while(Characters.asciiSpace(Source.at(s, i))) { i = i + 1 }
            quote: Source.at(s, i)
            if((quote == 34) || (quote == 39)) {
                i = i + 1
                spelling: "\""
                if(quote == 39) { spelling = "'" }
                endQuote: find(s, i, spelling, failures)
                if(endQuote === null) { ^null }
                i = endQuote
            }
            ((quote == 34) || (quote == 39)).ifFalse(() => {
                begin: i
                while((i < Source.size(s)) && (Characters.asciiSpace(Source.at(s, i)) === false) && (Source.at(s, i) != 62)) {
                    c: Source.at(s, i)
                    if((c == 34) || (c == 39) || (c == 61) || (c == 60) || (c == 96)) { ^null }
                    i = i + 1
                }
                if(i == begin) { ^null }
            })
        }
        hasValue.ifFalse(() => {
            // Leave separating whitespace for the next attribute iteration.
            if(Source.at(s, i) != 62) {
                if(Source.at(s, i) != 47) { i = afterName }
            }
        })
    }
    null
}

blockNames: ["address", "article", "aside", "base", "basefont", "blockquote", "body", "caption", "center", "col", "colgroup", "dd", "details", "dialog", "dir", "div", "dl", "dt", "fieldset", "figcaption", "figure", "footer", "form", "frame", "frameset", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hr", "html", "iframe", "legend", "li", "link", "main", "menu", "menuitem", "nav", "noframes", "ol", "optgroup", "option", "p", "param", "search", "section", "summary", "table", "tbody", "td", "tfoot", "th", "thead", "title", "tr", "track", "ul"]
blockNames.freeze()

block: (s, start, paragraph) => {
    if(Source.at(s, start) != 60) { ^null }
    if(Source.matches(s, start, "<!--")) { ^{ category: 2; close: "-->" } }
    if(Source.matches(s, start, "<?")) { ^{ category: 3; close: "?>" } }
    if(Source.matches(s, start, "<![CDATA[")) { ^{ category: 5; close: "]]>" } }
    c: Source.at(s, start + 2)
    if(Source.matches(s, start, "<!") && Characters.alpha(c)) {
        ^{ category: 4; close: ">" }
    }
    i: start + 1
    closing: Source.at(s, i) == 47
    if(closing) { i = i + 1 }
    end: nameEnd(s, i)
    name: lower(s, i, end)
    following: Source.at(s, end)
    if((closing === false) && ((name == "script") || (name == "pre") || (name == "style") || (name == "textarea")) && (Characters.asciiSpace(following) || (following == 62) || (following == -1))) {
        ^{ category: 1; close: "</" + name + ">" }
    }
    if(Characters.asciiSpace(following) || (following == 62) || Source.matches(s, end, "/>" ) || (following == -1)) {
        for(candidate in blockNames) { if(candidate == name) { ^{ category: 6; close: null } } }
    }
    if(paragraph === false) {
        token: recognize(s, start)
        if(token !== null) {
            while(Characters.asciiSpace(Source.at(s, token))) { token = token + 1 }
            if(token == Source.size(s)) { ^{ category: 7; close: null } }
        }
    }
    null
}

terminated: (s, marker) => {
    if(marker.close === null) { ^false }
    if(marker.category == 1) {
        text: Source.scan(lower(s, 0, Source.size(s)))
        for(closing in ["</script>", "</pre>", "</style>", "</textarea>"]) {
            if(find(text, 0, closing) !== null) { ^true }
        }
        ^false
    }
    find(s, 0, marker.close) !== null
}
