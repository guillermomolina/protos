//! Transactional link syntax scanners; parenthesis depth is an Integer counter.
Source: import("./Source.protos")
Characters: import("./Characters.protos")
Entities: import("./Entities.protos")

space: (s, start) => {
    i: start
    while(Characters.labelSpace(Source.at(s, i))) { i = i + 1 }
    i
}

label: (s, start) => {
    if(Source.at(s, start) != 91) { ^null }
    i: start + 1
    nonspace: false
    count: 0
    while(i < Source.size(s)) {
        c: Source.entry(s, i).scalar
        if(c == 93) {
            if((count == 0) || (nonspace === false)) { ^null }
            ^{ subject: Source.slice(s, start + 1, i); end: i + 1 }
        }
        if(c == 91) { ^null }
        if(c == 10) {
            j: i + 1
            while((Source.at(s, j) == 32) || (Source.at(s, j) == 9)) { j = j + 1 }
            if(Source.at(s, j) == 10) { ^null }
        }
        if((c == 92) && Characters.escapable(Source.at(s, i + 1))) { i = i + 1; count = count + 1 }
        Characters.labelSpace(c).ifFalse(() => { nonspace = true })
        count = count + 1
        if(count > 999) { ^null }
        i = i + 1
    }
    null
}

state: () => { { bare: null; angles: null; titleFailures: Map() } }

// Integer endpoints are shared by speculative candidates. Parentheses are
// matched without recursion; no candidate decodes a destination before commit.
indexDestinations: (s, state) => {
    pairs: Map()
    stack: null
    i: 0
    while(i < Source.size(s)) {
        c: Source.at(s, i)
        escaped: (c == 92) && Characters.escapable(Source.at(s, i + 1))
        if(escaped) { i = i + 2 }
        escaped.ifFalse(() => {
            if((c <= 32) || (c == 127)) { stack = null }
            if(c == 40) { stack = { start: i; previous: stack } }
            if((c == 41) && (stack !== null)) { pairs[stack.start] = i; stack = stack.previous }
            i = i + 1
        })
    }
    bare: Map()
    angle: Map()
    end: Source.size(s)
    bare[end] = end
    bare[end + 1] = end
    angle[end] = end
    angle[end + 1] = end
    i = end - 1
    while(i >= 0) {
        c: Source.at(s, i)
        escaped: (c == 92) && Characters.escapable(Source.at(s, i + 1))
        bare[i] = bare[i + 1]
        angle[i] = angle[i + 1]
        if((c <= 32) || (c == 127) || (c == 41)) { bare[i] = i }
        if(c == 40) {
            bare[i] = -1
            if(pairs.containsKey(i)) { bare[i] = bare[pairs[i] + 1] }
        }
        if((c == 10) || (c == 13) || (c == 60) || (c == 62)) { angle[i] = i }
        if(escaped) { bare[i] = bare[i + 2]; angle[i] = angle[i + 2] }
        i = i - 1
    }
    state.bare = bare
    state.angles = angle
}

destination: (s, start, scan) => {
    if((start < 0) || (start > Source.size(s))) { ^null }
    if(scan.bare === null) { indexDestinations(s, scan) }
    if(Source.at(s, start) == 60) {
        end: scan.angles[start + 1]
        if(Source.at(s, end) != 62) { ^null }
        ^{ subject: Source.slice(s, start + 1, end); end: end + 1 }
    }
    end: scan.bare[start]
    if(end < 0) { ^null }
    { subject: Source.slice(s, start, end); end: end }
}

title: (s, start, scan) => {
    opener: Source.at(s, start)
    if((opener != 34) && (opener != 39) && (opener != 40)) { ^null }
    closer: opener
    if(opener == 40) { closer = 41 }
    i: start + 1
    if(scan.titleFailures.containsKey(opener)) {
        failed: scan.titleFailures[opener]
        if((i >= failed.begin) && (i < failed.end)) { ^null }
    }
    fail: (end) => { scan.titleFailures[opener] = { begin: start + 1; end: end }; null }
    while(i < Source.size(s)) {
        c: Source.entry(s, i).scalar
        if(c == closer) { ^{ subject: Source.slice(s, start + 1, i); end: i + 1 } }
        if((opener == 40) && (c == 40)) { ^fail(i) }
        if(c == 10) {
            j: i + 1
            while((Source.at(s, j) == 32) || (Source.at(s, j) == 9)) { j = j + 1 }
            if(Source.at(s, j) == 10) { ^fail(i) }
        }
        if((c == 92) && Characters.escapable(Source.at(s, i + 1))) { i = i + 1 }
        i = i + 1
    }
    fail(Source.size(s))
}

inline: (s, start, scan) => {
    if(Source.at(s, start) != 40) { ^null }
    begin: space(s, start + 1)
    dest: destination(s, begin, scan)
    if(dest === null) { ^null }
    i: space(s, dest.end)
    caption: null
    if((i > dest.end) && (Source.at(s, i) != 41)) {
        parsed: title(s, i, scan)
        if(parsed === null) { ^null }
        caption = parsed.subject
        i = space(s, parsed.end)
    }
    if(Source.at(s, i) != 41) { ^null }
    { destinationRange: dest.subject; titleRange: caption; end: i + 1 }
}

commit: (candidate) => {
    destination: Entities.decode(candidate.destinationRange)
    title: null
    if(candidate.titleRange !== null) { title = Entities.decode(candidate.titleRange) }
    cost: destination.size()
    if(title !== null) { cost = cost + title.size() }
    { destination: destination; title: title; textSize: cost; end: candidate.end }
}
