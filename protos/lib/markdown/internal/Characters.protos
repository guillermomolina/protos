//! Exact Markdown classification; generated Unicode data is version-pinned.
Builders: import("./Builders.protos")
Categories: import("./generated/UnicodeCategories.protos")
Folding: import("./generated/UnicodeCaseFolding.protos")

alpha: (c) => { ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)) }
digit: (c) => { (c >= 48) && (c <= 57) }
asciiSpace: (c) => { (c == 32) || ((c >= 9) && (c <= 13)) }
labelSpace: (c) => { asciiSpace(c) }
escapable: (c) => {
    ((c >= 33) && (c <= 47)) || ((c >= 58) && (c <= 64)) ||
    ((c >= 91) && (c <= 96)) || ((c >= 123) && (c <= 126))
}

inRanges: (ranges, c) => {
    low: 0
    high: ranges.size()
    while(low < high) {
        middle: (low + high).div(2)
        range: ranges[middle]
        if(c < range[0]) { high = middle }
        (c < range[0]).ifFalse(() => {
            if(c <= range[1]) { ^true }
            low = middle + 1
        })
    }
    false
}

whitespace: (c) => { (c == 9) || (c == 10) || (c == 12) || (c == 13) || inRanges(Categories.spaces, c) }
punctuation: (c) => { escapable(c) || inRanges(Categories.punctuation, c) }
hex: (c) => {
    if(digit(c)) { ^(c - 48) }
    if((c >= 65) && (c <= 70)) { ^(c - 55) }
    if((c >= 97) && (c <= 102)) { ^(c - 87) }
    -1
}

string: (c) => { output: Builders.text(); Builders.scalar(output, c); Builders.string(output) }

fold: (c) => {
    low: 0
    high: Folding.entries.size()
    while(low < high) {
        mid: (low + high).div(2)
        entry: Folding.entries[mid]
        if(c == entry[0]) { ^entry[1] }
        if(c < entry[0]) { high = mid }
        (c < entry[0]).ifFalse(() => { low = mid + 1 })
    }
    string(c)
}
