//! Only these constructors materialize public semantic nodes.
Positions: import("./Positions.protos")

leaf: (kind, positions, extent) => { Positions.attach({ kind: kind }, positions, extent) }
container: (kind, children, positions, extent) => {
    Positions.attach({ kind: kind; children: children }, positions, extent)
}
value: (kind, text, positions, extent) => {
    Positions.attach({ kind: kind; value: text }, positions, extent)
}
heading: (level, children, positions, extent) => {
    Positions.attach({ kind: "heading"; level: level; children: children }, positions, extent)
}
list: (ordered, start, tight, children, positions, extent) => {
    Positions.attach({ kind: "list"; ordered: ordered; start: start; tight: tight; children: children }, positions, extent)
}
item: (task, children, positions, extent) => {
    Positions.attach({ kind: "listItem"; task: task; children: children }, positions, extent)
}
code: (value, info, positions, extent) => {
    Positions.attach({ kind: "codeBlock"; value: value; info: info }, positions, extent)
}
link: (kind, destination, title, children, positions, extent) => {
    Positions.attach({ kind: kind; destination: destination; title: title; children: children }, positions, extent)
}
table: (alignments, children, positions, extent) => {
    Positions.attach({ kind: "table"; alignments: alignments; children: children }, positions, extent)
}
