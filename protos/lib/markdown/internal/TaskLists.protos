//! Task recognition changes the first item's paragraph subject only.
Source: import("./Source.protos")
Characters: import("./Characters.protos")

recognize: (s) => {
    if((Source.at(s, 0) != 91) || (Source.at(s, 2) != 93)) { ^null }
    mark: Source.at(s, 1)
    if((Characters.asciiSpace(mark) === false) && (mark != 120) && (mark != 88)) { ^null }
    if(Characters.asciiSpace(Source.at(s, 3)) === false) { ^null }
    i: 3
    while(Characters.asciiSpace(Source.at(s, i))) { i = i + 1 }
    if(i == Source.size(s)) { ^null }
    { task: (mark == 120) || (mark == 88); subject: Source.slice(s, i, Source.size(s)) }
}
