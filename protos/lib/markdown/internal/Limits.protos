//! Final-result accounting, independent of discarded working structures.
input: (source, prototype) => {
    if(source.size() > 1048576) { prototype().signal() }
}

verify: (root, prototype) => {
    stack: { node: root; depth: 0; next: null }
    count: 0
    text: 0
    while(stack !== null) {
        entry: stack
        stack = entry.next
        count = count + 1
        if((count > 262144) || (entry.depth > 128)) { prototype().signal() }
        node: entry.node
        for(name in ["value", "info", "destination", "title"]) {
            if(node.hasSlot(name)) {
                value: node.slotValue(name)
                if(value !== null) { text = text + value.size() }
            }
        }
        if(text > 8388608) { prototype().signal() }
        if(node.hasSlot("children")) {
            for(child in node.children) {
                stack = { node: child; depth: entry.depth + 1; next: stack }
            }
        }
    }
    root
}

// Contributions enter this state only after their final interpretation is
// inevitable. The independent final traversal remains the consistency guard.
create: (prototype) => { { prototype: prototype; nodes: 0; text: 0 } }
room: (state, nodes, text) => {
    if((state.nodes + nodes > 262144) || (state.text + text > 8388608)) { excess(state) }
}
charge: (state, nodes, depth, text: 0) => {
    room(state, nodes, text)
    if(depth > 128) { excess(state) }
    state.nodes = state.nodes + nodes
    state.text = state.text + text
}
text: (state, scalars) => { room(state, 0, scalars); state.text = state.text + scalars }

excess: (state) => { prototype: state.prototype; prototype().signal() }
