//! Private FFI objectprojection operations. Dependencies remain initializer-owned.

create: (associations, captureGroup, commitPrepared, fail, isOrdinaryObject, projectionLayout, projectionPlan, readGroup, requireArity, requireCanonicalMethod, slots, storage) => {
    snapshotGroup: null
    snapshotValue: null
    readAs: null
    captureSlots: null
    captureSlotValue: null
    writeFrom: null

    methods: {
        snapshotGroup: (parentPrototype, layout, nodes, values) => {
            result: null
            if(storage(layout).layoutKind == "array") {
                elements: slots(nodes.size())
                index: 0
                for(node in nodes) {
                    elements[index] = snapshotValue(node, values[index])
                    index = index + 1
                }
                result = elements
            } else {
                requireCanonicalMethod(parentPrototype, "createSlot")
                answer: parentPrototype {}
                create: answer.createSlot
                for(node in nodes) {
                    create(node.key, snapshotValue(node, values.at(node.key)))
                }
                result = answer
            }
            result
        }

        // A nested struct or union is an ordinary object of Object; leaves keep the
        // value of the existing typed read.
        snapshotValue: (node, value) => {
            result: value
            if(node.children !== null) {
                result = snapshotGroup(Object, node.layout, node.children, value)
            }
            result
        }

        readAs: (prototype: fail(), region: fail(), arms: fail(), ...extra) => {
            requireArity(extra)
            (isOrdinaryObject(prototype) === true).ifFalse(() => fail())
            associations.containsKey(prototype).ifFalse(() => fail())
            layout: projectionLayout(region, false)
            (associations.at(prototype) === layout).ifFalse(() => fail())
            requireCanonicalMethod(prototype, "createSlot")
            nodes: projectionPlan(layout, arms)
            snapshotGroup(prototype, layout, nodes, readGroup(region, layout, nodes))
        }

        // The local slots an ordinary object holds for the planned members, captured
        // through its canonical bound `slotValue` into a private Map (an Array per
        // fixed array) of exactly the shape captureGroup admits. A missing local slot
        // is the ordinary Error; delegated slots are never consulted and slots
        // outside the plan are never read.
        captureSlots: (layout, nodes, input) => {
            result: null
            if(storage(layout).layoutKind == "array") {
                Array.recognizes(input).ifFalse(() => fail())
                ordered: Array(...input)
                (ordered.size() == nodes.size()).ifFalse(() => fail())
                elements: slots(nodes.size())
                index: 0
                for(node in nodes) {
                    elements[index] = captureSlotValue(node, ordered[index])
                    index = index + 1
                }
                result = elements
            } else {
                (isOrdinaryObject(input) === true).ifFalse(() => fail())
                requireCanonicalMethod(input, "slotValue")
                read: input.slotValue
                fields: Map()
                for(node in nodes) {
                    fields[node.key] = captureSlotValue(node, read(node.key))
                }
                result = fields
            }
            result
        }

        captureSlotValue: (node, value) => {
            result: value
            if(node.children !== null) {
                result = captureSlots(node.layout, node.children, value)
            }
            result
        }

        writeFrom: (region: fail(), value: fail(), arms: fail(), ...extra) => {
            requireArity(extra)
            layout: projectionLayout(region, true)
            (isOrdinaryObject(value) === true).ifFalse(() => fail())
            requireCanonicalMethod(value, "parent")
            prototype: value.parent()
            associations.containsKey(prototype).ifFalse(() => fail())
            (associations.at(prototype) === layout).ifFalse(() => fail())
            requireCanonicalMethod(value, "slotValue")
            nodes: projectionPlan(layout, arms)
            fields: captureSlots(layout, nodes, value)
            commitPrepared(region, layout, nodes, captureGroup(layout, nodes, fields))
        }
    }

    // Bind private operations once; factory-created closures use normal completion.
    snapshotGroup = methods.snapshotGroup
    snapshotValue = methods.snapshotValue
    readAs = methods.readAs
    captureSlots = methods.captureSlots
    captureSlotValue = methods.captureSlotValue
    writeFrom = methods.writeFrom

    {
        snapshotGroup: snapshotGroup
        snapshotValue: snapshotValue
        readAs: readAs
        captureSlots: captureSlots
        captureSlotValue: captureSlotValue
        writeFrom: writeFrom
    }
}
