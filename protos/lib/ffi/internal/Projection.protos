//! Private FFI projection operations. Dependencies remain initializer-owned.

create: (allocateRoot, fail, operation, projectionLayout, projectionPlan, providerContext, releaseOwned, requireArity, requireMap, requireString, slots, storage) => {
    readGroup: null
    readFields: null
    captureGroup: null
    writeGroup: null
    commitPrepared: null
    writeFields: null

    methods: {
        readGroup: (region, layout, nodes) => {
            values: slots(nodes.size())
            index: 0
            for(node in nodes) {
                value: region[node.key]
                if((node.children === null) == false) {
                    value = readGroup(value, node.layout, node.children)
                }
                values[index] = value
                index = index + 1
            }
            result: values
            if((storage(layout).layoutKind == "array") == false) {
                fields: Map()
                index = 0
                for(node in nodes) {
                    fields[node.key] = values[index]
                    index = index + 1
                }
                result = fields
            }
            result
        }

        readFields: (region: fail(), arms: fail(), ...extra) => {
            requireArity(extra)
            layout: projectionLayout(region, false)
            readGroup(region, layout, projectionPlan(layout, arms))
        }

        // Phase 1: the complete structural admission of `input` against the plan,
        // capturing every value into fresh private Arrays aligned with the plan. Map
        // keys are checked through the ordinary enumeration of the actual entries.
        captureGroup: (layout, nodes, input) => {
            ordered: null
            if(storage(layout).layoutKind == "array") {
                Array.recognizes(input).ifFalse(() => fail())
                ordered = Array(...input)
                (ordered.size() == nodes.size()).ifFalse(() => fail())
            } else {
                requireMap(input)
                entries: Map()
                input.each((key, value) => {
                    requireString(key)
                    entries[key] = value
                })
                (entries.size() == nodes.size()).ifFalse(() => fail())
                ordered = slots(nodes.size())
                index: 0
                for(node in nodes) {
                    entries.containsKey(node.key).ifFalse(() => fail())
                    ordered[index] = entries.at(node.key)
                    index = index + 1
                }
            }
            captured: slots(nodes.size())
            position: 0
            for(node in nodes) {
                value: ordered[position]
                if((node.children === null) == false) {
                    value = captureGroup(node.layout, node.children, value)
                }
                captured[position] = value
                position = position + 1
            }
            captured
        }

        // Phase 3: the existing indexed writes, applied only to the temporary root
        // and its nested views; they own every ABI admission.
        writeGroup: (target, nodes, captured) => {
            index: 0
            for(node in nodes) {
                if(node.children === null) {
                    target[node.key] = captured[index]
                } else {
                    writeGroup(target[node.key], node.children, captured[index])
                }
                index = index + 1
            }
        }

        // Phases 2 to 4, shared by writeFields and writeFrom: values already captured
        // are admitted by the indexed writes on a temporary root holding the
        // destination's bytes, then committed by one physical copy. The temporary
        // root is always released; the destination changes only on success.
        commitPrepared: (region, layout, nodes, captured) => {
            temporary: allocateRoot(layout)
            (() => {
                native: providerContext()
                // Phase 2: the destination's current bytes, uninterpreted.
                operation(native, "copyRegion", temporary, region)
                writeGroup(temporary, nodes, captured)
                // Phase 4: one physical commit of the whole prepared region.
                operation(native, "copyRegion", region, temporary)
            }).ensure(() => {
                releaseOwned(temporary)
            })
            region
        }

        writeFields: (region: fail(), fields: fail(), arms: fail(), ...extra) => {
            requireArity(extra)
            layout: projectionLayout(region, true)
            nodes: projectionPlan(layout, arms)
            commitPrepared(region, layout, nodes, captureGroup(layout, nodes, fields))
        }
    }

    // Bind private operations once; factory-created closures use normal completion.
    readGroup = methods.readGroup
    readFields = methods.readFields
    captureGroup = methods.captureGroup
    writeGroup = methods.writeGroup
    commitPrepared = methods.commitPrepared
    writeFields = methods.writeFields

    {
        readGroup: readGroup
        readFields: readFields
        captureGroup: captureGroup
        writeGroup: writeGroup
        commitPrepared: commitPrepared
        writeFields: writeFields
    }
}
