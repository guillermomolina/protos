//! Private FFI memory operations. Dependencies remain initializer-owned.

create: (cTypes, checkedAdd, checkedSize, fail, nativeContextFacility, operation, owners, physical, providerContext, requireArity, requirePositive, requireString, storage) => {
    cType: null
    allocateRoot: null
    allocate: null
    slice: null
    view: null
    assumeExtent: null

    methods: {
        cType: (name: fail(), ...extra) => {
            requireArity(extra)
            requireString(name)
            cTypes.containsKey(name).ifFalse(() => fail())
            // Context acquisition verifies the native platform once per session.
            providerContext()
            cTypes.at(name)
        }

        // One allocation root of the session's existing custody, released by FFI.release.
        allocateRoot: (layout) => {
            storage(layout)
            native: providerContext()
            region: operation(native, "allocate", physical(layout))
            owners[region] = native
            region
        }

        allocate: (layout: fail(), ...extra) => {
            requireArity(extra)
            allocateRoot(layout)
        }

        slice: (region: fail(), byteOffset: fail(), byteLength: fail(), ...extra) => {
            requireArity(extra)
            checkedSize(byteOffset)
            checkedSize(byteLength)
            checkedAdd(byteOffset, byteLength)
            operation(providerContext(), "slice", region, byteOffset, byteLength)
        }

        view: (pointer: fail(), layout: fail(), ...extra) => {
            requireArity(extra)
            storage(layout)
            native: providerContext()
            operation(native, "view", pointer, physical(layout))
        }

        assumeExtent: (pointer: fail(), byteLength: fail(), anchor: fail(), access: fail(),
                ...extra) => {
            requireArity(extra)
            requirePositive(byteLength)
            checkedSize(byteLength)
            requireString(access)
            ((access == "read") || (access == "readWrite")).ifFalse(() => fail())
            result: null
            if((anchor === pointer) || owners.containsKey(anchor)) {
                native: providerContext()
                (anchor === native).ifTrue(() => fail())
                result = operation(native, "assumeExtent", pointer, byteLength, anchor, access)
            } else {
                // Recognize a library-static anchor before reading foreign members.
                (nativeContextFacility.isLibraryAnchor(pointer, anchor) === true).ifFalse(() => fail())
                result = operation(anchor, "assumeStaticExtent", pointer, byteLength, access)
            }
            result
        }
    }

    // Bind private operations once; factory-created closures use normal completion.
    cType = methods.cType
    allocateRoot = methods.allocateRoot
    allocate = methods.allocate
    slice = methods.slice
    view = methods.view
    assumeExtent = methods.assumeExtent

    {
        cType: cType
        allocateRoot: allocateRoot
        allocate: allocate
        slice: slice
        view: view
        assumeExtent: assumeExtent
    }
}
