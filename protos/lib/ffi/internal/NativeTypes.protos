//! Private FFI nativetypes operations. Dependencies remain initializer-owned.

create: (Interop, fail, isGroup, layouts, metadata, operation, pointerTypes, providerContext, storage, storages, voidDescriptor) => {
    pointerType: null
    physical: null
    nativeType: null

    methods: {
        pointerType: (library, pointee) => {
            result: null
            if(pointerTypes.containsKey(pointee)) {
                result = pointerTypes.at(pointee)
            } else {
                result = operation(library, "pointerType", pointee === voidDescriptor)
                pointerTypes[pointee] = result
            }
            result
        }

        // Provider physical metadata of one storage layout, composed incrementally
        // from the sizes, alignments, member names, offsets, counts and strides this
        // module computed. The provider validates it; it never computes a layout.
        physical: (layout) => {
            result: null
            if(storages.containsKey(layout)) {
                result = storages.at(layout)
            } else {
                record: storage(layout)
                native: providerContext()
                identity: pointerType(native, layout)
                kind: record.layoutKind
                composed: null
                if(kind == "scalar") {
                    composed = operation(native, "scalarStorage", Interop.readMember(native, record.kind),
                        record.size, record.align, identity)
                }
                if(kind == "pointer") {
                    composed = operation(native, "pointerStorage",
                        pointerType(native, record.parts.pointee), identity)
                }
                if(kind == "nullablePointer") {
                    composed = operation(native, "pointerStorage",
                        operation(native, "nullablePointerType", pointerType(native, record.parts.pointee)),
                        identity)
                }
                if((kind == "struct") || (kind == "union")) {
                    composed = operation(native, "aggregateStorage", kind, record.size, record.align,
                        identity)
                    for(entry in record.parts.members) {
                        composed = operation(native, "memberStorage", composed, entry.name, entry.offset,
                            physical(entry.layout))
                    }
                }
                if(kind == "array") {
                    composed = operation(native, "arrayStorage", physical(record.parts.element),
                        record.parts.count, record.parts.stride, identity)
                }
                storages[layout] = composed
                layouts[composed] = layout
                result = composed
            }
            result
        }

        nativeType: (library, descriptor) => {
            record: metadata(descriptor)
            result: null
            if(record.library !== null) {
                (record.library === library).ifFalse(() => fail())
                result = record.native
            } else {
                if(record.kind == "out") {
                    result = operation(library, "out", nativeType(library, record.target))
                } else {
                    if(record.kind == "pointer") {
                        result = pointerType(library, record.parts.pointee)
                    } else {
                        if(record.kind == "nullablePointer") {
                            result = operation(library, "nullablePointerType", nativeType(library, record.target))
                        } else {
                            if(record.kind == "borrowedPointer") {
                                result = operation(library, "borrowedPointerType", nativeType(library, record.target))
                            } else {
                                // A by-value group uses the session's physical storage metadata.
                                if(isGroup(record)) {
                                    result = physical(descriptor)
                                } else {
                                    result = Interop.readMember(library, record.kind)
                                }
                            }
                        }
                    }
                }
            }
            result
        }
    }

    // Bind private operations once; factory-created closures use normal completion.
    pointerType = methods.pointerType
    physical = methods.physical
    nativeType = methods.nativeType

    {
        pointerType: pointerType
        physical: physical
        nativeType: nativeType
    }
}
