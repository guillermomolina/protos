//! Standard Library TLS client (D220–S12, TLS.md).
//!
//! `Client.handshake(duplex, serverIdentity, trust, options)` performs one TLS
//! client handshake over a caller-supplied, already connected duplex
//! (`ByteReadable` and `ByteWritable`) and answers a fresh `Future` of a secure
//! duplex (`read`, `write`, `close`), delivered only after the peer chain
//! verified against `trust` and the peer certificate presented
//! `serverIdentity`. It borrows `duplex` and never closes it.
//! `Client.handshake.owning(...)` additionally requires `Closable` and closes
//! `duplex` exactly once: on a failed or cancelled handshake, or when the
//! secure duplex is closed.
//!
//! `serverIdentity` is a DNS name or an `IpAddress`. A DNS reference name is
//! an ASCII wire name (TLS.md §4) whose labels are NR-LDH labels or strict
//! IDNA2008 A-labels; every other reserved label and every Unicode (U-label)
//! input is rejected, never converted. `trust`
//! is `Trust.anchors(certificates)`, `Trust.javaCacerts()` or
//! `Trust.system()`; `options` is an ordinary object with the optional fields
//! `minimumVersion`, `alpn`, `maxHandshakeBytes` and `maxQueuedWriteBytes`.
//! There is no default trust. The facility acquires no network, name
//! resolution, URL, clock or other ambient authority.

/// The prototype of every TLS failure. Each failure is a fresh occurrence
/// whose own `kind` is one of "trustUnavailable", "backendUnavailable",
/// "untrustedPeer", "identityMismatch", "protocolVersion", "alpn",
/// "handshakeFailure", "protocol", "limit" or "truncated". A failure caused
/// by the underlying transport is that transport Error instead.
TlsError: Error {}

/// Explicit trust descriptors. `anchors(certificates)` takes 1..256 DER X.509
/// CA certificates as Bytes (each at most 65536 octets, 4194304 in total) and
/// snapshots them; `javaCacerts()` selects only the Java cacerts material,
/// read for each handshake; `system()` selects operating-system trust, for
/// which this release has no adapter, so handshakes using it fail with kind
/// "trustUnavailable". A malformed argument signals an Error synchronously.
Trust: ((facility) => {
    TrustSource: import("std:tls/internal/TrustSource")
    TrustSource.constructors(facility)
})(_tlsBackendFacility)

/// The TLS client handshake.
Client: ((facility) => {
    Options: import("std:tls/internal/Options")
    Identity: import("std:tls/internal/Identity")
    TrustSource: import("std:tls/internal/TrustSource")
    Session: import("std:tls/internal/Session")

    // TLS.md §2.1: every argument is validated before any effect. An invalid
    // call answers an already failed Future without a Task, custody or I/O;
    // an admitted call creates exactly one handshake Task.
    admit: (duplex, serverIdentity, trust, options, owning) => {
        valid: facility.provides(duplex, "read") && facility.provides(duplex, "write")
        if(valid && owning) {
            valid = facility.closable(duplex)
        }
        reference: null
        if(valid) {
            reference = Identity.reference(facility, serverIdentity)
            valid = reference !== null
        }
        if(valid) {
            valid = TrustSource.recognizes(facility, trust)
        }
        captured: null
        if(valid) {
            captured = Options.capture(facility, options)
            valid = captured !== null
        }

        answer: null
        if(valid) {
            answer = facility.startService(
                Session.serviceBody(facility, TlsError, duplex, reference, trust, captured, owning)
            )
        } else {
            answer = facility.failed(InvalidIOArgument {})
        }
        answer
    }

    // Performs one borrowed handshake over duplex; see the module documentation.
    entry: (duplex, serverIdentity, trust, options) => {
        admit(duplex, serverIdentity, trust, options, false)
    }
    // Performs one handshake and takes custody of duplex, closing it exactly once.
    entry.owning: (duplex, serverIdentity, trust, options) => {
        admit(duplex, serverIdentity, trust, options, true)
    }

    client: {
        handshake: entry
    }
    client
})(_tlsBackendFacility)

// The runtime-provisioned facility is captured privately above; it is not
// module surface.
context.removeSlot("_tlsBackendFacility")
