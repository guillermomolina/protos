//! Internal D242 MODULE projection of selected TLS identity operations.
//! Not a supported public Standard Library API; the actual implementation
//! remains the relative private SOURCE ../Identity.protos.

IdentitySource: import("../Identity.protos")

this.reference: IdentitySource.reference
this.dnsName: IdentitySource.dnsName
this.matches: IdentitySource.matches

// Internal IDNA2008 and RFC 3492 testable operations.
this.punycodeDecode: IdentitySource.punycodeDecode
this.punycodeEncode: IdentitySource.punycodeEncode
this.derivedProperty: IdentitySource.derivedProperty
this.contextJ: IdentitySource.contextJ
this.contextO: IdentitySource.contextO
this.bidiRule: IdentitySource.bidiRule
