//! Internal handshake session of std:tls/Client (D220–S12, TLS.md §§2.1, 3–5,
//! 8, 10). This module is an unpublished implementation artifact, not an
//! approved Standard Library API. One admitted handshake runs entirely in its
//! one service Task: trust resolution, engine provisioning, octet pumping,
//! handshake accounting, identity verification and, for an owning handshake
//! that does not deliver a secure duplex, the close of the lower duplex.

Errors: import("std:tls/internal/Errors")
TrustSource: import("std:tls/internal/TrustSource")
Identity: import("std:tls/internal/Identity")
SecureDuplex: import("std:tls/internal/SecureDuplex")

// One lower read never exceeds one maximal encrypted record (§10).
encryptedRecordBytes: 18432

/// Answers the zero-argument service body of one admitted handshake, to be run
/// as its one service Task. reference is the Identity.reference snapshot,
/// options the Options.capture snapshot. The body answers the secure duplex
/// only after negotiation, chain, version, suite, ALPN and reference identity
/// all succeeded.
serviceBody: (facility, TlsError, duplex, reference, trust, options, owning) => {
    delivered: false
    handshakeBytes: 0

    fail: (errorKind) => {
        Errors.tlsError(TlsError, errorKind).signal()
    }

    // Counts every handshake octet in either direction against the bound.
    account: (size) => {
        handshakeBytes = handshakeBytes + size
        if(handshakeBytes > options.maxHandshakeBytes) {
            fail("limit")
        }
    }

    flush: (engine) => {
        if(engine.hasCiphertext()) {
            ciphertext: engine.takeCiphertext()
            account(ciphertext.size())
            duplex.write(ciphertext).value()
        }
    }

    // Offers the alert the backend prepared for a failure, without waiting
    // for or depending on its delivery.
    offerAlert: (engine) => {
        Error.handle(
            () => {
                if(engine.hasCiphertext()) {
                    duplex.write(engine.takeCiphertext())
                }
            },
            (error) => {
                error
            }
        )
    }

    // Waits for future even through a cancellation unwind. An Error already
    // observed by the body is not signaled again from the cleanup: a second
    // signal would escape a caller's consumed handler (ERRORS.md, selected
    // handler deactivation precedes unwind cleanup).
    awaitThroughCancellation: (future) => {
        observed: false
        (() => {
            Error.handle(
                () => {
                    future.value()
                },
                (error) => {
                    observed = true
                    error.signal()
                }
            )
        }).ensure(() => {
            if(!observed) {
                future.value()
            }
        })
    }

    negotiate: (engine) => {
        while(!engine.established()) {
            fact: engine.advance()
            if(fact !== null) {
                offerAlert(engine)
                Errors.fromFact(TlsError, fact, true).signal()
            }
            flush(engine)
            if(!engine.established()) {
                capacity: engine.receiveCapacity()
                // A full receive buffer without one complete record (§10).
                if(capacity == 0) {
                    fail("limit")
                }
                if(capacity > encryptedRecordBytes) {
                    capacity = encryptedRecordBytes
                }
                received: duplex.read(capacity).value()
                if(received === null) {
                    // The next advance reports the unauthenticated end.
                    engine.endOfInput()
                } else {
                    account(received.size())
                    engine.offer(received)
                }
            }
        }
        // The client's final flight follows establishment.
        flush(engine)
    }

    process: () => {
        anchors: TrustSource.resolve(facility, TlsError, trust)
        engine: facility.startEngine(anchors, reference.sni, options.tls13Only, options.offerHttp11)
        if(String.recognizes(engine)) {
            Errors.fromFact(TlsError, engine, true).signal()
        }
        negotiate(engine)
        // engine.established() proves chain, version, suite and ALPN only.
        Identity.matches(reference, engine.peerDnsNames(), engine.peerIpAddresses()).ifFalse(() => {
            fail("identityMismatch")
        })
        secure: SecureDuplex.create(facility, TlsError, duplex, engine, options, owning)
        // Custody of an owned duplex passes to the secure duplex here.
        delivered = true
        secure
    }

    // As in std:http/Server: an already-requested Actor-termination
    // cancellation is delivered here, so the mandatory close runs as the
    // cleanup of that cancellation unwind (D121).
    closeOwned: () => {
        (() => {
            facility.enterService()
        }).ensure(() => {
            awaitThroughCancellation(duplex.close())
        })
    }

    // TLS.md §8 precedence, arbitrated here without changing Core ensure:
    // the primary handshake Error survives a failing owned close; with no
    // primary Error (success never closes; a cancellation unwind is not an
    // Error and passes Error.handle untouched), a close Error supersedes
    // under the ordinary ensure rule.
    run: () => {
        answer: null
        primary: null
        (() => {
            Error.handle(
                () => {
                    // First instruction: a cancellation requested before the
                    // service started unwinds from here, through the cleanup.
                    facility.enterService()
                    answer = process()
                },
                (error) => {
                    primary = error
                    error
                }
            )
        }).ensure(() => {
            if(owning && !delivered) {
                if(primary === null) {
                    closeOwned()
                } else {
                    Error.handle(
                        () => {
                            closeOwned()
                        },
                        (cleanupError) => {
                            // The close was attempted; its Error yields.
                            cleanupError
                        }
                    )
                }
            }
        })
        if(primary !== null) {
            primary.signal()
        }
        answer
    }

    run
}
