//! Internal options capture of std:tls/Client (D220–S12, TLS.md §6). This
//! module is an unpublished implementation artifact, not an approved Standard
//! Library API.

maxSigned32: 2147483647

optionNames: [
    "minimumVersion",
    "alpn",
    "maxHandshakeBytes",
    "maxQueuedWriteBytes"
]

// Whether value is an Integer in 1..2147483647, without comparing a
// non-Integer.
boundedCount: (value) => {
    valid: false
    if(Integer.recognizes(value)) {
        valid = (value >= 1) && (value <= maxSigned32)
    }
    valid
}

// Whether value is the String text, without comparing another family.
exactly: (value, text) => {
    valid: false
    if(String.recognizes(value)) {
        valid = value == text
    }
    valid
}

/// Validates options (an ordinary object whose own slots are only the
/// recognized option names, each with an admissible value, and none of which
/// is reachable only by delegation) and answers a private frozen snapshot of
/// every effective option, or null when options is not admissible. facility
/// is the private backend bridge of std:tls/Client.
capture: (facility, options) => {
    valid: facility.ordinaryObject(options)
    if(valid) {
        options.slotNames().each((name) => {
            if(valid) {
                value: options.slotValue(name)
                if(name == "minimumVersion") {
                    valid = exactly(value, "1.2") || exactly(value, "1.3")
                } else {
                    if(name == "alpn") {
                        valid = (value === null) || exactly(value, "http/1.1")
                    } else {
                        if((name == "maxHandshakeBytes") || (name == "maxQueuedWriteBytes")) {
                            valid = boundedCount(value)
                        } else {
                            valid = false
                        }
                    }
                }
            }
        })
    }
    // A recognized field obtained only by delegation is inadmissible (§6);
    // ancestors are inspected reflectively, never read.
    if(valid) {
        ancestor: options.parent()
        while(valid && (ancestor !== Object)) {
            optionNames.each((name) => {
                if(ancestor.hasSlot(name) && !options.hasSlot(name)) {
                    valid = false
                }
            })
            ancestor = ancestor.parent()
        }
    }

    pick: (name, fallback) => {
        chosen: fallback
        if(options.hasSlot(name)) {
            chosen = options.slotValue(name)
        }
        chosen
    }

    captured: null
    if(valid) {
        captured = {
            tls13Only: pick("minimumVersion", "1.2") == "1.3"
            offerHttp11: pick("alpn", "http/1.1") !== null
            maxHandshakeBytes: pick("maxHandshakeBytes", 1048576)
            maxQueuedWriteBytes: pick("maxQueuedWriteBytes", 33554432)
        }
        captured.freeze()
    }
    captured
}
