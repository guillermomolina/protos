//! Internal TlsError construction of std:tls/Client (D220–S12, TLS.md §9).
//! This module is an unpublished implementation artifact, not an approved
//! Standard Library API.

/// Answers a fresh occurrence of TlsError whose own kind is errorKind.
tlsError: (TlsError, errorKind) => {
    occurrence: TlsError {
        kind: errorKind
    }
    occurrence
}

/// Answers a fresh TlsError for a backend fact name. Only facts the backend
/// established conclusively select a specific kind; anything else, including
/// an unknown fact, is the general kind of the phase: "handshakeFailure"
/// while handshaking, "protocol" afterwards. Exception text and peer alerts
/// are never consulted.
fromFact: (TlsError, fact, handshaking) => {
    errorKind: "protocol"
    if(handshaking) {
        errorKind = "handshakeFailure"
    }
    if(fact == "BACKEND_UNAVAILABLE") {
        errorKind = "backendUnavailable"
    }
    if(fact == "TRUST_MATERIAL_UNAVAILABLE") {
        errorKind = "trustUnavailable"
    }
    if(fact == "UNTRUSTED_CHAIN") {
        errorKind = "untrustedPeer"
    }
    if(fact == "NEGOTIATED_VERSION_OUTSIDE_POLICY") {
        errorKind = "protocolVersion"
    }
    if(fact == "NEGOTIATED_ALPN_OUTSIDE_POLICY") {
        errorKind = "alpn"
    }
    if(fact == "HANDSHAKE_FAILED") {
        errorKind = "handshakeFailure"
    }
    if(fact == "TRUNCATED") {
        errorKind = "truncated"
    }
    tlsError(TlsError, errorKind)
}
