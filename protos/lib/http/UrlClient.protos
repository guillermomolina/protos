//! Standard Library one-shot HTTP/1.1 URL client (D222-C, HTTP.md §18).
//!
//! `UrlClient.requestOne(authorities, url, request, limits)` sends one request
//! to an absolute `http` or `https` URL and answers a fresh `Future` of the
//! buffered response `{status, headers, body}`, whose `body` is detached
//! Bytes. `authorities` is `{network, resolver, trust}`: the explicitly
//! granted `Network` used for the TCP connection, the explicitly granted
//! `Resolver` used only for a host name (it may be null for a numeric host),
//! and the explicit `std:tls/Client` trust used only for `https`. `request` is
//! `{method, headers, body}`; the `Host` field and the origin-form target come
//! from the URL. `limits` are the `std:http/Client` limits.
//!
//! The UrlClient composes `std:network`, `std:tls/Client` and
//! `std:http/Client`; it acquires no authority implicitly, has no default
//! trust, and never follows redirects, retries, pools connections, stores
//! cookies or decodes content. Any final status, including 3xx, 4xx and 5xx,
//! is a successful response.

/// The one-shot URL client.
UrlClient: ((facility) => {
    ClientLimits: import("std:http/internal/ClientLimits")
    ClientHead: import("std:http/internal/ClientHead")
    UrlRequest: import("std:http/internal/UrlRequest")
    UrlSession: import("std:http/internal/UrlSession")

    // HTTP.md §18.3: semantic validation and the complete snapshot precede
    // every effect. An invalid call answers an already failed Future without
    // a Task, a lookup or a connection; an admitted call creates exactly one
    // service Task.
    requestOne: (authorities, url, request, limits) => {
        captured: ClientLimits.capture(facility, limits)
        valid: captured !== null
        prepared: null
        if(valid) {
            prepared = UrlRequest.prepare(facility, authorities, url, request)
            valid = prepared !== null
        }
        if(valid) {
            valid = ClientHead.prepareRequest(facility, prepared.request) !== null
        }

        answer: null
        if(valid) {
            answer = facility.startService(UrlSession.serviceBody(facility, prepared, captured))
        } else {
            answer = facility.failed(InvalidIOArgument {})
        }
        answer
    }

    client: {
        requestOne: requestOne
    }
    client
})(_httpAsyncFacility)

// The runtime-provisioned facility is captured privately above; it is not
// module surface.
context.removeSlot("_httpAsyncFacility")
