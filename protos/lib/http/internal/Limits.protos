//! Internal HTTP limit capture (HTTP.md §10) shared by std:http/Server
//! admission and std:http/Host construction (§15.2), so that both validate
//! one limits object by the same rule. This module is an unpublished
//! implementation artifact, not an approved Standard Library API.

maxSigned64: 9223372036854775807

limitNames: [
    "maxRequestLineBytes",
    "maxHeaderBytes",
    "maxHeaderFields",
    "maxChunkLineBytes",
    "maxTrailerBytes",
    "maxTrailerFields",
    "maxRequestBodyBytes",
    "maxPrefetchBytes",
    "ioChunkBytes"
]

/// Validates limits and answers a private frozen snapshot of every effective
/// limit, or null when limits is not admissible. facility is the private
/// asynchronous bridge of the calling HTTP module.
capture: (facility, limits) => {
    valid: true
    if(limits !== null) {
        valid = facility.ordinaryObject(limits)
        if(valid) {
            limits.slotNames().each((name) => {
                if(valid) {
                    known: false
                    limitNames.each((limitName) => {
                        if(name == limitName) {
                            known = true
                        }
                    })
                    if(known) {
                        value: limits.slotValue(name)
                        if(Integer.recognizes(value)) {
                            if((value <= 0) || (value > maxSigned64)) {
                                valid = false
                            }
                        } else {
                            valid = false
                        }
                    } else {
                        valid = false
                    }
                }
            })
        }
    }

    pick: (name, fallback) => {
        chosen: fallback
        if((limits !== null) && limits.hasSlot(name)) {
            chosen = limits.slotValue(name)
        }
        chosen
    }

    captured: null
    if(valid) {
        captured = {
            maxRequestLineBytes: pick("maxRequestLineBytes", 8192)
            maxHeaderBytes: pick("maxHeaderBytes", 32768)
            maxHeaderFields: pick("maxHeaderFields", 100)
            maxChunkLineBytes: pick("maxChunkLineBytes", 8192)
            maxTrailerBytes: pick("maxTrailerBytes", 8192)
            maxTrailerFields: pick("maxTrailerFields", 100)
            maxRequestBodyBytes: pick("maxRequestBodyBytes", 33554432)
            maxPrefetchBytes: pick("maxPrefetchBytes", 65536)
            ioChunkBytes: pick("ioChunkBytes", 16384)
        }
        captured.freeze()
    }
    captured
}
