//! Internal HTTP/1.1 message-body framing for the future std:http/Server driver
//! (D215, LIB025-B1) and for std:http/Client (D218-B). This module is an
//! unpublished implementation artifact, not an approved Standard Library API. It
//! performs no I/O and owns no authority: it only frames request-body and
//! response-body octets and encodes response-chunk octets.

MessageSyntax: import("std:http/internal/MessageSyntax")

// The shared directional framing engine. config holds the framing mode, the
// declared content length, the chunk-line, trailer, and decoded-body budgets,
// and the failure kind and status of malformed framing and of an exceeded
// limit. Request and response framing differ only in this configuration, so
// one chunk-size, chunk-extension, chunk-data, CRLF, and trailer machine
// serves both directions.
bodyFramer: (config) => {
    // Scalars are captured once; later mutation of the configuration is ignored.
    framing: config.framing
    declaredLength: config.contentLength
    maxChunkLineBytes: config.maxChunkLineBytes
    maxTrailerBytes: config.maxTrailerBytes
    maxTrailerFields: config.maxTrailerFields
    maxBodyBytes: config.maxBodyBytes
    malformedKind: config.malformedKind
    malformedStatus: config.malformedStatus
    limitKind: config.limitKind
    limitStatus: config.limitStatus

    if(framing == "CONTENT_LENGTH") {
        Integer.recognizes(declaredLength).ifFalse(() => {
            Error().signal()
        })
        if(declaredLength < 0) {
            Error().signal()
        }
    }

    maxSigned64: 9223372036854775807

    // Private rejection signal; only feed and endOfInput handle it.
    Rejection: Error {}
    rejectKind: null
    rejectStatus: 0

    reject: (kind, status) => {
        rejectKind = kind
        rejectStatus = status
        occurrence: Rejection {}
        occurrence.signal()
    }

    malformed: () => {
        reject(malformedKind, malformedStatus)
    }

    overLimit: () => {
        reject(limitKind, limitStatus)
    }

    // ------------------------------------------------------------ framer state

    // NONE and CONTENT_LENGTH use "BODY"; CHUNKED uses SIZE_LINE, DATA,
    // DATA_CR, DATA_LF, and TRAILER_LINE; CLOSE_DELIMITED uses UNTIL_EOF.
    // COMPLETE and REJECTED are terminal.
    phase: "COMPLETE"
    remaining: 0
    totalContent: 0
    line: null
    pendingCr: false
    chunkLineBytes: 0
    trailerBytes: 0
    trailerFields: 0

    if(framing == "CONTENT_LENGTH") {
        if(declaredLength > maxBodyBytes) {
            // Defensive: an accepted head never exceeds the body budget.
            phase = "REJECTED"
            rejectKind = limitKind
            rejectStatus = limitStatus
        } else {
            if(declaredLength > 0) {
                phase = "BODY"
                remaining = declaredLength
            }
        }
    }
    if(framing == "CHUNKED") {
        phase = "SIZE_LINE"
        line = Encoding.UTF8.encode("")
    }
    if(framing == "CLOSE_DELIMITED") {
        phase = "UNTIL_EOF"
    }

    // Answers the index after a complete quoted-string, rejecting a malformed one.
    skipQuotedString: (bytes, start, end) => {
        index: MessageSyntax.quotedStringEnd(bytes, start, end)
        if(index < 0) {
            malformed()
        }
        index
    }

    // ------------------------------------------------------------ chunked lines

    // chunk-size [ chunk-ext ], without CRLF. Extensions are validated and
    // discarded; the size is checked against the budget only after the whole
    // line is syntactically valid.
    parseSizeLine: () => {
        size: line.size()
        chunkSize: 0
        index: 0
        while((index < size) && (MessageSyntax.hexValue(line[index]) >= 0)) {
            digit: MessageSyntax.hexValue(line[index])
            if(chunkSize > (maxSigned64 - digit).div(16)) {
                malformed()
            }
            chunkSize = chunkSize * 16 + digit
            index = index + 1
        }
        if(index == 0) {
            malformed()
        }

        // chunk-ext = *( BWS ";" BWS chunk-ext-name [ BWS "=" BWS chunk-ext-val ] )
        while(index < size) {
            index = MessageSyntax.skipWhitespace(line, index, size)
            if(index >= size) {
                malformed()
            }
            if(line[index] != 59) {
                malformed()
            }
            index = MessageSyntax.skipWhitespace(line, index + 1, size)
            nameEnd: MessageSyntax.skipToken(line, index, size)
            if(nameEnd == index) {
                malformed()
            }
            index = nameEnd
            afterName: MessageSyntax.skipWhitespace(line, index, size)
            if((afterName < size) && (line[afterName] == 61)) {
                index = MessageSyntax.skipWhitespace(line, afterName + 1, size)
                if(index >= size) {
                    malformed()
                }
                if(line[index] == 34) {
                    index = skipQuotedString(line, index, size)
                } else {
                    valueEnd: MessageSyntax.skipToken(line, index, size)
                    if(valueEnd == index) {
                        malformed()
                    }
                    index = valueEnd
                }
            }
        }

        if(chunkSize == 0) {
            phase = "TRAILER_LINE"
        } else {
            if(chunkSize > (maxBodyBytes - totalContent)) {
                overLimit()
            }
            remaining = chunkSize
            phase = "DATA"
        }
    }

    // field-name ":" OWS field-value OWS; validated and discarded.
    parseTrailerLine: () => {
        size: line.size()

        // obs-fold
        if(MessageSyntax.isWhitespace(line[0])) {
            malformed()
        }
        // Whitespace before ":" is not a tchar, so it ends the name early.
        nameEnd: MessageSyntax.skipToken(line, 0, size)
        if((nameEnd == 0) || (nameEnd >= size) || (line[nameEnd] != 58)) {
            malformed()
        }
        index: nameEnd + 1
        while(index < size) {
            if(!MessageSyntax.isFieldValueOctet(line[index])) {
                malformed()
            }
            index = index + 1
        }
    }

    completeLine: () => {
        if(phase == "SIZE_LINE") {
            parseSizeLine()
        } else {
            if(line.size() == 0) {
                phase = "COMPLETE"
            } else {
                trailerFields = trailerFields + 1
                if(trailerFields > maxTrailerFields) {
                    overLimit()
                }
                parseTrailerLine()
            }
        }
        line = Encoding.UTF8.encode("")
        chunkLineBytes = 0
    }

    // Consumes one framing octet of a size line, a chunk-data delimiter, or a
    // trailer line.
    consumeOctet: (octet) => {
        if(phase == "DATA_CR") {
            if(octet != 13) {
                malformed()
            }
            phase = "DATA_LF"
        } else {
            if(phase == "DATA_LF") {
                if(octet != 10) {
                    malformed()
                }
                phase = "SIZE_LINE"
            } else {
                if(phase == "SIZE_LINE") {
                    chunkLineBytes = chunkLineBytes + 1
                    if(chunkLineBytes > maxChunkLineBytes) {
                        overLimit()
                    }
                } else {
                    trailerBytes = trailerBytes + 1
                    if(trailerBytes > maxTrailerBytes) {
                        overLimit()
                    }
                }
                if(pendingCr) {
                    if(octet != 10) {
                        malformed()
                    }
                    pendingCr = false
                    completeLine()
                } else {
                    if(octet == 13) {
                        pendingCr = true
                    } else {
                        if(octet == 10) {
                            malformed()
                        }
                        line.add(octet)
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ results

    resultOf: (resultState, consumed, content) => {
        result: {
            state: resultState
            consumed: consumed
            content: content
            failure: null
        }
        result
    }

    rejectedResult: (consumed) => {
        result: {
            state: "REJECTED"
            consumed: consumed
            content: null
            failure: {
                kind: rejectKind
                status: rejectStatus
            }
        }
        result
    }

    terminalize: () => {
        phase = "REJECTED"
        line = null
        pendingCr = false
    }

    framer: null
    framer = {
        feed: (source, offset, length, maxContentBytes) => {
            (Integer.recognizes(offset) && Integer.recognizes(length) && Integer.recognizes(maxContentBytes)).ifFalse(() => {
                Error().signal()
            })
            if(offset < 0) {
                Error().signal()
            }
            if(length < 0) {
                Error().signal()
            }
            if(maxContentBytes <= 0) {
                Error().signal()
            }
            // Bounds are established without computing offset + length.
            sourceSize: source.size()
            if(offset > sourceSize) {
                Error().signal()
            }
            if(length > (sourceSize - offset)) {
                Error().signal()
            }

            end: offset + length
            index: offset
            content: null
            result: null

            if(phase == "COMPLETE") {
                result = resultOf("COMPLETE", 0, null)
            }
            if(phase == "REJECTED") {
                result = rejectedResult(0)
            }

            if(phase == "BODY") {
                take: remaining
                if(length < take) {
                    take = length
                }
                if(maxContentBytes < take) {
                    take = maxContentBytes
                }
                if(take > 0) {
                    content = MessageSyntax.copyRange(source, offset, offset + take)
                    remaining = remaining - take
                    totalContent = totalContent + take
                    index = offset + take
                    if(remaining == 0) {
                        phase = "COMPLETE"
                    }
                }
            }

            if(result === null) {
                Rejection.handle(
                    () => {
                        if((phase == "UNTIL_EOF") && (length > 0)) {
                            // Delivers octets up to the decoded-body budget;
                            // the first octet beyond it rejects the body.
                            allowed: maxBodyBytes - totalContent
                            if(allowed == 0) {
                                overLimit()
                            }
                            take: length
                            if(maxContentBytes < take) {
                                take = maxContentBytes
                            }
                            if(allowed < take) {
                                take = allowed
                            }
                            content = MessageSyntax.copyRange(source, offset, offset + take)
                            totalContent = totalContent + take
                            index = offset + take
                        }
                        // Decoded content ends the call before any later octet
                        // is inspected.
                        while((content === null) && (phase != "COMPLETE") && (phase != "BODY") && (phase != "UNTIL_EOF") && (index < end)) {
                            if(phase == "DATA") {
                                take: remaining
                                if((end - index) < take) {
                                    take = end - index
                                }
                                if(maxContentBytes < take) {
                                    take = maxContentBytes
                                }
                                content = MessageSyntax.copyRange(source, index, index + take)
                                index = index + take
                                remaining = remaining - take
                                totalContent = totalContent + take
                                if(remaining == 0) {
                                    phase = "DATA_CR"
                                }
                            } else {
                                octet: source[index]
                                index = index + 1
                                consumeOctet(octet)
                            }
                        }
                    },
                    (error) => {
                        terminalize()
                        result = rejectedResult(index - offset)
                        error
                    }
                )
            }

            if(result === null) {
                if(content !== null) {
                    result = resultOf("CONTENT", index - offset, content)
                } else {
                    if(phase == "COMPLETE") {
                        line = null
                        result = resultOf("COMPLETE", index - offset, null)
                    } else {
                        result = resultOf("NEED_MORE", index - offset, null)
                    }
                }
            }

            result
        }

        endOfInput: () => {
            result: null
            if(phase == "COMPLETE") {
                result = resultOf("COMPLETE", 0, null)
            } else {
                if(phase != "REJECTED") {
                    if(phase == "UNTIL_EOF") {
                        // Clean physical EOF is the end of a close-delimited body.
                        phase = "COMPLETE"
                    } else {
                        // Physical EOF before the logical end of the body.
                        rejectKind = malformedKind
                        rejectStatus = malformedStatus
                        terminalize()
                    }
                }
                if(phase == "COMPLETE") {
                    result = resultOf("COMPLETE", 0, null)
                } else {
                    result = rejectedResult(0)
                }
            }
            result
        }

        state: () => {
            answer: "OPEN"
            if(phase == "COMPLETE") {
                answer = "COMPLETE"
            }
            if(phase == "REJECTED") {
                answer = "REJECTED"
            }
            answer
        }
    }

    framer
}

/// Answers a stateful request-body framer for an accepted request head.
/// feed(bytes, offset, length, maxContentBytes) and endOfInput() answer
/// {state, consumed, content, failure}; state() answers "OPEN", "COMPLETE", or
/// "REJECTED". consumed counts only octets taken from the supplied slice, and
/// octets after the logical end of the body are never consumed.
requestBodyFramer: (head, limits) => {
    framing: head.framing
    ((framing == "NONE") || (framing == "CONTENT_LENGTH") || (framing == "CHUNKED")).ifFalse(() => {
        Error().signal()
    })
    config: {
        framing: framing
        contentLength: head.contentLength
        maxChunkLineBytes: limits.maxChunkLineBytes
        maxTrailerBytes: limits.maxTrailerBytes
        maxTrailerFields: limits.maxTrailerFields
        maxBodyBytes: limits.maxRequestBodyBytes
        malformedKind: "malformedRequest"
        malformedStatus: 400
        limitKind: "requestLimit"
        limitStatus: 413
    }
    bodyFramer(config)
}

/// Answers a stateful response-body framer (HTTP.md §16.7) with the
/// requestBodyFramer protocol. head.framing is "NONE", "CONTENT_LENGTH",
/// "CHUNKED", or "CLOSE_DELIMITED"; limits are the captured Client limits.
/// Malformed framing, including physical EOF before the end of a
/// Content-Length or chunked body, fails as "malformedResponse"; an exceeded
/// chunk-line, trailer, or decoded-body budget fails as "responseLimit". A
/// close-delimited body completes at clean physical EOF (endOfInput()).
/// Response failures carry no HTTP status.
responseBodyFramer: (head, limits) => {
    framing: head.framing
    ((framing == "NONE") || (framing == "CONTENT_LENGTH") || (framing == "CHUNKED") || (framing == "CLOSE_DELIMITED")).ifFalse(() => {
        Error().signal()
    })
    config: {
        framing: framing
        contentLength: head.contentLength
        maxChunkLineBytes: limits.maxChunkLineBytes
        maxTrailerBytes: limits.maxTrailerBytes
        maxTrailerFields: limits.maxTrailerFields
        maxBodyBytes: limits.maxResponseBodyBytes
        malformedKind: "malformedResponse"
        malformedStatus: null
        limitKind: "responseLimit"
        limitStatus: null
    }
    bodyFramer(config)
}

/// Answers new Bytes holding one response chunk: lowercase hex-size CRLF
/// payload CRLF. The payload is copied first and never modified; an empty
/// payload signals an Error.
encodeResponseChunk: (payload) => {
    captured: Encoding.UTF8.encode("")
    index: 0
    while(index < payload.size()) {
        captured.add(payload[index])
        index = index + 1
    }
    if(captured.size() == 0) {
        Error().signal()
    }

    output: Encoding.UTF8.encode("")

    appendHex: null
    appendHex = (value) => {
        quotient: value.div(16)
        if(quotient > 0) {
            appendHex(quotient)
        }
        digit: value.mod(16)
        if(digit < 10) {
            output.add(48 + digit)
        } else {
            output.add(87 + digit)
        }
    }

    appendHex(captured.size())
    output.add(13)
    output.add(10)
    index = 0
    while(index < captured.size()) {
        output.add(captured[index])
        index = index + 1
    }
    output.add(13)
    output.add(10)
    output
}

/// Answers new Bytes holding the final response chunk "0" CRLF CRLF, without
/// trailers.
finalResponseChunk: () => {
    Encoding.Latin1.encode("0\r\n\r\n")
}
