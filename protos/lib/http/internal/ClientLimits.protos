//! Internal limit capture of std:http/Client (D218-B, HTTP.md §16.12). This
//! module is an unpublished implementation artifact, not an approved Standard
//! Library API. It is distinct from Limits, whose server limit names and
//! signed-64 range it does not share.

maxSigned32: 2147483647

limitNames: [
    "maxStatusLineBytes",
    "maxHeaderBytes",
    "maxHeaderFields",
    "maxChunkLineBytes",
    "maxTrailerBytes",
    "maxTrailerFields",
    "maxResponseBodyBytes",
    "maxInformationalResponses",
    "maxPrefetchBytes",
    "ioChunkBytes"
]

/// Validates limits (null or an ordinary object whose own slots are only
/// recognized limit names, each a positive Integer no greater than
/// 2147483647) and answers a private frozen snapshot of every effective
/// limit, or null when limits is not admissible. Inherited slots are never
/// read. facility is the private asynchronous bridge of std:http/Client.
capture: (facility, limits) => {
    valid: true
    if(limits !== null) {
        valid = facility.ordinaryObject(limits)
        if(valid) {
            limits.slotNames().each((name) => {
                if(valid) {
                    known: false
                    limitNames.each((limitName) => {
                        if(name == limitName) {
                            known = true
                        }
                    })
                    if(known) {
                        value: limits.slotValue(name)
                        if(Integer.recognizes(value)) {
                            if((value <= 0) || (value > maxSigned32)) {
                                valid = false
                            }
                        } else {
                            valid = false
                        }
                    } else {
                        valid = false
                    }
                }
            })
        }
    }

    pick: (name, fallback) => {
        chosen: fallback
        if((limits !== null) && limits.hasSlot(name)) {
            chosen = limits.slotValue(name)
        }
        chosen
    }

    captured: null
    if(valid) {
        captured = {
            maxStatusLineBytes: pick("maxStatusLineBytes", 8192)
            maxHeaderBytes: pick("maxHeaderBytes", 32768)
            maxHeaderFields: pick("maxHeaderFields", 100)
            maxChunkLineBytes: pick("maxChunkLineBytes", 8192)
            maxTrailerBytes: pick("maxTrailerBytes", 8192)
            maxTrailerFields: pick("maxTrailerFields", 100)
            maxResponseBodyBytes: pick("maxResponseBodyBytes", 33554432)
            maxInformationalResponses: pick("maxInformationalResponses", 8)
            maxPrefetchBytes: pick("maxPrefetchBytes", 65536)
            ioChunkBytes: pick("ioChunkBytes", 16384)
        }
        captured.freeze()
    }
    captured
}
