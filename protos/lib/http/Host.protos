//! Standard Library continuous HTTP/1.1 hosting (D216, HTTP.md §15).
//!
//! `Host.owning(listener, handlerModule, handlerBinding, options)` takes
//! custody of a live `TcpListener` of the calling Actor and services
//! successive TCP connections with `workers` Worker Actors of the same
//! Process. Each Worker receives only a `TcpAcceptor` derived from the
//! listener, resolves `handlerModule` and its own binding `handlerBinding`
//! itself, accepts by itself, and services each accepted connection exactly
//! once with `Server.serveOne.owning`. Admission is bounded by the fixed
//! per-Worker quotas of `maxConnections` and `maxPendingAccepts`.
//!
//! `Host.owningWithFactory(listener, factoryModule, factoryBinding,
//! initialization, options)` hosts exactly the same way (D225-A, HTTP.md
//! §15.13), except that each Worker builds its own handler: it receives its
//! own Actor-boundary copy of `initialization`, resolves its own binding
//! `factoryBinding` of `factoryModule`, and calls it exactly once with that
//! copy before it becomes ready. `initialization` may carry ordinary
//! transferable data and `ActorRef` values; live resources, Closures, Futures
//! and every other non-transferable value, including a `TcpAcceptor`, are
//! rejected as at any ordinary Actor boundary.
//!
//! The returned host is an Actor-local control object: `ready()`,
//! `shutdown("drain")`, `shutdown("abort")` and `termination()` answer fresh
//! local Futures resolving to that host. Cancelling such a Future abandons
//! only that observation. The host acquires no Network or other ambient
//! authority and defines no timeout.

/// The prototype of every hosting failure. Each failure is a fresh
/// occurrence whose `kind` is "startup", "listener", "worker", or
/// "shutdown".
HostError: Error {}

/// The continuous HTTP/1.1 host.
Host: ((facility) => {
    HostConfig: import("std:http/internal/HostConfig")
    HostLifecycle: import("std:http/internal/HostLifecycle")

    // HTTP.md §15.2: every construction argument is validated before any
    // effect. An invalid call signals a fresh InvalidIOArgument without
    // listener custody, Workers or I/O. Answers the captured configuration
    // and one TcpAcceptor per Worker.
    admit: (listener, moduleSpecifier, bindingName, options) => {
        config: HostConfig.capture(facility, options)
        valid: (config !== null) && String.recognizes(moduleSpecifier) && String.recognizes(bindingName)
        acceptors: null
        if(valid) {
            acceptors = HostConfig.acceptors(facility, listener, config.workers)
            valid = acceptors !== null
        }
        if(!valid) {
            invalid: InvalidIOArgument {}
            invalid.signal()
        }
        admitted: {
            config: config
            acceptors: acceptors
        }
        admitted
    }

    owning: (listener, handlerModule, handlerBinding, options) => {
        admitted: admit(listener, handlerModule, handlerBinding, options)
        config: admitted.config
        // Only the acceptor, the handler Strings, the quotas and the
        // captured limits cross into a Worker (HTTP.md §15.4).
        spawnWorker: (acceptor, connectionQuota, pendingQuota) => {
            Actor.spawn(
                "std:http/internal/HostWorker",
                "start",
                acceptor,
                handlerModule,
                handlerBinding,
                connectionQuota,
                pendingQuota,
                config.limits
            )
        }
        HostLifecycle.start(facility, HostError, listener, admitted.acceptors, spawnWorker, config, [])
    }

    // HTTP.md §15.13: initialization is not a structural argument and is
    // never an Actor.spawn argument, whose TcpAcceptor delegation stays
    // reserved for the acceptor derived here. Each Worker receives it as the
    // argument of its "serve" request, an ordinary Actor transfer: one
    // independent copy per Worker, and a non-transferable value, including a
    // caller-supplied TcpAcceptor, signals NonTransferableValue while the
    // Workers are created, which HostLifecycle reports as a startup failure
    // with its mandatory cleanup.
    owningWithFactory: (listener, factoryModule, factoryBinding, initialization, options) => {
        admitted: admit(listener, factoryModule, factoryBinding, options)
        config: admitted.config
        spawnWorker: (acceptor, connectionQuota, pendingQuota) => {
            Actor.spawn(
                "std:http/internal/HostWorker",
                "startWithFactory",
                acceptor,
                factoryModule,
                factoryBinding,
                connectionQuota,
                pendingQuota,
                config.limits
            )
        }
        HostLifecycle.start(facility, HostError, listener, admitted.acceptors, spawnWorker, config, [initialization])
    }

    host: {
        owning: owning
        owningWithFactory: owningWithFactory
    }
    host
})(_httpAsyncFacility)

// The runtime-provisioned facility is captured privately above; it is not
// module surface.
context.removeSlot("_httpAsyncFacility")
