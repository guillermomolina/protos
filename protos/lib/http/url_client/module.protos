//! Standard Library one-shot HTTP/1.1 URL client (D222-C, HTTP.md §18).
//!
//! `UrlClient.requestOne(url, request, limits, network: network,
//! resolver: resolver, trust: trust)` sends one request to an absolute `http`
//! or `https` URL and answers a fresh `Future` of the buffered response
//! `{status, headers, body}`, whose `body` is detached Bytes. The three
//! required named authorities are the explicitly granted `Network` used for
//! the TCP connection, the explicitly granted `Resolver` used only for a host
//! name (it may be null for a numeric host), and the explicit `std:tls/client`
//! trust used only for `https` (it may be null for `http`). `request` is
//! `{method, headers, body}`; the `Host` field and the origin-form target come
//! from the URL. `limits` are the `std:http/client` limits.
//!
//! The UrlClient composes `std:network`, `std:tls/client` and
//! `std:http/client`; it acquires no authority implicitly, has no default
//! trust, and never follows redirects, retries, pools connections, stores
//! cookies or decodes content. Any final status, including 3xx, 4xx and 5xx,
//! is a successful response.

/// The one-shot URL client.
this.UrlClient: ((facility) => {
    ClientLimits: import("../internal/ClientLimits.protos")
    ClientHead: import("../internal/ClientHead.protos")
    UrlRequest: import("../internal/UrlRequest.protos")
    UrlSession: import("../internal/UrlSession.protos")

    // HTTP.md §18.3: semantic validation and the complete snapshot precede
    // every effect. An invalid call answers an already failed Future without
    // a Task, a lookup or a connection; an admitted call creates exactly one
    // service Task.
    // Private presence identity: an omitted authority is distinct from an
    // explicitly supplied null (D241).
    missingAuthority: {}

    requestOne: (
        url,
        request,
        limits,
        network: missingAuthority,
        resolver: missingAuthority,
        trust: missingAuthority
    ) => {
        supplied: (network !== missingAuthority) && (resolver !== missingAuthority) && (trust !== missingAuthority)
        authorities: null
        if(supplied) {
            authorities = {
                network: network
                resolver: resolver
                trust: trust
            }
        }

        captured: null
        valid: supplied
        if(valid) {
            captured = ClientLimits.capture(facility, limits)
            valid = captured !== null
        }
        prepared: null
        if(valid) {
            prepared = UrlRequest.prepare(facility, authorities, url, request)
            valid = prepared !== null
        }
        if(valid) {
            valid = ClientHead.prepareRequest(facility, prepared.request) !== null
        }

        answer: null
        if(valid) {
            answer = facility.startService(UrlSession.serviceBody(facility, prepared, captured))
        } else {
            answer = facility.failed(InvalidIOArgument {})
        }
        answer
    }

    client: {
        requestOne: requestOne
    }
    client
})(_httpAsyncFacility)

// The runtime-provisioned facility is captured privately above; it is not
// module surface.
context.removeSlot("_httpAsyncFacility")
