//! Private strict JWT admission and claims policy.
//! No ambient authority, clock, key lookup or shared mutable session state.

Claims: import("./Claims.protos")
Instant: import("std:datetime/instant")

fail: () => {
    Error().signal()
}

/// Capture a trusted policy using only own slots.
capture: (policy) => {
    (policy === null).ifTrue(() => { fail() })

    requiredString: (name) => {
        policy.hasSlot(name).ifFalse(() => { fail() })
        value: policy.slotValue(name)

        String.recognizes(value).ifFalse(() => { fail() })
        (value == "").ifTrue(() => { fail() })
        value
    }

    issuer: requiredString("issuer")
    audience: requiredString("audience")
    type: requiredString("type")

    if(Encoding.UTF8.encode(issuer).size() > 4096) {
        fail()
    }
    if(Encoding.UTF8.encode(audience).size() > 4096) {
        fail()
    }
    if(Encoding.UTF8.encode(type).size() > 1024) {
        fail()
    }

    policy.hasSlot("maxLifetimeSeconds").ifFalse(() => {
        fail()
    })

    lifetime: policy.slotValue("maxLifetimeSeconds")
    Integer.recognizes(lifetime).ifFalse(() => { fail() })
    (lifetime <= 0).ifTrue(() => { fail() })

    skew: 0
    if(policy.hasSlot("clockSkewSeconds")) {
        skew = policy.slotValue("clockSkewSeconds")
    }

    Integer.recognizes(skew).ifFalse(() => { fail() })

    if((skew < 0) || (skew > 300)) {
        fail()
    }

    snapshot: {
        issuer: issuer
        audience: audience
        type: type
        maxLifetimeSeconds: lifetime
        clockSkewSeconds: skew
    }

    snapshot.freeze()
}

/// Require a genuine standard Bytes key and capture independent octets.
key: (value) => {
    copy: null

    Error.handle(
        () => {
            copy = Encoding.Latin1.encode(
                Encoding.Latin1.decode(value)
            )
        },
        (error) => {
            fail()
        }
    )

    size: copy.size()

    if((size < 32) || (size > 4096)) {
        fail()
    }

    copy
}

/// Require an exact Instant from std:datetime/instant.
time: (value) => {
    Instant.recognizes(value).ifFalse(() => {
        fail()
    })

    value.nanoseconds
}

/// Require a complete strict registered-claims profile.
validateClaims: (root, policy, nowNanoseconds) => {
    Claims.requireObject(root)
    Claims.validateDepth(root, 16)

    issuer: Claims.stringValue(Claims.required(root, "iss"))
    (issuer == policy.issuer).ifFalse(() => { fail() })

    audience: Claims.required(root, "aud")
    Claims.matchesAudience(audience, policy.audience).ifFalse(() => {
        fail()
    })

    subject: Claims.nonemptyString(Claims.required(root, "sub"))

    issuedAt: Claims.integerValue(Claims.required(root, "iat"))
    expiresAt: Claims.integerValue(Claims.required(root, "exp"))

    if(Claims.has(root, "jti")) {
        Claims.stringValue(Claims.required(root, "jti"))
    }

    (expiresAt > issuedAt).ifFalse(() => { fail() })

    lifetime: expiresAt - issuedAt
    (lifetime <= policy.maxLifetimeSeconds).ifFalse(() => {
        fail()
    })

    billion: 1000000000
    skewNanoseconds: policy.clockSkewSeconds * billion

    issuedNanoseconds: issuedAt * billion
    expiresNanoseconds: expiresAt * billion

    // Future issuance beyond the allowed skew is invalid.
    if(issuedNanoseconds > nowNanoseconds + skewNanoseconds) {
        fail()
    }

    // Expiration is exclusive; equality is expired at zero skew.
    if(nowNanoseconds >= expiresNanoseconds + skewNanoseconds) {
        fail()
    }

    if(Claims.has(root, "nbf")) {
        notBefore: Claims.integerValue(Claims.required(root, "nbf"))
        notBeforeNanoseconds: notBefore * billion

        if(notBeforeNanoseconds > nowNanoseconds + skewNanoseconds) {
            fail()
        }
    }

    root
}
