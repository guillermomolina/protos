v4: (a, b, c, d) => {
    requireComponent: (value) => {
        // Use the existing strict ordinary-Integer receiver domain as the
        // family gate. This validates rather than converts the supplied value.
        value.div(1)
        (value < 0).ifTrue(() => {
            Error().signal()
        })
        (value > 255).ifTrue(() => {
            Error().signal()
        })
    }

    requireComponent(a)
    requireComponent(b)
    requireComponent(c)
    requireComponent(d)

    bits: a
    bits = bits * 256 + b
    bits = bits * 256 + c
    bits = bits * 256 + d

    IpAddress(4, bits)
}

v6: (a, b, c, d, e, f, g, h) => {
    requireHextet: (value) => {
        // Fixed-width values and delegated numeric lookalikes may find this
        // selector through delegation, but the Core div protocol rejects any
        // receiver that is not an actual ordinary unbounded Integer value.
        value.div(1)
        (value < 0).ifTrue(() => {
            Error().signal()
        })
        (value > 65535).ifTrue(() => {
            Error().signal()
        })
    }

    requireHextet(a)
    requireHextet(b)
    requireHextet(c)
    requireHextet(d)
    requireHextet(e)
    requireHextet(f)
    requireHextet(g)
    requireHextet(h)

    bits: a
    bits = bits * 65536 + b
    bits = bits * 65536 + c
    bits = bits * 65536 + d
    bits = bits * 65536 + e
    bits = bits * 65536 + f
    bits = bits * 65536 + g
    bits = bits * 65536 + h

    IpAddress(6, bits)
}
