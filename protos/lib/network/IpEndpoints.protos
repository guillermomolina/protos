//! Parsing and formatting of canonical `IpEndpoint` values; the `IpEndpoint`
//! factory itself is installed by the runtime.

/// Parses endpoint text `address:port` for IPv4 or `[address]:port` for IPv6
/// into an `IpEndpoint`. The port is decimal in 1..65535. Invalid text,
/// including unbracketed IPv6, signals an Error.
parse: (text) => {
    // Validate the exact semantic String family without conversion.
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })

    size: text.size()
    if(size == 0) {
        fail()
    }

    digitValue: (character) => {
        result: -1

        if(character == "0") { result = 0 }
        if(character == "1") { result = 1 }
        if(character == "2") { result = 2 }
        if(character == "3") { result = 3 }
        if(character == "4") { result = 4 }
        if(character == "5") { result = 5 }
        if(character == "6") { result = 6 }
        if(character == "7") { result = 7 }
        if(character == "8") { result = 8 }
        if(character == "9") { result = 9 }

        result
    }

    parsePortFrom: (start) => {
        if(start >= size) {
            fail()
        }

        index: start
        value: 0
        digitCount: 0

        while(index < size) {
            digit: digitValue(text[index])
            if(digit < 0) {
                fail()
            }

            digitCount = digitCount + 1
            value = value * 10 + digit

            // Leading zeros are accepted, but the mathematical port is bounded.
            if(value > 65535) {
                fail()
            }

            index = index + 1
        }

        if(digitCount == 0) {
            fail()
        }
        if(value == 0) {
            fail()
        }

        value
    }

    IpAddresses: import("std:network/IpAddresses")

    bracketed: text[0] == "["
    addressText: ""
    portStart: -1
    address: null

    if(bracketed) {
        index: 1
        closed: false
        addressLength: 0

        (() => {
            keepScanning: index < size
            if(keepScanning) {
                keepScanning = closed == false
            }
            keepScanning
        }).whileTrue() {
            character: text[index]

            if(character == "]") {
                closed = true
            }

            (character == "]").ifFalse(() => {
                addressLength = addressLength + 1
                // No valid numeric IPv6 address accepted by IpAddresses exceeds
                // 45 Unicode scalar positions.
                if(addressLength > 45) {
                    fail()
                }
                addressText = addressText + character
            })

            index = index + 1
        }

        closed.ifFalse(() => {
            fail()
        })
        if(index >= size) {
            fail()
        }
        (text[index] == ":").ifFalse(() => {
            fail()
        })

        portStart = index + 1
        address = IpAddresses.parse(addressText)

        // Brackets are reserved for IPv6 endpoint text.
        (address.version == 6).ifFalse(() => {
            fail()
        })
    }

    bracketed.ifFalse(() => {
        separatorIndex: -1
        index: 0
        addressLength: 0

        while(index < size) {
            character: text[index]
            isSeparator: character == ":"

            if(isSeparator) {
                if(separatorIndex >= 0) {
                    fail()
                }
                separatorIndex = index
            }

            isSeparator.ifFalse(() => {
                if(separatorIndex < 0) {
                    addressLength = addressLength + 1
                    // The unbracketed endpoint grammar admits IPv4 only.
                    if(addressLength > 15) {
                        fail()
                    }
                    addressText = addressText + character
                }
            })

            index = index + 1
        }

        if(separatorIndex < 0) {
            fail()
        }

        portStart = separatorIndex + 1
        address = IpAddresses.parse(addressText)

        // Unbracketed IPv6 endpoint text is intentionally rejected.
        (address.version == 4).ifFalse(() => {
            fail()
        })
    })

    port: parsePortFrom(portStart)
    IpEndpoint(address, port)
}

/// Formats an `IpEndpoint` as `address:port` for IPv4 or `[address]:port` for
/// IPv6, using `IpAddresses.format` and a decimal port.
format: (endpoint) => {
    IpEndpoint.recognizes(endpoint).ifFalse(() => {
        fail()
    })

    IpAddresses: import("std:network/IpAddresses")
    addressText: IpAddresses.format(endpoint.address)

    digitText: (digit) => {
        result: null

        if(digit == 0) { result = "0" }
        if(digit == 1) { result = "1" }
        if(digit == 2) { result = "2" }
        if(digit == 3) { result = "3" }
        if(digit == 4) { result = "4" }
        if(digit == 5) { result = "5" }
        if(digit == 6) { result = "6" }
        if(digit == 7) { result = "7" }
        if(digit == 8) { result = "8" }
        if(digit == 9) { result = "9" }

        if(result === null) {
            fail()
        }

        result
    }

    // IpEndpoint.recognizes has already established 1..65535, so exactly five
    // divisor positions are sufficient for canonical decimal emission.
    portText: ""
    started: false
    divisor: 10000

    while(divisor > 0) {
        digit: endpoint.port.div(divisor).mod(10)

        emit: started
        emit.ifFalse(() => {
            if(digit > 0) {
                emit = true
            }
            if(divisor == 1) {
                emit = true
            }
        })

        if(emit) {
            portText = portText + digitText(digit)
            started = true
        }

        divisor = divisor.div(10)
    }

    result: null

    if(endpoint.address.version == 4) {
        result = addressText + ":" + portText
    }

    if(endpoint.address.version == 6) {
        result = "[" + addressText + "]:" + portText
    }

    if(result === null) {
        fail()
    }

    result
}
