//! Explicit structured loggers. A logger is a frozen ordinary object holding a
//! minimum level, a sink, and context `fields`; it is created and passed around
//! explicitly like any other value. There is no global or default logger, no
//! registry, no mutable configuration, and no thread-, Task-, or dynamically
//! scoped context. A logger opens no stream, file, or connection, reads no
//! clock, and starts no Task.
//!
//! A sink is any object answering `emit(event)`; it is the only output
//! authority a logger uses and it receives each enabled `std:logging/LogEvent`
//! synchronously. An Error signalled by `emit` is contained by the logging
//! call: it does not reach the caller, is not retried, and is not reported
//! anywhere else. No order is promised between events emitted concurrently
//! through loggers sharing a sink.
//!
//! Level filtering happens first: a call whose level is less severe than the
//! minimum level answers `null` after validating only its level, without
//! inspecting its other arguments, copying data, creating an event, or invoking
//! the sink. Callers avoid building expensive data for disabled levels with
//! `isEnabled(level)`.
//!
//! Context and call-site fields merge by key: a derived logger's fields
//! override its base logger's fields, and call-site fields override both.

/// Answers a fresh frozen logger that emits events at least as severe as
/// `minimumLevel` to `sink` and has no context fields. `minimumLevel` must be
/// a canonical level and `sink` must not be `null`; otherwise an Error is
/// signalled.
///
/// The logger answers:
///
/// - `isEnabled(level)`: whether `level` is at least `minimumLevel`.
/// - `log(level, message)`, `log(level, message, fields)`, and
///   `log(level, message, fields, error)`: when enabled, emits a
///   `std:logging/LogEvent` whose fields are the logger's context merged with
///   `fields` (a Map, or `null` for none) and whose error is `error` (an Error,
///   or `null`); answers `null`. Invalid enabled arguments signal an Error.
/// - `trace`, `debug`, `info`, `warn`, and `error`: `log` at that level with
///   the remaining arguments.
/// - `with(fields)`: a derived logger with the same minimum level and sink
///   whose context is this logger's context overridden by a snapshot of the
///   Map `fields`. The receiver is unchanged.
call: (minimumLevel, sink) => {
    Level: import("std:logging/Level")
    LogEvent: import("std:logging/LogEvent")

    Level.compare(minimumLevel, minimumLevel)
    (sink === null).ifTrue(() => {
        Error().signal()
    })

    // An empty matcher Map recognizes exactly normal standard Maps without
    // invoking any behavior of the candidate.
    mapMatcher: %{}
    requireMap: (value) => {
        (mapMatcher.match(value) === true).ifFalse(() => {
            Error().signal()
        })
    }

    build: null
    build = (baseFields) => {
        logger: {
            minimumLevel: minimumLevel
            sink: sink
            fields: baseFields

            isEnabled: (level) => {
                Level.compare(level, minimumLevel) >= 0
            }

            log: (level, message, ...details) => {
                (details.size() > 2).ifTrue(() => {
                    Error().signal()
                })

                (Level.compare(level, minimumLevel) >= 0).ifTrue(() => {
                    callFields: null
                    attached: null
                    (details.size() > 0).ifTrue(() => {
                        callFields = details[0]
                    })
                    (details.size() > 1).ifTrue(() => {
                        attached = details[1]
                    })

                    // Only top-level references are merged here; the event
                    // snapshots every nested value.
                    merged: Map()
                    baseFields.each((key, item) => {
                        merged[key] = item
                    })
                    (callFields === null).ifFalse(() => {
                        requireMap(callFields)
                        callFields.each((key, item) => {
                            String.recognizes(key).ifFalse(() => {
                                Error().signal()
                            })
                            merged[key] = item
                        })
                    })

                    event: LogEvent(level, message, merged, attached)
                    Error.handle(() => {
                        sink.emit(event)
                    }, (failure) => {
                        null
                    })
                })
                null
            }

            trace: (message, ...details) => {
                this.log(Level.TRACE, message, ...details)
            }

            debug: (message, ...details) => {
                this.log(Level.DEBUG, message, ...details)
            }

            info: (message, ...details) => {
                this.log(Level.INFO, message, ...details)
            }

            warn: (message, ...details) => {
                this.log(Level.WARN, message, ...details)
            }

            error: (message, ...details) => {
                this.log(Level.ERROR, message, ...details)
            }

            with: (extraFields) => {
                requireMap(extraFields)
                // Context fields obey exactly the event field domain and
                // snapshot rules, so the event constructor provides them.
                snapshot: LogEvent(Level.TRACE, "", extraFields, null).fields

                merged: Map()
                baseFields.each((key, item) => {
                    merged[key] = item
                })
                snapshot.each((key, item) => {
                    merged[key] = item
                })
                merged.freeze()
                build(merged)
            }
        }
        logger.freeze()
        logger
    }

    noFields: Map()
    noFields.freeze()
    build(noFields)
}
