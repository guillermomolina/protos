//! Canonical logging severity levels. The five levels, in ascending order of
//! severity, are `TRACE`, `DEBUG`, `INFO`, `WARN`, and `ERROR`. Each level is
//! its canonical String value: `Level.INFO` is exactly `"INFO"`, so a level is
//! immutable, compares with `===` and `==`, and keeps its identity across
//! Actor, Task, and Process boundaries without any shared registry.
//!
//! There is no `FATAL` level: logging reports severity and never implies
//! terminating a Process. Severity order is observed only through `compare`;
//! no numeric rank is part of the public contract.

/// The finest-grained diagnostic level.
TRACE: "TRACE"

/// Detailed diagnostics intended for debugging.
DEBUG: "DEBUG"

/// Ordinary operational information.
INFO: "INFO"

/// A condition that deserves attention but does not prevent progress.
WARN: "WARN"

/// A failure of the operation being reported.
ERROR: "ERROR"

/// Answers `-1`, `0`, or `1` as level `left` is less severe than, equal to, or
/// more severe than level `right`. Both arguments must be canonical levels;
/// any other value signals an Error. Arguments are recognized by String
/// identity only, so no behavior of an argument is invoked.
compare: (left, right) => {
    rank: (level) => {
        result: -1
        (level === "TRACE").ifTrue(() => {
            result = 0
        })
        (level === "DEBUG").ifTrue(() => {
            result = 1
        })
        (level === "INFO").ifTrue(() => {
            result = 2
        })
        (level === "WARN").ifTrue(() => {
            result = 3
        })
        (level === "ERROR").ifTrue(() => {
            result = 4
        })
        (result < 0).ifTrue(() => {
            Error().signal()
        })
        result
    }

    leftRank: rank(left)
    rightRank: rank(right)
    result: 0
    (leftRank < rightRank).ifTrue(() => {
        result = -1
    })
    (leftRank > rightRank).ifTrue(() => {
        result = 1
    })
    result
}
