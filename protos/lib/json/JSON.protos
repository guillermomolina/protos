//! JSON node trees, whole-text parsing and encoding, and incremental event parsing and
//! writing. Nodes are objects with `kind` and `value` slots; numbers are exact
//! decimals of an Integer `coefficient` and Integer `exponent`.

/// Answers a fresh JSON null node.
nullValue: () => {
    node: {
        kind: "null"
        value: null
    }
}

/// Answers a fresh JSON boolean node; `value` must be canonical `true` or `false`.
boolean: (value) => {
    valid: value === true
    if(value === false) {
        valid = true
    }
    valid.ifFalse(() => {
        Error().signal()
    })

    node: {
        kind: "boolean"
        value: value
    }
}

/// Answers a fresh JSON string node; `value` must be a String.
string: (value) => {
    String.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    node: {
        kind: "string"
        value: value
    }
}

/// Answers a fresh JSON number node of value `coefficient` × 10^`exponent`; both must
/// be Integers.
number: (coefficient, exponent) => {
    Integer.recognizes(coefficient).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(exponent).ifFalse(() => {
        Error().signal()
    })

    decimal: {
        coefficient: coefficient
        exponent: exponent
    }

    node: {
        kind: "number"
        value: decimal
    }
}

/// Answers a fresh JSON array node of `nodes`; each argument must have one of the six
/// JSON node kinds.
array: (...nodes) => {
    nodes.each((node) => {
        kind: node.kind
        valid: kind === "null"
        if(kind === "boolean") { valid = true }
        if(kind === "string") { valid = true }
        if(kind === "number") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "object") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    })


    node: {
        kind: "array"
        value: nodes
    }
}

/// Answers a fresh JSON object node from alternating String names and nodes. A
/// duplicate name, a non-String name, a non-node value, or a missing final value
/// signals an Error.
object: (...nameNodePairs) => {
    result: Map()
    pendingName: null
    expectingName: true

    nameNodePairs.each((entry) => {
        wasExpectingName: expectingName

        if(wasExpectingName) {
            String.recognizes(entry).ifFalse(() => {
                Error().signal()
            })
            pendingName = entry
            expectingName = false
        }

        wasExpectingName.ifFalse(() => {
            kind: entry.kind
            valid: kind === "null"
            if(kind === "boolean") { valid = true }
            if(kind === "string") { valid = true }
            if(kind === "number") { valid = true }
            if(kind === "array") { valid = true }
            if(kind === "object") { valid = true }
            valid.ifFalse(() => {
                Error().signal()
            })
            ignoredValue: entry.value

            if(result.containsKey(pendingName)) {
                Error().signal()
            }
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    })

    expectingName.ifFalse(() => {
        Error().signal()
    })


    node: {
        kind: "object"
        value: result
    }
}

/// Parses one complete JSON text into a node tree. Malformed text, trailing
/// content, or a duplicate object name signals an Error.
parse: (text) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    source: Encoding.UTF8.encode(text)

    isWhitespace: (octet) => {
        result: octet == 32
        if(octet == 9) { result = true }
        if(octet == 10) { result = true }
        if(octet == 13) { result = true }
        result
    }

    decimalDigit: (octet) => {
        result: -1
        if(octet >= 48) {
            if(octet <= 57) {
                result = octet - 48
            }
        }
        result
    }

    hexDigit: (octet) => {
        result: -1

        if(octet >= 48) {
            if(octet <= 57) {
                result = octet - 48
            }
        }

        if(result < 0) {
            if(octet >= 65) {
                if(octet <= 70) {
                    result = octet - 55
                }
            }
        }

        if(result < 0) {
            if(octet >= 97) {
                if(octet <= 102) {
                    result = octet - 87
                }
            }
        }

        result
    }

    isNumberCharacter: (octet) => {
        result: decimalDigit(octet) >= 0
        if(octet == 45) { result = true }
        if(octet == 43) { result = true }
        if(octet == 46) { result = true }
        if(octet == 101) { result = true }
        if(octet == 69) { result = true }
        result
    }

    isNumberTerminator: (octet) => {
        result: isWhitespace(octet)
        if(octet == 44) { result = true }
        if(octet == 93) { result = true }
        if(octet == 125) { result = true }
        result
    }

    appendScalarUtf8: (buffer, scalar) => {
        handled: false

        if(scalar <= 127) {
            buffer.add(scalar)
            handled = true
        }

        handled.ifFalse(() => {
            if(scalar <= 2047) {
                buffer.add(192 + scalar.div(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(scalar <= 65535) {
                buffer.add(224 + scalar.div(4096))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(scalar <= 1114111) {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            fail()
        })
    }

    topFrame: null
    depth: 0
    root: null
    rootDone: false

    pushArrayFrame: () => {
        frame: {
            parent: topFrame
            kind: "array"
            phase: "valueOrEnd"
            chunks: Map()
            maxLevel: -1
        }
        topFrame = frame
        depth = depth + 1
    }

    pushObjectFrame: () => {
        frame: {
            parent: topFrame
            kind: "object"
            phase: "nameOrEnd"
            entries: Map()
            pendingName: null
        }
        topFrame = frame
        depth = depth + 1
    }

    carryArrayChunk: null
    carryArrayChunk = (frame, chunk, level) => {
        present: frame.chunks.containsKey(level)

        if(present) {
            left: frame.chunks[level]
            frame.chunks.remove(level)
            merged: Array(...left, ...chunk)
            carryArrayChunk(frame, merged, level + 1)
        }

        present.ifFalse(() => {
            frame.chunks[level] = chunk
            if(level > frame.maxLevel) {
                frame.maxLevel = level
            }
        })
    }

    appendArrayValue: (frame, node) => {
        carryArrayChunk(frame, Array(node), 0)
        frame.phase = "commaOrEnd"
    }

    collectArrayChunks: null
    collectArrayChunks = (frame, level, result) => {
        finalResult: result

        if(level >= 0) {
            nextResult: result
            if(frame.chunks.containsKey(level)) {
                nextResult = Array(...result, ...frame.chunks[level])
            }
            finalResult = collectArrayChunks(frame, level - 1, nextResult)
        }

        finalResult
    }

    acceptValue: (node) => {
        if(depth == 0) {
            if(rootDone) {
                fail()
            }
            root = node
            rootDone = true
        }

        (depth == 0).ifFalse(() => {
            frame: topFrame

            if(frame.kind == "array") {
                validPhase: frame.phase == "valueOrEnd"
                if(frame.phase == "value") {
                    validPhase = true
                }
                validPhase.ifFalse(() => {
                    fail()
                })
                appendArrayValue(frame, node)
            }

            if(frame.kind == "object") {
                (frame.phase == "value").ifFalse(() => {
                    fail()
                })
                frame.entries[frame.pendingName] = node
                frame.pendingName = null
                frame.phase = "commaOrEnd"
            }
        })
    }

    closeArray: () => {
        frame: topFrame
        (frame.kind == "array").ifFalse(() => {
            fail()
        })

        validPhase: frame.phase == "valueOrEnd"
        if(frame.phase == "commaOrEnd") {
            validPhase = true
        }
        validPhase.ifFalse(() => {
            fail()
        })

        materialized: collectArrayChunks(frame, frame.maxLevel, Array())
        node: array(...materialized)

        topFrame = frame.parent
        depth = depth - 1
        acceptValue(node)
    }

    closeObject: () => {
        frame: topFrame
        (frame.kind == "object").ifFalse(() => {
            fail()
        })

        validPhase: frame.phase == "nameOrEnd"
        if(frame.phase == "commaOrEnd") {
            validPhase = true
        }
        validPhase.ifFalse(() => {
            fail()
        })

        node: {
            kind: "object"
            value: frame.entries
        }

        topFrame = frame.parent
        depth = depth - 1
        acceptValue(node)
    }

    mode: "normal"
    stringRole: null
    stringBuffer: Encoding.UTF8.encode("")
    unicodeValue: 0
    unicodeDigits: 0
    pendingHighSurrogate: null

    beginString: (role) => {
        stringRole = role
        stringBuffer = Encoding.UTF8.encode("")
        pendingHighSurrogate = null
        mode = "string"
    }

    completeString: () => {
        decoded: Encoding.UTF8.decode(stringBuffer)
        role: stringRole
        stringRole = null
        mode = "normal"

        if(role == "name") {
            frame: topFrame
            (frame.kind == "object").ifFalse(() => {
                fail()
            })
            if(frame.entries.containsKey(decoded)) {
                fail()
            }
            frame.pendingName = decoded
            frame.phase = "colon"
        }

        if(role == "value") {
            acceptValue(string(decoded))
        }

        validRole: role == "name"
        if(role == "value") {
            validRole = true
        }
        validRole.ifFalse(() => {
            fail()
        })
    }

    numberBuffer: Encoding.UTF8.encode("")

    beginNumber: (octet) => {
        numberBuffer = Encoding.UTF8.encode("")
        numberBuffer.add(octet)
        mode = "number"
    }

    finalizeNumber: () => {
        state: "start"
        negative: false
        coefficient: 0
        fractionDigits: 0
        exponentNegative: false
        exponentValue: 0

        numberBuffer.each((octet) => {
            previous: state
            digit: decimalDigit(octet)
            handled: false

            if(previous == "start") {
                if(octet == 45) {
                    negative = true
                    state = "integerStart"
                    handled = true
                }
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "integerStart") {
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "afterZero") {
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "integer") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    handled = true
                }
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "fractionStart") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = 1
                    state = "fraction"
                    handled = true
                }
            }

            if(previous == "fraction") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = fractionDigits + 1
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "exponentStart") {
                if(octet == 43) {
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(octet == 45) {
                    exponentNegative = true
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponentDigitsStart") {
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponent") {
                if(digit >= 0) {
                    exponentValue = exponentValue * 10 + digit
                    handled = true
                }
            }

            handled.ifFalse(() => {
                fail()
            })
        })

        validEnd: state == "afterZero"
        if(state == "integer") { validEnd = true }
        if(state == "fraction") { validEnd = true }
        if(state == "exponent") { validEnd = true }
        validEnd.ifFalse(() => {
            fail()
        })

        if(negative) {
            coefficient = 0 - coefficient
        }

        exponent: exponentValue
        if(exponentNegative) {
            exponent = 0 - exponentValue
        }
        exponent = exponent - fractionDigits

        mode = "normal"
        acceptValue(number(coefficient, exponent))
    }

    literalKind: null
    literalIndex: 0

    beginLiteral: (kind) => {
        literalKind = kind
        literalIndex = 0
        mode = "literal"
    }

    consumeLiteralOctet: (octet) => {
        expected: -1
        finalIndex: -1

        if(literalKind == "true") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 114 }
            if(literalIndex == 1) { expected = 117 }
            if(literalIndex == 2) { expected = 101 }
        }

        if(literalKind == "false") {
            finalIndex = 3
            if(literalIndex == 0) { expected = 97 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 115 }
            if(literalIndex == 3) { expected = 101 }
        }

        if(literalKind == "null") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 117 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 108 }
        }

        if(expected < 0) {
            fail()
        }
        (octet == expected).ifFalse(() => {
            fail()
        })

        done: literalIndex == finalIndex
        literalIndex = literalIndex + 1

        if(done) {
            kind: literalKind
            literalKind = null
            mode = "normal"

            if(kind == "true") {
                acceptValue(boolean(true))
            }
            if(kind == "false") {
                acceptValue(boolean(false))
            }
            if(kind == "null") {
                acceptValue(nullValue())
            }
        }
    }

    startValue: (octet) => {
        handled: false

        if(octet == 34) {
            beginString("value")
            handled = true
        }

        if(octet == 123) {
            pushObjectFrame()
            handled = true
        }

        if(octet == 91) {
            pushArrayFrame()
            handled = true
        }

        if(octet == 116) {
            beginLiteral("true")
            handled = true
        }

        if(octet == 102) {
            beginLiteral("false")
            handled = true
        }

        if(octet == 110) {
            beginLiteral("null")
            handled = true
        }

        if(octet == 45) {
            beginNumber(octet)
            handled = true
        }

        if(decimalDigit(octet) >= 0) {
            beginNumber(octet)
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    processNormal: null
    processNormal = (octet) => {
        whitespace: isWhitespace(octet)

        whitespace.ifFalse(() => {
            wasTopLevel: depth == 0

            if(wasTopLevel) {
                if(rootDone) {
                    fail()
                }
                rootDone.ifFalse(() => {
                    startValue(octet)
                })
            }

            wasTopLevel.ifFalse(() => {
                frame: topFrame

                if(frame.kind == "array") {
                    phase: frame.phase

                    if(phase == "valueOrEnd") {
                        if(octet == 93) {
                            closeArray()
                        }
                        (octet == 93).ifFalse(() => {
                            startValue(octet)
                        })
                    }

                    if(phase == "value") {
                        startValue(octet)
                    }

                    if(phase == "commaOrEnd") {
                        handled: false
                        if(octet == 44) {
                            frame.phase = "value"
                            handled = true
                        }
                        if(octet == 93) {
                            closeArray()
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }
                }

                if(frame.kind == "object") {
                    phase: frame.phase

                    if(phase == "nameOrEnd") {
                        handled: false
                        if(octet == 125) {
                            closeObject()
                            handled = true
                        }
                        if(octet == 34) {
                            beginString("name")
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }

                    if(phase == "name") {
                        (octet == 34).ifFalse(() => {
                            fail()
                        })
                        beginString("name")
                    }

                    if(phase == "colon") {
                        (octet == 58).ifFalse(() => {
                            fail()
                        })
                        frame.phase = "value"
                    }

                    if(phase == "value") {
                        startValue(octet)
                    }

                    if(phase == "commaOrEnd") {
                        handled: false
                        if(octet == 44) {
                            frame.phase = "name"
                            handled = true
                        }
                        if(octet == 125) {
                            closeObject()
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }
                }
            })
        })
    }

    source.each((octet) => {
        previousMode: mode

        if(previousMode == "normal") {
            processNormal(octet)
        }

        if(previousMode == "number") {
            if(isNumberCharacter(octet)) {
                numberBuffer.add(octet)
            }

            isNumberCharacter(octet).ifFalse(() => {
                isNumberTerminator(octet).ifFalse(() => {
                    fail()
                })
                finalizeNumber()
                processNormal(octet)
            })
        }

        if(previousMode == "literal") {
            consumeLiteralOctet(octet)
        }

        if(previousMode == "string") {
            handled: false

            if(octet == 34) {
                completeString()
                handled = true
            }

            if(octet == 92) {
                mode = "escape"
                handled = true
            }

            handled.ifFalse(() => {
                if(octet < 32) {
                    fail()
                }
                stringBuffer.add(octet)
            })
        }

        if(previousMode == "escape") {
            handled: false

            if(octet == 34) {
                stringBuffer.add(34)
                handled = true
            }
            if(octet == 92) {
                stringBuffer.add(92)
                handled = true
            }
            if(octet == 47) {
                stringBuffer.add(47)
                handled = true
            }
            if(octet == 98) {
                stringBuffer.add(8)
                handled = true
            }
            if(octet == 102) {
                stringBuffer.add(12)
                handled = true
            }
            if(octet == 110) {
                stringBuffer.add(10)
                handled = true
            }
            if(octet == 114) {
                stringBuffer.add(13)
                handled = true
            }
            if(octet == 116) {
                stringBuffer.add(9)
                handled = true
            }

            if(octet == 117) {
                unicodeValue = 0
                unicodeDigits = 0
                mode = "unicode"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })

            if(mode == "escape") {
                mode = "string"
            }
        }

        if(previousMode == "unicode") {
            digit: hexDigit(octet)
            if(digit < 0) {
                fail()
            }

            unicodeValue = unicodeValue * 16 + digit
            unicodeDigits = unicodeDigits + 1

            if(unicodeDigits == 4) {
                hadPendingHigh: pendingHighSurrogate === null

                if(hadPendingHigh) {
                    high: unicodeValue >= 55296
                    (unicodeValue <= 56319).ifFalse(() => {
                        high = false
                    })

                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })

                    if(high) {
                        pendingHighSurrogate = unicodeValue
                        mode = "surrogateBackslash"
                    }

                    high.ifFalse(() => {
                        if(low) {
                            fail()
                        }
                        appendScalarUtf8(stringBuffer, unicodeValue)
                        mode = "string"
                    })
                }

                hadPendingHigh.ifFalse(() => {
                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })
                    low.ifFalse(() => {
                        fail()
                    })

                    scalar: 65536 + (pendingHighSurrogate - 55296) * 1024 + (unicodeValue - 56320)
                    pendingHighSurrogate = null
                    appendScalarUtf8(stringBuffer, scalar)
                    mode = "string"
                })
            }
        }

        if(previousMode == "surrogateBackslash") {
            (octet == 92).ifFalse(() => {
                fail()
            })
            mode = "surrogateU"
        }

        if(previousMode == "surrogateU") {
            (octet == 117).ifFalse(() => {
                fail()
            })
            unicodeValue = 0
            unicodeDigits = 0
            mode = "unicode"
        }
    })

    if(mode == "number") {
        finalizeNumber()
    }

    (mode == "normal").ifFalse(() => {
        fail()
    })

    (depth == 0).ifFalse(() => {
        fail()
    })

    rootDone.ifFalse(() => {
        fail()
    })

    root
}

/// Encodes the node tree `root` as compact JSON text. An invalid or cyclic node
/// signals an Error.
encode: (root) => {
    output: Encoding.UTF8.encode("")

    emitAsciiText: (text) => {
        Encoding.UTF8.encode(text).each((octet) => {
            output.add(octet)
        })
    }

    emitHexNibble: (digit) => {
        if(digit < 10) {
            output.add(48 + digit)
        }
        if(digit >= 10) {
            output.add(87 + digit)
        }
    }

    emitString: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })

        output.add(34)
        Encoding.UTF8.encode(text).each((octet) => {
            handled: false

            if(octet == 34) {
                output.add(92)
                output.add(34)
                handled = true
            }

            if(octet == 92) {
                output.add(92)
                output.add(92)
                handled = true
            }

            handled.ifFalse(() => {
                if(octet < 32) {
                    output.add(92)
                    output.add(117)
                    output.add(48)
                    output.add(48)
                    emitHexNibble(octet.div(16))
                    emitHexNibble(octet.mod(16))
                    handled = true
                }
            })

            handled.ifFalse(() => {
                output.add(octet)
            })
        })
        output.add(34)
    }

    emitUnsignedInteger: null
    emitUnsignedInteger = (value) => {
        quotient: value.div(10)
        if(quotient > 0) {
            emitUnsignedInteger(quotient)
        }
        output.add(48 + value.mod(10))
    }

    emitInteger: (value) => {
        Integer.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        negative: value < 0
        magnitude: value

        if(negative) {
            output.add(45)
            magnitude = 0 - value
        }

        if(magnitude == 0) {
            output.add(48)
        }

        (magnitude == 0).ifFalse(() => {
            emitUnsignedInteger(magnitude)
        })
    }

    active: IdentityMap()
    visit: null

    visit = (node) => {
        kind: node.kind
        value: node.value
        handled: false

        if(kind === "null") {
            (value === null).ifFalse(() => {
                fail()
            })
            emitAsciiText("null")
            handled = true
        }

        if(kind === "boolean") {
            if(value === true) {
                emitAsciiText("true")
                handled = true
            }
            if(value === false) {
                emitAsciiText("false")
                handled = true
            }
            handled.ifFalse(() => {
                fail()
            })
        }

        if(kind === "string") {
            emitString(value)
            handled = true
        }

        if(kind === "number") {
            coefficient: value.coefficient
            exponent: value.exponent

            Integer.recognizes(coefficient).ifFalse(() => {
                Error().signal()
            })
            Integer.recognizes(exponent).ifFalse(() => {
                Error().signal()
            })

            emitInteger(coefficient)
            (exponent == 0).ifFalse(() => {
                output.add(101)
                emitInteger(exponent)
            })
            handled = true
        }

        if(kind === "array") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(91)
            first: true
            value.each((child) => {
                first.ifFalse(() => {
                    output.add(44)
                })
                visit(child)
                first = false
            })
            output.add(93)

            active.remove(node)
            handled = true
        }

        if(kind === "object") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(123)
            first: true
            value.each((name, child) => {
                String.recognizes(name).ifFalse(() => {
                    Error().signal()
                })

                first.ifFalse(() => {
                    output.add(44)
                })
                emitString(name)
                output.add(58)
                visit(child)
                first = false
            })
            output.add(125)

            active.remove(node)
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    visit(root)
    Encoding.UTF8.decode(output)
}

/// Answers an incremental parser whose `feed(text)` consumes JSON text and whose
/// `finish()` ends the input, calling `emit(event)` with events of `kind`
/// `objectStart`, `objectEnd`, `arrayStart`, `arrayEnd`, `name`, `null`,
/// `boolean`, `string`, or `number` and their `value`. Malformed input, an
/// `emit` failure, or use after `finish()` signals an Error and leaves the
/// parser terminal.
eventParser: (emit) => {
    failed: false
    finished: false
    parser: null

    fail: () => {
        failed = true
        Error().signal()
    }

    publish: (kind, value) => {
        event: {
            kind: kind
            value: value
        }

        // Keep callbacks non-reentrant and make a consumer failure terminal.
        failed = true
        emit(event)
        failed = false
    }

    isWhitespace: (octet) => {
        result: octet == 32
        if(octet == 9) { result = true }
        if(octet == 10) { result = true }
        if(octet == 13) { result = true }
        result
    }

    decimalDigit: (octet) => {
        result: -1
        if(octet >= 48) {
            if(octet <= 57) {
                result = octet - 48
            }
        }
        result
    }

    hexDigit: (octet) => {
        result: -1

        if(octet >= 48) {
            if(octet <= 57) {
                result = octet - 48
            }
        }

        if(result < 0) {
            if(octet >= 65) {
                if(octet <= 70) {
                    result = octet - 55
                }
            }
        }

        if(result < 0) {
            if(octet >= 97) {
                if(octet <= 102) {
                    result = octet - 87
                }
            }
        }

        result
    }

    isNumberCharacter: (octet) => {
        result: decimalDigit(octet) >= 0
        if(octet == 45) { result = true }
        if(octet == 43) { result = true }
        if(octet == 46) { result = true }
        if(octet == 101) { result = true }
        if(octet == 69) { result = true }
        result
    }

    isNumberTerminator: (octet) => {
        result: isWhitespace(octet)
        if(octet == 44) { result = true }
        if(octet == 93) { result = true }
        if(octet == 125) { result = true }
        result
    }

    appendScalarUtf8: (buffer, scalar) => {
        handled: false

        if(scalar <= 127) {
            buffer.add(scalar)
            handled = true
        }

        handled.ifFalse(() => {
            if(scalar <= 2047) {
                buffer.add(192 + scalar.div(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(scalar <= 65535) {
                buffer.add(224 + scalar.div(4096))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(scalar <= 1114111) {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
                handled = true
            }
        })

        handled.ifFalse(() => {
            fail()
        })
    }

    topFrame: null
    depth: 0
    rootDone: false

    completeValue: () => {
        if(depth == 0) {
            if(rootDone) {
                fail()
            }
            rootDone = true
        }

        (depth == 0).ifFalse(() => {
            frame: topFrame
            handled: false

            if(frame.kind == "array") {
                validPhase: frame.phase == "valueOrEnd"
                if(frame.phase == "value") {
                    validPhase = true
                }
                validPhase.ifFalse(() => {
                    fail()
                })
                frame.phase = "commaOrEnd"
                handled = true
            }

            if(frame.kind == "object") {
                (frame.phase == "value").ifFalse(() => {
                    fail()
                })
                frame.phase = "commaOrEnd"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })
        })
    }

    pushArrayFrame: () => {
        frame: {
            parent: topFrame
            kind: "array"
            phase: "valueOrEnd"
        }
        topFrame = frame
        depth = depth + 1
        publish("arrayStart", null)
    }

    pushObjectFrame: () => {
        frame: {
            parent: topFrame
            kind: "object"
            phase: "nameOrEnd"
            names: Map()
        }
        topFrame = frame
        depth = depth + 1
        publish("objectStart", null)
    }

    closeArray: () => {
        frame: topFrame
        (frame.kind == "array").ifFalse(() => {
            fail()
        })

        validPhase: frame.phase == "valueOrEnd"
        if(frame.phase == "commaOrEnd") {
            validPhase = true
        }
        validPhase.ifFalse(() => {
            fail()
        })

        topFrame = frame.parent
        depth = depth - 1
        publish("arrayEnd", null)
        completeValue()
    }

    closeObject: () => {
        frame: topFrame
        (frame.kind == "object").ifFalse(() => {
            fail()
        })

        validPhase: frame.phase == "nameOrEnd"
        if(frame.phase == "commaOrEnd") {
            validPhase = true
        }
        validPhase.ifFalse(() => {
            fail()
        })

        topFrame = frame.parent
        depth = depth - 1
        publish("objectEnd", null)
        completeValue()
    }

    mode: "normal"
    stringRole: null
    stringBuffer: Encoding.UTF8.encode("")
    unicodeValue: 0
    unicodeDigits: 0
    pendingHighSurrogate: null

    beginString: (role) => {
        stringRole = role
        stringBuffer = Encoding.UTF8.encode("")
        pendingHighSurrogate = null
        mode = "string"
    }

    completeString: () => {
        decoded: Encoding.UTF8.decode(stringBuffer)
        role: stringRole
        stringRole = null
        mode = "normal"

        if(role == "name") {
            frame: topFrame
            (frame.kind == "object").ifFalse(() => {
                fail()
            })
            if(frame.names.containsKey(decoded)) {
                fail()
            }
            frame.names[decoded] = true
            publish("name", decoded)
            frame.phase = "colon"
        }

        if(role == "value") {
            publish("string", decoded)
            completeValue()
        }

        validRole: role == "name"
        if(role == "value") {
            validRole = true
        }
        validRole.ifFalse(() => {
            fail()
        })
    }

    numberBuffer: Encoding.UTF8.encode("")

    beginNumber: (octet) => {
        numberBuffer = Encoding.UTF8.encode("")
        numberBuffer.add(octet)
        mode = "number"
    }

    finalizeNumber: () => {
        state: "start"
        negative: false
        coefficient: 0
        fractionDigits: 0
        exponentNegative: false
        exponentValue: 0

        numberBuffer.each((octet) => {
            previous: state
            digit: decimalDigit(octet)
            handled: false

            if(previous == "start") {
                if(octet == 45) {
                    negative = true
                    state = "integerStart"
                    handled = true
                }
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "integerStart") {
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "afterZero") {
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "integer") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    handled = true
                }
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "fractionStart") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = 1
                    state = "fraction"
                    handled = true
                }
            }

            if(previous == "fraction") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = fractionDigits + 1
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "exponentStart") {
                if(octet == 43) {
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(octet == 45) {
                    exponentNegative = true
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponentDigitsStart") {
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponent") {
                if(digit >= 0) {
                    exponentValue = exponentValue * 10 + digit
                    handled = true
                }
            }

            handled.ifFalse(() => {
                fail()
            })
        })

        validEnd: state == "afterZero"
        if(state == "integer") { validEnd = true }
        if(state == "fraction") { validEnd = true }
        if(state == "exponent") { validEnd = true }
        validEnd.ifFalse(() => {
            fail()
        })

        if(negative) {
            coefficient = 0 - coefficient
        }

        exponent: exponentValue
        if(exponentNegative) {
            exponent = 0 - exponentValue
        }
        exponent = exponent - fractionDigits

        mode = "normal"
        publish("number", {
            coefficient: coefficient
            exponent: exponent
        })
        completeValue()
    }

    literalKind: null
    literalIndex: 0

    beginLiteral: (kind) => {
        literalKind = kind
        literalIndex = 0
        mode = "literal"
    }

    consumeLiteralOctet: (octet) => {
        expected: -1
        finalIndex: -1

        if(literalKind == "true") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 114 }
            if(literalIndex == 1) { expected = 117 }
            if(literalIndex == 2) { expected = 101 }
        }

        if(literalKind == "false") {
            finalIndex = 3
            if(literalIndex == 0) { expected = 97 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 115 }
            if(literalIndex == 3) { expected = 101 }
        }

        if(literalKind == "null") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 117 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 108 }
        }

        if(expected < 0) {
            fail()
        }
        (octet == expected).ifFalse(() => {
            fail()
        })

        done: literalIndex == finalIndex
        literalIndex = literalIndex + 1

        if(done) {
            kind: literalKind
            literalKind = null
            mode = "normal"

            if(kind == "true") {
                publish("boolean", true)
            }
            if(kind == "false") {
                publish("boolean", false)
            }
            if(kind == "null") {
                publish("null", null)
            }
            completeValue()
        }
    }

    startValue: (octet) => {
        handled: false

        if(octet == 34) {
            beginString("value")
            handled = true
        }

        if(octet == 123) {
            pushObjectFrame()
            handled = true
        }

        if(octet == 91) {
            pushArrayFrame()
            handled = true
        }

        if(octet == 116) {
            beginLiteral("true")
            handled = true
        }

        if(octet == 102) {
            beginLiteral("false")
            handled = true
        }

        if(octet == 110) {
            beginLiteral("null")
            handled = true
        }

        if(octet == 45) {
            beginNumber(octet)
            handled = true
        }

        if(decimalDigit(octet) >= 0) {
            beginNumber(octet)
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    processNormal: null
    processNormal = (octet) => {
        whitespace: isWhitespace(octet)

        whitespace.ifFalse(() => {
            wasTopLevel: depth == 0

            if(wasTopLevel) {
                if(rootDone) {
                    fail()
                }
                rootDone.ifFalse(() => {
                    startValue(octet)
                })
            }

            wasTopLevel.ifFalse(() => {
                frame: topFrame

                if(frame.kind == "array") {
                    phase: frame.phase

                    if(phase == "valueOrEnd") {
                        if(octet == 93) {
                            closeArray()
                        }
                        (octet == 93).ifFalse(() => {
                            startValue(octet)
                        })
                    }

                    if(phase == "value") {
                        startValue(octet)
                    }

                    if(phase == "commaOrEnd") {
                        handled: false
                        if(octet == 44) {
                            frame.phase = "value"
                            handled = true
                        }
                        if(octet == 93) {
                            closeArray()
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }
                }

                if(frame.kind == "object") {
                    phase: frame.phase

                    if(phase == "nameOrEnd") {
                        handled: false
                        if(octet == 125) {
                            closeObject()
                            handled = true
                        }
                        if(octet == 34) {
                            beginString("name")
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }

                    if(phase == "name") {
                        (octet == 34).ifFalse(() => {
                            fail()
                        })
                        beginString("name")
                    }

                    if(phase == "colon") {
                        (octet == 58).ifFalse(() => {
                            fail()
                        })
                        frame.phase = "value"
                    }

                    if(phase == "value") {
                        startValue(octet)
                    }

                    if(phase == "commaOrEnd") {
                        handled: false
                        if(octet == 44) {
                            frame.phase = "name"
                            handled = true
                        }
                        if(octet == 125) {
                            closeObject()
                            handled = true
                        }
                        handled.ifFalse(() => {
                            fail()
                        })
                    }
                }
            })
        })
    }

    consumeOctet: (octet) => {
        previousMode: mode

        if(previousMode == "normal") {
            processNormal(octet)
        }

        if(previousMode == "number") {
            if(isNumberCharacter(octet)) {
                numberBuffer.add(octet)
            }

            isNumberCharacter(octet).ifFalse(() => {
                isNumberTerminator(octet).ifFalse(() => {
                    fail()
                })
                finalizeNumber()
                processNormal(octet)
            })
        }

        if(previousMode == "literal") {
            consumeLiteralOctet(octet)
        }

        if(previousMode == "string") {
            handled: false

            if(octet == 34) {
                completeString()
                handled = true
            }

            if(octet == 92) {
                mode = "escape"
                handled = true
            }

            handled.ifFalse(() => {
                if(octet < 32) {
                    fail()
                }
                stringBuffer.add(octet)
            })
        }

        if(previousMode == "escape") {
            handled: false

            if(octet == 34) {
                stringBuffer.add(34)
                handled = true
            }
            if(octet == 92) {
                stringBuffer.add(92)
                handled = true
            }
            if(octet == 47) {
                stringBuffer.add(47)
                handled = true
            }
            if(octet == 98) {
                stringBuffer.add(8)
                handled = true
            }
            if(octet == 102) {
                stringBuffer.add(12)
                handled = true
            }
            if(octet == 110) {
                stringBuffer.add(10)
                handled = true
            }
            if(octet == 114) {
                stringBuffer.add(13)
                handled = true
            }
            if(octet == 116) {
                stringBuffer.add(9)
                handled = true
            }

            if(octet == 117) {
                unicodeValue = 0
                unicodeDigits = 0
                mode = "unicode"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })

            if(mode == "escape") {
                mode = "string"
            }
        }

        if(previousMode == "unicode") {
            digit: hexDigit(octet)
            if(digit < 0) {
                fail()
            }

            unicodeValue = unicodeValue * 16 + digit
            unicodeDigits = unicodeDigits + 1

            if(unicodeDigits == 4) {
                noPendingHigh: pendingHighSurrogate === null

                if(noPendingHigh) {
                    high: unicodeValue >= 55296
                    (unicodeValue <= 56319).ifFalse(() => {
                        high = false
                    })

                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })

                    if(high) {
                        pendingHighSurrogate = unicodeValue
                        mode = "surrogateBackslash"
                    }

                    high.ifFalse(() => {
                        if(low) {
                            fail()
                        }
                        appendScalarUtf8(stringBuffer, unicodeValue)
                        mode = "string"
                    })
                }

                noPendingHigh.ifFalse(() => {
                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })
                    low.ifFalse(() => {
                        fail()
                    })

                    scalar: 65536 + (pendingHighSurrogate - 55296) * 1024 + (unicodeValue - 56320)
                    pendingHighSurrogate = null
                    appendScalarUtf8(stringBuffer, scalar)
                    mode = "string"
                })
            }
        }

        if(previousMode == "surrogateBackslash") {
            (octet == 92).ifFalse(() => {
                fail()
            })
            mode = "surrogateU"
        }

        if(previousMode == "surrogateU") {
            (octet == 117).ifFalse(() => {
                fail()
            })
            unicodeValue = 0
            unicodeDigits = 0
            mode = "unicode"
        }
    }

    parser = {
        feed: (text) => {
            if(failed) {
                Error().signal()
            }
            if(finished) {
                fail()
            }

            String.recognizes(text).ifFalse(() => {
                Error().signal()
            })
            Encoding.UTF8.encode(text).each((octet) => {
                consumeOctet(octet)
            })
            parser
        }

        finish: () => {
            if(failed) {
                Error().signal()
            }
            if(finished) {
                fail()
            }

            if(mode == "number") {
                finalizeNumber()
            }

            (mode == "normal").ifFalse(() => {
                fail()
            })
            (depth == 0).ifFalse(() => {
                fail()
            })
            rootDone.ifFalse(() => {
                fail()
            })

            finished = true
            parser
        }
    }

    parser
}

/// Answers an incremental writer whose `feed(event)` accepts the events produced
/// by `eventParser` and calls `emit(text)` with each encoded chunk, and whose
/// `finish()` requires one complete document. Invalid event sequences, an
/// `emit` failure, or use after `finish()` signals an Error and leaves the
/// writer terminal.
eventWriter: (emit) => {
    failed: false
    finished: false
    writer: null
    topFrame: null
    depth: 0
    rootDone: false
    chunk: ""

    fail: () => {
        failed = true
        Error().signal()
    }

    append: (text) => {
        chunk = chunk + text
    }

    publishChunk: () => {
        // Keep callbacks non-reentrant and make a consumer failure terminal.
        failed = true
        emit(chunk)
        failed = false
    }

    prepareValue: () => {
        if(depth == 0) {
            if(rootDone) {
                fail()
            }
        }

        (depth == 0).ifFalse(() => {
            frame: topFrame
            handled: false

            if(frame.kind == "array") {
                (frame.phase == "valueOrEnd").ifFalse(() => {
                    fail()
                })
                frame.first.ifFalse(() => {
                    append(",")
                })
                frame.first = false
                frame.phase = "inValue"
                handled = true
            }

            if(frame.kind == "object") {
                (frame.phase == "value").ifFalse(() => {
                    fail()
                })
                frame.phase = "inValue"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })
        })
    }

    completeValue: () => {
        if(depth == 0) {
            if(rootDone) {
                fail()
            }
            rootDone = true
        }

        (depth == 0).ifFalse(() => {
            frame: topFrame
            handled: false

            if(frame.kind == "array") {
                (frame.phase == "inValue").ifFalse(() => {
                    fail()
                })
                frame.phase = "valueOrEnd"
                handled = true
            }

            if(frame.kind == "object") {
                (frame.phase == "inValue").ifFalse(() => {
                    fail()
                })
                frame.phase = "nameOrEnd"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })
        })
    }

    beginArray: () => {
        prepareValue()
        append("[")
        frame: {
            parent: topFrame
            kind: "array"
            phase: "valueOrEnd"
            first: true
        }
        topFrame = frame
        depth = depth + 1
    }

    endArray: () => {
        (depth > 0).ifFalse(() => {
            fail()
        })
        frame: topFrame
        (frame.kind == "array").ifFalse(() => {
            fail()
        })
        (frame.phase == "valueOrEnd").ifFalse(() => {
            fail()
        })

        topFrame = frame.parent
        depth = depth - 1
        append("]")
        completeValue()
    }

    beginObject: () => {
        prepareValue()
        append("{")
        frame: {
            parent: topFrame
            kind: "object"
            phase: "nameOrEnd"
            first: true
            names: Map()
        }
        topFrame = frame
        depth = depth + 1
    }

    endObject: () => {
        (depth > 0).ifFalse(() => {
            fail()
        })
        frame: topFrame
        (frame.kind == "object").ifFalse(() => {
            fail()
        })
        (frame.phase == "nameOrEnd").ifFalse(() => {
            fail()
        })

        topFrame = frame.parent
        depth = depth - 1
        append("}")
        completeValue()
    }

    emitName: (name) => {
        (depth > 0).ifFalse(() => {
            fail()
        })
        frame: topFrame
        (frame.kind == "object").ifFalse(() => {
            fail()
        })
        (frame.phase == "nameOrEnd").ifFalse(() => {
            fail()
        })

        // Reuse the published encoder for String-domain validation and escaping.
        encodedName: encode(string(name))
        if(frame.names.containsKey(name)) {
            fail()
        }
        frame.names[name] = true

        frame.first.ifFalse(() => {
            append(",")
        })
        frame.first = false
        append(encodedName)
        append(":")
        frame.phase = "value"
    }

    emitScalar: (kind, value) => {
        encoded: null
        handled: false

        // Validate/encode the complete scalar before changing structural state.
        // Invalid scalar arguments therefore contribute no output and consume no
        // event position, matching the ordinary synchronous argument boundary.
        if(kind == "null") {
            (value === null).ifFalse(() => {
                fail()
            })
            encoded = "null"
            handled = true
        }

        if(kind == "boolean") {
            encoded = encode(boolean(value))
            handled = true
        }

        if(kind == "string") {
            encoded = encode(string(value))
            handled = true
        }

        if(kind == "number") {
            coefficient: value.coefficient
            exponent: value.exponent
            encoded = encode(number(coefficient, exponent))
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
        prepareValue()
        append(encoded)
        completeValue()
    }

    writer = {
        feed: (event) => {
            if(failed) {
                Error().signal()
            }
            if(finished) {
                fail()
            }

            chunk = ""
            kind: event.kind
            value: event.value
            String.recognizes(kind).ifFalse(() => {
                Error().signal()
            })
            handled: false

            if(kind == "objectStart") {
                (value === null).ifFalse(() => { fail() })
                beginObject()
                handled = true
            }
            if(kind == "objectEnd") {
                (value === null).ifFalse(() => { fail() })
                endObject()
                handled = true
            }
            if(kind == "arrayStart") {
                (value === null).ifFalse(() => { fail() })
                beginArray()
                handled = true
            }
            if(kind == "arrayEnd") {
                (value === null).ifFalse(() => { fail() })
                endArray()
                handled = true
            }
            if(kind == "name") {
                emitName(value)
                handled = true
            }
            if(kind == "null") {
                emitScalar(kind, value)
                handled = true
            }
            if(kind == "boolean") {
                emitScalar(kind, value)
                handled = true
            }
            if(kind == "string") {
                emitScalar(kind, value)
                handled = true
            }
            if(kind == "number") {
                emitScalar(kind, value)
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })

            publishChunk()
            writer
        }

        finish: () => {
            if(failed) {
                Error().signal()
            }
            if(finished) {
                fail()
            }
            (depth == 0).ifFalse(() => {
                fail()
            })
            rootDone.ifFalse(() => {
                fail()
            })

            finished = true
            writer
        }
    }

    writer
}

/// Answers an adapter whose `read()` reads one chunk from `textReader`, feeds it to
/// an `eventParser(emit)`, and answers a Future of `true`, or of `false` once the
/// input has ended and been finished. Calling `read()` while a read is pending
/// or after the end signals an Error.
readEvents: (textReader, emit) => {
    parser: eventParser(emit)
    busy: false
    finished: false
    adapter: null

    ensureReady: () => {
        if(busy) {
            Error().signal()
        }
        if(finished) {
            Error().signal()
        }
    }

    adapter = {
        read: () => {
            ensureReady()
            busy = true

            readFuture: textReader.readText()
            completion: readFuture.then((chunk) => {
                more: true

                if(chunk === null) {
                    parser.finish()
                    finished = true
                    more = false
                }

                (chunk === null).ifFalse(() => {
                    parser.feed(chunk)
                })

                busy = false
                more
            })

            completion
        }
    }

    adapter
}

/// Answers an adapter whose `feed(event)` encodes one event and writes it to
/// `textWriter`, and whose `finish()` requires one complete document and then
/// performs an ordered zero-output write; both answer a Future of the adapter.
/// The adapter does not close `textWriter`.
writeEvents: (textWriter) => {
    busy: false
    finished: false
    adapter: null
    chunk: null

    jsonWriter: eventWriter((text) => {
        chunk = text
    })

    ensureReady: () => {
        if(busy) {
            Error().signal()
        }
        if(finished) {
            Error().signal()
        }
    }

    adapter = {
        feed: (event) => {
            ensureReady()

            chunk = null
            jsonWriter.feed(event)
            if(chunk === null) {
                Error().signal()
            }

            busy = true
            writeFuture: textWriter.writeText(chunk)
            completion: writeFuture.then((ignored) => {
                busy = false
                adapter
            })
            completion
        }

        finish: () => {
            ensureReady()
            jsonWriter.finish()

            // Empty TextWriter writes are ordered zero-output operations.  Using
            // one here makes finish Future-shaped without inventing a second
            // flush/finalization contract or contributing bytes of its own.
            busy = true
            barrier: textWriter.writeText("")
            completion: barrier.then((ignored) => {
                finished = true
                busy = false
                adapter
            })
            completion
        }
    }

    adapter
}
