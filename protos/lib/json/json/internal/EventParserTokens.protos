//! Invocation-local JSON token state and octet consumption.

create: (fail, hexDigit, isNumberCharacter, isNumberTerminator, appendScalarUtf8, admitNumber, getTopFrame, publish, completeValue, processNormal) => {
    mode: "normal"
    stringRole: null
    stringBuffer: Encoding.UTF8.encode("")
    unicodeValue: 0
    unicodeDigits: 0
    pendingHighSurrogate: null

    beginString: (role) => {
        stringRole = role
        stringBuffer = Encoding.UTF8.encode("")
        pendingHighSurrogate = null
        mode = "string"
    }

    completeString: () => {
        decoded: Encoding.UTF8.decode(stringBuffer)
        role: stringRole
        stringRole = null
        mode = "normal"

        if(role == "name") {
            frame: getTopFrame()
            (frame.kind == "object").ifFalse(() => {
                fail()
            })
            if(frame.names.containsKey(decoded)) {
                fail()
            }
            frame.names[decoded] = true
            publish("name", decoded)
            frame.phase = "colon"
        }

        if(role == "value") {
            publish("string", decoded)
            completeValue()
        }

        validRole: role == "name"
        if(role == "value") {
            validRole = true
        }
        validRole.ifFalse(() => {
            fail()
        })
    }

    numberBuffer: Encoding.UTF8.encode("")

    beginNumber: (octet) => {
        numberBuffer = Encoding.UTF8.encode("")
        numberBuffer.add(octet)
        mode = "number"
    }

    finalizeNumber: () => {
        admitNumber(numberBuffer, (coefficient, exponent) => {
            mode = "normal"
            publish("number", {
                coefficient: coefficient
                exponent: exponent
            })
            completeValue()
        })
    }

    literalKind: null
    literalIndex: 0

    beginLiteral: (kind) => {
        literalKind = kind
        literalIndex = 0
        mode = "literal"
    }

    consumeLiteralOctet: (octet) => {
        expected: -1
        finalIndex: -1

        if(literalKind == "true") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 114 }
            if(literalIndex == 1) { expected = 117 }
            if(literalIndex == 2) { expected = 101 }
        }

        if(literalKind == "false") {
            finalIndex = 3
            if(literalIndex == 0) { expected = 97 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 115 }
            if(literalIndex == 3) { expected = 101 }
        }

        if(literalKind == "null") {
            finalIndex = 2
            if(literalIndex == 0) { expected = 117 }
            if(literalIndex == 1) { expected = 108 }
            if(literalIndex == 2) { expected = 108 }
        }

        if(expected < 0) {
            fail()
        }
        (octet == expected).ifFalse(() => {
            fail()
        })

        done: literalIndex == finalIndex
        literalIndex = literalIndex + 1

        if(done) {
            kind: literalKind
            literalKind = null
            mode = "normal"

            if(kind == "true") {
                publish("boolean", true)
            }
            if(kind == "false") {
                publish("boolean", false)
            }
            if(kind == "null") {
                publish("null", null)
            }
            completeValue()
        }
    }

    consumeOctet: (octet) => {
        previousMode: mode

        if(previousMode == "normal") {
            processNormal(octet)
        }

        if(previousMode == "number") {
            if(isNumberCharacter(octet)) {
                numberBuffer.add(octet)
            }

            isNumberCharacter(octet).ifFalse(() => {
                isNumberTerminator(octet).ifFalse(() => {
                    fail()
                })
                finalizeNumber()
                processNormal(octet)
            })
        }

        if(previousMode == "literal") {
            consumeLiteralOctet(octet)
        }

        if(previousMode == "string") {
            handled: false

            if(octet == 34) {
                completeString()
                handled = true
            }

            if(octet == 92) {
                mode = "escape"
                handled = true
            }

            handled.ifFalse(() => {
                if(octet < 32) {
                    fail()
                }
                stringBuffer.add(octet)
            })
        }

        if(previousMode == "escape") {
            handled: false

            if(octet == 34) {
                stringBuffer.add(34)
                handled = true
            }
            if(octet == 92) {
                stringBuffer.add(92)
                handled = true
            }
            if(octet == 47) {
                stringBuffer.add(47)
                handled = true
            }
            if(octet == 98) {
                stringBuffer.add(8)
                handled = true
            }
            if(octet == 102) {
                stringBuffer.add(12)
                handled = true
            }
            if(octet == 110) {
                stringBuffer.add(10)
                handled = true
            }
            if(octet == 114) {
                stringBuffer.add(13)
                handled = true
            }
            if(octet == 116) {
                stringBuffer.add(9)
                handled = true
            }

            if(octet == 117) {
                unicodeValue = 0
                unicodeDigits = 0
                mode = "unicode"
                handled = true
            }

            handled.ifFalse(() => {
                fail()
            })

            if(mode == "escape") {
                mode = "string"
            }
        }

        if(previousMode == "unicode") {
            digit: hexDigit(octet)
            if(digit < 0) {
                fail()
            }

            unicodeValue = unicodeValue * 16 + digit
            unicodeDigits = unicodeDigits + 1

            if(unicodeDigits == 4) {
                noPendingHigh: pendingHighSurrogate === null

                if(noPendingHigh) {
                    high: unicodeValue >= 55296
                    (unicodeValue <= 56319).ifFalse(() => {
                        high = false
                    })

                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })

                    if(high) {
                        pendingHighSurrogate = unicodeValue
                        mode = "surrogateBackslash"
                    }

                    high.ifFalse(() => {
                        if(low) {
                            fail()
                        }
                        appendScalarUtf8(stringBuffer, unicodeValue)
                        mode = "string"
                    })
                }

                noPendingHigh.ifFalse(() => {
                    low: unicodeValue >= 56320
                    (unicodeValue <= 57343).ifFalse(() => {
                        low = false
                    })
                    low.ifFalse(() => {
                        fail()
                    })

                    scalar: 65536 + (pendingHighSurrogate - 55296) * 1024 + (unicodeValue - 56320)
                    pendingHighSurrogate = null
                    appendScalarUtf8(stringBuffer, scalar)
                    mode = "string"
                })
            }
        }

        if(previousMode == "surrogateBackslash") {
            (octet == 92).ifFalse(() => {
                fail()
            })
            mode = "surrogateU"
        }

        if(previousMode == "surrogateU") {
            (octet == 117).ifFalse(() => {
                fail()
            })
            unicodeValue = 0
            unicodeDigits = 0
            mode = "unicode"
        }
    }

    {
        beginString: beginString
        beginNumber: beginNumber
        beginLiteral: beginLiteral
        finalizeNumber: finalizeNumber
        consumeOctet: consumeOctet
        currentMode: () => mode
    }
}
