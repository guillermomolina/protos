//! Private JSON numbers implementation.

create: (fail, decimalDigit) => {
    admit: (numberBuffer, complete) => {
        state: "start"
        negative: false
        coefficient: 0
        fractionDigits: 0
        exponentNegative: false
        exponentValue: 0

        for(octet in numberBuffer) {
            previous: state
            digit: decimalDigit(octet)
            handled: false

            if(previous == "start") {
                if(octet == 45) {
                    negative = true
                    state = "integerStart"
                    handled = true
                }
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "integerStart") {
                if(digit >= 0) {
                    coefficient = digit
                    if(digit == 0) {
                        state = "afterZero"
                    }
                    (digit == 0).ifFalse(() => {
                        state = "integer"
                    })
                    handled = true
                }
            }

            if(previous == "afterZero") {
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "integer") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    handled = true
                }
                if(octet == 46) {
                    state = "fractionStart"
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "fractionStart") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = 1
                    state = "fraction"
                    handled = true
                }
            }

            if(previous == "fraction") {
                if(digit >= 0) {
                    coefficient = coefficient * 10 + digit
                    fractionDigits = fractionDigits + 1
                    handled = true
                }
                if(octet == 101) {
                    state = "exponentStart"
                    handled = true
                }
                if(octet == 69) {
                    state = "exponentStart"
                    handled = true
                }
            }

            if(previous == "exponentStart") {
                if(octet == 43) {
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(octet == 45) {
                    exponentNegative = true
                    state = "exponentDigitsStart"
                    handled = true
                }
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponentDigitsStart") {
                if(digit >= 0) {
                    exponentValue = digit
                    state = "exponent"
                    handled = true
                }
            }

            if(previous == "exponent") {
                if(digit >= 0) {
                    exponentValue = exponentValue * 10 + digit
                    handled = true
                }
            }

            handled.ifFalse(() => {
                fail()
            })
        }

        validEnd: state == "afterZero"
        if(state == "integer") { validEnd = true }
        if(state == "fraction") { validEnd = true }
        if(state == "exponent") { validEnd = true }
        validEnd.ifFalse(() => {
            fail()
        })

        if(negative) {
            coefficient = 0 - coefficient
        }

        exponent: exponentValue
        if(exponentNegative) {
            exponent = 0 - exponentValue
        }
        exponent = exponent - fractionDigits

        complete(coefficient, exponent)
    }

    {
        admit: admit
    }
}
