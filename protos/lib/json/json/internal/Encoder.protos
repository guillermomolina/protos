//! Private JSON encoder implementation.

encode: (root) => {
    output: Encoding.UTF8.encode("")

    emitAsciiText: (text) => {
        for(octet in Encoding.UTF8.encode(text)) {
            output.add(octet)
        }
    }

    emitHexNibble: (digit) => {
        if(digit < 10) {
            output.add(48 + digit)
        }
        if(digit >= 10) {
            output.add(87 + digit)
        }
    }

    emitString: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })

        output.add(34)
        for(octet in Encoding.UTF8.encode(text)) {
            handled: false

            if(octet == 34) {
                output.add(92)
                output.add(34)
                handled = true
            }

            if(octet == 92) {
                output.add(92)
                output.add(92)
                handled = true
            }

            handled.ifFalse(() => {
                if(octet < 32) {
                    output.add(92)
                    output.add(117)
                    output.add(48)
                    output.add(48)
                    emitHexNibble(octet.div(16))
                    emitHexNibble(octet.mod(16))
                    handled = true
                }
            })

            handled.ifFalse(() => {
                output.add(octet)
            })
        }
        output.add(34)
    }

    emitUnsignedInteger: null
    emitUnsignedInteger = (value) => {
        quotient: value.div(10)
        if(quotient > 0) {
            emitUnsignedInteger(quotient)
        }
        output.add(48 + value.mod(10))
    }

    emitInteger: (value) => {
        Integer.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        negative: value < 0
        magnitude: value

        if(negative) {
            output.add(45)
            magnitude = 0 - value
        }

        if(magnitude == 0) {
            output.add(48)
        }

        (magnitude == 0).ifFalse(() => {
            emitUnsignedInteger(magnitude)
        })
    }

    active: IdentityMap()
    visit: null

    visit = (node) => {
        kind: node.kind
        value: node.value
        handled: false

        if(kind === "null") {
            (value === null).ifFalse(() => {
                fail()
            })
            emitAsciiText("null")
            handled = true
        }

        if(kind === "boolean") {
            if(value === true) {
                emitAsciiText("true")
                handled = true
            }
            if(value === false) {
                emitAsciiText("false")
                handled = true
            }
            handled.ifFalse(() => {
                fail()
            })
        }

        if(kind === "string") {
            emitString(value)
            handled = true
        }

        if(kind === "number") {
            coefficient: value.coefficient
            exponent: value.exponent

            Integer.recognizes(coefficient).ifFalse(() => {
                Error().signal()
            })
            Integer.recognizes(exponent).ifFalse(() => {
                Error().signal()
            })

            emitInteger(coefficient)
            (exponent == 0).ifFalse(() => {
                output.add(101)
                emitInteger(exponent)
            })
            handled = true
        }

        if(kind === "array") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(91)
            first: true
            for(child in value) {
                first.ifFalse(() => {
                    output.add(44)
                })
                visit(child)
                first = false
            }
            output.add(93)

            active.remove(node)
            handled = true
        }

        if(kind === "object") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(123)
            first: true
            value.each((name, child) => {
                String.recognizes(name).ifFalse(() => {
                    Error().signal()
                })

                first.ifFalse(() => {
                    output.add(44)
                })
                emitString(name)
                output.add(58)
                visit(child)
                first = false
            })
            output.add(125)

            active.remove(node)
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    visit(root)
    Encoding.UTF8.decode(output)
}
