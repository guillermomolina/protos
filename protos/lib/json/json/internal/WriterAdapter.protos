//! Private JSON writeradapter implementation.

create: (selectEventWriter) => {
    writeEvents: (textWriter) => {
        busy: false
        finished: false
        adapter: null
        chunk: null

        jsonWriter: (selectEventWriter())((text) => {
            chunk = text
        })

        ensureReady: () => {
            if(busy) {
                Error().signal()
            }
            if(finished) {
                Error().signal()
            }
        }

        adapter = {
            feed: (event) => {
                ensureReady()

                chunk = null
                jsonWriter.feed(event)
                if(chunk === null) {
                    Error().signal()
                }

                busy = true
                writeFuture: textWriter.writeText(chunk)
                completion: writeFuture.then((ignored) => {
                    busy = false
                    adapter
                })
                completion
            }

            finish: () => {
                ensureReady()
                jsonWriter.finish()

                // Empty TextWriter writes are ordered zero-output operations.  Using
                // one here makes finish Future-shaped without inventing a second
                // flush/finalization contract or contributing bytes of its own.
                busy = true
                barrier: textWriter.writeText("")
                completion: barrier.then((ignored) => {
                    finished = true
                    busy = false
                    adapter
                })
                completion
            }
        }

        adapter
    }

    {
        writeEvents: writeEvents
    }
}
