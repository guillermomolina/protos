//! Private JSON nodes implementation.

nullValue: () => {
    node: {
        kind: "null"
        value: null
    }
}

boolean: (value) => {
    valid: value === true
    if(value === false) {
        valid = true
    }
    valid.ifFalse(() => {
        Error().signal()
    })

    node: {
        kind: "boolean"
        value: value
    }
}

string: (value) => {
    String.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    node: {
        kind: "string"
        value: value
    }
}

number: (coefficient, exponent) => {
    Integer.recognizes(coefficient).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(exponent).ifFalse(() => {
        Error().signal()
    })

    decimal: {
        coefficient: coefficient
        exponent: exponent
    }

    node: {
        kind: "number"
        value: decimal
    }
}

array: (...nodes) => {
    for(node in nodes) {
        kind: node.kind
        valid: kind === "null"
        if(kind === "boolean") { valid = true }
        if(kind === "string") { valid = true }
        if(kind === "number") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "object") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    node: {
        kind: "array"
        value: nodes
    }
}

object: (...nameNodePairs) => {
    result: Map()
    pendingName: null
    expectingName: true

    for(entry in nameNodePairs) {
        wasExpectingName: expectingName

        if(wasExpectingName) {
            String.recognizes(entry).ifFalse(() => {
                Error().signal()
            })
            pendingName = entry
            expectingName = false
        }

        wasExpectingName.ifFalse(() => {
            kind: entry.kind
            valid: kind === "null"
            if(kind === "boolean") { valid = true }
            if(kind === "string") { valid = true }
            if(kind === "number") { valid = true }
            if(kind === "array") { valid = true }
            if(kind === "object") { valid = true }
            valid.ifFalse(() => {
                Error().signal()
            })
            ignoredValue: entry.value

            if(result.containsKey(pendingName)) {
                Error().signal()
            }
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    }

    expectingName.ifFalse(() => {
        Error().signal()
    })

    node: {
        kind: "object"
        value: result
    }
}
