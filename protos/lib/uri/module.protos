//! Strict RFC 3986 URI-reference parsing over ordinary frozen component data.

Parser: import("./internal/Parser.protos")
FormatterSource: import("./internal/Formatter.protos")
Formatter: FormatterSource.create((text) => parse(text))
ResolutionSource: import("./internal/Resolution.protos")
Resolution: ResolutionSource.create((reference) => format(reference))

/// Parses one RFC 3986 URI-reference and preserves its accepted component spelling.
this.parse: Parser.slotValue("parse")

/// Serializes one validated seven-component RFC 3986 URI-reference record.
this.format: Formatter.slotValue("format")

/// Resolves one RFC 3986 URI-reference against one absolute-URI base.
this.resolve: Resolution.slotValue("resolve")
