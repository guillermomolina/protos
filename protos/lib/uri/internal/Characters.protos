//! Private URI characters implementation.

isAlpha: (octet) => {
    ((octet >= 65) && (octet <= 90)) ||
        ((octet >= 97) && (octet <= 122))
}

isDigit: (octet) => {
    (octet >= 48) && (octet <= 57)
}

isHexDigit: (octet) => {
    isDigit(octet) ||
        ((octet >= 65) && (octet <= 70)) ||
        ((octet >= 97) && (octet <= 102))
}

isUnreserved: (octet) => {
    isAlpha(octet) ||
        isDigit(octet) ||
        (octet == 45) ||
        (octet == 46) ||
        (octet == 95) ||
        (octet == 126)
}

isSubDelimiter: (octet) => {
    (octet == 33) ||
        (octet == 36) ||
        (octet == 38) ||
        (octet == 39) ||
        (octet == 40) ||
        (octet == 41) ||
        (octet == 42) ||
        (octet == 43) ||
        (octet == 44) ||
        (octet == 59) ||
        (octet == 61)
}
