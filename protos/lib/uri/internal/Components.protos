//! Private URI components implementation.

Characters: import("./Characters.protos")

create: (source) => {
    isHexDigit: Characters.slotValue("isHexDigit")
    isUnreserved: Characters.slotValue("isUnreserved")
    isSubDelimiter: Characters.slotValue("isSubDelimiter")

    validatePercentTriplet: (index, end) => {
        if((index + 2) >= end) {
            fail()
        }
        isHexDigit(source[index + 1]).ifFalse(() => {
            fail()
        })
        isHexDigit(source[index + 2]).ifFalse(() => {
            fail()
        })
    }

    sliceText: (start, end) => {
        buffer: Encoding.UTF8.encode("")
        index: start
        while(index < end) {
            buffer.add(source[index])
            index = index + 1
        }
        Encoding.UTF8.decode(buffer)
    }

    validateComponent: (start, end, allowSlash, allowQuestion) => {
        index: start
        while(index < end) {
            octet: source[index]
            isPercent: octet == 37

            if(isPercent) {
                validatePercentTriplet(index, end)
                index = index + 3
            }

            isPercent.ifFalse(() => {
                allowed: isUnreserved(octet) || isSubDelimiter(octet)
                if(octet == 58) { allowed = true }
                if(octet == 64) { allowed = true }
                if(allowSlash && (octet == 47)) { allowed = true }
                if(allowQuestion && (octet == 63)) { allowed = true }

                allowed.ifFalse(() => {
                    fail()
                })
                index = index + 1
            })
        }
    }

    {
        validatePercentTriplet: validatePercentTriplet
        sliceText: sliceText
        validateComponent: validateComponent
    }
}
