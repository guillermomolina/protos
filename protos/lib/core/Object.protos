// D203: Closure binding accepts any argument count, so the independent standard
// arities below are checked explicitly before any other effect.
_coreObjectInit: (...args) => {
    (args.size() == 0).ifFalse(() => { _coreArgumentCountError() })
    this
}

_coreObjectEquals: (other) => {
    this === other
}

_coreObjectMatch: (subject) => {
    this == subject
}

/// Invokes `block()` exactly when the receiver is canonical `null`.
ifNull: (...args) => {
    (args.size() == 1).ifFalse(() => { _coreArgumentCountError() })
    block: args[0]
    (this === null).ifTrueIfFalse(
        () => { block() },
        () => { this }
    )
}

/// Invokes `block(this)` exactly when the receiver is not canonical `null`.
ifNotNull: (...args) => {
    (args.size() == 1).ifFalse(() => { _coreArgumentCountError() })
    block: args[0]
    (this === null).ifTrueIfFalse(
        () => { null },
        () => { block(this) }
    )
}
