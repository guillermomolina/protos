// The canonical directed Integer range prototypes (D232, D235-B1-F). They are
// published as the Prelude bindings Range and InvertedRange and, with the
// same identities, as the standard members of std:collections/Range. Both are
// ordinary source-backed objects frozen with the shared standard graph; the
// bare names below resolve lexically to these canonical prototypes.

/// Ascending half-open Integer range [start, stop).
Range: {
    /// Initializes a fresh Range child with exactly two Integer bounds,
    /// start <= stop, then freezes it.
    init: (...args) => {
        (args.size() == 2).ifFalse(() => {
            Error().signal()
        })
        (this.parent() === Range).ifFalse(() => {
            Error().signal()
        })

        start: args[0]
        stop: args[1]

        Integer.recognizes(start).ifFalse(() => {
            Error().signal()
        })
        Integer.recognizes(stop).ifFalse(() => {
            Error().signal()
        })
        (start <= stop).ifFalse(() => {
            Error().signal()
        })

        this.start: start
        this.stop: stop
        this.freeze()
    }

    /// Visits each Integer of the range in ascending unit order.
    each: (block) => {
        this.eachStep(1, block)
    }

    /// Visits start, start + step, ... while below stop; step must be a
    /// strictly positive Integer.
    eachStep: (step, block) => {
        Integer.recognizes(step).ifFalse(() => {
            Error().signal()
        })
        (step > 0).ifFalse(() => {
            Error().signal()
        })

        current: this.start

        while(current < this.stop) {
            block(current)
            current = current + step
        }

        null
    }

    /// Swaps bounds and direction: Range(a, b) -> InvertedRange(b, a).
    invert: () => {
        InvertedRange(this.stop, this.start)
    }

    /// Keeps the elements and reverses their order:
    /// Range(a, b) -> InvertedRange(b - 1, a - 1).
    reverse: () => {
        InvertedRange(this.stop - 1, this.start - 1)
    }
}

/// Descending half-open Integer range (stop, start], visited from start down.
InvertedRange: {
    /// Initializes a fresh InvertedRange child with exactly two Integer
    /// bounds, start >= stop, then freezes it.
    init: (...args) => {
        (args.size() == 2).ifFalse(() => {
            Error().signal()
        })
        (this.parent() === InvertedRange).ifFalse(() => {
            Error().signal()
        })

        start: args[0]
        stop: args[1]

        Integer.recognizes(start).ifFalse(() => {
            Error().signal()
        })
        Integer.recognizes(stop).ifFalse(() => {
            Error().signal()
        })
        (start >= stop).ifFalse(() => {
            Error().signal()
        })

        this.start: start
        this.stop: stop
        this.freeze()
    }

    /// Visits each Integer of the range in descending unit order.
    each: (block) => {
        this.eachStep(-1, block)
    }

    /// Visits start, start + step, ... while above stop; step must be a
    /// strictly negative Integer.
    eachStep: (step, block) => {
        Integer.recognizes(step).ifFalse(() => {
            Error().signal()
        })
        (step < 0).ifFalse(() => {
            Error().signal()
        })

        current: this.start

        while(current > this.stop) {
            block(current)
            current = current + step
        }

        null
    }

    /// Swaps bounds and direction: InvertedRange(a, b) -> Range(b, a).
    invert: () => {
        Range(this.stop, this.start)
    }

    /// Keeps the elements and reverses their order:
    /// InvertedRange(a, b) -> Range(b + 1, a + 1).
    reverse: () => {
        Range(this.stop + 1, this.start + 1)
    }
}
