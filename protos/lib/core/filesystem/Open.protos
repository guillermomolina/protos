// D241-B (FILESYSTEM.md §18.0): the single source implementation of the
// public Filesystem open selector. The runtime binds this Closure as the local
// "open" slot of every host-provisioned Filesystem capability; it is never a
// Prelude binding, module member or slot of any shared prototype.
//
// The five options are ordinary D237 parameters with the D241-B defaults, so
// unknown labels and positional/named collisions fail before this body runs.
// The literal built below is an internal adaptation value, not the retired
// public options object: the private bridge, reached through the unpublished
// bootstrap anchor _coreFilesystemOpenBridge, admits only a genuine Filesystem
// capability whose Actor-local open flow was installed by the host, and the
// existing open flow captures and validates the option tuple exactly once
// before any namespace or backend operation.
//
// This source only declares; it opens nothing while Core bootstraps.
_coreFilesystemOpenMethod: (
    path,
    read: true,
    write: false,
    create: false,
    createNew: false,
    truncate: false
) => {
    _coreFilesystemOpenBridge.open(this, path, {
        read: read
        write: write
        create: create
        createNew: createNew
        truncate: truncate
    })
}
