// The canonical IpAddress family prototype. Construction, structural equality
// and hash are ordinary source closures; only the exact structural recognizer
// is installed by the runtime, because it must not dispatch on the candidate.
// The closures reach the canonical prototype through the private bootstrap
// anchor below, which survives removal of the public IpAddress binding.
IpAddress: {
    call: (version, bits) => {
        (this === _coreIpAddressCanonical).ifFalse(() => {
            Error().signal()
        })

        Integer.recognizes(version).ifFalse(() => {
            Error().signal()
        })
        Integer.recognizes(bits).ifFalse(() => {
            Error().signal()
        })

        validVersion: (version == 4) || (version == 6)
        validVersion.ifFalse(() => {
            Error().signal()
        })

        (bits < 0).ifTrue(() => {
            Error().signal()
        })

        (version == 4).ifTrue(() => {
            (bits > 4294967295).ifTrue(() => {
                Error().signal()
            })
        })

        (version == 6).ifTrue(() => {
            (bits > 340282366920938463463374607431768211455).ifTrue(() => {
                Error().signal()
            })
        })

        address: (_coreIpAddressCanonical) {
            version: version
            bits: bits
        }
        address.freeze()
    }

    // Installed by the runtime as `==`; a slot target cannot spell an operator.
    _coreIpAddressEquals: (other) => {
        _coreIpAddressCanonical.recognizes(this).ifFalse(() => {
            Error().signal()
        })

        result: false
        _coreIpAddressCanonical.recognizes(other).ifTrue(() => {
            result =
                (this.version == other.version) &&
                (this.bits == other.bits)
        })
        result
    }

    hash: () => {
        _coreIpAddressCanonical.recognizes(this).ifFalse(() => {
            Error().signal()
        })

        this.bits * 31 + this.version
    }
}

_coreIpAddressCanonical: IpAddress
