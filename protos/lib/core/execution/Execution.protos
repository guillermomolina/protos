// EXTERNAL_PROCESS.md §§1-3: authority-free, source-backed external
// execution protocol. Possessing this prototype confers no authority: the
// private bridge authenticates the host grant and performs host effects.
// _coreExecutionBridge stays in the unpublished Core bootstrap context and
// is never a Prelude binding, module member or slot of Execution.
//
// start has exactly four arguments. Portable type validation and the argv
// snapshot happen here, before any host effect; native representability,
// the Map snapshot and environment-name uniqueness are checked by the
// bridge in the same turn.

Execution: {
    start: (...args) => {
        bridge: _coreExecutionBridge
        if(args.size() != 4) {
            Error().signal()
        }
        executable: args[0]
        arguments: args[1]
        environment: args[2]
        workingDirectory: args[3]

        argv: null
        valid: String.recognizes(executable) && Array.recognizes(arguments)
        if(valid) {
            argv = Array(...arguments)
            for(argument in argv) {
                if(!String.recognizes(argument)) {
                    valid = false
                }
            }
        }
        if(valid && (workingDirectory !== null)) {
            valid = String.recognizes(workingDirectory)
        }

        answer: null
        if(valid) {
            answer = bridge.start(this, executable, argv, environment, workingDirectory)
        } else {
            answer = bridge.failed(InvalidIOArgument {})
        }
        answer
    }
}
