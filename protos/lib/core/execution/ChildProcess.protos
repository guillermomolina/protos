// EXTERNAL_PROCESS.md §§2, 5-7: authority-free child protocol. Every
// selector authenticates the receiver as a host-registered child through the
// private bridge; an imitation or delegating child of this prototype is not a
// child capability. Repeated stdin/stdout/stderr return the same logical
// endpoint. There is deliberately no close, PID or native selector.

ChildProcess: {
    stdin: (...args) => {
        if(args.size() != 0) {
            Error().signal()
        }
        _coreExecutionBridge.childStdin(this)
    }

    stdout: (...args) => {
        if(args.size() != 0) {
            Error().signal()
        }
        _coreExecutionBridge.childStdout(this)
    }

    stderr: (...args) => {
        if(args.size() != 0) {
            Error().signal()
        }
        _coreExecutionBridge.childStderr(this)
    }

    wait: (...args) => {
        if(args.size() != 0) {
            Error().signal()
        }
        _coreExecutionBridge.childWait(this)
    }

    terminate: (...args) => {
        if(args.size() != 0) {
            Error().signal()
        }
        _coreExecutionBridge.childTerminate(this)
    }
}
