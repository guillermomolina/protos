// D243-C: authority-free, source-backed secure entropy protocol.
// The private bridge authenticates grants and performs host effects.
// Possessing this prototype does not confer entropy authority.

Entropy: {
    bytes: (...args) => {
        bridge: _coreEntropyBridge
        count: null

        if(args.size() == 1) {
            candidate: args[0]
            if(Integer.recognizes(candidate)) {
                if(candidate >= 0) {
                    if(candidate <= 65536) {
                        count = candidate
                    }
                }
            }
        }

        answer: null
        if(count === null) {
            answer = bridge.failed(InvalidIOArgument {})
        } else {
            answer = bridge.generate(this, count)
        }
        answer
    }

    close: (...args) => {
        bridge: _coreEntropyBridge
        answer: null
        if(args.size() == 0) {
            answer = bridge.close(this)
        } else {
            answer = bridge.failed(InvalidIOArgument {})
        }
        answer
    }
}
