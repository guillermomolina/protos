//! Standard Library HMAC-SHA256 (D244-C, CRYPTO.md).
//!
//! Exports exactly digest(key, message) and verify(key, message, tag).
//! All inputs must be exact standard Bytes, with no String coercion.
//! Both operations are synchronous and require no ambient authority.
//!
//! Keys contain 0..4096 octets and messages 0..16777216 octets.
//! An empty key is algorithmically valid but insecure for authentication.
//! Verification requires a complete 32-octet tag.

/// Calculate HMAC-SHA256 over exact Bytes.
/// Answers fresh, independent, open standard Bytes of 32 octets.
/// Invalid argument domains and bounds signal an ordinary Error.
this.digest: ((facility) => {
    (key, message) => {
        facility.digest(key, message)
    }
})(_hmacSha256Facility)

/// Verify a complete HMAC-SHA256 tag.
/// Answers true only for a matching 32-octet tag.
/// Incorrect well-typed tags answer false.
/// Invalid argument domains and bounds signal an ordinary Error.
this.verify: ((facility) => {
    (key, message, tag) => {
        facility.verify(key, message, tag)
    }
})(_hmacSha256Facility)

// Keep the runtime backend only in the closures' lexical environment.
context.removeSlot("_hmacSha256Facility")
