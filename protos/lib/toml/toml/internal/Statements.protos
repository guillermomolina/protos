//! Private TOML statements implementation.

documentStatements: (text) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    source: Encoding.UTF8.encode(text)
    index: 0
    length: source.size()

    statementChunks: Map()
    statementMaxLevel: -1
    buffer: Encoding.UTF8.encode("")
    significant: false

    carryStatementChunk: (initialChunk, initialLevel) => {
        chunk: initialChunk
        level: initialLevel
        carrying: true
        while(carrying) {
            present: statementChunks.containsKey(level)
            if(present) {
                left: statementChunks[level]
                statementChunks.remove(level)
                chunk = Array(...left, ...chunk)
                level = level + 1
            }
            present.ifFalse(() => {
                statementChunks[level] = chunk
                if(level > statementMaxLevel) {
                    statementMaxLevel = level
                }
                carrying = false
            })
        }
    }

    collectStatementChunks: (initialLevel, initialResult) => {
        level: initialLevel
        result: initialResult
        while(level >= 0) {
            if(statementChunks.containsKey(level)) {
                result = Array(...result, ...statementChunks[level])
            }
            level = level - 1
        }
        result
    }
    squareDepth: 0
    braceDepth: 0
    stringQuote: -1
    multiline: false
    comment: false

    peek: () => {
        value: -1
        if(index < length) {
            value = source[index]
        }
        value
    }

    take: () => {
        if(index >= length) {
            fail()
        }
        value: source[index]
        index = index + 1
        value
    }

    append: (octet) => {
        buffer.add(octet)
        (octet == 32).ifFalse(() => {
            (octet == 9).ifFalse(() => {
                significant = true
            })
        })
    }

    appendQuotes: (quote, count) => {
        remaining: count
        while(remaining > 0) {
            append(quote)
            remaining = remaining - 1
        }
    }

    quoteRun: (quote) => {
        look: index
        count: 0
        scanning: true

        while(scanning && (look < length)) {
            matches: source[look] == quote
            if(matches) {
                count = count + 1
                look = look + 1
            }
            matches.ifFalse(() => {
                scanning = false
            })
        }

        count
    }

    finish: () => {
        if(significant) {
            carryStatementChunk(Array(Encoding.UTF8.decode(buffer)), 0)
        }
        buffer = Encoding.UTF8.encode("")
        significant = false
    }

    appendNewline: (include) => {
        first: take()
        if(first == 10) {
            if(include) { append(10) }
        }
        if(first == 13) {
            (peek() == 10).ifFalse(() => {
                fail()
            })
            second: take()
            if(include) {
                append(13)
                append(second)
            }
        }
        (first == 10).ifFalse(() => {
            (first == 13).ifFalse(() => {
                fail()
            })
        })
    }

    step: () => {
        octet: peek()

        wasComment: comment
        if(wasComment) {
            isNewline: octet == 10
            if(octet == 13) { isNewline = true }

            if(isNewline) {
                comment = false
                nested: squareDepth > 0
                if(braceDepth > 0) { nested = true }
                if(nested) {
                    appendNewline(true)
                }
                nested.ifFalse(() => {
                    appendNewline(false)
                    finish()
                })
            }

            isNewline.ifFalse(() => {
                forbiddenControl: octet < 32
                if(octet == 9) {
                    forbiddenControl = false
                }
                if(octet == 127) {
                    forbiddenControl = true
                }
                if(forbiddenControl) {
                    fail()
                }
                index = index + 1
            })
        }

        wasComment.ifFalse(() => {
            wasString: stringQuote >= 0
            if(wasString) {
                wasMultiline: multiline
                if(wasMultiline) {
                    // Snapshot this before closing mutates stringQuote.
                    quoteOctet: octet == stringQuote
                    if(quoteOctet) {
                        run: quoteRun(stringQuote)
                        if(run >= 3) {
                            if(run > 5) {
                                fail()
                            }
                            appendQuotes(stringQuote, run)
                            index = index + run
                            stringQuote = -1
                            multiline = false
                        }
                        if(run < 3) {
                            append(take())
                        }
                    }

                    quoteOctet.ifFalse(() => {
                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        if(escapedBasic) {
                            append(take())
                            if(index >= length) {
                                fail()
                            }
                            append(take())
                        }

                        escapedBasic.ifFalse(() => {
                            append(take())
                        })
                    })
                }

                wasMultiline.ifFalse(() => {
                    isNewline: octet == 10
                    if(octet == 13) { isNewline = true }
                    if(isNewline) {
                        fail()
                    }

                    escapedBasic: stringQuote == 34
                    (octet == 92).ifFalse(() => {
                        escapedBasic = false
                    })

                    if(escapedBasic) {
                        append(take())
                        if(index >= length) {
                            fail()
                        }
                        append(take())
                    }

                    escapedBasic.ifFalse(() => {
                        append(take())
                        if(octet == stringQuote) {
                            stringQuote = -1
                        }
                    })
                })
            }

            wasString.ifFalse(() => {
                if(octet == 35) {
                    comment = true
                    index = index + 1
                }

                (octet == 35).ifFalse(() => {
                    isQuote: octet == 34
                    if(octet == 39) { isQuote = true }

                    if(isQuote) {
                        run: quoteRun(octet)
                        if(run >= 3) {
                            appendQuotes(octet, 3)
                            index = index + 3
                            stringQuote = octet
                            multiline = true
                        }
                        if(run < 3) {
                            append(take())
                            stringQuote = octet
                            multiline = false
                        }
                    }

                    isQuote.ifFalse(() => {
                        if(octet == 91) {
                            squareDepth = squareDepth + 1
                            append(take())
                        }
                        if(octet == 93) {
                            if(squareDepth == 0) {
                                fail()
                            }
                            squareDepth = squareDepth - 1
                            append(take())
                        }
                        if(octet == 123) {
                            braceDepth = braceDepth + 1
                            append(take())
                        }
                        if(octet == 125) {
                            if(braceDepth == 0) {
                                fail()
                            }
                            braceDepth = braceDepth - 1
                            append(take())
                        }

                        structural: octet == 91
                        if(octet == 93) { structural = true }
                        if(octet == 123) { structural = true }
                        if(octet == 125) { structural = true }

                        structural.ifFalse(() => {
                            isNewline: octet == 10
                            if(octet == 13) { isNewline = true }

                            if(isNewline) {
                                nested: squareDepth > 0
                                if(braceDepth > 0) { nested = true }
                                if(nested) {
                                    appendNewline(true)
                                }
                                nested.ifFalse(() => {
                                    appendNewline(false)
                                    finish()
                                })
                            }

                            isNewline.ifFalse(() => {
                                append(take())
                            })
                        })
                    })
                })
            })
        })

    }

    visitIndex: 0
    for(ignoredOctet in source) {
        if(visitIndex == index) {
            step()
        }
        visitIndex = visitIndex + 1
    }

    (index == length).ifFalse(() => {
        fail()
    })

    if(stringQuote >= 0) {
        fail()
    }
    if(squareDepth != 0) {
        fail()
    }
    if(braceDepth != 0) {
        fail()
    }

    finish()
    collectStatementChunks(statementMaxLevel, Array())
}
