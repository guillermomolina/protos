//! Private TOML nodes implementation.

string: (value) => {
    String.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "string"
        value: value
    }
}

integer: (value) => {
    Integer.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "integer"
        value: value
    }
}

float: (value) => {
    Float.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "float"
        value: value
    }
}

boolean: (value) => {
    valid: value === true
    if(value === false) {
        valid = true
    }
    valid.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "boolean"
        value: value
    }
}

array: (...nodes) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        if(kind === "integer") { valid = true }
        if(kind === "float") { valid = true }
        if(kind === "boolean") { valid = true }
        if(kind === "offsetDateTime") { valid = true }
        if(kind === "localDateTime") { valid = true }
        if(kind === "localDate") { valid = true }
        if(kind === "localTime") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "table") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    for(node in nodes) {
        validateNode(node)
    }

    {
        kind: "array"
        value: nodes
    }
}

table: (...nameNodePairs) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        if(kind === "integer") { valid = true }
        if(kind === "float") { valid = true }
        if(kind === "boolean") { valid = true }
        if(kind === "offsetDateTime") { valid = true }
        if(kind === "localDateTime") { valid = true }
        if(kind === "localDate") { valid = true }
        if(kind === "localTime") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "table") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    result: Map()
    pendingName: null
    expectingName: true

    for(entry in nameNodePairs) {
        wasExpectingName: expectingName

        if(wasExpectingName) {
            String.recognizes(entry).ifFalse(() => {
                Error().signal()
            })
            pendingName = entry
            expectingName = false
        }

        wasExpectingName.ifFalse(() => {
            validateNode(entry)
            if(result.containsKey(pendingName)) {
                Error().signal()
            }
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    }

    expectingName.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "table"
        value: result
    }
}
