//! Private TOML encoder implementation.

EncoderScalars: import("./EncoderScalars.protos")
EncoderTemporal: import("./EncoderTemporal.protos")

encode: (selectString, selectInteger, selectFloat, selectBoolean, selectLocalDate, selectLocalTime, selectLocalDateTime, selectOffsetDateTime, rootTable) => {
    output: Encoding.UTF8.encode("")

    scalars: EncoderScalars.create(output)
    emitHexNibble: scalars.slotValue("emitHexNibble")
    emitBasicString: scalars.slotValue("emitBasicString")
    integerText: scalars.slotValue("integerText")
    repeatZero: scalars.slotValue("repeatZero")
    powerInteger: scalars.slotValue("powerInteger")
    absoluteInteger: scalars.slotValue("absoluteInteger")
    decimalToken: scalars.slotValue("decimalToken")
    floatText: scalars.slotValue("floatText")
    paddedIntegerText: scalars.slotValue("paddedIntegerText")
    fractionText: scalars.slotValue("fractionText")
    temporal: EncoderTemporal.create(selectLocalDate, selectLocalTime, selectLocalDateTime, selectOffsetDateTime, paddedIntegerText, fractionText)
    dateText: temporal.slotValue("dateText")
    timeText: temporal.slotValue("timeText")
    localDateTimeText: temporal.slotValue("localDateTimeText")
    offsetDateTimeText: temporal.slotValue("offsetDateTimeText")

    emitText: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        for(octet in Encoding.UTF8.encode(text)) {
            output.add(octet)
        }
    }

    active: IdentityMap()
    topFrame: null

    snapshotTableEntries: (tableValue) => {
        entries: Map()
        count: 0

        tableValue.each((name, child) => {
            String.recognizes(name).ifFalse(() => {
                Error().signal()
            })
            entries[count] = {
                name: name
                child: child
            }
            count = count + 1
        })

        {
            entries: entries
            count: count
        }
    }

    pushValue: (node, parentFrame) => {
        kind: node.kind
        value: node.value
        handled: false

        if(kind === "string") {
            ignoredValidation: (selectString())(value)
            emitBasicString(value)
            handled = true
        }

        if(kind === "integer") {
            ignoredValidation: (selectInteger())(value)
            emitText(integerText(value))
            handled = true
        }

        if(kind === "float") {
            ignoredValidation: (selectFloat())(value)
            emitText(floatText(value))
            handled = true
        }

        if(kind === "boolean") {
            ignoredValidation: (selectBoolean())(value)
            if(value === true) {
                emitText("true")
            }
            if(value === false) {
                emitText("false")
            }
            handled = true
        }

        if(kind === "localDate") {
            emitText(dateText(value))
            handled = true
        }

        if(kind === "localTime") {
            emitText(timeText(value))
            handled = true
        }

        if(kind === "localDateTime") {
            emitText(localDateTimeText(value))
            handled = true
        }

        if(kind === "offsetDateTime") {
            emitText(offsetDateTimeText(value))
            handled = true
        }

        if(kind === "array") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(91)
            topFrame = {
                frameKind: "array"
                parent: parentFrame
                node: node
                values: value
                count: value.size()
                index: 0
            }
            handled = true
        }

        if(kind === "table") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            snapshot: snapshotTableEntries(value)
            output.add(123)
            topFrame = {
                frameKind: "table"
                parent: parentFrame
                node: node
                entries: snapshot.entries
                count: snapshot.count
                index: 0
            }
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    (rootTable.kind === "table").ifFalse(() => {
        fail()
    })

    rootSnapshot: snapshotTableEntries(rootTable.value)
    active[rootTable] = true
    topFrame = {
        frameKind: "root"
        parent: null
        node: rootTable
        entries: rootSnapshot.entries
        count: rootSnapshot.count
        index: 0
    }

    running: true
    while(running) {
        frame: topFrame
        frameKind: frame.frameKind

        if(frameKind == "root") {
            if(frame.index >= frame.count) {
                if(frame.count > 0) {
                    output.add(10)
                }
                active.remove(frame.node)
                running = false
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    output.add(10)
                }

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            }
        }

        if(frameKind == "array") {
            if(frame.index >= frame.count) {
                output.add(93)
                active.remove(frame.node)
                topFrame = frame.parent
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    emitText(", ")
                }

                child: frame.values[frame.index]
                frame.index = frame.index + 1
                pushValue(child, frame)
            }
        }

        if(frameKind == "table") {
            if(frame.index >= frame.count) {
                output.add(125)
                active.remove(frame.node)
                topFrame = frame.parent
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    emitText(", ")
                }

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            }
        }
    }

    Encoding.UTF8.decode(output)
}
