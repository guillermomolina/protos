//! Private TOML temporalnodes implementation.

localDate: (year, month, day) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }

    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    date: {
        year: year
        month: month
        day: day
    }

    {
        kind: "localDate"
        value: date
    }
}

localTime: (hour, minute, second, fractionCoefficient, fractionDigits) => {
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    time: {
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localTime"
        value: time
    }
}

localDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }
    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localDateTime"
        value: dateTime
    }
}

offsetDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits,
    offsetMinutes
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits
    ignoredOffsetValidation: 0 + offsetMinutes

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }
    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    if((offsetMinutes < -1439) || (offsetMinutes > 1439)) {
        Error().signal()
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
        offsetMinutes: offsetMinutes
    }

    {
        kind: "offsetDateTime"
        value: dateTime
    }
}
