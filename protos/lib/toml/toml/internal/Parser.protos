//! Private TOML parser implementation.

KeyParser: import("./KeyParser.protos")
ValueParser: import("./ValueParser.protos")
Statements: import("./Statements.protos")
DocumentParser: import("./DocumentParser.protos")

parseDialect: (selectLocalDate, selectLocalTime, selectLocalDateTime, selectOffsetDateTime, text, version) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    String.recognizes(version).ifFalse(() => {
        Error().signal()
    })
    toml11: version == "1.1"
    (toml11 || (version == "1.0")).ifFalse(() => {
        Error().signal()
    })

    publicLocalDate: selectLocalDate()
    publicLocalTime: selectLocalTime()
    publicLocalDateTime: selectLocalDateTime()
    publicOffsetDateTime: selectOffsetDateTime()

    syntaxNode: (kind, value) => {
        result: {
            kind: kind
            value: value
        }
        result
    }
    keys: KeyParser.create(toml11)
    syntaxKeyPath: keys.slotValue("syntaxKeyPath")
    values: ValueParser.create(toml11, syntaxNode, publicLocalDate, publicLocalTime, publicLocalDateTime, publicOffsetDateTime)
    syntaxValue: values.slotValue("syntaxValue")
    document: DocumentParser.create(Statements.slotValue("documentStatements"), syntaxKeyPath, syntaxValue)
    documentTable: document.slotValue("documentTable")

    documentTable(text)
}
