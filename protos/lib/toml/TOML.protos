        twoDigitsAt: (token, position) => {
            valid: position + 1 < token.size()
            value: 0

            if(valid) {
                first: decimalDigit(token[position])
                second: decimalDigit(token[position + 1])
                if((first < 0) || (second < 0)) {
                    valid = false
                }
                if(valid) {
                    value = first * 10 + second
                }
            }

            {
                valid: valid
                value: value
            }
        }

        fourDigitsAt: (token, position) => {
            valid: position + 3 < token.size()
            value: 0
            offset: 0

            scan: null
            scan = () => {
                if(offset < 4) {
                    if(valid) {
                        digit: decimalDigit(token[position + offset])
                        if(digit < 0) {
                            valid = false
                        }
                        if(digit >= 0) {
                            value = value * 10 + digit
                        }
                    }
                    offset = offset + 1
                    scan()
                }
            }

            if(valid) {
                scan()
            }

            {
                valid: valid
                value: value
            }
        }

        timeAt: (token, start) => {
            tokenLength: token.size()
            valid: start + 4 < tokenLength

            hour: 0
            minute: 0
            second: 0
            fractionCoefficient: 0
            fractionDigits: 0
            position: start

            if(valid) {
                hourPart: twoDigitsAt(token, start)
                minutePart: twoDigitsAt(token, start + 3)

                (token[start + 2] == 58).ifFalse(() => {
                    valid = false
                })
                (hourPart.valid && minutePart.valid).ifFalse(() => {
                    valid = false
                })

                if(valid) {
                    hour = hourPart.value
                    minute = minutePart.value
                    position = start + 5
                }
            }

            // TOML 1.0 requires the seconds field; TOML 1.1 lets it be omitted.
            if(valid) {
                toml11.ifFalse(() => {
                    secondsPresent: false
                    if(position < tokenLength) {
                        secondsPresent = token[position] == 58
                    }
                    secondsPresent.ifFalse(() => {
                        valid = false
                    })
                })
            }

            if(valid) {
                if(position < tokenLength) {
                    if(token[position] == 58) {
                        secondPart: twoDigitsAt(token, position + 1)
                        secondPart.valid.ifFalse(() => {
                            valid = false
                        })
                        if(secondPart.valid) {
                            second = secondPart.value
                            position = position + 3

                            if(position < tokenLength) {
                                if(token[position] == 46) {
                                    position = position + 1
                                    fractionStart: position

                                    scanningFraction: true
                                    while(scanningFraction && (position < tokenLength)) {
                                        digit: decimalDigit(token[position])
                                        if(digit >= 0) {
                                            fractionCoefficient =
                                                fractionCoefficient * 10 + digit
                                            fractionDigits = fractionDigits + 1
                                            position = position + 1
                                        }
                                        if(digit < 0) {
                                            scanningFraction = false
                                        }
                                    }
                                    if(position == fractionStart) {
                                        valid = false
                                    }
                                }
                            }
                        }
                    }
                }
            }

            {
                valid: valid
                hour: hour
                minute: minute
                second: second
                fractionCoefficient: fractionCoefficient
                fractionDigits: fractionDigits
                position: position
            }
        }

        temporalFromToken: (token) => {
            tokenLength: token.size()
            result: {
                valid: false
                value: null
            }

            dateShape: tokenLength >= 10
            if(dateShape) {
                ((token[4] == 45) && (token[7] == 45)).ifFalse(() => {
                    dateShape = false
                })
            }

            if(dateShape) {
                yearPart: fourDigitsAt(token, 0)
                monthPart: twoDigitsAt(token, 5)
                dayPart: twoDigitsAt(token, 8)
                (yearPart.valid && monthPart.valid && dayPart.valid).ifFalse(() => {
                    dateShape = false
                })

                if(dateShape) {
                    if(tokenLength == 10) {
                        result.value =
                            publicLocalDate(yearPart.value, monthPart.value, dayPart.value)
                        result.valid = true
                    }

                    if(tokenLength > 10) {
                        delimiter: token[10]
                        validDelimiter: delimiter == 84
                        if(delimiter == 116) { validDelimiter = true }
                        if(delimiter == 32) { validDelimiter = true }

                        if(validDelimiter) {
                            parsedTime: timeAt(token, 11)
                            if(parsedTime.valid) {
                                position: parsedTime.position

                                if(position == tokenLength) {
                                    result.value =
