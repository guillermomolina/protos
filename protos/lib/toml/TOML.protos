                (offset < 4).ifTrue(() => {
                    valid.ifTrue(() => {
                        digit: decimalDigit(token[position + offset])
                        (digit < 0).ifTrue(() => {
                            valid = false
                        })
                        (digit >= 0).ifTrue(() => {
                            value = value * 10 + digit
                        })
                    })
                    offset = offset + 1
                    scan()
                })
            }

            valid.ifTrue(() => {
                scan()
            })

            {
                valid: valid
                value: value
            }
        }

        timeAt: (token, start) => {
            tokenLength: token.size()
            valid: start + 4 < tokenLength

            hour: 0
            minute: 0
            second: 0
            fractionCoefficient: 0
            fractionDigits: 0
            position: start

            valid.ifTrue(() => {
                hourPart: twoDigitsAt(token, start)
                minutePart: twoDigitsAt(token, start + 3)

                (token[start + 2] == 58).ifFalse(() => {
                    valid = false
                })
                (hourPart.valid && minutePart.valid).ifFalse(() => {
                    valid = false
                })

                valid.ifTrue(() => {
                    hour = hourPart.value
                    minute = minutePart.value
                    position = start + 5
                })
            })

            valid.ifTrue(() => {
                (position < tokenLength).ifTrue(() => {
                    (token[position] == 58).ifTrue(() => {
                        secondPart: twoDigitsAt(token, position + 1)
                        secondPart.valid.ifFalse(() => {
                            valid = false
                        })
                        secondPart.valid.ifTrue(() => {
                            second = secondPart.value
                            position = position + 3

                            (position < tokenLength).ifTrue(() => {
                                (token[position] == 46).ifTrue(() => {
                                    position = position + 1
                                    fractionStart: position

                                    scanFraction: null
                                    scanFraction = () => {
                                        (position < tokenLength).ifTrue(() => {
                                            digit: decimalDigit(token[position])
                                            (digit >= 0).ifTrue(() => {
                                                fractionCoefficient =
                                                    fractionCoefficient * 10 + digit
                                                fractionDigits = fractionDigits + 1
                                                position = position + 1
                                                scanFraction()
                                            })
                                        })
                                    }

                                    scanFraction()
                                    (position == fractionStart).ifTrue(() => {
                                        valid = false
                                    })
                                })
                            })
                        })
                    })
                })
            })

            {
                valid: valid
                hour: hour
                minute: minute
                second: second
                fractionCoefficient: fractionCoefficient
                fractionDigits: fractionDigits
                position: position
            }
        }

        temporalFromToken: (token) => {
            tokenLength: token.size()
            result: {
                valid: false
                value: null
            }

            dateShape: tokenLength >= 10
            dateShape.ifTrue(() => {
                ((token[4] == 45) && (token[7] == 45)).ifFalse(() => {
                    dateShape = false
                })
            })

            dateShape.ifTrue(() => {
                yearPart: fourDigitsAt(token, 0)
                monthPart: twoDigitsAt(token, 5)
                dayPart: twoDigitsAt(token, 8)
                (yearPart.valid && monthPart.valid && dayPart.valid).ifFalse(() => {
                    dateShape = false
                })

                dateShape.ifTrue(() => {
                    (tokenLength == 10).ifTrue(() => {
                        result.value =
                            publicLocalDate(yearPart.value, monthPart.value, dayPart.value)
                        result.valid = true
                    })

                    (tokenLength > 10).ifTrue(() => {
                        delimiter: token[10]
                        validDelimiter: delimiter == 84
                        (delimiter == 116).ifTrue(() => { validDelimiter = true })
                        (delimiter == 32).ifTrue(() => { validDelimiter = true })

                        validDelimiter.ifTrue(() => {
                            parsedTime: timeAt(token, 11)
                            parsedTime.valid.ifTrue(() => {
                                position: parsedTime.position

                                (position == tokenLength).ifTrue(() => {
                                    result.value =
                                        publicLocalDateTime(
                                            yearPart.value,
                                            monthPart.value,
                                            dayPart.value,
                                            parsedTime.hour,
                                            parsedTime.minute,
                                            parsedTime.second,
                                            parsedTime.fractionCoefficient,
                                            parsedTime.fractionDigits
                                        )
                                    result.valid = true
                                })

                                (position < tokenLength).ifTrue(() => {
                                    offsetMinutes: 0
                                    offsetValid: false
                                    offsetEnd: position

                                    ((token[position] == 90) ||
                                        (token[position] == 122)).ifTrue(() => {
                                        offsetValid = true
                                        offsetEnd = position + 1
                                    })

                                    ((token[position] == 43) ||
                                        (token[position] == 45)).ifTrue(() => {
                                        (position + 5 < tokenLength).ifTrue(() => {
                                            (token[position + 3] == 58).ifTrue(() => {
                                                offsetHour: twoDigitsAt(token, position + 1)
                                                offsetMinute: twoDigitsAt(token, position + 4)

                                                (offsetHour.valid && offsetMinute.valid).ifTrue(() => {
                                                    ((offsetHour.value <= 23) &&
                                                        (offsetMinute.value <= 59)).ifTrue(() => {
                                                        offsetMinutes =
                                                            offsetHour.value * 60 +
                                                            offsetMinute.value
                                                        (token[position] == 45).ifTrue(() => {
                                                            offsetMinutes =
                                                                0 - offsetMinutes
                                                        })
                                                        offsetEnd = position + 6
                                                        offsetValid = true
                                                    })
                                                })
                                            })
                                        })
                                    })

                                    (offsetValid && (offsetEnd == tokenLength)).ifTrue(() => {
                                        result.value =
                                            publicOffsetDateTime(
                                                yearPart.value,
                                                monthPart.value,
                                                dayPart.value,
                                                parsedTime.hour,
                                                parsedTime.minute,
                                                parsedTime.second,
                                                parsedTime.fractionCoefficient,
                                                parsedTime.fractionDigits,
                                                offsetMinutes
                                            )
                                        result.valid = true
                                    })
                                })
                            })
                        })
                    })
                })
            })

            dateShape.ifFalse(() => {
                parsedTime: timeAt(token, 0)
                (parsedTime.valid && (parsedTime.position == tokenLength)).ifTrue(() => {
                    result.value =
                        publicLocalTime(
                            parsedTime.hour,
                            parsedTime.minute,
                            parsedTime.second,
                            parsedTime.fractionCoefficient,
                            parsedTime.fractionDigits
                        )
                    result.valid = true
                })
            })

            result
        }

        isBareTerminator: (octet) => {
            result: octet < 0
            isSpace(octet).ifTrue(() => { result = true })
            isNewlineStart(octet).ifTrue(() => { result = true })
            (octet == 35).ifTrue(() => { result = true })
            (octet == 44).ifTrue(() => { result = true })
            (octet == 93).ifTrue(() => { result = true })
            (octet == 125).ifTrue(() => { result = true })
            result
        }

        parseBareValue: () => {
            token: Encoding.UTF8.encode("")

            gather: null
            gather = () => {
                octet: peek()
                terminator: octet < 0
                isNewlineStart(octet).ifTrue(() => { terminator = true })
                (octet == 35).ifTrue(() => { terminator = true })
                (octet == 44).ifTrue(() => { terminator = true })
                (octet == 93).ifTrue(() => { terminator = true })
                (octet == 125).ifTrue(() => { terminator = true })

                terminator.ifFalse(() => {
                    invalidControl: octet < 32
                    (octet == 9).ifTrue(() => {
                        invalidControl = false
                    })
                    (octet == 127).ifTrue(() => {
                        invalidControl = true
                    })
                    invalidControl.ifTrue(() => {
                        fail()
                    })
                    token.add(take())
                    gather()
                })
            }

            gather()
            (token.size() == 0).ifTrue(() => {
                fail()
            })

            right: token.size()
            trimRight: null
            trimRight = () => {
                (right > 0).ifTrue(() => {
                    isSpace(token[right - 1]).ifTrue(() => {
                        right = right - 1
                        trimRight()
                    })
                })
            }
            trimRight()

            trimmed: Encoding.UTF8.encode("")
            copyIndex: 0
            copyTrimmed: null
            copyTrimmed = () => {
                (copyIndex < right).ifTrue(() => {
                    trimmed.add(token[copyIndex])
                    copyIndex = copyIndex + 1
                    copyTrimmed()
                })
            }
            copyTrimmed()

            (trimmed.size() == 0).ifTrue(() => {
                fail()
            })

            decoded: Encoding.UTF8.decode(trimmed)
            result: null

            (decoded == "true").ifTrue(() => {
                result = syntaxNode("boolean", true)
            })
            (decoded == "false").ifTrue(() => {
                result = syntaxNode("boolean", false)
            })

            (result === null).ifTrue(() => {
                integer: integerFromToken(trimmed)
                integer.valid.ifTrue(() => {
                    result = syntaxNode("integer", integer.value)
                })
            })

            (result === null).ifTrue(() => {
                temporal: temporalFromToken(trimmed)
                temporal.valid.ifTrue(() => {
                    result = temporal.value
                })
            })

            (result === null).ifTrue(() => {
                floating: floatFromToken(trimmed)
                floating.valid.ifTrue(() => {
                    result = syntaxNode("float", floating.value)
                })
            })

            (result === null).ifTrue(() => {
                fail()
            })

            result
        }

        topFrame: null
        depth: 0
        rootValue: null
        rootDone: false

        pushArrayFrame: () => {
            frame: {
                parent: topFrame
                kind: "array"
                phase: "valueOrEnd"
                chunks: Map()
                maxLevel: -1
            }
            topFrame = frame
            depth = depth + 1
        }

        pushInlineTableFrame: () => {
            frame: {
                parent: topFrame
                kind: "inlineTable"
                phase: "keyOrEnd"
                entries: Map()
                pendingPath: null
            }
            topFrame = frame
            depth = depth + 1
        }

        appendArrayValue: (frame, valueNode) => {
            carryFrameChunk(frame, Array(valueNode), 0)
            frame.phase = "commaOrEnd"
        }

        acceptValue: (valueNode) => {
            (depth == 0).ifTrue(() => {
                rootDone.ifTrue(() => { fail() })
                rootValue = valueNode
                rootDone = true
            })

            (depth > 0).ifTrue(() => {
                frame: topFrame

                (frame.kind == "array").ifTrue(() => {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    appendArrayValue(frame, valueNode)
                })

                (frame.kind == "inlineTable").ifTrue(() => {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    putPath(frame.entries, frame.pendingPath, 0, valueNode)
                    frame.pendingPath = null
                    frame.phase = "commaOrEnd"
                })
            })
        }

        closeArrayFrame: () => {
            frame: topFrame
            (frame.kind == "array").ifFalse(() => { fail() })
            validPhase: frame.phase == "valueOrEnd"
            (frame.phase == "commaOrEnd").ifTrue(() => { validPhase = true })
            validPhase.ifFalse(() => { fail() })

            materialized: collectFrameChunks(frame, frame.maxLevel, Array())
            valueNode: syntaxNode("array", materialized)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        closeInlineTableFrame: () => {
            frame: topFrame
            (frame.kind == "inlineTable").ifFalse(() => { fail() })
            validPhase: frame.phase == "keyOrEnd"
            (frame.phase == "commaOrEnd").ifTrue(() => { validPhase = true })
            validPhase.ifFalse(() => { fail() })

            valueNode: syntaxNode("table", frame.entries)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        startValue: () => {
            skipSpaces()
            first: peek()
            (first < 0).ifTrue(() => { fail() })
            handled: false

            (first == 91).ifTrue(() => {
                index = index + 1
                pushArrayFrame()
                handled = true
            })
            (first == 123).ifTrue(() => {
                index = index + 1
                pushInlineTableFrame()
                handled = true
            })

            handled.ifFalse(() => {
                result: null
                (first == 34).ifTrue(() => {
                    multiline: false
                    (index + 2 < length).ifTrue(() => {
                        ((source[index + 1] == 34) &&
                            (source[index + 2] == 34)).ifTrue(() => {
                            multiline = true
                        })
                    })
                    result = syntaxNode("string", parseBasicString(multiline))
                })
                (first == 39).ifTrue(() => {
                    multiline: false
                    (index + 2 < length).ifTrue(() => {
                        ((source[index + 1] == 39) &&
                            (source[index + 2] == 39)).ifTrue(() => {
                            multiline = true
                        })
                    })
                    result = syntaxNode("string", parseLiteralString(multiline))
                })
                (result === null).ifTrue(() => {
                    result = parseBareValue()
                })
                acceptValue(result)
            })
        }

        running: true
        (() => running).while(() => {
            wasTopLevel: depth == 0

            wasTopLevel.ifTrue(() => {
                rootDone.ifTrue(() => {
                    running = false
                })
                rootDone.ifFalse(() => {
                    startValue()
                })
            })

            wasTopLevel.ifFalse(() => {
                frame: topFrame
                phase: frame.phase

                (frame.kind == "array").ifTrue(() => {
                    skipArrayTrivia()

                    (phase == "valueOrEnd").ifTrue(() => {
                        (peek() == 93).ifTrue(() => {
                            index = index + 1
                            closeArrayFrame()
                        })
                        (peek() == 93).ifFalse(() => {
                            frame.phase = "awaitValue"
                            startValue()
                        })
                    })

                    (phase == "value").ifTrue(() => {
                        frame.phase = "awaitValue"
                        startValue()
                    })

                    (phase == "commaOrEnd").ifTrue(() => {
                        comma: peek() == 44
                        closing: peek() == 93
                        comma.ifTrue(() => {
                            index = index + 1
                            skipArrayTrivia()
                            (peek() == 93).ifTrue(() => {
                                index = index + 1
                                closeArrayFrame()
                            })
                            (peek() == 93).ifFalse(() => {
                                frame.phase = "value"
                            })
                        })
                        comma.ifFalse(() => {
                            closing.ifTrue(() => {
                                index = index + 1
                                closeArrayFrame()
                            })
                            closing.ifFalse(() => { fail() })
                        })
                    })
                })

                (frame.kind == "inlineTable").ifTrue(() => {
                    skipArrayTrivia()

                    (phase == "keyOrEnd").ifTrue(() => {
                        (peek() == 125).ifTrue(() => {
                            index = index + 1
                            closeInlineTableFrame()
                        })
                        (peek() == 125).ifFalse(() => {
                            frame.pendingPath = parseKeyPath()
                            skipSpaces()
                            (take() == 61).ifFalse(() => { fail() })
                            skipSpaces()
                            frame.phase = "value"
                        })
                    })

                    (phase == "value").ifTrue(() => {
                        frame.phase = "awaitValue"
                        startValue()
                    })

                    (phase == "commaOrEnd").ifTrue(() => {
                        comma: peek() == 44
                        closing: peek() == 125
                        comma.ifTrue(() => {
                            index = index + 1
                            skipArrayTrivia()
                            (peek() == 125).ifTrue(() => {
                                index = index + 1
                                closeInlineTableFrame()
                            })
                            (peek() == 125).ifFalse(() => {
                                frame.phase = "keyOrEnd"
                            })
                        })
                        comma.ifFalse(() => {
                            closing.ifTrue(() => {
                                index = index + 1
                                closeInlineTableFrame()
                            })
                            closing.ifFalse(() => { fail() })
                        })
                    })
                })
            })
        })

        result: rootValue
        skipSpaces()
        (peek() == 35).ifTrue(() => {
            index = index + 1
            skipComment()
        })
        (index < length).ifTrue(() => {
            isNewlineStart(peek()).ifTrue(() => { consumeNewline() })
        })
        skipSpaces()
        (index == length).ifFalse(() => { fail() })
        result

    }

    documentStatements: (text) => {
        ignoredStringValidation: text + ""
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        result: Array()
        buffer: Encoding.UTF8.encode("")
        significant: false
        squareDepth: 0
        braceDepth: 0
        stringQuote: -1
        multiline: false
        comment: false

        fail: () => {
            Error().signal()
        }

        peek: () => {
            value: -1
            (index < length).ifTrue(() => {
                value = source[index]
            })
            value
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            value: source[index]
            index = index + 1
            value
        }

        append: (octet) => {
            buffer.add(octet)
            (octet == 32).ifFalse(() => {
                (octet == 9).ifFalse(() => {
                    significant = true
                })
            })
        }

        appendQuotes: null
        appendQuotes = (quote, remaining) => {
            (remaining > 0).ifTrue(() => {
                append(quote)
                appendQuotes(quote, remaining - 1)
            })
        }

        quoteRun: (quote) => {
            look: index
            count: 0

            scan: null
            scan = () => {
                (look < length).ifTrue(() => {
                    (source[look] == quote).ifTrue(() => {
                        count = count + 1
                        look = look + 1
                        scan()
                    })
                })
            }

            scan()
            count
        }

        finish: () => {
            significant.ifTrue(() => {
                result = Array(...result, Encoding.UTF8.decode(buffer))
            })
            buffer = Encoding.UTF8.encode("")
            significant = false
        }

        appendNewline: (include) => {
            first: take()
            (first == 10).ifTrue(() => {
                include.ifTrue(() => { append(10) })
            })
            (first == 13).ifTrue(() => {
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                second: take()
                include.ifTrue(() => {
                    append(13)
                    append(second)
                })
            })
            (first == 10).ifFalse(() => {
                (first == 13).ifFalse(() => {
                    fail()
                })
            })
        }

        step: () => {
            octet: peek()

            wasComment: comment
            wasComment.ifTrue(() => {
                isNewline: octet == 10
                (octet == 13).ifTrue(() => { isNewline = true })

                isNewline.ifTrue(() => {
                    comment = false
                    nested: squareDepth > 0
                    (braceDepth > 0).ifTrue(() => { nested = true })
                    nested.ifTrue(() => {
                        appendNewline(true)
                    })
                    nested.ifFalse(() => {
                        appendNewline(false)
                        finish()
                    })
                })

                isNewline.ifFalse(() => {
                    index = index + 1
                })
            })

            wasComment.ifFalse(() => {
                wasString: stringQuote >= 0
                wasString.ifTrue(() => {
                    wasMultiline: multiline
                    wasMultiline.ifTrue(() => {
                        // Snapshot this before closing mutates stringQuote.
                        quoteOctet: octet == stringQuote
                        quoteOctet.ifTrue(() => {
                            run: quoteRun(stringQuote)
                            (run >= 3).ifTrue(() => {
                                (run > 5).ifTrue(() => {
                                    fail()
                                })
                                appendQuotes(stringQuote, run)
                                index = index + run
                                stringQuote = -1
                                multiline = false
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                            })
                        })

                        quoteOctet.ifFalse(() => {
                            escapedBasic: stringQuote == 34
                            (octet == 92).ifFalse(() => {
                                escapedBasic = false
                            })

                            escapedBasic.ifTrue(() => {
                                append(take())
                                (index >= length).ifTrue(() => {
                                    fail()
                                })
                                append(take())
                            })

                            escapedBasic.ifFalse(() => {
                                append(take())
                            })
                        })
                    })

                    wasMultiline.ifFalse(() => {
                        isNewline: octet == 10
                        (octet == 13).ifTrue(() => { isNewline = true })
                        isNewline.ifTrue(() => {
                            fail()
                        })

                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        escapedBasic.ifTrue(() => {
                            append(take())
                            (index >= length).ifTrue(() => {
                                fail()
                            })
                            append(take())
                        })

                        escapedBasic.ifFalse(() => {
                            append(take())
                            (octet == stringQuote).ifTrue(() => {
                                stringQuote = -1
                            })
                        })
                    })
                })

                wasString.ifFalse(() => {
                    (octet == 35).ifTrue(() => {
                        comment = true
                        index = index + 1
                    })

                    (octet == 35).ifFalse(() => {
                        isQuote: octet == 34
                        (octet == 39).ifTrue(() => { isQuote = true })

                        isQuote.ifTrue(() => {
                            run: quoteRun(octet)
                            (run >= 3).ifTrue(() => {
                                appendQuotes(octet, 3)
                                index = index + 3
                                stringQuote = octet
                                multiline = true
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                                stringQuote = octet
                                multiline = false
                            })
                        })

                        isQuote.ifFalse(() => {
                            (octet == 91).ifTrue(() => {
                                squareDepth = squareDepth + 1
                                append(take())
                            })
                            (octet == 93).ifTrue(() => {
                                (squareDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                squareDepth = squareDepth - 1
                                append(take())
                            })
                            (octet == 123).ifTrue(() => {
                                braceDepth = braceDepth + 1
                                append(take())
                            })
                            (octet == 125).ifTrue(() => {
                                (braceDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                braceDepth = braceDepth - 1
                                append(take())
                            })

                            structural: octet == 91
                            (octet == 93).ifTrue(() => { structural = true })
                            (octet == 123).ifTrue(() => { structural = true })
                            (octet == 125).ifTrue(() => { structural = true })

                            structural.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => { isNewline = true })

                                isNewline.ifTrue(() => {
                                    nested: squareDepth > 0
                                    (braceDepth > 0).ifTrue(() => { nested = true })
                                    nested.ifTrue(() => {
                                        appendNewline(true)
                                    })
                                    nested.ifFalse(() => {
                                        appendNewline(false)
                                        finish()
                                    })
                                })

                                isNewline.ifFalse(() => {
                                    append(take())
                                })
                            })
                        })
                    })
                })
            })

        }

        visitIndex: 0
        source.each((ignoredOctet) => {
            (visitIndex == index).ifTrue(() => {
                step()
            })
            visitIndex = visitIndex + 1
        })

        (index == length).ifFalse(() => {
            fail()
        })

        (stringQuote >= 0).ifTrue(() => {
            fail()
        })
        (squareDepth != 0).ifTrue(() => {
            fail()
        })
        (braceDepth != 0).ifTrue(() => {
            fail()
        })

        finish()
        result
    }

    documentTable: (text) => {
        items: documentStatements(text)

        fail: () => {
            Error().signal()
        }

        node: (kind, value) => {
            result: {
                kind: kind
                value: value
            }
            result
        }

        root: node("table", Map())
        states: IdentityMap()
        states[root] = "root"
        current: root

        isSpace: (octet) => {
            result: octet == 32
            (octet == 9).ifTrue(() => {
                result = true
            })
            result
        }

        decodeRange: (source, start, end) => {
            buffer: Encoding.UTF8.encode("")
            position: start
            (() => position < end).while(() => {
                buffer.add(source[position])
                position = position + 1
            })
            Encoding.UTF8.decode(buffer)
        }

        trimBounds: (source) => {
            left: 0
            right: source.size()

            trimLeft: null
            trimLeft = () => {
                (left < right).ifTrue(() => {
                    isSpace(source[left]).ifTrue(() => {
                        left = left + 1
                        trimLeft()
                    })
                })
            }

            trimRight: null
            trimRight = () => {
                (right > left).ifTrue(() => {
                    isSpace(source[right - 1]).ifTrue(() => {
                        right = right - 1
                        trimRight()
                    })
                })
            }

            trimLeft()
            trimRight()
            {
                left: left
                right: right
            }
        }

        markInlineTable: (valueNode) => {
            (valueNode.kind == "table").ifTrue(() => {
                states[valueNode] = "inline"
            })
        }

        putDotted: null
        putDotted = (tableNode, parts, position, valueNode) => {
            name: parts[position]
            last: position == parts.size() - 1
            entries: tableNode.value

            last.ifTrue(() => {
                entries.containsKey(name).ifTrue(() => {
                    fail()
                })
                entries[name] = valueNode
                markInlineTable(valueNode)
            })

            last.ifFalse(() => {
                child: null
                entries.containsKey(name).ifTrue(() => {
                    child = entries[name]
                    (child.kind == "table").ifFalse(() => {
                        fail()
                    })
                    states.containsKey(child).ifFalse(() => {
                        fail()
                    })
                    state: states[child]
                    (state == "header").ifTrue(() => {
                        fail()
                    })
                    (state == "inline").ifTrue(() => {
                        fail()
                    })
                    (state == "implicit").ifTrue(() => {
                        states[child] = "dotted"
                    })
                })

                entries.containsKey(name).ifFalse(() => {
                    child = node("table", Map())
                    entries[name] = child
                    states[child] = "dotted"
                })

                putDotted(child, parts, position + 1, valueNode)
            })
        }

        latestArrayTable: (arrayNode) => {
            (arrayNode.kind == "array").ifFalse(() => {
                fail()
            })
            states.containsKey(arrayNode).ifFalse(() => {
                fail()
            })
            (states[arrayNode] == "array-table").ifFalse(() => {
                fail()
            })
            elements: arrayNode.value
            (elements.size() == 0).ifTrue(() => {
                fail()
            })
            selected: elements[elements.size() - 1]
            (selected.kind == "table").ifFalse(() => {
                fail()
            })
            selected
        }

        existingParent: (child) => {
            selected: null

            (child.kind == "table").ifTrue(() => {
                states.containsKey(child).ifFalse(() => {
                    fail()
                })
                (states[child] == "inline").ifTrue(() => {
                    fail()
                })
                selected = child
            })

            (child.kind == "array").ifTrue(() => {
                selected = latestArrayTable(child)
            })

            (selected === null).ifTrue(() => {
                fail()
            })
            selected
        }

        selectHeader: (parts) => {
            selected: root
            position: 0

            walk: null
            walk = () => {
                name: parts[position]
                last: position == parts.size() - 1
                entries: selected.value
                child: null

                entries.containsKey(name).ifTrue(() => {
                    child = entries[name]

                    last.ifTrue(() => {
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        state: states[child]
                        (state == "implicit").ifTrue(() => {
                            states[child] = "header"
                        })
                        (state == "implicit").ifFalse(() => {
                            fail()
                        })
                        selected = child
                    })

                    last.ifFalse(() => {
                        selected = existingParent(child)
                    })
                })

                entries.containsKey(name).ifFalse(() => {
                    child = node("table", Map())
                    entries[name] = child
                    last.ifTrue(() => {
                        states[child] = "header"
                    })
                    last.ifFalse(() => {
                        states[child] = "implicit"
                    })
                    selected = child
                })

                last.ifFalse(() => {
                    position = position + 1
                    walk()
                })
            }

            walk()
            selected
        }

        selectArrayHeader: (parts) => {
            selected: root
            position: 0
            created: null

            walk: null
            walk = () => {
                name: parts[position]
                last: position == parts.size() - 1
                entries: selected.value
                child: null

                last.ifTrue(() => {
                    element: node("table", Map())
                    states[element] = "array-element"

                    entries.containsKey(name).ifTrue(() => {
                        child = entries[name]
                        (child.kind == "array").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        (states[child] == "array-table").ifFalse(() => {
                            fail()
                        })
                        child.value = Array(...child.value, element)
                    })

                    entries.containsKey(name).ifFalse(() => {
                        child = node("array", Array(element))
                        entries[name] = child
                        states[child] = "array-table"
                    })

                    created = element
                })

                last.ifFalse(() => {
                    entries.containsKey(name).ifTrue(() => {
                        child = entries[name]
                        selected = existingParent(child)
                    })

                    entries.containsKey(name).ifFalse(() => {
                        child = node("table", Map())
                        entries[name] = child
                        states[child] = "implicit"
                        selected = child
                    })

                    position = position + 1
                    walk()
                })
            }

            walk()
            created
        }

        parseHeader: (statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            (bounds.left >= bounds.right).ifTrue(() => {
                fail()
            })
            (source[bounds.left] == 91).ifFalse(() => {
                fail()
            })
            (source[bounds.right - 1] == 93).ifFalse(() => {
                fail()
            })

            arrayHeader: false
            keyStart: bounds.left + 1
            keyEnd: bounds.right - 1

            (keyStart < keyEnd).ifTrue(() => {
                (source[keyStart] == 91).ifTrue(() => {
                    arrayHeader = true
                    (keyStart + 1 >= keyEnd).ifTrue(() => {
                        fail()
                    })
                    (source[keyEnd - 1] == 93).ifFalse(() => {
                        fail()
                    })
                    keyStart = keyStart + 1
                    keyEnd = keyEnd - 1
                })
            })

            keyText: decodeRange(source, keyStart, keyEnd)
            {
                array: arrayHeader
                path: syntaxKeyPath(keyText)
            }
        }

        parseAssignment: (statement) => {
            source: Encoding.UTF8.encode(statement)
            length: source.size()
            position: 0
            quote: -1
            separator: -1

            scan: null
            scan = () => {
                (position < length).ifTrue(() => {
                    (separator < 0).ifTrue(() => {
                        octet: source[position]
                        inQuote: quote >= 0

                        inQuote.ifTrue(() => {
                            escaped: quote == 34
                            (octet == 92).ifFalse(() => {
                                escaped = false
                            })

                            escaped.ifTrue(() => {
                                position = position + 1
                                (position >= length).ifTrue(() => {
                                    fail()
                                })
                                position = position + 1
                            })

                            escaped.ifFalse(() => {
                                (octet == quote).ifTrue(() => {
                                    quote = -1
                                })
                                position = position + 1
                            })
                        })

                        inQuote.ifFalse(() => {
                            isQuote: octet == 34
                            (octet == 39).ifTrue(() => {
                                isQuote = true
                            })

                            isQuote.ifTrue(() => {
                                quote = octet
                                position = position + 1
                            })

                            isQuote.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => {
                                    isNewline = true
                                })
                                isNewline.ifTrue(() => {
                                    fail()
                                })

                                (octet == 61).ifTrue(() => {
                                    separator = position
                                })
                                position = position + 1
                            })
                        })

                        scan()
                    })
                })
            }

            scan()
            (quote >= 0).ifTrue(() => {
                fail()
            })
            (separator < 0).ifTrue(() => {
                fail()
            })

            keyText: decodeRange(source, 0, separator)
            valueText: decodeRange(source, separator + 1, length)
            {
                path: syntaxKeyPath(keyText)
                value: syntaxValue(valueText)
            }
        }

        items.each((statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            (bounds.left >= bounds.right).ifTrue(() => {
                fail()
            })

            header: source[bounds.left] == 91
            header.ifTrue(() => {
                parsedHeader: parseHeader(statement)
                parsedHeader.array.ifTrue(() => {
                    current = selectArrayHeader(parsedHeader.path)
                })
                parsedHeader.array.ifFalse(() => {
                    current = selectHeader(parsedHeader.path)
                })
            })

            header.ifFalse(() => {
                assignment: parseAssignment(statement)
                putDotted(current, assignment.path, 0, assignment.value)
            })
        })
        root
    }

    documentTable(text)
}
