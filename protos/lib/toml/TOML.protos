string: (value) => {
    ignoredValidation: "" + value

    {
        kind: "string"
        value: value
    }
}

integer: (value) => {
    ignoredValidation: 0 + value

    {
        kind: "integer"
        value: value
    }
}

float: (value) => {
    ignoredValidation: 0.0 + value

    {
        kind: "float"
        value: value
    }
}

boolean: (value) => {
    valid: value === true
    (value === false).ifTrue(() => {
        valid = true
    })
    valid.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "boolean"
        value: value
    }
}

localDate: (year, month, day) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })

    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    date: {
        year: year
        month: month
        day: day
    }

    {
        kind: "localDate"
        value: date
    }
}

localTime: (hour, minute, second, fractionCoefficient, fractionDigits) => {
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).while(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    time: {
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localTime"
        value: time
    }
}

localDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })
    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).while(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localDateTime"
        value: dateTime
    }
}

offsetDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits,
    offsetMinutes
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits
    ignoredOffsetValidation: 0 + offsetMinutes

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })
    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).while(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    ((offsetMinutes < -1439) || (offsetMinutes > 1439)).ifTrue(() => {
        Error().signal()
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
        offsetMinutes: offsetMinutes
    }

    {
        kind: "offsetDateTime"
        value: dateTime
    }
}

array: (...nodes) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        (kind === "integer").ifTrue(() => { valid = true })
        (kind === "float").ifTrue(() => { valid = true })
        (kind === "boolean").ifTrue(() => { valid = true })
        (kind === "offsetDateTime").ifTrue(() => { valid = true })
        (kind === "localDateTime").ifTrue(() => { valid = true })
        (kind === "localDate").ifTrue(() => { valid = true })
        (kind === "localTime").ifTrue(() => { valid = true })
        (kind === "array").ifTrue(() => { valid = true })
        (kind === "table").ifTrue(() => { valid = true })
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    nodes.each((node) => {
        validateNode(node)
    })

    {
        kind: "array"
        value: nodes
    }
}

table: (...nameNodePairs) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        (kind === "integer").ifTrue(() => { valid = true })
        (kind === "float").ifTrue(() => { valid = true })
        (kind === "boolean").ifTrue(() => { valid = true })
        (kind === "offsetDateTime").ifTrue(() => { valid = true })
        (kind === "localDateTime").ifTrue(() => { valid = true })
        (kind === "localDate").ifTrue(() => { valid = true })
        (kind === "localTime").ifTrue(() => { valid = true })
        (kind === "array").ifTrue(() => { valid = true })
        (kind === "table").ifTrue(() => { valid = true })
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    result: Map()
    pendingName: null
    expectingName: true

    nameNodePairs.each((entry) => {
        wasExpectingName: expectingName

        wasExpectingName.ifTrue(() => {
            ignoredNameValidation: "" + entry
            pendingName = entry
            expectingName = false
        })

        wasExpectingName.ifFalse(() => {
            validateNode(entry)
            result.containsKey(pendingName).ifTrue(() => {
                Error().signal()
            })
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    })

    expectingName.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "table"
        value: result
    }
}

parse: (text) => {
    ignoredStringValidation: "" + text

    publicLocalDate: localDate
    publicLocalTime: localTime
    publicLocalDateTime: localDateTime
    publicOffsetDateTime: offsetDateTime

    syntaxNode: (kind, value) => {
        result: {
            kind: kind
            value: value
        }
        result
    }

    syntaxKeyPath: (text) => {
        ignoredStringValidation: text + ""
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        fail: () => {
            Error().signal()
        }

        peek: () => {
            result: -1
            (index < length).ifTrue(() => {
                result = source[index]
            })
            result
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            result: source[index]
            index = index + 1
            result
        }

        skipSpaces: null
        skipSpaces = () => {
            (index < length).ifTrue(() => {
                octet: source[index]
                whitespace: octet == 32
                (octet == 9).ifTrue(() => {
                    whitespace = true
                })
                whitespace.ifTrue(() => {
                    index = index + 1
                    skipSpaces()
                })
            })
        }

        hexDigit: (octet) => {
            result: -1
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => {
                    result = octet - 48
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 65).ifTrue(() => {
                    (octet <= 70).ifTrue(() => {
                        result = octet - 55
                    })
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 97).ifTrue(() => {
                    (octet <= 102).ifTrue(() => {
                        result = octet - 87
                    })
                })
            })
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            (scalar > 1114111).ifTrue(() => {
                invalid = true
            })
            (scalar >= 55296).ifTrue(() => {
                (scalar <= 57343).ifTrue(() => {
                    invalid = true
                })
            })
            invalid.ifTrue(() => {
                fail()
            })

            handled: false
            (scalar <= 127).ifTrue(() => {
                buffer.add(scalar)
                handled = true
            })
            handled.ifFalse(() => {
                (scalar <= 2047).ifTrue(() => {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                (scalar <= 65535).ifTrue(() => {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                (remaining > 0).ifTrue(() => {
                    digit: hexDigit(take())
                    (digit < 0).ifTrue(() => {
                        fail()
                    })
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                })
            }

            consume()
            appendScalarUtf8(buffer, scalar)
        }

        parseBasicKey: () => {
            (take() == 34).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            scan: null
            scan = () => {
                done.ifFalse(() => {
                    octet: take()
                    (octet == 34).ifTrue(() => {
                        done = true
                    })

                    done.ifFalse(() => {
                        (octet == 92).ifTrue(() => {
                            escape: take()
                            handled: false
                            (escape == 98).ifTrue(() => {
                                buffer.add(8)
                                handled = true
                            })
                            (escape == 116).ifTrue(() => {
                                buffer.add(9)
                                handled = true
                            })
                            (escape == 110).ifTrue(() => {
                                buffer.add(10)
                                handled = true
                            })
                            (escape == 102).ifTrue(() => {
                                buffer.add(12)
                                handled = true
                            })
                            (escape == 114).ifTrue(() => {
                                buffer.add(13)
                                handled = true
                            })
                            (escape == 101).ifTrue(() => {
                                buffer.add(27)
                                handled = true
                            })
                            (escape == 120).ifTrue(() => {
                                parseUnicodeEscape(2, buffer)
                                handled = true
                            })
                            (escape == 34).ifTrue(() => {
                                buffer.add(34)
                                handled = true
                            })
                            (escape == 92).ifTrue(() => {
                                buffer.add(92)
                                handled = true
                            })
                            (escape == 117).ifTrue(() => {
                                parseUnicodeEscape(4, buffer)
                                handled = true
                            })
                            (escape == 85).ifTrue(() => {
                                parseUnicodeEscape(8, buffer)
                                handled = true
                            })
                            handled.ifFalse(() => {
                                fail()
                            })
                        })

                        (octet == 92).ifFalse(() => {
                            invalidControl: octet < 32
                            (octet == 127).ifTrue(() => {
                                invalidControl = true
                            })
                            (octet == 9).ifTrue(() => {
                                invalidControl = false
                            })
                            invalidControl.ifTrue(() => {
                                fail()
                            })
                            buffer.add(octet)
                        })
                        scan()
                    })
                })
            }

            scan()
            Encoding.UTF8.decode(buffer)
        }

        parseLiteralKey: () => {
            (take() == 39).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            scan: null
            scan = () => {
                done.ifFalse(() => {
                    octet: take()
                    (octet == 39).ifTrue(() => {
                        done = true
                    })
                    done.ifFalse(() => {
                        invalidControl: octet < 32
                        (octet == 127).ifTrue(() => {
                            invalidControl = true
                        })
                        (octet == 9).ifTrue(() => {
                            invalidControl = false
                        })
                        invalidControl.ifTrue(() => {
                            fail()
                        })
                        buffer.add(octet)
                        scan()
                    })
                })
            }

            scan()
            Encoding.UTF8.decode(buffer)
        }

        isBareKeyOctet: (octet) => {
            result: false
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => { result = true })
            })
            (octet >= 65).ifTrue(() => {
                (octet <= 90).ifTrue(() => { result = true })
            })
            (octet >= 97).ifTrue(() => {
                (octet <= 122).ifTrue(() => { result = true })
            })
            (octet == 95).ifTrue(() => { result = true })
            (octet == 45).ifTrue(() => { result = true })
            result
        }

        parseBareKey: () => {
            buffer: Encoding.UTF8.encode("")

            scan: null
            scan = () => {
                (index < length).ifTrue(() => {
                    octet: source[index]
                    isBareKeyOctet(octet).ifTrue(() => {
                        buffer.add(octet)
                        index = index + 1
                        scan()
                    })
                })
            }

            scan()
            (buffer.size() == 0).ifTrue(() => {
                fail()
            })
            Encoding.UTF8.decode(buffer)
        }

        parsePart: () => {
            skipSpaces()
            first: peek()
            result: null

            (first == 34).ifTrue(() => {
                result = parseBasicKey()
            })
            (first == 39).ifTrue(() => {
                result = parseLiteralKey()
            })
            (first == 34).ifFalse(() => {
                (first == 39).ifFalse(() => {
                    result = parseBareKey()
                })
            })

            result
        }

        parts: Array(parsePart())
        more: true

        continuePath: null
        continuePath = () => {
            more.ifTrue(() => {
                skipSpaces()
                (index < length).ifTrue(() => {
                    (source[index] == 46).ifFalse(() => {
                        fail()
                    })
                    index = index + 1
                    parts = Array(...parts, parsePart())
                    continuePath()
                })
                (index >= length).ifTrue(() => {
                    more = false
                })
            })
        }

        continuePath()
        skipSpaces()
        (index == length).ifFalse(() => {
            fail()
        })
        parts
    }

    syntaxValue: (text) => {
        ignoredStringValidation: text + ""
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        fail: () => {
            Error().signal()
        }

        peek: () => {
            result: -1
            (index < length).ifTrue(() => {
                result = source[index]
            })
            result
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            result: source[index]
            index = index + 1
            result
        }

        isSpace: (octet) => {
            result: octet == 32
            (octet == 9).ifTrue(() => {
                result = true
            })
            result
        }

        isNewlineStart: (octet) => {
            result: octet == 10
            (octet == 13).ifTrue(() => {
                result = true
            })
            result
        }

        consumeNewline: () => {
            octet: take()
            valid: octet == 10
            (octet == 13).ifTrue(() => {
                valid = true
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                take()
            })
            valid.ifFalse(() => {
                fail()
            })
        }

        skipSpaces: null
        skipSpaces = () => {
            (index < length).ifTrue(() => {
                isSpace(source[index]).ifTrue(() => {
                    index = index + 1
                    skipSpaces()
                })
            })
        }

        skipComment: null
        skipComment = () => {
            (index < length).ifTrue(() => {
                octet: source[index]
                isNewlineStart(octet).ifFalse(() => {
                    invalidControl: octet < 32
                    (octet == 127).ifTrue(() => {
                        invalidControl = true
                    })
                    (octet == 9).ifTrue(() => {
                        invalidControl = false
                    })
                    invalidControl.ifTrue(() => {
                        fail()
                    })
                    index = index + 1
                    skipComment()
                })
            })
        }

        skipArrayTrivia: null
        skipArrayTrivia = () => {
            progressed: false
            (index < length).ifTrue(() => {
                octet: source[index]
                isSpace(octet).ifTrue(() => {
                    index = index + 1
                    progressed = true
                })
                isNewlineStart(octet).ifTrue(() => {
                    consumeNewline()
                    progressed = true
                })
                (octet == 35).ifTrue(() => {
                    index = index + 1
                    skipComment()
                    progressed = true
                })
            })
            progressed.ifTrue(() => {
                skipArrayTrivia()
            })
        }

        hexDigit: (octet) => {
            result: -1
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => {
                    result = octet - 48
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 65).ifTrue(() => {
                    (octet <= 70).ifTrue(() => {
                        result = octet - 55
                    })
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 97).ifTrue(() => {
                    (octet <= 102).ifTrue(() => {
                        result = octet - 87
                    })
                })
            })
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            (scalar > 1114111).ifTrue(() => {
                invalid = true
            })
            (scalar >= 55296).ifTrue(() => {
                (scalar <= 57343).ifTrue(() => {
                    invalid = true
                })
            })
            invalid.ifTrue(() => {
                fail()
            })

            handled: false
            (scalar <= 127).ifTrue(() => {
                buffer.add(scalar)
                handled = true
            })
            handled.ifFalse(() => {
                (scalar <= 2047).ifTrue(() => {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                (scalar <= 65535).ifTrue(() => {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                (remaining > 0).ifTrue(() => {
                    digit: hexDigit(take())
                    (digit < 0).ifTrue(() => {
                        fail()
                    })
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                })
            }

