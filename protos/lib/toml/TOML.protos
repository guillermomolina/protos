                            if(underscore) {
                                nextValid: false
                                if(position + 1 < tokenLength) {
                                    if(decimalDigit(token[position + 1]) >= 0) {
                                        nextValid = true
                                    }
                                }
                                (previousDigit && nextValid).ifFalse(() => {
                                    valid = false
                                })
                                previousDigit = false
                                position = position + 1
                            }
                            underscore.ifFalse(() => {
                                scanningInteger = false
                            })
                        }
                    }
                }
                if(integerDigits == 0) {
                    valid = false
                }
                previousDigit.ifFalse(() => {
                    valid = false
                })

                hasFraction: false
                if(valid) {
                    if(position < tokenLength) {
                        if(token[position] == 46) {
                            hasFraction = true
                            position = position + 1
                            previousDigit = false

                            scanningFraction: true
                            while(scanningFraction && (position < tokenLength)) {
                                octet: token[position]
                                digit: decimalDigit(octet)

                                if(digit >= 0) {
                                    coefficient = coefficient * 10 + digit
                                    fractionDigits = fractionDigits + 1
                                    totalDigits = totalDigits + 1
                                    significant.ifFalse(() => {
                                        if(digit == 0) {
                                            leadingZeros = leadingZeros + 1
                                        }
                                        if(digit != 0) {
                                            significant = true
                                        }
                                    })
                                    previousDigit = true
                                    position = position + 1
                                }

                                if(digit < 0) {
                                    underscore: octet == 95
                                    if(underscore) {
                                        nextValid: false
                                        if(position + 1 < tokenLength) {
                                            if(decimalDigit(token[position + 1]) >= 0) {
                                                nextValid = true
                                            }
                                        }
                                        (previousDigit && nextValid).ifFalse(() => {
                                            valid = false
                                        })
                                        previousDigit = false
                                        position = position + 1
                                    }
                                    underscore.ifFalse(() => {
                                        scanningFraction = false
                                    })
                                }
                            }
                            if(fractionDigits == 0) {
                                valid = false
                            }
                            previousDigit.ifFalse(() => {
                                valid = false
                            })
                        }
                    }
                }

                exponentValue: 0
                exponentNegative: false
                exponentDigits: 0
                hasExponent: false

                if(valid) {
                    if(position < tokenLength) {
                        exponentMarker: token[position] == 101
                        if(token[position] == 69) {
                            exponentMarker = true
                        }

                        if(exponentMarker) {
                            hasExponent = true
                            position = position + 1

                            if(position < tokenLength) {
                                if(token[position] == 43) {
                                    position = position + 1
                                }
                                if(position < tokenLength) {
                                    if(token[position] == 45) {
                                        exponentNegative = true
                                        position = position + 1
                                    }
                                }
                            }

                            previousDigit = false
                            scanningExponent: true
                            while(scanningExponent && (position < tokenLength)) {
                                octet: token[position]
                                digit: decimalDigit(octet)

                                if(digit >= 0) {
                                    exponentValue = exponentValue * 10 + digit
                                    exponentDigits = exponentDigits + 1
                                    previousDigit = true
                                    position = position + 1
                                }

                                if(digit < 0) {
                                    underscore: octet == 95
                                    if(underscore) {
                                        nextValid: false
                                        if(position + 1 < tokenLength) {
                                            if(decimalDigit(token[position + 1]) >= 0) {
                                                nextValid = true
                                            }
                                        }
                                        (previousDigit && nextValid).ifFalse(() => {
                                            valid = false
                                        })
                                        previousDigit = false
                                        position = position + 1
                                    }
                                    underscore.ifFalse(() => {
                                        scanningExponent = false
                                    })
                                }
                            }
                            if(exponentDigits == 0) {
                                valid = false
                            }
                            previousDigit.ifFalse(() => {
                                valid = false
                            })
                        }
                    }
                }

                if((hasFraction || hasExponent) === false) {
                    valid = false
                }
                if(position != tokenLength) {
                    valid = false
                }

                if(valid) {
                    decimalExponent: exponentValue
                    if(exponentNegative) {
                        decimalExponent = 0 - exponentValue
                    }
                    decimalExponent = decimalExponent - fractionDigits

                    if(negative) {
                        coefficient = 0 - coefficient
                    }

                    floating: null

                    if(coefficient == 0) {
                        if(negative) {
                            floating = -0.0
                        }
                        negative.ifFalse(() => {
                            floating = 0.0
                        })
                    }

                    if(coefficient != 0) {
                        significantDigits: totalDigits - leadingZeros
                        adjustedExponent: decimalExponent + significantDigits - 1

                        if(adjustedExponent > 400) {
                            if(negative) {
                                floating = -1.0 / 0.0
                            }
                            negative.ifFalse(() => {
                                floating = 1.0 / 0.0
                            })
                        }

                        if(adjustedExponent < -400) {
                            if(negative) {
                                floating = -0.0
                            }
                            negative.ifFalse(() => {
                                floating = 0.0
                            })
                        }

                        if(floating === null) {
                            if(decimalExponent >= 0) {
                                numerator: coefficient * powerOfTen(decimalExponent)
                                floating = Float(numerator)
                            }
                            if(decimalExponent < 0) {
                                denominator: powerOfTen(0 - decimalExponent)
                                floating = Float(coefficient / denominator)
                            }
                        }
                    }

                    result.valid = true
                    result.value = floating
