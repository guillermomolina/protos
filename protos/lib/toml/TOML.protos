//! TOML node trees and whole-document parsing and encoding. Nodes are objects with
//! `kind` and `value` slots.

/// Answers a fresh TOML string node; `value` must be a String.
string: (value) => {
    String.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "string"
        value: value
    }
}

/// Answers a fresh TOML integer node; `value` must be an Integer.
integer: (value) => {
    Integer.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "integer"
        value: value
    }
}

/// Answers a fresh TOML float node; `value` must be a Float.
float: (value) => {
    Float.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "float"
        value: value
    }
}

/// Answers a fresh TOML boolean node; `value` must be canonical `true` or `false`.
boolean: (value) => {
    valid: value === true
    if(value === false) {
        valid = true
    }
    valid.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "boolean"
        value: value
    }
}

/// Answers a fresh TOML local-date node. Validates the year (1..9999), month, and day
/// against the proleptic Gregorian calendar.
localDate: (year, month, day) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }

    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    date: {
        year: year
        month: month
        day: day
    }

    {
        kind: "localDate"
        value: date
    }
}

/// Answers a fresh TOML local-time node. Validates hour (0..23), minute (0..59), and
/// second (0..60); the fraction is `fractionCoefficient` over `fractionDigits` decimal
/// digits.
localTime: (hour, minute, second, fractionCoefficient, fractionDigits) => {
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    time: {
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localTime"
        value: time
    }
}

/// Answers a fresh TOML local-date-time node.
/// Validates the year (1..9999), month, and day against the proleptic Gregorian
/// calendar.
/// Validates hour (0..23), minute (0..59), and second (0..60); the fraction is
/// `fractionCoefficient` over `fractionDigits` decimal digits.
localDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }
    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localDateTime"
        value: dateTime
    }
}

/// Answers a fresh TOML offset-date-time node.
/// Validates the year (1..9999), month, and day against the proleptic Gregorian
/// calendar.
/// Validates hour (0..23), minute (0..59), and second (0..60); the fraction is
/// `fractionCoefficient` over `fractionDigits` decimal digits.
/// `offsetMinutes` must lie in -1439..1439.
offsetDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits,
    offsetMinutes
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits
    ignoredOffsetValidation: 0 + offsetMinutes

    if((year < 1) || (year > 9999)) {
        Error().signal()
    }
    if((month < 1) || (month > 12)) {
        Error().signal()
    }

    maxDay: 31
    if((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
        maxDay = 30
    }
    if(month == 2) {
        leap: false
        if(year.mod(4) == 0) {
            leap = true
        }
        if(year.mod(100) == 0) {
            leap = false
        }
        if(year.mod(400) == 0) {
            leap = true
        }
        maxDay = 28
        if(leap) {
            maxDay = 29
        }
    }
    if((day < 1) || (day > maxDay)) {
        Error().signal()
    }

    if((hour < 0) || (hour > 23)) {
        Error().signal()
    }
    if((minute < 0) || (minute > 59)) {
        Error().signal()
    }
    if((second < 0) || (second > 60)) {
        Error().signal()
    }
    if(fractionCoefficient < 0) {
        Error().signal()
    }
    if(fractionDigits < 0) {
        Error().signal()
    }

    if(fractionDigits == 0) {
        if(fractionCoefficient != 0) {
            Error().signal()
        }
    }
    if(fractionDigits > 0) {
        limit: 1
        index: 0
        while(index < fractionDigits) {
            limit = limit * 10
            index = index + 1
        }
        if(fractionCoefficient >= limit) {
            Error().signal()
        }
    }

    if((offsetMinutes < -1439) || (offsetMinutes > 1439)) {
        Error().signal()
    }

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
        offsetMinutes: offsetMinutes
    }

    {
        kind: "offsetDateTime"
        value: dateTime
    }
}

/// Answers a fresh TOML array node whose elements are `nodes`, in order.
/// Each element must be a TOML node: this constructor checks only each element's
/// immediate envelope, namely that its `kind` names one of the ten TOML semantic
/// kinds and that it carries a `value`; otherwise it signals an Error.
/// Success does not establish that an arbitrarily constructed tree is recursively
/// valid TOML; `TOML.encode` rejects any tree that cannot be validly encoded.
array: (...nodes) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        if(kind === "integer") { valid = true }
        if(kind === "float") { valid = true }
        if(kind === "boolean") { valid = true }
        if(kind === "offsetDateTime") { valid = true }
        if(kind === "localDateTime") { valid = true }
        if(kind === "localDate") { valid = true }
        if(kind === "localTime") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "table") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    nodes.each((node) => {
        validateNode(node)
    })

    {
        kind: "array"
        value: nodes
    }
}

/// Answers a fresh TOML table node from alternating `name, node` arguments, in
/// order. Each name must be a String, names must not repeat, and every name must
/// be followed by its node; otherwise it signals an Error.
/// Each node is checked only for its immediate envelope, namely that its `kind`
/// names one of the ten TOML semantic kinds and that it carries a `value`.
/// Success does not establish that arbitrarily constructed descendants are
/// recursively valid TOML; `TOML.encode` retains full encodability validation.
table: (...nameNodePairs) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        if(kind === "integer") { valid = true }
        if(kind === "float") { valid = true }
        if(kind === "boolean") { valid = true }
        if(kind === "offsetDateTime") { valid = true }
        if(kind === "localDateTime") { valid = true }
        if(kind === "localDate") { valid = true }
        if(kind === "localTime") { valid = true }
        if(kind === "array") { valid = true }
        if(kind === "table") { valid = true }
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    result: Map()
    pendingName: null
    expectingName: true

    nameNodePairs.each((entry) => {
        wasExpectingName: expectingName

        if(wasExpectingName) {
            String.recognizes(entry).ifFalse(() => {
                Error().signal()
            })
            pendingName = entry
            expectingName = false
        }

        wasExpectingName.ifFalse(() => {
            validateNode(entry)
            if(result.containsKey(pendingName)) {
                Error().signal()
            }
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    })

    expectingName.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "table"
        value: result
    }
}

/// Encodes the table node `rootTable` as TOML document text; a root that is not
/// a table node or a tree that cannot be encoded signals an Error.
encode: (rootTable) => {
    output: Encoding.UTF8.encode("")

    emitText: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        Encoding.UTF8.encode(text).each((octet) => {
            output.add(octet)
        })
    }

    emitHexNibble: (digit) => {
        if(digit < 10) {
            output.add(48 + digit)
        }
        if(digit >= 10) {
            output.add(55 + digit)
        }
    }

    emitBasicString: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })

        output.add(34)
        Encoding.UTF8.encode(text).each((octet) => {
            handled: false

            if(octet == 34) {
                output.add(92)
                output.add(34)
                handled = true
            }
            if(octet == 92) {
                output.add(92)
                output.add(92)
                handled = true
            }

            handled.ifFalse(() => {
                control: octet < 32
                if(octet == 127) {
                    control = true
                }
                if(control) {
                    output.add(92)
                    output.add(117)
                    output.add(48)
                    output.add(48)
                    emitHexNibble(octet.div(16))
                    emitHexNibble(octet.mod(16))
                    handled = true
                }
            })

            handled.ifFalse(() => {
                output.add(octet)
            })
        })
        output.add(34)
    }

    integerText: (value) => {
        Integer.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        negative: value < 0
        magnitude: value
        if(negative) {
            magnitude = 0 - value
        }

        reversed: Encoding.UTF8.encode("")
        if(magnitude == 0) {
            reversed.add(48)
        }
        while(magnitude > 0) {
            reversed.add(48 + magnitude.mod(10))
            magnitude = magnitude.div(10)
        }

        result: Encoding.UTF8.encode("")
        if(negative) {
            result.add(45)
        }

        index: reversed.size() - 1
        while(index >= 0) {
            result.add(reversed[index])
            index = index - 1
        }

        Encoding.UTF8.decode(result)
    }

    repeatZero: (count) => {
        result: ""
        remaining: count
        while(remaining > 0) {
            result = result + "0"
            remaining = remaining - 1
        }
        result
    }

    powerInteger: (base, exponent) => {
        if(exponent < 0) {
            fail()
        }

        result: 1
        factor: base
        remaining: exponent

        while(remaining > 0) {
            if(remaining.mod(2) == 1) {
                result = result * factor
            }
            remaining = remaining.div(2)
            if(remaining > 0) {
                factor = factor * factor
            }
        }

        result
    }

    absoluteInteger: (value) => {
        result: value
        if(result < 0) {
            result = 0 - result
        }
        result
    }

    decimalToken: (coefficient, decimalExponent) => {
        digits: integerText(coefficient)
        digitCount: digits.size()

        fixed: ""
        if(decimalExponent >= 0) {
            fixed = digits + repeatZero(decimalExponent) + ".0"
        }

        if(decimalExponent < 0) {
            point: digitCount + decimalExponent

            if(point <= 0) {
                fixed = "0." + repeatZero(0 - point) + digits
            }

            if(point > 0) {
                result: ""
                index: 0
                while(index < digitCount) {
                    if(index == point) {
                        result = result + "."
                    }
                    result = result + digits[index]
                    index = index + 1
                }
                fixed = result
            }
        }

        scientificExponent: decimalExponent + digitCount - 1
        scientific: digits[0]

        if(digitCount > 1) {
            scientific = scientific + "."
            index: 1
            while(index < digitCount) {
                scientific = scientific + digits[index]
                index = index + 1
            }
        }

        scientific = scientific + "e" + integerText(scientificExponent)

        result: fixed
        if(scientific.size() < fixed.size()) {
            result = scientific
        }
        result
    }

    floatText: (value) => {
        Float.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        positiveInfinity: 1.0 / 0.0
        negativeInfinity: 0.0 - positiveInfinity

        result: null
        handled: false

        (value == value).ifFalse(() => {
            result = "nan"
            handled = true
        })

        handled.ifFalse(() => {
            if(value == positiveInfinity) {
                result = "inf"
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(value == negativeInfinity) {
                result = "-inf"
                handled = true
            }
        })

        handled.ifFalse(() => {
            if(value == 0.0) {
                result = "0.0"
                if((1.0 / value) == negativeInfinity) {
                    result = "-0.0"
                }
                handled = true
            }
        })

        handled.ifFalse(() => {
            negative: value < 0.0
            magnitude: value
            if(negative) {
                magnitude = 0.0 - value
            }

            normalized: magnitude
            binaryExponent: 0

            while(normalized >= 2.0) {
                normalized = normalized / 2.0
                binaryExponent = binaryExponent + 1
            }

            while(normalized < 1.0) {
                normalized = normalized * 2.0
                binaryExponent = binaryExponent - 1
            }

            significand: Integer(normalized * 4503599627370496.0)
            binaryShift: binaryExponent - 52

            numerator: significand
            denominator: 1

            if(binaryShift >= 0) {
                numerator = numerator * powerInteger(2, binaryShift)
            }

            if(binaryShift < 0) {
                denominator = powerInteger(2, 0 - binaryShift)
            }

            decimalExponent: 0

            if(numerator >= denominator) {
                threshold: denominator * 10
                while(numerator >= threshold) {
                    decimalExponent = decimalExponent + 1
                    threshold = threshold * 10
                }
            }

            if(numerator < denominator) {
                decimalExponent = -1
                scaledNumerator: numerator * 10
                while(scaledNumerator < denominator) {
                    decimalExponent = decimalExponent - 1
                    scaledNumerator = scaledNumerator * 10
                }
            }

            coefficient: null
            coefficientExponent: 0
            significantDigits: 1

            while((coefficient === null) && (significantDigits <= 17)) {
                candidateExponent: decimalExponent - significantDigits + 1
                scaledNumerator: numerator
                scaledDenominator: denominator

                if(candidateExponent >= 0) {
                    scaledDenominator =
                        scaledDenominator * powerInteger(10, candidateExponent)
                }

                if(candidateExponent < 0) {
                    scaledNumerator =
                        scaledNumerator * powerInteger(10, 0 - candidateExponent)
                }

                quotient: scaledNumerator.div(scaledDenominator)
                remainder: scaledNumerator.mod(scaledDenominator)
                rounded: quotient
                twiceRemainder: remainder * 2

                if(twiceRemainder > scaledDenominator) {
                    rounded = rounded + 1
                }

                if(twiceRemainder == scaledDenominator) {
                    if(rounded.mod(2) == 1) {
                        rounded = rounded + 1
                    }
                }

                bestCandidate: null
                bestDistance: null

                roundTrips: (candidate) => {
                    candidateFloat: null

                    if(candidateExponent >= 0) {
                        candidateFloat =
                            Float(candidate * powerInteger(10, candidateExponent))
                    }

                    if(candidateExponent < 0) {
                        candidateFloat =
                            Float(candidate / powerInteger(10, 0 - candidateExponent))
                    }

                    candidateFloat == magnitude
                }

                consider: (candidate) => {
                    if(candidate > 0) {
                        if(roundTrips(candidate)) {
                            distance:
                                absoluteInteger(
                                    scaledNumerator - candidate * scaledDenominator
                                )

                            better: bestCandidate === null

                            (bestCandidate === null).ifFalse(() => {
                                if(distance < bestDistance) {
                                    better = true
                                }

                                if(distance == bestDistance) {
                                    candidateEven: candidate.mod(2) == 0
                                    bestOdd: bestCandidate.mod(2) == 1
                                    if(candidateEven && bestOdd) {
                                        better = true
                                    }
                                }
                            })

                            if(better) {
                                bestCandidate = candidate
                                bestDistance = distance
                            }
                        }
                    }
                }

                consider(rounded)
                consider(rounded - 1)
                consider(rounded + 1)

                (bestCandidate === null).ifFalse(() => {
                    coefficient = bestCandidate
                    coefficientExponent = candidateExponent
                })

                significantDigits = significantDigits + 1
            }

            if(coefficient === null) {
                fail()
            }

            while(coefficient.mod(10) == 0) {
                coefficient = coefficient.div(10)
                coefficientExponent = coefficientExponent + 1
            }

            result = decimalToken(coefficient, coefficientExponent)
            if(negative) {
                result = "-" + result
            }
        })

        result
    }

    paddedIntegerText: (value, width) => {
        text: integerText(value)
        result: text
        while(result.size() < width) {
            result = "0" + result
        }
        result
    }

    fractionText: (fraction) => {
        coefficient: fraction.coefficient
        digits: fraction.digits

        Integer.recognizes(coefficient).ifFalse(() => {
            Error().signal()
        })
        Integer.recognizes(digits).ifFalse(() => {
            Error().signal()
        })

        result: ""
        if(digits > 0) {
            raw: Encoding.UTF8.encode(integerText(coefficient))
            buffer: Encoding.UTF8.encode(".")
            padding: digits - raw.size()
            while(padding > 0) {
                buffer.add(48)
                padding = padding - 1
            }
            raw.each((octet) => {
                buffer.add(octet)
            })
            result = Encoding.UTF8.decode(buffer)
        }
        result
    }

    dateText: (value) => {
        ignoredValidation: localDate(value.year, value.month, value.day)
        paddedIntegerText(value.year, 4) +
            "-" +
            paddedIntegerText(value.month, 2) +
            "-" +
            paddedIntegerText(value.day, 2)
    }

    timeText: (value) => {
        ignoredValidation:
            localTime(
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits
            )

        paddedIntegerText(value.hour, 2) +
            ":" +
            paddedIntegerText(value.minute, 2) +
            ":" +
            paddedIntegerText(value.second, 2) +
            fractionText(value.fraction)
    }

    localDateTimeText: (value) => {
        ignoredValidation:
            localDateTime(
                value.year,
                value.month,
                value.day,
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits
            )

        datePart: {
            year: value.year
            month: value.month
            day: value.day
        }

        timePart: {
            hour: value.hour
            minute: value.minute
            second: value.second
            fraction: value.fraction
        }

        dateText(datePart) + "T" + timeText(timePart)
    }

    offsetDateTimeText: (value) => {
        ignoredValidation:
            offsetDateTime(
                value.year,
                value.month,
                value.day,
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits,
                value.offsetMinutes
            )

        datePart: {
            year: value.year
            month: value.month
            day: value.day
        }

        timePart: {
            hour: value.hour
            minute: value.minute
            second: value.second
            fraction: value.fraction
        }

        offsetText: "Z"
        (value.offsetMinutes == 0).ifFalse(() => {
            sign: "+"
            magnitude: value.offsetMinutes
            if(magnitude < 0) {
                sign = "-"
                magnitude = 0 - magnitude
            }

            offsetText =
                sign +
                paddedIntegerText(magnitude.div(60), 2) +
                ":" +
                paddedIntegerText(magnitude.mod(60), 2)
        })

        dateText(datePart) + "T" + timeText(timePart) + offsetText
    }

    active: IdentityMap()
    topFrame: null

    snapshotTableEntries: (tableValue) => {
        entries: Map()
        count: 0

        tableValue.each((name, child) => {
            String.recognizes(name).ifFalse(() => {
                Error().signal()
            })
            entries[count] = {
                name: name
                child: child
            }
            count = count + 1
        })

        {
            entries: entries
            count: count
        }
    }

    pushValue: (node, parentFrame) => {
        kind: node.kind
        value: node.value
        handled: false

        if(kind === "string") {
            ignoredValidation: string(value)
            emitBasicString(value)
            handled = true
        }

        if(kind === "integer") {
            ignoredValidation: integer(value)
            emitText(integerText(value))
            handled = true
        }

        if(kind === "float") {
            ignoredValidation: float(value)
            emitText(floatText(value))
            handled = true
        }

        if(kind === "boolean") {
            ignoredValidation: boolean(value)
            if(value === true) {
                emitText("true")
            }
            if(value === false) {
                emitText("false")
            }
            handled = true
        }

        if(kind === "localDate") {
            emitText(dateText(value))
            handled = true
        }

        if(kind === "localTime") {
            emitText(timeText(value))
            handled = true
        }

        if(kind === "localDateTime") {
            emitText(localDateTimeText(value))
            handled = true
        }

        if(kind === "offsetDateTime") {
            emitText(offsetDateTimeText(value))
            handled = true
        }

        if(kind === "array") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            output.add(91)
            topFrame = {
                frameKind: "array"
                parent: parentFrame
                node: node
                values: value
                count: value.size()
                index: 0
            }
            handled = true
        }

        if(kind === "table") {
            if(active.containsKey(node)) {
                fail()
            }
            active[node] = true

            snapshot: snapshotTableEntries(value)
            output.add(123)
            topFrame = {
                frameKind: "table"
                parent: parentFrame
                node: node
                entries: snapshot.entries
                count: snapshot.count
                index: 0
            }
            handled = true
        }

        handled.ifFalse(() => {
            fail()
        })
    }

    (rootTable.kind === "table").ifFalse(() => {
        fail()
    })

    rootSnapshot: snapshotTableEntries(rootTable.value)
    active[rootTable] = true
    topFrame = {
        frameKind: "root"
        parent: null
        node: rootTable
        entries: rootSnapshot.entries
        count: rootSnapshot.count
        index: 0
    }

    running: true
    while(running) {
        frame: topFrame
        frameKind: frame.frameKind

        if(frameKind == "root") {
            if(frame.index >= frame.count) {
                if(frame.count > 0) {
                    output.add(10)
                }
                active.remove(frame.node)
                running = false
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    output.add(10)
                }

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            }
        }

        if(frameKind == "array") {
            if(frame.index >= frame.count) {
                output.add(93)
                active.remove(frame.node)
                topFrame = frame.parent
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    emitText(", ")
                }

                child: frame.values[frame.index]
                frame.index = frame.index + 1
                pushValue(child, frame)
            }
        }

        if(frameKind == "table") {
            if(frame.index >= frame.count) {
                output.add(125)
                active.remove(frame.node)
                topFrame = frame.parent
            }

            if(frame.index < frame.count) {
                if(frame.index > 0) {
                    emitText(", ")
                }

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            }
        }
    }

    Encoding.UTF8.decode(output)
}


/// Parses one complete TOML document into its root table node using the TOML
/// specification version named by `version`, either `"1.0"` or `"1.1"`; any other
/// `version` or invalid text signals an Error. Both versions share one parser: TOML
/// 1.0 additionally rejects the `\e` and `\xHH` escapes, inline tables that span
/// lines or end with a trailing comma, and times without seconds.
parseDialect: (text, version) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    String.recognizes(version).ifFalse(() => {
        Error().signal()
    })
    toml11: version == "1.1"
    (toml11 || (version == "1.0")).ifFalse(() => {
        Error().signal()
    })

    publicLocalDate: localDate
    publicLocalTime: localTime
    publicLocalDateTime: localDateTime
    publicOffsetDateTime: offsetDateTime

    syntaxNode: (kind, value) => {
        result: {
            kind: kind
            value: value
        }
        result
    }

    syntaxKeyPath: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        peek: () => {
            result: -1
            if(index < length) {
                result = source[index]
            }
            result
        }

        take: () => {
            if(index >= length) {
                fail()
            }
            result: source[index]
            index = index + 1
            result
        }

        skipSpaces: () => {
            scanning: true
            while(scanning && (index < length)) {
                octet: source[index]
                whitespace: octet == 32
                if(octet == 9) {
                    whitespace = true
                }
                if(whitespace) {
                    index = index + 1
                }
                whitespace.ifFalse(() => {
                    scanning = false
                })
            }
        }

        hexDigit: (octet) => {
            result: -1
            if(octet >= 48) {
                if(octet <= 57) {
                    result = octet - 48
                }
            }
            if(result < 0) {
                if(octet >= 65) {
                    if(octet <= 70) {
                        result = octet - 55
                    }
                }
            }
            if(result < 0) {
                if(octet >= 97) {
                    if(octet <= 102) {
                        result = octet - 87
                    }
                }
            }
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            if(scalar > 1114111) {
                invalid = true
            }
            if(scalar >= 55296) {
                if(scalar <= 57343) {
                    invalid = true
                }
            }
            if(invalid) {
                fail()
            }

            handled: false
            if(scalar <= 127) {
                buffer.add(scalar)
                handled = true
            }
            handled.ifFalse(() => {
                if(scalar <= 2047) {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                }
            })
            handled.ifFalse(() => {
                if(scalar <= 65535) {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                }
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                if(remaining > 0) {
                    digit: hexDigit(take())
                    if(digit < 0) {
                        fail()
                    }
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                }
            }

            consume()
            appendScalarUtf8(buffer, scalar)
        }

        parseBasicKey: () => {
            (take() == 34).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            while(done === false) {
                octet: take()
                    if(octet == 34) {
                        done = true
                    }

                    done.ifFalse(() => {
                        if(octet == 92) {
                            escape: take()
                            handled: false
                            if(escape == 98) {
                                buffer.add(8)
                                handled = true
                            }
                            if(escape == 116) {
                                buffer.add(9)
                                handled = true
                            }
                            if(escape == 110) {
                                buffer.add(10)
                                handled = true
                            }
                            if(escape == 102) {
                                buffer.add(12)
                                handled = true
                            }
                            if(escape == 114) {
                                buffer.add(13)
                                handled = true
                            }
                            if(toml11 && (escape == 101)) {
                                buffer.add(27)
                                handled = true
                            }
                            if(toml11 && (escape == 120)) {
                                parseUnicodeEscape(2, buffer)
                                handled = true
                            }
                            if(escape == 34) {
                                buffer.add(34)
                                handled = true
                            }
                            if(escape == 92) {
                                buffer.add(92)
                                handled = true
                            }
                            if(escape == 117) {
                                parseUnicodeEscape(4, buffer)
                                handled = true
                            }
                            if(escape == 85) {
                                parseUnicodeEscape(8, buffer)
                                handled = true
                            }
                            handled.ifFalse(() => {
                                fail()
                            })
                        }

                        (octet == 92).ifFalse(() => {
                            invalidControl: octet < 32
                            if(octet == 127) {
                                invalidControl = true
                            }
                            if(octet == 9) {
                                invalidControl = false
                            }
                            if(invalidControl) {
                                fail()
                            }
                            buffer.add(octet)
                        })
                    })
            }
            Encoding.UTF8.decode(buffer)
        }

        parseLiteralKey: () => {
            (take() == 39).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            while(done === false) {
                octet: take()
                    if(octet == 39) {
                        done = true
                    }
                    done.ifFalse(() => {
                        invalidControl: octet < 32
                        if(octet == 127) {
                            invalidControl = true
                        }
                        if(octet == 9) {
                            invalidControl = false
                        }
                        if(invalidControl) {
                            fail()
                        }
                        buffer.add(octet)
                    })
            }
            Encoding.UTF8.decode(buffer)
        }

        isBareKeyOctet: (octet) => {
            result: false
            if(octet >= 48) {
                if(octet <= 57) { result = true }
            }
            if(octet >= 65) {
                if(octet <= 90) { result = true }
            }
            if(octet >= 97) {
                if(octet <= 122) { result = true }
            }
            if(octet == 95) { result = true }
            if(octet == 45) { result = true }
            result
        }

        parseBareKey: () => {
            buffer: Encoding.UTF8.encode("")
            scanning: true

            while(scanning && (index < length)) {
                octet: source[index]
                validBare: isBareKeyOctet(octet)
                if(validBare) {
                    buffer.add(octet)
                    index = index + 1
                }
                validBare.ifFalse(() => {
                    scanning = false
                })
            }

            if(buffer.size() == 0) {
                fail()
            }
            Encoding.UTF8.decode(buffer)
        }

        parsePart: () => {
            skipSpaces()
            first: peek()
            result: null

            if(first == 34) {
                result = parseBasicKey()
            }
            if(first == 39) {
                result = parseLiteralKey()
            }
            (first == 34).ifFalse(() => {
                (first == 39).ifFalse(() => {
                    result = parseBareKey()
                })
            })

            result
        }

        pathEntries: Map()
        pathCount: 0

        appendPathPart: (part) => {
            pathEntries[pathCount] = part
            pathCount = pathCount + 1
        }

        appendPathPart(parsePart())
        more: true

        while(more) {
            skipSpaces()

            if(index < length) {
                (source[index] == 46).ifFalse(() => {
                    fail()
                })
                index = index + 1
                appendPathPart(parsePart())
            }

            if(index >= length) {
                more = false
            }
        }

        skipSpaces()
        (index == length).ifFalse(() => {
            fail()
        })

        {
            entries: pathEntries
            count: pathCount
        }
    }

    syntaxValue: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        peek: () => {
            result: -1
            if(index < length) {
                result = source[index]
            }
            result
        }

        take: () => {
            if(index >= length) {
                fail()
            }
            result: source[index]
            index = index + 1
            result
        }

        isSpace: (octet) => {
            result: octet == 32
            if(octet == 9) {
                result = true
            }
            result
        }

        isNewlineStart: (octet) => {
            result: octet == 10
            if(octet == 13) {
                result = true
            }
            result
        }

        consumeNewline: () => {
            octet: take()
            valid: octet == 10
            if(octet == 13) {
                valid = true
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                take()
            }
            valid.ifFalse(() => {
                fail()
            })
        }

        skipSpaces: () => {
            scanning: true
            while(scanning && (index < length)) {
                whitespace: isSpace(source[index])
                if(whitespace) {
                    index = index + 1
                }
                whitespace.ifFalse(() => {
                    scanning = false
                })
            }
        }

        skipComment: () => {
            scanning: true
            while(scanning && (index < length)) {
                octet: source[index]
                newline: isNewlineStart(octet)
                if(newline) {
                    scanning = false
                }
                newline.ifFalse(() => {
                    invalidControl: octet < 32
                    if(octet == 127) {
                        invalidControl = true
                    }
                    if(octet == 9) {
                        invalidControl = false
                    }
                    if(invalidControl) {
                        fail()
                    }
                    index = index + 1
                })
            }
        }

        skipArrayTrivia: () => {
            progressed: true
            while(progressed) {
                progressed = false
                if(index < length) {
                    octet: source[index]
                    if(isSpace(octet)) {
                        index = index + 1
                        progressed = true
                    }
                    if(isNewlineStart(octet)) {
                        consumeNewline()
                        progressed = true
                    }
                    if(octet == 35) {
                        index = index + 1
                        skipComment()
                        progressed = true
                    }
                }
            }
        }

        // TOML 1.0 inline tables are single-line, so only spaces and tabs may
        // separate their tokens; TOML 1.1 also admits newlines and comments.
        skipInlineTableTrivia: () => {
            if(toml11) {
                skipArrayTrivia()
            }
            toml11.ifFalse(() => {
                skipSpaces()
            })
        }

        hexDigit: (octet) => {
            result: -1
            if(octet >= 48) {
                if(octet <= 57) {
                    result = octet - 48
                }
            }
            if(result < 0) {
                if(octet >= 65) {
                    if(octet <= 70) {
                        result = octet - 55
                    }
                }
            }
            if(result < 0) {
                if(octet >= 97) {
                    if(octet <= 102) {
                        result = octet - 87
                    }
                }
            }
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            if(scalar > 1114111) {
                invalid = true
            }
            if(scalar >= 55296) {
                if(scalar <= 57343) {
                    invalid = true
                }
            }
            if(invalid) {
                fail()
            }

            handled: false
            if(scalar <= 127) {
                buffer.add(scalar)
                handled = true
            }
            handled.ifFalse(() => {
                if(scalar <= 2047) {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                }
            })
            handled.ifFalse(() => {
                if(scalar <= 65535) {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                }
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                if(remaining > 0) {
                    digit: hexDigit(take())
                    if(digit < 0) {
                        fail()
                    }
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                }
            }

            consume()
            appendScalarUtf8(buffer, scalar)
        }

        parseBasicString: (multiline) => {
            multiline.ifFalse(() => {
                (take() == 34).ifFalse(() => {
                    fail()
                })
            })

            if(multiline) {
                (take() == 34).ifFalse(() => { fail() })
                (take() == 34).ifFalse(() => { fail() })
                (take() == 34).ifFalse(() => { fail() })
                if(isNewlineStart(peek())) {
                    consumeNewline()
                }
            }

            buffer: Encoding.UTF8.encode("")
            done: false

            countQuotes: (initial) => {
                count: initial
                while(peek() == 34) {
                    index = index + 1
                    count = count + 1
                }
                count
            }

            skipContinuationWhitespace: () => {
                scanning: true
                while(scanning && (index < length)) {
                    octet: source[index]
                    whitespace: isSpace(octet)
                    if(isNewlineStart(octet)) {
                        whitespace = true
                    }

                    if(whitespace) {
                        if(isNewlineStart(octet)) {
                            consumeNewline()
                        }
                        isNewlineStart(octet).ifFalse(() => {
                            index = index + 1
                        })
                    }
                    whitespace.ifFalse(() => {
                        scanning = false
                    })
                }
            }

            while(done === false) {
                octet: take()
                ordinaryOctet: true

                    multiline.ifFalse(() => {
                        if(octet == 34) {
                            done = true
                        }
                    })

                    if(multiline) {
                        if(octet == 34) {
                            ordinaryOctet = false
                            quoteCount: countQuotes(1)

                            if(quoteCount >= 3) {
                                if(quoteCount > 5) {
                                    fail()
                                }
                                extra: quoteCount - 3
                                if(extra > 0) {
                                    buffer.add(34)
                                }
                                if(extra > 1) {
                                    buffer.add(34)
                                }
                                done = true
                            }

                            if(quoteCount < 3) {
                                buffer.add(34)
                                if(quoteCount == 2) {
                                    buffer.add(34)
                                }
                            }
                        }
                    }

                    done.ifFalse(() => {
                        if(ordinaryOctet) {
                            if(octet == 92) {
                                continuation: false

                                if(multiline) {
                                    look: index
                                    seeking: true
                                    sawNewline: false

                                    while(seeking && (look < length)) {
                                        candidate: source[look]
                                        candidateSpace: isSpace(candidate)
                                        candidateNewline: isNewlineStart(candidate)

                                        if(candidateSpace) {
                                            look = look + 1
                                        }
                                        if(candidateNewline) {
                                            sawNewline = true
                                            seeking = false
                                        }
                                        (candidateSpace || candidateNewline).ifFalse(() => {
                                            seeking = false
                                        })
                                    }
                                    if(look >= length) {
                                        seeking = false
                                    }
                                    if(sawNewline) {
                                        continuation = true
                                    }
                                }

                                if(continuation) {
                                    while(isSpace(peek())) {
                                        index = index + 1
                                    }
                                    isNewlineStart(peek()).ifFalse(() => {
                                        fail()
                                    })
                                    consumeNewline()
                                    skipContinuationWhitespace()
                                }

                                continuation.ifFalse(() => {
                                    escape: take()
                                    handled: false

                                    if(escape == 98) {
                                        buffer.add(8)
                                        handled = true
                                    }
                                    if(escape == 116) {
                                        buffer.add(9)
                                        handled = true
                                    }
                                    if(escape == 110) {
                                        buffer.add(10)
                                        handled = true
                                    }
                                    if(escape == 102) {
                                        buffer.add(12)
                                        handled = true
                                    }
                                    if(escape == 114) {
                                        buffer.add(13)
                                        handled = true
                                    }
                                    if(toml11 && (escape == 101)) {
                                        buffer.add(27)
                                        handled = true
                                    }
                                    if(toml11 && (escape == 120)) {
                                        parseUnicodeEscape(2, buffer)
                                        handled = true
                                    }
                                    if(escape == 34) {
                                        buffer.add(34)
                                        handled = true
                                    }
                                    if(escape == 92) {
                                        buffer.add(92)
                                        handled = true
                                    }
                                    if(escape == 117) {
                                        parseUnicodeEscape(4, buffer)
                                        handled = true
                                    }
                                    if(escape == 85) {
                                        parseUnicodeEscape(8, buffer)
                                        handled = true
                                    }

                                    handled.ifFalse(() => {
                                        fail()
                                    })
                                })
                            }

                            (octet == 92).ifFalse(() => {
                                newline: isNewlineStart(octet)

                                if(newline) {
                                    multiline.ifFalse(() => {
                                        fail()
                                    })
                                    index = index - 1
                                    consumeNewline()
                                    buffer.add(10)
                                }

                                newline.ifFalse(() => {
                                    invalidControl: octet < 32
                                    if(octet == 127) {
                                        invalidControl = true
                                    }
                                    if(octet == 9) {
                                        invalidControl = false
                                    }
                                    if(invalidControl) {
                                        fail()
                                    }
                                    buffer.add(octet)
                                })
                            })
                        }

                    })
            }
            Encoding.UTF8.decode(buffer)
        }

        parseLiteralString: (multiline) => {
            multiline.ifFalse(() => {
                (take() == 39).ifFalse(() => {
                    fail()
                })
            })

            if(multiline) {
                (take() == 39).ifFalse(() => { fail() })
                (take() == 39).ifFalse(() => { fail() })
                (take() == 39).ifFalse(() => { fail() })
                if(isNewlineStart(peek())) {
                    consumeNewline()
                }
            }

            buffer: Encoding.UTF8.encode("")
            done: false

            countQuotes: (initial) => {
                count: initial
                while(peek() == 39) {
                    index = index + 1
                    count = count + 1
                }
                count
            }

            while(done === false) {
                octet: take()
                ordinaryOctet: true

                    multiline.ifFalse(() => {
                        if(octet == 39) {
                            done = true
                        }
                    })

                    if(multiline) {
                        if(octet == 39) {
                            ordinaryOctet = false
                            quoteCount: countQuotes(1)

                            if(quoteCount >= 3) {
                                if(quoteCount > 5) {
                                    fail()
                                }
                                extra: quoteCount - 3
                                if(extra > 0) {
                                    buffer.add(39)
                                }
                                if(extra > 1) {
                                    buffer.add(39)
                                }
                                done = true
                            }

                            if(quoteCount < 3) {
                                buffer.add(39)
                                if(quoteCount == 2) {
                                    buffer.add(39)
                                }
                            }
                        }
                    }

                    done.ifFalse(() => {
                        if(ordinaryOctet) {
                            newline: isNewlineStart(octet)

                            if(newline) {
                                multiline.ifFalse(() => {
                                    fail()
                                })
                                index = index - 1
                                consumeNewline()
                                buffer.add(10)
                            }

                            newline.ifFalse(() => {
                                invalidControl: octet < 32
                                if(octet == 127) {
                                    invalidControl = true
                                }
                                if(octet == 9) {
                                    invalidControl = false
                                }
                                if(invalidControl) {
                                    fail()
                                }
                                buffer.add(octet)
                            })
                        }

                    })
            }
            Encoding.UTF8.decode(buffer)
        }

        isBareKeyOctet: (octet) => {
            result: false
            if(octet >= 48) {
                if(octet <= 57) { result = true }
            }
            if(octet >= 65) {
                if(octet <= 90) { result = true }
            }
            if(octet >= 97) {
                if(octet <= 122) { result = true }
            }
            if(octet == 95) { result = true }
            if(octet == 45) { result = true }
            result
        }

        parseKeyPart: () => {
            skipSpaces()
            first: peek()
            result: null

            if(first == 34) {
                result = parseBasicString(false)
            }
            if(first == 39) {
                result = parseLiteralString(false)
            }

            (first == 34).ifFalse(() => {
                (first == 39).ifFalse(() => {
                    buffer: Encoding.UTF8.encode("")

                    gathering: true
                    while(gathering && (index < length)) {
                        octet: source[index]
                        bare: isBareKeyOctet(octet)
                        if(bare) {
                            buffer.add(octet)
                            index = index + 1
                        }
                        bare.ifFalse(() => {
                            gathering = false
                        })
                    }
                    if(buffer.size() == 0) {
                        fail()
                    }
                    result = Encoding.UTF8.decode(buffer)
                })
            })

            result
        }

        parseKeyPath: () => {
            chunks: Map()
            maxLevel: -1

            appendPart: (part) => {
                chunk: Array(part)
                level: 0
                carrying: true

                while(carrying) {
                    present: chunks.containsKey(level)
                    if(present) {
                        left: chunks[level]
                        chunks.remove(level)
                        chunk = Array(...left, ...chunk)
                        level = level + 1
                    }
                    present.ifFalse(() => {
                        chunks[level] = chunk
                        if(level > maxLevel) {
                            maxLevel = level
                        }
                        carrying = false
                    })
                }
            }

            appendPart(parseKeyPart())
            more: true

            while(more) {
                skipSpaces()
                hasDot: peek() == 46
                if(hasDot) {
                    index = index + 1
                    appendPart(parseKeyPart())
                }
                hasDot.ifFalse(() => {
                    more = false
                })
            }

            parts: Array()
            level: maxLevel
            while(level >= 0) {
                if(chunks.containsKey(level)) {
                    parts = Array(...parts, ...chunks[level])
                }
                level = level - 1
            }
            parts
        }

        // Only a table created by an earlier dotted key of the same inline
        // table may be extended; an inline-table value is already complete.
        putPath: (map, parts, dottedTables, valueNode) => {
            current: map
            position: 0

            while(position < parts.size()) {
                name: parts[position]
                last: position == parts.size() - 1

                if(last) {
                    if(current.containsKey(name)) {
                        fail()
                    }
                    current[name] = valueNode
                    position = parts.size()
                }

                last.ifFalse(() => {
                    child: null
                    if(current.containsKey(name)) {
                        child = current[name]
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        dottedTables.containsKey(child).ifFalse(() => {
                            fail()
                        })
                    }
                    current.containsKey(name).ifFalse(() => {
                        child = syntaxNode("table", Map())
                        current[name] = child
                        dottedTables[child] = true
                    })
                    current = child.value
                    position = position + 1
                })
            }
        }

        carryFrameChunk: (frame, initialChunk, initialLevel) => {
            chunk: initialChunk
            level: initialLevel
            carrying: true
            while(carrying) {
                present: frame.chunks.containsKey(level)
                if(present) {
                    left: frame.chunks[level]
                    frame.chunks.remove(level)
                    chunk = Array(...left, ...chunk)
                    level = level + 1
                }
                present.ifFalse(() => {
                    frame.chunks[level] = chunk
                    if(level > frame.maxLevel) {
                        frame.maxLevel = level
                    }
                    carrying = false
                })
            }
        }

        collectFrameChunks: (frame, initialLevel, initialResult) => {
            level: initialLevel
            result: initialResult
            while(level >= 0) {
                if(frame.chunks.containsKey(level)) {
                    result = Array(...result, ...frame.chunks[level])
                }
                level = level - 1
            }
            result
        }

        decimalDigit: (octet) => {
            result: -1
            if(octet >= 48) {
                if(octet <= 57) {
                    result = octet - 48
                }
            }
            result
        }

        radixDigit: (octet, base) => {
            result: -1
            if(base == 16) {
                result = hexDigit(octet)
            }
            if(base == 10) {
                result = decimalDigit(octet)
            }
            if(base == 8) {
                digit: decimalDigit(octet)
                if(digit >= 0) {
                    if(digit <= 7) {
                        result = digit
                    }
                }
            }
            if(base == 2) {
                if(octet == 48) { result = 0 }
                if(octet == 49) { result = 1 }
            }
            result
        }

        integerFromToken: (token) => {
            tokenLength: token.size()
            position: 0
            negative: false
            signed: false
            valid: true
            base: 10

            if(position < tokenLength) {
                first: token[position]
                if(first == 43) {
                    signed = true
                    position = position + 1
                }
                if(first == 45) {
                    signed = true
                    negative = true
                    position = position + 1
                }
            }

            if(position >= tokenLength) {
                valid = false
            }

            if(valid) {
                if(position + 1 < tokenLength) {
                    if(token[position] == 48) {
                        prefix: token[position + 1]
                        if(prefix == 120) {
                            base = 16
                            position = position + 2
                        }
                        if(prefix == 111) {
                            base = 8
                            position = position + 2
                        }
                        if(prefix == 98) {
                            base = 2
                            position = position + 2
                        }
                    }
                }
            }

            if(base != 10) {
                if(signed) {
                    valid = false
                }
            }

            if(position >= tokenLength) {
                valid = false
            }

            resultValue: 0
            digits: 0
            previousUnderscore: false
            leadingZero: false

            if(valid) {
                while(position < tokenLength) {
                    octet: token[position]

                    if(octet == 95) {
                        invalidUnderscore: digits == 0
                        if(previousUnderscore) {
                            invalidUnderscore = true
                        }
                        if(invalidUnderscore) {
                            valid = false
                        }
                        previousUnderscore = true
                    }

                    (octet == 95).ifFalse(() => {
                        digit: radixDigit(octet, base)
                        if(digit < 0) {
                            valid = false
                        }
                        if(digit >= 0) {
                            if(digits == 0) {
                                if(digit == 0) {
                                    leadingZero = true
                                }
                            }
                            if(base == 10) {
                                if(leadingZero) {
                                    if(digits > 0) {
                                        valid = false
                                    }
                                }
                            }
                            resultValue = resultValue * base + digit
                            digits = digits + 1
                            previousUnderscore = false
                        }
                    })

                    position = position + 1
                }
            }

            if(digits == 0) {
                valid = false
            }
            if(previousUnderscore) {
                valid = false
            }

            if(negative) {
                resultValue = 0 - resultValue
            }


            result: {
                valid: valid
                value: resultValue
            }
            result
        }


        powerOfTen: (power) => {
            ignoredPowerValidation: 0 + power
            if(power < 0) {
                fail()
            }

            resultValue: 1
            factor: 10
            remaining: power

            while(remaining > 0) {
                if(remaining.mod(2) == 1) {
                    resultValue = resultValue * factor
                }
                remaining = remaining.div(2)
                if(remaining > 0) {
                    factor = factor * factor
                }
            }

            resultValue
        }

        floatFromToken: (token) => {
            decoded: Encoding.UTF8.decode(token)
            special: null

            if((decoded == "inf") || (decoded == "+inf")) {
                special = 1.0 / 0.0
            }
            if(decoded == "-inf") {
                special = -1.0 / 0.0
            }
            if((decoded == "nan") || (decoded == "+nan") || (decoded == "-nan")) {
                special = 0.0 / 0.0
            }

            result: {
                valid: special !== null
                value: special
            }

            if(special === null) {
                tokenLength: token.size()
                position: 0
                negative: false
                valid: true

                if(position < tokenLength) {
                    first: token[position]
                    if(first == 43) {
                        position = position + 1
                    }
                    if(first == 45) {
                        negative = true
                        position = position + 1
                    }
                }
                if(position >= tokenLength) {
                    valid = false
                }

                coefficient: 0
                integerDigits: 0
                fractionDigits: 0
                totalDigits: 0
                leadingZeros: 0
                significant: false
                firstIntegerZero: false
                previousDigit: false

                if(valid) {
                    scanningInteger: true
                    while(scanningInteger && (position < tokenLength)) {
                        octet: token[position]
                        digit: decimalDigit(octet)

                        if(digit >= 0) {
                            if(integerDigits == 0) {
                                if(digit == 0) {
                                    firstIntegerZero = true
                                }
                            }
                            if((integerDigits > 0) && firstIntegerZero) {
                                valid = false
                            }
                            coefficient = coefficient * 10 + digit
                            integerDigits = integerDigits + 1
                            totalDigits = totalDigits + 1
