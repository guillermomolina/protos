                                            yearPart.value,
                                            monthPart.value,
                                            dayPart.value,
                                            parsedTime.hour,
                                            parsedTime.minute,
                                            parsedTime.second,
                                            parsedTime.fractionCoefficient,
                                            parsedTime.fractionDigits
                                        )
                                    result.valid = true
                                }

