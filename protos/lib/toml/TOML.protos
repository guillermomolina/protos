                                    offsetValid: false
                                    offsetEnd: position

                                    if((token[position] == 90) ||
                                        (token[position] == 122)) {
                                        offsetValid = true
                                        offsetEnd = position + 1
                                    }

                                    if((token[position] == 43) ||
                                        (token[position] == 45)) {
                                        if(position + 5 < tokenLength) {
                                            if(token[position + 3] == 58) {
                                                offsetHour: twoDigitsAt(token, position + 1)
                                                offsetMinute: twoDigitsAt(token, position + 4)

                                                if(offsetHour.valid && offsetMinute.valid) {
                                                    if((offsetHour.value <= 23) &&
                                                        (offsetMinute.value <= 59)) {
                                                        offsetMinutes =
                                                            offsetHour.value * 60 +
                                                            offsetMinute.value
                                                        if(token[position] == 45) {
                                                            offsetMinutes =
                                                                0 - offsetMinutes
                                                        }
                                                        offsetEnd = position + 6
                                                        offsetValid = true
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if(offsetValid && (offsetEnd == tokenLength)) {
                                        result.value =
                                            publicOffsetDateTime(
                                                yearPart.value,
                                                monthPart.value,
                                                dayPart.value,
                                                parsedTime.hour,
                                                parsedTime.minute,
                                                parsedTime.second,
                                                parsedTime.fractionCoefficient,
                                                parsedTime.fractionDigits,
                                                offsetMinutes
                                            )
                                        result.valid = true
                                    }
                                }
                            }
                        }
                    }
                }
            }

            dateShape.ifFalse(() => {
                parsedTime: timeAt(token, 0)
                if(parsedTime.valid && (parsedTime.position == tokenLength)) {
                    result.value =
                        publicLocalTime(
                            parsedTime.hour,
                            parsedTime.minute,
                            parsedTime.second,
                            parsedTime.fractionCoefficient,
                            parsedTime.fractionDigits
                        )
                    result.valid = true
                }
            })

            result
        }

        isBareTerminator: (octet) => {
            result: octet < 0
            if(isSpace(octet)) { result = true }
            if(isNewlineStart(octet)) { result = true }
            if(octet == 35) { result = true }
            if(octet == 44) { result = true }
            if(octet == 93) { result = true }
            if(octet == 125) { result = true }
            result
        }

        parseBareValue: () => {
            token: Encoding.UTF8.encode("")

            gathering: true
            while(gathering) {
                octet: peek()
                terminator: octet < 0
                if(isNewlineStart(octet)) { terminator = true }
                if(octet == 35) { terminator = true }
                if(octet == 44) { terminator = true }
                if(octet == 93) { terminator = true }
                if(octet == 125) { terminator = true }

                if(terminator) {
                    gathering = false
                }
                terminator.ifFalse(() => {
                    invalidControl: octet < 32
                    if(octet == 9) {
                        invalidControl = false
                    }
                    if(octet == 127) {
                        invalidControl = true
                    }
                    if(invalidControl) {
                        fail()
                    }
                    token.add(take())
                })
            }
            if(token.size() == 0) {
                fail()
            }

            right: token.size()
            trimming: true
            while(trimming && (right > 0)) {
                whitespace: isSpace(token[right - 1])
                if(whitespace) {
                    right = right - 1
                }
                whitespace.ifFalse(() => {
                    trimming = false
                })
            }

            trimmed: Encoding.UTF8.encode("")
            copyIndex: 0
            while(copyIndex < right) {
                trimmed.add(token[copyIndex])
                copyIndex = copyIndex + 1
            }

            if(trimmed.size() == 0) {
                fail()
            }

            decoded: Encoding.UTF8.decode(trimmed)
            result: null

            if(decoded == "true") {
                result = syntaxNode("boolean", true)
            }
            if(decoded == "false") {
                result = syntaxNode("boolean", false)
            }

            if(result === null) {
                integer: integerFromToken(trimmed)
                if(integer.valid) {
                    result = syntaxNode("integer", integer.value)
                }
            }

            if(result === null) {
                temporal: temporalFromToken(trimmed)
                if(temporal.valid) {
                    result = temporal.value
                }
            }

            if(result === null) {
                floating: floatFromToken(trimmed)
                if(floating.valid) {
                    result = syntaxNode("float", floating.value)
                }
            }

            if(result === null) {
                fail()
            }

            result
        }

        topFrame: null
        depth: 0
        rootValue: null
        rootDone: false

        pushArrayFrame: () => {
            frame: {
                parent: topFrame
                kind: "array"
                phase: "valueOrEnd"
                chunks: Map()
                maxLevel: -1
            }
            topFrame = frame
            depth = depth + 1
        }

        pushInlineTableFrame: () => {
            frame: {
                parent: topFrame
                kind: "inlineTable"
                phase: "keyOrEnd"
                entries: Map()
                dottedTables: IdentityMap()
                pendingPath: null
            }
            topFrame = frame
            depth = depth + 1
        }

        appendArrayValue: (frame, valueNode) => {
            carryFrameChunk(frame, Array(valueNode), 0)
            frame.phase = "commaOrEnd"
        }

        acceptValue: (valueNode) => {
            if(depth == 0) {
                if(rootDone) { fail() }
                rootValue = valueNode
                rootDone = true
            }

            if(depth > 0) {
                frame: topFrame

                if(frame.kind == "array") {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    appendArrayValue(frame, valueNode)
                }

                if(frame.kind == "inlineTable") {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    putPath(
                        frame.entries,
                        frame.pendingPath,
                        frame.dottedTables,
                        valueNode
                    )
                    frame.pendingPath = null
                    frame.phase = "commaOrEnd"
                }
            }
        }

        closeArrayFrame: () => {
            frame: topFrame
            (frame.kind == "array").ifFalse(() => { fail() })
            validPhase: frame.phase == "valueOrEnd"
            if(frame.phase == "commaOrEnd") { validPhase = true }
            validPhase.ifFalse(() => { fail() })

            materialized: collectFrameChunks(frame, frame.maxLevel, Array())
            valueNode: syntaxNode("array", materialized)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        closeInlineTableFrame: () => {
            frame: topFrame
            (frame.kind == "inlineTable").ifFalse(() => { fail() })
            validPhase: frame.phase == "keyOrEnd"
            if(frame.phase == "commaOrEnd") { validPhase = true }
            validPhase.ifFalse(() => { fail() })

            valueNode: syntaxNode("table", frame.entries)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        startValue: () => {
            skipSpaces()
            first: peek()
            if(first < 0) { fail() }
            handled: false

            if(first == 91) {
                index = index + 1
                pushArrayFrame()
                handled = true
            }
            if(first == 123) {
                index = index + 1
                pushInlineTableFrame()
                handled = true
            }

            handled.ifFalse(() => {
                result: null
                if(first == 34) {
                    multiline: false
                    if(index + 2 < length) {
                        if((source[index + 1] == 34) &&
                            (source[index + 2] == 34)) {
                            multiline = true
                        }
                    }
                    result = syntaxNode("string", parseBasicString(multiline))
                }
                if(first == 39) {
                    multiline: false
                    if(index + 2 < length) {
                        if((source[index + 1] == 39) &&
                            (source[index + 2] == 39)) {
                            multiline = true
                        }
                    }
                    result = syntaxNode("string", parseLiteralString(multiline))
                }
                if(result === null) {
                    result = parseBareValue()
                }
                acceptValue(result)
            })
        }

        running: true
        while(running) {
            wasTopLevel: depth == 0

            if(wasTopLevel) {
                if(rootDone) {
                    running = false
                }
                rootDone.ifFalse(() => {
                    startValue()
                })
            }

            wasTopLevel.ifFalse(() => {
                frame: topFrame
                phase: frame.phase

                if(frame.kind == "array") {
                    skipArrayTrivia()

                    if(phase == "valueOrEnd") {
                        closing: peek() == 93
                        if(closing) {
                            index = index + 1
                            closeArrayFrame()
                        }
                        closing.ifFalse(() => {
                            frame.phase = "awaitValue"
                            startValue()
                        })
                    }

                    if(phase == "value") {
                        frame.phase = "awaitValue"
                        startValue()
                    }

                    if(phase == "commaOrEnd") {
                        comma: peek() == 44
                        closing: peek() == 93
                        if(comma) {
                            index = index + 1
                            skipArrayTrivia()
                            trailing: peek() == 93
                            if(trailing) {
                                index = index + 1
                                closeArrayFrame()
                            }
                            trailing.ifFalse(() => {
                                frame.phase = "value"
                            })
                        }
                        comma.ifFalse(() => {
                            if(closing) {
                                index = index + 1
                                closeArrayFrame()
                            }
                            closing.ifFalse(() => { fail() })
                        })
                    }
                }

                if(frame.kind == "inlineTable") {
                    skipInlineTableTrivia()

                    if(phase == "keyOrEnd") {
                        closing: peek() == 125
                        if(closing) {
                            index = index + 1
                            closeInlineTableFrame()
                        }
                        closing.ifFalse(() => {
                            frame.pendingPath = parseKeyPath()
                            skipSpaces()
                            (take() == 61).ifFalse(() => { fail() })
                            skipSpaces()
                            frame.phase = "value"
                        })
                    }

                    if(phase == "value") {
                        frame.phase = "awaitValue"
                        startValue()
                    }

                    if(phase == "commaOrEnd") {
                        comma: peek() == 44
                        closing: peek() == 125
                        if(comma) {
                            index = index + 1
                            skipInlineTableTrivia()
                            trailing: peek() == 125
                            if(trailing) {
                                // TOML 1.0 forbids a trailing comma in an inline table.
                                toml11.ifFalse(() => { fail() })
                                index = index + 1
                                closeInlineTableFrame()
                            }
                            trailing.ifFalse(() => {
                                frame.phase = "keyOrEnd"
                            })
                        }
                        comma.ifFalse(() => {
                            if(closing) {
                                index = index + 1
                                closeInlineTableFrame()
                            }
                            closing.ifFalse(() => { fail() })
                        })
                    }
                }
            })
        }

        result: rootValue
        skipSpaces()
        if(peek() == 35) {
            index = index + 1
            skipComment()
        }
        if(index < length) {
            if(isNewlineStart(peek())) { consumeNewline() }
        }
        skipSpaces()
        (index == length).ifFalse(() => { fail() })
        result

    }

    documentStatements: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        statementChunks: Map()
        statementMaxLevel: -1
        buffer: Encoding.UTF8.encode("")
        significant: false

        carryStatementChunk: (initialChunk, initialLevel) => {
            chunk: initialChunk
            level: initialLevel
            carrying: true
            while(carrying) {
                present: statementChunks.containsKey(level)
                if(present) {
                    left: statementChunks[level]
                    statementChunks.remove(level)
                    chunk = Array(...left, ...chunk)
                    level = level + 1
                }
                present.ifFalse(() => {
                    statementChunks[level] = chunk
                    if(level > statementMaxLevel) {
                        statementMaxLevel = level
                    }
                    carrying = false
                })
            }
        }

        collectStatementChunks: (initialLevel, initialResult) => {
            level: initialLevel
            result: initialResult
            while(level >= 0) {
                if(statementChunks.containsKey(level)) {
                    result = Array(...result, ...statementChunks[level])
                }
                level = level - 1
            }
            result
        }
        squareDepth: 0
        braceDepth: 0
        stringQuote: -1
        multiline: false
        comment: false

        peek: () => {
            value: -1
            if(index < length) {
                value = source[index]
            }
            value
        }

        take: () => {
            if(index >= length) {
                fail()
            }
            value: source[index]
            index = index + 1
            value
        }

        append: (octet) => {
            buffer.add(octet)
            (octet == 32).ifFalse(() => {
                (octet == 9).ifFalse(() => {
                    significant = true
                })
            })
        }

        appendQuotes: (quote, count) => {
            remaining: count
            while(remaining > 0) {
                append(quote)
                remaining = remaining - 1
            }
        }

        quoteRun: (quote) => {
            look: index
            count: 0
            scanning: true

            while(scanning && (look < length)) {
                matches: source[look] == quote
                if(matches) {
                    count = count + 1
                    look = look + 1
                }
                matches.ifFalse(() => {
                    scanning = false
                })
            }

            count
        }

        finish: () => {
            if(significant) {
                carryStatementChunk(Array(Encoding.UTF8.decode(buffer)), 0)
            }
            buffer = Encoding.UTF8.encode("")
            significant = false
        }

        appendNewline: (include) => {
            first: take()
            if(first == 10) {
                if(include) { append(10) }
            }
            if(first == 13) {
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                second: take()
                if(include) {
                    append(13)
                    append(second)
                }
            }
            (first == 10).ifFalse(() => {
                (first == 13).ifFalse(() => {
                    fail()
                })
            })
        }

        step: () => {
            octet: peek()

            wasComment: comment
            if(wasComment) {
                isNewline: octet == 10
                if(octet == 13) { isNewline = true }

                if(isNewline) {
                    comment = false
                    nested: squareDepth > 0
                    if(braceDepth > 0) { nested = true }
                    if(nested) {
                        appendNewline(true)
                    }
                    nested.ifFalse(() => {
                        appendNewline(false)
                        finish()
                    })
                }

                isNewline.ifFalse(() => {
                    forbiddenControl: octet < 32
                    if(octet == 9) {
                        forbiddenControl = false
                    }
                    if(octet == 127) {
                        forbiddenControl = true
                    }
                    if(forbiddenControl) {
                        fail()
                    }
                    index = index + 1
                })
            }

            wasComment.ifFalse(() => {
                wasString: stringQuote >= 0
                if(wasString) {
                    wasMultiline: multiline
                    if(wasMultiline) {
                        // Snapshot this before closing mutates stringQuote.
                        quoteOctet: octet == stringQuote
                        if(quoteOctet) {
                            run: quoteRun(stringQuote)
                            if(run >= 3) {
                                if(run > 5) {
                                    fail()
                                }
                                appendQuotes(stringQuote, run)
                                index = index + run
                                stringQuote = -1
                                multiline = false
                            }
                            if(run < 3) {
                                append(take())
                            }
                        }

                        quoteOctet.ifFalse(() => {
                            escapedBasic: stringQuote == 34
                            (octet == 92).ifFalse(() => {
                                escapedBasic = false
                            })

                            if(escapedBasic) {
                                append(take())
                                if(index >= length) {
                                    fail()
                                }
                                append(take())
                            }

                            escapedBasic.ifFalse(() => {
                                append(take())
                            })
                        })
                    }

                    wasMultiline.ifFalse(() => {
                        isNewline: octet == 10
                        if(octet == 13) { isNewline = true }
                        if(isNewline) {
                            fail()
                        }

                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        if(escapedBasic) {
                            append(take())
                            if(index >= length) {
                                fail()
                            }
                            append(take())
                        }

                        escapedBasic.ifFalse(() => {
                            append(take())
                            if(octet == stringQuote) {
                                stringQuote = -1
                            }
                        })
                    })
                }

                wasString.ifFalse(() => {
                    if(octet == 35) {
                        comment = true
                        index = index + 1
                    }

                    (octet == 35).ifFalse(() => {
                        isQuote: octet == 34
                        if(octet == 39) { isQuote = true }

                        if(isQuote) {
                            run: quoteRun(octet)
                            if(run >= 3) {
                                appendQuotes(octet, 3)
                                index = index + 3
                                stringQuote = octet
                                multiline = true
                            }
                            if(run < 3) {
                                append(take())
                                stringQuote = octet
                                multiline = false
                            }
                        }

                        isQuote.ifFalse(() => {
                            if(octet == 91) {
                                squareDepth = squareDepth + 1
                                append(take())
                            }
                            if(octet == 93) {
                                if(squareDepth == 0) {
                                    fail()
                                }
                                squareDepth = squareDepth - 1
                                append(take())
                            }
                            if(octet == 123) {
                                braceDepth = braceDepth + 1
                                append(take())
                            }
                            if(octet == 125) {
                                if(braceDepth == 0) {
                                    fail()
                                }
                                braceDepth = braceDepth - 1
                                append(take())
                            }

                            structural: octet == 91
                            if(octet == 93) { structural = true }
                            if(octet == 123) { structural = true }
                            if(octet == 125) { structural = true }

                            structural.ifFalse(() => {
                                isNewline: octet == 10
                                if(octet == 13) { isNewline = true }

                                if(isNewline) {
                                    nested: squareDepth > 0
                                    if(braceDepth > 0) { nested = true }
                                    if(nested) {
                                        appendNewline(true)
                                    }
                                    nested.ifFalse(() => {
                                        appendNewline(false)
                                        finish()
                                    })
                                }

                                isNewline.ifFalse(() => {
                                    append(take())
                                })
                            })
                        })
                    })
                })
            })

        }

        visitIndex: 0
        source.each((ignoredOctet) => {
            if(visitIndex == index) {
                step()
            }
            visitIndex = visitIndex + 1
        })

        (index == length).ifFalse(() => {
            fail()
        })

        if(stringQuote >= 0) {
            fail()
        }
        if(squareDepth != 0) {
            fail()
        }
        if(braceDepth != 0) {
            fail()
        }

        finish()
        collectStatementChunks(statementMaxLevel, Array())
    }

    documentTable: (text) => {
        items: documentStatements(text)

        node: (kind, value) => {
            result: {
                kind: kind
                value: value
            }
            result
        }

        root: node("table", Map())
        states: IdentityMap()
        states[root] = "root"
        current: root

        arrayTableBuilders: IdentityMap()
        arrayTableBuilderEntries: Map()
        arrayTableBuilderCount: 0

        appendArrayTableElement: (arrayNode, element) => {
            builder: null
            if(arrayTableBuilders.containsKey(arrayNode)) {
                builder = arrayTableBuilders[arrayNode]
            }
            arrayTableBuilders.containsKey(arrayNode).ifFalse(() => {
                builder = {
                    arrayNode: arrayNode
                    chunks: Map()
                    maxLevel: -1
                    last: null
                }
                arrayTableBuilders[arrayNode] = builder
                arrayTableBuilderEntries[arrayTableBuilderCount] = builder
                arrayTableBuilderCount = arrayTableBuilderCount + 1
            })

            chunk: Array(element)
            level: 0
            carrying: true
            while(carrying) {
                present: builder.chunks.containsKey(level)
                if(present) {
                    left: builder.chunks[level]
                    builder.chunks.remove(level)
                    chunk = Array(...left, ...chunk)
                    level = level + 1
                }
                present.ifFalse(() => {
                    builder.chunks[level] = chunk
                    if(level > builder.maxLevel) {
                        builder.maxLevel = level
                    }
                    carrying = false
                })
            }
            builder.last = element
        }

        materializeArrayTableBuilder: (builder) => {
            result: Array()
            level: builder.maxLevel
            while(level >= 0) {
                if(builder.chunks.containsKey(level)) {
                    result = Array(...result, ...builder.chunks[level])
                }
                level = level - 1
            }
            result
        }

        isSpace: (octet) => {
            result: octet == 32
            if(octet == 9) {
                result = true
            }
            result
        }

        decodeRange: (source, start, end) => {
            buffer: Encoding.UTF8.encode("")
            position: start
            while(position < end) {
                buffer.add(source[position])
                position = position + 1
            }
            Encoding.UTF8.decode(buffer)
        }

        trimBounds: (source) => {
            left: 0
            right: source.size()

            trimmingLeft: true
            while(trimmingLeft && (left < right)) {
                whitespace: isSpace(source[left])
                if(whitespace) {
                    left = left + 1
                }
                whitespace.ifFalse(() => {
                    trimmingLeft = false
                })
            }

            trimmingRight: true
            while(trimmingRight && (right > left)) {
                whitespace: isSpace(source[right - 1])
                if(whitespace) {
                    right = right - 1
                }
                whitespace.ifFalse(() => {
                    trimmingRight = false
                })
            }

            {
                left: left
                right: right
            }
        }

        markInlineTable: (valueNode) => {
            if(valueNode.kind == "table") {
                states[valueNode] = "inline"
            }
        }

        putDotted: (tableNode, parts, ignoredPosition, valueNode) => {
            selected: tableNode
            position: 0

            while(position < parts.count) {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value

                if(last) {
                    if(entries.containsKey(name)) {
                        fail()
                    }
                    entries[name] = valueNode
                    markInlineTable(valueNode)
                    position = parts.count
                }

                last.ifFalse(() => {
                    child: null
                    if(entries.containsKey(name)) {
                        child = entries[name]
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        state: states[child]
                        if(state == "header") {
                            fail()
                        }
                        if(state == "inline") {
                            fail()
                        }
                        if(state == "implicit") {
                            states[child] = "dotted"
                        }
                    }

                    entries.containsKey(name).ifFalse(() => {
                        child = node("table", Map())
                        entries[name] = child
                        states[child] = "dotted"
                    })

                    selected = child
                    position = position + 1
                })
            }
        }

        latestArrayTable: (arrayNode) => {
            (arrayNode.kind == "array").ifFalse(() => {
                fail()
            })
            states.containsKey(arrayNode).ifFalse(() => {
                fail()
            })
            (states[arrayNode] == "array-table").ifFalse(() => {
                fail()
            })
            arrayTableBuilders.containsKey(arrayNode).ifFalse(() => {
                fail()
            })
            builder: arrayTableBuilders[arrayNode]
            selected: builder.last
            if(selected === null) {
                fail()
            }
            (selected.kind == "table").ifFalse(() => {
                fail()
            })
            selected
        }

        existingParent: (child) => {
            selected: null

            if(child.kind == "table") {
                states.containsKey(child).ifFalse(() => {
                    fail()
                })
                if(states[child] == "inline") {
                    fail()
                }
                selected = child
            }

            if(child.kind == "array") {
                selected = latestArrayTable(child)
            }

            if(selected === null) {
                fail()
            }
            selected
        }

        selectHeader: (parts) => {
            selected: root
            position: 0

            while(position < parts.count) {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value
                child: null

                if(entries.containsKey(name)) {
                    child = entries[name]

                    if(last) {
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        state: states[child]
                        if(state == "implicit") {
                            states[child] = "header"
                        }
                        (state == "implicit").ifFalse(() => {
                            fail()
                        })
                        selected = child
                    }

                    last.ifFalse(() => {
                        selected = existingParent(child)
                    })
                }

                entries.containsKey(name).ifFalse(() => {
                    child = node("table", Map())
                    entries[name] = child
                    if(last) {
                        states[child] = "header"
                    }
                    last.ifFalse(() => {
                        states[child] = "implicit"
                    })
                    selected = child
                })

                position = position + 1
            }

            selected
        }

        selectArrayHeader: (parts) => {
            selected: root
            position: 0
            created: null

            while(position < parts.count) {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value
                child: null

                if(last) {
                    element: node("table", Map())
                    states[element] = "array-element"

                    if(entries.containsKey(name)) {
                        child = entries[name]
                        (child.kind == "array").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        (states[child] == "array-table").ifFalse(() => {
                            fail()
                        })
                    }

                    entries.containsKey(name).ifFalse(() => {
                        child = node("array", Array())
                        entries[name] = child
                        states[child] = "array-table"
                    })

                    appendArrayTableElement(child, element)
                    created = element
                }

                last.ifFalse(() => {
                    if(entries.containsKey(name)) {
                        child = entries[name]
                        selected = existingParent(child)
                    }

                    entries.containsKey(name).ifFalse(() => {
                        child = node("table", Map())
                        entries[name] = child
                        states[child] = "implicit"
                        selected = child
                    })
                })

                position = position + 1
            }

            created
        }

        parseHeader: (statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            if(bounds.left >= bounds.right) {
                fail()
            }
            (source[bounds.left] == 91).ifFalse(() => {
                fail()
            })
            (source[bounds.right - 1] == 93).ifFalse(() => {
                fail()
            })

            arrayHeader: false
            keyStart: bounds.left + 1
            keyEnd: bounds.right - 1

            if(keyStart < keyEnd) {
                if(source[keyStart] == 91) {
                    arrayHeader = true
                    if(keyStart + 1 >= keyEnd) {
                        fail()
                    }
                    (source[keyEnd - 1] == 93).ifFalse(() => {
                        fail()
                    })
                    keyStart = keyStart + 1
                    keyEnd = keyEnd - 1
                }
            }

            keyText: decodeRange(source, keyStart, keyEnd)
            {
                array: arrayHeader
                path: syntaxKeyPath(keyText)
            }
        }

        parseAssignment: (statement) => {
            source: Encoding.UTF8.encode(statement)
            length: source.size()
            position: 0
            quote: -1
            separator: -1

            while((position < length) && (separator < 0)) {
                        octet: source[position]
                        inQuote: quote >= 0

                        if(inQuote) {
                            escaped: quote == 34
                            (octet == 92).ifFalse(() => {
                                escaped = false
                            })

                            if(escaped) {
                                position = position + 1
                                if(position >= length) {
                                    fail()
                                }
                                position = position + 1
                            }

                            escaped.ifFalse(() => {
                                if(octet == quote) {
                                    quote = -1
                                }
                                position = position + 1
                            })
                        }

                        inQuote.ifFalse(() => {
                            isQuote: octet == 34
                            if(octet == 39) {
                                isQuote = true
                            }

                            if(isQuote) {
                                quote = octet
                                position = position + 1
                            }

                            isQuote.ifFalse(() => {
                                isNewline: octet == 10
                                if(octet == 13) {
                                    isNewline = true
                                }
                                if(isNewline) {
                                    fail()
                                }

                                if(octet == 61) {
                                    separator = position
                                }
                                position = position + 1
                            })
                        })

            }
            if(quote >= 0) {
                fail()
            }
            if(separator < 0) {
                fail()
            }

            keyText: decodeRange(source, 0, separator)
            valueText: decodeRange(source, separator + 1, length)
            {
                path: syntaxKeyPath(keyText)
                value: syntaxValue(valueText)
            }
        }

        items.each((statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            if(bounds.left >= bounds.right) {
                fail()
            }

            header: source[bounds.left] == 91
            if(header) {
                parsedHeader: parseHeader(statement)
                if(parsedHeader.array) {
                    current = selectArrayHeader(parsedHeader.path)
                }
                parsedHeader.array.ifFalse(() => {
                    current = selectHeader(parsedHeader.path)
                })
            }

            header.ifFalse(() => {
                assignment: parseAssignment(statement)
                putDotted(current, assignment.path, 0, assignment.value)
            })
        })

        builderIndex: 0
        while(builderIndex < arrayTableBuilderCount) {
            builder: arrayTableBuilderEntries[builderIndex]
            builder.arrayNode.value = materializeArrayTableBuilder(builder)
            builderIndex = builderIndex + 1
        }

        root
    }

    documentTable(text)
}

/// Parses one complete TOML 1.1 document into its root table node; invalid text signals
/// an Error. Equivalent to `parseDialect(text, "1.1")`.
parse: (text) => {
    parseDialect(text, "1.1")
}
