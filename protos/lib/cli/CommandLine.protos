//! Canonical inert command-line specification records.

/// Canonicalizes one option descriptor into a fresh frozen OptionSpec record.
option: (descriptor) => {
    fail: () => {
        Error().signal()
    }

    required: (name) => {
        descriptor.hasSlot(name).ifFalse(() => {
            fail()
        })
        descriptor.slotValue(name)
    }

    validateString: (value) => {
        validated: "" + value
        (validated === value).ifFalse(() => {
            fail()
        })
        value
    }

    validateNonEmptyString: (value) => {
        validateString(value)
        (value == "").ifTrue(() => {
            fail()
        })
        value
    }

    validateOptionalString: (value) => {
        (value === null).ifFalse(() => {
            validateString(value)
        })
        value
    }

    isAlpha: (octet) => {
        ((octet >= 65) && (octet <= 90)) ||
            ((octet >= 97) && (octet <= 122))
    }

    isDigit: (octet) => {
        (octet >= 48) && (octet <= 57)
    }

    validateLongName: (value) => {
        validateString(value)
        source: Encoding.UTF8.encode(value)
        (source.size() == 0).ifTrue(() => {
            fail()
        })
        isAlpha(source[0]).ifFalse(() => {
            fail()
        })
        index: 1
        (() => index < source.size()).while() {
            octet: source[index]
            allowed: isAlpha(octet) || isDigit(octet) || (octet == 45)
            allowed.ifFalse(() => {
                fail()
            })
            index = index + 1
        }
        value
    }

    validateShortName: (value) => {
        validateString(value)
        source: Encoding.UTF8.encode(value)
        (source.size() == 1).ifFalse(() => {
            fail()
        })
        (isAlpha(source[0]) || isDigit(source[0])).ifFalse(() => {
            fail()
        })
        value
    }

    validateInteger: (value) => {
        ignoredValidation: value.div(1)
        value
    }

    keyValue: validateNonEmptyString(required("key"))
    longValue: required("long")
    shortValue: required("short")
    minValuesValue: validateInteger(required("minValues"))
    maxValuesValue: validateInteger(required("maxValues"))
    minOccurrencesValue: validateInteger(required("minOccurrences"))
    maxOccurrencesValue: required("maxOccurrences")
    valueNameValue: validateOptionalString(required("valueName"))
    helpValue: validateOptionalString(required("help"))

    (longValue === null).ifFalse(() => {
        validateLongName(longValue)
    })
    (shortValue === null).ifFalse(() => {
        validateShortName(shortValue)
    })
    ((longValue === null) && (shortValue === null)).ifTrue(() => {
        fail()
    })

    validValueCardinality: ((minValuesValue == 0) && (maxValuesValue == 0)) ||
        ((minValuesValue == 1) && (maxValuesValue == 1))
    validValueCardinality.ifFalse(() => {
        fail()
    })

    ((minOccurrencesValue == 0) || (minOccurrencesValue == 1)).ifFalse(() => {
        fail()
    })
    (maxOccurrencesValue === null).ifFalse(() => {
        validateInteger(maxOccurrencesValue)
        (maxOccurrencesValue == 1).ifFalse(() => {
            fail()
        })
    })

    canonical: {
        kind: "option"
        key: keyValue
        long: longValue
        short: shortValue
        minValues: minValuesValue
        maxValues: maxValuesValue
        minOccurrences: minOccurrencesValue
        maxOccurrences: maxOccurrencesValue
        valueName: valueNameValue
        help: helpValue
    }

    canonical.freeze()
}

/// Canonicalizes one positional descriptor into a fresh frozen PositionalSpec record.
positional: (descriptor) => {
    fail: () => {
        Error().signal()
    }

    required: (name) => {
        descriptor.hasSlot(name).ifFalse(() => {
            fail()
        })
        descriptor.slotValue(name)
    }

    validateString: (value) => {
        validated: "" + value
        (validated === value).ifFalse(() => {
            fail()
        })
        value
    }

    validateNonEmptyString: (value) => {
        validateString(value)
        (value == "").ifTrue(() => {
            fail()
        })
        value
    }

    validateOptionalString: (value) => {
        (value === null).ifFalse(() => {
            validateString(value)
        })
        value
    }

    validateInteger: (value) => {
        ignoredValidation: value.div(1)
        value
    }

    keyValue: validateNonEmptyString(required("key"))
    minOccurrencesValue: validateInteger(required("minOccurrences"))
    maxOccurrencesValue: required("maxOccurrences")
    valueNameValue: validateOptionalString(required("valueName"))
    helpValue: validateOptionalString(required("help"))

    ((minOccurrencesValue == 0) || (minOccurrencesValue == 1)).ifFalse(() => {
        fail()
    })
    (maxOccurrencesValue === null).ifFalse(() => {
        validateInteger(maxOccurrencesValue)
        (maxOccurrencesValue == 1).ifFalse(() => {
            fail()
        })
    })

    canonical: {
        kind: "positional"
        key: keyValue
        minOccurrences: minOccurrencesValue
        maxOccurrences: maxOccurrencesValue
        valueName: valueNameValue
        help: helpValue
    }

    canonical.freeze()
}

/// Canonicalizes one command descriptor and its complete nested specification graph.
command: (descriptor) => {
    fail: () => {
        Error().signal()
    }

    validateString: (value) => {
        validated: "" + value
        (validated === value).ifFalse(() => {
            fail()
        })
        value
    }

    validateOptionalString: (value) => {
        (value === null).ifFalse(() => {
            validateString(value)
        })
        value
    }

    isAlpha: (octet) => {
        ((octet >= 65) && (octet <= 90)) ||
            ((octet >= 97) && (octet <= 122))
    }

    isDigit: (octet) => {
        (octet >= 48) && (octet <= 57)
    }

    validateCommandName: (value) => {
        validateString(value)
        source: Encoding.UTF8.encode(value)
        (source.size() == 0).ifTrue(() => {
            fail()
        })
        isAlpha(source[0]).ifFalse(() => {
            fail()
        })
        index: 1
        (() => index < source.size()).while() {
            octet: source[index]
            allowed: isAlpha(octet) || isDigit(octet) || (octet == 45)
            allowed.ifFalse(() => {
                fail()
            })
            index = index + 1
        }
        value
    }

    validateArray: (value) => {
        (value.parent() === Array).ifFalse(() => {
            fail()
        })
        value
    }

    visiting: IdentityMap()
    canonicalizeCommand: null

    canonicalizeCommand = (candidate) => {
        visiting.containsKey(candidate).ifTrue(() => {
            fail()
        })
        visiting[candidate] = true

        required: (name) => {
            candidate.hasSlot(name).ifFalse(() => {
                fail()
            })
            candidate.slotValue(name)
        }

        nameValue: validateCommandName(required("name"))
        helpValue: validateOptionalString(required("help"))
        optionDescriptors: validateArray(required("options"))
        positionalDescriptors: validateArray(required("positionals"))
        subcommandDescriptors: validateArray(required("subcommands"))

        canonicalOptions: Array(...optionDescriptors)
        optionKeys: Map()
        longNames: Map()
        shortNames: Map()

        optionIndex: 0
        optionDescriptors.each((entry) => {
            spec: option(entry)

            optionKeys.containsKey(spec.key).ifTrue(() => {
                fail()
            })
            optionKeys[spec.key] = true

            (spec.long === null).ifFalse(() => {
                longNames.containsKey(spec.long).ifTrue(() => {
                    fail()
                })
                longNames[spec.long] = true
            })

            (spec.short === null).ifFalse(() => {
                shortNames.containsKey(spec.short).ifTrue(() => {
                    fail()
                })
                shortNames[spec.short] = true
            })

            canonicalOptions[optionIndex] = spec
            optionIndex = optionIndex + 1
        })
        canonicalOptions.freeze()

        canonicalPositionals: Array(...positionalDescriptors)
        positionalKeys: Map()
        positionalIndex: 0
        positionalDescriptors.each((entry) => {
            spec: positional(entry)

            positionalKeys.containsKey(spec.key).ifTrue(() => {
                fail()
            })
            positionalKeys[spec.key] = true

            (spec.maxOccurrences === null).ifTrue(() => {
                ((positionalIndex + 1) == positionalDescriptors.size()).ifFalse(() => {
                    fail()
                })
            })

            canonicalPositionals[positionalIndex] = spec
            positionalIndex = positionalIndex + 1
        })
        canonicalPositionals.freeze()

        canonicalSubcommands: Array(...subcommandDescriptors)
        subcommandNames: Map()
        subcommandIndex: 0
        subcommandDescriptors.each((entry) => {
            spec: canonicalizeCommand(entry)

            subcommandNames.containsKey(spec.name).ifTrue(() => {
                fail()
            })
            subcommandNames[spec.name] = true

            canonicalSubcommands[subcommandIndex] = spec
            subcommandIndex = subcommandIndex + 1
        })
        canonicalSubcommands.freeze()

        visiting.remove(candidate)

        canonical: {
            kind: "command"
            name: nameValue
            help: helpValue
            options: canonicalOptions
            positionals: canonicalPositionals
            subcommands: canonicalSubcommands
        }

        canonical.freeze()
    }

    canonicalizeCommand(descriptor)
}

/// Parses one already-selected command scope into a fresh frozen lossless result.
///
/// Nested command traversal remains owned by LIB011-C; this parser rejects a
/// CommandSpec that still contains subcommands.
parse: (specification, suppliedArguments) => {
    fail: () => {
        Error().signal()
    }

    validateArray: (value) => {
        (value.parent() === Array).ifFalse(() => {
            fail()
        })
        value
    }

    validateString: (value) => {
        validated: "" + value
        (validated === value).ifFalse(() => {
            fail()
        })
        value
    }

    specification.hasSlot("kind").ifFalse(() => {
        fail()
    })
    (specification.slotValue("kind") == "command").ifFalse(() => {
        fail()
    })

    spec: command(specification)
    (spec.subcommands.size() == 0).ifFalse(() => {
        fail()
    })

    validateArray(suppliedArguments)
    suppliedArguments.each((entry) => {
        validateString(entry)
    })

    arguments: Array(...suppliedArguments)
    arguments.freeze()

    newBuilder: () => {
        {
            chunks: Map()
            maxLevel: -1
        }
    }

    carryChunk: null
    carryChunk = (builder, chunk, level) => {
        present: builder.chunks.containsKey(level)

        present.ifTrue(() => {
            left: builder.chunks[level]
            builder.chunks.remove(level)
            carryChunk(builder, Array(...left, ...chunk), level + 1)
        })

        present.ifFalse(() => {
            builder.chunks[level] = chunk
            (level > builder.maxLevel).ifTrue(() => {
                builder.maxLevel = level
            })
        })
    }

    appendBuilt: (builder, value) => {
        carryChunk(builder, Array(value), 0)
    }

    collectChunks: null
    collectChunks = (builder, level, result) => {
        finalResult: result

        (level >= 0).ifTrue(() => {
            nextResult: result
            builder.chunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...builder.chunks[level])
            })
            finalResult = collectChunks(builder, level - 1, nextResult)
        })

        finalResult
    }

    finishBuilder: (builder) => {
        collectChunks(builder, builder.maxLevel, Array())
    }

    decodeRange: (source, start, end) => {
        buffer: Encoding.UTF8.encode("")
        cursor: start
        (() => cursor < end).while() {
            buffer.add(source[cursor])
            cursor = cursor + 1
        }
        Encoding.UTF8.decode(buffer)
    }

    isAsciiLetter: (octet) => {
        ((octet >= 65) && (octet <= 90)) ||
            ((octet >= 97) && (octet <= 122))
    }

    isAsciiDigit: (octet) => {
        (octet >= 48) && (octet <= 57)
    }

    isShortOctet: (octet) => {
        isAsciiLetter(octet) || isAsciiDigit(octet)
    }

    longOptions: Map()
    shortOptions: Map()
    occurrenceCounts: Map()

    spec.options.each((optionSpec) => {
        occurrenceCounts[optionSpec.key] = 0

        (optionSpec.long === null).ifFalse(() => {
            longOptions[optionSpec.long] = optionSpec
        })

        (optionSpec.short === null).ifFalse(() => {
            shortOptions[optionSpec.short] = optionSpec
        })
    })

    optionBuilder: newBuilder()
    rawPositionalBuilder: newBuilder()

    recordOption: (optionSpec, spelling, tokenIndex, value, valueTokenIndex) => {
        count: occurrenceCounts[optionSpec.key]

        (optionSpec.maxOccurrences === null).ifFalse(() => {
            (count >= optionSpec.maxOccurrences).ifTrue(() => {
                fail()
            })
        })

        occurrenceCounts[optionSpec.key] = count + 1

        occurrence: {
            kind: "optionOccurrence"
            key: optionSpec.key
            spelling: spelling
            tokenIndex: tokenIndex
            value: value
            valueTokenIndex: valueTokenIndex
        }
        occurrence.freeze()
        appendBuilt(optionBuilder, occurrence)
    }

    recordRawPositional: (value, tokenIndex) => {
        appendBuilt(
            rawPositionalBuilder,
            {
                value: value
                tokenIndex: tokenIndex
            }
        )
    }

    scanIndex: 0
    optionsEnabled: true
    endOfOptionsIndex: null

    (() => scanIndex < arguments.size()).while() {
        token: arguments[scanIndex]
        source: Encoding.UTF8.encode(token)
        advance: 1
        handled: false

        optionsEnabled.ifTrue(() => {
            (token == "--").ifTrue(() => {
                endOfOptionsIndex = scanIndex
                optionsEnabled = false
                handled = true
            })

            handled.ifFalse(() => {
                optionLike: false
                (source.size() > 0).ifTrue(() => {
                    (source[0] == 45).ifTrue(() => {
                        optionLike = true
                    })
                })

                optionLike.ifTrue(() => {
                    (source.size() == 1).ifTrue(() => {
                        fail()
                    })

                    longForm: source[1] == 45

                    longForm.ifTrue(() => {
                        equalsIndex: -1
                        cursor: 2
                        (() => cursor < source.size()).while() {
                            ((equalsIndex < 0) && (source[cursor] == 61)).ifTrue(() => {
                                equalsIndex = cursor
                            })
                            cursor = cursor + 1
                        }

                        nameEnd: source.size()
                        (equalsIndex >= 0).ifTrue(() => {
                            nameEnd = equalsIndex
                        })

                        longName: decodeRange(source, 2, nameEnd)
                        longOptions.containsKey(longName).ifFalse(() => {
                            fail()
                        })

                        optionSpec: longOptions[longName]
                        spelling: "--" + optionSpec.long

                        (equalsIndex >= 0).ifTrue(() => {
                            (optionSpec.maxValues == 1).ifFalse(() => {
                                fail()
                            })

                            value: decodeRange(source, equalsIndex + 1, source.size())
                            recordOption(
                                optionSpec,
                                spelling,
                                scanIndex,
                                value,
                                scanIndex
                            )
                        })

                        (equalsIndex >= 0).ifFalse(() => {
                            (optionSpec.maxValues == 1).ifTrue(() => {
                                ((scanIndex + 1) >= arguments.size()).ifTrue(() => {
                                    fail()
                                })

                                recordOption(
                                    optionSpec,
                                    spelling,
                                    scanIndex,
                                    arguments[scanIndex + 1],
                                    scanIndex + 1
                                )
                                advance = 2
                            })

                            (optionSpec.maxValues == 1).ifFalse(() => {
                                recordOption(
                                    optionSpec,
                                    spelling,
                                    scanIndex,
                                    null,
                                    null
                                )
                            })
                        })

                        handled = true
                    })

                    longForm.ifFalse(() => {
                        memberCount: source.size() - 1
                        cursor: 1

                        (() => cursor < source.size()).while() {
                            octet: source[cursor]
                            isShortOctet(octet).ifFalse(() => {
                                fail()
                            })

                            shortName: decodeRange(source, cursor, cursor + 1)
                            shortOptions.containsKey(shortName).ifFalse(() => {
                                fail()
                            })

                            optionSpec: shortOptions[shortName]
                            spelling: "-" + optionSpec.short

                            (memberCount > 1).ifTrue(() => {
                                (optionSpec.maxValues == 0).ifFalse(() => {
                                    fail()
                                })
                                recordOption(
                                    optionSpec,
                                    spelling,
                                    scanIndex,
                                    null,
                                    null
                                )
                            })

                            (memberCount == 1).ifTrue(() => {
                                (optionSpec.maxValues == 1).ifTrue(() => {
                                    ((scanIndex + 1) >= arguments.size()).ifTrue(() => {
                                        fail()
                                    })

                                    recordOption(
                                        optionSpec,
                                        spelling,
                                        scanIndex,
                                        arguments[scanIndex + 1],
                                        scanIndex + 1
                                    )
                                    advance = 2
                                })

                                (optionSpec.maxValues == 1).ifFalse(() => {
                                    recordOption(
                                        optionSpec,
                                        spelling,
                                        scanIndex,
                                        null,
                                        null
                                    )
                                })
                            })

                            cursor = cursor + 1
                        }

                        handled = true
                    })
                })
            })
        })

        handled.ifFalse(() => {
            recordRawPositional(token, scanIndex)
        })

        scanIndex = scanIndex + advance
    }

    spec.options.each((optionSpec) => {
        (occurrenceCounts[optionSpec.key] < optionSpec.minOccurrences).ifTrue(() => {
            fail()
        })
    })

    rawPositionals: finishBuilder(rawPositionalBuilder)

    requiredPositionals: 0
    spec.positionals.each((positionalSpec) => {
        requiredPositionals = requiredPositionals + positionalSpec.minOccurrences
    })

    (rawPositionals.size() < requiredPositionals).ifTrue(() => {
        fail()
    })

    positionalBuilder: newBuilder()
    rawIndex: 0
    laterMinimum: requiredPositionals

    spec.positionals.each((positionalSpec) => {
        laterMinimum = laterMinimum - positionalSpec.minOccurrences
        remaining: rawPositionals.size() - rawIndex
        consume: 0

        (positionalSpec.maxOccurrences === null).ifTrue(() => {
            consume = remaining
        })

        (positionalSpec.maxOccurrences === null).ifFalse(() => {
            (positionalSpec.minOccurrences == 1).ifTrue(() => {
                consume = 1
            })

            (positionalSpec.minOccurrences == 0).ifTrue(() => {
                (remaining > laterMinimum).ifTrue(() => {
                    consume = 1
                })
            })
        })

        (consume < positionalSpec.minOccurrences).ifTrue(() => {
            fail()
        })

        consumed: 0
        (() => consumed < consume).while() {
            raw: rawPositionals[rawIndex]
            occurrence: {
                kind: "positionalOccurrence"
                key: positionalSpec.key
                value: raw.value
                tokenIndex: raw.tokenIndex
            }
            occurrence.freeze()
            appendBuilt(positionalBuilder, occurrence)

            rawIndex = rawIndex + 1
            consumed = consumed + 1
        }
    })

    (rawIndex == rawPositionals.size()).ifFalse(() => {
        fail()
    })

    optionOccurrences: finishBuilder(optionBuilder)
    optionOccurrences.freeze()

    positionalOccurrences: finishBuilder(positionalBuilder)
    positionalOccurrences.freeze()

    commandResult: {
        kind: "commandResult"
        name: spec.name
        tokenIndex: null
        endOfOptionsIndex: endOfOptionsIndex
        options: optionOccurrences
        positionals: positionalOccurrences
        subcommand: null
    }
    commandResult.freeze()

    result: {
        kind: "parseResult"
        arguments: arguments
        command: commandResult
    }
    result.freeze()
}
