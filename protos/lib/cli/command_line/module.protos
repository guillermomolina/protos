//! Canonical inert command-line specification records.

Normalizers: import("./internal/Normalizers.protos")
Specification: import("./internal/Specification.protos")
Parser: import("./internal/Parser.protos")
Help: import("./internal/Help.protos")

// Private lexical scope of the two descriptor normalizers. They are captured
// by `option`, `positional` and `command` below and are not module surface.
_commandLineNormalizers: Normalizers.create()

/// Canonicalizes one option, given by its nine required named parameters, into
/// a fresh frozen OptionSpec record.
this.option: Specification.createOption(_commandLineNormalizers.option)

/// Canonicalizes one positional, given by its five required named parameters,
/// into a fresh frozen PositionalSpec record.
this.positional: Specification.createPositional(_commandLineNormalizers.positional)

/// Canonicalizes one command descriptor and its complete nested specification graph.
this.command: Specification.createCommand(_commandLineNormalizers.option, _commandLineNormalizers.positional)

// The normalizers are captured privately above; they are not module surface.
context.removeSlot("_commandLineNormalizers")

/// Parses a canonical CommandSpec tree into a fresh frozen lossless result.
///
/// Traversal follows D115 Candidate C-prime: the earliest feasible exact-child
/// boundary, parent-minimum reservation, current-scope `--` escape and
/// irreversible child scope transfer.
this.parse: Parser.slotValue("parse")

/// Renders canonical pure help for one exact command path.
///
/// D118 Candidate F-prime fixes deterministic unwrapped plain text with explicit
/// path context and no terminal/output authority. D119 Candidate A-prime ensures
/// every value-bearing canonical specification already carries a non-empty
/// presentation valueName.
this.renderHelp: Help.slotValue("renderHelp")
