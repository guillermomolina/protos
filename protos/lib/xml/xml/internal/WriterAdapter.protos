//! Borrowed writer composition retains only the validated stable String contribution.
create: (errors, records, selectWriter) => {
    {
        writeEvents: (textWriter, limits: null) => {
            unavailable: false
            captured: null
            writer: (selectWriter())((chunk) => { captured = chunk }, limits)
            adapter: null
            adapter = {
                feed: (event) => {
                    if(unavailable) { errors.lifecycle() }
                    records.event(event)
                    unavailable = true
                    writer.feed(event)
                    chunk: captured; captured = null
                    event = null
                    textWriter.writeText(chunk).then((ignored) => {
                        unavailable = false
                        adapter
                    })
                }
                finish: () => {
                    if(unavailable) { errors.lifecycle() }
                    unavailable = true; writer.finish()
                    textWriter.writeText("").then((ignored) => { adapter })
                }
            }
            adapter
        }
    }
}
