//! One event writer validates the entire contribution before invoking its consumer.
create: (errors, budgeting, records, namespaces, escaping) => {
    {
        eventWriter: (emit, limits: null) => {
            bounds: budgeting.snapshot(limits)
            lifecycle: "OPEN"; phase: "before"; eligible: true
            stack: null; depth: 0; nodes: 0; produced: 0; textRun: false
            scope: namespaces.scope()
            writer: null
            ready: () => { if(lifecycle != "OPEN") { errors.lifecycle() } }
            writer = {
                feed: (event) => {
                    ready(); records.event(event)
                    lifecycle = "ACTIVE"
                    completed: false
                    (() => {
                        kind: event.kind
                        undo: null
                        node: false
                        if(kind == "declaration") {
                            if(!eligible || (phase != "before")) { errors.syntax(null) }
                        }
                        if(kind == "startElement") {
                            if(phase == "after") { errors.syntax(null) }
                            undo = scope.enter(event.namespaceDeclarations, null)
                            scope.checkName(event.name, false, null)
                            scope.attributes(event.attributes, null)
                            budgeting.check(bounds, "maxAttributesPerElement", event.attributes.size(), null)
                            budgeting.check(bounds, "maxNamespaceDeclarationsPerElement", event.namespaceDeclarations.size(), null)
                            budgeting.check(bounds, "maxDepth", depth + 1, null)
                            node = true
                        }
                        if(kind == "endElement") {
                            if(stack === null) { errors.syntax(null) }
                            scope.checkName(event.name, false, null)
                            if((scope.lexical(event.name) != stack.lexical) || (event.name.namespaceURI != stack.uri)) { errors.namespace(null) }
                        }
                        if(kind == "text") {
                            if(phase != "inside") { errors.syntax(null) }
                            node = !textRun
                        }
                        if((kind == "comment") || (kind == "processingInstruction")) { node = true }
                        if(node) { budgeting.check(bounds, "maxNodes", nodes + 1, null) }
                        contribution: escaping.render(event, bounds, produced, scope.slotValue("lexical"))
                        // Retain stable scalars rather than the caller's mutable event graph.
                        if(kind == "startElement") {
                            spelling: scope.lexical(event.name); namespaceURI: event.name.namespaceURI
                            stack = { lexical: spelling; uri: namespaceURI; restoration: undo; next: stack }
                            depth = depth + 1; phase = "inside"
                        }
                        if(kind == "endElement") {
                            scope.leave(stack.restoration); stack = stack.next; depth = depth - 1
                            if(depth == 0) { phase = "after" }
                        }
                        if(node) { nodes = nodes + 1 }
                        textRun = kind == "text"; eligible = false
                        produced = produced + contribution.size()
                        emit(contribution)
                        completed = true
                    }).ensure(() => {
                        lifecycle = "FAILED"
                        if(completed) { lifecycle = "OPEN" }
                    })
                    writer
                }
                finish: () => {
                    ready(); lifecycle = "ACTIVE"
                    completed: false
                    (() => {
                        if((phase != "after") || (stack !== null)) { errors.syntax(null) }
                        completed = true
                    }).ensure(() => {
                        lifecycle = "FAILED"
                        if(completed) { lifecycle = "FINISHED" }
                    })
                    writer
                }
            }
            writer
        }
    }
}
