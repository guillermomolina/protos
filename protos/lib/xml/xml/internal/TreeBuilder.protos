//! Tree materialization consumes only validated events from EventParser.
Builders: import("./Builders.protos")
create: (records) => {
    {
        builder: () => {
            declaration: null
            before: Builders.array(); after: Builders.array()
            root: null; stack: null
            flush: () => {
                if((stack !== null) && (stack.text !== null)) {
                    Builders.push(stack.children, records.makeValue("text", Builders.string(stack.text)))
                    stack.text = null
                }
            }
            attach: (node) => {
                if(stack !== null) { Builders.push(stack.children, node) }
                if(stack === null) {
                    if(root === null) { Builders.push(before, node) }
                    if(root !== null) { Builders.push(after, node) }
                }
            }
            {
                accept: (event) => {
                    kind: event.kind
                    if(kind == "text") {
                        if(stack.text === null) { stack.text = Builders.text() }
                        Builders.append(stack.text, event.value)
                    }
                    if(kind != "text") { flush() }
                    if(kind == "declaration") { declaration = event }
                    if(kind == "startElement") {
                        stack = { start: event; children: Builders.array(); text: null; next: stack }
                    }
                    if(kind == "endElement") {
                        start: stack.start
                        node: records.makeElement(start.name, start.attributes, start.namespaceDeclarations, Builders.finish(stack.children))
                        stack = stack.next
                        if(stack === null) { root = node }
                        if(stack !== null) { Builders.push(stack.children, node) }
                    }
                    if((kind == "comment") || (kind == "processingInstruction")) { attach(event) }
                }
                document: () => { records.makeDocument(declaration, Builders.finish(before), root, Builders.finish(after)) }
            }
        }
    }
}
