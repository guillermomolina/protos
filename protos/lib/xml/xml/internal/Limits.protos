//! Inclusive semantic scalar and structural bounds; callers own their counters.
create: (errors) => {
    // Bytes is not a required Prelude binding. An ordinary Encoding result
    // supplies its existing standard parent without introducing a public name.
    bytesParent: Encoding.UTF8.encode("").parent()
    defaults: {
        maxDocumentScalars: 2097152; maxDepth: 256
        maxAttributesPerElement: 256; maxNamespaceDeclarationsPerElement: 128
        maxNameScalars: 1024; maxAttributeScalars: 262144
        maxTokenScalars: 1048576; maxNodes: 250000
    }.freeze()
    {
        snapshot: (options) => {
            result: {}
            for(key in defaults.slotNames()) { result.createSlot(key, defaults.slotValue(key)) }
            if(options !== null) {
                if(String.recognizes(options) || Integer.recognizes(options) || Float.recognizes(options) ||
                    Fraction.recognizes(options) || Complex.recognizes(options) || Array.recognizes(options) ||
                    (options === true) || (options === false) || (options.parent() === bytesParent) || (options.parent() === Future)) { errors.argument() }
                for(key in options.slotNames()) {
                    if(!defaults.hasSlot(key)) { errors.argument() }
                    value: options.slotValue(key)
                    if(!Integer.recognizes(value)) { errors.argument() }
                    if(value <= 0) { errors.argument() }
                    result.updateSlot(key, value)
                }
            }
            result.freeze()
        }
        check: (bounds, key, value, position) => {
            if(value > bounds.slotValue(key)) { errors.limit(position, key) }
        }
    }
}
