//! Private geometric Array accumulation and BOM-preserving UTF-8 output.

array: () => { { chunks: Map(); highest: -1; size: 0; last: null } }

push: (builder, value) => {
    chunk: [value]
    level: 0
    while(builder.chunks.containsKey(level)) {
        chunk = Array(...builder.chunks[level], ...chunk)
        builder.chunks.remove(level)
        level = level + 1
    }
    builder.chunks[level] = chunk
    if(level > builder.highest) { builder.highest = level }
    builder.size = builder.size + 1
    builder.last = value
    value
}

finish: (builder) => {
    result: []
    level: builder.highest
    while(level >= 0) {
        if(builder.chunks.containsKey(level)) {
            result = Array(...result, ...builder.chunks[level])
        }
        level = level - 1
    }
    result
}

// A synthetic BOM is consumed by the ordinary decoder. Any supplied U+FEFF
// follows it and therefore survives, even at the beginning of a fragment.
text: () => { Encoding.UTF8.encode("\u{feff}") }

scalar: (output, value) => {
    if(value < 128) { output.add(value) }
    if((value >= 128) && (value < 2048)) {
        output.add(192 + value.div(64))
        output.add(128 + value % 64)
    }
    if((value >= 2048) && (value < 65536)) {
        output.add(224 + value.div(4096))
        output.add(128 + value.div(64) % 64)
        output.add(128 + value % 64)
    }
    if(value >= 65536) {
        output.add(240 + value.div(262144))
        output.add(128 + value.div(4096) % 64)
        output.add(128 + value.div(64) % 64)
        output.add(128 + value % 64)
    }
    output
}

append: (output, value) => {
    for(octet in Encoding.UTF8.encode(value)) { output.add(octet) }
    output
}

string: (output) => { Encoding.UTF8.decode(output) }
