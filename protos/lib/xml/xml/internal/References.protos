//! Incremental one-pass references never re-enter the markup grammar.
create: (errors, characters, limits) => {
    {
        decoder: (bounds, opening) => {
            length: 1
            mode: "first"
            radix: 10
            value: 0
            digits: 0
            named: ""
            {
                charge: (position) => { length = length + 1; limits.check(bounds, "maxTokenScalars", length, position) }
                accept: (c) => {
                    result: null
                    handled: false
                    if(c == 59) {
                        handled = true
                        if(mode == "named") {
                            if(named == "amp") { result = 38 }
                            if(named == "lt") { result = 60 }
                            if(named == "gt") { result = 62 }
                            if(named == "apos") { result = 39 }
                            if(named == "quot") { result = 34 }
                            if(result === null) { errors.syntax(opening) }
                        }
                        if(mode != "named") {
                            if((digits == 0) || !characters.char(value)) { errors.syntax(opening) }
                            result = value
                        }
                    }
                    if(!handled && (mode == "first")) {
                        if(c == 35) { mode = "numeric"; handled = true }
                        if(c != 35) { mode = "named" }
                    }
                    if(!handled && (mode == "named")) {
                        handled = true
                        // All admitted names are at most four ASCII letters.
                        if((named.size() >= 4) || !(((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)))) { errors.syntax(opening) }
                        limits.check(bounds, "maxNameScalars", named.size() + 1, opening + length - 1)
                        letters: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                        index: c - 65
                        if(c >= 97) { index = c - 97 + 26 }
                        named = named.concat(letters[index])
                    }
                    if(!handled && (mode == "numeric")) {
                        mode = "digits"
                        if(c == 120) { radix = 16; handled = true }
                    }
                    if(!handled) {
                        digit: characters.digit(c, radix)
                        if(digit < 0) { errors.syntax(opening) }
                        if(value > (1114111 - digit).div(radix)) { errors.syntax(opening) }
                        value = value * radix + digit
                        digits = digits + 1
                    }
                    result
                }
            }
        }
    }
}
