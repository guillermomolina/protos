//! One active binding table with per-element undo chains, shared by both kernels.
create: (errors, characters, records) => {
    xmlURI: "http://www.w3.org/XML/1998/namespace"
    xmlnsURI: "http://www.w3.org/2000/xmlns/"
    {
        scope: () => {
            active: Map()
            active["xml"] = xmlURI
            key: (prefix) => { result: ""; if(prefix !== null) { result = prefix }; result }
            resolveName: (lexical, attribute, position) => {
                parts: characters.qName(lexical)
                if(parts === null) { errors.namespace(position) }
                prefix: parts.prefix
                if((prefix == "xmlns") || ((prefix === null) && attribute && (parts.localName == "xmlns"))) { errors.namespace(position) }
                uri: null
                if(prefix !== null) {
                    if(!active.containsKey(prefix)) { errors.namespace(position) }
                    uri = active[prefix]
                    if(uri === null) { errors.namespace(position) }
                }
                if((prefix === null) && !attribute && active.containsKey("")) { uri = active[""] }
                records.makeName(uri, parts.localName, prefix)
            }
            lexicalName: (expanded) => {
                result: expanded.localName
                if(expanded.prefix !== null) { result = expanded.prefix.concat(":", expanded.localName) }
                result
            }
            validateName: (expanded, attribute, position) => {
                actual: resolveName(lexicalName(expanded), attribute, position)
                if((actual.namespaceURI != expanded.namespaceURI) || (actual.localName != expanded.localName)) { errors.namespace(position) }
            }
            {
                enter: (declarations, position) => {
                    seen: Map()
                    undo: null
                    for(binding in declarations) {
                        prefix: binding.prefix
                        uri: binding.namespaceURI
                        slot: key(prefix)
                        if(seen.containsKey(slot)) { errors.namespace(position) }
                        seen[slot] = true
                        if((prefix == "xmlns") || (uri == xmlnsURI)) { errors.namespace(position) }
                        if((prefix == "xml") && (uri != xmlURI)) { errors.namespace(position) }
                        if((prefix != "xml") && (uri == xmlURI)) { errors.namespace(position) }
                        if((prefix !== null) && (uri === null)) { errors.namespace(position) }
                        previous: null
                        present: active.containsKey(slot)
                        if(present) { previous = active[slot] }
                        wasPresent: present; savedValue: previous
                        undo = { key: slot; present: wasPresent; previous: savedValue; next: undo }
                        active[slot] = uri
                    }
                    undo
                }
                leave: (restoration) => {
                    cursor: restoration
                    while(cursor !== null) {
                        if(cursor.present) { active[cursor.key] = cursor.previous }
                        if(!cursor.present) { active.remove(cursor.key) }
                        cursor = cursor.next
                    }
                }
                resolve: (spelling, ordinary, position) => { resolveName(spelling, ordinary, position) }
                lexical: (expanded) => { lexicalName(expanded) }
                checkName: (expanded, ordinary, position) => { validateName(expanded, ordinary, position) }
                attributes: (attributes, position) => {
                    buckets: Map()
                    for(attribute in attributes) {
                        validateName(attribute.name, true, position)
                        uri: attribute.name.namespaceURI
                        if(!buckets.containsKey(uri)) { buckets[uri] = Map() }
                        bucket: buckets[uri]
                        local: attribute.name.localName
                        if(bucket.containsKey(local)) { errors.namespace(position) }
                        bucket[local] = true
                    }
                }
            }
        }
    }
}
