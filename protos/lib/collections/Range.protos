//! Bounded half-open iteration over ordinary unbounded Integer values.

/// Visits each Integer in [start, stop) in ascending unit order.
each: (start, stop, block) => {
    start.div(1)
    stop.div(1)

    current: start

    (() => current < stop).while() {
        block(current)
        current = current + 1
    }

    null
}

/// Visits each Integer in [start, stop) in descending unit order.
reverseEach: (start, stop, block) => {
    start.div(1)
    stop.div(1)

    current: stop

    (() => current > start).while() {
        current = current - 1
        block(current)
    }

    null
}
