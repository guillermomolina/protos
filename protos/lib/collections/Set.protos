//! Sets represented as ordinary Maps keyed by their members (ordinary `hash` plus `==`
//! key equality).

/// Answers a fresh Set containing `elements`.
call: (...elements) => {
    result: Map()
    elements.each((element) => {
        result[element] = true
    })
    result
}

/// Answers whether `element` is a member of `set`.
contains: (set, element) => {
    set.containsKey(element)
}

/// Answers the number of members of `set`.
size: (set) => {
    set.size()
}

/// Adds `element` to `set` in place and answers `set`.
add: (set, element) => {
    set[element] = true
    set
}

/// Removes `element` from `set` in place and answers `set`.
remove: (set, element) => {
    set.remove(element)
    set
}

/// Calls `block(element)` for each member of `set` and answers `set`.
each: (set, block) => {
    set.each((element, marker) => {
        block(element)
    })
    set
}

/// Answers a fresh Set of the members of `left` or `right`.
union: (left, right) => {
    result: Map()
    left.each((element, marker) => {
        result[element] = true
    })
    right.each((element, marker) => {
        result[element] = true
    })
    result
}

/// Answers a fresh Set of the members of `left` that are also in `right`.
intersection: (left, right) => {
    result: Map()
    left.each((element, marker) => {
        right.containsKey(element).ifTrue(() => {
            result[element] = true
        })
    })
    result
}

/// Answers a fresh Set of the members of `left` that are not in `right`.
difference: (left, right) => {
    result: Map()
    left.each((element, marker) => {
        right.containsKey(element).ifFalse(() => {
            result[element] = true
        })
    })
    result
}

/// Answers whether `left` and `right` have exactly the same members.
sameMembers: (left, right) => {
    (left.size() == right.size()).ifFalse(() => {
        ^false
    })
    left.each((element, marker) => {
        right.containsKey(element).ifFalse(() => {
            ^false
        })
    })
    true
}

/// Answers whether every member of `left` is a member of `right`.
isSubset: (left, right) => {
    left.each((element, marker) => {
        right.containsKey(element).ifFalse(() => {
            ^false
        })
    })
    true
}

/// Answers whether every member of `right` is a member of `left`.
isSuperset: (left, right) => {
    right.each((element, marker) => {
        left.containsKey(element).ifFalse(() => {
            ^false
        })
    })
    true
}

/// Answers whether `left` and `right` have no member in common.
isDisjoint: (left, right) => {
    left.each((element, marker) => {
        right.containsKey(element).ifTrue(() => {
            ^false
        })
    })
    true
}
