//! Sequential and isolated-parallel algorithms over ordinary Arrays.

/// Answers a fresh Array whose element `i` is `transform(array[i])`, applied to a
/// snapshot of `array` in ascending index order.
map: (array, transform) => {
    snapshot: Array(...array)
    result: Array(...snapshot)
    index: 0
    snapshot.each((element) => {
        result[index] = transform(element)
        index = index + 1
    })
    result
}

/// Answers a fresh Array of the elements of a snapshot of `array` for which
/// `predicate(element)` answers `true`, keeping source order. A result other
/// than canonical `true` or `false` signals `InvalidPredicateResult`.
filter: (array, predicate) => {
    snapshot: Array(...array)

    filterRange: (start, end) => {
        length: end - start
        result: null

        if(length == 0) {
            result = Array()
        }

        if(length == 1) {
            element: snapshot[start]
            decision: predicate(element)

            if(decision === true) {
                result = Array(element)
            }
            (decision === true).ifFalse(() => {
                if(decision === false) {
                    result = Array()
                }
                (decision === false).ifFalse(() => {
                    InvalidPredicateResult().signal()
                })
            })
        }

        if(length > 1) {
            middle: start + length.div(2)
            left: filterRange(start, middle)
            right: filterRange(middle, end)
            result = Array(...left, ...right)
        }

        result
    }

    filterRange(0, snapshot.size())
}

/// Answers the lowest index of a snapshot of `array` whose element satisfies
/// `predicate(element)`, or `null` when none does. Elements are tested in
/// ascending order; a result other than canonical `true` or `false` signals
/// `InvalidPredicateResult`.
findIndex: (array, predicate) => {
    snapshot: Array(...array)
    index: 0

    snapshot.each((element) => {
        decision: predicate(element)

        if(decision === true) {
            ^index
        }
        (decision === false).ifFalse(() => {
            InvalidPredicateResult().signal()
        })

        index = index + 1
    })

    null
}

/// Folds a snapshot of `array` left to right with `reducer(accumulator, element)`.
/// An optional single `initial` value seeds the fold; without one, the first
/// element does, and an empty Array answers `null`. More than one initial
/// value signals an Error.
reduce: (array, reducer, ...initial) => {
    snapshot: Array(...array)
    initialSize: initial.size()

    if(initialSize > 1) {
        Error().signal()
    }

    snapshotSize: snapshot.size()
    accumulator: null

    if(initialSize == 1) {
        accumulator = initial[0]
    }

    if(initialSize == 0) {
        if(snapshotSize == 0) {
            ^null
        }
        accumulator = snapshot[0]
    }

    foldRange: (start, end) => {
        length: end - start

        if(length == 1) {
            accumulator = reducer(accumulator, snapshot[start])
        }

        if(length > 1) {
            middle: start + length.div(2)
            foldRange(start, middle)
            foldRange(middle, end)
        }
    }

    foldRange(1 - initialSize, snapshotSize)
    accumulator
}

/// Answers a fresh Array with the elements of a snapshot of `array` stably sorted
/// by `less(left, right)`. A comparator result other than canonical `true` or
/// `false` signals `InvalidComparatorResult`, and two elements each less than
/// the other signal `InvalidComparatorOrder`. The source is not mutated.
/// When `less` is omitted it defaults to `(left, right) => left < right`, the
/// ordinary `<` protocol of the elements; that default defines no total order
/// over arbitrary values, so elements whose `<` fails or answers a non-Boolean
/// signal exactly as with an explicit comparator. An explicit `null` is an
/// ordinary comparator argument and does not select the default.
sort: (array, less: (left, right) => left < right) => {
    snapshot: Array(...array)

    merge: (left, right) => {
        result: Array(...left, ...right)
        leftSize: left.size()
        rightSize: right.size()
        leftIndex: 0
        rightIndex: 0
        mergeRange: (start, end) => {
            length: end - start

            if(length == 1) {
                leftDone: leftIndex == leftSize
                rightDone: rightIndex == rightSize

                if(leftDone) {
                    result[start] = right[rightIndex]
                    rightIndex = rightIndex + 1
                }

                leftDone.ifFalse(() => {
                    if(rightDone) {
                        result[start] = left[leftIndex]
                        leftIndex = leftIndex + 1
                    }

                    rightDone.ifFalse(() => {
                        leftValue: left[leftIndex]
                        rightValue: right[rightIndex]
                        lr: less(leftValue, rightValue)

                        (lr === true).ifFalse(() => {
                            (lr === false).ifFalse(() => {
                                InvalidComparatorResult().signal()
                            })
                        })

                        rl: less(rightValue, leftValue)

                        (rl === true).ifFalse(() => {
                            (rl === false).ifFalse(() => {
                                InvalidComparatorResult().signal()
                            })
                        })

                        if(lr === true) {
                            if(rl === true) {
                                InvalidComparatorOrder().signal()
                            }
                            result[start] = leftValue
                            leftIndex = leftIndex + 1
                        }

                        if(lr === false) {
                            if(rl === true) {
                                result[start] = rightValue
                                rightIndex = rightIndex + 1
                            }
                            if(rl === false) {
                                result[start] = leftValue
                                leftIndex = leftIndex + 1
                            }
                        }
                    })
                })
            }

            if(length > 1) {
                middle: start + length.div(2)
                mergeRange(start, middle)
                mergeRange(middle, end)
            }

            null
        }

        mergeRange(0, result.size())
        result
    }

    sortRange: (start, end) => {
        length: end - start
        result: null

        if(length == 0) {
            result = Array()
        }

        if(length == 1) {
            result = Array(snapshot[start])
        }

        if(length > 1) {
            middle: start + length.div(2)
            left: sortRange(start, middle)
            right: sortRange(middle, end)
            result = merge(left, right)
        }

        result
    }

    sortRange(0, snapshot.size())
}

/// Answers a fresh open Array holding the elements of `array` followed by
/// `value` as one single element, even when `value` is itself an Array. The
/// copy is shallow and `array` is not mutated. A non-Array `array` (one that
/// `Array.recognizes` rejects) signals an Error.
append: (array, value) => {
    Array.recognizes(array).ifFalse(() => {
        Error().signal()
    })
    Array(...array, value)
}

/// Answers a fresh open Array holding the elements of `left` followed by the
/// elements of `right`, flattened exactly one level. The copy is shallow,
/// neither operand is mutated, and the result never shares indexed storage
/// with either operand, even when both are the same Array or both are empty.
/// An operand that `Array.recognizes` rejects signals an Error.
concat: (left, right) => {
    Array.recognizes(left).ifFalse(() => {
        Error().signal()
    })
    Array.recognizes(right).ifFalse(() => {
        Error().signal()
    })
    Array(...left, ...right)
}

/// Answers a fresh open Array holding the elements of a shallow snapshot of
/// `array` at the half-open index range `[start, end)`. `start` and `end` must
/// be Integers with `0 <= start <= end <= size`; anything else, including a
/// Float, a negative bound, or an arbitrarily large Integer, signals an Error
/// without numeric conversion. The result is never a view or an alias of
/// `array`, even for the full or an empty range.
slice: (array, start, end) => {
    Array.recognizes(array).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(start).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(end).ifFalse(() => {
        Error().signal()
    })

    snapshot: Array(...array)
    size: snapshot.size()

    (((0 <= start) && (start <= end)) && (end <= size)).ifFalse(() => {
        Error().signal()
    })

    // Answers a fresh Array of `count` null placeholders in O(count).
    sized: null
    sized = (count) => {
        result: Array()
        if(count > 0) {
            half: sized(count.div(2))
            result = Array(...half, ...half)
            if((count % 2) == 1) {
                result = Array(...result, null)
            }
        }
        result
    }

    count: end - start
    result: sized(count)
    index: 0
    while(index < count) {
        result[index] = snapshot[start + index]
        index = index + 1
    }
    result
}

/// Answers a fresh open Array holding the elements of `array` with `value`
/// inserted as one single element at `index`, shifting later elements one
/// position up. `index` must be an Integer with `0 <= index <= size`; `size`
/// itself appends. Anything else signals an Error before any element is moved.
/// The copy is shallow and `array` is not mutated.
insertAt: (array, index, value) => {
    Array.recognizes(array).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(index).ifFalse(() => {
        Error().signal()
    })

    result: Array(...array, value)
    n: result.size() - 1

    ((0 <= index) && (index <= n)).ifFalse(() => {
        Error().signal()
    })

    // Shift the suffix from the end so no pending element is overwritten.
    position: n
    while(position > index) {
        result[position] = result[position - 1]
        position = position - 1
    }
    result[index] = value
    result
}

/// Answers a fresh open Array holding the elements of a shallow snapshot of
/// `array` without the element at `index`, keeping the order and identity of
/// the remaining elements. `index` must be an Integer with
/// `0 <= index < size`; anything else, including any index of an empty Array,
/// signals an Error. `array` is not mutated. Unlike `Bytes.removeAt`, this
/// answers a new Array rather than editing a receiver.
removeAt: (array, index) => {
    Array.recognizes(array).ifFalse(() => {
        Error().signal()
    })
    Integer.recognizes(index).ifFalse(() => {
        Error().signal()
    })

    snapshot: Array(...array)
    n: snapshot.size()

    ((0 <= index) && (index < n)).ifFalse(() => {
        Error().signal()
    })

    // Answers a fresh Array of `count` null placeholders in O(count).
    sized: null
    sized = (count) => {
        result: Array()
        if(count > 0) {
            half: sized(count.div(2))
            result = Array(...half, ...half)
            if((count % 2) == 1) {
                result = Array(...result, null)
            }
        }
        result
    }

    result: sized(n - 1)
    target: 0
    while(target < (n - 1)) {
        source: target
        if(target >= index) {
            source = target + 1
        }
        result[target] = snapshot[source]
        target = target + 1
    }
    result
}

/// Answers a fresh open Array holding the elements of `array` in reverse
/// order. The copy is shallow, `array` is not mutated, and no comparator or
/// other callback is invoked.
reverse: (array) => {
    Array.recognizes(array).ifFalse(() => {
        Error().signal()
    })

    result: Array(...array)
    left: 0
    right: result.size() - 1
    while(left < right) {
        swap: result[left]
        result[left] = result[right]
        result[right] = swap
        left = left + 1
        right = right - 1
    }
    result
}

// Parallel algorithms (D160): Standard Library policy composed only from the
// public isolated-parallel substrate (`Closure.parallel`, `Future`,
// `Future.all`, `ensure`). Every callback runs in isolated P, so it cannot
// capture caller state; explicit trailing `arguments` are the supported way to
// pass data to it, and they cross P exactly like the elements do.
//
// A non-empty call first submits P snapshots of the source elements, the
// callback, and the arguments. That synchronous submission is the input
// snapshot point and signals `NonParallelValue` before any Future is returned.
// Each logical callback invocation then runs in its own isolated P child owned
// by the operation's result Future. Cancelling the result Future cancels
// unfinished children. Failure selection never depends on worker timing.
//
// Arrays, Errors, and other results are always assembled in the caller domain
// and only cross P: P children run nothing but the user callback, and their
// raw outcomes are validated in the caller in ascending index order.

/// Answers a Future of a fresh Array whose element `i` is
/// `worker(array[i], arguments...)`, evaluated in isolated parallel execution.
/// Results keep source order; the lowest failing index supplies the failure.
parallelMap: (array, worker, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, worker, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            Future.all(...children).value()
        }).ensure(() => {
            input.cancel()
            children.each((child) => {
                child.cancel()
            })
        })
    }).future()
}

/// Answers a Future of a fresh Array of the elements for which
/// `predicate(element, arguments...)`, evaluated in isolated parallel
/// execution, answers `true`. Selection keeps source order. Outcomes are
/// examined in ascending index order, so the lowest index whose predicate
/// fails or answers something other than canonical `true` or `false`
/// (`InvalidPredicateResult`) supplies the failure.
parallelFilter: (array, predicate, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, predicate, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            index: 0
            filter(parts[0], (element) => {
                decision: children[index].value()
                index = index + 1
                decision
            })
        }).ensure(() => {
            input.cancel()
            children.each((child) => {
                child.cancel()
            })
        })
    }).future()
}

/// Answers a Future of the lowest index whose element satisfies
/// `predicate(element, arguments...)`, evaluated in isolated parallel
/// execution, or `null` when none does. Indexes are decided in ascending
/// logical order: a failure or non-Boolean result (`InvalidPredicateResult`)
/// at a lower index defeats a later match, and work at higher indexes is
/// cancelled once the outcome is decided.
parallelFindIndex: (array, predicate, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { null }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, predicate, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            findIndex(children, (child) => {
                child.value()
            })
        }).ensure(() => {
            input.cancel()
            children.each((child) => {
                child.cancel()
            })
        })
    }).future()
}

/// Answers a Future of the reduction of the elements with
/// `reducer(left, right, arguments...)`, or `null` for an empty Array. Each
/// round combines adjacent pairs (0,1), (2,3), ... left to right in isolated
/// parallel execution and carries an odd final value unchanged, so the
/// parenthesization is fixed and a non-associative reducer stays
/// deterministic. Within a round the leftmost failing pair supplies the
/// failure, and no later round starts after a failure.
parallelReduce: (array, reducer, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { null }).future()
    }

    // Groups one round's values into adjacent pairs, ending with a singleton
    // when the round has an odd final value.
    pairs: (values) => {
        size: values.size()

        pairRange: (start, end) => {
            length: end - start
            result: null

            if(length == 1) {
                position: start * 2
                result = Array(Array(values[position]))
                if(position + 1 < size) {
                    result = Array(Array(values[position], values[position + 1]))
                }
            }

            if(length > 1) {
                middle: start + length.div(2)
                result = Array(...pairRange(start, middle), ...pairRange(middle, end))
            }

            result
        }

        pairRange(0, size.div(2) + size.mod(2))
    }

    combine: (pair, callback, ...extra) => {
        result: pair[0]

        if(pair.size() == 2) {
            result = callback(pair[0], pair[1], ...extra)
        }

        result
    }

    round: parallelMap(pairs(snapshot), combine, reducer, ...arguments)

    (() => {
        (() => {
            values: round.value()

            while(values.size() > 1) {
                round = parallelMap(pairs(values), combine, reducer, ...arguments)
                values = round.value()
            }

            values[0]
        }).ensure(() => {
            round.cancel()
        })
    }).future()
}

/// Answers a Future of a fresh Array with the elements stably sorted by
/// `less(left, right, arguments...)`. The result, comparator invocation order,
/// and failures are exactly those of `sort` with the comparator
/// `(left, right) => less(left, right, arguments...)`, except that every
/// comparator invocation runs in its own isolated parallel execution. The
/// source Array is not mutated.
parallelSort: (array, less, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, less, arguments))

    compare: (left, right, comparator, extra) => {
        comparator(left, right, ...extra)
    }

    (() => {
        parts: input.value()
        sort(parts[0], (left, right) => {
            compare.parallel(left, right, parts[1], parts[2]).value()
        })
    }).future()
}
