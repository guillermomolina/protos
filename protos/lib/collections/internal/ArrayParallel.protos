//! Private Array parallel algorithms.

parallelMap: (map, array, worker, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, worker, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            Future.all(...children).value()
        }).ensure(() => {
            input.cancel()
            for(child in children) {
                child.cancel()
            }
        })
    }).future()
}

parallelFilter: (map, filter, array, predicate, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, predicate, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            index: 0
            filter(parts[0], (element) => {
                decision: children[index].value()
                index = index + 1
                decision
            })
        }).ensure(() => {
            input.cancel()
            for(child in children) {
                child.cancel()
            }
        })
    }).future()
}

parallelFindIndex: (map, findIndex, array, predicate, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { null }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, predicate, arguments))

    apply: (element, callback, extra) => {
        callback(element, ...extra)
    }

    (() => {
        children: Array()

        (() => {
            parts: input.value()
            children = map(parts[0], (element) => {
                apply.parallel(element, parts[1], parts[2])
            })
            findIndex(children, (child) => {
                child.value()
            })
        }).ensure(() => {
            input.cancel()
            for(child in children) {
                child.cancel()
            }
        })
    }).future()
}

parallelReduce: (parallelMap, array, reducer, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { null }).future()
    }

    // Groups one round's values into adjacent pairs, ending with a singleton
    // when the round has an odd final value.
    pairs: (values) => {
        size: values.size()

        pairRange: (start, end) => {
            length: end - start
            result: null

            if(length == 1) {
                position: start * 2
                result = Array(Array(values[position]))
                if(position + 1 < size) {
                    result = Array(Array(values[position], values[position + 1]))
                }
            }

            if(length > 1) {
                middle: start + length.div(2)
                result = Array(...pairRange(start, middle), ...pairRange(middle, end))
            }

            result
        }

        pairRange(0, size.div(2) + size.mod(2))
    }

    combine: (pair, callback, ...extra) => {
        result: pair[0]

        if(pair.size() == 2) {
            result = callback(pair[0], pair[1], ...extra)
        }

        result
    }

    round: parallelMap(pairs(snapshot), combine, reducer, ...arguments)

    (() => {
        (() => {
            values: round.value()

            while(values.size() > 1) {
                round = parallelMap(pairs(values), combine, reducer, ...arguments)
                values = round.value()
            }

            values[0]
        }).ensure(() => {
            round.cancel()
        })
    }).future()
}

parallelSort: (sort, array, less, ...arguments) => {
    snapshot: Array(...array)

    if(snapshot.size() == 0) {
        ^(() => { Array() }).future()
    }

    input: ((bundle) => {
        bundle
    }).parallel(Array(snapshot, less, arguments))

    compare: (left, right, comparator, extra) => {
        comparator(left, right, ...extra)
    }

    (() => {
        parts: input.value()
        sort(parts[0], (left, right) => {
            compare.parallel(left, right, parts[1], parts[2]).value()
        })
    }).future()
}
