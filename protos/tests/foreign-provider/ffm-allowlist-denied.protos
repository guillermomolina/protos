// Default-off native library authorization: the distributable protos-ffm
// provider is registered with --foreign-provider-path but the host gives no
// --allow-library option. Provider presence authorizes no library, sqlite3
// included, even when the library exists on the host.
// Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/assertions")

unauthorized: (body) => {
    error: Assertions.signals(ForeignError, body)
    Assertions.require(error.foreignCategory == "unauthorized-library")
}

// std:ffi imports and declares without activating any library.
FFI: import("std:ffi")
Assertions.require(FFI.out(FFI.i32) !== null)

// The provider's presence does not authorize sqlite3 or any other valid alias.
unauthorized(() => import("ffi:sqlite3"))
unauthorized(() => import("ffi:libc"))
unauthorized(() => import("ffi:not_listed"))

// File names and paths are not aliases: ordinary import failure, no native load.
invalidImport: (body) => {
    error: Assertions.signals(Error, body)
    Assertions.require(error.parent() !== ForeignError)
}
invalidImport(() => import("ffi:libsqlite3.so.0"))
invalidImport(() => import("ffi:/usr/lib/x86_64-linux-gnu/libsqlite3.so.0"))
invalidImport(() => import("ffi:./libsqlite3.so.0"))

// The Standard Library facade over SQLite cannot use it either.
SQLite: import("std:sqlite")
Assertions.signals(Error, () => SQLite.openMemory())

print("FFM-ALLOWLIST-DENIED-PASS")
