// RootActor-only native FFM authority with a real secondary Actor. The host
// authorizes first=<absolute libffi_test.so> (and second, unused here).
// Run by dist/test_external_foreign_providers.py and dist/validate_native.py.

Assertions: import("std:test/assertions")
FFI: import("std:ffi")

// Spawned before the RootActor acquires any native library.
worker: Actor.spawn("./ffm-root-actor-worker.protos", "worker")
(() => {
    Assertions.require(worker.request("layoutSize").value() == 16)
    Assertions.require(worker.request("nativeImportRefused").value() == true)

    first: import("ffi:first")
    identity: FFI.bind(first, "ffi_test_i32_identity", FFI.i32, Array(FFI.i32))
    calls: FFI.bind(first, "ffi_test_scalar_calls_count", FFI.i32, Array())
    Assertions.require(identity(41) == 41)

    before: calls()
    Assertions.require(worker.request("nativeImportRefused").value() == true)
    Assertions.require(calls() == before)
    Assertions.require(identity(42) == 42)

    // Native authority never crosses an Actor boundary.
    Assertions.signals(NonTransferableValue, () => worker.request("echo", first))
    raw: first.bind("ffi_test_i32_identity", first.param(first.signature(first.i32), first.i32))
    Assertions.signals(NonTransferableValue, () => worker.request("echo", raw))
    // An ordinary Closure capturing live foreign authority is not transferable either.
    Assertions.signals(NonTransferableValue, () => worker.request("echo", identity))
    // Ordinary results remain transferable.
    Assertions.require(worker.request("echo", identity(7)).value() == 7)
    Assertions.require(worker.request("layoutSize").value() == 16)
    Assertions.require(identity(43) == 43)
}).ensure(() => worker.stop())

print("FFM-ROOT-ACTOR-PASS")
