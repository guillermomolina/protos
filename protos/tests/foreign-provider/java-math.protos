// I085-B: the real JDK java.lang.Math through the external java: provider.
// Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/Assertions")

Math: import("java:math")

Assertions.require(Math.abs(-42) == 42)
Assertions.require(Math.abs(42) == 42)
Assertions.require(Math.max(7, 15) == 15)
Assertions.require(Math.max(-7, -15) == -7)
Assertions.require(import("java:math") === Math)

// I088-A: the provider owns java:, and jdk: is not an alias for it.
Assertions.signals(Error, () => import("jdk:math"))

// Incompatible arguments: wrong kind, inexact conversion, wrong arity.
Assertions.signals(Error, () => Math.abs("42"))
Assertions.signals(Error, () => Math.abs(1.5))
Assertions.signals(Error, () => Math.abs(9223372036854775808))
Assertions.signals(Error, () => Math.max(1))

print("I085-B-JAVA-MATH-PASS")
