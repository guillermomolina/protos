// Deterministic private-adapter lifetime/order and NULL/allocation failures.
// The production Borrowed source is loaded by ProtosLib029SqliteLifecycleTest.
Assertions: import("std:test/assertions")
data: Array()
reported: 0
nullPointer: false
errorCode: 0
phase: 0
copies: 0
region: {}
library: {
    i32: {}
    borrowed: {}
    opaque: (name) => name
    signature: (returns) => {
        { preserves: false }
    }
    param: (signature, parameter) => signature
    preserving: (signature) => {
        signature.preserves = true
        signature
    }
    bind: (symbol, signature) => {
        if((symbol == "sqlite3_column_text") || (symbol == "sqlite3_column_blob")) {
            Assertions.require(signature.preserves === false)
            ^(statement, index) => {
                phase = 1
                if(nullPointer) { null } else { region }
            }
        }
        if(symbol == "sqlite3_column_bytes") {
            Assertions.require(signature.preserves)
            ^(statement, index) => {
                Assertions.require(phase == 1)
                phase = 2
                reported
            }
        }
        Assertions.require(symbol == "sqlite3_errcode")
        Assertions.require(signature.preserves)
        (connection) => {
            Assertions.require(phase == 1)
            errorCode
        }
    }
    copy: (pointer, count) => {
        Assertions.require(phase == 2)
        Assertions.require(pointer === region)
        Assertions.require(count == data.size())
        copies = copies + 1
        phase = 3
        Array(...data)
    }
}
read: columnReader(library)
fault: Error()
fail: (code) => fault
configure: (bytes, isNull, length, code) => {
    data = bytes
    nullPointer = isNull
    reported = length
    errorCode = code
    phase = 0
}
configure(Array(97, 0, 98), false, 3, 0)
Assertions.require(read(null, null, 0, true, fail) == "a\u{0}b")
configure(Array(0, 255), false, 2, 0)
blob: read(null, null, 0, false, fail)
Assertions.require((blob[0] == 0) && (blob[1] == 255))
configure(Array(), true, 0, 0)
empty: read(null, null, 0, false, fail)
Assertions.require((empty !== null) && (empty.size() == 0))
Assertions.require(blob[1] == 255)
before: copies
// NULL TEXT is a failed conversion, including SQLite's zero-length OOM case.
for(code in Array(0, 7)) {
    configure(Array(), true, 0, code)
    Assertions.require(Assertions.signals(Error, () => read(null, null, 0, true, fail)) === fault)
}
// NULL empty BLOB is accepted only with a non-error connection status.
configure(Array(), true, 0, 7)
Assertions.require(Assertions.signals(Error, () => read(null, null, 0, false, fail)) === fault)
configure(Array(), true, 2, 0)
Assertions.require(Assertions.signals(Error, () => read(null, null, 0, false, fail)) === fault)
for(size in Array(-1, 16777217)) {
    configure(Array(), false, size, 0)
    Assertions.require(Assertions.signals(Error, () => read(null, null, 0, false, fail)) === fault)
}
Assertions.require(copies == before)
configure(Array(128), false, 1, 0)
Assertions.signals(Error, () => read(null, null, 0, true, fail))

configure(Array(239, 187, 191, 97), false, 4, 0)
Assertions.require(read(null, null, 0, true, fail) == "\u{FEFF}a")
configure(Array(239, 187, 191, 239, 187, 191), false, 6, 0)
Assertions.require(read(null, null, 0, true, fail) == "\u{FEFF}\u{FEFF}")

// LIB030 reuse: every read copies again inside its own accessor window; a
// result never aliases provider memory or an earlier result, so a later
// step/reset/close cannot change values already returned.
configure(Array(0, 7, 0), false, 3, 0)
copiesBefore: copies
again: read(null, null, 0, false, fail)
later: read(null, null, 0, false, fail)
Assertions.require(copies == (copiesBefore + 2))
Assertions.require(again !== later)
again[1] = 9
Assertions.require(later[1] == 7)
data[1] = 8
Assertions.require((later[1] == 7) && (again[1] == 9))
