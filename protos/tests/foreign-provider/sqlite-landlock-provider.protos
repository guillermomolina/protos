// PLAT074-B4 test-only operations; not a public durable SQLite API.
FFI: import("std:ffi")
native: import("ffi:sqlite3")
database: FFI.opaque(native, "sqlite3")
statement: FFI.opaque(native, "sqlite3_stmt")
ownedDatabase: FFI.owned(database, "sqlite3_close_v2", FFI.i32)
ownedStatement: FFI.owned(statement, "sqlite3_finalize", FFI.i32)
vfs: FFI.nullable(FFI.opaque(native, "sqlite3_vfs_name"))
// No producer exists for this pointer type: pzTail is always NULL. These
// harness-controlled single statements do NOT implement std:sqlite admission.
tail: FFI.nullable(FFI.opaque(native, "sqlite3_tail_pointer"))
bind: (symbol, returns, parameters) => FFI.bind(native, symbol, returns, parameters)
version: bind("sqlite3_libversion_number", FFI.i32, Array())
threadsafe: bind("sqlite3_threadsafe", FFI.i32, Array())
open: bind("sqlite3_open_v2", FFI.i32, Array(FFI.utf8z, FFI.out(ownedDatabase), FFI.i32, vfs))
compile: bind("sqlite3_prepare_v2", FFI.i32,
    Array(database, FFI.utf8z, FFI.i32, FFI.out(ownedStatement), tail))
step: bind("sqlite3_step", FFI.i32, Array(statement))
reset: bind("sqlite3_reset", FFI.i32, Array(statement))
bindInteger: bind("sqlite3_bind_int64", FFI.i32, Array(statement, FFI.i32, FFI.i64))
columnInteger: bind("sqlite3_column_int64", FFI.i64, Array(statement, FFI.i32))
errcode: bind("sqlite3_errcode", FFI.i32, Array(database))
getAutocommit: bind("sqlite3_get_autocommit", FFI.i32, Array(database))
busyTimeout: bind("sqlite3_busy_timeout", FFI.i32, Array(database, FFI.i32))

prepare: () => {
    connection: null
    pending: null
    retired: false
    requireOpen: () => {
        if(connection === null) { Error().signal() }
    }
    check: (code, expected) => {
        if(code != expected) { Error { code: code }.signal() }
        code
    }
    finish: () => {
        result: 0
        if(pending !== null) {
            handle: pending
            pending = null
            result = FFI.release(handle)
        }
        result
    }
    acquire: (path, flags) => {
        if((connection !== null) || retired) { Error().signal() }
        result: open(path, flags, null)
        handle: result[1]
        if(result[0] == 0) {
            if(handle === null) { Error().signal() }
            connection = handle
        } else {
            // Even an unsuccessful open may publish an owned connection.
            // The release result must not replace the original SQLite status.
            if(handle !== null) { FFI.release(handle) }
        }
        result[0]
    }
    compileHere: (sql) => {
        requireOpen()
        if(pending !== null) { Error().signal() }
        result: compile(connection, sql, -1, null)
        pending = result[1]
        result[0]
    }
    executeStatus: (sql) => {
        (() => {
            code: compileHere(sql)
            if((code == 0) && (pending !== null)) { code = step(pending) }
            code
        }).ensure(() => { finish() })
    }
    execute: (sql) => {
        code: executeStatus(sql)
        if((code != 100) && (code != 101)) { Error { code: code }.signal() }
        code
    }
    close: () => {
        // Retire guest state before any uncertain native destructor result.
        handle: connection
        connection = null
        (() => { finish() }).ensure(() => {
            if(handle !== null) { check(FFI.release(handle), 0) }
        })
        0
    }
    {
        version: () => version()
        threadsafe: () => threadsafe()
        openFile: (path) => acquire(path, 6)
        openReadOnly: (path) => acquire(path, 1)
        openMemory: () => acquire(":memory:", 6)
        execute: execute
        executeStatus: executeStatus
        // T6 separates preparation from the observed downcall. No other native
        // operation can occur between the host readiness latch and this step.
        prepareContendedInsert: () => check(compileHere("INSERT INTO t VALUES (2)"), 0)
        stepPreparedStatus: () => {
            requireOpen()
            if(pending === null) { Error().signal() }
            step(pending)
        }
        finalizePending: () => finish()
        publicMemory: publicMemory
        publicModule: () => SQLite
        queryInteger: (sql) => {
            (() => {
                check(compileHere(sql), 0)
                if(pending === null) { Error().signal() }
                check(step(pending), 100)
                // Copy while SQLITE_ROW is current, before the ensure finalizes.
                columnInteger(pending, 0)
            }).ensure(() => { finish() })
        }
        insertInteger: (value) => {
            (() => {
                check(compileHere("INSERT INTO t(value) VALUES (?)"), 0)
                check(bindInteger(pending, 1, value), 0)
                check(step(pending), 101)
                check(reset(pending), 0)
                101
            }).ensure(() => { finish() })
        }
        beginImmediate: () => execute("BEGIN IMMEDIATE")
        commit: () => execute("COMMIT")
        rollback: () => execute("ROLLBACK")
        setBusyTimeout: (milliseconds) => {
            requireOpen()
            busyTimeout(connection, milliseconds)
        }
        autocommit: () => {
            requireOpen()
            getAutocommit(connection)
        }
        errorCode: () => {
            requireOpen()
            errcode(connection)
        }
        close: close
        closeForSession: () => {
            finish()
            // Deliberately leave the connection in provider custody, with no
            // dependent statement. The owner next closes its existing session.
            connection = null
            retired = true
            0
        }
        isOpen: () => connection !== null
    }
}

// Resolve the public module before Landlock, then execute its existing API
// inside the restricted thread. Each close is observed through its terminal Future.
SQLite: import("std:sqlite")
// Diagnostic wrappers preserve the original failure as a private Error payload.
// The phase label identifies native/library work separately from cleanup failure.
publicAt: (phase, operation) => Error.handle(operation, (error) => {
    Error { phase: phase
        original: error }.signal()
})
publicMemory: () => {
    db: publicAt("openMemory", () => SQLite.openMemory())
    (() => {
        ddl: publicAt("create.prepare", () => db.prepare("CREATE TABLE t(value INTEGER)"))
        (() => {
            publicAt("create.step", () => ddl.step())
        }).ensure(() => { publicAt("create.close.value", () => ddl.close().value()) })
        insert: publicAt("insert.prepare", () => db.prepare("INSERT INTO t(value) VALUES (?)"))
        (() => {
            publicAt("insert.bind.i64", () => insert.bind(1, 9223372036854775806))
            publicAt("insert.step.first", () => insert.step())
            publicAt("insert.reset", () => insert.reset())
            publicAt("insert.bind.second", () => insert.bind(1, 41))
            publicAt("insert.step.second", () => insert.step())
        }).ensure(() => { publicAt("insert.close.value", () => insert.close().value()) })
        query: publicAt("query.prepare", () => db.prepare("SELECT value FROM t ORDER BY value DESC"))
        (() => {
            publicAt("query.step.first", () => query.step())
            first: publicAt("query.column.first", () => query.column(0))
            publicAt("query.step.second", () => query.step())
            second: publicAt("query.column.second", () => query.column(0))
            publicAt("query.reset", () => query.reset())
            publicAt("query.step.reset", () => query.step())
            Array(first, second, publicAt("query.column.reset", () => query.column(0)))
        }).ensure(() => { publicAt("query.close.value", () => query.close().value()) })
    }).ensure(() => { publicAt("connection.close.value", () => db.close().value()) })
}

// Preparation only: exercise the same diagnostic wrapper, exceptional epilogue
// and ensure unwind outside Landlock. The deliberately signalled Error is caught;
// this neither opens a database nor substitutes for T7's restricted operations.
warmPublicErrorPath: () => {
    observed: false
    Error.handle(() => {
        publicAt("warmup.error", () => {
            (() => Error().signal()).ensure(() => null)
        })
    }, (error) => { observed = true })
    observed
}

// A caught guest Error does not reach terminal diagnostic projection. Let this
// preparation-only error reach the host, which must assert FAILED explicitly.
warmPublicTerminalError: () => publicAt("warmup.terminal", () => {
    (() => Error().signal()).ensure(() => null)
})

{ prepare: prepare
  publicMemory: publicMemory
  warmPublicErrorPath: warmPublicErrorPath
  warmPublicTerminalError: warmPublicTerminalError }
