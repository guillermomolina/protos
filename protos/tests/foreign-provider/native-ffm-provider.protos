// I085-B: an external provider calling the real C library strlen through the
// JDK Foreign Function and Memory API. Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/Assertions")

libc: import("oslib:libc")

Assertions.require(libc.strlen("protos") == 6)
Assertions.require(libc.strlen("") == 0)

print("I085-B-FFM-PASS")
