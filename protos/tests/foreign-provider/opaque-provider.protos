// I085-B: an external Java provider with opaque handles, loaded from a JAR
// outside the portable distribution. Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/Assertions")

lib: import("inventado:demo")

Assertions.require(lib.double(21) == 42)
Assertions.require(import("inventado:demo") === lib)

print("I085-B-OPAQUE-PASS")
