// By-value struct and union arguments and returns, group out positions and
// their independently owned result roots, against real C functions. The host
// authorizes:
//   first=<absolute libffi_test.so>    (native/ffi_test.c)
//   second=<absolute libffi_second.so> (native/ffi_second.c)
// Every exercised group signature is registered for Native Image, so this
// program runs on the JVM and under Native Image alike. Run by
// ProtosI144FfmFixtureAbiTest, dist/test_external_foreign_providers.py,
// scripts/native-test.sh and dist/validate_native.py.

FFI: import("std:ffi")
Arrays: import("std:collections/array")

CheckFailure: Error {}

check: (label, condition) => {
    (condition === true).ifFalse(() => {
        failure: CheckFailure { label: label }
        failure.signal()
    })
    null
}

caught: (prototype, body) => {
    result: null
    prototype.handle(body, (error) => {
        result = error
        error
    })
    result
}

/// The ordinary pre-entry Error, never a ForeignError.
ordinary: (label, body) => {
    error: caught(Error, body)
    check(label, (error === null) == false)
    check(label + " is ordinary", error.parent() === Error)
}

/// A ForeignError signalled after entry.
foreign: (label, body) => {
    error: caught(ForeignError, body)
    check(label, (error === null) == false)
}

// Every octet of a region, as an ordinary Array of Integers.
octets: (region, length) => {
    view: FFI.slice(region, 0, length)
    answer: Array()
    index: 0
    while(index < length) {
        answer = Arrays.append(answer, view[index])
        index = index + 1
    }
    answer
}

sameOctets: (left, right) => {
    if((left.size() == right.size()) == false) { ^false }
    index: 0
    while(index < left.size()) {
        if((left[index] == right[index]) == false) { ^false }
        index = index + 1
    }
    true
}

// ---- group layouts, each declared independently in Protos

field: FFI.field
Inner: FFI.struct(Array(field("a", FFI.i32), field("b", FFI.f64)))
Large: FFI.struct(Array(field("x", FFI.i64), field("y", FFI.i64), field("z", FFI.i64)))
Choice: FFI.union(Array(field("integer", FFI.i64), field("real", FFI.f64)))
PaddedUnion: FFI.union(Array(field("wide", FFI.i64), field("bytes", FFI.array(FFI.u8, 9))))
Outer: FFI.struct(Array(
    field("tag", FFI.u8),
    field("inner", Inner),
    field("values", FFI.array(FFI.i16, 3)),
    field("next", FFI.nullable(FFI.pointer(Inner)))))
Nested: FFI.struct(Array(field("choice", Choice), field("ratios", FFI.array(FFI.f32, 2))))
// Structurally identical to Inner, but a distinct layout identity.
Twin: FFI.struct(Array(field("a", FFI.i32), field("b", FFI.f64)))

// ---- C measurements: sizeof, _Alignof and offsetof against Protos

first: import("ffi:first")
layout: FFI.bind(first, "ffi_test_group_layout", FFI.i64, Array(FFI.i64))
check("unknown group query", layout(9999) == -1)
oracle: Array(
    Array(0, FFI.sizeOf(Inner)), Array(1, FFI.alignOf(Inner)),
    Array(2, FFI.offsetOf(Inner, Array("b"))),
    Array(10, FFI.sizeOf(Large)), Array(11, FFI.alignOf(Large)),
    Array(12, FFI.offsetOf(Large, Array("z"))),
    Array(20, FFI.sizeOf(Choice)), Array(21, FFI.alignOf(Choice)),
    Array(22, FFI.offsetOf(Choice, Array("real"))),
    Array(30, FFI.sizeOf(PaddedUnion)), Array(31, FFI.alignOf(PaddedUnion)),
    Array(32, FFI.offsetOf(PaddedUnion, Array("bytes", 8))),
    Array(40, FFI.sizeOf(Outer)), Array(41, FFI.alignOf(Outer)),
    Array(42, FFI.offsetOf(Outer, Array("inner"))),
    Array(43, FFI.offsetOf(Outer, Array("inner", "b"))),
    Array(44, FFI.offsetOf(Outer, Array("values"))),
    Array(45, FFI.offsetOf(Outer, Array("values", 2))),
    Array(46, FFI.offsetOf(Outer, Array("next"))),
    Array(50, FFI.sizeOf(Nested)), Array(51, FFI.alignOf(Nested)),
    Array(52, FFI.offsetOf(Nested, Array("ratios"))),
    Array(53, FFI.offsetOf(Nested, Array("ratios", 1))))
for(entry in oracle) {
    check("C group layout matches Protos", layout(entry[0]) == entry[1])
}
check("Twin measures like Inner",
    (FFI.sizeOf(Twin) == layout(0)) && (FFI.alignOf(Twin) == layout(1)))

// ---- bindings

calls: FFI.bindPreserving(first, "ffi_test_group_calls_count", FFI.i32, Array())
make: FFI.bind(first, "ffi_test_group_inner_make", Inner, Array())
transform: FFI.bind(first, "ffi_test_group_inner_transform", Inner, Array(Inner))
measure: FFI.bind(first, "ffi_test_group_inner_measure", FFI.i32, Array(Inner))
measurePreserving: FFI.bindPreserving(first, "ffi_test_group_inner_measure", FFI.i32, Array(Inner))
large: FFI.bind(first, "ffi_test_group_large_transform", Large, Array(Large))
unionInteger: FFI.bind(first, "ffi_test_group_union_integer", Choice, Array(Choice))
unionFloat: FFI.bind(first, "ffi_test_group_union_float", Choice, Array(Choice))
padded: FFI.bind(first, "ffi_test_group_padded_union_transform", PaddedUnion, Array(PaddedUnion))
outer: FFI.bind(first, "ffi_test_group_outer_transform", Outer, Array(Outer))
nested: FFI.bind(first, "ffi_test_group_nested_transform", Nested, Array(Nested))
innerA: FFI.bind(first, "ffi_test_memory_inner_a", FFI.i32, Array(FFI.nullable(FFI.pointer(Inner))))
touch: FFI.bind(first, "ffi_test_touch", FFI.void, Array())
Quad: FFI.array(FFI.u8, 4)
lend: FFI.bind(first, "ffi_test_pointer_octets", FFI.borrowedPointer(FFI.pointer(Quad)),
    Array(FFI.i32))
lendInner: FFI.bind(first, "ffi_test_memory_static", FFI.borrowedPointer(FFI.pointer(Inner)),
    Array(FFI.i32))
check("a binding is a fresh Closure",
    FFI.bind(first, "ffi_test_group_inner_make", Inner, Array()) !== make)

// Exactly one C entry per admitted group call.
entered: (label, body) => {
    before: calls()
    answer: body()
    check(label + " entered C once", calls() == (before + 1))
    answer
}

// ---- group return without group input

made: entered("make", () => make())
check("returned struct a", made["a"] == 17)
check("returned struct b", made["b"] == 2.5)
again: make()
check("every return is a fresh root", again !== made)
again["a"] = 1
check("returned roots are independent", made["a"] == 17)

// ---- group input and return

input: FFI.allocate(Inner)
input["a"] = 5
input["b"] = 1.25
result: entered("transform", () => transform(input))
check("transformed a", result["a"] == 12)
check("transformed b", result["b"] == 2.5)
check("result is not the input", result !== input)
check("input unchanged by C", (input["a"] == 5) && (input["b"] == 1.25))
result["a"] = 99
check("result write leaves the input", input["a"] == 5)
input["a"] = 6
check("input write leaves the result", result["a"] == 99)
check("group input without group return", entered("measure", () => measure(input)) == 6)

// Returned roots are ordinary native regions.
check("returned region slice", FFI.slice(result, 0, 4)[0] == 99)
check("returned region view", FFI.view(FFI.addressOf(result), Inner)["a"] == 99)
check("returned region at", result.at("b") == 2.5)
check("returned region atPut", result.atPut("b", 3.0) == 3.0)
check("returned region passes by value", measure(result) == 99)
check("returned region pointer passes", innerA(FFI.addressOf(result)) == 99)

// Owning roots, typed views, nested views and read-only views are inputs.
fromView: transform(FFI.view(FFI.addressOf(input), Inner))
check("typed view input", fromView["a"] == 13)
holder: FFI.allocate(Outer)
holder["inner"]["a"] = 30
holder["inner"]["b"] = 0.5
fromNested: transform(holder["inner"])
check("nested view input", (fromNested["a"] == 37) && (fromNested["b"] == 1.0))
holder["next"] = FFI.addressOf(input)
readOnly: FFI.view(FFI.assumeExtent(holder["next"], 16, input, "read"), Inner)
ordinary("read-only view stays read-only", () => { readOnly["a"] = 1 })
fromReadOnly: entered("read-only input", () => transform(readOnly))
check("read-only view input", (fromReadOnly["a"] == 13) && (fromReadOnly["b"] == 2.5))
check("read-only source unchanged", (input["a"] == 6) && (input["b"] == 1.25))

// Releasing the input never revokes an independent result.
check("input release", FFI.release(input) === null)
check("result survives the input release", result["a"] == 99)
check("result release", FFI.release(result) === null)
ordinary("result released once", () => FFI.release(result))
ordinary("released result", () => result["a"])

// ---- a large aggregate: the backend's indirect return

wide: FFI.allocate(Large)
wide["x"] = -1
wide["y"] = 21
wide["z"] = 9223372036854775807
widened: entered("large", () => large(wide))
check("large x", widened["x"] == 0)
check("large y", widened["y"] == 42)
check("large z", widened["z"] == -9223372036854775807)
check("large input unchanged",
    (wide["x"] == -1) && (wide["y"] == 21) && (wide["z"] == 9223372036854775807))

// ---- a nested aggregate with a fixed array and a pointer member

pointee: FFI.allocate(Inner)
pointee["a"] = 77
complex: FFI.allocate(Outer)
complex["tag"] = 250
complex["inner"]["a"] = 4
complex["inner"]["b"] = 1.5
complex["values"][0] = 1
complex["values"][1] = 2
complex["values"][2] = 3
complex["next"] = FFI.addressOf(pointee)
transformed: entered("outer", () => outer(complex))
check("outer tag", transformed["tag"] == 251)
check("outer nested a", transformed["inner"]["a"] == 12)
check("outer nested b", transformed["inner"]["b"] == 2.0)
check("outer array 0", transformed["values"][0] == 11)
check("outer array 1", transformed["values"][1] == 22)
check("outer array 2", transformed["values"][2] == 33)
kept: transformed["next"]
check("outer pointer kept", (kept === null) == false)
check("outer pointer passes to C", innerA(kept) == 77)
ordinary("outer pointer has no inferred extent", () => FFI.view(kept, Inner))
outerKept: (complex["tag"] == 250) && (complex["values"][2] == 3)
check("outer input unchanged", outerKept && (complex["inner"]["a"] == 4))

shaped: FFI.allocate(Nested)
shaped["choice"]["integer"] = 50
shaped["ratios"][0] = 1.5
shaped["ratios"][1] = 0.5
reshaped: entered("nested", () => nested(shaped))
check("nested union arm", reshaped["choice"]["integer"] == 45)
check("nested ratio 0", reshaped["ratios"][0] == 3.0)
check("nested ratio 1", reshaped["ratios"][1] == 0.75)

// ---- unions: overlapping storage, no active-arm tracking

choice: FFI.allocate(Choice)
choice["integer"] = 1
integral: entered("union integer", () => unionInteger(choice))
check("union integer arm", integral["integer"] == 101)
real: FFI.allocate(Choice)
real["real"] = 2.5
scaled: entered("union float", () => unionFloat(real))
check("union float arm", scaled["real"] == 10.0)
check("union result overlaps", scaled["integer"] == 4621819117588971520)
scaled["real"] = 1.0
check("union result overlaps back", scaled["integer"] == 4607182418800017408)
check("union input unchanged", (choice["integer"] == 1) && (real["real"] == 2.5))

octuple: FFI.allocate(PaddedUnion)
octuple["bytes"][0] = 10
octuple["bytes"][8] = 1
flipped: entered("padded union", () => padded(octuple))
check("padded union size", FFI.sizeOf(PaddedUnion) == 16)
check("padded union byte 0", flipped["bytes"][0] == 11)
check("padded union byte 8", flipped["bytes"][8] == 254)
check("padded union bytes 1..7", sameOctets(Arrays.take(Arrays.drop(octets(flipped, 9), 1), 7),
    Array(0, 0, 0, 0, 0, 0, 0)))
check("padded union wide arm", flipped["wide"] == 11)
check("padded union input unchanged", (octuple["bytes"][0] == 10) && (octuple["bytes"][8] == 1))

// ---- a group return together with struct and union outs

mixedParameters: Array(Inner, FFI.i32, FFI.out(Inner), FFI.out(Choice))
mixed: FFI.bind(first, "ffi_test_group_mixed", Inner, mixedParameters)
seed: FFI.allocate(Inner)
seed["a"] = 3
seed["b"] = 1.0
answers: entered("mixed", () => mixed(seed, 4))
check("mixed answers an Array", Array.recognizes(answers))
check("mixed positions", answers.size() == 3)
check("mixed return", (answers[0]["a"] == 7) && (answers[0]["b"] == 1.5))
check("mixed struct out", (answers[1]["a"] == 6) && (answers[1]["b"] == 0.0))
check("mixed union out", answers[2]["integer"] == 1007)
mixedDistinct: (answers[0] !== answers[1]) && (answers[1] !== answers[2])
check("mixed roots are independent", mixedDistinct && (answers[0] !== answers[2]))
check("mixed return is not the struct out", answers[0] !== answers[1])
check("mixed return is not the union out", answers[0] !== answers[2])
check("mixed struct out is not the union out", answers[1] !== answers[2])
check("mixed return is not the input", answers[0] !== seed)
check("mixed struct out is not the input", answers[1] !== seed)
answers[1]["a"] = 0
check("mixed out write is independent", answers[0]["a"] == 7)
check("mixed out write leaves the input", seed["a"] == 3)
answers[0]["b"] = 9.5
check("mixed return write leaves the input", seed["b"] == 1.0)
check("mixed return write leaves the struct out", answers[1]["b"] == 0.0)
answers[1]["b"] = -2.5
check("mixed struct out write leaves the input", seed["b"] == 1.0)
check("mixed struct out write leaves the return", answers[0]["b"] == 9.5)
check("mixed struct writes leave the union out", answers[2]["integer"] == 1007)
answers[1]["b"] = 0.0
ordinary("mixed takes two arguments", () => mixed(seed))
ordinary("mixed takes no out argument", () => mixed(seed, 4, seed))
repeated: mixed(seed, 4)
check("mixed fresh Array", repeated !== answers)
freshRoots: (repeated[0] !== answers[0]) && (repeated[1] !== answers[1])
check("mixed fresh roots", freshRoots && (repeated[2] !== answers[2]))
check("mixed release union out first", FFI.release(answers[2]) === null)
check("mixed return outlives its outs", answers[0]["a"] == 7)
check("mixed release return", FFI.release(answers[0]) === null)
check("mixed struct out outlives the return", answers[1]["b"] == 0.0)
check("mixed release struct out", FFI.release(answers[1]) === null)
check("repeated results unaffected", (repeated[0]["a"] == 7) && (repeated[2]["integer"] == 1007))
for(root in repeated) {
    check("repeated release", FFI.release(root) === null)
}
mixedPreserving: FFI.bindPreserving(first, "ffi_test_group_mixed", Inner, mixedParameters)
lentForMixed: lend(1)
preserved: mixedPreserving(seed, -3)
preservedFirst: (preserved[0]["a"] == 0) && (preserved[1]["a"] == 6)
check("preserving mixed results", preservedFirst && (preserved[2]["integer"] == 1000))
check("preserving mixed keeps borrowed pointers", first.isLive(lentForMixed) == true)
for(root in preserved) {
    check("preserving mixed release", FFI.release(root) === null)
}

// ---- borrowed inputs are copied before the epoch advances

borrowed: lendInner(1)
borrowedView: FFI.view(FFI.assumeExtent(borrowed, 16, borrowed, "read"), Inner)
expectedA: borrowedView["a"] + 7
copied: entered("borrowed input", () => transform(borrowedView))
check("borrowed input copied before the call", copied["a"] == expectedA)
ordinary("borrowed view expired by the call", () => borrowedView["a"])
check("group result outlives the epoch", copied["a"] == expectedA)

// ---- rejection before entry: counter, bytes and borrowed pointers unchanged

source: FFI.allocate(Inner)
source["a"] = 8
source["b"] = 0.125
unrelated: FFI.allocate(Large)
twin: FFI.allocate(Twin)
twin["a"] = 8
released: FFI.allocate(Inner)
check("released release", FFI.release(released) === null)
plainMap: Map()
plainMap["a"] = 8
plainMap["b"] = 0.125
lent: lend(1)
rejected: (label, body) => {
    before: calls()
    bytes: octets(source, 16)
    ordinary(label, body)
    check(label + " did not enter C", calls() == before)
    check(label + " left the input bytes", sameOctets(bytes, octets(source, 16)))
    check(label + " kept the borrowed pointer", first.isLive(lent) == true)
}
rejected("wrong arity", () => transform())
rejected("extra argument", () => transform(source, source))
rejected("ordinary Object", () => transform({ a: 8 }))
rejected("ordinary Map", () => transform(plainMap))
rejected("ordinary Array", () => transform(Array(8, 0.125)))
rejected("null", () => transform(null))
rejected("raw pointer", () => transform(FFI.addressOf(source)))
rejected("byte slice", () => transform(FFI.slice(source, 0, 16)))
rejected("unrelated layout", () => transform(unrelated))
rejected("structurally identical layout", () => transform(twin))
rejected("released region", () => transform(released))
rejected("expired borrowed view", () => transform(borrowedView))
rejected("measure of a Twin", () => measure(twin))
rejected("mixed of a Twin", () => mixed(twin, 1))
check("no rejection advanced the epoch", first.isLive(lent) == true)

// ---- borrow epoch: non-preserving group calls revoke, preserving keep

check("non-preserving group call", measure(source) == 8)
check("non-preserving group call revokes", first.isLive(lent) == false)
lentAgain: lend(1)
check("preserving group call", measurePreserving(source) == 8)
check("preserving group call keeps", first.isLive(lentAgain) == true)
independent: make()
touch()
check("group result independent of the epoch", independent["a"] == 17)

// ---- the same layout through a second, independently authorized library

second: import("ffi:second")
secondTransform: FFI.bind(second, "ffi_second_group_transform", Inner, Array(Inner))
pair: FFI.allocate(Inner)
pair["a"] = 2
pair["b"] = 5.0
paired: secondTransform(pair)
check("second library result", (paired["a"] == 11) && (paired["b"] == 3.0))
ordinary("second library rejects a structurally identical layout", () => secondTransform(twin))
// The shared physical registration grants no symbol of another library.
foreign("registration is not authorization",
    () => FFI.bind(second, "ffi_test_group_inner_transform", Inner, Array(Inner)))

// ---- isolated parallel execution: group roots never cross P

refused: caught(NonParallelValue, () => ((x) => 1).parallel(paired).value())
check("group root never crosses P", (refused === null) == false)
check("scalar read from a group crosses P", ((x) => x + 1).parallel(paired["a"]).value() == 12)

// ---- explicit aggregate projection to and from ordinary Maps and Arrays

mapShape: %{}
isMap: (value) => mapShape.match(value) === true
whole: (name) => FFI.unionArm(Array(), name)
rootInteger: whole("integer")
rootReal: whole("real")

// C results by value, projected.
madeFields: FFI.readFields(made, Array())
check("C struct result as a Map", isMap(madeFields) && (madeFields.size() == 2))
check("C struct result values", (madeFields["a"] == 17) && (madeFields["b"] == 2.5))
integralFields: FFI.readFields(integral, Array(rootInteger))
check("C union result as a Map", (integralFields.size() == 1) && (integralFields["integer"] == 101))
check("C union result, other selection", FFI.readFields(scaled, Array(rootReal))["real"] == 1.0)
reshapedFields: FFI.readFields(reshaped, Array(FFI.unionArm(Array("choice"), "integer")))
check("C nested union", reshapedFields["choice"]["integer"] == 45)
ratios: reshapedFields["ratios"]
check("C nested array",
    Array.recognizes(ratios) && (ratios[0] == 3.0) && (ratios[1] == 0.75))
transformedFields: FFI.readFields(transformed, Array())
transformedHead: (transformedFields["tag"] == 251) && (transformedFields["inner"]["a"] == 12)
check("C struct with nested struct and array",
    transformedHead && (transformedFields["values"][2] == 33))
outs: mixed(seed, 4)
outFields: FFI.readFields(outs[1], Array())
check("struct out projected", (outFields["a"] == 6) && (outFields["b"] == 0.0))
check("union out projected", FFI.readFields(outs[2], Array(rootInteger))["integer"] == 1007)
for(root in outs) {
    check("out release", FFI.release(root) === null)
}
firstMade: make()
secondMade: make()
firstFields: FFI.readFields(firstMade, Array())
secondFields: FFI.readFields(secondMade, Array())
check("snapshots of distinct calls are distinct", firstFields !== secondFields)
firstFields["a"] = 0
check("snapshots of distinct calls are independent", secondFields["a"] == 17)
check("writeFields over a C result",
    FFI.writeFields(firstMade, %{ "a": 40; "b": 0.5 }, Array()) === firstMade)
check("C reads the written group", measure(firstMade) == 40)
rewritten: transform(firstMade)
check("C transforms the written group", (rewritten["a"] == 47) && (rewritten["b"] == 1.0))
for(root in Array(firstMade, secondMade, rewritten)) {
    check("projection result release", FFI.release(root) === null)
}

// ---- union selections

Deep: FFI.union(Array(field("inner", Choice), field("plain", FFI.i64)))
Selector: FFI.struct(Array(
    field("count", FFI.i32),
    field("choice", Choice),
    field("link", FFI.nullable(FFI.pointer(Inner))),
    field("cells", FFI.array(Choice, 2)),
    field("deep", Deep)))
choicePath: Array("choice")
choiceArm: FFI.unionArm(choicePath, "integer")
choicePath[0] = "count"
cell0: FFI.unionArm(Array("cells", 0), "integer")
cell1: FFI.unionArm(Array("cells", 1), "real")
deepArm: FFI.unionArm(Array("deep"), "inner")
deepInner: FFI.unionArm(Array("deep", "inner"), "real")
// Deliberately not in traversal order.
selections: Array(deepInner, cell1, choiceArm, deepArm, cell0)
selector: FFI.allocate(Selector)
selectorFields: %{
    "count": 3
    "choice": %{ "integer": -9 }
    "link": null
    "cells": Array(%{ "integer": 1 }, %{ "real": 2.5 })
    "deep": %{ "inner": %{ "real": 0.5 } }
}
check("selector write", FFI.writeFields(selector, selectorFields, selections) === selector)
selected: FFI.readFields(selector, selections)
check("struct-nested union", selected["choice"]["integer"] == -9)
check("array-nested unions",
    (selected["cells"][0]["integer"] == 1) && (selected["cells"][1]["real"] == 2.5))
check("union inside a selected union member", selected["deep"]["inner"]["real"] == 0.5)
check("nullable pointer member null", selected.containsKey("link") && (selected["link"] === null))
check("selections read the native bytes", selector["cells"][1]["real"] == 2.5)

selectorRejected: (label, body) => {
    before: calls()
    bytes: octets(selector, FFI.sizeOf(Selector))
    ordinary(label, body)
    check(label + " did not enter C", calls() == before)
    check(label + " left every byte", sameOctets(bytes, octets(selector, FFI.sizeOf(Selector))))
}
withSelections: (extra) => Arrays.concat(selections, extra)
badSelections: Array(
    Array("missing", Array(deepInner, cell1, choiceArm, deepArm)),
    Array("duplicate", withSelections(Array(FFI.unionArm(Array("cells", 0), "real")))),
    Array("unknown", withSelections(Array(FFI.unionArm(Array("nowhere"), "integer")))),
    Array("through a scalar", withSelections(Array(FFI.unionArm(Array("count", "x"), "y")))),
    Array("through a pointer", withSelections(Array(FFI.unionArm(Array("link", "a"), "b")))),
    Array("index beyond the array", withSelections(Array(FFI.unionArm(Array("cells", 2), "real")))),
    Array("unknown member", Array(deepInner, cell1, FFI.unionArm(Array("choice"), "nope"), deepArm,
        cell0)),
    Array("struct as a union", withSelections(Array(FFI.unionArm(Array(), "count")))),
    Array("inside an unselected member", Array(deepInner, cell1, choiceArm,
        FFI.unionArm(Array("deep"), "plain"), cell0)),
    Array("unconsumed", withSelections(Array(FFI.unionArm(Array("choice", "integer"), "x")))),
    Array("String index of an array", Array(deepInner, cell1, choiceArm, deepArm,
        FFI.unionArm(Array("cells", "0"), "integer"))),
    Array("forged selection", withSelections(Array({ path: Array("choice") }))),
    Array("not an Array", deepArm))
for(entry in badSelections) {
    selectorRejected("read " + entry[0], () => FFI.readFields(selector, entry[1]))
    selectorRejected("write " + entry[0],
        () => FFI.writeFields(selector, selectorFields, entry[1]))
}
ordinary("negative index", () => FFI.unionArm(Array("cells", -1), "integer"))
ordinary("Float index", () => FFI.unionArm(Array("cells", 1.0), "integer"))
ordinary("null component", () => FFI.unionArm(Array(null), "integer"))
ordinary("member name not a String", () => FFI.unionArm(Array("choice"), 1))
ordinary("path not an Array", () => FFI.unionArm("choice", "integer"))
ordinary("unionArm arity", () => FFI.unionArm(Array()))

// Names: "0" is not 0, "a.b" is not ("a", "b"), "" and Unicode are names.
Keyed: FFI.struct(Array(
    field("0", Choice),
    field("list", FFI.array(Choice, 1)),
    field("a.b", Choice),
    field("a", FFI.struct(Array(field("b", Choice)))),
    field("", Choice),
    field("ñandú π", Choice)))
keyedArms: Array(
    FFI.unionArm(Array("ñandú π"), "real"),
    FFI.unionArm(Array(""), "integer"),
    FFI.unionArm(Array("a", "b"), "real"),
    FFI.unionArm(Array("a.b"), "integer"),
    FFI.unionArm(Array("list", 0), "real"),
    FFI.unionArm(Array("0"), "integer"))
keyed: FFI.allocate(Keyed)
keyedFields: %{
    "0": %{ "integer": 1 }
    "list": Array(%{ "real": 2.5 })
    "a.b": %{ "integer": 3 }
    "a": %{ "b": %{ "real": 4.5 } }
    "": %{ "integer": 5 }
    "ñandú π": %{ "real": 6.5 }
}
FFI.writeFields(keyed, keyedFields, keyedArms)
keyedRead: FFI.readFields(keyed, keyedArms)
check("String \"0\" member", keyedRead["0"]["integer"] == 1)
check("Integer 0 index", keyedRead["list"][0]["real"] == 2.5)
check("dotted name", keyedRead["a.b"]["integer"] == 3)
check("nested path", keyedRead["a"]["b"]["real"] == 4.5)
check("empty name", keyedRead[""]["integer"] == 5)
check("Unicode name", keyedRead["ñandú π"]["real"] == 6.5)
ordinary("Integer 0 does not name member \"0\"", () => FFI.readFields(keyed, Array(
    FFI.unionArm(Array(0), "integer"), keyedArms[1], keyedArms[2], keyedArms[3], keyedArms[4],
    keyedArms[0])))
ordinary("String \"0\" does not index an array", () => FFI.readFields(keyed, Array(
    keyedArms[5], keyedArms[1], keyedArms[2], keyedArms[3], FFI.unionArm(Array("list", "0"),
    "real"), keyedArms[0])))
ordinary("\"a.b\" is not a path", () => FFI.readFields(keyed, Array(keyedArms[0], keyedArms[1],
    FFI.unionArm(Array("a.b"), "real"), keyedArms[3], keyedArms[4], keyedArms[5])))

// ---- field names that are also message names

collisions: Array("call", "construct", "init", "createSlot", "updateSlot", "slotValue", "parent",
    "hasSlot", "at", "atPut", "size", "with space", "x-y", "[0]", "a.b.c")
collisionFields: Array()
for(name in collisions) {
    collisionFields = Arrays.append(collisionFields, field(name, FFI.i32))
}
Collisions: FFI.struct(collisionFields)
colliding: FFI.allocate(Collisions)
collidingInput: Map()
index: 0
for(name in collisions) {
    collidingInput[name] = index * 3
    index = index + 1
}
check("colliding names write", FFI.writeFields(colliding, collidingInput, Array()) === colliding)
collidingRead: FFI.readFields(colliding, Array())
check("colliding names read every field", collidingRead.size() == collisions.size())
index = 0
for(name in collisions) {
    check("colliding name " + name, collidingRead[name] == (index * 3))
    check("colliding native field " + name, colliding[name] == (index * 3))
    index = index + 1
}

// ---- staged writes: a rejected value never changes the destination

Late: FFI.struct(Array(
    field("first", FFI.i32),
    field("list", FFI.array(FFI.i16, 3)),
    field("choice", Choice),
    field("ratio", FFI.f32),
    field("target", FFI.pointer(Inner)),
    field("maybe", FFI.nullable(FFI.pointer(Inner))),
    field("small", FFI.i8),
    field("real", FFI.f64)))
lateArms: Array(FFI.unionArm(Array("choice"), "integer"))
lateTarget: FFI.allocate(Inner)
lateTarget["a"] = 21
lateFields: () => {
    %{
        "first": 1
        "list": Array(1, 2, 3)
        "choice": %{ "integer": 4 }
        "ratio": 0.5
        "target": FFI.addressOf(lateTarget)
        "maybe": null
        "small": -128
        "real": 2.5
    }
}
late: FFI.allocate(Late)
FFI.writeFields(late, lateFields(), lateArms)
check("late initial write", (late["first"] == 1) && (late["small"] == -128))
lentLate: lend(1)
lateSize: FFI.sizeOf(Late)
lateRejected: (label, change) => {
    input: lateFields()
    change(input)
    before: calls()
    bytes: octets(late, lateSize)
    ordinary(label, () => FFI.writeFields(late, input, lateArms))
    check(label + " did not enter C", calls() == before)
    check(label + " left every byte", sameOctets(bytes, octets(late, lateSize)))
    check(label + " kept the borrowed pointer", first.isLive(lentLate) == true)
}
expiring: FFI.allocate(Inner)
expired: FFI.addressOf(expiring)
FFI.release(expiring)
lateRejected("Integer range", (m) => { m["small"] = 128 })
lateRejected("Integer for f64", (m) => { m["real"] = 1 })
lateRejected("String for f64", (m) => { m["real"] = "1.0" })
lateRejected("incompatible pointer", (m) => { m["target"] = FFI.addressOf(wide) })
lateRejected("expired pointer", (m) => { m["target"] = expired })
lateRejected("null pointer", (m) => { m["target"] = null })
lateRejected("Integer pointer", (m) => { m["maybe"] = 0 })
lateRejected("missing field", (m) => { m.remove("real") })
lateRejected("extra field", (m) => { m["extra"] = 1 })
lateRejected("non-String key", (m) => {
    m.remove("real")
    m[7] = 2.5
})
lateRejected("short Array", (m) => { m["list"] = Array(1, 2) })
lateRejected("long Array", (m) => { m["list"] = Array(1, 2, 3, 4) })
lateRejected("invalid last element", (m) => { m["list"] = Array(1, 2, 40000) })
lateRejected("Object for Array", (m) => { m["list"] = { size: 3 } })
lateRejected("Object for Map", (m) => { m["choice"] = { integer: 4 } })
lateRejected("wrong union member", (m) => { m["choice"] = %{ "real": 1.5 } })
lateRejected("extra union member", (m) => { m["choice"] = %{ "integer": 4; "real": 1.5 } })
lateRejected("region for a Map", (m) => { m["choice"] = choice })
// f32 rounds once (FFI.md): overflow is binary32 infinity, not a rejection.
huge: lateFields()
huge["ratio"] = 1.0e300
FFI.writeFields(late, huge, lateArms)
check("f32 overflow rounds to infinity", late["ratio"] == (1.0 / 0.0))
validBefore: calls()
check("valid write", FFI.writeFields(late, lateFields(), lateArms) === late)
check("valid write did not enter C", calls() == validBefore)
check("valid write kept the borrow epoch", first.isLive(lentLate) == true)
check("valid write committed", (late["ratio"] == 0.5) && (late["list"][2] == 3))
check("valid pointer written", innerA(late["target"]) == 21)

// ---- padding and unselected union bytes keep their contents

pattern: (region, length) => {
    view: FFI.slice(region, 0, length)
    index: 0
    while(index < length) {
        view[index] = 160 + index
        index = index + 1
    }
}
paddedUnion: FFI.allocate(PaddedUnion)
pattern(paddedUnion, 16)
FFI.writeFields(paddedUnion, %{ "wide": 0 }, Array(whole("wide")))
unionBytes: octets(paddedUnion, 16)
check("written member bytes", sameOctets(Arrays.take(unionBytes, 8), Array(0, 0, 0, 0, 0, 0, 0, 0)))
check("bytes beyond the member keep their pattern", sameOctets(Arrays.drop(unionBytes, 8),
    Array(168, 169, 170, 171, 172, 173, 174, 175)))
paddedBytes: FFI.readFields(paddedUnion, Array(whole("bytes")))["bytes"]
check("other member reads the kept byte", (paddedBytes.size() == 9) && (paddedBytes[8] == 168))
paddedStruct: FFI.allocate(Inner)
pattern(paddedStruct, 16)
FFI.writeFields(paddedStruct, %{ "a": 1; "b": 2.0 }, Array())
check("struct padding keeps its pattern",
    sameOctets(Arrays.take(Arrays.drop(octets(paddedStruct, 16), 4), 4), Array(164, 165, 166, 167)))
check("struct fields around padding", FFI.readFields(paddedStruct, Array())["b"] == 2.0)

// ---- ownership, permissions and lifetime

owner: FFI.allocate(Inner)
FFI.writeFields(owner, %{ "a": 2; "b": 0.5 }, Array())
typedView: FFI.view(FFI.addressOf(owner), Inner)
check("typed view read", FFI.readFields(typedView, Array())["a"] == 2)
FFI.writeFields(typedView, %{ "a": 3; "b": 0.5 }, Array())
check("typed view write", owner["a"] == 3)
check("nested view read", FFI.readFields(holder["inner"], Array())["a"] == 30)
FFI.writeFields(holder["inner"], %{ "a": 31; "b": 0.5 }, Array())
check("nested view write", holder["inner"]["a"] == 31)
holder["next"] = FFI.addressOf(owner)
readOnlyView: FFI.view(FFI.assumeExtent(holder["next"], 16, owner, "read"), Inner)
check("read-only view read", FFI.readFields(readOnlyView, Array())["a"] == 3)
ownerBytes: octets(owner, 16)
ordinary("read-only view write",
    () => FFI.writeFields(readOnlyView, %{ "a": 4; "b": 0.5 }, Array()))
check("read-only refusal left the bytes", sameOctets(ownerBytes, octets(owner, 16)))
ordinary("array region is not a projection root", () => FFI.readFields(holder["values"], Array()))
ordinary("raw pointer is not a region", () => FFI.readFields(FFI.addressOf(owner), Array()))
ordinary("byte slice is not a group", () => FFI.readFields(FFI.slice(owner, 0, 16), Array()))
ordinary("Map is not a region", () => FFI.readFields(plainMap, Array()))
ordinary("null is not a region", () => FFI.readFields(null, Array()))
ordinary("descriptor is not a region", () => FFI.readFields(Inner, Array()))
ordinary("readFields arity", () => FFI.readFields(owner))
ordinary("writeFields arity", () => FFI.writeFields(owner, %{ "a": 1; "b": 1.0 }))
lentInner: lendInner(1)
lentView: FFI.view(FFI.assumeExtent(lentInner, 16, lentInner, "read"), Inner)
lentA: FFI.readFields(lentView, Array())["a"]
check("borrowed view read", lentA == lentView["a"])
touch()
ordinary("borrowed view expired by a downcall", () => FFI.readFields(lentView, Array()))
temporaryRoot: FFI.allocate(Inner)
temporaryView: FFI.view(FFI.addressOf(temporaryRoot), Inner)
FFI.release(temporaryRoot)
ordinary("released region", () => FFI.readFields(temporaryRoot, Array()))
ordinary("released region write",
    () => FFI.writeFields(temporaryRoot, %{ "a": 1; "b": 1.0 }, Array()))
ordinary("view revoked by its root release", () => FFI.readFields(temporaryView, Array()))

// ---- pointers inside snapshots stay capabilities

complexFields: FFI.readFields(complex, Array())
next: complexFields["next"]
check("pointer member is not an Integer", Integer.recognizes(next) == false)
check("pointer member passes to C", innerA(next) == 77)
ordinary("pointer member has no inferred extent", () => FFI.view(next, Inner))
ordinary("pointer member is not an owned resource", () => FFI.release(next))
check("projection read no pointee", pointee["a"] == 77)
FFI.writeFields(complex, complexFields, Array())
check("writeFields keeps the original pointer capability", innerA(next) == 77)
check("written pointer is the same address", innerA(complex["next"]) == 77)
dangling: FFI.allocate(Inner)
holderNext: FFI.allocate(Outer)
holderNext["next"] = FFI.addressOf(dangling)
FFI.release(dangling)
check("a pointer member is never dereferenced",
    (FFI.readFields(holderNext, Array())["next"] === null) == false)
emptyNext: FFI.allocate(Outer)
check("nullable pointer null value", FFI.readFields(emptyNext, Array())["next"] === null)

// ---- transfer: snapshots follow ordinary rules, capabilities never cross

scalarSnapshot: FFI.readFields(made, Array())
check("scalar snapshot crosses P",
    ((fields) => fields["a"] + fields["b"]).parallel(scalarSnapshot).value() == 19.5)
pointerSnapshot: FFI.readFields(complex, Array())
refusedSnapshot: caught(NonParallelValue, () => ((x) => 1).parallel(pointerSnapshot).value())
check("a snapshot holding a pointer never crosses P", (refusedSnapshot === null) == false)
check("nested groups are Maps, not regions", isMap(pointerSnapshot["inner"]))

// ---- ordinary object snapshots of C results

InnerShape: {
    succ: () => this.a + 1
}
FFI.prototype(Inner, InnerShape)
ChoiceShape: {}
FFI.prototype(Choice, ChoiceShape)
OuterShape: {}
FFI.prototype(Outer, OuterShape)
NestedShape: {}
FFI.prototype(Nested, NestedShape)
LateShape: {}
FFI.prototype(Late, LateShape)
PaddedShape: {}
FFI.prototype(PaddedUnion, PaddedShape)

snapshotCalls: calls()
madeObject: FFI.readAs(InnerShape, made, Array())
check("C struct result as an object", (madeObject.a == 17) && (madeObject.b == 2.5))
check("C struct object parent", madeObject.parent() === InnerShape)
integralObject: FFI.readAs(ChoiceShape, integral, Array(rootInteger))
check("C union result as an object", integralObject.integer == 101)
check("C union object holds one member", integralObject.slotNames().size() == 1)
transformedObject: FFI.readAs(OuterShape, transformed, Array())
check("C nested struct object", transformedObject.inner.a == 12)
check("C nested struct parent is Object", transformedObject.inner.parent() === Object)
check("C nested array", Array.recognizes(transformedObject.values) &&
    (transformedObject.values[2] == 33))
reshapedObject: FFI.readAs(NestedShape, reshaped, Array(FFI.unionArm(Array("choice"), "integer")))
check("C nested union object", reshapedObject.choice.integer == 45)
check("C nested f32 array", reshapedObject.ratios[1] == 0.75)
check("readAs never entered C", calls() == snapshotCalls)
objectOuts: mixed(seed, 4)
outObject: FFI.readAs(InnerShape, objectOuts[1], Array())
outUnion: FFI.readAs(ChoiceShape, objectOuts[2], Array(rootInteger))
for(root in objectOuts) {
    check("object out release", FFI.release(root) === null)
}
check("out snapshots outlive their roots", (outObject.a == 6) && (outUnion.integer == 1007))
check("out snapshot delegates", outObject.succ() == 7)
// A snapshot of its own independent C result, observed after that root's release.
standalone: outer(complex)
standaloneObject: FFI.readAs(OuterShape, standalone, Array())
standaloneInner: standaloneObject.inner
standaloneValues: standaloneObject.values
standalonePointer: standaloneObject.next
expectedTag: standalone["tag"]
expectedInnerA: standalone["inner"]["a"]
expectedLast: standalone["values"][2]
check("standalone pointer passes before release", innerA(standalonePointer) == 77)
check("standalone root release", FFI.release(standalone) === null)
ordinary("a snapshot keeps no region alive", () => standalone["tag"])
check("the snapshot stays ordinary", (standaloneObject.tag == expectedTag) &&
    (standaloneObject.parent() === OuterShape))
check("the nested object keeps its scalars", (standaloneInner.a == expectedInnerA) &&
    (standaloneObject.inner === standaloneInner))
check("the nested Array keeps its elements", (standaloneValues.size() == 3) &&
    (standaloneValues[2] == expectedLast))
standaloneObject.tag = 1
standaloneInner.a = 2
standaloneValues[0] = 3
check("released snapshot slots stay mutable", (standaloneObject.tag == 1) &&
    (standaloneInner.a == 2) && (standaloneValues[0] == 3))
ordinary("a contained pointer follows its region's revocation",
    () => innerA(standalonePointer))
ordinary("a snapshot is not a region", () => FFI.readFields(standaloneObject, Array()))
ordinary("a snapshot is not an owned root", () => FFI.release(standaloneObject))

// Writes observed by C.
writable: make()
writableObject: FFI.readAs(InnerShape, writable, Array())
writableObject.a = 40
writeCalls: calls()
check("writeFrom over a C result", FFI.writeFrom(writable, writableObject, Array()) === writable)
check("writeFrom never entered C", calls() == writeCalls)
check("C reads the written object", measure(writable) == 40)
rewrittenFromObject: transform(writable)
check("C transforms the written object",
    (rewrittenFromObject["a"] == 47) && (rewrittenFromObject["b"] == 2.5 * 2.0))
for(root in Array(writable, rewrittenFromObject)) {
    check("written object release", FFI.release(root) === null)
}

// ---- field names that are also reflective messages

hookNames: Array("createSlot", "call", "init", "construct", "slotValue", "parent", "plain", "",
    "with space", "a.b", "ñandú π")
hookFields: Array()
for(name in hookNames) {
    hookFields = Arrays.append(hookFields, field(name, FFI.i32))
}
Hooked: FFI.struct(hookFields)
hookHits: { count: 0 }
HookedShape: {
    call: (...arguments) => {
        hookHits.count = hookHits.count + 1
        null
    }
    init: (...arguments) => {
        hookHits.count = hookHits.count + 1
        null
    }
    construct: (...arguments) => {
        hookHits.count = hookHits.count + 1
        null
    }
}
FFI.prototype(Hooked, HookedShape)
hookedRegion: FFI.allocate(Hooked)
hookedInput: Map()
hookIndex: 0
for(name in hookNames) {
    hookedInput[name] = hookIndex + 1
    hookIndex = hookIndex + 1
}
FFI.writeFields(hookedRegion, hookedInput, Array())
hooked: FFI.readAs(HookedShape, hookedRegion, Array())
check("every colliding name became a slot, even after createSlot",
    hooked.hasSlot("plain") && hooked.hasSlot("ñandú π") && hooked.hasSlot(""))
check("hasSlot sees the odd names", hooked.hasSlot("with space") && hooked.hasSlot("a.b"))
check("createSlot field", hooked.createSlot == 1)
check("call field", hooked.call == 2)
check("init and construct fields", (hooked.init == 3) && (hooked.construct == 4))
check("slotValue and parent fields", (hooked.slotValue == 5) && (hooked.parent == 6))
check("plain field", hooked.plain == 7)
check("prototype behavior never ran", hookHits.count == 0)
check("a call field makes the snapshot not invocable", (caught(Error, () => hooked()) === null) == false)
check("a failed invocation ran no prototype behavior", hookHits.count == 0)
// A layout without slotValue inspects the odd names through ordinary reflection.
Named: FFI.struct(Array(field("", FFI.i32), field("with space", FFI.i32), field("a.b", FFI.i32),
    field("ñandú π", FFI.i32)))
NamedShape: {}
FFI.prototype(Named, NamedShape)
namedRegion: FFI.allocate(Named)
FFI.writeFields(namedRegion, %{ "": 1; "with space": 2; "a.b": 3; "ñandú π": 4 }, Array())
namedObject: FFI.readAs(NamedShape, namedRegion, Array())
check("exact odd names", (namedObject.slotValue("") == 1) && (namedObject.slotValue("with space") == 2))
check("exact odd names 2", (namedObject.slotValue("a.b") == 3) &&
    (namedObject.slotValue("ñandú π") == 4))
namedObject.updateSlot("a.b", 30)
FFI.writeFrom(namedRegion, namedObject, Array())
check("odd names write back", namedRegion["a.b"] == 30)
check("a snapshot is not a native region", FFI.release(namedRegion) === null)
ordinary("a snapshot is not an owned region", () => FFI.release(namedObject))
check("a snapshot outlives its region", namedObject.slotValue("") == 1)
hookedBytes: octets(hookedRegion, FFI.sizeOf(Hooked))
ordinary("writeFrom refuses a shadowed parent and slotValue",
    () => FFI.writeFrom(hookedRegion, hooked, Array()))
SlotValued: FFI.struct(Array(field("slotValue", FFI.i32), field("v", FFI.i32)))
SlotValuedShape: {}
FFI.prototype(SlotValued, SlotValuedShape)
slotValuedRegion: FFI.allocate(SlotValued)
slotValued: FFI.readAs(SlotValuedShape, slotValuedRegion, Array())
ordinary("writeFrom refuses a shadowed slotValue",
    () => FFI.writeFrom(slotValuedRegion, slotValued, Array()))
Parented: FFI.struct(Array(field("parent", FFI.i32), field("v", FFI.i32)))
ParentedShape: {}
FFI.prototype(Parented, ParentedShape)
parentedRegion: FFI.allocate(Parented)
parented: FFI.readAs(ParentedShape, parentedRegion, Array())
ordinary("writeFrom refuses a shadowed parent",
    () => FFI.writeFrom(parentedRegion, parented, Array()))
check("shadowed refusals left the bytes",
    sameOctets(hookedBytes, octets(hookedRegion, FFI.sizeOf(Hooked))))
hookedInput["call"] = 20
check("writeFields still serves colliding layouts",
    FFI.writeFields(hookedRegion, hookedInput, Array()) === hookedRegion)
check("readFields still serves colliding layouts",
    FFI.readFields(hookedRegion, Array())["call"] == 20)
for(root in Array(hookedRegion, slotValuedRegion, parentedRegion)) {
    check("colliding root release", FFI.release(root) === null)
}

// ---- redefined reflection is refused without being executed

forgery: { hits: 0 }
forged: () => {
    forgery.hits = forgery.hits + 1
}
ForgedCreate: {
    createSlot: (name, value) => {
        forged()
        value
    }
}
FFI.prototype(Inner, ForgedCreate)
ordinary("readAs refuses a redefined createSlot", () => FFI.readAs(ForgedCreate, made, Array()))
ForgedRead: {
    slotValue: (name) => {
        forged()
        5
    }
}
FFI.prototype(Inner, ForgedRead)
forgedTarget: FFI.allocate(Inner)
forgedTarget["a"] = 1
forgedBytes: octets(forgedTarget, 16)
ordinary("writeFrom refuses a redefined slotValue",
    () => FFI.writeFrom(forgedTarget, ForgedRead { a: 2; b: 0.5 }, Array()))
ordinary("writeFrom refuses a slotValue forging a missing field",
    () => FFI.writeFrom(forgedTarget, ForgedRead { a: 2 }, Array()))
Impostor: {
    parent: () => {
        forged()
        InnerShape
    }
}
ordinary("writeFrom refuses a parent forging a registered prototype",
    () => FFI.writeFrom(forgedTarget, Impostor { a: 2; b: 0.5 }, Array()))
ForgedParent: {
    parent: () => {
        forged()
        ForgedParent
    }
}
FFI.prototype(Inner, ForgedParent)
ordinary("writeFrom refuses a parent answering the truth",
    () => FFI.writeFrom(forgedTarget, ForgedParent { a: 2; b: 0.5 }, Array()))
truthful: { a: 2; b: 0.5 }
HonestRead: {
    slotValue: (name) => {
        forged()
        truthful.slotValue(name)
    }
}
FFI.prototype(Inner, HonestRead)
ordinary("writeFrom refuses a slotValue that would delegate correctly",
    () => FFI.writeFrom(forgedTarget, HonestRead { a: 2; b: 0.5 }, Array()))
Top: {}
MiddleForger: Top {
    slotValue: (name) => {
        forged()
        2
    }
}
Bottom: MiddleForger {}
FFI.prototype(Inner, Bottom)
ordinary("a redefinition in an intermediate ancestor is observed",
    () => FFI.writeFrom(forgedTarget, Bottom { a: 2; b: 0.5 }, Array()))
NotAClosure: { slotValue: 3 }
FFI.prototype(Inner, NotAClosure)
ordinary("a non-Closure shadowing slotValue is refused",
    () => FFI.writeFrom(forgedTarget, NotAClosure { a: 2; b: 0.5 }, Array()))
NullCreate: { createSlot: null }
FFI.prototype(Inner, NullCreate)
ordinary("a non-Closure shadowing createSlot is refused",
    () => FFI.readAs(NullCreate, made, Array()))
check("no forged method ran", forgery.hits == 0)
check("forged refusals left the bytes", sameOctets(forgedBytes, octets(forgedTarget, 16)))

// ---- local slots, never delegated ones

Defaulted: { b: 0.5 }
FFI.prototype(Inner, Defaulted)
partial: Defaulted { a: 3 }
ordinary("a delegated field is not a local slot",
    () => FFI.writeFrom(forgedTarget, partial, Array()))
check("the delegated refusal left the bytes", sameOctets(forgedBytes, octets(forgedTarget, 16)))
partial.createSlot("b", 1.5)
check("a local slot is written", FFI.writeFrom(forgedTarget, partial, Array()) === forgedTarget)
check("local values written", (forgedTarget["a"] == 3) && (forgedTarget["b"] == 1.5))
partial.b = 2.5
check("the snapshot slot is not the prototype slot", Defaulted.b == 0.5)
check("the forged target release", FFI.release(forgedTarget) === null)

// ---- preflight: a rejected writeFrom changes nothing

lentObjects: lend(1)
lateObjectRejected: (label, change, arms) => {
    input: FFI.readAs(LateShape, late, lateArms)
    change(input)
    before: calls()
    bytes: octets(late, lateSize)
    ordinary(label, () => FFI.writeFrom(late, input, arms))
    check(label + " did not enter C", calls() == before)
    check(label + " left every byte", sameOctets(bytes, octets(late, lateSize)))
    check(label + " kept the borrow epoch", first.isLive(lentObjects) == true)
    check(label + " kept the region live", late["first"] == 1)
}
SlotForger: {
    slotValue: (name) => {
        forged()
        4
    }
}
lateObjectRejected("last local slot missing", (o) => { o.removeSlot("real") }, lateArms)
lateObjectRejected("scalar out of range", (o) => { o.small = 128 }, lateArms)
lateObjectRejected("Integer for the last Float", (o) => { o.real = 1 }, lateArms)
lateObjectRejected("incompatible pointer", (o) => { o.target = FFI.addressOf(wide) }, lateArms)
lateObjectRejected("expired pointer", (o) => { o.target = expired }, lateArms)
lateObjectRejected("short Array", (o) => { o.list = Array(1, 2) }, lateArms)
lateObjectRejected("invalid last element", (o) => { o.list[2] = 40000 }, lateArms)
lateObjectRejected("nested Map", (o) => { o.choice = %{ "integer": 4 } }, lateArms)
lateObjectRejected("nested redefined slotValue", (o) => { o.choice = SlotForger { integer: 4 } },
    lateArms)
lateObjectRejected("missing selection", (o) => null, Array())
lateObjectRejected("duplicate selection", (o) => null,
    Arrays.append(lateArms, FFI.unionArm(Array("choice"), "real")))
lateObjectRejected("extraneous selection", (o) => null,
    Arrays.append(lateArms, FFI.unionArm(Array("nowhere"), "real")))
check("no nested forger ran", forgery.hits == 0)
overflowing: FFI.readAs(LateShape, late, lateArms)
overflowing.ratio = 1.0e300
FFI.writeFrom(late, overflowing, lateArms)
check("f32 overflow from an object rounds to infinity", late["ratio"] == (1.0 / 0.0))
overflowing.ratio = 0.5
check("valid object write", FFI.writeFrom(late, overflowing, lateArms) === late)
check("valid object write kept the borrow epoch", first.isLive(lentObjects) == true)

// ---- padding and unselected union bytes keep their contents

pattern(paddedStruct, 16)
FFI.writeFrom(paddedStruct, InnerShape { a: 5; b: 4.0 }, Array())
check("object write keeps struct padding",
    sameOctets(Arrays.take(Arrays.drop(octets(paddedStruct, 16), 4), 4), Array(164, 165, 166, 167)))
check("object write fields", (paddedStruct["a"] == 5) && (paddedStruct["b"] == 4.0))
pattern(paddedUnion, 16)
FFI.writeFrom(paddedUnion, PaddedShape { wide: 0 }, Array(whole("wide")))
check("object write keeps union bytes beyond the member",
    sameOctets(Arrays.drop(octets(paddedUnion, 16), 8), Array(168, 169, 170, 171, 172, 173, 174, 175)))
Tail: FFI.struct(Array(field("wide", FFI.i64), field("last", FFI.u8)))
check("tail-padded struct size", FFI.sizeOf(Tail) == 16)
check("tail-padded struct alignment", FFI.alignOf(Tail) == 8)
TailShape: {}
FFI.prototype(Tail, TailShape)
tail: FFI.allocate(Tail)
pattern(tail, 16)
tailBefore: octets(tail, 16)
check("tail object write answers the region",
    FFI.writeFrom(tail, TailShape { wide: -2; last: 200 }, Array()) === tail)
check("tail object fields", (tail["wide"] == -2) && (tail["last"] == 200))
check("tail padding keeps its pattern",
    sameOctets(Arrays.drop(octets(tail, 16), 9), Arrays.drop(tailBefore, 9)))
tailWritten: octets(tail, 16)
ordinary("a late out-of-range u8 is refused",
    () => FFI.writeFrom(tail, TailShape { wide: 9; last: 256 }, Array()))
check("the late refusal left every byte", sameOctets(tailWritten, octets(tail, 16)))
check("tail release", FFI.release(tail) === null)

// A nested object needs canonical slotValue only: its parent is never observed.
ChildLayout: FFI.struct(Array(field("parent", FFI.i32), field("v", FFI.i32)))
HolderLayout: FFI.struct(Array(field("head", FFI.i32), field("child", ChildLayout)))
HolderShape: {}
FFI.prototype(HolderLayout, HolderShape)
holderRegion: FFI.allocate(HolderLayout)
FFI.writeFields(holderRegion, %{ "head": 1; "child": %{ "parent": 2; "v": 3 } }, Array())
holderObject: FFI.readAs(HolderShape, holderRegion, Array())
check("nested parent field is a slot",
    holderObject.child.hasSlot("parent") && holderObject.child.hasSlot("v"))
check("nested parent field value", (holderObject.child.parent == 2) && (holderObject.child.v == 3))
holderObject.child.parent = 20
check("a nested parent field writes",
    FFI.writeFrom(holderRegion, holderObject, Array()) === holderRegion)
check("nested parent field written", holderRegion["child"]["parent"] == 20)
loudHits: { count: 0 }
LoudParent: {
    parent: () => {
        loudHits.count = loudHits.count + 1
        Error().signal()
    }
}
WrappedLayout: FFI.struct(Array(field("head", FFI.i32), field("inner", Inner)))
WrappedShape: {}
FFI.prototype(WrappedLayout, WrappedShape)
wrappedRegion: FFI.allocate(WrappedLayout)
check("an inherited nested parent redefinition is not observed",
    FFI.writeFrom(wrappedRegion, WrappedShape { head: 4; inner: LoudParent { a: 7; b: 0.5 } },
        Array()) === wrappedRegion)
check("nested values written", (wrappedRegion["head"] == 4) && (wrappedRegion["inner"]["a"] == 7))
check("the nested parent redefinition never ran", loudHits.count == 0)
for(root in Array(holderRegion, wrappedRegion)) {
    check("nested parent root release", FFI.release(root) === null)
}

// ---- pointers inside object snapshots stay capabilities

pointerObject: FFI.readAs(OuterShape, complex, Array())
check("object pointer is not an Integer", Integer.recognizes(pointerObject.next) == false)
check("object pointer passes to C", innerA(pointerObject.next) == 77)
ordinary("object pointer has no inferred extent", () => FFI.view(pointerObject.next, Inner))
ordinary("object pointer is not an owned resource", () => FFI.release(pointerObject.next))
FFI.writeFrom(complex, pointerObject, Array())
check("writeFrom keeps the pointer address", innerA(complex["next"]) == 77)
emptyObject: FFI.readAs(OuterShape, emptyNext, Array())
check("nullable pointer null slot", emptyObject.hasSlot("next") && (emptyObject.next === null))
check("null pointer writes back", FFI.writeFrom(emptyNext, emptyObject, Array()) === emptyNext)
// A pointer read from a region keeps that region as provenance, so the one in
// holderNext is still live; an expired capability is one of a released root.
danglingObject: FFI.readAs(OuterShape, holderNext, Array())
check("a read pointer of a live region writes",
    FFI.writeFrom(holderNext, danglingObject, Array()) === holderNext)
expiredObject: FFI.readAs(OuterShape, emptyNext, Array())
expiredObject.next = expired
emptyBytes: octets(emptyNext, FFI.sizeOf(Outer))
ordinary("writeFrom never revives an expired pointer",
    () => FFI.writeFrom(emptyNext, expiredObject, Array()))
check("expired refusal left the bytes", sameOctets(emptyBytes, octets(emptyNext, FFI.sizeOf(Outer))))
refusedObject: caught(NonParallelValue, () => ((x) => 1).parallel(pointerObject).value())
check("an object holding a pointer never crosses P", (refusedObject === null) == false)
PlainShape: {}
FFI.prototype(Inner, PlainShape)
plainSource: make()
plainSnapshot: FFI.readAs(PlainShape, plainSource, Array())
check("a plain snapshot crosses P", ((x) => x.a + 1).parallel(plainSnapshot).value() == 18)
check("plain source release", FFI.release(plainSource) === null)
check("a plain snapshot crosses P after release",
    ((x) => x.a + 1).parallel(plainSnapshot).value() == 18)

for(root in Array(selector, keyed, colliding, lateTarget, late, paddedUnion, paddedStruct, owner,
        holderNext, emptyNext)) {
    check("projection release", FFI.release(root) === null)
}

// ---- cleanup: every remaining allocation root is released explicitly

for(root in Array(made, again, wide, widened, pointee, complex, transformed, shaped, reshaped,
        choice, integral, real, scaled, octuple, flipped, seed, holder, fromNested,
        fromView, fromReadOnly, copied, source, unrelated, twin, independent, pair, paired)) {
    check("remaining release", FFI.release(root) === null)
}

print("FFM-GROUPS-PASS")
