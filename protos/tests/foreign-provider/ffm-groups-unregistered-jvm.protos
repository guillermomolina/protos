// A valid by-value group signature, ffi_test_group_reverse, whose physical
// shape is deliberately absent from the Native Image registration. On the
// JVM the standard linker supports it, so it is a genuine downcall. The host
// authorizes first=<absolute libffi_test.so> (native/ffi_test.c). Run by
// ProtosI144FfmFixtureAbiTest and dist/test_external_foreign_providers.py;
// never under Native Image (see ffm-groups-unregistered-native.protos).

FFI: import("std:ffi")

CheckFailure: Error {}

check: (label, condition) => {
    (condition === true).ifFalse(() => {
        failure: CheckFailure { label: label }
        failure.signal()
    })
    null
}

caught: (prototype, body) => {
    result: null
    prototype.handle(body, (error) => {
        result = error
        error
    })
    result
}

// f64 b at offset 0, i32 a at offset 8 and native trailing padding computed
// by std:ffi: the same size and alignment as an i32/f64 struct, a different
// physical layout, struct(D,I,padding(4)).
Reversed: FFI.struct(Array(FFI.field("b", FFI.f64), FFI.field("a", FFI.i32)))
check("reversed size", FFI.sizeOf(Reversed) == 16)
check("reversed alignment", FFI.alignOf(Reversed) == 8)
check("reversed a offset", FFI.offsetOf(Reversed, Array("a")) == 8)

first: import("ffi:first")
calls: FFI.bindPreserving(first, "ffi_test_group_calls_count", FFI.i32, Array())
reverse: FFI.bind(first, "ffi_test_group_reverse", Reversed, Array(Reversed))

input: FFI.allocate(Reversed)
input["b"] = 1.5
input["a"] = 10
before: calls()
result: reverse(input)
check("the C function was entered exactly once", calls() == (before + 1))
check("C-transformed b", result["b"] == 15.0)
check("C-transformed a", result["a"] == 7)
check("independent result", result !== input)
check("input unchanged", (input["b"] == 1.5) && (input["a"] == 10))
result["a"] = 0
check("result storage is independent", input["a"] == 10)
check("input release", FFI.release(input) === null)
check("result survives the input", result["b"] == 15.0)
check("result release", FFI.release(result) === null)
check("result released once", (caught(Error, () => FFI.release(result)) === null) == false)

print("FFM-UNREGISTERED-GROUP-JVM-PASS")
