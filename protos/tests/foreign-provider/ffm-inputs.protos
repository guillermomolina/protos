// LIB030: provider-private length-carrying inputs over the generic ABI fixture.
// Run only by ProtosI144FfmFixtureAbiTest under the fixture-only registration.
Assertions: import("std:test/assertions")

ffi: import("ffi-test:ffi_test")

signature: (returns, parameters) => {
    composed: ffi.signature(returns)
    for(parameter in parameters) { composed = ffi.param(composed, parameter) }
    composed
}
declare: (symbol, returns, parameters) => ffi.bind(symbol, signature(returns, parameters))
ordinary: (body) => {
    error: Assertions.signals(Error, body)
    Assertions.require(error.parent() === Error)
}

copyText: declare("ffi_test_input_copy", ffi.i32, Array(ffi.text, ffi.inputLength, ffi.copyDestructor))
copyOctets: declare("ffi_test_input_copy", ffi.i32, Array(ffi.octets, ffi.inputLength, ffi.copyDestructor))
byte: declare("ffi_test_input_byte", ffi.i32, Array(ffi.i32))
calls: declare("ffi_test_input_calls_count", ffi.i32, Array())
guarded: declare("ffi_test_input_was_guarded", ffi.i32, Array())
tail: declare("ffi_test_tail", ffi.i32, Array(ffi.utf8z, ffi.i32, ffi.out(ffi.remainder)))
expect: (values) => {
    index: 0
    for(value in values) {
        Assertions.require(byte(index) == value)
        index = index + 1
    }
    Assertions.require(byte(index) == -1)
}

// Exact strict UTF-8 octets, interior NUL kept, a non-NULL NUL-guarded copy
// whose length is provider-computed and which C copied during the call.
Assertions.require(copyText("a\u{0}b\u{E9}") == 5)
expect(Array(97, 0, 98, 195, 169))
Assertions.require(guarded() == 1)
Assertions.require(copyText("\u{1F642}") == 4)
expect(Array(240, 159, 153, 130))
// Empty input is a non-NULL zero-length region, not a NULL pointer.
Assertions.require(copyText("") == 0)
expect(Array())
// Octets transport: one character U+0000..U+00FF per octet, no text encoding.
Assertions.require(copyOctets("\u{0}\u{FF}\u{80}a") == 4)
expect(Array(0, 255, 128, 97))
Assertions.require(copyOctets("") == 0)

// Pre-entry refusals are ordinary Errors and never reach C.
before: calls()
ordinary(() => copyOctets("\u{100}"))
ordinary(() => copyOctets("\u{E9}\u{1F642}"))
for(value in Array(42, null, 1.5, true)) {
    ordinary(() => copyText(value))
    ordinary(() => copyOctets(value))
}
// Length and destructor are never Protos arguments: no address can be supplied.
ordinary(() => copyText("ab", 2))
ordinary(() => copyText("ab", 2, 0))
ordinary(() => copyOctets())
Assertions.require(calls() == before)
// 16 MiB is a std:sqlite policy, not a provider bound: larger inputs are admitted
// here up to the C int length domain (not exercised: it needs a 2 GiB value).
Assertions.require(copyOctets("xyz") == 3)
Assertions.require(byte(0) == 120)

// Positional rules: a length or copy destructor needs an input, a remainder
// needs a text input,
// and the private descriptors are never return types.
ordinary(() => ffi.param(ffi.signature(ffi.i32), ffi.inputLength))
ordinary(() => ffi.param(ffi.signature(ffi.i32), ffi.copyDestructor))
ordinary(() => ffi.param(signature(ffi.i32, Array(ffi.utf8z)), ffi.copyDestructor))
ordinary(() => ffi.param(signature(ffi.i32, Array(ffi.utf8z)), ffi.inputLength))
ordinary(() => ffi.param(signature(ffi.i32, Array(ffi.octets)), ffi.out(ffi.remainder)))
ordinary(() => ffi.param(ffi.signature(ffi.i32), ffi.out(ffi.remainder)))
ordinary(() => ffi.param(signature(ffi.i32, Array(ffi.utf8z)), ffi.remainder))
for(descriptor in Array(ffi.text, ffi.octets, ffi.inputLength, ffi.copyDestructor, ffi.remainder)) {
    ordinary(() => ffi.signature(descriptor))
}
ordinary(() => ffi.out(ffi.text))
ordinary(() => ffi.out(ffi.copyDestructor))

// Remainder: the unconsumed octets measured while the input is alive; NULL is
// absent and a tail outside the input is a ForeignError, never an address.
Assertions.require(tail("h\u{E9}llo", 0)[1] == 6)
Assertions.require(tail("h\u{E9}llo", 3)[1] == 3)
Assertions.require(tail("h\u{E9}llo", 6)[1] == 0)
Assertions.require(tail("h\u{E9}llo", -1)[1] === null)
escaped: Assertions.signals(Error, () => tail("h\u{E9}llo", 7))
Assertions.require(escaped.parent() === ForeignError)
textTail: declare("ffi_test_tail", ffi.i32, Array(ffi.text, ffi.i32, ffi.out(ffi.remainder)))
Assertions.require(textTail("a\u{0}bc", 1)[1] == 3)
