// Run with no provider. Import is authority-free; acquisition is denied.
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
Assertions.require(!SQLite.hasSlot("_terminalFutureFacility"))
Assertions.signals(SlotNotFound, () => { _terminalFutureFacility })
for(attempt in Array(1, 2)) {
    missing: Assertions.signals(Error, () => SQLite.openMemory())
    Assertions.require(missing.parent() === Error)
}
print("LIB029-MISSING-PASS")
