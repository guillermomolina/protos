// I085-B: the real JDK java.time.LocalDate through the external jdk:
// provider. Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/Assertions")

Date: import("jdk:date")

Assertions.require(Date.year("2026-10-08") == 2026)
Assertions.require(Date.month("2026-10-08") == 10)
Assertions.require(Date.month("2024-02-29") == 2)
Assertions.require(import("jdk:date") === Date)

// Invalid dates and incompatible arguments.
Assertions.signals(Error, () => Date.year("2026-13-08"))
Assertions.signals(Error, () => Date.month("2025-02-29"))
Assertions.signals(Error, () => Date.year("not a date"))
Assertions.signals(Error, () => Date.year(2026))

print("I085-B-JAVA-DATE-PASS")
