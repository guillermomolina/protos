// PLAT074-B2 declarations for the existing authorized FFM fixture host.
// Evaluating this source imports only std:ffi. Phase closures distinguish
// acquisition, binding and invocation without declaring any ABI in Java.
FFI: import("std:ffi")
acquireLibrary: () => import("ffi-test:ffi_test")
bindThreadId: (library) => FFI.bind(library, "ffi_test_thread_id", FFI.i64, Array())
prepare: () => {
    native: acquireLibrary()
    declare: (symbol, returns, parameters) => FFI.bind(native, symbol, returns, parameters)
    tid: bindThreadId(native)
    openProbe: declare("ffi_test_open_probe", FFI.i32,
        Array(FFI.utf8z, FFI.i32, FFI.out(FFI.i32), FFI.out(FFI.i64)))
    destroyTid: declare("ffi_test_last_destroy_thread_id", FFI.i64, Array())
    live: declare("ffi_test_live_count", FFI.i32, Array())
    destroyed: declare("ffi_test_destroyed_count", FFI.i32, Array())
    crossThreadDestroyed: declare("ffi_test_cross_thread_destroy_count", FFI.i32, Array())
    counterType: FFI.opaque(native, "ffi_test_counter")
    owned: FFI.owned(counterType, "ffi_test_counter_free", FFI.i32)
    make: declare("ffi_test_counter_new", owned, Array(FFI.i64))
    increment: declare("ffi_test_counter_increment", FFI.i64, Array(counterType))
    kept: null
    keptSecond: null
    keptThird: null

    // Only native integral values and Arrays leave the restricted thread normally.
    // The handle export is used solely for negative admission/transfer tests.
    {
        library: native
        threadId: () => tid()
        open: (path, mode) => openProbe(path, mode)
        lastDestroyThreadId: () => destroyTid()
        liveCount: () => live()
        destroyedCount: () => destroyed()
        crossThreadDestroyCount: () => crossThreadDestroyed()
        ordinarySegment: () => 41
        createOwned: () => make(40)
        incrementOwned: (handle) => increment(handle)
        releaseOwned: (handle) => FFI.release(handle)
        releaseHere: () => {
            handle: make(40)
            value: increment(handle)
            status: FFI.release(handle)
            Array(value, status, destroyTid(), live(), destroyed())
        }
        keepForClose: () => {
            kept = make(40)
            increment(kept)
        }
        keepManyForClose: () => {
            kept = make(40)
            keptSecond = make(50)
            keptThird = make(60)
            firstValue: increment(kept)
            thirdValue: increment(keptThird)
            status: FFI.release(keptSecond)
            Array(firstValue, thirdValue, status)
        }
        retained: () => kept
        retainedThird: () => keptThird
    }
}

{
    acquireLibrary: acquireLibrary
    bindThreadId: bindThreadId
    invokeBound: (bound) => bound()
    prepare: prepare
}
