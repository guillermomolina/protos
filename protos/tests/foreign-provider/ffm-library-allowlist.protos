// Two host-authorized C libraries under the single distributable protos-ffm
// provider. The host runs this program with exactly:
//   --allow-library first=<absolute libffi_test.so>
//   --allow-library second=<absolute libffi_second.so>
// and passes, as the only application argument, a file path it selected in
// its own temporary directory. No Filesystem or Network grant is given: the
// native write below uses operating-system process authority only, and the
// host verifies the file afterwards.
// Run by dist/test_external_foreign_providers.py.

Assertions: import("std:test/assertions")
FFI: import("std:ffi")
first: import("ffi:first")
second: import("ffi:second")

// ---- both libraries load and are called independently, each with its own symbols

identity: FFI.bind(first, "ffi_test_i32_identity", FFI.i32, Array(FFI.i32))
add: FFI.bind(first, "ffi_test_add_i32", FFI.i32, Array(FFI.i32, FFI.i32))
triple: FFI.bind(second, "ffi_second_triple", FFI.i32, Array(FFI.i32))
Assertions.require(identity(41) == 41)
Assertions.require(add(40, 2) == 42)
Assertions.require(triple(14) == 42)

// Symbols are resolved only in the library of their own alias.
Assertions.signals(ForeignError, () => FFI.bind(first, "ffi_second_triple", FFI.i32, Array(FFI.i32)))
Assertions.signals(ForeignError, () => FFI.bind(second, "ffi_test_i32_identity", FFI.i32, Array(FFI.i32)))
Assertions.signals(ForeignError, () => FFI.bind(second, "ffi_second_no_such_symbol", FFI.i32, Array()))

// ---- native global state stays observable inside the authorized library

store: FFI.bind(second, "ffi_second_store", FFI.void, Array(FFI.i64))
load: FFI.bind(second, "ffi_second_load", FFI.i64, Array())
Assertions.require(store(9007199254740993) === null)
Assertions.require(load() == 9007199254740993)
store(-7)
Assertions.require(load() == -7)

// ---- ordinary Protos Closures and results

total: 0
for(value in Array(1, 2, 3)) {
    total = total + triple(value)
}
Assertions.require(total == 18)
composed: (value) => { identity(triple(value)) }
Assertions.require(composed(5) == 15)

// ---- a third, unauthorized alias does not work

third: Assertions.signals(ForeignError, () => import("ffi:third"))
Assertions.require(third.foreignCategory == "unauthorized-library")

// ---- guest capabilities are not implied by native library authorization

Assertions.signals(Error, () => filesystem)
Assertions.signals(Error, () => network)

// ---- the authorized C function writes natively to the host-selected file

marker: FFI.bind(second, "ffi_second_write_marker", FFI.i32, Array(FFI.utf8z))
Assertions.require(marker(process.args()[0]) == 0)

print("FFM-LIBRARY-ALLOWLIST-PASS")
