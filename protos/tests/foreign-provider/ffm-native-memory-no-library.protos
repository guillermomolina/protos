// Native memory with the FFM provider configured but no library granted:
// allocation needs an available provider, never an acquired C library, and
// grants no library authority. Run by dist/test_external_foreign_providers.py
// without any --allow-library option.

FFI: import("std:ffi")

CheckFailure: Error {}

check: (label, condition) => {
    (condition === true).ifFalse(() => {
        failure: CheckFailure { label: label }
        failure.signal()
    })
    null
}

Point: FFI.struct(Array(FFI.field("x", FFI.i32), FFI.field("y", FFI.f64)))
check("cType", FFI.cType("long long") === FFI.i64)
point: FFI.allocate(Point)
check("zeroed", (point["x"] == 0) && (point["y"] == 0.0))
point["x"] = -5
point["y"] = 1.5
check("typed access", (point["x"] == -5) && (point["y"] == 1.5))
bytes: FFI.slice(point, 0, 4)
check("byte alias", (bytes[0] == 251) && (bytes[3] == 255))
check("view", FFI.view(FFI.addressOf(point), Point)["y"] == 1.5)
check("release", FFI.release(point) === null)

refused: null
ForeignError.handle(() => import("ffi:first"), (error) => {
    refused = error
    error
})
check("allocation grants no library", (refused === null) == false)
check("unauthorized library", refused.foreignCategory == "unauthorized-library")

print("FFM-NATIVE-MEMORY-NO-LIBRARY-PASS")
