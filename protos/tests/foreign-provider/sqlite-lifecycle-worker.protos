// Secondary-Actor behavior for sqlite-lifecycle.protos. Importing std:sqlite
// needs no native authority; opening a database needs the RootActor's.

// Answers whether body signals exactly an ordinary Error (not ForeignError or
// SQLiteError).
refusedOrdinarily: (body) => {
    refused: null
    Error.handle(body, (error) => {
        refused = error
        error
    })
    if(refused === null) { ^false }
    refused.parent() === Error
}

// Bootstrap binding of the worker Actor.
worker: () => {
    behavior: {
        importSucceeds: () => {
            SQLite: import("std:sqlite")
            (SQLite === null) == false
        }
        openMemoryRefused: () => {
            SQLite: import("std:sqlite")
            refusedOrdinarily(() => SQLite.openMemory())
        }
        openFileRefused: (path) => {
            SQLite: import("std:sqlite")
            refusedOrdinarily(() => SQLite.openFile(path, "readOnly"))
        }
        echo: (value) => value
    }
    behavior
}
