// PLAT074-D1 test-only native authority probe: the initial FILE entry of a
// Protos CLI JVM launched by the JUnit harness, with or without the pre-exec
// Landlock launcher. Not a public API.
//
// Both database paths are bootstrap arguments; nothing is read from IPC. The
// real SQLite C library is reached through the same SqliteEngine module and
// FFM provider as the helper. Only read-only SQL runs (integrity_check), so a
// successfully opened existing database is not modified by the probe.
//
// stdout, one line each:
//   AUTHORIZED_OPENED <integrity>  |  AUTHORIZED_FAILED
//   EXTERIOR_OPENED <integrity>    |  EXTERIOR_DENIED
// A failed authorized open makes the exterior result meaningless; the harness
// also requires an unrestricted control run before reading a denial as
// confinement evidence.
ProcessStreams: import("std:io/process_streams")
SqliteEngine: import("./SqliteEngine.protos")

arguments: process.args()
writer: ProcessStreams.stdoutWriter(process)

emit: (text) => {
    writer.writeLine(text).value()
    writer.flush().value()
}

if(arguments.size() != 2) {
    emit("PROBE_USAGE")
    Error().signal()
}

// Opens `path`, runs one real SQLite query and closes. Answers the integrity
// result, or null when SQLite could not open or read the database.
attemptOpen: (path) => {
    result: null
    Error.handle(() => {
        engine: SqliteEngine.openFile(path)
        (() => {
            if(engine.integrityOk()) { result = "true" } else { result = "false" }
        }).ensure(() => {
            engine.close()
        })
    }, (error) => {
        result = null
    })
    result
}

authorized: attemptOpen(arguments[0])
if(authorized === null) {
    emit("AUTHORIZED_FAILED")
} else {
    emit("AUTHORIZED_OPENED " + authorized)
    exterior: attemptOpen(arguments[1])
    if(exterior === null) {
        emit("EXTERIOR_DENIED")
    } else {
        emit("EXTERIOR_OPENED " + exterior)
    }
}
