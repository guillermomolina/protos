// PLAT074-D2 isolated durable SQLite helper: the initial FILE entry of a
// separate Protos CLI JVM, launched by the JUnit harness behind the D1-R1
// Landlock launcher. Test-only; not a public API.
//
// One RootActor, one connection, one request at a time, protocol version 2.
// stdout carries only protocol lines; stderr only diagnostics. The database
// path is the single application argument, never accepted from the channel.
//
// PLAT074-D3 mode: application arguments PATH IDENTITY_HI IDENTITY_LO
// [PROVISION], all from the trusted bootstrap. Without PROVISION the persisted
// database identity must already equal the pair; with PROVISION a brand-new
// database (no schema object at all) receives it once. Any failure ends the
// process before READY. Otherwise READY is followed by one DATABASE_IDENTITY
// event and the unchanged protocol v2 loop. The one-argument D2 mode is
// unchanged and publishes no identity.
ProcessStreams: import("std:io/process_streams")
JSON: import("std:json/json")
Protocol: import("./DurableProtocol.protos")
SqliteEngine: import("./SqliteEngine.protos")

arguments: process.args()
reader: ProcessStreams.stdinReader(process)
writer: ProcessStreams.stdoutWriter(process)
diagnostics: ProcessStreams.stderrWriter(process)

diagnose: (text) => {
    diagnostics.writeLine(text).value()
    diagnostics.flush().value()
}

respond: (text) => {
    writer.writeLine(text).value()
    writer.flush().value()
}

// Exact canonical signed 64-bit Integer text; never a protocol value.
identityArgument: (text) => {
    node: JSON.parse(text)
    (node.kind === "number").ifFalse(() => { Error().signal() })
    (node.value.exponent == 0).ifFalse(() => { Error().signal() })
    value: node.value.coefficient
    Integer.recognizes(value).ifFalse(() => { Error().signal() })
    ((value >= (0 - 9223372036854775807 - 1)) && (value <= 9223372036854775807)).ifFalse(() => {
        Error().signal()
    })
    (JSON.encode(JSON.number(value, 0)) == text).ifFalse(() => { Error().signal() })
    value
}

identityHi: null
identityLo: null
provision: false
if((arguments.size() != 1) && (arguments.size() != 3) && (arguments.size() != 4)) {
    diagnose("durable helper requires PATH or PATH IDENTITY_HI IDENTITY_LO [PROVISION]")
    Error().signal()
}
if(arguments.size() >= 3) {
    bootstrapValid: false
    Error.handle(() => {
        identityHi = identityArgument(arguments[1])
        identityLo = identityArgument(arguments[2])
        bootstrapValid = true
    }, (error) => {
        bootstrapValid = false
    })
    if(arguments.size() == 4) {
        if(arguments[3] == "PROVISION") {
            provision = true
        } else {
            bootstrapValid = false
        }
    }
    if(!bootstrapValid) {
        diagnose("DURABLE_DATABASE_IDENTITY_REFUSED BOOTSTRAP")
        Error().signal()
    }
}

// Operations that need the live connection. PING, CLOSE and STOP do not.
connectionOperations: Array("INIT", "APPLY_ONCE", "LOOKUP", "COUNT", "RECEIPTS", "SUM",
    "INTEGRITY", "HOLD_BEFORE_COMMIT", "HOLD_AFTER_COMMIT")

listed: (names, candidate) => {
    found: false
    for(name in names) {
        if(name == candidate) { found = true }
    }
    found
}

engine: SqliteEngine.openFile(arguments[0])
lastAdmittedId: 0
running: true
// Admission must end without a clean protocol exit; the process fails after
// the connection cleanup below has been attempted.
fatal: false

endFailClosed: (event) => {
    diagnose(event)
    fatal = true
    running = false
}

// One bounded line. A framing failure permanently fails the reader, so
// admission ends fail-closed.
nextLine: () => {
    line: null
    failed: false
    Error.handle(() => {
        line = reader.readLine(4096).value()
    }, (error) => {
        failed = true
    })
    if(failed) {
        endFailClosed("FRAMING_REJECTED")
        line = null
    }
    line
}

// TEST-ONLY continuation of a held operation: exactly one admitted CONTINUE
// with a strictly increasing transport id. Waiting executes no SQL.
awaitContinuation: (heldId) => {
    released: false
    line: nextLine()
    if(line !== null) {
        continuation: Protocol.decodeRequest(line)
        if(continuation.admitted) {
            if((continuation.operation == "CONTINUE") && (continuation.id > heldId)) {
                lastAdmittedId = continuation.id
                released = true
            }
        }
    }
    released
}

reply: (id, outcome) => Protocol.encodeResponse(id, outcome.status, outcome.value, null)

// Read-only or idempotent operation: an SQLite failure is a bounded ERROR.
attempt: (id, operation) => {
    text: null
    Error.handle(() => {
        text = Protocol.encodeResponse(id, "OK", operation(), null)
    }, (error) => {
        text = null
    })
    if(text === null) { text = Protocol.encodeResponse(id, "ERROR", null, "SQLITE_FAILURE") }
    text
}

// APPLY_ONCE and its TEST-ONLY held variants share the one transactional
// engine method; `hold` is null, "BEFORE" or "AFTER".
applyDurable: (request, hold) => {
    id: request.id
    // Set when a hold ended without a valid continuation: nothing is sent.
    withheld: false
    beforeCommit: null
    afterCommit: null
    if(hold == "BEFORE") {
        beforeCommit = () => {
            diagnose("DURABLE_PRECOMMIT")
            if(!awaitContinuation(id)) {
                withheld = true
                // The engine rolls the uncommitted transaction back locally;
                // no reply claims that outcome.
                Error().signal()
            }
        }
    }
    if(hold == "AFTER") {
        afterCommit = () => {
            diagnose("DURABLE_COMMITTED_BEFORE_ACK")
            if(!awaitContinuation(id)) { withheld = true }
        }
    }
    outcome: null
    Error.handle(() => {
        outcome = engine.applyOnce(request.clientId, request.operationId, request.value,
            beforeCommit, afterCommit)
    }, (error) => {
        outcome = null
    })
    if(withheld) {
        endFailClosed("DURABLE_ACK_WITHHELD")
    } else {
        if(outcome === null) {
            hazard: engine.writeHazard()
            if(hazard === null) {
                respond(Protocol.encodeResponse(id, "ERROR", null, "SQLITE_FAILURE"))
            } else {
                if(hazard == "RECONCILE_REQUIRED") {
                    // Never a rollback claim: a new session must reconcile.
                    respond(Protocol.encodeResponse(id, "ERROR", null, "RECONCILE_REQUIRED"))
                    endFailClosed("DURABLE_RECONCILE_REQUIRED")
                } else {
                    respond(Protocol.encodeResponse(id, "ERROR", null, "SQLITE_FAILURE"))
                    endFailClosed("DURABLE_SESSION_BROKEN")
                }
            }
        } else {
            if(outcome.status == "BUSY") {
                respond(Protocol.encodeResponse(id, "ERROR", null, "BUSY"))
            } else {
                respond(reply(id, outcome))
            }
        }
    }
}

lookup: (request) => {
    text: null
    Error.handle(() => {
        found: engine.lookupReceipt(request.clientId, request.operationId)
        if(found === null) {
            text = Protocol.encodeResponse(request.id, "ABSENT", null, null)
        } else {
            text = Protocol.encodeResponse(request.id, "FOUND", found, null)
        }
    }, (error) => {
        text = null
    })
    if(text === null) { text = Protocol.encodeResponse(request.id, "ERROR", null, "SQLITE_FAILURE") }
    text
}

dispatch: (request) => {
    id: request.id
    operation: request.operation
    if(listed(connectionOperations, operation) && !engine.isOpen()) {
        respond(Protocol.encodeResponse(id, "ERROR", null, "CLOSED"))
    } else {
        if(operation == "PING") { respond(Protocol.encodeResponse(id, "OK", 0, null)) }
        if(operation == "CONTINUE") {
            respond(Protocol.encodeResponse(id, "ERROR", null, "UNEXPECTED_CONTINUE"))
        }
        if(operation == "INIT") { respond(attempt(id, () => engine.initializeDurable())) }
        if(operation == "APPLY_ONCE") { applyDurable(request, null) }
        if(operation == "HOLD_BEFORE_COMMIT") { applyDurable(request, "BEFORE") }
        if(operation == "HOLD_AFTER_COMMIT") { applyDurable(request, "AFTER") }
        if(operation == "LOOKUP") { respond(lookup(request)) }
        if(operation == "COUNT") { respond(attempt(id, () => engine.count())) }
        if(operation == "RECEIPTS") { respond(attempt(id, () => engine.receiptCount())) }
        if(operation == "SUM") { respond(attempt(id, () => engine.sum())) }
        if(operation == "INTEGRITY") { respond(attempt(id, () => engine.integrityOk())) }
        // A close failure is irreversible: it is not caught, so it ends
        // admission and fails the process after cleanup.
        if(operation == "CLOSE") {
            engine.close()
            respond(Protocol.encodeResponse(id, "OK", null, null))
        }
        if(operation == "STOP") {
            engine.close()
            respond(Protocol.encodeResponse(id, "OK", null, null))
            running = false
        }
    }
}

(() => {
    // Per-connection durability (synchronous=FULL, bounded busy wait) before
    // any request is admitted.
    engine.configureDurable()
    // PLAT074-D3: the database identity is established before READY; a
    // refusal publishes nothing on stdout and fails the process.
    if(identityHi !== null) {
        verified: false
        Error.handle(() => {
            if(provision) { engine.provisionDatabaseIdentity(identityHi, identityLo) }
            engine.requireDatabaseIdentity(identityHi, identityLo)
            verified = true
        }, (error) => {
            verified = false
        })
        if(!verified) { endFailClosed("DURABLE_DATABASE_IDENTITY_REFUSED") }
    }
    if(running) {
        respond(Protocol.encodeReady())
        if(identityHi !== null) { respond(Protocol.encodeDatabaseIdentity(identityHi, identityLo)) }
    }
    while(running) {
        line: nextLine()
        if(line === null) {
            // EOF or framing failure: admission ends. Never implies rollback
            // of a reply the client did not receive.
            running = false
        } else {
            request: Protocol.decodeRequest(line)
            if(!request.admitted) {
                respond(Protocol.encodeResponse(request.id, "ERROR", null, request.reason))
            } else {
                if(request.id <= lastAdmittedId) {
                    respond(Protocol.encodeResponse(request.id, "ERROR", null, "NON_INCREASING_ID"))
                } else {
                    lastAdmittedId = request.id
                    dispatch(request)
                }
            }
        }
    }
}).ensure(() => {
    // Idempotent: a connection already closed by CLOSE/STOP is not released again.
    engine.close()
})

if(fatal) {
    diagnose("ADMISSION_FAILED_CLOSED")
    Error().signal()
}
