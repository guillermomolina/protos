//! Explicit performance diagnostic of the private SQLite v4 transport costs.
//! Not a suite test (foreign-provider/ is excluded from discovery) and not
//! run by the general regression: ProtosIsolatedSqliteCodecDiagnostic copies
//! this file next to the production IsolatedProtocol.protos and runs it.
//!
//! Every measured operation runs here, in Protos, with the real modules. It is
//! bracketed by DIAG_BEGIN / DIAG_END lines, flushed immediately, which the
//! Java harness timestamps; this program reads no clock. Integrity checks run
//! after DIAG_END, outside the measured interval, and a failed check signals.
//! No FFM, SQLite, helper or Landlock is involved.
//!
//! Arguments: the number of warm-up repetitions, the number of measured
//! repetitions, then one or more sizes in octets (each 8192 * 2^k).
Base64url: import("std:text/base64url")
JSON: import("std:json/json")
Arrays: import("std:collections/array")
Streams: import("std:io/process_streams")
Protocol: import("./IsolatedProtocol.protos")

CHUNK_OCTETS: 2304
out: Streams.stdoutWriter(process)
report: (line) => {
    out.writeLine(line).value()
    out.flush().value()
}
require: (condition) => { condition.ifFalse(() => { Error().signal() }) }

// A canonical decimal argument, read through the JSON number syntax.
integerArgument: (text) => {
    node: JSON.parse(text)
    require((node.kind === "number") && (node.value.exponent == 0))
    node.value.coefficient
}
arguments: process.args()
require(arguments.size() >= 3)
warmup: integerArgument(arguments[0])
measured: integerArgument(arguments[1])
sizes: Array()
argumentIndex: 2
while(argumentIndex < arguments.size()) {
    sizes = Arrays.append(sizes, integerArgument(arguments[argumentIndex]))
    argumentIndex = argumentIndex + 1
}

// Reproducible BLOB: zeros, low and non-ASCII octets. Built once per size
// through the native Latin1 path; not measured.
blobOf: (size) => {
    unit: Encoding.Latin1.encode("")
    n: 0
    while(n < 8192) {
        octet: n % 251
        if((n % 7) == 0) { octet = 0 }
        unit.add(octet)
        n = n + 1
    }
    text: Encoding.Latin1.decode(unit)
    while(Encoding.Latin1.encode(text).size() < size) { text = text + text }
    // Doubling from 8192 octets reaches every 8192 * 2^k size exactly.
    sized: Encoding.Latin1.encode(text)
    require(sized.size() == size)
    sized
}

// Reproducible TEXT of exactly `size` UTF-8 octets: NUL, 2- and 4-octet scalars.
textOf: (size) => {
    text: "a\u{0}\u{E9}\u{1F642}"
    while(Encoding.UTF8.encode(text).size() < size) { text = text + text }
    require(Encoding.UTF8.encode(text).size() == size)
    text
}

fragmentCount: (total) => {
    count: (total + CHUNK_OCTETS - 1).div(CHUNK_OCTETS)
    if(count == 0) { count = 1 }
    count
}

sameOctets: (left, right) => (left.size() == right.size()) &&
    (Encoding.Latin1.decode(left) == Encoding.Latin1.decode(right))

completed: () => { { value: () => null } }

// Canonical decimal text of an Integer, through the JSON number syntax.
decimal: (value) => JSON.encode(JSON.number(value, 0))

// One measured or warm-up execution of `body`, answering its result.
measure: (operation, kind, size, fragments, phase, repetition, body) => {
    label: operation + " " + kind + " " + decimal(size) + " " + decimal(fragments) + " " + phase + " " +
        decimal(repetition)
    report("DIAG_BEGIN " + label)
    result: body()
    report("DIAG_END " + label)
    result
}

run: (kind, octets, value) => {
    size: octets.size()
    fragments: fragmentCount(size)
    total: warmup + measured
    repetition: 0
    while(repetition < total) {
        phase: "warmup"
        if(repetition >= warmup) { phase = "measured" }
        m: (operation, body) => measure(operation, kind, size, fragments, phase, repetition, body)
        if(kind == "blob") {
            // 1. Range copy into fragments: the same per-octet idiom as the protocol writer.
            chunks: m("copy", () => {
                copied: Array()
                fragment: 0
                while(fragment < fragments) {
                    chunk: Encoding.Latin1.encode("")
                    position: fragment * CHUNK_OCTETS
                    end: position + CHUNK_OCTETS
                    if(end > size) { end = size }
                    while(position < end) {
                        chunk.add(octets[position])
                        position = position + 1
                    }
                    copied = Arrays.append(copied, chunk)
                    fragment = fragment + 1
                }
                copied
            })
            require(chunks.size() == fragments)
            // 2. Base64url.encode of every fragment.
            encoded: m("base64-encode", () => {
                texts: Array()
                for(chunk in chunks) { texts = Arrays.append(texts, Base64url.encode(chunk)) }
                texts
            })
            // 3. Base64url.decode of every fragment.
            decoded: m("base64-decode", () => {
                parts: Array()
                for(text in encoded) { parts = Arrays.append(parts, Base64url.decode(text)) }
                parts
            })
            index: 0
            while(index < fragments) { require(sameOctets(chunks[index], decoded[index])); index = index + 1 }
            // 4. JSON.encode of protocol data lines (the members of a streamed "data" line).
            lines: m("json-encode", () => {
                encodedLines: Array()
                fragment: 0
                while(fragment < fragments) {
                    encodedLines = Arrays.append(encodedLines, JSON.encode(JSON.object(
                        "v", JSON.number(4, 0), "s", JSON.number(2, 0), "k", JSON.string("data"),
                        "session", JSON.number(7, 0), "re", JSON.number(1, 0), "c", JSON.number(0, 0),
                        "t", JSON.string("blob"), "o", JSON.number(size, 0), "i", JSON.number(fragment, 0),
                        "n", JSON.number(fragments, 0), "d", JSON.string(encoded[fragment]))))
                    fragment = fragment + 1
                }
                encodedLines
            })
            // 5. JSON.parse of the same lines.
            parsed: m("json-parse", () => {
                nodes: Array()
                for(line in lines) { nodes = Arrays.append(nodes, JSON.parse(line)) }
                nodes
            })
            index = 0
            while(index < fragments) { require(parsed[index].value["d"].value == encoded[index]); index = index + 1 }
            // 6. Reassembly by received.add, as the protocol reader does.
            received: m("reassemble", () => {
                whole: Encoding.Latin1.encode("")
                for(part in decoded) { for(octet in part) { whole.add(octet) } }
                whole
            })
            require(sameOctets(received, octets))
        } else {
            // 7. Strict UTF-8 decoding of the complete TEXT octets.
            text: m("utf8-decode", () => Encoding.UTF8.decode(octets))
            require(text == value)
        }
        // 8. Complete v4 STEP row: production writer to a local line sink, then
        // the production reader over those lines (no SQLite, no channel).
        frames: m("v4-write", () => {
            written: Array()
            sink: {
                writeLine: (line) => { written = Arrays.append(written, line); completed() }
                flush: () => completed()
            }
            Protocol.writeRow(sink, 2, 7, 1, Array(Protocol.rowColumn(null, kind == "text", octets)))
            written
        })
        require(frames.size() == (fragments + 2))
        row: m("v4-read", () => {
            position: 0
            reader: {
                readLine: (limit) => {
                    line: null
                    if(position < frames.size()) { line = frames[position]; position = position + 1 }
                    { value: () => line }
                }
            }
            Protocol.readStepReply(reader, 2, 7, 1)
        })
        if(kind == "text") {
            require(row.columns[0].value == value)
        } else {
            require(sameOctets(row.columns[0].value, octets))
        }
        repetition = repetition + 1
    }
}

for(size in sizes) {
    require((size > 0) && ((size % 8) == 0))
    blob: blobOf(size)
    run("blob", blob, blob)
    text: textOf(size)
    run("text", Encoding.UTF8.encode(text), text)
}
report("DIAG_COMPLETE")
