// PLAT074-D0 experimental JSON Lines messages. Test-only: this is neither a
// normative protocol nor an approved production format. It owns no native
// authority and never names files, libraries, symbols, SQL or Protos code.
JSON: import("std:json/json")

// Private lexical scope; only the closures published in `surface` below are
// reachable through this SOURCE's bindings.
_protocol: (() => {
    version: 1
    lineLimit: 4096
    operationLimit: 32
    maxInteger: 9223372036854775807
    minInteger: 0 - 9223372036854775807 - 1
    requestFields: Array("version", "id", "op", "value")
    responseFields: Array("version", "id", "status", "value", "error")
    readyFields: Array("version", "event")
    statuses: Array("OK", "ERROR", "UNCERTAIN")
    reasons: Array("MALFORMED", "OVERSIZED", "INVALID_VERSION", "INVALID_ID",
        "INVALID_OPERATION", "INVALID_VALUE", "NON_INCREASING_ID",
        "UNSUPPORTED_OPERATION", "CLOSED", "NO_TRANSACTION", "SQLITE_FAILURE",
        "CONNECTION_LOST")

    fail: () => {
        Error().signal()
    }

    contains: (names, candidate) => {
        found: false
        for(name in names) {
            if(name == candidate) { found = true }
        }
        found
    }

    isI64: (value) => {
        result: false
        if(Integer.recognizes(value)) {
            result = (value >= minInteger) && (value <= maxInteger)
        }
        result
    }

    isId: (value) => {
        result: false
        if(isI64(value)) { result = value > 0 }
        result
    }

    isOperation: (value) => {
        result: false
        if(String.recognizes(value)) {
            result = (value.size() > 0) && (value.size() <= operationLimit)
        }
        result
    }

    // Exact octet bound of one line before its terminator.
    withinLine: (text) => Encoding.UTF8.encode(text).size() <= lineLimit

    // A JSON object node with exactly `names` as members: no extra fields.
    requireExactObject: (node, names) => {
        (node.kind === "object").ifFalse(() => { fail() })
        (node.value.size() == names.size()).ifFalse(() => { fail() })
        for(name in names) {
            node.value.containsKey(name).ifFalse(() => { fail() })
        }
        node.value
    }

    // Exact JSON integer: Integer coefficient and exponent zero; never a
    // fraction, an approximation or a value outside the signed 64-bit domain.
    exactInteger: (node) => {
        (node.kind === "number").ifFalse(() => { fail() })
        coefficient: node.value.coefficient
        Integer.recognizes(coefficient).ifFalse(() => { fail() })
        (node.value.exponent == 0).ifFalse(() => { fail() })
        isI64(coefficient).ifFalse(() => { fail() })
        coefficient
    }

    nullOrInteger: (node) => {
        copied: null
        if(node.kind !== "null") { copied = exactInteger(node) }
        copied
    }

    stringValue: (node) => {
        (node.kind === "string").ifFalse(() => { fail() })
        node.value
    }

    integerNode: (value) => JSON.number(value, 0)

    valueNode: (value) => {
        node: null
        if(value === null) {
            node = JSON.nullValue()
        } else {
            if((value === true) || (value === false)) {
                node = JSON.boolean(value)
            } else {
                isI64(value).ifFalse(() => { fail() })
                node = integerNode(value)
            }
        }
        node
    }

    encodeLine: (root) => {
        text: JSON.encode(root)
        withinLine(text).ifFalse(() => { fail() })
        text
    }

    encodeResponse: (id, status, value, reason) => {
        idNode: JSON.nullValue()
        if(id !== null) { idNode = integerNode(id) }
        errorNode: JSON.nullValue()
        if(reason !== null) { errorNode = JSON.object("reason", JSON.string(reason)) }
        encodeLine(JSON.object("version", integerNode(version), "id", idNode,
            "status", JSON.string(status), "value", valueNode(value), "error", errorNode))
    }

    encodeRequest: (id, operation, value) => {
        isId(id).ifFalse(() => { fail() })
        isOperation(operation).ifFalse(() => { fail() })
        if(value !== null) { isI64(value).ifFalse(() => { fail() }) }
        encodeLine(JSON.object("version", integerNode(version), "id", integerNode(id),
            "op", JSON.string(operation), "value", valueNode(value)))
    }

    // Admission result: a fresh object of copied, validated Protos values.
    // A rejection is never an operation; it carries the request id only when
    // that id itself was valid, so the reply can be correlated.
    decodeRequest: (text) => {
        reason: "MALFORMED"
        echoedId: null
        admitted: null
        Error.handle(() => {
            String.recognizes(text).ifFalse(() => { fail() })
            reason = "OVERSIZED"
            withinLine(text).ifFalse(() => { fail() })
            reason = "MALFORMED"
            members: requireExactObject(JSON.parse(text), requestFields)
            reason = "INVALID_VERSION"
            (exactInteger(members["version"]) == version).ifFalse(() => { fail() })
            reason = "INVALID_ID"
            id: exactInteger(members["id"])
            isId(id).ifFalse(() => { fail() })
            echoedId = id
            reason = "INVALID_OPERATION"
            operation: stringValue(members["op"])
            isOperation(operation).ifFalse(() => { fail() })
            reason = "INVALID_VALUE"
            value: nullOrInteger(members["value"])
            admitted = {
                admitted: true
                id: id
                operation: operation
                value: value
                reason: null
            }
        }, (error) => {
            admitted = null
        })
        if(admitted === null) {
            admitted = {
                admitted: false
                id: echoedId
                operation: null
                value: null
                reason: reason
            }
        }
        admitted.freeze()
        admitted
    }

    encodeSuccess: (id, value) => {
        isId(id).ifFalse(() => { fail() })
        encodeResponse(id, "OK", value, null)
    }

    // `id` is null only when the rejected request carried no valid id.
    encodeFailure: (id, reason) => {
        if(id !== null) { isId(id).ifFalse(() => { fail() }) }
        contains(reasons, reason).ifFalse(() => { fail() })
        encodeResponse(id, "ERROR", null, reason)
    }

    // Signals an Error for any response outside the D0 contract.
    decodeResponse: (text) => {
        String.recognizes(text).ifFalse(() => { fail() })
        withinLine(text).ifFalse(() => { fail() })
        members: requireExactObject(JSON.parse(text), responseFields)
        (exactInteger(members["version"]) == version).ifFalse(() => { fail() })
        status: stringValue(members["status"])
        contains(statuses, status).ifFalse(() => { fail() })
        id: null
        if(members["id"].kind !== "null") {
            id = exactInteger(members["id"])
            isId(id).ifFalse(() => { fail() })
        }
        valueMember: members["value"]
        value: null
        if(valueMember.kind === "boolean") {
            value = valueMember.value
        } else {
            value = nullOrInteger(valueMember)
        }
        errorMember: members["error"]
        reason: null
        if(status == "OK") {
            (id !== null).ifFalse(() => { fail() })
            (errorMember.kind === "null").ifFalse(() => { fail() })
        } else {
            (value === null).ifFalse(() => { fail() })
            errorFields: requireExactObject(errorMember, Array("reason"))
            reason = stringValue(errorFields["reason"])
            contains(reasons, reason).ifFalse(() => { fail() })
        }
        response: {
            id: id
            status: status
            value: value
            reason: reason
        }
        response.freeze()
        response
    }

    // Startup event. It is not a reply to any request and carries no id.
    encodeReady: () => encodeLine(JSON.object("version", integerNode(version),
        "event", JSON.string("READY")))

    decodeReady: (text) => {
        String.recognizes(text).ifFalse(() => { fail() })
        withinLine(text).ifFalse(() => { fail() })
        members: requireExactObject(JSON.parse(text), readyFields)
        (exactInteger(members["version"]) == version).ifFalse(() => { fail() })
        (stringValue(members["event"]) == "READY").ifFalse(() => { fail() })
        true
    }

    surface: {
        encodeRequest: encodeRequest
        decodeRequest: decodeRequest
        encodeSuccess: encodeSuccess
        encodeFailure: encodeFailure
        decodeResponse: decodeResponse
        encodeReady: encodeReady
        decodeReady: decodeReady
    }
    surface.freeze()
    surface
})()

encodeRequest: _protocol.encodeRequest
decodeRequest: _protocol.decodeRequest
encodeSuccess: _protocol.encodeSuccess
encodeFailure: _protocol.encodeFailure
decodeResponse: _protocol.decodeResponse
encodeReady: _protocol.encodeReady
decodeReady: _protocol.decodeReady
