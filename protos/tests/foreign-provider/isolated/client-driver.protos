// PLAT074-D0 test-only CLI entry that runs the Protos client logic for the
// JUnit harness. It imports no std:ffi and opens no database. The harness
// relays opaque lines between this process and the helper; every request is
// built, and every reply decoded and correlated, here in Protos.
//
// Harness commands, one field per line (numbers are JSON scalars):
//   REQUEST, id, op, value        -> "TEXT <request line>" | "REJECTED"
//   MATCH, id, reply              -> "ACCEPTED <status> <value> <reason>" | "REJECTED"
//   RESPONSE, reply               -> "ACCEPTED <id> <status> <value> <reason>" | "REJECTED"
//   DECODE_REQUEST, line          -> "ADMITTED <id> <op> <value>" | "REFUSED <id> <reason>"
//   READY, line                   -> "ACCEPTED" | "REJECTED"
//   LOST, id                      -> "ACCEPTED <status> <value> <reason>"
ProcessStreams: import("std:io/process_streams")
JSON: import("std:json/json")
Client: import("./Client.protos")
Protocol: import("./Protocol.protos")

reader: ProcessStreams.stdinReader(process)
writer: ProcessStreams.stdoutWriter(process)

emit: (text) => {
    writer.writeLine(text).value()
    writer.flush().value()
}

field: () => {
    line: reader.readLine(8192).value()
    if(line === null) { Error().signal() }
    line
}

// A JSON scalar argument: null or an exact Integer (exponent zero).
scalar: (text) => {
    node: JSON.parse(text)
    result: null
    if(node.kind !== "null") {
        (node.kind === "number").ifFalse(() => { Error().signal() })
        (node.value.exponent == 0).ifFalse(() => { Error().signal() })
        result = node.value.coefficient
    }
    result
}

render: (value) => {
    text: "null"
    if(value !== null) {
        if((value === true) || (value === false)) {
            text = JSON.encode(JSON.boolean(value))
        } else {
            text = JSON.encode(JSON.number(value, 0))
        }
    }
    text
}

renderText: (value) => {
    text: "null"
    if(value !== null) { text = value }
    text
}

outcome: (decoded) => "ACCEPTED " + decoded.status + " " + render(decoded.value) + " " +
    renderText(decoded.reason)

// Runs `body`; a signalled Error becomes the fixed `refusal` line.
guarded: (body, refusal) => {
    text: null
    Error.handle(() => {
        text = body()
    }, (error) => {
        text = null
    })
    if(text === null) { text = refusal }
    text
}

running: true
while(running) {
    command: reader.readLine(64).value()
    if(command === null) {
        running = false
    } else {
        if(command == "REQUEST") {
            id: scalar(field())
            operation: field()
            value: scalar(field())
            emit(guarded(() => "TEXT " + Client.request(id, operation, value), "REJECTED"))
        }
        if(command == "MATCH") {
            id: scalar(field())
            reply: field()
            emit(guarded(() => outcome(Client.requireMatchingResponse(id, reply)), "REJECTED"))
        }
        if(command == "RESPONSE") {
            reply: field()
            emit(guarded(() => {
                decoded: Client.response(reply)
                "ACCEPTED " + render(decoded.id) + " " + decoded.status + " " +
                    render(decoded.value) + " " + renderText(decoded.reason)
            }, "REJECTED"))
        }
        if(command == "DECODE_REQUEST") {
            admission: Protocol.decodeRequest(field())
            if(admission.admitted) {
                emit("ADMITTED " + render(admission.id) + " " + admission.operation + " " +
                    render(admission.value))
            } else {
                emit("REFUSED " + render(admission.id) + " " + admission.reason)
            }
        }
        if(command == "READY") {
            line: field()
            emit(guarded(() => {
                Client.requireReady(line)
                "ACCEPTED"
            }, "REJECTED"))
        }
        if(command == "LOST") {
            emit(outcome(Client.connectionLost(scalar(field()))))
        }
    }
}
