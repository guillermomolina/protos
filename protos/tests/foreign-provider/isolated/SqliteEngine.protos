// PLAT074-D0 test-only durable SQLite operations over one connection. Not a
// public durable SQLite API and not std:sqlite. Every statement is fixed SQL
// owned by this file; no operation accepts SQL, a path or a native value from
// a caller other than the helper bootstrap path given to `openFile`.
//
// The declarations follow the PLAT074-B4 custody pattern of
// ../sqlite-landlock-provider.protos and std:sqlite/abi.protos. They are
// restated here instead of imported: the B4 module also exposes arbitrary-SQL
// test operations, and B1-B6 must not gain a new dependent.

// Private lexical scope: Connection and Statement custody never leaves it.
_engine: (() => {
    FFI: import("std:ffi")
    native: import("ffi:sqlite3")

    SQLITE_OK: 0
    SQLITE_ROW: 100
    SQLITE_DONE: 101
    // SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE; no URI, no memory database.
    OPEN_FILE: 6
    maxInteger: 9223372036854775807
    minInteger: 0 - 9223372036854775807 - 1

    database: FFI.opaque(native, "sqlite3")
    statement: FFI.opaque(native, "sqlite3_stmt")
    ownedDatabase: FFI.owned(database, "sqlite3_close_v2", FFI.i32)
    ownedStatement: FFI.owned(statement, "sqlite3_finalize", FFI.i32)
    // No producer exists for either pointer type: both are always NULL.
    vfs: FFI.nullable(FFI.opaque(native, "sqlite3_vfs_name"))
    tail: FFI.nullable(FFI.opaque(native, "sqlite3_tail_pointer"))
    bind: (symbol, returns, parameters) => FFI.bind(native, symbol, returns, parameters)
    open: bind("sqlite3_open_v2", FFI.i32, Array(FFI.utf8z, FFI.out(ownedDatabase), FFI.i32, vfs))
    compile: bind("sqlite3_prepare_v2", FFI.i32,
        Array(database, FFI.utf8z, FFI.i32, FFI.out(ownedStatement), tail))
    step: bind("sqlite3_step", FFI.i32, Array(statement))
    bindInteger: bind("sqlite3_bind_int64", FFI.i32, Array(statement, FFI.i32, FFI.i64))
    columnInteger: bind("sqlite3_column_int64", FFI.i64, Array(statement, FFI.i32))
    getAutocommit: bind("sqlite3_get_autocommit", FFI.i32, Array(database))

    fail: () => {
        Error().signal()
    }

    check: (code, expected) => {
        if(code != expected) { fail() }
        code
    }

    session: (initial) => {
        connection: initial

        requireOpen: () => {
            if(connection === null) { fail() }
        }

        // Prepares one fixed statement, runs `body` with it and always
        // finalizes it. A finalize failure after a successful body is reported,
        // never hidden; after a failed body the original Error is preserved.
        run: (sql, body) => {
            requireOpen()
            prepared: compile(connection, sql, -1, null)
            handle: prepared[1]
            if(prepared[0] != SQLITE_OK) {
                // A failed prepare publishes no statement; release defensively
                // without replacing the original SQLite status.
                if(handle !== null) { FFI.release(handle) }
                fail()
            }
            if(handle === null) { fail() }
            completed: false
            result: null
            (() => {
                result = body(handle)
                completed = true
            }).ensure(() => {
                finalized: FFI.release(handle)
                if(completed && (finalized != SQLITE_OK)) { fail() }
            })
            result
        }

        execute: (sql) => {
            run(sql, (handle) => {
                check(step(handle), SQLITE_DONE)
                null
            })
        }

        // Copies the single Integer cell while SQLITE_ROW is current, before
        // `run` finalizes the statement.
        queryInteger: (sql) => {
            run(sql, (handle) => {
                check(step(handle), SQLITE_ROW)
                copied: columnInteger(handle, 0)
                check(step(handle), SQLITE_DONE)
                copied
            })
        }

        // Irreversible and idempotent: guest custody is retired before the
        // native destructor runs, so no path can release the connection twice
        // or observe it again. A failed destructor result is signalled.
        close: () => {
            handle: connection
            connection = null
            if(handle !== null) {
                check(FFI.release(handle), SQLITE_OK)
            }
            null
        }

        operations: {
            initialize: () => execute("CREATE TABLE IF NOT EXISTS entries(value INTEGER NOT NULL)")
            begin: () => execute("BEGIN IMMEDIATE")
            insert: (value) => {
                Integer.recognizes(value).ifFalse(() => { fail() })
                ((value >= minInteger) && (value <= maxInteger)).ifFalse(() => { fail() })
                run("INSERT INTO entries(value) VALUES (?)", (handle) => {
                    check(bindInteger(handle, 1, value), SQLITE_OK)
                    check(step(handle), SQLITE_DONE)
                    null
                })
            }
            commit: () => execute("COMMIT")
            rollback: () => execute("ROLLBACK")
            count: () => queryInteger("SELECT count(*) FROM entries")
            sum: () => queryInteger("SELECT coalesce(sum(value), 0) FROM entries")
            // Real SQLite integrity check: exactly the single 'ok' row.
            integrityOk: () => {
                queryInteger("SELECT count(*) FROM pragma_integrity_check WHERE integrity_check='ok'") == 1
            }
            inTransaction: () => {
                requireOpen()
                getAutocommit(connection) == 0
            }
            isOpen: () => connection !== null
            close: close
        }
        operations.freeze()
        operations
    }

    // `path` comes only from the helper process bootstrap, never from IPC.
    openFile: (path) => {
        String.recognizes(path).ifFalse(() => { fail() })
        opened: open(path, OPEN_FILE, null)
        handle: opened[1]
        if(opened[0] != SQLITE_OK) {
            // An unsuccessful open may still publish an owned connection. Its
            // release result must not replace the original open failure.
            if(handle !== null) { FFI.release(handle) }
            fail()
        }
        if(handle === null) { fail() }
        session(handle)
    }

    surface: {
        openFile: openFile
    }
    surface.freeze()
    surface
})()

openFile: _engine.openFile
