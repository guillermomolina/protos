// TOOL009: the Package TOML corpus under
// protos/tests/package-tool/toml-syntax is now suite-native (Test/Assertions
// declarations), so this legacy exact-execution E2A2B slice no longer sources
// its subject from that corpus (its bare-signal raw-execution contract no
// longer applies there). Manifest.parsePackageTomlLine still validates the
// unrelated CaseId/parser plumbing; the executed source is a dedicated
// inline fixture mirroring the corpus's own former invalid-key-error.protos
// behavior without depending on corpus content that now belongs to the
// suite-native route.
Manifest: import("self:Manifest")

spec: Manifest.parsePackageTomlLine(
    "invalid-key-error.protos\terror"
)
observation: packageExecution(
    "Toml: import(\"self:TomlSyntax\")\nToml.keyPath(\"a..b\")\n"
)

passed:
    Manifest.caseId(spec) ==
    "package-tool/toml-syntax/invalid-key-error.protos"

passed.ifTrue(() => {
    passed = observation.state === "failed"
})
passed.ifTrue(() => {
    passed = observation.value === null
})
passed.ifTrue(() => {
    passed = (observation.error === null) === false
})
passed.ifTrue(() => {
    passed = (observation.error === Error) === false
})
passed.ifTrue(() => {
    passed = observation.error.parent() === Error
})
passed.ifTrue(() => {
    passed = observation.stdout.size() == 0
})
passed.ifTrue(() => {
    passed = observation.stderr.size() == 0
})

passed
