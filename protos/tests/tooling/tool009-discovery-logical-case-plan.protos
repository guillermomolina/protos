Discovery: import("self:Discovery")
CasePlan: import("self:LogicalCasePlan")
TestValue: import("std:test/Test")
Assertions: import("std:test/Assertions")

calls: {
    value: 0
}

suite: {
    tests: Array(
        TestValue("first", () => {
            calls.value = calls.value + 1
            11
        }),
        TestValue("second", () => {
            calls.value = calls.value + 1
            22
        })
    )
}

sourceAssociation: "suite.protos"

projection:
    Discovery.projectionFromModule(
        sourceAssociation,
        suite
    )

signature: Discovery.projectionSignature(projection)
plan: Discovery.projectionPlan(projection)

Assertions.require(calls.value == 0)

Assertions.require(signature.size() == 2)
Assertions.require(signature[0] == "first")
Assertions.require(signature[1] == "second")

Assertions.require(plan.size() == 2)

first: plan[0]
second: plan[1]

Assertions.require(first.size() == 3)
Assertions.require(second.size() == 3)

Assertions.require(
    CasePlan.sourceAssociation(first) == sourceAssociation
)
Assertions.require(CasePlan.selector(first) == "first")
Assertions.require(CasePlan.declarationPosition(first) == 0)

Assertions.require(
    CasePlan.sourceAssociation(second) == sourceAssociation
)
Assertions.require(CasePlan.selector(second) == "second")
Assertions.require(CasePlan.declarationPosition(second) == 1)

// Discovery of a valid empty declaration produces an empty logical CasePlan.
emptySuite: {
    tests: Array()
}

emptyProjection:
    Discovery.projectionFromModule(
        "empty.protos",
        emptySuite
    )

emptySignature:
    Discovery.projectionSignature(
        emptyProjection
    )

emptyPlan:
    Discovery.projectionPlan(
        emptyProjection
    )

Assertions.require(emptySignature.size() == 0)
Assertions.require(emptyPlan.size() == 0)

// Projection, authoritative signature and plan are all immutable.
Assertions.signals(Error, () => {
    projection[0] = Array()
})

Assertions.signals(Error, () => {
    signature[0] = "changed"
})

Assertions.signals(Error, () => {
    plan[0] = plan[1]
})

true
