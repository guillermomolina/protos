Manifest: import("self:Manifest")
Runner: import("self:Runner")

integerCase: Manifest.parseLine("one.protos\tinteger\t42")
unsupported: Manifest.parseLine(
    "missing.protos\ttool002-unsupported-sentinel\t-"
)
errorCase: Manifest.parseLine("error.protos\terror\t-")

plan: Manifest.frozenTuple(
    Manifest.frozenTuple(integerCase, unsupported, errorCase)
)

run: Runner.runSimple(plan, filesystem, execution)
results: Runner.runCaseResults(run)

firstEvaluation: Runner.caseRunEvaluation(results.at(0))
secondEvaluation: Runner.caseRunEvaluation(results.at(1))

(Runner.runSelectedCount(run) == 2) &&
(Runner.runPassedCount(run) == 2) &&
(Runner.runSkippedCount(run) == 1) &&
Runner.runAllPassed(run) &&
(results.size() == 2) &&
(Manifest.caseId(Runner.caseRunSpec(results.at(0))) == "one.protos") &&
(Manifest.caseId(Runner.caseRunSpec(results.at(1))) == "error.protos") &&
(Runner.resultObservation(firstEvaluation).state === "completed") &&
(Runner.resultObservation(secondEvaluation).state === "failed")
