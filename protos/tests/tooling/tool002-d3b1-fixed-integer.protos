Manifest: import("self:Manifest")
Runner: import("self:Runner")

u8: Runner.evaluateSimple(Manifest.parseLine("u8.protos\tfixed-integer\tUInt8:255"), "UInt8(255)", execution)
i8: Runner.evaluateSimple(Manifest.parseLine("i8.protos\tfixed-integer\tInt8:-128"), "Int8(-128)", execution)
u16: Runner.evaluateSimple(Manifest.parseLine("u16.protos\tfixed-integer\tUInt16:65535"), "UInt16(65535)", execution)
i16: Runner.evaluateSimple(Manifest.parseLine("i16.protos\tfixed-integer\tInt16:-32768"), "Int16(-32768)", execution)
u32: Runner.evaluateSimple(Manifest.parseLine("u32.protos\tfixed-integer\tUInt32:4294967295"), "UInt32(4294967295)", execution)
i32: Runner.evaluateSimple(Manifest.parseLine("i32.protos\tfixed-integer\tInt32:-2147483648"), "Int32(-2147483648)", execution)
u64: Runner.evaluateSimple(Manifest.parseLine("u64.protos\tfixed-integer\tUInt64:18446744073709551615"), "UInt64(18446744073709551615)", execution)
i64: Runner.evaluateSimple(Manifest.parseLine("i64.protos\tfixed-integer\tInt64:-9223372036854775808"), "Int64(-9223372036854775808)", execution)

wrongFamily: Runner.evaluateSimple(Manifest.parseLine("wf.protos\tfixed-integer\tUInt8:1"), "Int8(1)", execution)
ordinary: Runner.evaluateSimple(Manifest.parseLine("ordinary.protos\tfixed-integer\tUInt8:1"), "1", execution)
wrongValue: Runner.evaluateSimple(Manifest.parseLine("wv.protos\tfixed-integer\tUInt8:1"), "UInt8(2)", execution)

Runner.resultPassed(u8) &&
Runner.resultPassed(i8) &&
Runner.resultPassed(u16) &&
Runner.resultPassed(i16) &&
Runner.resultPassed(u32) &&
Runner.resultPassed(i32) &&
Runner.resultPassed(u64) &&
Runner.resultPassed(i64) &&
(Runner.resultPassed(wrongFamily) === false) &&
(Runner.resultPassed(ordinary) === false) &&
(Runner.resultPassed(wrongValue) === false)
