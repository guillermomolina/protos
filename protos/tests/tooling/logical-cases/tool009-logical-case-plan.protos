CasePlan: import("self:LogicalCasePlan")
Assertions: import("std:test/Assertions")

sourceAssociation: "suite.protos"
plan:
    CasePlan.build(
        sourceAssociation,
        Array("first", "second", "third")
    )

Assertions.require(plan.size() == 3)

Assertions.require(
    CasePlan.sourceAssociation(plan[0]) == sourceAssociation
)
Assertions.require(CasePlan.selector(plan[0]) == "first")
Assertions.require(CasePlan.declarationPosition(plan[0]) == 0)

Assertions.require(
    CasePlan.sourceAssociation(plan[1]) == sourceAssociation
)
Assertions.require(CasePlan.selector(plan[1]) == "second")
Assertions.require(CasePlan.declarationPosition(plan[1]) == 1)

Assertions.require(
    CasePlan.sourceAssociation(plan[2]) == sourceAssociation
)
Assertions.require(CasePlan.selector(plan[2]) == "third")
Assertions.require(CasePlan.declarationPosition(plan[2]) == 2)

// Both the flat CasePlan and every Case entry are inert/frozen.
Assertions.signals(Error, () => {
    plan[0] = plan[1]
})

Assertions.signals(Error, () => {
    plan[0][1] = "changed"
})

true
