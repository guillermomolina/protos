Manifest: import("self:Manifest")
Runner: import("self:Runner")

taxonomyOk:
    (Runner.standardErrorPrototype("Error") === Error) &&
    (Runner.standardErrorPrototype("SlotNotFound") === SlotNotFound) &&
    (Runner.standardErrorPrototype("InvalidSuper") === InvalidSuper) &&
    (Runner.standardErrorPrototype("InvalidReturn") === InvalidReturn) &&
    (Runner.standardErrorPrototype("Cancelled") === Cancelled) &&
    (Runner.standardErrorPrototype("FutureResolutionCycle") === FutureResolutionCycle) &&
    (Runner.standardErrorPrototype("RequestOutcomeUncertain") === RequestOutcomeUncertain) &&
    (Runner.standardErrorPrototype("NonTransferableValue") === NonTransferableValue) &&
    (Runner.standardErrorPrototype("NonParallelValue") === NonParallelValue) &&
    (Runner.standardErrorPrototype("InvalidPredicateResult") === InvalidPredicateResult) &&
    (Runner.standardErrorPrototype("InvalidComparatorResult") === InvalidComparatorResult) &&
    (Runner.standardErrorPrototype("InvalidComparatorOrder") === InvalidComparatorOrder) &&
    (Runner.standardErrorPrototype("ParallelRegionOverlap") === ParallelRegionOverlap) &&
    (Runner.standardErrorPrototype("ParallelRegionInUse") === ParallelRegionInUse) &&
    (Runner.standardErrorPrototype("ParallelRegionOutsideP") === ParallelRegionOutsideP) &&
    (Runner.standardErrorPrototype("IOError") === IOError) &&
    (Runner.standardErrorPrototype("InvalidIOArgument") === InvalidIOArgument) &&
    (Runner.standardErrorPrototype("IOLifecycleError") === IOLifecycleError) &&
    (Runner.standardErrorPrototype("IOCapacityExhausted") === IOCapacityExhausted) &&
    (Runner.standardErrorPrototype("EncodingError") === EncodingError) &&
    (Runner.standardErrorPrototype("LineTooLong") === LineTooLong)

failedWith: (error) => {
    (source) => {
        {
            state: "failed"
            value: null
            error: error
        }
    }
}

generic: Runner.evaluateSimple(
    Manifest.parseLine("generic.protos\terror-parent\tError"),
    "",
    failedWith(Error {})
)
slot: Runner.evaluateSimple(
    Manifest.parseLine("slot.protos\terror-parent\tSlotNotFound"),
    "",
    failedWith(SlotNotFound {})
)
io: Runner.evaluateSimple(
    Manifest.parseLine("io.protos\terror-parent\tIOError"),
    "",
    failedWith(IOError {})
)
encoding: Runner.evaluateSimple(
    Manifest.parseLine("encoding.protos\terror-parent\tEncodingError"),
    "",
    failedWith(EncodingError {})
)
wrongAncestor: Runner.evaluateSimple(
    Manifest.parseLine("wrong.protos\terror-parent\tIOError"),
    "",
    failedWith(EncodingError {})
)

taxonomyOk &&
Runner.resultPassed(generic) &&
Runner.resultPassed(slot) &&
Runner.resultPassed(io) &&
Runner.resultPassed(encoding) &&
(Runner.resultPassed(wrongAncestor) === false)
