Runner: import("self:Runner")

(Runner.parseExpectedFloatBits("0000000000000000") == 0) &&
(Runner.parseExpectedFloatBits("0000000000000001") == 1) &&
(Runner.parseExpectedFloatBits("3ff0000000000000") == 4607182418800017408) &&
(Runner.parseExpectedFloatBits("8000000000000000") == 9223372036854775808) &&
(Runner.parseExpectedFloatBits("7ff0000000000000") == 9218868437227405312) &&
(Runner.parseExpectedFloatBits("ffffffffffffffff") == 18446744073709551615) &&
(Runner.parseExpectedFloatBits("ABCDEF0123456789") == 12379813738877118345) &&
(Runner.parseExpectedFloatBits("abcdef0123456789") == 12379813738877118345)
