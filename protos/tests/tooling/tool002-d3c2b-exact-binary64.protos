Runner: import("self:Runner")

fromHex: (text) => {
    Runner.floatFromExpectedBits(
        Runner.parseExpectedFloatBits(text)
    )
}

positiveZero: fromHex("0000000000000000")
negativeZero: fromHex("8000000000000000")
minSubnormal: fromHex("0000000000000001")
negativeMinSubnormal: fromHex("8000000000000001")
maxSubnormal: fromHex("000fffffffffffff")
minNormal: fromHex("0010000000000000")
half: fromHex("3fe0000000000000")
third: fromHex("3fd5555555555555")
one: fromHex("3ff0000000000000")
tieUp: fromHex("3ff0000000000002")
maxNormal: fromHex("7fefffffffffffff")
positiveInfinity: fromHex("7ff0000000000000")
negativeInfinity: fromHex("fff0000000000000")

negativeZeroReference: (0.0 - 1.0) * 0.0
negativeMinReference: -4.9406564584124654e-324
negativeInfinityReference: (0.0 - 1.0) / 0.0

(positiveZero === 0.0) &&
(negativeZero === negativeZeroReference) &&
((negativeZero === 0.0) === false) &&
(minSubnormal === 4.9406564584124654e-324) &&
(negativeMinSubnormal === negativeMinReference) &&
(maxSubnormal === 2.2250738585072009e-308) &&
(minNormal === 2.2250738585072014e-308) &&
(half === 0.5) &&
(third === (1.0 / 3.0)) &&
(one === 1.0) &&
(tieUp === 1.0000000000000004) &&
(maxNormal === 1.7976931348623157e308) &&
(positiveInfinity === (1.0 / 0.0)) &&
(negativeInfinity === negativeInfinityReference) &&
Runner.matchesExpectedFloatBits(
    Runner.parseExpectedFloatBits("3ff0000000000000"),
    1.0
) &&
(Runner.matchesExpectedFloatBits(
    Runner.parseExpectedFloatBits("3ff0000000000000"),
    1.0000000000000002
) === false) &&
(Runner.matchesExpectedFloatBits(
    Runner.parseExpectedFloatBits("8000000000000000"),
    0.0
) === false) &&
(Runner.matchesExpectedFloatBits(
    Runner.parseExpectedFloatBits("3ff0000000000000"),
    1
) === false)
