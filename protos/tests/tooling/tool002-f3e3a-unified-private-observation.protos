Manifest: import("self:Manifest")
Runner: import("self:Runner")

storedSpec: Manifest.parseLine(
    "future/failed-value-resignals-recorded-error.protos\tfuture-observation-error-identity\tstored:Error"
)
freshSpec: Manifest.parseLine(
    "future/cancelled-value-fresh-error.protos\tfuture-observation-error-identity\tfresh:Cancelled"
)

storedEvaluation: Runner.evaluateFutureObservation(
    storedSpec,
    retainedStoredSource,
    executionInspect
)
freshEvaluation: Runner.evaluateFutureObservation(
    freshSpec,
    retainedFreshSource,
    executionInspect
)

storedObservation: Runner.resultObservation(storedEvaluation)
freshObservation: Runner.resultObservation(freshEvaluation)

passed: Runner.resultPassed(storedEvaluation) === true
passed.ifTrue(() => {
    passed = storedObservation.state === "completed"
})
passed.ifTrue(() => {
    passed = storedObservation.error === null
})
passed.ifTrue(() => {
    passed = storedObservation.value === true
})
passed.ifTrue(() => {
    passed = Runner.resultPassed(freshEvaluation) === true
})
passed.ifTrue(() => {
    passed = freshObservation.state === "completed"
})
passed.ifTrue(() => {
    passed = freshObservation.error === null
})
passed.ifTrue(() => {
    passed = freshObservation.value === true
})

passed
