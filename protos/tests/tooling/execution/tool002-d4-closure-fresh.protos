Manifest: import("self:Manifest")
Runner: import("self:Runner")

invalidSuperSource:
    "runner: () => {\n" +
    "    super.noSuchSelector()\n" +
    "}\n" +
    "runner\n"

invalidReturnSource:
    "make: () => {\n" +
    "    () => {\n" +
    "        ^42\n" +
    "    }\n" +
    "}\n" +
    "make()\n"

normalClosureSource:
    "runner: () => {\n" +
    "    42\n" +
    "}\n" +
    "runner\n"

invalidSuper: Runner.evaluateDCase(
    Manifest.parseLine(
        "invalid-super.protos\tclosure-error-parent-fresh\tInvalidSuper"
    ),
    invalidSuperSource,
    execution
)

invalidReturn: Runner.evaluateDCase(
    Manifest.parseLine(
        "invalid-return.protos\tclosure-error-parent-fresh\tInvalidReturn"
    ),
    invalidReturnSource,
    execution
)

wrongParent: Runner.evaluateDCase(
    Manifest.parseLine(
        "wrong-parent.protos\tclosure-error-parent-fresh\tInvalidReturn"
    ),
    invalidSuperSource,
    execution
)

normalClosure: Runner.evaluateDCase(
    Manifest.parseLine(
        "normal.protos\tclosure-error-parent-fresh\tError"
    ),
    normalClosureSource,
    execution
)

nonClosure: Runner.evaluateDCase(
    Manifest.parseLine(
        "non-closure.protos\tclosure-error-parent-fresh\tError"
    ),
    "42",
    execution
)

Runner.resultPassed(invalidSuper) &&
Runner.resultPassed(invalidReturn) &&
(Runner.resultPassed(wrongParent) === false) &&
(Runner.resultPassed(normalClosure) === false) &&
(Runner.resultPassed(nonClosure) === false)
