Manifest: import("self:Manifest")
Runner: import("self:Runner")

completedWith: (value) => {
    (source) => {
        {
            state: "completed"
            value: value
            error: null
        }
    }
}

one: Runner.evaluateSimple(
    Manifest.parseLine("one.protos\tfloat-bits\t3ff0000000000000"),
    "",
    completedWith(1.0)
)

negativeZero: Runner.evaluateSimple(
    Manifest.parseLine("negative-zero.protos\tfloat-bits\t8000000000000000"),
    "",
    completedWith(0.0.negated())
)

wrongZeroSign: Runner.evaluateSimple(
    Manifest.parseLine("wrong-zero.protos\tfloat-bits\t0000000000000000"),
    "",
    completedWith(0.0.negated())
)

positiveInfinity: Runner.evaluateSimple(
    Manifest.parseLine("infinity.protos\tfloat-bits\t7ff0000000000000"),
    "",
    completedWith(1.0 / 0.0)
)

wrongFamily: Runner.evaluateSimple(
    Manifest.parseLine("integer.protos\tfloat-bits\t3ff0000000000000"),
    "",
    completedWith(1)
)

Runner.resultPassed(one) &&
Runner.resultPassed(negativeZero) &&
Runner.resultPassed(positiveInfinity) &&
(Runner.resultPassed(wrongZeroSign) === false) &&
(Runner.resultPassed(wrongFamily) === false)
