Manifest: import("self:Manifest")
Runner: import("self:Runner")

evaluate: (line, source, expectedPassed) => {
    spec: Manifest.parseLine(line)
    result: Runner.evaluateFutureTerminal(spec, source, executionInspect)
    observation: Runner.resultObservation(result)

    passed: Runner.resultPassed(result) === expectedPassed
    if(passed) {
        passed = observation.state === "completed"
    }
    if(passed) {
        passed = observation.error === null
    }
    passed
}

failedSpec: Manifest.parseLine(
    "tool002-f2-source-failed-plain.protos\tfuture-error\t-"
)
failedSource: Runner.readSource(failedSpec, filesystem)

parentSpec: Manifest.parseLine(
    "tool002-f2-source-failed-invalid-io-argument.protos\tfuture-error-parent\tInvalidIOArgument"
)
parentSource: Runner.readSource(parentSpec, filesystem)

cancelledSpec: Manifest.parseLine(
    "tool002-f2-source-cancelled.protos\tfuture-cancelled\t-"
)
cancelledSource: Runner.readSource(cancelledSpec, filesystem)

passed:
    Runner.isFutureTerminalExpectation(failedSpec) &&
    Runner.isFutureTerminalExpectation(parentSpec) &&
    Runner.isFutureTerminalExpectation(cancelledSpec) &&
    Runner.isDExpectation(failedSpec) &&
    Runner.isDExpectation(parentSpec) &&
    Runner.isDExpectation(cancelledSpec)

if(passed) {
    passed = evaluate(
        "tool002-f2-source-failed-plain.protos\tfuture-error\t-",
        failedSource,
        true
    )
}

if(passed) {
    passed = evaluate(
        "tool002-f2-source-failed-invalid-io-argument.protos\tfuture-error-parent\tInvalidIOArgument",
        parentSource,
        true
    )
}

if(passed) {
    passed = evaluate(
        "tool002-f2-source-cancelled.protos\tfuture-cancelled\t-",
        cancelledSource,
        true
    )
}

// FAILED and CANCELLED are not collapsed merely because both value() calls signal.
if(passed) {
    passed = evaluate(
        "tool002-f2-source-cancelled.protos\tfuture-error\t-",
        cancelledSource,
        false
    )
}

if(passed) {
    passed = evaluate(
        "tool002-f2-source-failed-plain.protos\tfuture-cancelled\t-",
        failedSource,
        false
    )
}

// Immediate parent matching remains exact, not ancestry-based.
if(passed) {
    passed = evaluate(
        "tool002-f2-source-failed-invalid-io-argument.protos\tfuture-error-parent\tIOError",
        parentSource,
        false
    )
}

// A resolved Future is neither FAILED nor CANCELLED.
if(passed) {
    passed = evaluate(
        "future/tool002-f2-inline.protos\tfuture-error\t-",
        "(() => { 42 }).future()",
        false
    )
}

passed
