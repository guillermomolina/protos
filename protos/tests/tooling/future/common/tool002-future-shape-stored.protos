// TOOL002-owned retained/stored Future shape: a frozen local object exposing
// `future`, `error`, and `observe`, where `observe` resignals the same
// recorded `error` identity on every call. Shared by the F3C1B/F3C2/F3E
// live-inspection fixtures, which probe this exact slot shape through
// `executionInspect`. This source is intentionally independent from the
// `protos/tests/conformance` corpus: those fixtures are owned by the
// suite-native Test Tool corpus and no longer expose this bare shape.
error: Error()
future: (() => {
    error.signal()
}).future()

{
    future: future
    error: error
    observe: () => {
        future.value()
    }
}
