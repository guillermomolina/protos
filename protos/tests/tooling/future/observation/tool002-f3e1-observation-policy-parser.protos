Runner: import("self:Runner")

stored: Runner.parseFutureObservationPolicy("stored:Error")
fresh: Runner.parseFutureObservationPolicy("fresh:Cancelled")
freshError: Runner.parseFutureObservationPolicy("fresh:Error")

passed:
    (Runner.futureObservationPolicyMode(stored) === "stored") &&
    (Runner.futureObservationPolicyParent(stored) === Error)
passed.ifTrue(() => {
    passed =
        (Runner.futureObservationPolicyMode(fresh) === "fresh") &&
        (Runner.futureObservationPolicyParent(fresh) === Cancelled)
})
passed.ifTrue(() => {
    passed =
        (Runner.futureObservationPolicyMode(freshError) === "fresh") &&
        (Runner.futureObservationPolicyParent(freshError) === Error)
})

rejected: (payload) => {
    caughtPolicyError: false
    Error.handle(
        () => {
            Runner.parseFutureObservationPolicy(payload)
            null
        },
        (caught) => {
            caughtPolicyError = caught.parent() === Error
            null
        }
    )
    caughtPolicyError
}

passed.ifTrue(() => { passed = rejected("stored") })
passed.ifTrue(() => { passed = rejected(":Error") })
passed.ifTrue(() => { passed = rejected("stored:") })
passed.ifTrue(() => { passed = rejected("stored:Error:Cancelled") })
passed.ifTrue(() => { passed = rejected("cached:Error") })
passed.ifTrue(() => { passed = rejected("fresh:NotAStandardError") })

passed
