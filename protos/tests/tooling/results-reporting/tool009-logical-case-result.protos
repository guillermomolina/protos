Assertions: import("std:test/Assertions")
CaseResult: import("self:LogicalCaseResult")

completion: (phase, state, value, error) => {
    observation: {
        state: state
        value: value
        error: error
    }
    observation.freeze()

    envelope: {
        phase: phase
        observation: observation
    }
    envelope.freeze()
}

returnedError: Error {}

passCompletion:
    completion(
        "case-execution",
        "completed",
        returnedError,
        null
    )

failCompletion:
    completion(
        "case-execution",
        "failed",
        null,
        Error {}
    )

cancelledCompletion:
    completion(
        "case-execution",
        "cancelled",
        null,
        null
    )

rematerializationCompletion:
    completion(
        "rematerialization-error",
        "failed",
        null,
        Error {}
    )

passResult: CaseResult.project(passCompletion)
failResult: CaseResult.project(failCompletion)
cancelledResult: CaseResult.project(cancelledCompletion)
rematerializationResult:
    CaseResult.project(rematerializationCompletion)

Assertions.require(
    CaseResult.classification(passResult) == "pass"
)

Assertions.require(
    CaseResult.completion(passResult) === passCompletion
)

Assertions.require(
    CaseResult.classification(failResult) == "fail"
)

Assertions.require(
    CaseResult.classification(cancelledResult) == "tool-error"
)

Assertions.require(
    CaseResult.classification(rematerializationResult) == "tool-error"
)

projected:
    CaseResult.projectAll(
        Array(
            passCompletion,
            failCompletion,
            cancelledCompletion,
            rematerializationCompletion
        )
    )

Assertions.require(projected.size() == 4)

Assertions.require(
    CaseResult.classification(projected[0]) == "pass"
)
Assertions.require(
    CaseResult.classification(projected[1]) == "fail"
)
Assertions.require(
    CaseResult.classification(projected[2]) == "tool-error"
)
Assertions.require(
    CaseResult.classification(projected[3]) == "tool-error"
)

Assertions.require(
    CaseResult.exitCode(
        Array(passResult)
    ) == 0
)

Assertions.require(
    CaseResult.exitCode(
        Array(passResult, failResult)
    ) == 1
)

Assertions.require(
    CaseResult.exitCode(
        Array(passResult, failResult, cancelledResult)
    ) == 3
)

true
