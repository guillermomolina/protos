Manifest: import("self:Manifest")
Runner: import("self:Runner")

primary: Runner.runTuple(Array("primary-evidence"), 1, 1, 0)
auxHealthy: Runner.runTuple(Array("aux-healthy"), 1, 1, 0)
auxFailed: Runner.runTuple(Array("aux-failed"), 1, 0, 0)

allHealthy:
    Runner.testRunOutcomeCompletedAcrossRuns(
        primary,
        Array(primary, auxHealthy)
    )

failed:
    Runner.testRunOutcomeCompletedAcrossRuns(
        primary,
        Array(primary, auxFailed)
    )

healthyPassed:
    Runner.testRunOutcomeStatus(allHealthy) === "completed"
healthyPassed =
    healthyPassed &&
    (Runner.testRunOutcomeRun(allHealthy) === primary)
healthyPassed =
    healthyPassed &&
    (Runner.testRunOutcomeExitCode(allHealthy) == 0)

failedPassed:
    Runner.testRunOutcomeStatus(failed) === "completed"
failedPassed =
    failedPassed &&
    (Runner.testRunOutcomeRun(failed) === primary)
failedPassed =
    failedPassed &&
    (Runner.testRunOutcomeExitCode(failed) == 1)

laterCase:
    Manifest.caseSpec(
        Array(
            "later.protos",
            "integer",
            "1"
        )
    )
laterPlan:
    Manifest.frozenTuple(
        Manifest.frozenTuple(laterCase)
    )

abortedD108:
    Runner.d108RunEnvelope(
        Array("partial-current"),
        2,
        Array("infra-current"),
        Array("cutover-current"),
        1
    )

aborted:
    Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
        Array(primary),
        abortedD108,
        Array(laterPlan)
    )

abortPayload:
    Runner.testRunOutcomeInfrastructureAbort(aborted)

abortedPassed:
    Runner.testRunOutcomeStatus(aborted) === "infrastructure-aborted"
abortedPassed =
    abortedPassed &&
    (Runner.testRunOutcomeRun(aborted) === null)
abortedPassed =
    abortedPassed &&
    (Runner.testRunOutcomeExitCode(aborted) == 3)
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortExecutedCaseRuns(
            abortPayload
        ).size() == 2
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortOrdinaryUnsupportedCount(
            abortPayload
        ) == 2
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortAttempts(
            abortPayload
        ).size() == 1
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortCutoverNotAdmittedCases(
            abortPayload
        ).size() == 2
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortRetainedUnsafeReservationCount(
            abortPayload
        ) == 1
    )

healthyPassed && failedPassed && abortedPassed
