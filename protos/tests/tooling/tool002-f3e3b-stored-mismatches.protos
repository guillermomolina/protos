Manifest: import("self:Manifest")
Runner: import("self:Runner")

spec: Manifest.parseLine(
    "future/x.protos\tfuture-observation-error-identity\tstored:Error"
)

identityMismatchSource:
    "storedError: Error()\n" +
    "observedError: Error()\n" +
    "future: (() => { observedError.signal() }).future()\n" +
    "{\n" +
    "    future: future\n" +
    "    error: storedError\n" +
    "    observe: () => { future.value() }\n" +
    "}"

parentMismatchSource:
    "storedError: Cancelled()\n" +
    "future: (() => { storedError.signal() }).future()\n" +
    "{\n" +
    "    future: future\n" +
    "    error: storedError\n" +
    "    observe: () => { future.value() }\n" +
    "}"

inertFalse: (evaluation) => {
    observation: Runner.resultObservation(evaluation)
    passed: Runner.resultPassed(evaluation) === false
    passed.ifTrue(() => { passed = observation.state === "completed" })
    passed.ifTrue(() => { passed = observation.error === null })
    passed.ifTrue(() => { passed = observation.value === false })
    passed
}

passed: inertFalse(
    Runner.evaluateFutureObservation(spec, identityMismatchSource, executionInspect)
)
passed.ifTrue(() => {
    passed = inertFalse(
        Runner.evaluateFutureObservation(spec, parentMismatchSource, executionInspect)
    )
})

passed
