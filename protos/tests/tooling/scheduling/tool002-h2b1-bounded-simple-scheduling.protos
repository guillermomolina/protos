Manifest: import("self:Manifest")
Runner: import("self:Runner")

first: Manifest.caseSpec(Array("h2b1/first.protos", "integer", "10"))
second: Manifest.caseSpec(Array("h2b1/second.protos", "integer", "20"))
third: Manifest.caseSpec(Array("h2b1/third.protos", "integer", "30"))

plan: Manifest.frozenTuple(
    Manifest.frozenTuple(first, second, third)
)

sourceLoader: (spec) => {
    id: Manifest.caseId(spec)
    source: null

    (id === "h2b1/first.protos").ifTrue(() => { source = "10" })
    (id === "h2b1/second.protos").ifTrue(() => { source = "20" })
    (id === "h2b1/third.protos").ifTrue(() => { source = "30" })

    (source === null).ifTrue(() => { Error().signal() })
    source
}

run: Runner.runBoundedSimpleWithLoader(
    plan,
    sourceLoader,
    executionAsync,
    2
)

results: Runner.runCaseResults(run)
passed: Runner.runSelectedCount(run) == 3
passed = passed && (Runner.runPassedCount(run) == 3)
passed = passed && (Runner.runSkippedCount(run) == 0)
passed = passed && (results.size() == 3)

passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[0])) === "h2b1/first.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[1])) === "h2b1/second.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[2])) === "h2b1/third.protos"
})

passed
