Manifest: import("self:Manifest")
Runner: import("self:Runner")

case: Manifest.parseLine("large.protos\tinteger\t0")
source: Encoding.UTF8.encode(Runner.readSource(case, filesystem))

(source.size() == 1100007) &&
(source[0] == 97) &&
(source[1099999] == 97) &&
(source[1100000] == 207) &&
(source[1100001] == 128) &&
(source[1100002] == 240) &&
(source[1100003] == 159) &&
(source[1100004] == 153) &&
(source[1100005] == 130) &&
(source[1100006] == 10)
