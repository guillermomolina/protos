Manifest: import("self:Manifest")
Runner: import("self:Runner")

evaluate: (line, source, expectedPassed) => {
    spec: Manifest.parseLine(line)
    result: Runner.evaluateFutureTerminal(spec, source, execution)
    observation: Runner.resultObservation(result)

    passed: Runner.resultPassed(result) === expectedPassed
    passed.ifTrue(() => {
        passed = observation.state === "completed"
    })
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed
}

failedSpec: Manifest.parseLine(
    "text-reader/closed-reader-read-error.protos\tfuture-error\t-"
)
failedSource: Runner.readSource(failedSpec, filesystem)

parentSpec: Manifest.parseLine(
    "text-reader/readline-bound-zero-error.protos\tfuture-error-parent\tInvalidIOArgument"
)
parentSource: Runner.readSource(parentSpec, filesystem)

cancelledSpec: Manifest.parseLine(
    "future/cancel-before-start.protos\tfuture-cancelled\t-"
)
cancelledSource: Runner.readSource(cancelledSpec, filesystem)

passed:
    Runner.isFutureTerminalExpectation(failedSpec) &&
    Runner.isFutureTerminalExpectation(parentSpec) &&
    Runner.isFutureTerminalExpectation(cancelledSpec) &&
    (Runner.isDExpectation(failedSpec) === false) &&
    (Runner.isDExpectation(parentSpec) === false) &&
    (Runner.isDExpectation(cancelledSpec) === false)

passed.ifTrue(() => {
    passed = evaluate(
        "text-reader/closed-reader-read-error.protos\tfuture-error\t-",
        failedSource,
        true
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "text-reader/readline-bound-zero-error.protos\tfuture-error-parent\tInvalidIOArgument",
        parentSource,
        true
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/cancel-before-start.protos\tfuture-cancelled\t-",
        cancelledSource,
        true
    )
})

// FAILED and CANCELLED are not collapsed merely because both value() calls signal.
passed.ifTrue(() => {
    passed = evaluate(
        "future/cancel-before-start.protos\tfuture-error\t-",
        cancelledSource,
        false
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "text-reader/closed-reader-read-error.protos\tfuture-cancelled\t-",
        failedSource,
        false
    )
})

// Immediate parent matching remains exact, not ancestry-based.
passed.ifTrue(() => {
    passed = evaluate(
        "text-reader/readline-bound-zero-error.protos\tfuture-error-parent\tIOError",
        parentSource,
        false
    )
})

// A resolved Future is neither FAILED nor CANCELLED.
passed.ifTrue(() => {
    passed = evaluate(
        "future/tool002-f2-inline.protos\tfuture-error\t-",
        "(() => { 42 }).future()",
        false
    )
})

passed
