Manifest: import("self:Manifest")
Runner: import("self:Runner")

evaluate: (line, source, expectedPassed) => {
    spec: Manifest.parseLine(line)
    result: Runner.evaluateFutureResolved(spec, source, execution)
    observation: Runner.resultObservation(result)

    passed: Runner.resultPassed(result) === expectedPassed
    passed.ifTrue(() => {
        passed = observation.state === "completed"
    })
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed
}

integerSpec: Manifest.parseLine(
    "future/then-transforms.protos\tfuture-integer\t42"
)
integerSource: Runner.readSource(integerSpec, filesystem)

nullSpec: Manifest.parseLine(
    "future/closure-future-null.protos\tfuture-null\t-"
)
nullSource: Runner.readSource(nullSpec, filesystem)

passed:
    Runner.isFutureResolvedExpectation(integerSpec) &&
    (Runner.isDExpectation(integerSpec) === false)

passed.ifTrue(() => {
    passed = evaluate(
        "future/then-transforms.protos\tfuture-integer\t42",
        integerSource,
        true
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/closure-future-null.protos\tfuture-null\t-",
        nullSource,
        true
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/tool002-f1-inline.protos\tfuture-boolean\ttrue",
        "(() => { true }).future()",
        true
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/tool002-f1-inline.protos\tfuture-boolean\tfalse",
        "(() => { true }).future()",
        false
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/tool002-f1-inline.protos\tfuture-integer\t42",
        "42",
        false
    )
})

passed.ifTrue(() => {
    passed = evaluate(
        "future/tool002-f1-inline.protos\tfuture-integer\t42",
        "(() => { Error().signal() }).future()",
        false
    )
})

passed
