Assertions: import("std:test/Assertions")
Manifest: import("self:Manifest")
Migration: import("self:LogicalCaseMigration")
LogicalCaseResult: import("self:LogicalCaseResult")
Runner: import("self:Runner")

legacy:
    Manifest.caseSpec(
        Array(
            "legacy.protos",
            "boolean",
            "true"
        )
    )

native:
    Manifest.caseSpec(
        Array(
            "native.protos",
            "suite-native",
            "-"
        )
    )

cases:
    Array(
        legacy,
        native
    )
cases.freeze()

plan: Array(cases)
plan.freeze()

split:
    Migration.splitPlan(
        plan
    )

legacyPlan:
    Migration.legacyPlan(
        split
    )

nativeSpecs:
    Migration.suiteNativeSpecs(
        split
    )

Assertions.require(
    Manifest.planCases(legacyPlan).size() == 1
)
Assertions.require(
    Manifest.planCases(legacyPlan)[0] === legacy
)
Assertions.require(
    nativeSpecs.size() == 1
)
Assertions.require(
    nativeSpecs[0] === native
)

association:
    Migration.sourceAssociation(
        "corpus",
        native
    )

Assertions.require(
    association[0] == "corpus"
)
Assertions.require(
    association[1] == "native.protos"
)

selected:
    Migration.selectSuiteNativeSpecs(
        "corpus",
        nativeSpecs,
        Array(association)
    )

Assertions.require(
    selected.size() == 1
)
Assertions.require(
    selected[0] === native
)

notSelected:
    Migration.selectSuiteNativeSpecs(
        "other-corpus",
        nativeSpecs,
        Array(association)
    )

Assertions.require(
    notSelected.size() == 0
)

completion: (phase, state) => {
    observation: {
        state: state
    }
    observation.freeze()

    value: {
        phase: phase
        observation: observation
    }
    value.freeze()
}

passResult:
    LogicalCaseResult.project(
        completion(
            "case-execution",
            "completed"
        )
    )

failResult:
    LogicalCaseResult.project(
        completion(
            "case-execution",
            "failed"
        )
    )

toolErrorResult:
    LogicalCaseResult.project(
        completion(
            "rematerialization-error",
            "failed"
        )
    )

legacyPass:
    Runner.testRunOutcomeCompletedWithExit(
        null,
        0
    )

legacyFail:
    Runner.testRunOutcomeCompletedWithExit(
        null,
        1
    )

legacyInfrastructure:
    Runner.testRunOutcome(
        "infrastructure-aborted",
        null,
        null,
        3
    )

allPass:
    Migration.mergeOutcome(
        legacyPass,
        Array(passResult)
    )

Assertions.require(
    Runner.testRunOutcomeStatus(allPass) ==
        "completed"
)
Assertions.require(
    Runner.testRunOutcomeExitCode(allPass) == 0
)

nativeFail:
    Migration.mergeOutcome(
        legacyPass,
        Array(failResult)
    )

Assertions.require(
    Runner.testRunOutcomeStatus(nativeFail) ==
        "completed"
)
Assertions.require(
    Runner.testRunOutcomeExitCode(nativeFail) == 1
)

retainedLegacyFail:
    Migration.mergeOutcome(
        legacyFail,
        Array(passResult)
    )

Assertions.require(
    Runner.testRunOutcomeStatus(retainedLegacyFail) ==
        "completed"
)
Assertions.require(
    Runner.testRunOutcomeExitCode(retainedLegacyFail) == 1
)

nativeToolError:
    Migration.mergeOutcome(
        legacyPass,
        Array(toolErrorResult)
    )

Assertions.require(
    Runner.testRunOutcomeStatus(nativeToolError) ==
        "infrastructure-aborted"
)
Assertions.require(
    Runner.testRunOutcomeExitCode(nativeToolError) == 3
)

retainedInfrastructure:
    Migration.mergeOutcome(
        legacyInfrastructure,
        Array(passResult)
    )

Assertions.require(
    retainedInfrastructure ===
        legacyInfrastructure
)

neutral:
    Migration.neutralLegacyOutcome()

Assertions.require(
    Runner.testRunOutcomeStatus(neutral) ==
        "completed"
)
Assertions.require(
    Runner.testRunOutcomeExitCode(neutral) == 0
)

// TOOL009-D transport boundary: logicalCaseExecutorAsync resolves the
// requirement recorded for a logical Case's corpus and dispatches only to
// that requirement's own suite-native execution binding. The inert
// CasePlan/LogicalCasePlan shape never carries this host information; the
// dispatcher receives it only through the corpusExecutionRequirements map a
// caller builds from the authoritative SuiteGraph leaves.
recordedOrdinaryCalls: Array()

fakeOrdinaryLogicalCaseExecutionAsync:
    (sourceAssociation, source, signature, selector) => {
        recordedOrdinaryCalls =
            Array(
                ...recordedOrdinaryCalls,
                Array(
                    sourceAssociation,
                    source,
                    signature,
                    selector
                )
            )
        "ordinary-result"
    }

ordinaryBinding: {
    logicalCaseExecutionAsync: fakeOrdinaryLogicalCaseExecutionAsync
}

// Legacy-shaped requirement bindings (D125) that have not been extended with
// a suite-native logical Case execution route must not be silently reused.
actorBindingWithoutLogicalCaseRoute: {
    executionAsync: (source) => { source }
}

testExecutionRequirementBindings: {
    ordinary: ordinaryBinding
    actor: actorBindingWithoutLogicalCaseRoute
}

corpusExecutionRequirements: Map()
corpusExecutionRequirements["corpus-a"] = "ordinary"
corpusExecutionRequirements["corpus-b"] = "actor"

dispatcher:
    Migration.logicalCaseExecutorAsync(
        corpusExecutionRequirements,
        testExecutionRequirementBindings
    )

associationA: Array("corpus-a", "case-a.protos")
associationA.freeze()

dispatchResult:
    dispatcher(
        associationA,
        "source-a",
        Array("selector-a"),
        "selector-a"
    )

Assertions.require(
    dispatchResult == "ordinary-result"
)
Assertions.require(
    recordedOrdinaryCalls.size() == 1
)
Assertions.require(
    recordedOrdinaryCalls[0][0] === associationA
)
Assertions.require(
    recordedOrdinaryCalls[0][1] == "source-a"
)
Assertions.require(
    recordedOrdinaryCalls[0][3] == "selector-a"
)

// A corpus bound to a requirement whose binding has no suite-native
// execution route yet fails closed rather than falling back to a different
// requirement's mechanics.
associationB: Array("corpus-b", "case-b.protos")
associationB.freeze()

Assertions.signals(
    Error,
    () => {
        dispatcher(
            associationB,
            "source-b",
            Array(),
            "case-b"
        )
    }
)

// A corpus with no recorded execution requirement also fails closed.
associationUnknown: Array("corpus-unknown", "case-c.protos")
associationUnknown.freeze()

Assertions.signals(
    Error,
    () => {
        dispatcher(
            associationUnknown,
            "source-c",
            Array(),
            "case-c"
        )
    }
)

true
