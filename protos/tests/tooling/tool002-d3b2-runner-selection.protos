Manifest: import("self:Manifest")
Runner: import("self:Runner")

errorParent: Manifest.parseLine(
    "error-parent.protos\terror-parent\tSlotNotFound"
)
floatNotYet: Manifest.parseLine(
    "float.protos\tfloat-bits\t3ff0000000000000"
)
plan: Manifest.frozenTuple(
    Manifest.frozenTuple(errorParent, floatNotYet)
)

loads: 0
executions: 0

sourceLoader: (spec) => {
    loads = loads + 1
    "ignored"
}

executor: (source) => {
    executions = executions + 1
    {
        state: "failed"
        value: null
        error: SlotNotFound {}
    }
}

run: Runner.runSimpleWithLoader(plan, sourceLoader, executor)

(Runner.runSelectedCount(run) == 1) &&
(Runner.runPassedCount(run) == 1) &&
(Runner.runSkippedCount(run) == 1) &&
Runner.runAllPassed(run) &&
(loads == 1) &&
(executions == 1)
