Manifest: import("self:Manifest")
plan: Manifest.load(filesystem)
cases: Manifest.planCases(plan)
first: cases.at(0)
firstPath: Manifest.casePath(first)

sourceFile: filesystem.open(Manifest.pathValue(firstPath)).value()
sourceReader: TextReader.owning(sourceFile, Encoding.UTF8)
firstChunk: sourceReader.readText().value()
sourceReader.close().value()

(cases.size() > 100) &&
(Manifest.caseId(first) == "integer/add-small.protos") &&
(firstPath == Manifest.caseId(first)) &&
(Manifest.caseExpectation(first) == "integer") &&
(Manifest.caseExpected(first) == "2") &&
(firstChunk.size() > 0)
