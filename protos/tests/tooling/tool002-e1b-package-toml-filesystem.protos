Manifest: import("self:Manifest")

conformanceCases: Manifest.planCases(Manifest.load(filesystem))
packageTomlCases: Manifest.planCases(
    Manifest.loadPackageToml(packageTomlFilesystem)
)

conformanceFirst: conformanceCases.at(0)
packageTomlFirst: packageTomlCases.at(0)

passed: conformanceCases.size() > 0
passed = passed && (packageTomlCases.size() > 0)

passed = passed &&
    (Manifest.caseId(conformanceFirst) == "integer/add-small.protos")
passed = passed &&
    (Manifest.casePath(conformanceFirst) == "integer/add-small.protos")

passed = passed &&
    (Manifest.caseId(packageTomlFirst) ==
        "package-tool/toml-syntax/key-bare-dotted.protos")
passed = passed &&
    (Manifest.casePath(packageTomlFirst) == "key-bare-dotted.protos")
passed = passed &&
    (Manifest.caseExpectation(packageTomlFirst) == "boolean")
passed = passed &&
    (Manifest.caseExpected(packageTomlFirst) == "true")

passed
