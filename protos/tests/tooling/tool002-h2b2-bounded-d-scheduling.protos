Manifest: import("self:Manifest")
Runner: import("self:Runner")

simple: Manifest.caseSpec(Array("h2b2/simple.protos", "integer", "10"))
futureResolved: Manifest.caseSpec(Array("h2b2/future-resolved.protos", "future-integer", "20"))
closureFresh: Manifest.caseSpec(Array("h2b2/closure-fresh.protos", "closure-error-parent-fresh", "InvalidReturn"))
futureTerminal: Manifest.caseSpec(Array("h2b2/future-terminal.protos", "future-error", "-"))
futureObservation: Manifest.caseSpec(Array("h2b2/future-observation.protos", "future-observation-error-identity", "stored:Error"))

plan: Manifest.frozenTuple(
    Manifest.frozenTuple(
        simple,
        futureResolved,
        closureFresh,
        futureTerminal,
        futureObservation
    )
)

closureFreshSource:
    "make: () => {\n" +
    "    () => {\n" +
    "        ^42\n" +
    "    }\n" +
    "}\n" +
    "make()\n"

futureObservationSource:
    "error: Error()\n" +
    "future: (() => {\n" +
    "    error.signal()\n" +
    "}).future()\n" +
    "{\n" +
    "    future: future\n" +
    "    error: error\n" +
    "    observe: () => {\n" +
    "        future.value()\n" +
    "    }\n" +
    "}\n"

sourceLoader: (spec) => {
    id: Manifest.caseId(spec)
    source: null

    (id === "h2b2/simple.protos").ifTrue(() => {
        source = "10"
    })
    (id === "h2b2/future-resolved.protos").ifTrue(() => {
        source = "(() => { 20 }).future()"
    })
    (id === "h2b2/closure-fresh.protos").ifTrue(() => {
        source = closureFreshSource
    })
    (id === "h2b2/future-terminal.protos").ifTrue(() => {
        source = "(() => { Error().signal() }).future()"
    })
    (id === "h2b2/future-observation.protos").ifTrue(() => {
        source = futureObservationSource
    })

    (source === null).ifTrue(() => { Error().signal() })
    source
}

run: Runner.runBoundedWithLoader(
    plan,
    sourceLoader,
    executionAsync,
    executionInspectAsync,
    2
)

results: Runner.runCaseResults(run)
passed: Runner.runSelectedCount(run) == 5
passed = passed && (Runner.runPassedCount(run) == 5)
passed = passed && (Runner.runSkippedCount(run) == 0)
passed = passed && (results.size() == 5)

passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[0])) === "h2b2/simple.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[1])) === "h2b2/future-resolved.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[2])) === "h2b2/closure-fresh.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[3])) === "h2b2/future-terminal.protos"
})
passed.ifTrue(() => {
    passed = Manifest.caseId(Runner.caseRunSpec(results[4])) === "h2b2/future-observation.protos"
})

passed
