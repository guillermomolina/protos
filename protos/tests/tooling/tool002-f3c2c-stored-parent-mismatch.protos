Manifest: import("self:Manifest")
Runner: import("self:Runner")

spec: Manifest.parseLine(
    "future/failed-value-resignals-recorded-error.protos\tfuture-observation-error-identity\tstored:Error"
)

source:
    "storedError: Cancelled()\n" +
    "future: (() => {\n" +
    "    storedError.signal()\n" +
    "}).future()\n" +
    "{\n" +
    "    future: future\n" +
    "    error: storedError\n" +
    "    observe: () => {\n" +
    "        future.value()\n" +
    "    }\n" +
    "}"

evaluation: Runner.evaluateFutureStoredObservation(
    spec,
    source,
    executionInspect
)
observation: Runner.resultObservation(evaluation)

passed: Runner.resultPassed(evaluation) === false
passed.ifTrue(() => {
    passed = observation.state === "completed"
})
passed.ifTrue(() => {
    passed = observation.error === null
})
passed.ifTrue(() => {
    passed = observation.value === false
})

passed
