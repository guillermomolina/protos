Manifest: import("self:Manifest")
Runner: import("self:Runner")

first: Manifest.parseLine("synthetic/first.protos\tinteger\t1")
unsupported: Manifest.parseLine(
    "synthetic/future.protos\ttool002-unsupported-sentinel\t-"
)
second: Manifest.parseLine("synthetic/second.protos\tinteger\t2")
third: Manifest.parseLine("synthetic/third.protos\tinteger\t3")

smallCases: Manifest.frozenTuple(first, unsupported, second, third)
smallPlan: Manifest.frozenTuple(smallCases)

loadCount: 0
executeCount: 0

sourceLoader: (spec) => {
    loadCount = loadCount + 1
    Manifest.caseId(spec)
}

executor: (source) => {
    executeCount = executeCount + 1
    {
        state: "completed"
        value: executeCount
        error: null
    }
}

smallRun: Runner.runSimpleWithLoader(smallPlan, sourceLoader, executor)
smallResults: Runner.runCaseResults(smallRun)

smallOk:
    (Runner.runSelectedCount(smallRun) == 3) &&
    (Runner.runPassedCount(smallRun) == 3) &&
    (Runner.runSkippedCount(smallRun) == 1) &&
    Runner.runAllPassed(smallRun) &&
    (loadCount == 3) &&
    (executeCount == 3) &&
    (smallResults.size() == 3) &&
    (Manifest.caseId(Runner.caseRunSpec(smallResults[0])) == "synthetic/first.protos") &&
    (Manifest.caseId(Runner.caseRunSpec(smallResults[1])) == "synthetic/second.protos") &&
    (Manifest.caseId(Runner.caseRunSpec(smallResults[2])) == "synthetic/third.protos")

repeatSpec: Manifest.parseLine("synthetic/repeated.protos\tboolean\ttrue")
manyCases: Array(repeatSpec)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)
manyCases = Array(...manyCases, ...manyCases)

largePlan: Manifest.frozenTuple(Manifest.frozenTuple(...manyCases))
largeLoads: 0
largeExecutions: 0

largeLoader: (spec) => {
    largeLoads = largeLoads + 1
    "true"
}

largeExecutor: (source) => {
    largeExecutions = largeExecutions + 1
    {
        state: "completed"
        value: true
        error: null
    }
}

largeRun: Runner.runSimpleWithLoader(largePlan, largeLoader, largeExecutor)

smallOk &&
(Runner.runSelectedCount(largeRun) == 1024) &&
(Runner.runPassedCount(largeRun) == 1024) &&
(Runner.runSkippedCount(largeRun) == 0) &&
Runner.runAllPassed(largeRun) &&
(largeLoads == 1024) &&
(largeExecutions == 1024) &&
(Runner.runCaseResults(largeRun).size() == 1024)
