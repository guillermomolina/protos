// TOOL002-owned fresh/cancelled Future shape: a frozen local object exposing
// `future` and `observe`, where `observe` signals a fresh Cancelled-parented
// error identity on every call. Shared by the F3D live-inspection fixtures
// and the F3E unified-policy fixtures. Independent from the
// `protos/tests/conformance` corpus for the same reason as
// `tool002-future-shape-stored.protos`.
future: (() => { 42 }).future()
future.cancel()

{
    future: future
    observe: () => {
        future.value()
    }
}
