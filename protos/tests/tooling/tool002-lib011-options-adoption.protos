Options: import("self:Options")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

// Ordinary, option-like and structural-looking unknown arguments remain a
// TOOL002-local ignore policy. Exact recognized options after them still work.
selected: Options.parse(Array(
    "test",
    "ordinary-unknown",
    "--future-option",
    "--",
    "--jobs",
    "3",
    "--resource-catalog",
    "catalog.toml",
    "trailing-unknown"
))

require(selected[0] == 3)
require(selected[1] == "catalog.toml")

// LIB011 supports attached long values in general, but TOOL002 did not publish
// attached forms. The adapter therefore leaves them unknown rather than silently
// widening D069/D099.
attachedRemainUnknown: Options.parse(Array(
    "test",
    "--jobs=9",
    "--resource-catalog=other.toml"
))
require(attachedRemainUnknown[0] == 1)
require(attachedRemainUnknown[1] === null)

// Once a recognized value-taking option is selected, the next token is literal.
catalogValueLooksLikeJobs:
    Options.parse(Array("test", "--resource-catalog", "--jobs"))
require(catalogValueLooksLikeJobs[0] == 1)
require(catalogValueLooksLikeJobs[1] == "--jobs")

// Unknown options do not claim following values. A later exact TOOL002 option is
// still recognized, matching the historical state-machine parser.
unknownThenJobs:
    Options.parse(Array("test", "--foreign", "--jobs", "4"))
require(unknownThenJobs[0] == 4)
require(unknownThenJobs[1] === null)

// TOOL002 historically did not treat `--` as a structural delimiter.
afterDoubleDash:
    Options.parse(Array("test", "--", "--jobs", "5"))
require(afterDoubleDash[0] == 5)

// Existing fail-closed policy remains owned by the same public selectors.
require(reject(() => {
    Options.jobs(Array("test", "--jobs"))
}))

require(reject(() => {
    Options.jobs(Array("test", "--jobs", "2", "--jobs", "3"))
}))

require(reject(() => {
    Options.jobs(Array("test", "--jobs", "0"))
}))

require(reject(() => {
    Options.jobs(Array("test", "--jobs", "--resource-catalog"))
}))

require(reject(() => {
    Options.resourceCatalogPath(Array(
        "test",
        "--resource-catalog",
        "a.toml",
        "--resource-catalog",
        "b.toml"
    ))
}))

true
