// TOOL009: the Package TOML corpus under
// protos/tests/package-tool/toml-syntax is now suite-native (Test/Assertions
// declarations), so this legacy exact-execution E2A1 slice no longer sources
// its subject from that corpus (its bare-boolean raw-execution contract no
// longer applies there). It instead exercises the packageExecution resolution
// path against a dedicated inline fixture: self:ManifestSchemaV1 resolves
// through the bundled Package Tool closure and its TOML import resolves
// std:toml/TOML through the bundled-tool Standard Library resolver (I079).
observation: packageExecution(
    "Schema: import(\"self:ManifestSchemaV1\")\nmodel: Schema.parseBase(\"manifest-version = 1\\n[package]\\nid = 'p'\\nversion = '1.0.0'\\n\")\nmodel.package.id == \"p\"\n"
)

passed: observation.state === "completed"

passed.ifTrue(() => {
    passed = observation.error === null
})
passed.ifTrue(() => {
    passed = observation.value === true
})
passed.ifTrue(() => {
    passed = observation.stdout.size() == 0
})
passed.ifTrue(() => {
    passed = observation.stderr.size() == 0
})

passed
