Manifest: import("self:Manifest")
Runner: import("self:Runner")

isObservationExpectation: (spec) => {
    Manifest.caseExpectation(spec) === "future-observation-error-identity"
}

isFutureExpectation: (spec) => {
    supported: Runner.isFutureResolvedExpectation(spec)
    Runner.isFutureTerminalExpectation(spec).ifTrue(() => {
        supported = true
    })
    isObservationExpectation(spec).ifTrue(() => {
        supported = true
    })
    supported
}

plan: Manifest.load(filesystem)
cases: Manifest.planCases(plan)
futureCount: 0
passedCount: 0
firstFailure: null

cases.each((spec) => {
    isFutureExpectation(spec).ifTrue(() => {
        futureCount = futureCount + 1
        source: Runner.readSource(spec, filesystem)
        evaluation: null

        Runner.isFutureResolvedExpectation(spec).ifTrue(() => {
            evaluation = Runner.evaluateFutureResolved(
                spec,
                source,
                executionInspect
            )
        })

        (evaluation === null).ifTrue(() => {
            Runner.isFutureTerminalExpectation(spec).ifTrue(() => {
                evaluation = Runner.evaluateFutureTerminal(
                    spec,
                    source,
                    executionInspect
                )
            })
        })

        (evaluation === null).ifTrue(() => {
            isObservationExpectation(spec).ifTrue(() => {
                evaluation = Runner.evaluateFutureObservation(
                    spec,
                    source,
                    executionInspect
                )
            })
        })

        (evaluation === null).ifTrue(() => {
            (firstFailure === null).ifTrue(() => {
                firstFailure = Manifest.caseId(spec)
            })
        })
        (evaluation === null).ifFalse(() => {
            Runner.resultPassed(evaluation).ifTrue(() => {
                passedCount = passedCount + 1
            })
            Runner.resultPassed(evaluation).ifFalse(() => {
                (firstFailure === null).ifTrue(() => {
                    firstFailure = Manifest.caseId(spec)
                })
            })
        })
    })
})

result: firstFailure
(firstFailure === null).ifTrue(() => {
    complete: futureCount > 0
    complete.ifTrue(() => {
        complete = passedCount == futureCount
    })
    complete.ifTrue(() => {
        result = true
    })
    complete.ifFalse(() => {
        result = "tool002-f4b1-count-mismatch"
    })
})

result
