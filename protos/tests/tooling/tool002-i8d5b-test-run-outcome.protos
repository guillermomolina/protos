Runner: import("self:Runner")

// Healthy D108 envelope: no CaseRuns is still a valid completed run and lets the
// projection prove that the historical runTuple is retained unchanged.
healthyD108: Runner.d108RunEnvelope(
    Array(),
    0,
    Array(),
    Array(),
    0
)

healthyOutcome: Runner.testRunOutcomeFromD108(healthyD108)
healthyRun: Runner.testRunOutcomeRun(healthyOutcome)

healthyPassed:
    Runner.testRunOutcomeStatus(healthyOutcome) === "completed"
healthyPassed =
    healthyPassed &&
    (Runner.testRunOutcomeInfrastructureAbort(healthyOutcome) === null)
healthyPassed =
    healthyPassed &&
    (Runner.runCaseResults(healthyRun).size() == 0)
healthyPassed =
    healthyPassed &&
    (Runner.runSelectedCount(healthyRun) == 0)
healthyPassed =
    healthyPassed &&
    (Runner.runPassedCount(healthyRun) == 0)
healthyPassed =
    healthyPassed &&
    (Runner.runSkippedCount(healthyRun) == 0)

// Infrastructure-aborted D108 envelope with deliberately distinguishable payload
// values proves exact field preservation without executing/reporting policy.
executed: Array("executed-a", "executed-b")
attempts: Array("infra-a")
cutover: Array("not-admitted-a", "not-admitted-b")
abortedD108: Runner.d108RunEnvelope(
    executed,
    7,
    attempts,
    cutover,
    2
)

abortedOutcome: Runner.testRunOutcomeFromD108(abortedD108)
abortedPayload:
    Runner.testRunOutcomeInfrastructureAbort(abortedOutcome)

abortedPassed:
    Runner.testRunOutcomeStatus(abortedOutcome) === "infrastructure-aborted"
abortedPassed =
    abortedPassed &&
    (Runner.testRunOutcomeRun(abortedOutcome) === null)
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortExecutedCaseRuns(
            abortedPayload
        ) === executed
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortOrdinaryUnsupportedCount(
            abortedPayload
        ) == 7
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortAttempts(
            abortedPayload
        ) === attempts
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortCutoverNotAdmittedCases(
            abortedPayload
        ) === cutover
    )
abortedPassed =
    abortedPassed &&
    (
        Runner.testRunInfrastructureAbortRetainedUnsafeReservationCount(
            abortedPayload
        ) == 2
    )

healthyPassed && abortedPassed
