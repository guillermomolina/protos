source: {
    equals: (other) => { id == other.id }
    hash: () => { id }
}
view: source.alias("equals", "==")
left: view { id: 7 }
peer: view { id: 7 }

flags: 0
view.hasSlot("equals").ifTrue(() => { flags = flags + 1 })
view.hasSlot("==").ifTrue(() => { flags = flags + 1 })
(source.hasSlot("==")).ifFalse(() => { flags = flags + 1 })
(view.slotValue("equals") === view.slotValue("==")).ifTrue(() => { flags = flags + 1 })
(view.parent() === Object).ifTrue(() => { flags = flags + 1 })
(left == peer).ifTrue(() => { flags = flags + 1 })
(left === peer).ifFalse(() => { flags = flags + 1 })
result: flags
result
