shared: { value: 9 }
source: {
    keep: shared
    drop: 2
}
first: source.without("drop")
second: source.without("drop")

flags: 0
first.hasSlot("keep").ifTrue(() => { flags = flags + 1 })
first.hasSlot("drop").ifFalse(() => { flags = flags + 1 })
(source.hasSlot("drop")).ifTrue(() => { flags = flags + 1 })
(first.slotValue("keep") === shared).ifTrue(() => { flags = flags + 1 })
(first.parent() === Object).ifTrue(() => { flags = flags + 1 })
(first === second).ifFalse(() => { flags = flags + 1 })
result: flags
result
