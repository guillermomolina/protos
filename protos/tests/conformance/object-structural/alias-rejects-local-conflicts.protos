source: {
    value: 1
    existing: 2
}

missing: Error.handle(
    () => {
        source.alias("missing", "copy")
        0
    },
    (caught) => { 1 }
)
collision: Error.handle(
    () => {
        source.alias("value", "existing")
        0
    },
    (caught) => { 1 }
)
sameName: Error.handle(
    () => {
        source.alias("value", "value")
        0
    },
    (caught) => { 1 }
)
result: (missing * 100) + (collision * 10) + sameName
result
