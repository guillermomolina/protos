bytes: Encoding.UTF8.encode("")
low: 0
mid: 127
high: UInt8(255)

addedLow: bytes.add(low)
addedMid: bytes.add(mid)
addedHigh: bytes.add(high)
removed: bytes.removeAt(1)

ok: true
(addedLow === low).ifFalse(() => { ok = false })
(addedMid === mid).ifFalse(() => { ok = false })
(addedHigh === high).ifFalse(() => { ok = false })
(removed === mid).ifFalse(() => { ok = false })
(bytes.size() == 2).ifFalse(() => { ok = false })
(bytes[0] === low).ifFalse(() => { ok = false })
(bytes[1] === high).ifFalse(() => { ok = false })
ok
