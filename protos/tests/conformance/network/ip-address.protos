Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
IpAddress: import("std:network/IpAddresses").IpAddress

tests: Array(
    Test("ip address construction", () => {
        tool009LegacyCase: () => {
            ipv4: IpAddress(4, 4294967295)
            ipv6: IpAddress(6, 340282366920938463463374607431768211455)
            fresh: IpAddress(4, 4294967295)
            ok: true

            (ipv4.parent() === IpAddress).ifFalse(() => { ok = false })
            (ipv6.parent() === IpAddress).ifFalse(() => { ok = false })
            (ipv4.version == 4).ifFalse(() => { ok = false })
            (ipv4.bits == 4294967295).ifFalse(() => { ok = false })
            (ipv6.version == 6).ifFalse(() => { ok = false })
            (ipv6.bits == 340282366920938463463374607431768211455).ifFalse(() => { ok = false })
            (ipv4 === fresh).ifTrue(() => { ok = false })
            IpAddress.recognizes(ipv4).ifFalse(() => { ok = false })
            IpAddress.recognizes(ipv6).ifFalse(() => { ok = false })

            mutationRejected: Error.handle(
                () => {
                    ipv4.bits = 0
                    false
                },
                (error) => { true }
            )
            mutationRejected.ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("ip address validation", () => {
        tool009LegacyCase: () => {
            ok: true

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => { true }
                )
            }

            reject(() => { IpAddress(5, 0) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(4.0, 0) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(4, -1) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(4, 4294967296) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(6, 340282366920938463463374607431768211456) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(4) }).ifFalse(() => { ok = false })
            reject(() => { IpAddress(4, 1, 2) }).ifFalse(() => { ok = false })

            derived: IpAddress {}
            reject(() => { derived(4, 1) }).ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("ip address recognition", () => {
        tool009LegacyCase: () => {
            canonical: IpAddress(4, 1)
            openExactShape: IpAddress {
                version: 4
                bits: 1
            }
            wrongParent: {
                version: 4
                bits: 1
            }
            derived: IpAddress {}
            ok: true

            IpAddress.recognizes(canonical).ifFalse(() => { ok = false })
            IpAddress.recognizes(openExactShape).ifTrue(() => { ok = false })
            IpAddress.recognizes(wrongParent).ifTrue(() => { ok = false })
            IpAddress.recognizes(derived).ifTrue(() => { ok = false })
            IpAddress.recognizes(4).ifTrue(() => { ok = false })

            wrongReceiverRejected: Error.handle(
                () => {
                    derived.recognizes(canonical)
                    false
                },
                (error) => { true }
            )
            wrongReceiverRejected.ifFalse(() => { ok = false })

            wrongArityRejected: Error.handle(
                () => {
                    IpAddress.recognizes()
                    false
                },
                (error) => { true }
            )
            wrongArityRejected.ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("ip address equality hash", () => {
        tool009LegacyCase: () => {
            left: IpAddress(4, 3232235777)
            same: IpAddress(4, 3232235777)
            differentBits: IpAddress(4, 3232235778)
            differentVersion: IpAddress(6, 3232235777)
            addresses: Map()
            ok: true

            (left == same).ifFalse(() => { ok = false })
            (left === same).ifTrue(() => { ok = false })
            (left == differentBits).ifTrue(() => { ok = false })
            (left == differentVersion).ifTrue(() => { ok = false })
            (left == {}).ifTrue(() => { ok = false })
            (left.hash() == same.hash()).ifFalse(() => { ok = false })

            addresses[left] = 77
            (addresses[same] == 77).ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase())
    })
)
tests.freeze()
