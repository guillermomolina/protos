Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("empty snapshots each", () => {
        tool009LegacyCase: () => {
            argumentSnapshot: emptyProcess.args()
            environment: emptyProcess.environment()
            calls: 0

            argsResult: argumentSnapshot.each((value) => {
                calls = calls + 1
                null
            })

            environmentResult: environment.each((name, value) => {
                calls = calls + 1
                null
            })

            (argsResult === argumentSnapshot) &&
                (environmentResult === environment) &&
                (calls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("process descendant receiver error", () => {
        Assertions.signals(Error, () => {
            Fake: process {}
            Fake.args()
        })
    }),
    Test("snapshot content is stable across acquisitions", () => {
        tool009LegacyCase: () => {
            args1: process.args()
            args2: process.args()
            otherArgs: otherProcess.args()

            environment1: process.environment()
            environment2: process.environment()
            otherEnvironment: otherProcess.environment()

            (args1.size() == 3) &&
                (args2.size() == 3) &&
                (otherArgs.size() == 3) &&
                (args1[0] == "alpha") &&
                (args2[0] == "alpha") &&
                (otherArgs[0] == "alpha") &&
                (args1[2] == args2[2]) &&
                (args1[2] == otherArgs[2]) &&
                (environment1.get("A") == "first") &&
                (environment2.get("A") == "first") &&
                (otherEnvironment.get("A") == "first")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
