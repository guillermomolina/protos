args1: process.args()
args2: process.args()
otherArgs: otherProcess.args()

environment1: process.environment()
environment2: process.environment()
otherEnvironment: otherProcess.environment()

(args1 === args2).and() {
    (args1 !== otherArgs).and() {
        (environment1 === environment2).and() {
            environment1 !== otherEnvironment
        }
    }
}
