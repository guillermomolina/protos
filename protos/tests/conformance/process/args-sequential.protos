snapshot: process.args()
seen: Array(null, null, null)
index: 0

callback: {
    call: (value) => {
        seen[index] = value
        index = index + 1
        null
    }
}

result: snapshot.each(callback)

(snapshot.size() == 3) &&
    (snapshot[0] == "alpha") &&
    (snapshot[1] == "\u{3b2}") &&
    (snapshot[2] == "\u{1f600}") &&
    (result === snapshot) &&
    (seen[0] == "alpha") &&
    (seen[1] == "\u{3b2}") &&
    (seen[2] == "\u{1f600}")
