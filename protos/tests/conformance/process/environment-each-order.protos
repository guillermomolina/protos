environment: process.environment()
seen: Array(null, null, null)
index: 0

callback: {
    call: (name, value) => {
        seen.atPut(index, name)
        index = index + 1
        null
    }
}

result: environment.each(callback)

(result === environment).and() {
    (seen.at(0) == "A").and() {
        (seen.at(1) == "\u{e000}").and() {
            seen.at(2) == "\u{10000}"
        }
    }
}
