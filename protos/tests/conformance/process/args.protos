Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("args accessor wrong arity error", () => {
        Assertions.signals(Error, () => {
            process.args(null)
        })
    }),
    Test("args at negative error", () => {
        Assertions.signals(Error, () => {
            process.args().at(-1)
        })
    }),
    Test("args at noninteger error", () => {
        Assertions.signals(Error, () => {
            process.args().at("1")
        })
    }),
    Test("args at out of range error", () => {
        Assertions.signals(Error, () => {
            process.args().at(3)
        })
    }),
    Test("args descendant receiver error", () => {
        Assertions.signals(Error, () => {
            snapshot: process.args()
            Fake: snapshot {}
            Fake.size()
        })
    }),
    Test("args each noninvokable error", () => {
        Assertions.signals(Error, () => {
            bad: {
                call: 1
            }
            process.args().each(bad)
        })
    }),
    Test("args sequential", () => {
        tool009LegacyCase: () => {
            snapshot: process.args()
            seen: Array(null, null, null)
            index: 0

            callback: {
                call: (value) => {
                    seen[index] = value
                    index = index + 1
                    null
                }
            }

            result: snapshot.each(callback)

            (snapshot.size() == 3) &&
                (snapshot[0] == "alpha") &&
                (snapshot[1] == "\u{3b2}") &&
                (snapshot[2] == "\u{1f600}") &&
                (result === snapshot) &&
                (seen[0] == "alpha") &&
                (seen[1] == "\u{3b2}") &&
                (seen[2] == "\u{1f600}")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
