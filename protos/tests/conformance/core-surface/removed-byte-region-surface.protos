Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// D161 removed writable byte regions; these names are ordinary missing slots.
tests: [
    Test("bytes parallelRange is a missing selector", () => {
        Assertions.signals(SlotNotFound, () => {
            bytes: Encoding.UTF8.encode("ab")
            bytes.parallelRange(0, 1, (region) => { null })
        })
    }),
    Test("bytes remain ordinary after missing parallelRange", () => {
        bytes: Encoding.UTF8.encode("ab")
        Assertions.signals(SlotNotFound, () => {
            bytes.parallelRange(0, 2, (region) => { null })
        })
        bytes[0] = 120
        bytes.add(121)
        removed: bytes.removeAt(1)
        Assertions.require(removed === 98)
        Assertions.require(bytes.size() == 2)
        Assertions.require(bytes[0] === 120)
        Assertions.require(bytes[1] === 121)
    }),
    Test("missing byteregion binding", () => {
        Assertions.signals(SlotNotFound, () => {
            ByteRegion
        })
    }),
    Test("missing parallelregionoverlap binding", () => {
        Assertions.signals(SlotNotFound, () => {
            ParallelRegionOverlap
        })
    }),
    Test("missing parallelregioninuse binding", () => {
        Assertions.signals(SlotNotFound, () => {
            ParallelRegionInUse
        })
    }),
    Test("missing parallelregionoutsidep binding", () => {
        Assertions.signals(SlotNotFound, () => {
            ParallelRegionOutsideP
        })
    })
]
tests.freeze()
