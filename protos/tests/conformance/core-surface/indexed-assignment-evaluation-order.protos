trace: {
    value: 0
}

source: {
    put: (index, value) => {
        trace.value = trace.value * 10 + 4
        999
    }
}
receiver: source.alias("put", "atPut")

selectReceiver: () => {
    trace.value = trace.value * 10 + 1
    receiver
}

selectIndex: () => {
    trace.value = trace.value * 10 + 2
    5
}

selectValue: () => {
    trace.value = trace.value * 10 + 3
    7
}

result: (selectReceiver()[selectIndex()] = selectValue())

(trace.value * 10) + result
