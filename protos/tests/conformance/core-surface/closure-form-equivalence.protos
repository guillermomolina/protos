bare: x => x + 1
parenthesized: (x) => x + 1
braced: x => { x + 1 }
zero: () => 5
nested: x => y => x + y

(bare(1) * 10000) +
    (parenthesized(2) * 1000) +
    (braced(3) * 100) +
    (zero() * 10) +
    nested(2)(3)
