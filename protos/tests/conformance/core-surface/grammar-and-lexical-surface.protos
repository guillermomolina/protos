Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("grammar identifiers and member names", () => {
        tool009LegacyCase: () => {
            café: 10
            π2: 11
            日本語: 12
            _private: 13
            value9: 14

            if: 15
            else: 16
            while: 17
            class: 18

            holder: {}
            holder.this: 1
            holder.context: 2
            holder.args: 3
            holder.super: 4
            holder.true: 5
            holder.false: 6
            holder.null: 7

            café + π2 + 日本語 + _private + value9 + if + else + while + class +
                holder.this + holder.context + holder.args + holder.super +
                holder.true + holder.false + holder.null
        }
        Assertions.require(tool009LegacyCase() == 154)
    }),
    Test("grammar integer literals", () => {
        tool009LegacyCase: () => {
            binary: 0b1010_0101
            octal: 0o7_7
            hexadecimal: 0xCA_FE
            decimal: 1_000_000

            binary + octal + hexadecimal + decimal
        }
        Assertions.require(tool009LegacyCase() == 1052194)
    }),
    Test("grammar decimal float literal", () => {
        tool009LegacyCase: () => {
            1.5e2
        }
        Assertions.require(tool009LegacyCase() === 150.0)
    }),
    Test("grammar string literals", () => {
        tool009LegacyCase: () => {
            single: 'a\n\u{41}'
            double: "a\n\u{41}"
            triple: """a\n\u{41}"""
            emptyTriple: """"""
            multiline: """
                hello
                  world
                """

            (single == double) &&
                (double == triple) &&
                (emptyTriple == "") &&
                (multiline == "hello\n  world")
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("grammar separators comments continuation", () => {
        tool009LegacyCase: () => {
            a: 1
            // line comment
            b:
                2
            /* block
            comment
            still comment */
            c: 3
            d: 1 +
                2
            f: (x, y) =>
                { x + y }
            g: f(
                a,
                b
            )
            h: 4; i: 5
            a + b + c + d + g + h + i
        }
        Assertions.require(tool009LegacyCase() == 21)
    }),
    Test("trailing closure newline separation", () => {
        tool009LegacyCase: () => {
            count: 0

            ignore: (tail: null) => {
                count = count + 1
                40
            }

            ignore()
            {
                count = count + 10
            }

            count
        }
        Assertions.require(tool009LegacyCase() == 11)
    }),
    Test("observed Closure Context exposes established local", () => {
        value: {}
        make: () => {
            x: value
            context
        }
        observed: make()
        Assertions.require(observed.hasSlot("x"))
        Assertions.require(observed.slotValue("x") === value)
    }),
    Test("captured binding and observed Context share live mutation", () => {
        make: () => {
            x: 1
            observed: context
            set: (value) => x = value
            get: () => x
            observed
        }
        observed: make()
        observed.set(2)
        Assertions.require(observed.x == 2)
        observed.x = 3
        Assertions.require(observed.get() == 3)
    }),
    Test("completed Closure Context retains values and original identity", () => {
        value: {}
        make: () => {
            x: value
            original: context
            context
        }
        observed: make()
        Assertions.require(observed === observed.original)
        Assertions.require(observed.x === value)
    }),
    Test("removed Closure binding reveals the outer binding until recreated", () => {
        x: 1
        make: () => {
            x: 2
            observed: context
            read: () => x
            before: read()
            observed.removeSlot("x")
            after: read()
            x: 3
            before * 100 + after * 10 + read()
        }
        Assertions.require(make() == 213)
    }),
    Test("removed Closure binding reveals the receiver slot", () => {
        holder: {
            y: 7
            probe: () => {
                y: 1
                observed: context
                observed.removeSlot("y")
                y
            }
        }
        Assertions.require(holder.probe() == 7)
    }),
    Test("binding created through an observed Context shadows an outer binding", () => {
        x: 1
        make: () => {
            observed: context
            read: () => x
            before: read()
            observed.x: 2
            before * 10 + read()
        }
        Assertions.require(make() == 12)
    }),
    Test("captured assignment selects observed Context shadow", () => {
        x: 1
        make: () => {
            observed: context
            write: (value) => { x = value }
            observed.x: 2
            write(3)
            Assertions.require(observed.x == 3)
        }
        make()
        Assertions.require(x == 1)
    }),
    Test("present null Closure binding is not an absent binding", () => {
        x: 5
        make: () => {
            x: null
            observed: context
            present: x === null
            observed.removeSlot("x")
            Assertions.require(present)
            x
        }
        Assertions.require(make() == 5)
    }),
    Test("duplicate creation of a present Closure binding fails", () => {
        make: () => {
            x: 1
            x: 2
        }
        Assertions.signals(Error, make)
    }),
    Test("observed Closure Context reports slotNames in Unicode scalar order", () => {
        make: () => {
            zeta: 1
            alpha: 2
            context
        }
        observed: make()
        first: observed.slotNames()
        second: observed.slotNames()
        Assertions.require(first[0] == "alpha")
        Assertions.require(first[1] == "zeta")
        Assertions.require(first !== second)
    })
]
tests.freeze()
