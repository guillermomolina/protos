future: (() => false).future()
bodyCalls: 0
handled: false
Error.handle(
    () => {
        (() => future).while(() => {
            bodyCalls = bodyCalls + 1
        })
        null
    },
    (caught) => {
        handled = caught.parent() === Error
        null
    }
)
handled.and() {
    bodyCalls == 0
}
