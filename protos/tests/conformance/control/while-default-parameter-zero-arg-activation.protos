conditionCalls: 0
bodyDefaultCalls: 0
bodyCalls: 0
nextCondition: () => {
    conditionCalls = conditionCalls + 1
    conditionCalls == 1
}
bodyDefault: () => {
    bodyDefaultCalls = bodyDefaultCalls + 1
    99
}
condition: (value = nextCondition()) => value
result: condition.while((ignored = bodyDefault()) => {
    bodyCalls = bodyCalls + 1
})
(result === null) &&
    (conditionCalls == 2) &&
    (bodyDefaultCalls == 1) &&
    (bodyCalls == 1)
