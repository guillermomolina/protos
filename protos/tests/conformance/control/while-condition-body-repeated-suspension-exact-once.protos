work: () => {
    conditionBefore: 0
    conditionAfter: 0
    bodyBefore: 0
    bodyAfter: 0
    conditionChildRuns: 0
    bodyChildRuns: 0
    observedTotal: 0

    condition: () => {
        conditionBefore = conditionBefore + 1

        dependency: (() => {
            conditionChildRuns = conditionChildRuns + 1
            conditionBefore
        }).future()

        observedTotal = observedTotal + dependency.value()
        conditionAfter = conditionAfter + 1
        conditionBefore < 4
    }

    condition.while() {
        bodyBefore = bodyBefore + 1

        dependency: (() => {
            bodyChildRuns = bodyChildRuns + 1
            bodyBefore
        }).future()

        observedTotal = observedTotal + dependency.value()
        bodyAfter = bodyAfter + 1
    }

    (conditionBefore * 100000000) +
    (conditionAfter * 10000000) +
    (bodyBefore * 1000000) +
    (bodyAfter * 100000) +
    (conditionChildRuns * 10000) +
    (bodyChildRuns * 1000) +
    observedTotal
}

work.future()
