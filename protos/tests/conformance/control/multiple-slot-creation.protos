Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("multiple slot creation", () => {
        tool009LegacyCase: () => {
            Assertions: import("std:test/Assertions")

            // Success returns the exact original RHS, extracts shallow references in
            // ascending prefix order and ignores extra Array elements.
            firstObject: {
                value: 11
            }
            secondObject: {
                value: 22
            }
            extraObject: {
                value: 33
            }

            source: Array(firstObject, secondObject, extraObject)
            result: (first, second): source

            Assertions.require(result === source)
            Assertions.require(first === firstObject)
            Assertions.require(second === secondObject)

            // The RHS is evaluated exactly once and extraction does not dispatch the
            // user-visible Array 'at' protocol.
            calls: {
                source: 0
                at: 0
            }

            makeSource: () => {
                calls.source = calls.source + 1

                value: Array(4, 5, 6)
                value.at: (index) => {
                    calls.at = calls.at + 1
                    Error().signal()
                }

                value
            }

            madeResult: (madeFirst, madeSecond): makeSource()

            Assertions.require(calls.source == 1)
            Assertions.require(calls.at == 0)
            Assertions.require(madeFirst == 4)
            Assertions.require(madeSecond == 5)

            // Bare targets use the ordinary current slot-creation context. There is no
            // hidden Closure activation around the multiple creation itself.
            closureResult: (() => {
                (closureFirst, closureSecond): Array(7, 8)
                (closureFirst == 7) && (closureSecond == 8)
            })()

            Assertions.require(closureResult)

            // Object bodies likewise create the slots on that object's construction context.
            objectResult: {
                (objectFirst, objectSecond): Array(9, 10)
            }

            Assertions.require(objectResult.objectFirst == 9)
            Assertions.require(objectResult.objectSecond == 10)

            // Open, closed and frozen Array sources are equivalent for this read-only
            // fixed-prefix extraction.
            openArray: Array(11, 12)
            (openFirst, openSecond): openArray

            closedArray: Array(13, 14)
            closedArray.close()
            (closedFirst, closedSecond): closedArray

            frozenArray: Array(15, 16)
            frozenArray.freeze()
            (frozenFirst, frozenSecond): frozenArray

            Assertions.require(openFirst == 11)
            Assertions.require(openSecond == 12)
            Assertions.require(closedFirst == 13)
            Assertions.require(closedSecond == 14)
            Assertions.require(frozenFirst == 15)
            Assertions.require(frozenSecond == 16)

            // A descendant constructed through an Array prototype owns standard indexed
            // state and therefore qualifies.
            MyArray: Array {
                marker: true
            }
            descendantArray: MyArray(31, 32, 33)
            (descendantFirst, descendantSecond): descendantArray

            Assertions.require(descendantFirst == 31)
            Assertions.require(descendantSecond == 32)

            // An object that merely inherits Array behavior but owns no indexed Array state
            // is not an eligible source.
            ArrayLookalike: Array {}

            Assertions.signals(Error, () => {
                (lookalikeFirst, lookalikeSecond): ArrayLookalike
            })

            // Ordinary non-Array sources fail.
            Assertions.signals(Error, () => {
                (objectSourceFirst, objectSourceSecond): {}
            })

            // A short Array fails rather than partially binding a prefix.
            Assertions.signals(Error, () => {
                (shortFirst, shortSecond, shortThird): Array(1, 2)
            })

            // Multiple creation names participate in object-body composition reservation
            // exactly like ordinary bare ':' creations.
            compositionSource: {
                reservedFirst: 99
                contributed: 77
            }

            composed: {
                ...compositionSource
                (reservedFirst, reservedSecond): Array(41, 42)
            }

            Assertions.require(composed.reservedFirst == 41)
            Assertions.require(composed.reservedSecond == 42)
            Assertions.require(composed.contributed == 77)

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
