Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("ensure cancellation cleanup error supersedes", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    dependency.value()
                    41
                }).ensure(() => {
                    cleanupError.signal()
                })
            }).future()

            {
                future: future
                error: cleanupError
                observe: () => {
                    future.value()
                }
            }
        }
        subject: tool009LegacyCase()
        storedError: subject.slotValue("error")
        observe: subject.slotValue("observe")
        same: false

        Error.handle(
            () => {
                observe()
                null
            },
            (caught) => {
                same = (caught === storedError) && (caught.parent() === Error)
                null
            }
        )

        Assertions.require(same)
    })
]
tests.freeze()
