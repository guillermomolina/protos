Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

outerReturnChildStructured: (targetFuture, bodyDependency, setChildRan) => {
    (() => {
        targetFuture.cancel()
        bodyDependency.value()
        41
    }).ensure(() => {
        child: (() => {
            setChildRan(1)
            9
        }).future()
        ^42
    })

    0
}

outerReturnSupersedes: (targetFuture, dependency) => {
    (() => {
        targetFuture.cancel()
        dependency.value()
        41
    }).ensure(() => {
        ^42
    })

    0
}

tests: [
    Test("ensure cancellation cleanup error child structured completion", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()
            childRan: 0

            producer: (() => {
                bodyDependency: Future.all().then((values) => 7)

                Error.handle(
                    () => {
                        (() => {
                            producer.cancel()
                            bodyDependency.value()
                            41
                        }).ensure(() => {
                            child: (() => {
                                childRan = 1
                                9
                            }).future()
                            cleanupError.signal()
                        })
                    },
                    (error) => 42
                )
            }).future()

            observer: (() => {
                value: producer.value()
                childRan * 100 + value
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 142)
    })
    Test("ensure cancellation cleanup error handler recovers", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()

            producer: (() => {
                bodyDependency: Future.all().then((values) => 7)

                Error.handle(
                    () => {
                        (() => {
                            producer.cancel()
                            bodyDependency.value()
                            41
                        }).ensure(() => {
                            cleanupError.signal()
                        })
                    },
                    (error) => 42
                )
            }).future()

            producer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 42)
    })
    Test("ensure cancellation cleanup error supersedes", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    dependency.value()
                    41
                }).ensure(() => {
                    cleanupError.signal()
                })
            }).future()

            {
                future: future
                error: cleanupError
                observe: () => {
                    future.value()
                }
            }
        }
        subject: tool009LegacyCase()
        storedError: subject.slotValue("error")
        observe: subject.slotValue("observe")
        same: false

        Error.handle(
            () => {
                observe()
                null
            },
            (caught) => {
                same = (caught === storedError) && (caught.parent() === Error)
                null
            }
        )

        Assertions.require(same)
    })
    Test("ensure cancellation cleanup return child structured completion", () => {
        childRan: 0

        setChildRan: (value) => {
            childRan = value
            null
        }

        producer: (() => {
            bodyDependency: Future.all().then((values) => 7)
            outerReturnChildStructured(producer, bodyDependency, setChildRan)
        }).future()

        observer: (() => {
            value: producer.value()
            childRan * 100 + value
        }).future()

        futureValue: observer.value()
        Assertions.require(futureValue === 142)
    })
    Test("ensure cancellation cleanup return supersedes", () => {
        future: (() => {
            dependency: Future.all().then((values) => 7)
            outerReturnSupersedes(future, dependency)
        }).future()

        futureValue: future.value()
        Assertions.require(futureValue === 42)
    })
    Test("ensure cancellation suspended cleanup error supersedes", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()

            future: (() => {
                bodyDependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    bodyDependency.value()
                    41
                }).ensure(() => {
                    cleanupDependency: Future.all().then((values) => 9)
                    cleanupDependency.value()
                    cleanupError.signal()
                })
            }).future()

            {
                future: future
                error: cleanupError
                observe: () => {
                    future.value()
                }
            }
        }
        subject: tool009LegacyCase()
        storedError: subject.slotValue("error")
        observe: subject.slotValue("observe")
        same: false

        Error.handle(
            () => {
                observe()
                null
            },
            (caught) => {
                same = (caught === storedError) && (caught.parent() === Error)
                null
            }
        )

        Assertions.require(same)
    })
    Test("ensure selected error cleanup cancellation supersedes handler", () => {
        tool009LegacyCase: () => {
            selectedError: Error()
            handlerRan: 0

            producer: (() => {
                cleanupDependency: Future.all().then((values) => 9)

                Error.handle(
                    () => {
                        (() => {
                            selectedError.signal()
                        }).ensure(() => {
                            producer.cancel()
                            cleanupDependency.value()
                            null
                        })
                    },
                    (error) => {
                        handlerRan = 1
                        null
                    }
                )
            }).future()

            observer: (() => {
                Error.handle(
                    () => producer.value(),
                    (ignored) => null
                )
                handlerRan
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 0)
    })
    Test("ensure selected handler inactive across cleanup suspension", () => {
        tool009LegacyCase: () => {
            work: () => {
                dependency: (() => 7).future()

                Error.handle(() => {
                    Error.handle(() => {
                        (() => Error().signal()).ensure(() => {
                            dependency.value()
                            Error().signal()
                        })
                    }, (caught) => 1)
                }, (caught) => 2)
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 2)
    })
    Test("ensure selected handler inactive during cleanup", () => {
        tool009LegacyCase: () => {
            Error.handle(() => {
                Error.handle(() => {
                    (() => Error().signal()).ensure(() => Error().signal())
                }, (caught) => false)
            }, (caught) => true)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
