// D210: normal results of the standard pre-test loop `whileTrue`. It returns
// the exact result of its last normally completed body activation (canonical
// null for zero iterations). D210 retired the former D201 standard `while`
// selector; `while` remains an ordinary identifier and member name.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

lastBodyOf: (values) => {
    n: 0
    (() => { n < values.size() }).whileTrue() {
        n = n + 1
        values[n - 1]
    }
}

tests: [
    Test("zero iterations return null", () => {
        bodyCalls: 0
        bodyDefaultCalls: 0
        bodyDefault: () => {
            bodyDefaultCalls = bodyDefaultCalls + 1
            0
        }
        result: (() => false).whileTrue((ignored: bodyDefault()) => {
            bodyCalls = bodyCalls + 1
            42
        })
        Assertions.require(result === null)
        Assertions.require(bodyCalls == 0)
        Assertions.require(bodyDefaultCalls == 0)
    }),
    Test("one iteration returns the body result", () => {
        Assertions.require(lastBodyOf([7]) == 7)
    }),
    Test("many iterations return the last body result", () => {
        Assertions.require(lastBodyOf([1, 2, 3]) == 3)
    }),
    Test("last body result keeps its exact value and identity", () => {
        marker: {}
        Assertions.require(lastBodyOf([marker, null]) === null)
        Assertions.require(lastBodyOf([null, true]) === true)
        Assertions.require(lastBodyOf([true, false]) === false)
        Assertions.require(lastBodyOf([null, 42]) == 42)
        Assertions.require(lastBodyOf([null, marker]) === marker)
        Assertions.require(lastBodyOf([false, marker]) === marker)
    }),
    Test("structured, direct and inline loops agree on the result", () => {
        marker: {}
        n: 0
        condition: () => { n < 2 }
        body: () => {
            n = n + 1
            marker
        }
        structuredTrue: condition.whileTrue(body)
        n = 0
        extractedTrue: condition.whileTrue
        directTrue: extractedTrue(body)
        n = 0
        inlineTrue: (() => { n < 2 }).whileTrue() {
            n = n + 1
            marker
        }
        Assertions.require(structuredTrue === marker)
        Assertions.require(directTrue === marker)
        Assertions.require(inlineTrue === marker)
    }),
    Test("body Future is returned without awaiting it", () => {
        failure: Error()
        returned: null
        afterLoop: 0
        i: 0
        result: (() => { i < 1 }).whileTrue() {
            i = i + 1
            returned = (() => { failure.signal() }).future()
            returned
        }
        afterLoop = afterLoop + 1
        resolved: null
        resolvedResult: (() => { i < 2 }).whileTrue() {
            i = i + 1
            resolved = (() => { 5 }).future()
            resolved
        }
        Assertions.require(result === returned)
        Assertions.require(resolvedResult === resolved)
        Assertions.require(resolvedResult.value() == 5)
        Assertions.require(afterLoop == 1)
        observed: Error.handle(
            () => { returned.value() },
            (caught) => caught
        )
        Assertions.require(observed === failure)
    }),
    Test("outer Future adopts the Future returned by whileTrue", () => {
        outer: (() => {
            i: 0
            (() => { i < 2 }).whileTrue() {
                i = i + 1
                (() => { i * 21 }).future()
            }
        }).future()
        Assertions.require(outer.value() == 42)
    }),
    Test("outer Future adopts a failed Future returned by whileTrue", () => {
        failure: Error()
        outer: (() => {
            i: 0
            (() => { i < 1 }).whileTrue() {
                i = i + 1
                (() => { failure.signal() }).future()
            }
        }).future()
        observed: Error.handle(
            () => { outer.value() },
            (caught) => caught
        )
        Assertions.require(observed === failure)
    }),
    Test("outer Future adopts the single-iteration whileTrue Future", () => {
        outer: (() => {
            i: 0
            (() => { i < 1 }).whileTrue() {
                i = i + 1
                (() => { 42 }).future()
            }
        }).future()
        Assertions.require(outer.value() == 42)
    }),
    Test("terminal condition may mutate the returned object", () => {
        box: {}
        box.state: "initial"
        conditionCalls: 0
        condition: () => {
            conditionCalls = conditionCalls + 1
            (conditionCalls > 1).ifTrue(() => {
                box.state = "condition"
            })
            conditionCalls < 3
        }
        result: condition.whileTrue() {
            box.state = "body"
            box
        }
        Assertions.require(result === box)
        Assertions.require(box.state == "condition")
        Assertions.require(conditionCalls == 3)
    }),
    Test("terminal condition Error discards the saved body result", () => {
        expected: Error()
        conditionCalls: 0
        saved: "unset"
        condition: () => {
            conditionCalls = conditionCalls + 1
            (conditionCalls == 2).ifTrue(() => {
                expected.signal()
            })
            true
        }
        caught: Error.handle(
            () => {
                saved = condition.whileTrue() { "body" }
                null
            },
            (caught) => caught
        )
        Assertions.require(caught === expected)
        Assertions.require(saved == "unset")
        Assertions.require(conditionCalls == 2)
    }),
    Test("terminal condition nonlocal return discards the saved body result", () => {
        marker: {}
        saved: "unset"
        afterLoop: 0
        conditionCalls: 0
        outer: () => {
            condition: () => {
                conditionCalls = conditionCalls + 1
                (conditionCalls == 2).ifTrue(() => {
                    ^marker
                })
                true
            }
            saved = condition.whileTrue() { "body" }
            afterLoop = afterLoop + 1
            null
        }
        Assertions.require(outer() === marker)
        Assertions.require(saved == "unset")
        Assertions.require(afterLoop == 0)
        Assertions.require(conditionCalls == 2)
    }),
    Test("whileTrue validates receiver, arity and body before any activation", () => {
        conditionCalls: 0
        condition: () => {
            conditionCalls = conditionCalls + 1
            false
        }
        Assertions.signals(Error, () => {
            true.whileTrue(() => { null })
        })
        plain: {}
        Assertions.signals(Error, () => {
            plain.whileTrue(() => { null })
        })
        Assertions.signals(Error, () => {
            condition.whileTrue()
        })
        Assertions.signals(Error, () => {
            condition.whileTrue(42)
        })
        Assertions.require(conditionCalls == 0)
    }),
    Test("whileTrue binds parameters and defaults only when reached", () => {
        conditionDefaultCalls: 0
        nextCondition: () => {
            conditionDefaultCalls = conditionDefaultCalls + 1
            conditionDefaultCalls == 1
        }
        condition: (value: nextCondition()) => value
        bodyCalls: 0
        result: condition.whileTrue((ignored: 1) => {
            bodyCalls = bodyCalls + 1
            "body"
        })
        Assertions.require(result == "body")
        Assertions.require(conditionDefaultCalls == 2)
        Assertions.require(bodyCalls == 1)
        Assertions.require((() => false).whileTrue((required) => { 1 }) === null)
        // D203: the body's declared parameter binds null; the loop terminates normally.
        remaining: 2
        nullBodies: 0
        Assertions.require((() => remaining > 0).whileTrue((required) => {
            (required === null).ifTrue(() => { nullBodies = nullBodies + 1 })
            remaining = remaining - 1
            required
        }) === null)
        Assertions.require(nullBodies == 2)
        Assertions.require(remaining == 0)
    }),
    Test("suspension in body and terminal condition keeps the result exactly once", () => {
        work: () => {
            conditionBefore: 0
            conditionAfter: 0
            bodyBefore: 0
            bodyAfter: 0
            marker: {}
            condition: () => {
                conditionBefore = conditionBefore + 1
                (() => { null }).future().value()
                conditionAfter = conditionAfter + 1
                conditionBefore < 3
            }
            result: condition.whileTrue() {
                bodyBefore = bodyBefore + 1
                observed: (() => { marker }).future().value()
                bodyAfter = bodyAfter + 1
                observed
            }
            (result === marker) &&
                (conditionBefore == 3) &&
                (conditionAfter == 3) &&
                (bodyBefore == 2) &&
                (bodyAfter == 2)
        }
        Assertions.require(work.future().value() === true)
    }),
    Test("cancellation runs ensure once and produces no loop result", () => {
        observation: () => {
            bodyRuns: 0
            cleanupRuns: 0
            saved: "unset"
            future: (() => {
                dependency: Future.all().then((values) => 7)
                (() => {
                    saved = (() => { bodyRuns < 3 }).whileTrue() {
                        bodyRuns = bodyRuns + 1
                        (bodyRuns == 1).ifTrue(() => {
                            future.cancel()
                        })
                        (bodyRuns > 1).ifTrue(() => {
                            dependency.value()
                        })
                        "body"
                    }
                }).ensure(() => {
                    cleanupRuns = cleanupRuns + 1
                })
            }).future()
            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                (saved == "unset") &&
                    (bodyRuns == 2) &&
                    (cleanupRuns == 1)
            }).future()
            observer
        }
        Assertions.require(observation().value() === true)
    }),
    Test("only whileTrue is standard; while is an ordinary name", () => {
        Assertions.require(Object.hasSlot("whileTrue"))
        Assertions.require(!Object.hasSlot("while"))
        Assertions.require(!Object.hasSlot("whileFalse"))
        holder: {}
        holder.while: 5
        Assertions.require(holder.while === 5)
        custom: {}
        bodyCalls: 0
        custom.while: (body) => "custom"
        Assertions.require(custom.hasSlot("while"))
        Assertions.require(custom.while(() => {
            bodyCalls = bodyCalls + 1
        }) == "custom")
        Assertions.require(bodyCalls == 0)
        while: 3
        Assertions.require(while == 3)
        while = while + 1
        Assertions.require(while == 4)
        extracted: (() => false).whileTrue
        Assertions.require(extracted(() => { 1 }) === null)
        n: 0
        bound: (() => { n < 1 }).whileTrue
        Assertions.require(bound(() => {
            n = n + 1
            "bound"
        }) == "bound")
    })
]
tests.freeze()
