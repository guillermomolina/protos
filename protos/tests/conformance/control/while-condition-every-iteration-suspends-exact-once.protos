work: () => {
    before: 0
    after: 0
    bodyRuns: 0
    childRuns: 0
    observedSum: 0

    condition: () => {
        before = before + 1

        dependency: (() => {
            childRuns = childRuns + 1
            before
        }).future()

        observed: dependency.value()
        after = after + 1
        observedSum = observedSum + observed

        before < 3
    }

    condition.while() {
        bodyRuns = bodyRuns + 1
    }

    (before * 10000) +
    (after * 1000) +
    (bodyRuns * 100) +
    (childRuns * 10) +
    observedSum
}

work.future()
