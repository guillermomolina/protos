Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("while body every iteration suspends exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                conditionRuns: 0
                before: 0
                after: 0
                bodyRuns: 0
                childRuns: 0
                observedSum: 0

                condition: () => {
                    conditionRuns = conditionRuns + 1
                    conditionRuns < 3
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                    before = before + 1

                    dependency: (() => {
                        childRuns = childRuns + 1
                        before
                    }).future()

                    observed: dependency.value()
                    after = after + 1
                    observedSum = observedSum + observed
                    null
                }

                (conditionRuns * 100000) +
                (before * 10000) +
                (after * 1000) +
                (bodyRuns * 100) +
                (childRuns * 10) +
                observedSum
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 322223)
    }),
    Test("while cancellation no loop poll ensure once", () => {
        tool009LegacyCase: () => {
            conditionRuns: 0
            bodyRuns: 0
            afterCancel: 0
            afterBoundary: 0
            cleanupRuns: 0

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    condition: () => {
                        conditionRuns = conditionRuns + 1
                        conditionRuns < 3
                    }

                    condition.whileTrue() {
                        bodyRuns = bodyRuns + 1

                        (bodyRuns < 2).ifTrue(() => {
                            future.cancel()
                            afterCancel = afterCancel + 1
                        })

                        (bodyRuns < 2).ifFalse(() => {
                            dependency.value()
                            afterBoundary = afterBoundary + 1
                        })
                    }
                }).ensure(() => {
                    cleanupRuns = cleanupRuns + 1
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )

                (conditionRuns * 10000) +
                (bodyRuns * 1000) +
                (afterCancel * 100) +
                (cleanupRuns * 10) +
                afterBoundary
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 22110)
    }),
    Test("while condition body repeated suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                conditionBefore: 0
                conditionAfter: 0
                bodyBefore: 0
                bodyAfter: 0
                conditionChildRuns: 0
                bodyChildRuns: 0
                observedTotal: 0

                condition: () => {
                    conditionBefore = conditionBefore + 1

                    dependency: (() => {
                        conditionChildRuns = conditionChildRuns + 1
                        conditionBefore
                    }).future()

                    observedTotal = observedTotal + dependency.value()
                    conditionAfter = conditionAfter + 1
                    conditionBefore < 4
                }

                condition.whileTrue() {
                    bodyBefore = bodyBefore + 1

                    dependency: (() => {
                        bodyChildRuns = bodyChildRuns + 1
                        bodyBefore
                    }).future()

                    observedTotal = observedTotal + dependency.value()
                    bodyAfter = bodyAfter + 1
                }

                (conditionBefore * 100000000) +
                (conditionAfter * 10000000) +
                (bodyBefore * 1000000) +
                (bodyAfter * 100000) +
                (conditionChildRuns * 10000) +
                (bodyChildRuns * 1000) +
                observedTotal
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 443343016)
    }),
    Test("while condition every iteration suspends exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                before: 0
                after: 0
                bodyRuns: 0
                childRuns: 0
                observedSum: 0

                condition: () => {
                    before = before + 1

                    dependency: (() => {
                        childRuns = childRuns + 1
                        before
                    }).future()

                    observed: dependency.value()
                    after = after + 1
                    observedSum = observedSum + observed

                    before < 3
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                }

                (before * 10000) +
                (after * 1000) +
                (bodyRuns * 100) +
                (childRuns * 10) +
                observedSum
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 33236)
    }),
    Test("while condition suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                before: 0
                after: 0
                bodyRuns: 0

                dependency: (() => {
                    7
                }).future()

                condition: () => {
                    before = before + 1
                    dependency.value()
                    after = after + 1
                    before < 2
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                }

                (before * 100) + (after * 10) + bodyRuns
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 221)
    })
]
tests.freeze()
