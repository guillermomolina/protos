Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("while body every iteration suspends exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                conditionRuns: 0
                before: 0
                after: 0
                bodyRuns: 0
                childRuns: 0
                observedSum: 0

                condition: () => {
                    conditionRuns = conditionRuns + 1
                    conditionRuns < 3
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                    before = before + 1

                    dependency: (() => {
                        childRuns = childRuns + 1
                        before
                    }).future()

                    observed: dependency.value()
                    after = after + 1
                    observedSum = observedSum + observed
                    null
                }

                (conditionRuns * 100000) +
                (before * 10000) +
                (after * 1000) +
                (bodyRuns * 100) +
                (childRuns * 10) +
                observedSum
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 322223)
    }),
    Test("while cancellation no loop poll ensure once", () => {
        tool009LegacyCase: () => {
            conditionRuns: 0
            bodyRuns: 0
            afterCancel: 0
            afterBoundary: 0
            cleanupRuns: 0

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    condition: () => {
                        conditionRuns = conditionRuns + 1
                        conditionRuns < 3
                    }

                    condition.whileTrue() {
                        bodyRuns = bodyRuns + 1

                        if(bodyRuns < 2) {
                            future.cancel()
                            afterCancel = afterCancel + 1
                        }

                        (bodyRuns < 2).ifFalse(() => {
                            dependency.value()
                            afterBoundary = afterBoundary + 1
                        })
                    }
                }).ensure(() => {
                    cleanupRuns = cleanupRuns + 1
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )

                (conditionRuns * 10000) +
                (bodyRuns * 1000) +
                (afterCancel * 100) +
                (cleanupRuns * 10) +
                afterBoundary
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 22110)
    }),
    Test("while condition body repeated suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                conditionBefore: 0
                conditionAfter: 0
                bodyBefore: 0
                bodyAfter: 0
                conditionChildRuns: 0
                bodyChildRuns: 0
                observedTotal: 0

                condition: () => {
                    conditionBefore = conditionBefore + 1

                    dependency: (() => {
                        conditionChildRuns = conditionChildRuns + 1
                        conditionBefore
                    }).future()

                    observedTotal = observedTotal + dependency.value()
                    conditionAfter = conditionAfter + 1
                    conditionBefore < 4
                }

                condition.whileTrue() {
                    bodyBefore = bodyBefore + 1

                    dependency: (() => {
                        bodyChildRuns = bodyChildRuns + 1
                        bodyBefore
                    }).future()

                    observedTotal = observedTotal + dependency.value()
                    bodyAfter = bodyAfter + 1
                }

                (conditionBefore * 100000000) +
                (conditionAfter * 10000000) +
                (bodyBefore * 1000000) +
                (bodyAfter * 100000) +
                (conditionChildRuns * 10000) +
                (bodyChildRuns * 1000) +
                observedTotal
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 443343016)
    }),
    Test("while condition every iteration suspends exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                before: 0
                after: 0
                bodyRuns: 0
                childRuns: 0
                observedSum: 0

                condition: () => {
                    before = before + 1

                    dependency: (() => {
                        childRuns = childRuns + 1
                        before
                    }).future()

                    observed: dependency.value()
                    after = after + 1
                    observedSum = observedSum + observed

                    before < 3
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                }

                (before * 10000) +
                (after * 1000) +
                (bodyRuns * 100) +
                (childRuns * 10) +
                observedSum
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 33236)
    }),
    Test("while condition suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                before: 0
                after: 0
                bodyRuns: 0

                dependency: (() => {
                    7
                }).future()

                condition: () => {
                    before = before + 1
                    dependency.value()
                    after = after + 1
                    before < 2
                }

                condition.whileTrue() {
                    bodyRuns = bodyRuns + 1
                }

                (before * 100) + (after * 10) + bodyRuns
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 221)
    }),
    Test("suspending numeric operands are evaluated once per comparison and sum", () => {
        work: () => {
            n: 0
            readRuns: 0
            limitRuns: 0
            stepRuns: 0
            conditionRuns: 0
            bodyRuns: 0
            current: () => {
                readRuns = readRuns + 1
                n
            }
            limit: () => {
                limitRuns = limitRuns + 1
                (() => { 3 }).future().value()
            }
            step: () => {
                stepRuns = stepRuns + 1
                (() => { 2 }).future().value()
            }
            result: (() => {
                conditionRuns = conditionRuns + 1
                current() < limit()
            }).whileTrue() {
                bodyRuns = bodyRuns + 1
                n = current() + step()
            }
            (result == 4) &&
                (n == 4) &&
                (conditionRuns == 3) &&
                (limitRuns == 3) &&
                (bodyRuns == 2) &&
                (stepRuns == 2) &&
                (readRuns == 5)
        }
        Assertions.require(work.future().value() === true)
    }),
    Test("suspended numeric loop error propagates and stops later iterations", () => {
        work: () => {
            n: 0
            bodyRuns: 0
            stepRuns: 0
            expected: Error()
            step: () => {
                stepRuns = stepRuns + 1
                resolved: (() => { 1 }).future().value()
                if(stepRuns == 3) {
                    expected.signal()
                }
                resolved
            }
            handled: Error.handle(
                () => {
                    (() => { n < 10 }).whileTrue() {
                        bodyRuns = bodyRuns + 1
                        n = n + step()
                    }
                    false
                },
                (caught) => caught === expected
            )
            handled &&
                (n == 2) &&
                (bodyRuns == 3) &&
                (stepRuns == 3)
        }
        Assertions.require(work.future().value() === true)
    }),
    Test("numeric loop cancellation runs no later iteration", () => {
        observation: () => {
            n: 0
            bodyRuns: 0
            afterBoundary: 0
            cleanupRuns: 0
            saved: "unset"
            future: (() => {
                dependency: Future.all().then((values) => 7)
                (() => {
                    saved = (() => { n < 5 }).whileTrue() {
                        bodyRuns = bodyRuns + 1
                        n = n + 1
                        if(n == 2) {
                            future.cancel()
                        }
                        if(n > 1) {
                            n = n + dependency.value()
                            afterBoundary = afterBoundary + 1
                        }
                        n
                    }
                }).ensure(() => {
                    cleanupRuns = cleanupRuns + 1
                })
            }).future()
            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                (saved == "unset") &&
                    (n == 2) &&
                    (bodyRuns == 2) &&
                    (afterBoundary == 0) &&
                    (cleanupRuns == 1)
            }).future()
            observer
        }
        Assertions.require(observation().value() === true)
    })
]
tests.freeze()
