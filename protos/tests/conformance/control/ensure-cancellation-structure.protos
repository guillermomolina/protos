Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("ensure cancellation cleanup created child awaited", () => {
        tool009LegacyCase: () => {
            childRan: 0

            future: (() => {
                bodyDependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    bodyDependency.value()
                    41
                }).ensure(() => {
                    child: (() => {
                        childRan = 7
                        9
                    }).future()
                    child.value()
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                childRan
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 7)
    }),
    Test("ensure cancellation cleanup created child drained", () => {
        tool009LegacyCase: () => {
            child: null
            childRan: 0

            future: (() => {
                bodyDependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    bodyDependency.value()
                    41
                }).ensure(() => {
                    child = (() => {
                        childRan = 1
                        9
                    }).future()
                    null
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                Error.handle(
                    () => child.value(),
                    (ignored) => null
                )
                childRan
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 0)
    }),
    Test("ensure cancellation nested lifo", () => {
        tool009LegacyCase: () => {
            order: 0

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    (() => {
                        future.cancel()
                        dependency.value()
                        41
                    }).ensure(() => {
                        order = order * 10 + 1
                    })
                }).ensure(() => {
                    order = order * 10 + 2
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                order
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 12)
    }),
    Test("ensure cancellation preexisting child does not block cleanup", () => {
        tool009LegacyCase: () => {
            preexisting: null
            childRan: 0
            cleaned: 0

            future: (() => {
                preexisting = (() => {
                    childRan = 1
                    9
                }).future()

                bodyDependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    bodyDependency.value()
                    41
                }).ensure(() => {
                    cleaned = cleaned + 1
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                Error.handle(
                    () => preexisting.value(),
                    (ignored) => null
                )
                cleaned * 10 + childRan
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 10)
    }),
    Test("ensure cancellation sync cleanup runs", () => {
        tool009LegacyCase: () => {
            cleaned: 0

            future: (() => {
                dependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    dependency.value()
                    41
                }).ensure(() => {
                    cleaned = cleaned + 1
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                cleaned
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 1)
    }),
    Test("ensure cancellation suspended cleanup shields request", () => {
        tool009LegacyCase: () => {
            cleaned: 0

            future: (() => {
                bodyDependency: Future.all().then((values) => 7)

                (() => {
                    future.cancel()
                    bodyDependency.value()
                    41
                }).ensure(() => {
                    future.cancel()
                    cleanupDependency: Future.all().then((values) => 9)
                    cleaned = cleaned + 1
                    cleanupDependency.value()
                    cleaned = cleaned + 10
                })
            }).future()

            observer: (() => {
                Error.handle(
                    () => future.value(),
                    (ignored) => null
                )
                cleaned
            }).future()

            observer
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 11)
    })
]
tests.freeze()
