conditionRuns: 0
bodyRuns: 0
afterCancel: 0
afterBoundary: 0
cleanupRuns: 0

future: (() => {
    dependency: Future.all().then((values) => 7).detach()

    (() => {
        condition: () => {
            conditionRuns = conditionRuns + 1
            conditionRuns < 3
        }

        condition.while() {
            bodyRuns = bodyRuns + 1

            (bodyRuns < 2).ifTrue(() => {
                future.cancel()
                afterCancel = afterCancel + 1
            })

            (bodyRuns < 2).ifFalse(() => {
                dependency.value()
                afterBoundary = afterBoundary + 1
            })
        }
    }).ensure(() => {
        cleanupRuns = cleanupRuns + 1
    })
}).future()

observer: (() => {
    Error.handle(
        () => future.value(),
        (ignored) => null
    )

    (conditionRuns * 10000) +
    (bodyRuns * 1000) +
    (afterCancel * 100) +
    (cleanupRuns * 10) +
    afterBoundary
}).future()

observer
