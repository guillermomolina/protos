// D231-F2-PURE / I141: the contextual expressions
// `for(item in expression) { body }`, `for(i, start, stop) { body }` and
// `for(i, start, stop, step) { body }` are exactly the ordinary sends
// `expression.each(item => { body })`, `Range(start, stop).each(i => { body })`
// and `Range(start, stop).eachStep(step, i => { body })`. The binder is the
// body Closure's own parameter, `Range` is an ordinary lexical lookup, and the
// result is the result of the selected each/eachStep.

Assertions: import("std:test/assertions")
Test: import("std:test/test")
Arrays: import("std:collections/array")

sameValues: (actual, expected) => {
    same: actual.size() == expected.size()
    index: 0
    while(same && (index < actual.size())) {
        same = Integer.recognizes(actual[index]) && (actual[index] == expected[index])
        index = index + 1
    }
    same
}

tests: [
    Test("contextual for over String keeps order result and ordinary selection", () => {
        values: "A😀B"
        seen: ""
        result: for(n in values) { seen = seen + n }
        Assertions.require(seen === "A😀B")
        Assertions.require(result === values)
        custom: String {}
        custom.each: callback => { callback(9); 42 }
        selected: 0
        customResult: for(n in custom) { selected = n }
        Assertions.require(selected === 9)
        Assertions.require(customResult === 42)
    }),
    Test("contextual for over Vector keeps order result and ordinary selection", () => {
        LA: import("std:math/linear_algebra")
        Vector: LA.Vector
        values: Vector(10, 20, 30)
        seen: 0
        result: for(n in values) { seen = seen * 100 + n }
        Assertions.require(seen === 102030)
        Assertions.require(result === values)
        custom: Vector(10, 20, 30)
        custom.each: callback => { callback(9); 42 }
        selected: 0
        customResult: for(n in custom) { selected = n }
        Assertions.require(selected === 9)
        Assertions.require(customResult === 42)
    }),
    Test("contextual for over Matrix keeps order result and ordinary selection", () => {
        LA: import("std:math/linear_algebra")
        Matrix: LA.Matrix
        values: Matrix(2, 2, 1, 2, 3, 4)
        seen: 0
        result: for(n in values) { seen = seen * 10 + n }
        Assertions.require(seen === 1234)
        Assertions.require(result === values)
        custom: Matrix(2, 2, 1, 2, 3, 4)
        custom.each: callback => { callback(9); 42 }
        selected: 0
        customResult: for(n in custom) { selected = n }
        Assertions.require(selected === 9)
        Assertions.require(customResult === 42)
    }),
    Test("generic for visits an Array in order and returns the Array", () => {
        items: [3, 1, 4]
        visited: Array()
        result: for(item in items) {
            visited = Arrays.append(visited, item)
        }
        Assertions.require(sameValues(visited, Array(3, 1, 4)))
        Assertions.require(result === items)
    }),
    Test("generic for over a Map binds the key and returns the Map", () => {
        map: %{ 1: 10; 2: 20; 3: 30 }
        keySum: 0
        visits: 0
        result: for(key in map) {
            keySum = keySum + key
            visits = visits + 1
        }
        Assertions.require(keySum == 6)
        Assertions.require(visits == 3)
        Assertions.require(result === map)
    }),
    Test("generic for dispatches to the receiver's own each", () => {
        marker: {}
        visited: 0
        bag: {
            each: (callback) => {
                callback(7)
                callback(8)
                marker
            }
        }
        result: for(value in bag) {
            visited = (visited * 10) + value
        }
        Assertions.require(visited == 78)
        Assertions.require(result === marker)
    }),
    Test("numeric for visits ascending and descending ranges", () => {
        up: Array()
        upResult: for(i, 0, 5) {
            up = Arrays.append(up, i)
        }
        down: Array()
        downResult: for(i, 5, 0) {
            down = Arrays.append(down, i)
        }
        Assertions.require(sameValues(up, Array(0, 1, 2, 3, 4)))
        Assertions.require(sameValues(down, Array(5, 4, 3, 2, 1)))
        Assertions.require(upResult === null)
        Assertions.require(downResult === null)
    }),
    Test("stepped numeric for visits with the given step", () => {
        up: Array()
        upResult: for(i, 0, 10, 2) {
            up = Arrays.append(up, i)
        }
        down: Array()
        for(i, 10, 0, -2) {
            down = Arrays.append(down, i)
        }
        Assertions.require(sameValues(up, Array(0, 2, 4, 6, 8)))
        Assertions.require(sameValues(down, Array(10, 8, 6, 4, 2)))
        Assertions.require(upResult === null)
    }),
    Test("equal bounds and invalid steps follow ordinary eachStep", () => {
        bodyCalls: 0
        empty: for(i, 5, 5) {
            bodyCalls = bodyCalls + 1
        }
        Assertions.require(empty === null)
        Assertions.require(bodyCalls == 0)

        // Range(5, 5) is an empty ascending range, so a negative step is
        // invalid; the contextual form never flips the step sign.
        Assertions.signals(Error, () => { for(i, 5, 5, -1) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 0, 3, -1) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 3, 0, 1) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 0, 3, 0) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 0, 3, 1.0) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 0, 3, null) { bodyCalls = bodyCalls + 1 } })
        Assertions.signals(Error, () => { for(i, 0, 3.0) { bodyCalls = bodyCalls + 1 } })
        Assertions.require(bodyCalls == 0)
    }),
    Test("numeric for uses the lexically visible Range", () => {
        marker: {}
        received: Array()
        stepSeen: null
        Range: (start, stop) => {
            received = Array(start, stop)
            {
                each: (callback) => {
                    callback(42)
                    marker
                }
                eachStep: (step, callback) => {
                    stepSeen = step
                    callback(43)
                    marker
                }
            }
        }
        visited: 0
        plain: for(i, 1, 2) {
            visited = (visited * 100) + i
        }
        Assertions.require(sameValues(received, Array(1, 2)))
        stepped: for(i, 3, 4, 5) {
            visited = (visited * 100) + i
        }
        Assertions.require(sameValues(received, Array(3, 4)))
        Assertions.require(stepSeen == 5)
        Assertions.require(visited == 4243)
        Assertions.require(plain === marker)
        Assertions.require(stepped === marker)
    }),
    Test("bounds are evaluated once in order before step", () => {
        trace: 0
        mark: (digit, value) => {
            trace = (trace * 10) + digit
            value
        }
        for(i, mark(1, 0), mark(2, 4), mark(3, 2)) {
            trace = (trace * 10) + 9
        }
        Assertions.require(trace == 12399)

        // A failing Range call happens before step evaluation.
        trace = 0
        Assertions.signals(Error, () => {
            for(i, mark(1, 0), mark(2, 2.5), mark(3, 1)) {
                trace = (trace * 10) + 9
            }
        })
        Assertions.require(trace == 12)

        // With a shadowed Range, construction still precedes step evaluation.
        trace = 0
        Range: (start, stop) => {
            trace = (trace * 10) + 5
            { eachStep: (step, callback) => null }
        }
        for(i, mark(1, 0), mark(2, 1), mark(3, 1)) { null }
        Assertions.require(trace == 1253)
    }),
    Test("dynamic step and unbounded Integer bounds", () => {
        step: -3
        visited: Array()
        for(i, 11, 0, step) {
            visited = Arrays.append(visited, i)
        }
        Assertions.require(sameValues(visited, Array(11, 8, 5, 2)))

        base: 10000000000000000000000000000000000000000
        big: Array()
        for(i, base, base + 3) {
            big = Arrays.append(big, i)
        }
        Assertions.require(sameValues(big, Array(base, base + 1, base + 2)))

        bigStep: Array()
        for(i, 0, base + 1, base) {
            bigStep = Arrays.append(bigStep, i)
        }
        Assertions.require(sameValues(bigStep, Array(0, base)))
    }),
    Test("binder is a fresh body parameter capturing outer bindings", () => {
        i: 99
        total: 0
        readers: Array()
        for(i, 0, 3) {
            total = total + i
            readers = Arrays.append(readers, () => i)
        }
        Assertions.require(i == 99)
        Assertions.require(total == 3)
        Assertions.require((readers[0]() == 0) && (readers[1]() == 1) && (readers[2]() == 2))

        pairs: 0
        for(row in [1, 2]) {
            for(column, 0, 2) {
                pairs = (pairs * 10) + (row * 3) + column
            }
        }
        Assertions.require(pairs == 3467)

        counter: {}
        counter.n: 0
        counter.run: () => {
            for(step in [1, 2, 3]) {
                this.n = this.n + step
            }
            this.n
        }
        Assertions.require(counter.run() == 6)
    }),
    Test("non-local returns, ensure and Errors cross the body normally", () => {
        afterLoop: 0
        findCaret: () => {
            for(i, 0, 10) {
                if(i == 3) { ^i }
            }
            afterLoop = afterLoop + 1
            null
        }
        findReturn: () => {
            for(item in [5, 6, 7]) {
                if(item == 6) { return item }
            }
            afterLoop = afterLoop + 1
            null
        }
        Assertions.require(findCaret() == 3)
        Assertions.require(findReturn() == 6)
        Assertions.require(afterLoop == 0)

        cleaned: 0
        guarded: () => {
            (() => {
                for(i, 0, 5) {
                    if(i == 1) { ^i * 10 }
                }
                null
            }).ensure(() => {
                cleaned = cleaned + 1
            })
        }
        Assertions.require(guarded() == 10)
        Assertions.require(cleaned == 1)

        expected: Error()
        visits: 0
        caught: Error.handle(
            () => {
                for(i, 0, 5) {
                    visits = visits + 1
                    expected.signal()
                }
                null
            },
            (error) => error
        )
        Assertions.require(caught === expected)
        Assertions.require(visits == 1)
    }),
    Test("contextual for agrees with explicit each and eachStep", () => {
        items: [2, 4]
        viaFor: 0
        viaEach: 0
        forResult: for(item in items) { viaFor = viaFor + item }
        eachResult: items.each(item => { viaEach = viaEach + item })
        Assertions.require(viaFor == viaEach)
        Assertions.require(forResult === eachResult)

        stepFor: Array()
        stepEach: Array()
        for(i, 9, 0, -4) { stepFor = Arrays.append(stepFor, i) }
        Range(9, 0).eachStep(-4, i => { stepEach = Arrays.append(stepEach, i) })
        Assertions.require(sameValues(stepFor, stepEach))

        rangeFor: Array()
        rangeEach: Array()
        for(i, 2, 5) { rangeFor = Arrays.append(rangeFor, i) }
        Range(2, 5).each(i => { rangeEach = Arrays.append(rangeEach, i) })
        Assertions.require(sameValues(rangeFor, rangeEach))
    }),
    Test("grouped, member and body-less for spellings stay ordinary", () => {
        received: Array()
        for: (...args) => {
            received = args
            args.size()
        }
        Assertions.require((for)(1, 2, 3) { 4 } == 4)
        Assertions.require(for(1, 2, 3) == 3)
        Assertions.require(for(1, 2) { 3 } == 3)
        Assertions.require(for(1, 2, 3, 4, 5) { 6 } == 6)
        spread: [1, 2, 3]
        Assertions.require(for(...spread) { 4 } == 4)
        holder: {}
        holder.for: (a, b, c, body) => body() + a
        Assertions.require(holder.for(1, 2, 3) { 41 } == 42)

        // A lexical for binding is not consulted by the exact contextual shape.
        received = Array()
        visits: 0
        for(i, 0, 2) { visits = visits + 1 }
        Assertions.require(visits == 2)
        Assertions.require(received.size() == 0)
    }),
    Test("numeric for forms equal their direct Range sends", () => {
        forUnit: Array()
        sendUnit: Array()
        forResult: for(i, -2, 3) { forUnit = Arrays.append(forUnit, i) }
        sendResult: Range(-2, 3).each(i => { sendUnit = Arrays.append(sendUnit, i) })
        Assertions.require(sameValues(forUnit, sendUnit))
        Assertions.require((forResult === null) && (sendResult === null))

        forStep: Array()
        sendStep: Array()
        for(i, 1, 10, 4) { forStep = Arrays.append(forStep, i) }
        Range(1, 10).eachStep(4, i => { sendStep = Arrays.append(sendStep, i) })
        Assertions.require(sameValues(forStep, sendStep))
        Assertions.require(sameValues(forStep, Array(1, 5, 9)))

        forDown: Array()
        sendDown: Array()
        for(i, 3, 0) { forDown = Arrays.append(forDown, i) }
        Range(3, 0).each(i => { sendDown = Arrays.append(sendDown, i) })
        Assertions.require(sameValues(forDown, sendDown))
        Assertions.require(sameValues(forDown, Array(3, 2, 1)))

        forIn: Array()
        for(i in Range(4, 7)) { forIn = Arrays.append(forIn, i) }
        Assertions.require(sameValues(forIn, Array(4, 5, 6)))
    }),
    Test("numeric for step is evaluated after the Range is constructed", () => {
        order: Array()
        start: () => { order = Arrays.append(order, 1); 0 }
        stop: () => { order = Arrays.append(order, 2); 6 }
        step: () => { order = Arrays.append(order, 3); 2 }
        visits: 0
        for(i, start(), stop(), step()) { visits = visits + 1 }
        Assertions.require(sameValues(order, Array(1, 2, 3)))
        Assertions.require(visits == 3)
    }),
    Test("a lexically shadowed Range keeps its user-defined behavior", () => {
        Range: {
            construct: (start, stop) => {
                {
                    start: start
                    stop: stop
                    each: (block) => {
                        block(stop)
                        "each"
                    }
                    eachStep: (step, block) => {
                        block(step)
                        "eachStep"
                    }
                }
            }
        }
        seen: Array()
        unit: for(i, 0, 5) { seen = Arrays.append(seen, i) }
        stepped: for(i, 0, 5, 7) { seen = Arrays.append(seen, i) }
        Assertions.require(unit == "each")
        Assertions.require(stepped == "eachStep")
        Assertions.require(sameValues(seen, Array(5, 7)))
    }),
    Test("numeric for forms equal their direct Range sends over large integers", () => {
        max: 9223372036854775807
        min: -9223372036854775807 - 1
        big: max + 1000

        forUp: Array()
        sendUp: Array()
        forResult: for(i, max - 1, max + 2) { forUp = Arrays.append(forUp, i) }
        sendResult: Range(max - 1, max + 2).each(i => { sendUp = Arrays.append(sendUp, i) })
        Assertions.require(sameValues(forUp, sendUp))
        Assertions.require(sameValues(forUp, Array(max - 1, max, max + 1)))
        Assertions.require((forResult === null) && (sendResult === null))

        forDown: Array()
        sendDown: Array()
        for(i, min + 1, min - 2) { forDown = Arrays.append(forDown, i) }
        InvertedRange(min + 1, min - 2).each(i => { sendDown = Arrays.append(sendDown, i) })
        Assertions.require(sameValues(forDown, sendDown))
        Assertions.require(sameValues(forDown, Array(min + 1, min, min - 1)))

        forStep: Array()
        sendStep: Array()
        for(i, 0 - big, big * 2, big) { forStep = Arrays.append(forStep, i) }
        Range(0 - big, big * 2).eachStep(big, i => { sendStep = Arrays.append(sendStep, i) })
        Assertions.require(sameValues(forStep, sendStep))
        Assertions.require(sameValues(forStep, Array(0 - big, 0, big)))

        forBack: Array()
        sendBack: Array()
        for(i, big, max - 1, 0 - 600) { forBack = Arrays.append(forBack, i) }
        InvertedRange(big, max - 1).eachStep(0 - 600, i => { sendBack = Arrays.append(sendBack, i) })
        Assertions.require(sameValues(forBack, sendBack))
        Assertions.require(sameValues(forBack, Array(big, big - 600)))

        forIn: Array()
        for(i in Range(big, big + 2)) { forIn = Arrays.append(forIn, i) }
        Assertions.require(sameValues(forIn, Array(big, big + 1)))
    }),
    Test("a lexically shadowed Range keeps its behavior over large integers", () => {
        max: 9223372036854775807
        Range: {
            construct: (start, stop) => {
                {
                    each: (block) => {
                        block(stop)
                        "each"
                    }
                }
            }
        }
        seen: Array()
        unit: for(i, max, max + 5) { seen = Arrays.append(seen, i) }
        Assertions.require(unit == "each")
        Assertions.require(sameValues(seen, Array(max + 5)))
    }),
    Test("numeric for and saved normalized ranges share callback control", () => {
        make: (a, b) => { Range(a, b) }
        saved: make(5, 0)
        direct: Array()
        numeric: Array()
        record: value => { direct = Arrays.append(direct, value) }
        Assertions.require(saved.eachStep(-2, record) === null)
        Assertions.require(for(i, 5, 0, -2) {
            numeric = Arrays.append(numeric, i)
        } === null)
        Assertions.require(sameValues(direct, numeric))
        Assertions.require(sameValues(direct, Array(5, 3, 1)))
        Assertions.require(for(i, 4, 4) { Error().signal() } === null)
        Assertions.require(Range(4, 4).each(17) === null)

        numericReturn: () => {
            for(i, 0, 5) { if(i == 2) { ^i } }
            -1
        }
        directReturn: () => {
            make(0, 5).each(i => { if(i == 2) { ^i } })
            -1
        }
        Assertions.require(numericReturn() == directReturn())
        Assertions.signals(Error, () => { for(i, 0, 3) { Error().signal() } })
        Assertions.signals(Error, () => { saved.each(record => { Error().signal() }) })
    }),
    Test("contextual for callback captures accumulator across canonical and custom selection", () => {
        store: { block: null }
        keeper: {
            each: (block) => {
                store.block = block
                store
            }
            eachStep: (step, block) => {
                store.block = block
                store
            }
        }
        values: [13, 18, 6, 42]
        sum: () => {
            total: 0
            for(i, 0, values.size()) { total = total + values[i] }
            total
        }
        Assertions.require(sum() == 79)
        through: (receiver) => {
            total: 100
            returned: for(item in receiver) { total = total + item }
            if(returned === store) {
                total = 1000
                store.block(1)
            }
            total
        }
        Assertions.require(through([1, 2]) == 103)
        Assertions.require(through(keeper) == 1001)
        Assertions.require(through([3]) == 103)
        escaped: store.block
        escaped(10)
        escaped(5)
        nested: () => {
            total: 0
            for(i, 0, 3) { for(j, 0, 2) { total = total + (i * j) } }
            for(i, 0, 7, 3) { total = total * 10 + i }
            total
        }
        Assertions.require(nested() == 3036)
    }),
    Test("for callbacks observe their own context, return, escape and nest", () => {
        own: context
        h: {
            previous: null
            count: 0
        }
        for(i, 0, 3) {
            c: context
            Assertions.require((c !== own) && (c !== h.previous) && (c.hasSlot("i")))
            h.previous = c
            h.count = h.count + 1
        }
        for(i, 4, 0, -2) {
            c: context
            Assertions.require((c !== own) && (c !== h.previous) && (c.hasSlot("i")))
            h.previous = c
            h.count = h.count + 1
        }
        Assertions.require(h.count == 5)
        finder: () => {
            for(i, 0, 9) { (i == 3).ifTrue(() => { ^(i * 7) }) }
            -1
        }
        Assertions.require(finder() == 21)
        store: { block: null }
        keeper: {
            each: (block) => {
                store.block = block
                null
            }
        }
        binding: (receiver) => {
            base: 10
            receiver.each((i) => { base = base + i })
            base = base + 100
            () => { base }
        }
        Assertions.require(binding(Range(0, 2))() == 111)
        read: binding(keeper)
        store.block(5)
        Assertions.require(read() == 115)
        make: (receiver) => {
            receiver.each((i) => { ^(i + 1) })
            0
        }
        Assertions.require(make(keeper) == 0)
        Assertions.signals(InvalidReturn, () => { store.block(3) })
        pairs: () => {
            total: 0
            for(i, 0, 2) {
                for(j, 0, 2) { total = total * 10 + (i * 2 + j) }
            }
            total
        }
        Assertions.require(pairs() == 123)
    })
]
tests.freeze()
