// D212: the standard Closure loop protocols whileFalse (pre-test, receiver is
// the condition, exits on canonical true), untilTrue (post-test, receiver is
// the body, exits on canonical true) and untilFalse (post-test, receiver is
// the body, exits on canonical false). Each returns the exact result of its
// last normally completed body activation.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// Callback order is recorded as decimal digits: 1 for a condition
// activation and 2 for a body activation, oldest first.

tests: [
    Test("standard Object publishes the loop protocol family", () => {
        Assertions.require(Object.hasSlot("whileTrue"))
        Assertions.require(Object.hasSlot("whileFalse"))
        Assertions.require(Object.hasSlot("untilTrue"))
        Assertions.require(Object.hasSlot("untilFalse"))
        Assertions.require(!Object.hasSlot("while"))
        Assertions.require(!Object.hasSlot("until"))
    }),
    Test("whileFalse zero iterations returns null", () => {
        bodyCalls: 0
        result: (() => true).whileFalse(() => {
            bodyCalls = bodyCalls + 1
            42
        })
        Assertions.require(result === null)
        Assertions.require(bodyCalls == 0)
    }),
    Test("whileFalse one iteration", () => {
        n: 0
        result: (() => { n >= 1 }).whileFalse() {
            n = n + 1
            n * 10
        }
        Assertions.require(result == 10)
        Assertions.require(n == 1)
    }),
    Test("whileFalse multiple iterations in pre-test order", () => {
        trace: 0
        n: 0
        (() => {
            trace = trace * 10 + 1
            n >= 3
        }).whileFalse() {
            trace = trace * 10 + 2
            n = n + 1
        }
        Assertions.require(trace == 1212121)
    }),
    Test("untilTrue first iteration activates the body before the condition", () => {
        trace: 0
        (() => {
            trace = trace * 10 + 2
            1
        }).untilTrue(() => {
            trace = trace * 10 + 1
            true
        })
        Assertions.require(trace == 21)
    }),
    Test("untilTrue multiple iterations in post-test order", () => {
        trace: 0
        n: 0
        result: (() => {
            trace = trace * 10 + 2
            n = n + 1
            n * 10
        }).untilTrue(() => {
            trace = trace * 10 + 1
            n >= 3
        })
        Assertions.require(result == 30)
        Assertions.require(trace == 212121)
    }),
    Test("untilFalse first iteration", () => {
        bodyCalls: 0
        conditionCalls: 0
        result: (() => {
            bodyCalls = bodyCalls + 1
            "only"
        }).untilFalse(() => {
            conditionCalls = conditionCalls + 1
            false
        })
        Assertions.require(result == "only")
        Assertions.require(bodyCalls == 1)
        Assertions.require(conditionCalls == 1)
    }),
    Test("untilFalse multiple iterations in post-test order", () => {
        trace: 0
        n: 0
        result: (() => {
            trace = trace * 10 + 2
            n = n + 1
            n
        }).untilFalse(() => {
            trace = trace * 10 + 1
            n < 3
        })
        Assertions.require(result == 3)
        Assertions.require(trace == 212121)
    }),
    Test("last body result keeps its exact value and identity", () => {
        marker: {}
        values: [marker, null, false, marker]
        lastOf: (count) => {
            n: 0
            (() => {
                n = n + 1
                values[n - 1]
            }).untilTrue(() => { n >= count })
        }
        Assertions.require(lastOf(1) === marker)
        Assertions.require(lastOf(2) === null)
        Assertions.require(lastOf(3) === false)
        Assertions.require(lastOf(4) === marker)
        i: 0
        preTest: (() => { i >= 1 }).whileFalse() {
            i = i + 1
            marker
        }
        Assertions.require(preTest === marker)
        Assertions.require((() => { false }).untilFalse(() => false) === false)
        Assertions.require((() => { null }).untilTrue(() => true) === null)
    }),
    Test("body Future is returned without awaiting it", () => {
        failure: Error()
        returned: null
        result: (() => {
            returned = (() => { failure.signal() }).future()
            returned
        }).untilTrue(() => true)
        Assertions.require(result === returned)
        observed: Error.handle(
            () => { returned.value() },
            (caught) => caught
        )
        Assertions.require(observed === failure)
    }),
    Test("condition Future is rejected without awaiting it", () => {
        bodyCalls: 0
        conditionFuture: (() => true).future()
        caught: Error.handle(
            () => {
                (() => {
                    bodyCalls = bodyCalls + 1
                }).untilTrue(() => conditionFuture)
            },
            (error) => error
        )
        Assertions.require(caught.parent() === Error)
        Assertions.require(bodyCalls == 1)
        Assertions.signals(Error, () => {
            (() => conditionFuture).whileFalse(() => null)
        })
    }),
    Test("noncanonical condition results signal fresh Errors", () => {
        first: Error.handle(
            () => { (() => 1).untilFalse(() => 0) },
            (caught) => caught
        )
        second: Error.handle(
            () => { (() => 1).untilFalse(() => 0) },
            (caught) => caught
        )
        Assertions.require(first.parent() === Error)
        Assertions.require(second.parent() === Error)
        Assertions.require(first !== second)
        Assertions.signals(Error, () => { (() => null).whileFalse(() => 1) })
        Assertions.signals(Error, () => { (() => 1).untilTrue(() => Object) })
    }),
    Test("receiver and argument are validated before any activation", () => {
        bodyCalls: 0
        body: () => {
            bodyCalls = bodyCalls + 1
            null
        }
        Assertions.signals(Error, () => { true.whileFalse(body) })
        Assertions.signals(Error, () => { (42).untilTrue(body) })
        Assertions.signals(Error, () => { body.untilTrue(42) })
        Assertions.signals(Error, () => { body.untilFalse(null) })
        Assertions.signals(Error, () => { body.untilTrue() })
        Assertions.signals(Error, () => { body.untilFalse(() => true, () => true) })
        Assertions.signals(Error, () => { (() => false).whileFalse() })
        Assertions.require(bodyCalls == 0)
    }),
    Test("defaults are evaluated only on reached activations", () => {
        bodyDefaultCalls: 0
        conditionDefaultCalls: 0
        bodyDefault: () => {
            bodyDefaultCalls = bodyDefaultCalls + 1
            5
        }
        conditionDefault: () => {
            conditionDefaultCalls = conditionDefaultCalls + 1
            true
        }
        body: (value: bodyDefault()) => value
        result: body.untilTrue((done: conditionDefault()) => done)
        Assertions.require(result == 5)
        Assertions.require(bodyDefaultCalls == 1)
        Assertions.require(conditionDefaultCalls == 1)
        skipped: (() => true).whileFalse((ignored: bodyDefault()) => 1)
        Assertions.require(skipped === null)
        Assertions.require(bodyDefaultCalls == 1)
    }),
    Test("extracted standard loops behave like sends", () => {
        n: 0
        body: () => {
            n = n + 1
            n
        }
        extracted: body.untilTrue
        Assertions.require(extracted(() => { n >= 2 }) == 2)
        n = 0
        Assertions.require(body.untilTrue(() => { n >= 2 }) == 2)
    }),
    Test("a nearer user slot overrides the standard loop", () => {
        bodyCalls: 0
        holder: {}
        holder.untilTrue: (condition) => 7
        holder.whileFalse: (body) => 8
        holder.untilFalse: (condition) => 9
        Assertions.require(holder.untilTrue(() => true) == 7)
        Assertions.require(holder.whileFalse(() => {
            bodyCalls = bodyCalls + 1
        }) == 8)
        Assertions.require(holder.untilFalse(() => false) == 9)
        Assertions.require(bodyCalls == 0)
    }),
    Test("Closure-local loop selectors override standard Object methods", () => {
        receiverCalls: 0
        argumentCalls: 0
        overrideCalls: 0

        condition: () => {
            receiverCalls = receiverCalls + 1
            true
        }
        condition.whileFalse: (body) => {
            overrideCalls = overrideCalls + 1
            "whileFalse override"
        }
        Assertions.require(condition.whileFalse(() => {
            argumentCalls = argumentCalls + 1
        }) == "whileFalse override")
        Assertions.require(overrideCalls == 1)

        untilTrueBody: () => {
            receiverCalls = receiverCalls + 1
            null
        }
        untilTrueBody.untilTrue: (condition) => {
            overrideCalls = overrideCalls + 1
            "untilTrue override"
        }
        Assertions.require(untilTrueBody.untilTrue(() => {
            argumentCalls = argumentCalls + 1
            true
        }) == "untilTrue override")
        Assertions.require(overrideCalls == 2)

        untilFalseBody: () => {
            receiverCalls = receiverCalls + 1
            null
        }
        untilFalseBody.untilFalse: (condition) => {
            overrideCalls = overrideCalls + 1
            "untilFalse override"
        }
        Assertions.require(untilFalseBody.untilFalse(() => {
            argumentCalls = argumentCalls + 1
            false
        }) == "untilFalse override")
        Assertions.require(overrideCalls == 3)

        Assertions.require(receiverCalls == 0)
        Assertions.require(argumentCalls == 0)
    }),
    Test("body Error propagates with identity and skips the condition", () => {
        expected: Error()
        conditionCalls: 0
        afterLoop: 0
        caught: Error.handle(
            () => {
                (() => { expected.signal() }).untilFalse(() => {
                    conditionCalls = conditionCalls + 1
                    true
                })
                afterLoop = afterLoop + 1
                null
            },
            (error) => error
        )
        Assertions.require(caught === expected)
        Assertions.require(conditionCalls == 0)
        Assertions.require(afterLoop == 0)
    }),
    Test("condition Error propagates with identity", () => {
        expected: Error()
        bodyCalls: 0
        caught: Error.handle(
            () => {
                (() => { expected.signal() }).whileFalse(() => {
                    bodyCalls = bodyCalls + 1
                })
            },
            (error) => error
        )
        Assertions.require(caught === expected)
        Assertions.require(bodyCalls == 0)
    }),
    Test("valid nonlocal return propagates from body and condition", () => {
        marker: {}
        conditionCalls: 0
        fromBody: () => {
            (() => {
                ^marker
                null
            }).untilTrue(() => {
                conditionCalls = conditionCalls + 1
                true
            })
            null
        }
        bodyCalls: 0
        fromCondition: () => {
            (() => {
                bodyCalls = bodyCalls + 1
            }).untilFalse(() => {
                ^marker
                true
            })
            null
        }
        Assertions.require(fromBody() === marker)
        Assertions.require(conditionCalls == 0)
        Assertions.require(fromCondition() === marker)
        Assertions.require(bodyCalls == 1)
    }),
    Test("untilFalse body suspension resumes exactly once", () => {
        work: () => {
            conditionRuns: 0
            before: 0
            after: 0
            bodyRuns: 0
            childRuns: 0
            observedSum: 0

            body: () => {
                bodyRuns = bodyRuns + 1
                before = before + 1

                dependency: (() => {
                    childRuns = childRuns + 1
                    before
                }).future()

                observed: dependency.value()
                after = after + 1
                observedSum = observedSum + observed
                null
            }

            body.untilFalse(() => {
                conditionRuns = conditionRuns + 1
                conditionRuns < 3
            })

            (conditionRuns * 100000) +
            (before * 10000) +
            (after * 1000) +
            (bodyRuns * 100) +
            (childRuns * 10) +
            observedSum
        }
        Assertions.require(work.future().value() === 333336)
    }),
    Test("whileFalse condition suspension resumes exactly once", () => {
        work: () => {
            before: 0
            after: 0
            bodyRuns: 0
            childRuns: 0
            observedSum: 0

            condition: () => {
                before = before + 1

                dependency: (() => {
                    childRuns = childRuns + 1
                    before
                }).future()

                observed: dependency.value()
                after = after + 1
                observedSum = observedSum + observed
                before >= 3
            }

            condition.whileFalse() {
                bodyRuns = bodyRuns + 1
            }

            (before * 10000) +
            (after * 1000) +
            (bodyRuns * 100) +
            (childRuns * 10) +
            observedSum
        }
        Assertions.require(work.future().value() === 33236)
    }),
    Test("untilTrue cancellation has no loop poll and runs ensure once", () => {
        conditionRuns: 0
        bodyRuns: 0
        afterCancel: 0
        afterBoundary: 0
        cleanupRuns: 0

        future: (() => {
            dependency: Future.all().then((values) => 7)

            (() => {
                body: () => {
                    bodyRuns = bodyRuns + 1

                    if(bodyRuns < 2) {
                        future.cancel()
                        afterCancel = afterCancel + 1
                    }

                    (bodyRuns < 2).ifFalse(() => {
                        dependency.value()
                        afterBoundary = afterBoundary + 1
                    })
                }

                body.untilTrue(() => {
                    conditionRuns = conditionRuns + 1
                    conditionRuns >= 3
                })
            }).ensure(() => {
                cleanupRuns = cleanupRuns + 1
            })
        }).future()

        observer: (() => {
            Error.handle(
                () => future.value(),
                (ignored) => null
            )

            (conditionRuns * 10000) +
            (bodyRuns * 1000) +
            (afterCancel * 100) +
            (cleanupRuns * 10) +
            afterBoundary
        }).future()

        Assertions.require(observer.value() === 12110)
    })
]
tests.freeze()
