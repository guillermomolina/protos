Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// The protected body and cleanup share this invoked helper's home.
test011EnsureBodyReturn: (trace) => {
    (() => {
        trace.order = trace.order * 10 + 1
        ^42
    }).ensure(() => {
        trace.order = trace.order * 10 + 2
    })

    trace.afterEnsure = true
    0
}

test011EnsureCleanupNormal: (trace) => {
    (() => {
        trace.order = trace.order * 10 + 1
        41
    }).ensure(() => {
        trace.order = trace.order * 10 + 2
        ^43
    })

    trace.afterEnsure = true
    0
}

test011EnsureCleanupPending: (trace) => {
    (() => {
        trace.order = trace.order * 10 + 1
        ^42
    }).ensure(() => {
        trace.order = trace.order * 10 + 2
        ^43
    })

    trace.afterEnsure = true
    0
}

tests: [
    Test("ensure body nonlocal return runs cleanup", () => {
        trace: { order: 0; afterEnsure: false }

        Assertions.require(test011EnsureBodyReturn(trace) == 42)
        Assertions.require(trace.order == 12)
        Assertions.require(trace.afterEnsure == false)
    }),
    Test("ensure cleanup error supersedes normal", () => {
        tool009LegacyCase: () => {
            cleanupError: Error()
            Error.handle(() => {
                (() => 41).ensure(() => cleanupError.signal())
            }, (caught) => caught === cleanupError)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("ensure cleanup nonlocal return supersedes normal", () => {
        trace: { order: 0; afterEnsure: false }

        Assertions.require(test011EnsureCleanupNormal(trace) == 43)
        Assertions.require(trace.order == 12)
        Assertions.require(trace.afterEnsure == false)
    }),
    Test("ensure cleanup nonlocal return supersedes pending return", () => {
        trace: { order: 0; afterEnsure: false }

        Assertions.require(test011EnsureCleanupPending(trace) == 43)
        Assertions.require(trace.order == 12)
        Assertions.require(trace.afterEnsure == false)
    }),
    Test("ensure error cleanup preserves original", () => {
        tool009LegacyCase: () => {
            original: Error()
            cleaned: false
            original.handle(() => {
                (() => original.signal()).ensure(() => {
                    cleaned = true
                })
            }, (caught) => {
                (caught === original) && cleaned
            })
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("ensure nested lifo", () => {
        tool009LegacyCase: () => {
            order: 0
            (() => {
                (() => 1).ensure(() => {
                    order = order * 10 + 1
                })
            }).ensure(() => {
                order = order * 10 + 2
            })
            order
        }
        Assertions.require(tool009LegacyCase() == 12)
    })
]
tests.freeze()
