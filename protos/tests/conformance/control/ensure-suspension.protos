Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

outer: (dependency, addToCount) => {
    (() => {
        ^42
    }).ensure(() => {
        addToCount(1)
        dependency.value()
        addToCount(10)
    })

    0
}

tests: [
    Test("ensure body and cleanup both suspend", () => {
        tool009LegacyCase: () => {
            work: () => {
                count: 0
                bodyDependency: (() => 7).future()

                (() => {
                    count = count + 1
                    bodyDependency.value()
                    count = count + 10
                    41
                }).ensure(() => {
                    cleanupDependency: (() => 9).future()
                    count = count + 100
                    cleanupDependency.value()
                    count = count + 1000
                })

                count
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 1111)
    }),
    Test("ensure body suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                count: 0
                dependency: (() => 7).future()

                (() => {
                    count = count + 1
                    value: dependency.value()
                    count = count + 10
                    value
                }).ensure(() => {
                    count = count + 100
                })

                count
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 111)
    }),
    Test("ensure cleanup suspension exact once", () => {
        tool009LegacyCase: () => {
            work: () => {
                count: 0
                dependency: (() => 7).future()

                (() => {
                    count = count + 1
                    41
                }).ensure(() => {
                    count = count + 10
                    dependency.value()
                    count = count + 100
                })

                count
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 111)
    }),
    Test("ensure cleanup suspension exact result identity", () => {
        tool009LegacyCase: () => {
            work: () => {
                object: {}
                dependency: (() => 7).future()

                result: (() => object).ensure(() => {
                    dependency.value()
                })

                result === object
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === true)
    }),
    Test("ensure error cleanup suspension exact error identity", () => {
        tool009LegacyCase: () => {
            work: () => {
                original: Error()
                dependency: (() => 7).future()

                original.handle(() => {
                    (() => original.signal()).ensure(() => {
                        dependency.value()
                    })
                }, (caught) => caught === original)
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === true)
    }),
    Test("ensure nested cleanup suspension lifo", () => {
        tool009LegacyCase: () => {
            work: () => {
                count: 0
                dependency: (() => 7).future()

                (() => {
                    (() => {
                        count = count * 10 + 1
                    }).ensure(() => {
                        count = count * 10 + 2
                        dependency.value()
                        count = count * 10 + 3
                    })
                }).ensure(() => {
                    count = count * 10 + 4
                })

                count
            }

            work.future()
        }
        futureValue: tool009LegacyCase().value()
        Assertions.require(futureValue === 1234)
    }),
    Test("ensure return cleanup suspension preserves return", () => {
        count: 0

        addToCount: (delta) => {
            count = count + delta
            null
        }

        work: () => {
            dependency: (() => 7).future()
            value: outer(dependency, addToCount)
            count * 100 + value
        }

        futureValue: work.future().value()
        Assertions.require(futureValue === 1142)
    })
]
tests.freeze()
