Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("encoding error parent", () => {
        tool009LegacyFutureCase: () => {
            state: { writes: 0 }
            target: {
                write: (bytes) => {
                    state.writes = state.writes + 1
                    (() => { target }).future()
                }
            }
            writer: TextWriter(target, Encoding.Latin1)
            writer.writeText("€")
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.signals(EncodingError, () => {
            candidate.value()
        })
    })
    Test("encoding failure atomic and reusable", () => {
        tool009LegacyFutureCase: () => {
            state: {
                writes: 0
                size: 0
                byte0: 0
            }
            target: {
                write: (bytes) => {
                    state.writes = state.writes + 1
                    state.size = bytes.size()
                    state.byte0 = bytes[0]
                    (() => { target }).future()
                }
            }
            writer: TextWriter(target, Encoding.Latin1)
            writer.writeText("€")
            valid: writer.writeText("A")
            valid.then((result) => {
                (result === writer) &&
                    (state.writes == 1) &&
                    (state.size == 1) &&
                    (state.byte0 == 65)
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    })
    Test("write order text then line", () => {
        tool009LegacyFutureCase: () => {
            state: {
                writes: 0
                firstSize: 0
                first0: 0
                secondSize: 0
                second0: 0
                second1: 0
            }

            target: {
                write: (bytes) => {
                    current: state.writes
                    (current == 0).ifTrue(() => {
                        state.firstSize = bytes.size()
                        state.first0 = bytes[0]
                    })
                    (current == 1).ifTrue(() => {
                        state.secondSize = bytes.size()
                        state.second0 = bytes[0]
                        state.second1 = bytes[1]
                    })
                    state.writes = current + 1
                    (() => { target }).future()
                }
            }

            writer: TextWriter(target, Encoding.UTF8)
            writer.writeText("A")
            second: writer.writeLine("B")
            second.then((result) => {
                (result === writer) &&
                    (state.writes == 2) &&
                    (state.firstSize == 1) &&
                    (state.first0 == 65) &&
                    (state.secondSize == 2) &&
                    (state.second0 == 66) &&
                    (state.second1 == 10)
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    })
]
tests.freeze()
