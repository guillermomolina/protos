state: {
    writes: 0
    firstSize: 0
    first0: 0
    secondSize: 0
    second0: 0
    second1: 0
}

target: {
    write: (bytes) => {
        current: state.writes
        (current == 0).ifTrue(() => {
            state.firstSize = bytes.size()
            state.first0 = bytes.at(0)
        })
        (current == 1).ifTrue(() => {
            state.secondSize = bytes.size()
            state.second0 = bytes.at(0)
            state.second1 = bytes.at(1)
        })
        state.writes = current + 1
        (() => { target }).future()
    }
}

writer: TextWriter(target, Encoding.UTF8)
writer.writeText("A")
second: writer.writeLine("B")
second.then((result) => {
    (result === writer).and() {
        (state.writes == 2).and() {
            (state.firstSize == 1).and() {
                (state.first0 == 65).and() {
                    (state.secondSize == 2).and() {
                        (state.second0 == 66).and() { state.second1 == 10 }
                    }
                }
            }
        }
    }
})
