state: {
    writes: 0
    size: 0
    byte0: 0
}
target: {
    write: (bytes) => {
        state.writes = state.writes + 1
        state.size = bytes.size()
        state.byte0 = bytes.at(0)
        (() => { target }).future()
    }
}
writer: TextWriter(target, Encoding.UTF8)
writer.writeText(1)
valid: writer.writeText("A")
valid.then((result) => {
    (result === writer) &&
        (state.writes == 1) &&
        (state.size == 1) &&
        (state.byte0 == 65)
})
