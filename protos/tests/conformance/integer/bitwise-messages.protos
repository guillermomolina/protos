Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// D230-C1 (I135): unbounded two's-complement bitwise messages of the common Integer.
tests: [
    Test("bitNot is the complement -x - 1", () => {
        Assertions.require(0.bitNot() == -1)
        Assertions.require((-1).bitNot() == 0)
        Assertions.require(5.bitNot() == -6)
        Assertions.require((-6).bitNot() == 5)
        Assertions.require((9223372036854775807).bitNot() === -9223372036854775808)
        Assertions.require((-9223372036854775808).bitNot() === 9223372036854775807)
        Assertions.require((9223372036854775808).bitNot() == -9223372036854775809)
        Assertions.require((-9223372036854775809).bitNot() === 9223372036854775808)
        Assertions.require((100000000000000000000).bitNot().bitNot() === 100000000000000000000)
    }),
    Test("bitAnd bitOr and bitXor of signed values", () => {
        Assertions.require((-1).bitAnd(42) == 42)
        Assertions.require((-1).bitXor(5) == -6)
        Assertions.require(12.bitAnd(10) == 8)
        Assertions.require(12.bitOr(10) == 14)
        Assertions.require(12.bitXor(10) == 6)
        Assertions.require((-12).bitAnd(10) == 0)
        Assertions.require((-12).bitOr(10) == -2)
        Assertions.require((-12).bitXor(10) == -2)
        Assertions.require(0.bitAnd(-1) == 0)
        Assertions.require(0.bitOr(0) == 0)
        Assertions.require((-8).bitAnd(-12) == -16)
    }),
    Test("bitwise algebraic identities", () => {
        values: Array(0, 1, -1, 5, -6, 4294967295, -9223372036854775808,
            9223372036854775807, 18446744073709551616, -18446744073709551617)
        values.each((x) => {
            Assertions.require(x.bitNot() == -x - 1)
            Assertions.require(x.bitAnd(x) == x)
            Assertions.require(x.bitOr(x) == x)
            Assertions.require(x.bitXor(x) == 0)
            Assertions.require(x.bitAnd(0) == 0)
            Assertions.require(x.bitAnd(-1) == x)
            Assertions.require(x.bitOr(0) == x)
            Assertions.require(x.bitXor(-1) == x.bitNot())
            Assertions.require(x.bitAnd(x.bitNot()) == 0)
            Assertions.require(x.bitOr(x.bitNot()) == -1)
            values.each((y) => {
                Assertions.require(x.bitAnd(y) == y.bitAnd(x))
                Assertions.require(x.bitXor(y) == x.bitOr(y) - x.bitAnd(y))
                Assertions.require(x.bitAnd(y).bitNot() == x.bitNot().bitOr(y.bitNot()))
            })
        })
        null
    }),
    Test("large operands normalize the concrete result family", () => {
        big: 18446744073709551616
        Assertions.require(big.bitOr(1) == 18446744073709551617)
        Assertions.require(big.bitOr(1).parent() === BigInteger)
        Assertions.require(big.bitAnd(1) === 0)
        Assertions.require(big.bitAnd(1).parent() === SmallInteger)
        Assertions.require((big + 7).bitAnd(255) === 7)
        Assertions.require(big.bitXor(big) === 0)
        Assertions.require((-big).bitAnd(-1) == -big)
        Assertions.require((big - 1).bitAnd(9223372036854775807) === 9223372036854775807)
        Assertions.require((-9223372036854775808).bitOr(-1).parent() === SmallInteger)
        Assertions.require((9223372036854775807).bitXor(-1) === -9223372036854775808)
    }),
    Test("shiftLeft multiplies exactly by a power of two", () => {
        Assertions.require(1.shiftLeft(0) == 1)
        Assertions.require(1.shiftLeft(3) == 8)
        Assertions.require((-3).shiftLeft(2) == -12)
        Assertions.require(1.shiftLeft(62) === 4611686018427387904)
        Assertions.require(1.shiftLeft(63) == 9223372036854775808)
        Assertions.require(1.shiftLeft(63).parent() === BigInteger)
        Assertions.require((-1).shiftLeft(63) === -9223372036854775808)
        Assertions.require((-1).shiftLeft(63).parent() === SmallInteger)
        Assertions.require(1.shiftLeft(64) == 18446744073709551616)
        Assertions.require(1.shiftLeft(64).parent() === BigInteger)
        Assertions.require(1.shiftLeft(65) == 36893488147419103232)
        Assertions.require((-1).shiftLeft(64) == -18446744073709551616)
        Assertions.require(1.shiftLeft(128) == 340282366920938463463374607431768211456)
        Assertions.require(0.shiftLeft(64) === 0)
        Assertions.require(0.shiftLeft(2147483648) === 0)
        Assertions.require((3).shiftLeft(100) == 3 * 1.shiftLeft(100))
        Assertions.require(0.shiftLeft(1000000) === 0)
        Assertions.require(0.shiftLeft(100000000000000000000) === 0)
    }),
    Test("shiftRight rounds toward negative infinity", () => {
        Assertions.require((-3).shiftRight(1) == -2)
        Assertions.require((-3).div(2) == -1)
        Assertions.require(7.shiftRight(1) == 3)
        Assertions.require((-7).shiftRight(1) == -4)
        Assertions.require(8.shiftRight(0) == 8)
        Assertions.require((-9223372036854775808).shiftRight(63) == -1)
        Assertions.require((9223372036854775807).shiftRight(62) == 1)
        Assertions.require((9223372036854775807).shiftRight(64) == 0)
        Assertions.require((-1).shiftRight(1000000) == -1)
        Assertions.require(1.shiftRight(1000000) == 0)
        Assertions.require((18446744073709551616).shiftRight(1) === 9223372036854775808)
        Assertions.require((18446744073709551616).shiftRight(2) === 4611686018427387904)
        Assertions.require((18446744073709551616).shiftRight(2).parent() === SmallInteger)
        Assertions.require((-18446744073709551617).shiftRight(64) == -2)
        Assertions.require((-18446744073709551616).shiftRight(65) == -1)
        Assertions.require((18446744073709551616).shiftRight(65) == 0)
    }),
    Test("shift counts beyond the host int range keep the mathematical result", () => {
        huge: 100000000000000000000
        Assertions.require(huge.parent() === BigInteger)
        Assertions.require(1.shiftRight(huge) === 0)
        Assertions.require((-1).shiftRight(huge) === -1)
        Assertions.require((18446744073709551616).shiftRight(huge) === 0)
        Assertions.require((-18446744073709551616).shiftRight(huge) === -1)
        Assertions.require(5.shiftRight(4294967296) === 0)
        Assertions.require((-5).shiftRight(2147483648) === -1)
    }),
    Test("shifts round-trip and agree with multiplication", () => {
        values: Array(1, -1, 5, -6, 9223372036854775807, -9223372036854775808,
            18446744073709551617)
        counts: Array(0, 1, 31, 32, 63, 64, 65, 200)
        values.each((x) => {
            counts.each((n) => {
                Assertions.require(x.shiftLeft(n).shiftRight(n) == x)
                Assertions.require(x.shiftLeft(n) == x * 1.shiftLeft(n))
            })
        })
        null
    }),
    Test("negative shift counts signal Error", () => {
        Assertions.signals(Error, () => 1.shiftLeft(-1))
        Assertions.signals(Error, () => 1.shiftRight(-1))
        Assertions.signals(Error, () => 0.shiftLeft(-1))
        Assertions.signals(Error, () => 1.shiftRight(-100000000000000000000))
        Assertions.signals(Error, () => (18446744073709551616).shiftLeft(-1))
    }),
    Test("non-Integer arguments signal Error without coercion", () => {
        Assertions.signals(Error, () => 1.bitAnd(1.0))
        Assertions.signals(Error, () => 1.bitOr("1"))
        Assertions.signals(Error, () => 1.bitXor(null))
        Assertions.signals(Error, () => 1.bitAnd(true))
        Assertions.signals(Error, () => 1.bitAnd(1 / 2))
        Assertions.signals(Error, () => 1.shiftLeft(1.0))
        Assertions.signals(Error, () => 1.shiftRight(2 / 3))
        integerChild: Integer {}
        numericChild: (3) {}
        Assertions.signals(Error, () => 1.bitAnd(integerChild))
        Assertions.signals(Error, () => 1.shiftLeft(numericChild))
        Assertions.signals(Error, () => (1.5).bitAnd(1))
    }),
    Test("wrong arity signals Error", () => {
        Assertions.signals(Error, () => 1.bitAnd())
        Assertions.signals(Error, () => 1.bitOr(1, 2))
        Assertions.signals(Error, () => 1.bitNot(1))
        Assertions.signals(Error, () => 1.shiftLeft())
        Assertions.signals(Error, () => 1.shiftRight(1, 2))
    }),
    Test("delegating objects are not Integer receivers", () => {
        integerChild: Integer {}
        numericChild: (7) {}
        smallChild: SmallInteger {}
        bigChild: BigInteger {}
        Assertions.signals(Error, () => integerChild.bitNot())
        Assertions.signals(Error, () => numericChild.bitAnd(1))
        Assertions.signals(Error, () => smallChild.shiftLeft(1))
        Assertions.signals(Error, () => bigChild.shiftRight(1))
    }),
    Test("extracted standard messages preserve their receiver", () => {
        Assertions.require((12.bitAnd)(10) == 8)
        Assertions.require(((-3).shiftRight)(1) == -2)
        Assertions.require((5.bitNot)() == -6)
    }),
    Test("user overrides dispatch ordinarily", () => {
        custom: Integer {
            bitAnd: (other) => {
                99
            }
            shiftLeft: (count) => {
                count
            }
        }
        Assertions.require(custom.bitAnd(1) == 99)
        Assertions.require(custom.shiftLeft(-5) == -5)
        Assertions.signals(Error, () => custom.bitOr(1))
    }),
    Test("arguments are evaluated before validation", () => {
        evaluated: 0
        count: () => {
            negative: -1
            evaluated = evaluated + 1
            negative
        }
        Assertions.signals(Error, () => 1.shiftLeft(count()))
        Assertions.require(evaluated == 1)
    }),
    Test("results have value equality identity and hash", () => {
        a: 1.shiftLeft(64)
        b: 18446744073709551616
        Assertions.require(a == b)
        Assertions.require(a === b)
        Assertions.require(a.hash() == b.hash())
        c: a.shiftRight(64)
        Assertions.require(c === 1)
        Assertions.require(c.hash() == (1).hash())
        d: (-1).bitAnd(9223372036854775807)
        Assertions.require(d === 9223372036854775807)
    })
]
tests.freeze()
