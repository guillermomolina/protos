Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("cancel before start", () => {
        future: (() => { 42 }).future()
        future.cancel()

        caught: Assertions.signals(Cancelled, () => { future.value() })
        Assertions.require(caught.parent() === Cancelled)
    }),
    Test("cancelled value fresh error", () => {
        future: (() => { 42 }).future()
        future.cancel()

        first: Assertions.signals(Cancelled, () => { future.value() })
        second: Assertions.signals(Cancelled, () => { future.value() })
        Assertions.require(first.parent() === Cancelled)
        Assertions.require(second.parent() === Cancelled)
        Assertions.require(first !== second)
    }),
    Test("failed value original error identity", () => {
        tool009LegacyCase: () => {
            (() => {
                original: Error()
                failed: (() => {
                    original.signal()
                }).future()

                observed: null
                caught: false

                Error.handle(
                    () => {
                        failed.value()
                        null
                    },
                    (error) => {
                        observed = error
                        caught = true
                        null
                    }
                )

                passed: caught
                passed.ifTrue(() => {
                    passed = observed === original
                })
                passed
            }).future()
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("failed value repeated error identity", () => {
        tool009LegacyCase: () => {
            (() => {
                failed: (() => {
                    Error().signal()
                }).future()

                first: null
                second: null
                firstCaught: false
                secondCaught: false

                Error.handle(
                    () => {
                        failed.value()
                        null
                    },
                    (observed) => {
                        first = observed
                        firstCaught = true
                        null
                    }
                )

                Error.handle(
                    () => {
                        failed.value()
                        null
                    },
                    (observed) => {
                        second = observed
                        secondCaught = true
                        null
                    }
                )

                passed: firstCaught && secondCaught
                passed.ifTrue(() => {
                    passed = first === second
                })
                passed
            }).future()
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("failed value resignals recorded error", () => {
        error: Error()
        future: (() => {
            error.signal()
        }).future()

        first: Assertions.signals(Error, () => { future.value() })
        second: Assertions.signals(Error, () => { future.value() })
        Assertions.require(first === error)
        Assertions.require(second === error)
    })
]
tests.freeze()
