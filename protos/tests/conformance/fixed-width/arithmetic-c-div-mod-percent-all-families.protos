(UInt8(7).div(UInt8(3)) === UInt8(2)) &&
    (UInt8(7).mod(UInt8(3)) === UInt8(1)) &&
    (UInt8(7) % UInt8(3) === UInt8(1)) &&
    (Int8(-7).div(Int8(3)) === Int8(-2)) &&
    (Int8(-7).mod(Int8(3)) === Int8(-1)) &&
    (Int8(-7) % Int8(3) === Int8(-1)) &&
    (UInt16(7).div(UInt16(3)) === UInt16(2)) &&
    (UInt16(7).mod(UInt16(3)) === UInt16(1)) &&
    (UInt16(7) % UInt16(3) === UInt16(1)) &&
    (Int16(-7).div(Int16(3)) === Int16(-2)) &&
    (Int16(-7).mod(Int16(3)) === Int16(-1)) &&
    (Int16(-7) % Int16(3) === Int16(-1)) &&
    (UInt32(7).div(UInt32(3)) === UInt32(2)) &&
    (UInt32(7).mod(UInt32(3)) === UInt32(1)) &&
    (UInt32(7) % UInt32(3) === UInt32(1)) &&
    (Int32(-7).div(Int32(3)) === Int32(-2)) &&
    (Int32(-7).mod(Int32(3)) === Int32(-1)) &&
    (Int32(-7) % Int32(3) === Int32(-1)) &&
    (UInt64(7).div(UInt64(3)) === UInt64(2)) &&
    (UInt64(7).mod(UInt64(3)) === UInt64(1)) &&
    (UInt64(7) % UInt64(3) === UInt64(1)) &&
    (Int64(-7).div(Int64(3)) === Int64(-2)) &&
    (Int64(-7).mod(Int64(3)) === Int64(-1)) &&
    (Int64(-7) % Int64(3) === Int64(-1))
