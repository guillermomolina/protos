(-UInt8(0) === UInt8(0)) &&
    (-Int8(-1) === Int8(1)) &&
    (-UInt16(0) === UInt16(0)) &&
    (-Int16(-1) === Int16(1)) &&
    (-UInt32(0) === UInt32(0)) &&
    (-Int32(-1) === Int32(1)) &&
    (-UInt64(0) === UInt64(0)) &&
    (-Int64(-1) === Int64(1))
