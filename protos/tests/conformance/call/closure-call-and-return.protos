Assertions: import("std:test/assertions")
Test: import("std:test/test")

// The invoked helper owns the home captured by the nested closures.
test011NestedCallReturn: (trace) => {
    outer: () => {
        inner: () => {
            trace.innerCalls = trace.innerCalls + 1
            ^42
        }

        inner()
        trace.afterInner = true
        0
    }

    outer()
    trace.afterOuter = true
    0
}

testI115NamedReturn: (value: null) => { ^value }
testI115IndirectReturn: (f, value) => { f(value) }
testI115DirectReturn: (value) => { ^value }

tests: [
    Test("named and indirect calls preserve return operand identity", () => {
        token: {}
        Assertions.require(testI115NamedReturn(value: token) === token)
        Assertions.require(testI115IndirectReturn(testI115DirectReturn, token) === token)
    }),
    Test("plain closure call", () => {
        tool009LegacyCase: () => {
            identity: (x) => x
            identity(42)
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("closure local call override", () => {
        tool009LegacyCase: () => {
            f: () => 42
            f.call: (x) => x
            f(7)
        }
        Assertions.require(tool009LegacyCase() == 7)
    }),
    Test("non local return crosses nested call", () => {
        trace: {
            innerCalls: 0
            afterInner: false
            afterOuter: false
        }

        Assertions.require(test011NestedCallReturn(trace) == 42)
        Assertions.require(trace.innerCalls == 1)
        Assertions.require(trace.afterInner == false)
        Assertions.require(trace.afterOuter == false)
    })
]
tests.freeze()
