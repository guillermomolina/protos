Thing: {
    inheritedValue: 9

    init: (x) => {
        this.value: x
        null
    }
}

first: Thing(42)
second: Thing(43)

(first !== second) &&
    (first !== Thing) &&
    (first.value == 42) &&
    (second.value == 43) &&
    (first.inheritedValue == 9)
