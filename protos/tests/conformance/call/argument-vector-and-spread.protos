Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("args ordinary local slot", () => {
        tool009LegacyCase: () => {
            f: () => {
                args: 42
                args
            }

            f()
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("args ordinary parameter", () => {
        tool009LegacyCase: () => {
            f: (args) => args

            f(42)
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("args rest forwarding", () => {
        tool009LegacyCase: () => {
            target: (left, right) => left + right

            forward: (...args) => {
                target(...args)
            }

            forward(20, 22)
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("message send spread left to right", () => {
        tool009LegacyCase: () => {
            order: 0

            mark: (value) => {
                order = (order * 10) + value
                value
            }

            Receiver: {
                capture: (a, b, c) => {
                    (order * 1000) + (a * 100) + (b * 10) + c
                }
            }

            Receiver.capture(mark(1), ...Array(mark(2), mark(3)))
        }
        Assertions.require(tool009LegacyCase() == 123123)
    }),
    Test("super spread uses ordinary argument vector", () => {
        tool009LegacyCase: () => {
            base: {
                sum: (a, b) => {
                    a + b
                }
            }

            child: base {
                sum: (...args) => {
                    super.sum(...args)
                }
            }

            child.sum(2, 3)
        }
        Assertions.require(tool009LegacyCase() == 5)
    })
]
tests.freeze()
