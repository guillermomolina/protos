order: 0

mark: (value) => {
    order = (order * 10) + value
    value
}

Receiver: {
    capture: (a, b, c) => {
        (order * 1000) + (a * 100) + (b * 10) + c
    }
}

Receiver.capture(mark(1), ...Array(mark(2), mark(3)))
