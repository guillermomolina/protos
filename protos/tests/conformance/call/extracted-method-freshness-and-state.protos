method: () => this.value
method.note: 7

dog: {
    value: 42
    speak: method
}

a: dog.speak
b: dog.speak

(a !== b).and() {
    (a.note == 7).and() {
        (a() == 42).and() {
            b() == 42
        }
    }
}
