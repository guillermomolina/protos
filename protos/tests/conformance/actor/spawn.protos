Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("resolved reference bootstrap and arguments preserve aliases and local modules", () => {
        ref: import.resolve("workers")
        first: Actor.spawn(ref, "referenceHolder", ref, ref)
        second: Actor.spawn("workers", "referenceHolder", ref, ref)
        Assertions.require(first.request("valid").value())
        Assertions.require(second.request("valid").value())
        Assertions.require(first.request("increment").value() == 1)
        Assertions.require(first.request("increment").value() == 2)
        Assertions.require(second.request("increment").value() == 1)
        null
    }),
    Test("resolved references reject ordinary requests", () => {
        ref: import.resolve("workers")
        worker: Actor.spawn(ref, "echo")
        Assertions.signals(NonTransferableValue, () => worker.request("echo", ref))
        null
    }),
    Test("nested resolved references reject ordinary sends", () => {
        ref: import.resolve("workers")
        worker: Actor.spawn(ref, "echo")
        Assertions.signals(NonTransferableValue, () => worker.send("echo", { nested: [ref] }))
        null
    }),
    Test("resolved references cannot cross an ordinary request reply", () => {
        ref: import.resolve("workers")
        worker: Actor.spawn(ref, "referenceHolder", ref, ref)
        reply: worker.request("replyReference")
        caught: Assertions.signals(NonTransferableValue, () => reply.value())
        Assertions.require(caught.parent() === NonTransferableValue)
        Assertions.require(worker.request("valid").value())
        null
    }),
    Test("GroupRef requests reject direct and nested resolved references", () => {
        ref: import.resolve("workers")
        worker: Actor.spawn(ref, "echo")
        group: Actor.group(worker)
        Assertions.signals(NonTransferableValue, () => group.request("echo", ref))
        Assertions.signals(NonTransferableValue, () => group.request("echo", { nested: [ref] }))
        null
    }),
    Test("GroupRef sends reject direct and nested resolved references", () => {
        ref: import.resolve("workers")
        worker: Actor.spawn(ref, "echo")
        group: Actor.group(worker)
        Assertions.signals(NonTransferableValue, () => group.send("echo", ref))
        Assertions.signals(NonTransferableValue, () => group.send("echo", { nested: [ref] }))
        null
    }),
    Test("a genuine reference acquired inside isolated P cannot cross as its result", () => {
        result: (() => {
            ref: import.resolve("std:runtime")
            if(!import.isReference(ref)) {
                Error().signal()
            }
            ref
        }).parallel()
        caught: Assertions.signals(NonParallelValue, () => result.value())
        Assertions.require(caught.parent() === NonParallelValue)
        null
    }),
    Test("resolved references reject isolated P arguments", () => {
        ref: import.resolve("workers")
        Assertions.signals(NonParallelValue, () => ((value) => value).parallel(ref).value())
        null
    }),
    Test("isolated P does not inherit a captured resolved reference", () => {
        ref: import.resolve("workers")
        closure: () => ref
        Assertions.require(import.isReference(closure()))
        projected: closure.parallel()
        Assertions.signals(SlotNotFound, () => projected.value())
        null
    }),
    Test("spawn request echo", () => {
        tool009LegacyCase: () => {
            worker: Actor.spawn("workers", "echo")
            worker.request("echo", 42)
        }
        Assertions.require(tool009LegacyCase().value() == 42)
    }),
    Test("invalid spawn specifier", () => {
        Assertions.signals(Error, () => {
            Actor.spawn(7, "echo")
        })
    }),
    Test("spawn rejects nontransferable", () => {
        Assertions.signals(Error, () => {
            Actor.spawn("workers", "echo", () => { 1 })
        })
    })
]
tests.freeze()
