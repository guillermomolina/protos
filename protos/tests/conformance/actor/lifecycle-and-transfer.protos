Assertions: import("std:test/assertions")
Test: import("std:test/test")
IpAddress: import("std:network/ip_addresses").IpAddress
IpEndpoint: import("std:network/ip_endpoints").IpEndpoint

tests: [
    Test("stop termination same ref", () => {
        tool009LegacyCase: () => {
            worker: Actor.spawn("workers", "echo")
            terminated: worker.termination()
            worker.stop()
            terminated.then((observed) => { observed === worker })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("ip data transfer", () => {
        tool009LegacyCase: () => {
            address: IpAddress(6, 340282366920938463463374607431768211455)
            endpoint: IpEndpoint(address, 65535)
            worker: Actor.spawn("workers", "echo")

            worker.request("echo", endpoint).then((copy) => {
                ok: true

                IpEndpoint.recognizes(copy).ifFalse(() => { ok = false })
                (copy.parent() === IpEndpoint).ifFalse(() => { ok = false })
                (copy !== endpoint).ifFalse(() => { ok = false })
                (copy.port == 65535).ifFalse(() => { ok = false })
                (copy == endpoint).ifFalse(() => { ok = false })
                (copy.hash() == endpoint.hash()).ifFalse(() => { ok = false })

                IpAddress.recognizes(copy.address).ifFalse(() => { ok = false })
                (copy.address.parent() === IpAddress).ifFalse(() => { ok = false })
                (copy.address !== address).ifFalse(() => { ok = false })
                (copy.address.version == 6).ifFalse(() => { ok = false })
                (copy.address.bits == 340282366920938463463374607431768211455).ifFalse(() => { ok = false })
                (copy.address == address).ifFalse(() => { ok = false })
                (copy.address.hash() == address.hash()).ifFalse(() => { ok = false })

                worker.stop()
                ok
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    // D262-A: slots created or updated reflectively are ordinary slots for
    // Actor transfer; transferability and copy isolation are unchanged.
    Test("reflectively populated object transfers by value", () => {
        worker: Actor.spawn("workers", "echo")
        original: {}
        original.createSlot("dynamic name", 7)
        original.createSlot("count", 1)
        original.updateSlot("count", 2)
        copy: worker.request("echo", original).value()
        worker.stop()
        Assertions.require(copy !== original)
        Assertions.require(copy.slotNames().size() == 2)
        Assertions.require(copy.slotValue("dynamic name") == 7)
        Assertions.require(copy.count == 2)
    }),
    Test("reflectively stored aliases keep graph aliasing on transfer", () => {
        worker: Actor.spawn("workers", "echo")
        shared: { marker: 1 }
        original: {}
        original.createSlot("first", shared)
        original.createSlot("second", shared)
        copy: worker.request("echo", original).value()
        worker.stop()
        Assertions.require(copy.first === copy.second)
        Assertions.require(copy.first !== shared)
        Assertions.require(copy.first.marker == 1)
    }),
    Test("reflectively stored Closure remains non transferable", () => {
        worker: Actor.spawn("workers", "echo")
        created: {}
        created.createSlot("hook", () => { 1 })
        updated: { hook: 1 }
        updated.updateSlot("hook", () => { 2 })
        Assertions.signals(NonTransferableValue, () => {
            worker.request("echo", created)
        })
        Assertions.signals(NonTransferableValue, () => {
            worker.request("echo", updated)
        })
        worker.stop()
        Assertions.require(created.hook() == 1)
        Assertions.require(updated.hook() == 2)
    }),
    Test("mutating a transferred copy does not mutate the sender object", () => {
        worker: Actor.spawn("workers", "mailbox")
        original: {}
        original.createSlot("count", 1)
        worker.request("set", original).value()
        original.updateSlot("count", 2)
        stored: worker.request("get").value()
        snapshot: stored.count
        stored.updateSlot("count", 3)
        worker.stop()
        Assertions.require(snapshot == 1)
        Assertions.require(stored.count == 3)
        Assertions.require(original.count == 2)
    })
]
tests.freeze()
