// D235-B1-F: Actors share the frozen Core Range prototypes while each owns a
// distinct std:collections/Range module instance.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("range actor module identity and rebinding isolation", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")
            worker: Actor.spawn("workers", "ranges")

            worker.request("identity").then((sameInWorker) => {
                worker.request("moduleRange").then((workerRange) => {
                    worker.request("rebind").then((rebound) => {
                        worker.request("moduleRange").then((afterRebind) => {
                            ok: sameInWorker && rebound
                            (workerRange === Range).ifFalse(() => { ok = false })
                            (afterRebind == 7).ifFalse(() => { ok = false })
                            (Ranges.Range === Range).ifFalse(() => { ok = false })
                            (Range(0, 1).parent() === Range).ifFalse(() => { ok = false })
                            worker.stop()
                            ok
                        })
                    })
                })
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("range instance transfer by value", () => {
        tool009LegacyCase: () => {
            big: 100000000000000000000000000000
            original: InvertedRange(big, -big)
            worker: Actor.spawn("workers", "ranges")

            worker.request("bounds", original).then((observed) => {
                worker.stop()
                observed[0] && (observed[1] == big) && (observed[2] == -big)
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("range instance echo keeps canonical parent", () => {
        tool009LegacyCase: () => {
            original: Range(3, 9)
            worker: Actor.spawn("workers", "echo")

            worker.request("echo", original).then((copy) => {
                worker.stop()
                (copy !== original) &&
                    (copy.parent() === Range) &&
                    (copy.start == 3) &&
                    (copy.stop == 9)
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    })
]
tests.freeze()
