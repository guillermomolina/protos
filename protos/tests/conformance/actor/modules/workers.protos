echo: () => {
    {
        echo: (value) => { value }
        readValue: (box) => { box.value }
        current: () => { Actor.current() }
        currentStable: () => { Actor.current() === Actor.current() }
        // BUG035: observes a String plus standard Bytes request payload and
        // mutates only the received Bytes copy.
        inspectBytes: (method, target) => {
            receivedMethod: method
            decodedTarget: Encoding.Latin1.decode(target)
            octetCount: target.size()
            target.atPut(0, 95)
            changedTarget: Encoding.Latin1.decode(target)
            {
                method: receivedMethod
                decoded: decodedTarget
                size: octetCount
                changed: changedTarget
            }
        }
        replyBytes: () => { Encoding.Latin1.encode("actor-reply") }
        replyHttp: () => {
            payload: Encoding.Latin1.encode("body-ok")
            headerValue: Encoding.Latin1.encode("application/json")
            {
                status: 200
                headers: [["content-type", headerValue]]
                body: payload
                bodyAlias: payload
            }
        }
        inspectAliases: (first, second) => { first === second }
    }
}

// BUG035: Bytes transferred as an Actor.spawn initialization argument.
bytesHolder: (initialBytes) => {
    held: initialBytes
    {
        readBytes: () => { held }
    }
}

counter: (initial) => {
    count: initial
    {
        increment: () => {
            count = count + 1
            count
        }
        value: () => { count }
    }
}

mailbox: () => {
    stored: 0
    {
        set: (value) => {
            stored = value
            null
        }
        get: () => { stored }
    }
}

// D235-B1-F: reports this Actor's view of the shared Core Range prototypes and
// of its own Actor-local std:collections/range instance.
ranges: () => {
    {
        identity: () => {
            Ranges: import("std:collections/range")
            (Ranges.Range === Range) && (Ranges.InvertedRange === InvertedRange)
        }
        rebind: () => {
            Ranges: import("std:collections/range")
            Ranges.Range = 7
            (Ranges.Range == 7) && (Range(0, 1).parent() === Range)
        }
        moduleRange: () => {
            import("std:collections/range").Range
        }
        bounds: (range) => {
            Array(range.parent() === InvertedRange, range.start, range.stop)
        }
    }
}
