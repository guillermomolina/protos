echo: () => {
    {
        echo: (value) => { value }
        readValue: (box) => { box.value }
        current: () => { Actor.current() }
        currentStable: () => { Actor.current() === Actor.current() }
    }
}

counter: (initial) => {
    count: initial
    {
        increment: () => {
            count = count + 1
            count
        }
        value: () => { count }
    }
}

mailbox: () => {
    stored: 0
    {
        set: (value) => {
            stored = value
            null
        }
        get: () => { stored }
    }
}
