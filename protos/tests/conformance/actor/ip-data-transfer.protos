address: IpAddress(6, 340282366920938463463374607431768211455)
endpoint: IpEndpoint(address, 65535)
worker: Actor.spawn("workers", "echo")

worker.request("echo", endpoint).then((copy) => {
    ok: true

    IpEndpoint.recognizes(copy).ifFalse(() => { ok = false })
    (copy.parent() === IpEndpoint).ifFalse(() => { ok = false })
    (copy !== endpoint).ifFalse(() => { ok = false })
    (copy.port == 65535).ifFalse(() => { ok = false })
    (copy == endpoint).ifFalse(() => { ok = false })
    (copy.hash() == endpoint.hash()).ifFalse(() => { ok = false })

    IpAddress.recognizes(copy.address).ifFalse(() => { ok = false })
    (copy.address.parent() === IpAddress).ifFalse(() => { ok = false })
    (copy.address !== address).ifFalse(() => { ok = false })
    (copy.address.version == 6).ifFalse(() => { ok = false })
    (copy.address.bits == 340282366920938463463374607431768211455).ifFalse(() => { ok = false })
    (copy.address == address).ifFalse(() => { ok = false })
    (copy.address.hash() == address.hash()).ifFalse(() => { ok = false })

    worker.stop()
    ok
})
