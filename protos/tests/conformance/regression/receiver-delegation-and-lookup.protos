Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("default argument uses dynamic receiver", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1
                read: (selected = value) => { selected }
            }
            child: base { value: 23 }
            child.read()
        }
        Assertions.require(tool009LegacyCase() == 23)
    }),
    Test("delegated method uses dynamic receiver", () => {
        tool009LegacyCase: () => {
            animal: {
                value: 1
                read: () => { value }
            }

            child: animal {
                value: 7
            }

            child.read()
        }
        Assertions.require(tool009LegacyCase() == 7)
    }),
    Test("delegated shadowing", () => {
        tool009LegacyCase: () => {
            parent: { value: 1 }
            child: parent { value: 2 }
            child.value
        }
        Assertions.require(tool009LegacyCase() == 2)
    }),
    Test("extracted inherited method keeps receiver", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1
                read: () => { value }
            }

            child: base {
                value: 9
            }

            reader: child.read
            reader()
        }
        Assertions.require(tool009LegacyCase() == 9)
    }),
    Test("extracted inherited method observes later receiver mutation", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1
                read: () => { value }
            }
            child: base { value: 9 }
            reader: child.read
            child.value = 12
            reader()
        }
        Assertions.require(tool009LegacyCase() == 12)
    }),
    Test("inherited call slot keeps receiver", () => {
        tool009LegacyCase: () => {
            callable: {
                value: 1
                call: () => { value }
            }

            derived: callable {
                value: 9
            }

            derived()
        }
        Assertions.require(tool009LegacyCase() == 9)
    }),
    Test("inherited member assignment signals error", () => {
        Assertions.signals(Error, () => {
            base: {
                value: 1
            }

            child: base {}
            child.value = 2
        })
    }),
    Test("local nonclosure call shadows inherited call", () => {
        Assertions.signals(Error, () => {
            callable: {
                call: () => { 42 }
            }

            derived: callable {
                call: 0
            }

            derived()
        })
    }),
    Test("missing message slot not found", () => {
        Assertions.signals(SlotNotFound, () => {
            ({}).missing()
        })
    }),
    Test("multilevel delegated method uses leaf receiver", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1
                read: () => { value }
            }
            middle: base { value: 5 }
            leaf: middle { value: 17 }
            leaf.read()
        }
        Assertions.require(tool009LegacyCase() == 17)
    }),
    Test("multilevel inherited call keeps leaf receiver", () => {
        tool009LegacyCase: () => {
            callable: {
                value: 1
                call: () => { value }
            }
            middle: callable { value: 5 }
            leaf: middle { value: 18 }
            leaf()
        }
        Assertions.require(tool009LegacyCase() == 18)
    }),
    Test("nested closure retains method receiver state", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1

                makeReader: () => {
                    () => { value }
                }
            }

            child: base {
                value: 7
            }

            reader: child.makeReader()
            child.value = 9
            reader()
        }
        Assertions.require(tool009LegacyCase() == 9)
    }),
    Test("rest arguments on inherited method keep receiver", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1
                combine: (head, ...tail) => {
                    (value * 100) + (head * 10) + tail[0]
                }
            }
            child: base { value: 4 }
            child.combine(2, 3)
        }
        Assertions.require(tool009LegacyCase() == 423)
    }),
    Test("unqualified receiver fallback method keeps receiver", () => {
        tool009LegacyCase: () => {
            base: {
                value: 1

                read: () => {
                    value
                }

                makeReader: () => {
                    () => {
                        read()
                    }
                }
            }

            child: base {
                value: 7
            }

            reader: child.makeReader()
            child.value = 9
            reader()
        }
        Assertions.require(tool009LegacyCase() == 9)
    }),
    Test("one member read site follows own slot mutation and value kind", () => {
        holder: { value: 1 }
        read: () => holder.value

        Assertions.require(read() == 1)
        Assertions.require(read() == 1)
        holder.value = 2
        Assertions.require(read() == 2)
        holder.value = null
        Assertions.require(read() === null)

        holder.value = () => 40
        first: read()
        second: read()
        Assertions.require(first() == 40)
        Assertions.require(first !== second)
        holder.value = 3
        Assertions.require(read() == 3)
    }),
    Test("one member read site follows shadowing removal and recreation", () => {
        parent: { value: 1 }
        holder: parent {}
        read: () => holder.value

        Assertions.require(read() == 1)
        parent.value = 2
        Assertions.require(read() == 2)
        holder.value: 3
        Assertions.require(read() == 3)
        holder.removeSlot("value")
        Assertions.require(read() == 2)

        own: { value: 4 }
        readOwn: () => own.value
        Assertions.require(readOwn() == 4)
        own.removeSlot("value")
        Assertions.signals(SlotNotFound, () => { readOwn() })
        own.value: 5
        Assertions.require(readOwn() == 5)
    }),
    Test("one member read site follows its captured receiver binding", () => {
        holder: { value: 1 }
        read: () => holder.value

        Assertions.require(read() == 1)
        holder = { value: 2 }
        Assertions.require(read() == 2)
        holder = 7
        Assertions.signals(SlotNotFound, () => { read() })

        outer: () => {
            reader: () => holder.value
            before: reader()
            holder: { value: "nearer" }
            [before, reader()]
        }
        holder = { value: "outer" }
        result: outer()
        Assertions.require(result[0] == "outer")
        Assertions.require(result[1] == "nearer")
    }),
    Test("one member read site serves distinct activations and frozen receivers", () => {
        make: (initial) => {
            box: { value: initial }
            [box, () => box.value]
        }
        readers: [make(1), make(2), make(3), make(4), make(5)]

        Assertions.require(readers[0][1]() == 1)
        Assertions.require(readers[1][1]() == 2)
        Assertions.require(readers[4][1]() == 5)
        readers[1][0].value = 20
        Assertions.require(readers[1][1]() == 20)
        Assertions.require(readers[0][1]() == 1)

        readers[2][0].freeze()
        Assertions.require(readers[2][1]() == 3)
        Assertions.signals(Error, () => { readers[2][0].value = 30 })
        Assertions.require(readers[2][1]() == 3)
    })
]
tests.freeze()
