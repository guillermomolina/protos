positiveInfinity: 1.0 / 0.0
negativeInfinity: -1.0 / 0.0
nan: 0.0 / 0.0

ok: true
((-0.0) < 0).ifTrue(() => { ok = false })
((-0.0) <= 0).ifFalse(() => { ok = false })
(0 >= (-0.0)).ifFalse(() => { ok = false })
(positiveInfinity > 999999999999999999999999999999).ifFalse(() => { ok = false })
(negativeInfinity < -999999999999999999999999999999).ifFalse(() => { ok = false })
(nan < 1).ifTrue(() => { ok = false })
(nan <= 1).ifTrue(() => { ok = false })
(1 > nan).ifTrue(() => { ok = false })
(1 >= nan).ifTrue(() => { ok = false })
ok
