// D262-A reflective createSlot/updateSlot on genuine execution contexts follow
// the ordinary object rules and the live lexical membership of
// EXECUTION_AND_CONTROL §4 and §6.

Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("reflective creation of a name with no static declaration", () => {
        fn: () => {
            context.createSlot("dynamicOnly", 1)
            context.hasSlot("dynamicOnly")
        }
        Assertions.require(fn() === true)
    }),
    Test("bare lookup observes a reflectively created binding", () => {
        fn: () => {
            context.createSlot("dynamicOnly", 41)
            dynamicOnly + 1
        }
        Assertions.require(fn() == 42)
    }),
    Test("bare assignment updates a reflectively created binding", () => {
        fn: () => {
            here: context
            here.createSlot("dynamicOnly", 1)
            dynamicOnly = 5
            here.slotValue("dynamicOnly")
        }
        Assertions.require(fn() == 5)
    }),
    Test("reflective update of a declared local is observed by bare reads", () => {
        fn: () => {
            local: 1
            before: local
            context.updateSlot("local", 2)
            [before, local]
        }
        result: fn()
        Assertions.require(result[0] == 1)
        Assertions.require(result[1] == 2)
    }),
    Test("reflective update of a captured local is observed by sibling Closures", () => {
        fn: () => {
            shared: 1
            first: () => shared
            second: () => shared * 10
            context.updateSlot("shared", 3)
            [first(), second()]
        }
        result: fn()
        Assertions.require(result[0] == 3)
        Assertions.require(result[1] == 30)
    }),
    Test("reflective creation after capture is observed by an existing Closure", () => {
        fn: () => {
            reader: () => late
            context.createSlot("late", 42)
            reader()
        }
        Assertions.require(fn() == 42)
    }),
    Test("reflective creation shadows an outer same-named binding", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                context.createSlot("probe", "inner")
                probe
            }
            [inner(), probe]
        }
        result: outer()
        Assertions.require(result[0] == "inner")
        Assertions.require(result[1] == "outer")
    }),
    Test("reflective creation shadows receiver fallback", () => {
        holder: {
            receiverProbe: "receiver"
            read: () => {
                before: receiverProbe
                context.createSlot("receiverProbe", "local")
                [before, receiverProbe, this.receiverProbe]
            }
        }
        result: holder.read()
        Assertions.require(result[0] == "receiver")
        Assertions.require(result[1] == "local")
        Assertions.require(result[2] == "receiver")
    }),
    Test("reflective removal exposes the outer binding again", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                here: context
                here.createSlot("probe", "inner")
                before: probe
                here.removeSlot("probe")
                [before, probe]
            }
            inner()
        }
        result: outer()
        Assertions.require(result[0] == "inner")
        Assertions.require(result[1] == "outer")
    }),
    Test("reflective recreation restores the nearer binding", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                here: context
                here.createSlot("probe", "first")
                here.removeSlot("probe")
                exposed: probe
                here.createSlot("probe", "second")
                [exposed, probe]
            }
            inner()
        }
        result: outer()
        Assertions.require(result[0] == "outer")
        Assertions.require(result[1] == "second")
    }),
    Test("removal and reflective recreation of a declared local", () => {
        fn: () => {
            local: 1
            here: context
            here.removeSlot("local")
            absent: here.hasSlot("local") === false
            here.createSlot("local", 2)
            local = local + 1
            [absent, local, here.slotValue("local")]
        }
        result: fn()
        Assertions.require(result[0] === true)
        Assertions.require(result[1] == 3)
        Assertions.require(result[2] == 3)
    }),
    Test("removal and reflective recreation of a captured local keep sharing", () => {
        fn: () => {
            shared: 1
            here: context
            reader: () => shared
            writer: () => {
                shared = shared + 10
            }
            here.removeSlot("shared")
            here.createSlot("shared", 5)
            writer()
            [reader(), shared, here.slotValue("shared")]
        }
        result: fn()
        Assertions.require(result[0] == 15)
        Assertions.require(result[1] == 15)
        Assertions.require(result[2] == 15)
    }),
    Test("reflective creation makes a later static creation of that name fail", () => {
        fn: () => {
            context.createSlot("later", 1)
            later: 2
            later
        }
        Assertions.signals(Error, () => { fn() })
    }),
    Test("reflective update targets only the supplied context", () => {
        outer: () => {
            shared: "outer"
            inner: () => {
                here: context
                Assertions.signals(Error, () => {
                    here.updateSlot("shared", "inner")
                })
                here.hasSlot("shared")
            }
            [inner(), shared]
        }
        result: outer()
        Assertions.require(result[0] === false)
        Assertions.require(result[1] == "outer")
    }),
    Test("an escaped context remains usable through its identity", () => {
        makeEscaped: () => {
            context
        }
        escaped: makeEscaped()
        escaped.createSlot("added", 1)
        escaped.updateSlot("added", 2)
        Assertions.require(escaped.slotValue("added") == 2)
    }),
    Test("a returned Closure observes a later reflective update", () => {
        make: () => {
            stored: 1
            [context, () => stored]
        }
        (escaped, reader): make()
        before: reader()
        escaped.updateSlot("stored", 9)
        Assertions.require(before == 1)
        Assertions.require(reader() == 9)
    }),
    Test("independent invocations do not share dynamic bindings", () => {
        fn: (create) => {
            here: context
            create.ifTrue(() => {
                here.createSlot("dynamicOnly", 1)
            })
            here.hasSlot("dynamicOnly")
        }
        Assertions.require(fn(true) === true)
        Assertions.require(fn(false) === false)
        Assertions.require(fn(true) === true)
    }),
    Test("open closed and frozen rules apply to contexts without exception", () => {
        fn: () => {
            kept: 1
            here: context
            here.createSlot("open", 1)
            here.close()
            Assertions.signals(Error, () => { here.createSlot("closed", 1) })
            here.updateSlot("kept", 2)
            here.freeze()
            Assertions.signals(Error, () => { here.updateSlot("kept", 3) })
            Assertions.signals(Error, () => { here.createSlot("frozen", 1) })
            [kept, here.hasSlot("closed"), here.hasSlot("frozen"), open]
        }
        result: fn()
        Assertions.require(result[0] == 2)
        Assertions.require(result[1] === false)
        Assertions.require(result[2] === false)
        Assertions.require(result[3] == 1)
    }),
    Test("present null remains distinct from absence", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                here: context
                before: probe
                here.createSlot("probe", null)
                [before, probe, here.hasSlot("probe")]
            }
            inner()
        }
        result: outer()
        Assertions.require(result[0] == "outer")
        Assertions.require(result[1] === null)
        Assertions.require(result[2] === true)
    }),
    Test("one lookup site observes the full live binding sequence", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                here: context
                read: () => probe
                log: read()
                here.createSlot("probe", "nearer")
                log = log + "," + read()
                here.updateSlot("probe", "updated")
                log = log + "," + read()
                here.removeSlot("probe")
                log = log + "," + read()
                here.createSlot("probe", "recreated")
                log + "," + read()
            }
            inner()
        }
        Assertions.require(outer() == "outer,nearer,updated,outer,recreated")
    }),
    Test("a selected bare assignment destination is not re-resolved", () => {
        outer: () => {
            probe: "outer"
            inner: () => {
                here: context
                probe = (() => {
                    here.createSlot("probe", "nearer")
                    "assigned"
                })()
                probe
            }
            nearer: inner()
            [nearer, probe]
        }
        result: outer()
        Assertions.require(result[0] == "nearer")
        Assertions.require(result[1] == "assigned")
    }),
    Test("explicit reflective update targets its receiver after argument evaluation", () => {
        fn: () => {
            local: 1
            here: context
            result: here.updateSlot("local", (() => {
                local = 2
                3
            })())
            [result, local]
        }
        result: fn()
        Assertions.require(result[0] == 3)
        Assertions.require(result[1] == 3)
    }),
    Test("mutation through an alias equals mutation through context", () => {
        fn: () => {
            local: 1
            alias: context
            alias.updateSlot("local", 2)
            alias.createSlot("added", 3)
            [local, added, alias === context]
        }
        result: fn()
        Assertions.require(result[0] == 2)
        Assertions.require(result[1] == 3)
        Assertions.require(result[2] === true)
    }),
    Test("a captured binding updated reflectively is observed after resumption", () => {
        work: () => {
            stored: 1
            here: context
            reader: () => stored
            dependency: (() => {
                here.updateSlot("stored", 7)
                7
            }).future()
            waited: dependency.value()
            [waited, reader(), stored]
        }
        result: work.future().value()
        Assertions.require(result[0] == 7)
        Assertions.require(result[1] == 7)
        Assertions.require(result[2] == 7)
    })
]
tests.freeze()
