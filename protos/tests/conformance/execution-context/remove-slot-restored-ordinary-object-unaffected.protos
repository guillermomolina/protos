Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("D179 C0: removing a current local reveals the outer lexical binding", () => {
        tool009LegacyCase: () => {
            outer: () => {
                x: "outer"

                inner: () => {
                    x: "inner"
                    removed: context.removeSlot("x")

                    (removed == "inner") &&
                        (context.hasSlot("x") === false) &&
                        (x == "outer")
                }

                inner()
            }

            outer()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C0: removing a current local may reveal receiver fallback", () => {
        tool009LegacyCase: () => {
            receiver: {
                x: "receiver"

                readAfterRemoval: () => {
                    x: "local"
                    removed: context.removeSlot("x")

                    (removed == "local") && (x == "receiver")
                }
            }

            receiver.readAfterRemoval()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C0: a removed static local can be recreated in the same open context", () => {
        tool009LegacyCase: () => {
            fn: () => {
                x: 41
                here: context
                removed: here.removeSlot("x")
                absentAfterRemoval: here.hasSlot("x") === false

                here.x: 42

                (removed == 41) &&
                    absentAfterRemoval &&
                    here.hasSlot("x") &&
                    (x == 42)
            }

            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C0: ordinary Object.removeSlot retains the same behavior", () => {
        tool009LegacyCase: () => {
            ordinary: { value: 41 }
            removed: ordinary.removeSlot("value")

            (removed == 41) && (ordinary.hasSlot("value") === false)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
