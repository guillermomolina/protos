Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("D179 C3: an escaped execution context retains ordinary reflection", () => {
        tool009LegacyCase: () => {
            makeEscaped: () => {
                secret: 7
                context
            }
            escaped: makeEscaped()

            escaped.hasSlot("secret") && (escaped.slotValue("secret") == 7)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C3: close() on an execution context preserves its existing contract and rejects removal", () => {
        tool009LegacyCase: () => {
            fn: () => {
                a: 1
                here: context
                creationFailed: false
                removalFailed: false

                here.close()

                Error.handle(() => {
                    here.b: 2
                    null
                }, (error) => {
                    creationFailed = true
                    null
                })

                a = 5

                Error.handle(() => {
                    here.removeSlot("a")
                    null
                }, (error) => {
                    removalFailed = true
                    null
                })

                creationFailed && (a == 5) && removalFailed && here.hasSlot("a")
            }
            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C3: freeze() on an execution context preserves its existing contract and rejects removal", () => {
        tool009LegacyCase: () => {
            fn: () => {
                a: 1
                here: context
                creationFailed: false
                assignFailed: false
                removalFailed: false

                here.freeze()

                Error.handle(() => {
                    here.b: 2
                    null
                }, (error) => {
                    creationFailed = true
                    null
                })

                Error.handle(() => {
                    a = 5
                    null
                }, (error) => {
                    assignFailed = true
                    null
                })

                Error.handle(() => {
                    here.removeSlot("a")
                    null
                }, (error) => {
                    removalFailed = true
                    null
                })

                creationFailed && assignFailed && removalFailed && (a == 1) && here.hasSlot("a")
            }
            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C3: a present null local slot on an execution context remains present and its removal is rejected", () => {
        tool009LegacyCase: () => {
            fn: () => {
                here: context
                x: null
                hasX: here.hasSlot("x")
                valueX: here.slotValue("x")
                removalFailed: false

                Error.handle(() => {
                    here.removeSlot("x")
                    null
                }, (error) => {
                    removalFailed = true
                    null
                })

                hasX && (valueX === null) && removalFailed && here.hasSlot("x")
            }
            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
