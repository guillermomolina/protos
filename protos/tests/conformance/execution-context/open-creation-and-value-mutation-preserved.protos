Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("D179 C0: an open execution context allows absent-to-present local creation", () => {
        tool009LegacyCase: () => {
            fn: () => {
                here: context
                beforeHasX: here.hasSlot("x")
                x: 99
                afterHasX: here.hasSlot("x")

                (beforeHasX === false) && (afterHasX === true) && (x == 99)
            }
            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    }),

    Test("D179 C0: an execution context allows present-to-present value mutation while writable", () => {
        tool009LegacyCase: () => {
            fn: () => {
                v: 1
                v = 2
                v = 3
                v == 3
            }
            fn()
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
