Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("handle body invokable not closure", () => {
        Assertions.signals(Error, () => {
            ordinary: {
                call: () => 1
            }
            Error.handle(ordinary, (caught) => null)
        })
    }),
    Test("handle error ancestor match", () => {
        tool009LegacyCase: () => {
            Error.handle(() => InvalidReturn().signal(), (caught) => 42)
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("handle exact error identity", () => {
        tool009LegacyCase: () => {
            error: Error()
            Error.handle(() => error.signal(), (caught) => caught === error)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("handle exact instance match", () => {
        tool009LegacyCase: () => {
            error: Error()
            error.handle(() => error.signal(), (caught) => caught === error)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("handle exact prototype match", () => {
        tool009LegacyCase: () => {
            InvalidReturn.handle(() => InvalidReturn().signal(), (caught) => 43)
        }
        Assertions.require(tool009LegacyCase() == 43)
    }),
    Test("handle handler invokable not closure", () => {
        Assertions.signals(Error, () => {
            ordinary: {
                call: (error) => 1
            }
            Error.handle(() => 1, ordinary)
        })
    }),
    Test("handle innermost matching", () => {
        tool009LegacyCase: () => {
            Error.handle(() => {
                Error.handle(() => Error().signal(), (caught) => 45)
            }, (caught) => 99)
        }
        Assertions.require(tool009LegacyCase() == 45)
    }),
    Test("handle invalid body", () => {
        Assertions.signals(Error, () => {
            Error.handle(0, (caught) => null)
        })
    }),
    Test("handle invalid handler before body", () => {
        tool009LegacyCase: () => {
            ran: false
            Error.handle(() => {
                Error.handle(() => {
                    ran = true
                    null
                }, 0)
            }, (caught) => ran)
        }
        Assertions.require(tool009LegacyCase() === false)
    }),
    Test("handle nonmatching propagates", () => {
        tool009LegacyCase: () => {
            Error.handle(() => {
                InvalidReturn.handle(() => Error().signal(), (ignored) => 1)
            }, (caught) => 44)
        }
        Assertions.require(tool009LegacyCase() == 44)
    }),
    Test("handle nonresumable body", () => {
        tool009LegacyCase: () => {
            continued: false
            Error.handle(() => {
                Error().signal()
                continued = true
                null
            }, (caught) => continued)
        }
        Assertions.require(tool009LegacyCase() === false)
    }),
    Test("handle normal result", () => {
        tool009LegacyCase: () => {
            Error.handle(() => 41, (error) => 99)
        }
        Assertions.require(tool009LegacyCase() == 41)
    }),
    Test("handle parent task does not flow into child future", () => {
        tool009LegacyCase: () => {
            sourceError: Error()
            outerHandlerRan: 0
            consumerHandlerRan: 0

            child: Error.handle(
                () => {
                    (() => {
                        sourceError.signal()
                    }).future()
                },
                (error) => {
                    outerHandlerRan = 1
                    null
                }
            )

            observer: (() => {
                Error.handle(
                    () => child.value(),
                    (error) => {
                        consumerHandlerRan = 1
                        null
                    }
                )

                outerHandlerRan * 10 + consumerHandlerRan
            }).future()

            observer.value()
        }
        Assertions.require(tool009LegacyCase() == 1)
    }),
    Test("handle runtime slot not found", () => {
        tool009LegacyCase: () => {
            Error.handle(() => i022bDefinitelyMissing, (caught) => 47)
        }
        Assertions.require(tool009LegacyCase() == 47)
    }),
    Test("handle selected inactive", () => {
        tool009LegacyCase: () => {
            Error.handle(() => {
                Error.handle(() => Error().signal(), (first) => {
                    Error().signal()
                })
            }, (second) => 46)
        }
        Assertions.require(tool009LegacyCase() == 46)
    }),
    Test("handle wrong arity", () => {
        Assertions.signals(Error, () => {
            Error.handle(() => 1)
        })
    })
]
tests.freeze()
