Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("closure identity registry lifecycle", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            agent: {
                value: 0
                read: () => { value }
            }
            worker: agent { value: 10 }

            first: worker.read
            alias: first
            second: worker.read
            third: null

            byName: Map()
            metadata: IdentityMap()
            byName["primary"] = first
            byName["secondary"] = second
            metadata[first] = 1
            metadata[alias] = 2
            metadata[second] = 3

            flags: 0
            (first === alias).ifTrue(() => { flags = flags + 1 })
            (first === second).ifFalse(() => { flags = flags + 1 })
            (metadata.size() == 2).ifTrue(() => { flags = flags + 1 })

            invokeNamed: (name) => {
                callable: byName[name]
                callable()
            }

            rounds: Array(
                () => {
                    worker.value = 20
                    invokeNamed("primary")
                },
                () => { invokeNamed("secondary") },
                () => {
                    third = worker.read
                    byName["primary"] = third
                    metadata[third] = 4
                    worker.value = 30
                    invokeNamed("primary")
                },
                () => { invokeNamed("secondary") }
            )
            roundResults: Arrays.map(rounds, (round) => { round() })
            roundTotal: Arrays.reduce(roundResults, (sum, value) => { sum + value }, 0)

            (third === first).ifFalse(() => { flags = flags + 1 })
            (third === second).ifFalse(() => { flags = flags + 1 })
            (metadata.size() == 3).ifTrue(() => { flags = flags + 1 })

            metadata.remove(second)
            byName.remove("secondary")
            metadata.containsKey(second).ifFalse(() => { flags = flags + 1 })
            metadata.containsKey(first).ifTrue(() => { flags = flags + 1 })
            metadata.containsKey(third).ifTrue(() => { flags = flags + 1 })
            byName.containsKey("secondary").ifFalse(() => { flags = flags + 1 })
            byName.containsKey("primary").ifTrue(() => { flags = flags + 1 })

            aliasRead: alias()
            primaryRead: invokeNamed("primary")
            metaSum: metadata[first] + metadata[third]

            // Ordinary aliasing preserves one extracted Closure identity, while an
            // independent extraction is a distinct Closure. Map routes logical names to
            // those callables; IdentityMap tracks exact extracted Closure identities across
            // replacement/removal while every retained Closure still observes worker state.
            result:
                (roundTotal * 1000000000000000) +
                (aliasRead * 1000000000000) +
                (primaryRead * 1000000000) +
                (metaSum * 1000000) +
                (metadata.size() * 10000) +
                (byName.size() * 100) +
                flags
            result
        }
        Assertions.require(tool009LegacyCase() == 100030030006020111)
    }),
    Test("custom equality dual map live state", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            entitySource: {
                id: 0
                state: 0

                equals: (other) => { id == other.id }
                hash: () => { id }

                bump: (delta) => {
                    state = state + delta
                    state
                }

                makeReader: () => {
                    () => { state }
                }
            }

            // Operator spellings are not bare slot-creation targets. Use the ordinary
            // structural alias protocol to expose the equality Closure under selector "==".
            entity: entitySource.alias("equals", "==")

            left: entity {
                id: 7
                state: 10
            }
            peer: entity {
                id: 7
                state: 20
            }
            other: entity {
                id: 8
                state: 30
            }

            logical: Map()
            exact: IdentityMap()
            logical[left] = left.makeReader()
            exact[left] = left.makeReader()
            logical[peer] = peer.makeReader()
            exact[peer] = peer.makeReader()
            logical[other] = other.makeReader()
            exact[other] = other.makeReader()

            flags: 0
            (logical.size() == 2).ifTrue(() => { flags = flags + 1 })
            (exact.size() == 3).ifTrue(() => { flags = flags + 1 })
            (left == peer).ifTrue(() => { flags = flags + 1 })
            (left === peer).ifFalse(() => { flags = flags + 1 })

            mutations: Array(
                () => { left.bump(1) },
                () => { peer.bump(2) },
                () => { other.bump(3) }
            )
            mutationResults: Arrays.map(mutations, (mutation) => { mutation() })
            mutationTotal: Arrays.reduce(mutationResults, (sum, value) => { sum + value }, 0)

            invokeFrom: (registry, key) => {
                reader: registry[key]
                reader()
            }

            initialLogicalSum:
                invokeFrom(logical, left) +
                invokeFrom(logical, peer) +
                invokeFrom(logical, other)
            initialExactSum:
                invokeFrom(exact, left) +
                invokeFrom(exact, peer) +
                invokeFrom(exact, other)

            // id is the complete equality/hash key and remains stable while stored; only
            // unrelated live receiver state changes below.
            logical[left] = left.makeReader()
            left.bump(4)
            peer.bump(5)
            midLogicalPeer: invokeFrom(logical, peer)
            midExactSum: invokeFrom(exact, left) + invokeFrom(exact, peer)

            logical.remove(peer)
            logical.containsKey(left).ifFalse(() => { flags = flags + 1 })
            logical.containsKey(peer).ifFalse(() => { flags = flags + 1 })
            exact.containsKey(left).ifTrue(() => { flags = flags + 1 })
            exact.containsKey(peer).ifTrue(() => { flags = flags + 1 })

            logical[peer] = peer.makeReader()
            peer.bump(1)
            (logical.size() == 2).ifTrue(() => { flags = flags + 1 })
            (exact.size() == 3).ifTrue(() => { flags = flags + 1 })
            logical.containsKey(left).ifTrue(() => { flags = flags + 1 })

            finalLogicalLeft: invokeFrom(logical, left)
            finalExactPeer: invokeFrom(exact, peer)

            // Map collapses the two id=7 entities by their stable custom equality/hash law;
            // IdentityMap never does. Replacing/removing the logical key changes only that
            // registry, while exact-object readers remain receiver-bound through every live
            // state transition.
            result:
                (mutationTotal * 1000000000000000000000000) +
                (initialLogicalSum * 1000000000000000000000) +
                (initialExactSum * 1000000000000000000) +
                (midLogicalPeer * 1000000000000000) +
                (midExactSum * 1000000000000) +
                (finalLogicalLeft * 1000000000) +
                (finalExactPeer * 1000000) +
                (logical.size() * 10000) +
                (exact.size() * 100) +
                flags
            result
        }
        Assertions.require(tool009LegacyCase() == 66077066015042028028020311)
    }),
    Test("dual index entity registry transitions", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            record: {
                key: ""
                value: 0
                transitions: 0

                step: (delta) => {
                    value = value + delta
                    transitions = transitions + 1
                    value
                }

                makeReader: () => {
                    () => { value }
                }
            }

            a: record {
                key: "shared"
                value: 10
                transitions: 0
            }
            b: record {
                key: "shared"
                value: 20
                transitions: 0
            }
            c: record {
                key: "other"
                value: 30
                transitions: 0
            }

            logical: Map()
            exact: IdentityMap()

            logical[a.key] = a
            exact[a] = a.makeReader()
            logical[b.key] = b
            exact[b] = b.makeReader()
            logical[c.key] = c
            exact[c] = c.makeReader()

            flags: 0
            (logical["shared"] === b).ifTrue(() => { flags = flags + 1 })
            (exact.size() == 3).ifTrue(() => { flags = flags + 1 })

            operations: Array(
                () => { a.step(5) },
                () => { b.step(7) },
                () => { c.step(-4) },
                () => {
                    logical["shared"] = a
                    a.step(2)
                },
                () => {
                    b.step(3)
                    exact.remove(c)
                    exact[c] = c.makeReader()
                    c.step(6)
                }
            )
            operationResults: Arrays.map(operations, (operation) => { operation() })
            operationTotal: Arrays.reduce(operationResults, (sum, value) => { sum + value }, 0)

            logical.remove("other")
            logical.containsKey("other").ifFalse(() => { flags = flags + 1 })
            logical["other"] = c

            (logical["shared"] === a).ifTrue(() => { flags = flags + 1 })
            (exact.containsKey(c)).ifTrue(() => { flags = flags + 1 })

            readExact: (entity) => {
                reader: exact[entity]
                reader()
            }
            readerTotal: readExact(a) + readExact(b) + readExact(c)

            logical["shared"] = b
            (logical["shared"] === b).ifTrue(() => { flags = flags + 1 })
            (logical["other"] === c).ifTrue(() => { flags = flags + 1 })
            (exact.size() == 3).ifTrue(() => { flags = flags + 1 })

            transitionTotal: a.transitions + b.transitions + c.transitions

            // Map is the logical-key index, so the second "shared" registration replaces
            // the first and later transitions can redirect it. IdentityMap retains all three
            // exact entities, including the remove/reinsert lifecycle of c, and its stored
            // receiver-bound readers continue to observe later receiver mutation.
            result:
                (operationTotal * 1000000000000000) +
                (readerTotal * 1000000000000) +
                (logical["shared"].value * 1000000000) +
                (logical["other"].value * 1000000) +
                (transitionTotal * 1000) +
                (logical.size() * 100) +
                (exact.size() * 10) +
                flags
            result
        }
        Assertions.require(tool009LegacyCase() == 117079030032006238)
    }),
    Test("identity map receiver registry", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            sensor: {
                value: 0
                makeReader: () => { () => { value } }
            }

            a: sensor { value: 1 }
            b: sensor { value: 2 }
            c: sensor { value: 3 }

            registry: IdentityMap()
            registry[a] = a.makeReader()
            registry[b] = b.makeReader()
            registry[c] = c.makeReader()

            a.value = 7
            b.value = 8
            c.value = 10

            readers: Array(registry[a], registry[b], registry[c])
            values: Arrays.map(readers, (reader) => { reader() })
            sum: Arrays.reduce(values, (total, value) => { total + value }, 0)

            (registry.size() * 100) + sum
        }
        Assertions.require(tool009LegacyCase() == 325)
    }),
    Test("numeric equality identity registry transitions", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            logical: Map()
            exact: IdentityMap()
            flags: 0

            actions: Array(
                () => {
                    logical[1] = 10
                    exact[1] = 100
                    1
                },
                () => {
                    logical[1.0] = 20
                    exact[1.0] = 200
                    2
                },
                () => {
                    (logical.size() == 1).ifTrue(() => { flags = flags + 1 })
                    (exact.size() == 2).ifTrue(() => { flags = flags + 1 })
                    (logical[1] == 20).ifTrue(() => { flags = flags + 1 })
                    (logical[1.0] == 20).ifTrue(() => { flags = flags + 1 })
                    (exact[1] == 100).ifTrue(() => { flags = flags + 1 })
                    (exact[1.0] == 200).ifTrue(() => { flags = flags + 1 })
                    logical.remove(1)
                    exact.remove(1)
                    3
                },
                () => {
                    logical.containsKey(1.0).ifFalse(() => { flags = flags + 1 })
                    exact.containsKey(1).ifFalse(() => { flags = flags + 1 })
                    exact.containsKey(1.0).ifTrue(() => { flags = flags + 1 })
                    logical[1.0] = 30
                    exact[1] = 300
                    4
                },
                () => {
                    logical[1] = 40
                    exact[1.0] = 250
                    5
                }
            )

            actionResults: Arrays.map(actions, (action) => { action() })
            actionTotal: Arrays.reduce(actionResults, (sum, value) => { sum + value }, 0)

            (1 == 1.0).ifTrue(() => { flags = flags + 1 })
            (1 === 1.0).ifFalse(() => { flags = flags + 1 })
            (logical.size() == 1).ifTrue(() => { flags = flags + 1 })
            (exact.size() == 2).ifTrue(() => { flags = flags + 1 })
            (logical[1] == 40).ifTrue(() => { flags = flags + 1 })
            (logical[1.0] == 40).ifTrue(() => { flags = flags + 1 })
            (exact[1] == 300).ifTrue(() => { flags = flags + 1 })
            (exact[1.0] == 250).ifTrue(() => { flags = flags + 1 })

            // Numeric Map keys follow cross-family numeric equality/hash coherence, while
            // IdentityMap keeps ordinary Integer 1 and Float 1.0 distinct because numeric
            // semantic identity includes the family. Remove/reinsert/replace transitions must
            // preserve those two different laws throughout the workflow.
            result:
                (actionTotal * 1000000000000000000) +
                (logical[1] * 1000000000000000) +
                (logical[1.0] * 1000000000000) +
                (exact[1] * 1000000000) +
                (exact[1.0] * 1000000) +
                (logical.size() * 10000) +
                (exact.size() * 100) +
                flags
            result
        }
        Assertions.require(tool009LegacyCase() == 15040040300250010217)
    })
]
tests.freeze()
