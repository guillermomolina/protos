root: {
    shared: 1
    read: () => {
        value + branch + shared
    }
}
level1: root {
    branch: 2
}
level2: level1 {
    read: () => {
        super.read() * 2
    }

    makeSuperReader: () => {
        () => { super.read() }
    }
}
level3: level2 {}
level4: level3 {}
leaf: level4 {
    value: 10
}

// Both values retain the original receiver and the level2 methodHome. The
// nested Closure also retains the super lookup origin after makeSuperReader has
// already returned.
extracted: leaf.read
nested: leaf.makeSuperReader()

firstExtracted: extracted()
firstNested: nested()

leaf.value = 20
secondExtracted: extracted()
secondNested: nested()

level1.branch = 4
thirdExtracted: extracted()
thirdNested: nested()

root.shared = 3
fourthExtracted: extracted()
fourthNested: nested()

result:
    (firstExtracted * 100000000000000) +
    (firstNested * 1000000000000) +
    (secondExtracted * 10000000000) +
    (secondNested * 100000000) +
    (thirdExtracted * 1000000) +
    (thirdNested * 10000) +
    (fourthExtracted * 100) +
    fourthNested
result
