Arrays: import("std:collections/Array")

record: {
    key: ""
    value: 0
    transitions: 0

    step: (delta) => {
        value = value + delta
        transitions = transitions + 1
        value
    }

    makeReader: () => {
        () => { value }
    }
}

a: record {
    key: "shared"
    value: 10
    transitions: 0
}
b: record {
    key: "shared"
    value: 20
    transitions: 0
}
c: record {
    key: "other"
    value: 30
    transitions: 0
}

logical: Map()
exact: IdentityMap()

logical.atPut(a.key, a)
exact.atPut(a, a.makeReader())
logical.atPut(b.key, b)
exact.atPut(b, b.makeReader())
logical.atPut(c.key, c)
exact.atPut(c, c.makeReader())

flags: 0
(logical.at("shared") === b).ifTrue(() => { flags = flags + 1 })
(exact.size() == 3).ifTrue(() => { flags = flags + 1 })

operations: Array(
    () => { a.step(5) },
    () => { b.step(7) },
    () => { c.step(-4) },
    () => {
        logical.atPut("shared", a)
        a.step(2)
    },
    () => {
        b.step(3)
        exact.remove(c)
        exact.atPut(c, c.makeReader())
        c.step(6)
    }
)
operationResults: Arrays.map(operations, (operation) => { operation() })
operationTotal: Arrays.reduce(operationResults, (sum, value) => { sum + value }, 0)

logical.remove("other")
logical.containsKey("other").ifFalse(() => { flags = flags + 1 })
logical.atPut("other", c)

(logical.at("shared") === a).ifTrue(() => { flags = flags + 1 })
(exact.containsKey(c)).ifTrue(() => { flags = flags + 1 })

readExact: (entity) => {
    reader: exact.at(entity)
    reader()
}
readerTotal: readExact(a) + readExact(b) + readExact(c)

logical.atPut("shared", b)
(logical.at("shared") === b).ifTrue(() => { flags = flags + 1 })
(logical.at("other") === c).ifTrue(() => { flags = flags + 1 })
(exact.size() == 3).ifTrue(() => { flags = flags + 1 })

transitionTotal: a.transitions + b.transitions + c.transitions

// Map is the logical-key index, so the second "shared" registration replaces
// the first and later transitions can redirect it. IdentityMap retains all three
// exact entities, including the remove/reinsert lifecycle of c, and its stored
// receiver-bound readers continue to observe later receiver mutation.
result:
    (operationTotal * 1000000000000000) +
    (readerTotal * 1000000000000) +
    (logical.at("shared").value * 1000000000) +
    (logical.at("other").value * 1000000) +
    (transitionTotal * 1000) +
    (logical.size() * 100) +
    (exact.size() * 10) +
    flags
result
