Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("sibling extractions repeated rounds", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            prototype: {
                offset: 1
                read: () => { value + offset }
                makeReader: () => { () => { read() } }
            }
            branch: prototype {
                offset: 10
            }
            left: branch {
                value: 2
            }
            right: branch {
                value: 5
            }

            leftA: left.read
            leftB: left.read
            rightA: right.read
            leftNested: left.makeReader()
            rightNested: right.makeReader()

            round1Callables: Array(leftA, leftB, rightA, leftNested, rightNested)
            round1Values: Arrays.map(round1Callables, (callable) => { callable() })
            round1: Arrays.reduce(round1Values, (sum, value) => { sum + value }, 0)

            left.value = 20
            right.value = 30
            branch.offset = 7

            round2Values: Arrays.map(round1Callables, (callable) => { callable() })
            round2: Arrays.reduce(round2Values, (sum, value) => { sum + value }, 0)

            // Re-reading a Closure-valued member is a new extraction. It therefore binds
            // the stored Closure to holder, while leftA and leftNested remain bound to left.
            holder: left {
                saved: leftA
            }
            again: holder.saved
            holder.value: 40
            round3: again() + leftA() + leftNested()

            result: (round1 * 1000000) + (round2 * 1000) + round3
            result
        }
        Assertions.require(tool009LegacyCase() == 66155101)
    })
]
tests.freeze()
