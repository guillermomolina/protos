Arrays: import("std:collections/Array")

validator: {
    limit: 0
    bonus: 0

    checked: (value) => {
        (value > limit).ifTrue(() => {
            Error().signal()
        })
        value + bonus
    }

    makeTask: (value) => {
        () => { checked(value) }
    }
}

lenient: validator {
    limit: 10
    bonus: 100
}
strict: validator {
    limit: 3
    bonus: 200
}

tasks: Array(
    lenient.makeTask(8),
    strict.makeTask(8),
    strict.makeTask(2)
)

fallbacks: 0
safeRun: (task) => {
    Error.handle(
        () => { task() },
        (caught) => {
            fallbacks = fallbacks + 1
            7
        }
    )
}

results: Arrays.map(tasks, safeRun)
total: Arrays.reduce(results, (sum, value) => { sum + value }, 0)
summary: Map()
summary.atPut("total", total)
summary.atPut("fallbacks", fallbacks)

(summary.at("total") * 10) + summary.at("fallbacks")
