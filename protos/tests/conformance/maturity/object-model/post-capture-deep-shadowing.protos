prototype: {
    rate: 2
    makeReader: () => {
        () => { (rate * 10) + bias + value }
    }
}
branch: prototype {
    bias: 3
}
mid: branch {}
leaf: mid {
    value: 1
}

reader: leaf.makeReader()
before: reader()

// Local creation after capture shadows inherited state without changing the
// receiver retained by the nested Closure.
leaf.rate: 5
afterRateShadow: reader()

branch.bias = 7
afterAncestorMutation: reader()

leaf.bias: 9
afterBiasShadow: reader()

leaf.value = 4
afterLocalMutation: reader()

// The leaf-local rate now shields this later ancestor mutation.
prototype.rate = 8
afterShadowedAncestorMutation: reader()

result:
    (before * 10000000000) +
    (afterRateShadow * 100000000) +
    (afterAncestorMutation * 1000000) +
    (afterBiasShadow * 10000) +
    (afterLocalMutation * 100) +
    afterShadowedAncestorMutation
result
