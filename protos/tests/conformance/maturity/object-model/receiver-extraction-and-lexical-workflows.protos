Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("collection unwind preserves receiver state", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            service: {
                run: (value) => {
                    visits = visits + 1
                    (value > limit).ifTrue(() => {
                        problem.signal()
                    })
                    completed = completed + 1
                    value * factor
                }
            }

            worker: service {
                limit: 6
                factor: 10
                visits: 0
                completed: 0
                recoveries: 0
                problem: Error()
            }

            handlerCalls: 0
            identityHits: 0
            postCollection: 0

            handledResult: Error.handle(
                () => {
                    Arrays.reduce(Array(2, 5, 9, 1), (total, value) => {
                        total + worker.run(value)
                    }, 0)
                    postCollection = postCollection + 1
                    99
                },
                (caught) => {
                    handlerCalls = handlerCalls + 1
                    (caught === worker.problem).ifTrue(() => {
                        identityHits = identityHits + 1
                    })
                    worker.recoveries = worker.recoveries + 1
                    77
                }
            )

            // The third callback signals. Its pre-signal receiver mutation remains visible,
            // its post-signal continuation and the fourth callback are abandoned, and the
            // selected handler result becomes the result of the protected operation.
            result:
                (handledResult * 1000000) +
                (worker.visits * 100000) +
                (worker.completed * 10000) +
                (worker.recoveries * 1000) +
                (handlerCalls * 100) +
                (identityHits * 10) +
                postCollection
            result
        }
        Assertions.require(tool009LegacyCase() == 77321110)
    }),
    Test("deep extracted super chain mutation", () => {
        tool009LegacyCase: () => {
            root: {
                shared: 1
                read: () => {
                    value + branch + shared
                }
            }
            level1: root {
                branch: 2
            }
            level2: level1 {
                read: () => {
                    super.read() * 2
                }

                makeSuperReader: () => {
                    () => { super.read() }
                }
            }
            level3: level2 {}
            level4: level3 {}
            leaf: level4 {
                value: 10
            }

            // Both values retain the original receiver and the level2 methodHome. The
            // nested Closure also retains the super lookup origin after makeSuperReader has
            // already returned.
            extracted: leaf.read
            nested: leaf.makeSuperReader()

            firstExtracted: extracted()
            firstNested: nested()

            leaf.value = 20
            secondExtracted: extracted()
            secondNested: nested()

            level1.branch = 4
            thirdExtracted: extracted()
            thirdNested: nested()

            root.shared = 3
            fourthExtracted: extracted()
            fourthNested: nested()

            result:
                (firstExtracted * 100000000000000) +
                (firstNested * 1000000000000) +
                (secondExtracted * 10000000000) +
                (secondNested * 100000000) +
                (thirdExtracted * 1000000) +
                (thirdNested * 10000) +
                (fourthExtracted * 100) +
                fourthNested
            result
        }
        Assertions.require(tool009LegacyCase() == 2613462350255427)
    }),
    Test("delegated closure collection workflow", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            worker: {
                factor: 1
                bias: 0

                evaluate: (input) => {
                    (input * factor) + bias
                }

                makeJob: (input) => {
                    () => { evaluate(input) }
                }
            }

            double: worker {
                factor: 2
                bias: 1
            }
            triple: worker {
                factor: 3
                bias: 2
            }
            quad: worker {
                factor: 4
                bias: 3
            }

            jobs: Array(
                double.makeJob(10),
                triple.makeJob(10),
                quad.makeJob(10)
            )

            // The closure must keep the original receiver but observe its later local state.
            triple.factor = 5

            outputs: Arrays.map(jobs, (job) => { job() })
            byName: Map()
            byName["double"] = outputs[0]
            byName["triple"] = outputs[1]
            byName["quad"] = outputs[2]

            total: Arrays.reduce(outputs, (sum, value) => { sum + value }, 0)
            (total * 1000) +
                (byName["double"] * 100) +
                (byName["triple"] * 10) +
                byName["quad"]
        }
        Assertions.require(tool009LegacyCase() == 118663)
    }),
    Test("extracted methods through collection", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            base: {
                value: 0
                read: () => { value }
                makeReader: () => { () => { value } }
            }
            mid: base {}
            left: mid { value: 11 }
            right: mid { value: 13 }

            leftMethod: left.read
            rightMethod: right.read
            leftReader: left.makeReader()
            rightReader: right.makeReader()

            // Both extracted methods and nested closures must retain their receivers while
            // observing later mutations of local receiver slots.
            left.value = 17
            right.value = 19

            callables: Array(leftMethod, rightMethod, leftReader, rightReader)
            values: Arrays.map(callables, (callable) => { callable() })
            Arrays.reduce(values, (sum, value) => { sum + value }, 0)
        }
        Assertions.require(tool009LegacyCase() == 72)
    }),
    Test("method slot replacement after extraction", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            prototype: {
                read: () => { value + 1 }
            }
            level1: prototype {}
            level2: level1 {}
            level3: level2 {}
            leaf: level3 {
                value: 5
            }

            old: leaf.read
            oldBefore: old()

            // Replacing the prototype's local method slot affects future lookup, not the
            // already-extracted Closure value.
            prototype.read = () => { value + 100 }
            fresh: leaf.read
            freshBefore: fresh()

            leaf.value = 10
            oldAfter: old()
            freshAfter: fresh()
            again: leaf.read

            currentValues: Arrays.map(Array(old, fresh, again), (callable) => { callable() })
            currentSum: Arrays.reduce(currentValues, (sum, value) => { sum + value }, 0)

            result:
                (oldBefore * 1000000000000) +
                (freshBefore * 1000000000) +
                (oldAfter * 1000000) +
                (freshAfter * 1000) +
                currentSum
            result
        }
        Assertions.require(tool009LegacyCase() == 6105011110231)
    }),
    Test("post capture deep shadowing", () => {
        tool009LegacyCase: () => {
            prototype: {
                rate: 2
                makeReader: () => {
                    () => { (rate * 10) + bias + value }
                }
            }
            branch: prototype {
                bias: 3
            }
            mid: branch {}
            leaf: mid {
                value: 1
            }

            reader: leaf.makeReader()
            before: reader()

            // Local creation after capture shadows inherited state without changing the
            // receiver retained by the nested Closure.
            leaf.rate: 5
            afterRateShadow: reader()

            branch.bias = 7
            afterAncestorMutation: reader()

            leaf.bias: 9
            afterBiasShadow: reader()

            leaf.value = 4
            afterLocalMutation: reader()

            // The leaf-local rate now shields this later ancestor mutation.
            prototype.rate = 8
            afterShadowedAncestorMutation: reader()

            result:
                (before * 10000000000) +
                (afterRateShadow * 100000000) +
                (afterAncestorMutation * 1000000) +
                (afterBiasShadow * 10000) +
                (afterLocalMutation * 100) +
                afterShadowedAncestorMutation
            result
        }
        Assertions.require(tool009LegacyCase() == 245458606363)
    }),
    Test("sibling extractions repeated rounds", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            prototype: {
                offset: 1
                read: () => { value + offset }
                makeReader: () => { () => { read() } }
            }
            branch: prototype {
                offset: 10
            }
            left: branch {
                value: 2
            }
            right: branch {
                value: 5
            }

            leftA: left.read
            leftB: left.read
            rightA: right.read
            leftNested: left.makeReader()
            rightNested: right.makeReader()

            round1Callables: Array(leftA, leftB, rightA, leftNested, rightNested)
            round1Values: Arrays.map(round1Callables, (callable) => { callable() })
            round1: Arrays.reduce(round1Values, (sum, value) => { sum + value }, 0)

            left.value = 20
            right.value = 30
            branch.offset = 7

            round2Values: Arrays.map(round1Callables, (callable) => { callable() })
            round2: Arrays.reduce(round2Values, (sum, value) => { sum + value }, 0)

            // Re-reading a Closure-valued member is a new extraction. It therefore binds
            // the stored Closure to holder, while leftA and leftNested remain bound to left.
            holder: left {
                saved: leftA
            }
            again: holder.saved
            holder.value: 40
            round3: again() + leftA() + leftNested()

            result: (round1 * 1000000) + (round2 * 1000) + round3
            result
        }
        Assertions.require(tool009LegacyCase() == 66155101)
    })
]
tests.freeze()
