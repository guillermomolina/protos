Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("collection unwind preserves receiver state", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            service: {
                run: (value) => {
                    visits = visits + 1
                    (value > limit).ifTrue(() => {
                        problem.signal()
                    })
                    completed = completed + 1
                    value * factor
                }
            }

            worker: service {
                limit: 6
                factor: 10
                visits: 0
                completed: 0
                recoveries: 0
                problem: Error()
            }

            handlerCalls: 0
            identityHits: 0
            postCollection: 0

            handledResult: Error.handle(
                () => {
                    Arrays.reduce(Array(2, 5, 9, 1), (total, value) => {
                        total + worker.run(value)
                    }, 0)
                    postCollection = postCollection + 1
                    99
                },
                (caught) => {
                    handlerCalls = handlerCalls + 1
                    (caught === worker.problem).ifTrue(() => {
                        identityHits = identityHits + 1
                    })
                    worker.recoveries = worker.recoveries + 1
                    77
                }
            )

            // The third callback signals. Its pre-signal receiver mutation remains visible,
            // its post-signal continuation and the fourth callback are abandoned, and the
            // selected handler result becomes the result of the protected operation.
            result:
                (handledResult * 1000000) +
                (worker.visits * 100000) +
                (worker.completed * 10000) +
                (worker.recoveries * 1000) +
                (handlerCalls * 100) +
                (identityHits * 10) +
                postCollection
            result
        }
        Assertions.require(tool009LegacyCase() == 77321110)
    })
]
tests.freeze()
