Arrays: import("std:collections/Array")

base: {
    value: 0
    read: () => { value }
    makeReader: () => { () => { value } }
}
mid: base {}
left: mid { value: 11 }
right: mid { value: 13 }

leftMethod: left.read
rightMethod: right.read
leftReader: left.makeReader()
rightReader: right.makeReader()

// Both extracted methods and nested closures must retain their receivers while
// observing later mutations of local receiver slots.
left.value = 17
right.value = 19

callables: Array(leftMethod, rightMethod, leftReader, rightReader)
values: Arrays.map(callables, (callable) => { callable() })
Arrays.reduce(values, (sum, value) => { sum + value }, 0)
