Arrays: import("std:collections/Array")

prototype: {
    read: () => { value + 1 }
}
level1: prototype {}
level2: level1 {}
level3: level2 {}
leaf: level3 {
    value: 5
}

old: leaf.read
oldBefore: old()

// Replacing the prototype's local method slot affects future lookup, not the
// already-extracted Closure value.
prototype.read = () => { value + 100 }
fresh: leaf.read
freshBefore: fresh()

leaf.value = 10
oldAfter: old()
freshAfter: fresh()
again: leaf.read

currentValues: Arrays.map(Array(old, fresh, again), (callable) => { callable() })
currentSum: Arrays.reduce(currentValues, (sum, value) => { sum + value }, 0)

result:
    (oldBefore * 1000000000000) +
    (freshBefore * 1000000000) +
    (oldAfter * 1000000) +
    (freshAfter * 1000) +
    currentSum
result
