Arrays: import("std:collections/Array")

worker: {
    factor: 1
    bias: 0

    evaluate: (input) => {
        (input * factor) + bias
    }

    makeJob: (input) => {
        () => { evaluate(input) }
    }
}

double: worker {
    factor: 2
    bias: 1
}
triple: worker {
    factor: 3
    bias: 2
}
quad: worker {
    factor: 4
    bias: 3
}

jobs: Array(
    double.makeJob(10),
    triple.makeJob(10),
    quad.makeJob(10)
)

// The closure must keep the original receiver but observe its later local state.
triple.factor = 5

outputs: Arrays.map(jobs, (job) => { job() })
byName: Map()
byName["double"] = outputs[0]
byName["triple"] = outputs[1]
byName["quad"] = outputs[2]

total: Arrays.reduce(outputs, (sum, value) => { sum + value }, 0)
(total * 1000) +
    (byName["double"] * 100) +
    (byName["triple"] * 10) +
    byName["quad"]
