Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("delegated error category selection in callbacks", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            ValidationError: Error {}
            FatalValidation: ValidationError {}

            engine: {
                classify: (value) => {
                    calls = calls + 1
                    (value == 2).ifTrue(() => {
                        minor.signal()
                    })
                    (value == 4).ifTrue(() => {
                        major.signal()
                    })
                    successes = successes + 1
                    value * 10
                }
            }

            worker: engine {
                calls: 0
                successes: 0
                recoveries: 0
                minor: ValidationError()
                major: FatalValidation()
            }

            minorHits: 0
            majorHits: 0
            identityHits: 0

            safe: (value) => {
                ValidationError.handle(
                    () => {
                        FatalValidation.handle(
                            () => {
                                worker.classify(value)
                            },
                            (caught) => {
                                majorHits = majorHits + 1
                                (caught === worker.major).ifTrue(() => {
                                    identityHits = identityHits + 1
                                })
                                worker.recoveries = worker.recoveries + 1
                                400 + value
                            }
                        )
                    },
                    (caught) => {
                        minorHits = minorHits + 1
                        (caught === worker.minor).ifTrue(() => {
                            identityHits = identityHits + 1
                        })
                        worker.recoveries = worker.recoveries + 1
                        200 + value
                    }
                )
            }

            sum: Arrays.reduce(Array(1, 2, 3, 4, 5), (total, value) => {
                total + safe(value)
            }, 0)

            // Minor ValidationError bypasses the nonmatching FatalValidation handler and is
            // caught by the outer category. FatalValidation matches both categories, so the
            // dynamically innermost matching handler wins. The results are 10,202,30,404,50.
            result:
                (sum * 1000000) +
                (worker.calls * 100000) +
                (worker.successes * 10000) +
                (worker.recoveries * 1000) +
                (identityHits * 100) +
                (minorHits * 10) +
                majorHits
            result
        }
        Assertions.require(tool009LegacyCase() == 696532211)
    }),
    Test("error handled delegated pipeline", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            validator: {
                limit: 0
                bonus: 0

                checked: (value) => {
                    (value > limit).ifTrue(() => {
                        Error().signal()
                    })
                    value + bonus
                }

                makeTask: (value) => {
                    () => { checked(value) }
                }
            }

            lenient: validator {
                limit: 10
                bonus: 100
            }
            strict: validator {
                limit: 3
                bonus: 200
            }

            tasks: Array(
                lenient.makeTask(8),
                strict.makeTask(8),
                strict.makeTask(2)
            )

            fallbacks: 0
            safeRun: (task) => {
                Error.handle(
                    () => { task() },
                    (caught) => {
                        fallbacks = fallbacks + 1
                        7
                    }
                )
            }

            results: Arrays.map(tasks, safeRun)
            total: Arrays.reduce(results, (sum, value) => { sum + value }, 0)
            summary: Map()
            summary["total"] = total
            summary["fallbacks"] = fallbacks

            (summary["total"] * 10) + summary["fallbacks"]
        }
        Assertions.require(tool009LegacyCase() == 3171)
    }),
    Test("handler resignal escapes selected handler", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            machine: {
                step: (value) => {
                    attempts = attempts + 1
                    (value == 2).ifTrue(() => {
                        problem.signal()
                    })
                    successes = successes + 1
                    value * 10
                }
            }

            worker: machine {
                attempts: 0
                successes: 0
                problem: Error()
            }

            replacement: Error()
            innerCalls: 0
            innerIdentity: 0
            outerCalls: 0
            outerIdentity: 0
            afterReplacementSignal: 0
            postMap: 0

            outerResult: Error.handle(
                () => {
                    Arrays.map(Array(1, 2, 3), (value) => {
                        Error.handle(
                            () => {
                                worker.step(value)
                            },
                            (caught) => {
                                innerCalls = innerCalls + 1
                                (caught === worker.problem).ifTrue(() => {
                                    innerIdentity = innerIdentity + 1
                                })
                                // The selected inner Error handler is already inactive here.
                                // This replacement Error must therefore select the still-active
                                // outer Error handler rather than recursively selecting itself.
                                replacement.signal()
                                afterReplacementSignal = afterReplacementSignal + 1
                                88
                            }
                        )
                    })
                    postMap = postMap + 1
                    99
                },
                (caught) => {
                    outerCalls = outerCalls + 1
                    (caught === replacement).ifTrue(() => {
                        outerIdentity = outerIdentity + 1
                    })
                    66
                }
            )

            result:
                (outerResult * 10000000) +
                (worker.attempts * 1000000) +
                (worker.successes * 100000) +
                (innerCalls * 10000) +
                (innerIdentity * 1000) +
                (outerCalls * 100) +
                (outerIdentity * 10) +
                (afterReplacementSignal * 2) +
                postMap
            result
        }
        Assertions.require(tool009LegacyCase() == 662111110)
    }),
    Test("per element handler lexical state", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            processor: {
                apply: (value) => {
                    attempts = attempts + 1
                    (value > limit).ifTrue(() => {
                        problem.signal()
                    })
                    successes = successes + 1
                    value + bonus
                }
            }

            worker: processor {
                limit: 3
                bonus: 10
                attempts: 0
                successes: 0
                failures: 0
                problem: Error()
            }

            fallbackSeed: 40
            handlerCalls: 0
            identityHits: 0

            results: Arrays.map(Array(1, 5, 2, 6), (value) => {
                Error.handle(
                    () => {
                        worker.apply(value)
                    },
                    (caught) => {
                        handlerCalls = handlerCalls + 1
                        (caught === worker.problem).ifTrue(() => {
                            identityHits = identityHits + 1
                        })
                        worker.failures = worker.failures + 1
                        fallbackSeed = fallbackSeed + 1
                        fallbackSeed + worker.failures
                    }
                )
            })

            sum: Arrays.reduce(results, (total, value) => { total + value }, 0)

            // Results are 11, 42, 12 and 44. Two independently installed handlers mutate
            // the same captured lexical state while the delegated receiver keeps its own
            // attempts/success/failure state.
            result:
                (sum * 1000000) +
                (worker.attempts * 100000) +
                (worker.successes * 10000) +
                (worker.failures * 1000) +
                (handlerCalls * 100) +
                (identityHits * 10) +
                (fallbackSeed - 40)
            result
        }
        Assertions.require(tool009LegacyCase() == 109422222)
    })
]
tests.freeze()
