Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("per element handler lexical state", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/Array")

            processor: {
                apply: (value) => {
                    attempts = attempts + 1
                    (value > limit).ifTrue(() => {
                        problem.signal()
                    })
                    successes = successes + 1
                    value + bonus
                }
            }

            worker: processor {
                limit: 3
                bonus: 10
                attempts: 0
                successes: 0
                failures: 0
                problem: Error()
            }

            fallbackSeed: 40
            handlerCalls: 0
            identityHits: 0

            results: Arrays.map(Array(1, 5, 2, 6), (value) => {
                Error.handle(
                    () => {
                        worker.apply(value)
                    },
                    (caught) => {
                        handlerCalls = handlerCalls + 1
                        (caught === worker.problem).ifTrue(() => {
                            identityHits = identityHits + 1
                        })
                        worker.failures = worker.failures + 1
                        fallbackSeed = fallbackSeed + 1
                        fallbackSeed + worker.failures
                    }
                )
            })

            sum: Arrays.reduce(results, (total, value) => { total + value }, 0)

            // Results are 11, 42, 12 and 44. Two independently installed handlers mutate
            // the same captured lexical state while the delegated receiver keeps its own
            // attempts/success/failure state.
            result:
                (sum * 1000000) +
                (worker.attempts * 100000) +
                (worker.successes * 10000) +
                (worker.failures * 1000) +
                (handlerCalls * 100) +
                (identityHits * 10) +
                (fallbackSeed - 40)
            result
        }
        Assertions.require(tool009LegacyCase() == 109422222)
    })
]
tests.freeze()
