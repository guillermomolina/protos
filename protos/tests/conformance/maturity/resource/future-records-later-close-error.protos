recordedFirst: null
recordedSecond: null
encodingHandlerRan: false
future: (() => {
    file: filesystem.open(Path.relative().child("case.bin")).value()
    reader: TextReader(file, Encoding.UTF8)
    (() => {
        reader.readText().value()
    }).ensure(() => {
        reader.close().value()
        file.close().value()
    })
}).future()
IOError.handle(
    () => {
        EncodingError.handle(
            () => {
                future.value()
                null
            },
            (error) => {
                encodingHandlerRan = true
                null
            }
        )
    },
    (error) => {
        recordedFirst = error
        null
    }
)
IOError.handle(
    () => {
        future.value()
        null
    },
    (error) => {
        recordedSecond = error
        null
    }
)
(encodingHandlerRan == false).and() {
    (recordedFirst !== null).and() {
        recordedFirst === recordedSecond
    }
}
