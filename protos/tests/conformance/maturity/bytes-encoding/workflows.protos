Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("build utf8 bytes by add", () => {
        tool009LegacyCase: () => {
            bytes: Encoding.UTF8.encode("")
            bytes.add(65)
            bytes.add(240)
            bytes.add(159)
            bytes.add(152)
            bytes.add(128)

            Encoding.UTF8.decode(bytes) == "A\u{1f600}"
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("mutate utf8 before decode", () => {
        tool009LegacyCase: () => {
            bytes: Encoding.UTF8.encode("cat")
            bytes[1] = 117

            Encoding.UTF8.decode(bytes) == "cut"
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("encoded results independent under mutation", () => {
        tool009LegacyCase: () => {
            first: Encoding.UTF8.encode("cat")
            second: Encoding.UTF8.encode("cat")
            first[1] = 117

            (first !== second) &&
                (Encoding.UTF8.decode(first) == "cut") &&
                (Encoding.UTF8.decode(second) == "cat") &&
                (second[1] == 97)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("build utf16be bytes by add", () => {
        tool009LegacyCase: () => {
            bytes: Encoding.UTF8.encode("")
            bytes.add(0)
            bytes.add(65)
            bytes.add(216)
            bytes.add(61)
            bytes.add(222)
            bytes.add(0)

            Encoding.UTF16BE.decode(bytes) == "A\u{1f600}"
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("malformed after bytes mutation", () => {
        Assertions.signals(Error, () => {
            bytes: Encoding.UTF8.encode("A\u{e9}")
            bytes[2] = 65

            Encoding.UTF8.decode(bytes)
        })
    })
]
tests.freeze()
