Files: import("std:io/Files")
ProcessStreams: import("std:io/ProcessStreams")

reader: ProcessStreams.stdinReader(process)
text: reader.readText().value()
reader.close().value()

path: Path.relative().child("pipeline.txt")
Files.writeAllText(filesystem, path, text, Encoding.UTF8).value()
stored: Files.readAllText(filesystem, path, Encoding.UTF8).value()

writer: ProcessStreams.stdoutWriter(process)
writer.writeText(stored).value()
writer.close().value()

(stored == "stream-data") &&
    (Encoding.UTF8.decode(stdoutCapture) == "stream-data")
