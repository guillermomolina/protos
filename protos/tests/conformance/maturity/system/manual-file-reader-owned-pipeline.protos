ProcessStreams: import("std:io/ProcessStreams")
Arrays: import("std:collections/Array")

file: filesystem.open(Path.relative().child("manual.txt")).value()

result: (() => {
    reader: TextReader(file, Encoding.UTF8)
    text: reader.readText().value()
    reader.close().value()

    parts: Array(text, process.args()[0])
    joined: Arrays.reduce(parts, (left, right) => left + ":" + right)

    writer: ProcessStreams.stdoutWriter(process)
    writer.writeText(joined).value()
    writer.close().value()
    joined
}).ensure(() => {
    file.close().value()
})

(result == "manual:alpha") &&
    (Encoding.UTF8.decode(stdoutCapture) == "manual:alpha")
