Files: import("std:io/Files")
ProcessStreams: import("std:io/ProcessStreams")
Arrays: import("std:collections/Array")

parts: Array(process.args().at(0), process.environment().get("MODE"))
report: Arrays.reduce(parts, (left, right) => left + ":" + right)
path: Path.relative().child("report.txt")

Files.writeAllText(filesystem, path, report, Encoding.UTF8).value()
loaded: Files.readAllText(filesystem, path, Encoding.UTF8).value()

writer: ProcessStreams.stdoutWriter(process)
writer.writeText(loaded).value()
writer.close().value()

(loaded == "alpha:beta") &&
    (Encoding.UTF8.decode(stdoutCapture) == "alpha:beta")
