Files: import("std:io/Files")
ProcessStreams: import("std:io/ProcessStreams")

source: Path.relative().child("raw.bin")
original: Files.readAllBytes(filesystem, source).value()
copy: Encoding.Latin1.encode(Encoding.Latin1.decode(original))
copy[1] = 90

target: Path.relative().child("copy.bin")
Files.writeAllBytes(filesystem, target, copy).value()
stored: Files.readAllBytes(filesystem, target).value()
text: Encoding.Latin1.decode(stored)

writer: ProcessStreams.stdoutWriter(process)
writer.writeText(text).value()
writer.close().value()

(text == "AZC") &&
    (Encoding.UTF8.decode(stdoutCapture) == "AZC")
