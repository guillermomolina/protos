Files: import("std:io/Files")
ProcessStreams: import("std:io/ProcessStreams")
Arrays: import("std:collections/Array")

names: Array("first.txt", "second.txt")
paths: Arrays.map(names, (name) => Path.relative().child(name))
reads: Arrays.map(paths, (path) => Files.readAllText(filesystem, path, Encoding.UTF8))
texts: Future.all(...reads).value()
joined: Arrays.reduce(texts, (left, right) => left + "+" + right)

writer: ProcessStreams.stderrWriter(process)
writer.writeText(joined).value()
writer.close().value()

(texts.size() == 2) &&
    (texts[0] == "left") &&
    (texts[1] == "right") &&
    (joined == "left+right") &&
    (Encoding.UTF8.decode(stderrCapture) == "left+right")
