    Test("readtext utf16le state", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                    closes: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }

                    close: () => {
                        state.closes = state.closes + 1
                        (() => { null }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(255), makeBytes(254, 65, 0, 61, 216), makeBytes(0, 222), null))
            reader: TextReader(fixture.source, Encoding.UTF16LE)

            reader.readText().then((first) => {
                reader.readText().then((second) => {
                    reader.readText().then((third) => {
                        (first == "A") &&
                            (second == "\u{1f600}") &&
                            (third === null)
                    })
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readtext utf8 progress and bom", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                    closes: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }

                    close: () => {
                        state.closes = state.closes + 1
                        (() => { null }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(239, 187), makeBytes(191, 65, 240, 159), makeBytes(152, 128), null))
            reader: TextReader(fixture.source, Encoding.UTF8)

            reader.readText().then((first) => {
                firstOk: (first == "A") && (fixture.state.reads == 2)
                reader.readText().then((second) => {
                    secondOk: (second == "\u{1f600}") && (fixture.state.reads == 3)
                    reader.readText().then((third) => {
                        firstOk &&
                            secondOk &&
                            (third === null) &&
                            (fixture.state.reads == 4)
                    })
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readtext wrong arity error", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
