Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("readtext deferred malformed error", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                    closes: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }

                    close: () => {
                        state.closes = state.closes + 1
                        (() => { null }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(65, 192, 175), makeBytes(66)))
            reader: TextReader(fixture.source, Encoding.UTF8)
            reader.readText().then((first) => {
                next: (() => { null }).future()
                (first == "A").ifTrue(() => { next = reader.readText() })
                next
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.signals(Error, () => {
            candidate.value()
        })
    }),
    Test("readtext incomplete eof error", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                    closes: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }

                    close: () => {
                        state.closes = state.closes + 1
                        (() => { null }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(240, 159), null))
            reader: TextReader(fixture.source, Encoding.UTF8)
            reader.readText()
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.signals(Error, () => {
            candidate.value()
        })
    }),
    Test("readtext latin1", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                    closes: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }

                    close: () => {
                        state.closes = state.closes + 1
                        (() => { null }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(0, 128, 255), null))
            reader: TextReader(fixture.source, Encoding.Latin1)
            reader.readText().then((first) => {
                reader.readText().then((second) => {
                    (first == "\u{0}\u{80}\u{ff}") && (second === null)
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
