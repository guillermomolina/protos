makeBytes: (...octets) => {
    result: Encoding.UTF8.encode("")
    octets.each((octet) => {
        result.add(octet)
    })
    result
}

makeSource: (steps) => {
    state: {
        index: 0
        reads: 0
        closes: 0
    }

    source: {
        read: (maximum) => {
            current: state.index
            state.index = current + 1
            state.reads = state.reads + 1

            value: null
            (current < steps.size()).ifTrue(() => {
                value = steps.at(current)
            })

            (() => { value }).future()
        }

        close: () => {
            state.closes = state.closes + 1
            (() => { null }).future()
        }
    }

    {
        source: source
        state: state
    }
}

fixture: makeSource(Array(makeBytes(240, 159), null))
reader: TextReader(fixture.source, Encoding.UTF8)
reader.readText()
