Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("readline and readtext share order", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(65, 10, 66), null))
            reader: TextReader(fixture.source, Encoding.UTF8)

            lineFuture: reader.readLine()
            textFuture: reader.readText()

            lineFuture.then((line) => {
                textFuture.then((text) => {
                    (line == "A") &&
                        (text == "B") &&
                        (fixture.state.reads == 1)
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readline cr completes before following lf", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(97, 13), makeBytes(10, 66, 10), null))
            reader: TextReader(fixture.source, Encoding.UTF8)

            reader.readLine().then((first) => {
                firstCompleteWithoutReadAhead: (first == "a") && (fixture.state.reads == 1)
                reader.readLine().then((second) => {
                    firstCompleteWithoutReadAhead && (second == "B")
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readline framing lf crlf cr eof", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(97, 10, 98, 13, 10, 99, 13, 100), null))
            reader: TextReader(fixture.source, Encoding.UTF8)

            reader.readLine().then((first) => {
                reader.readLine().then((second) => {
                    reader.readLine().then((third) => {
                        reader.readLine().then((fourth) => {
                            reader.readLine().then((eof) => {
                                (first == "a") &&
                                    (second == "b") &&
                                    (third == "c") &&
                                    (fourth == "d") &&
                                    (eof === null)
                            })
                        })
                    })
                })
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readline maxbytes utf16le excludes bom and crlf", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(255, 254, 65, 0, 13, 0, 10, 0), null))
            reader: TextReader(fixture.source, Encoding.UTF16LE)

            reader.readLine(2).then((line) => {
                line == "A"
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    }),
    Test("readline maxbytes utf8 excludes bom and terminator", () => {
        tool009LegacyFutureCase: () => {
            makeBytes: (...octets) => {
                result: Encoding.UTF8.encode("")
                octets.each((octet) => {
                    result.add(octet)
                })
                result
            }

            makeSource: (steps) => {
                state: {
                    index: 0
                    reads: 0
                }

                source: {
                    read: (maximum) => {
                        current: state.index
                        state.index = current + 1
                        state.reads = state.reads + 1

                        value: null
                        (current < steps.size()).ifTrue(() => {
                            value = steps[current]
                        })

                        (() => { value }).future()
                    }
                }

                {
                    source: source
                    state: state
                }
            }

            fixture: makeSource(Array(makeBytes(239, 187, 191, 195, 169, 10), null))
            reader: TextReader(fixture.source, Encoding.UTF8)

            reader.readLine(2).then((line) => {
                line == "\u{e9}"
            })
        }

        candidate: tool009LegacyFutureCase()
        Assertions.require(candidate.parent() === Future)
        Assertions.require(candidate.value() === true)
    })
]
tests.freeze()
