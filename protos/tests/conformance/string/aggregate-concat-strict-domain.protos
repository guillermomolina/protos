ok: true

("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
("é" !== "e\u{301}").ifFalse(() => { ok = false })
("é" == "e\u{301}").ifTrue(() => { ok = false })

ok

Assertions: import("std:test/Assertions")

Assertions.signals(Error, () => {
    "x".concat(1)
})

Assertions.signals(Error, () => {
    "x".concat(true)
})

Assertions.signals(Error, () => {
    "x".concat(false)
})

Assertions.signals(Error, () => {
    "x".concat(null)
})

Assertions.signals(Error, () => {
    "x".concat(Bytes())
})

Assertions.signals(Error, () => {
    value: {}
    "x".concat(value)
})

FakeString: String {}

Assertions.signals(Error, () => {
    FakeString.concat("x")
})

true
