ok: true

("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
("é" !== "e\u{301}").ifFalse(() => { ok = false })
("é" == "e\u{301}").ifTrue(() => { ok = false })

ok

Assertions: import("std:test/Assertions")

empty: Array()
parts: Array("b", "c", "d")

Assertions.require("a".concat() === "a")
Assertions.require("a".concat("b") === ("a" + "b"))
Assertions.require("a".concat("b", "c", "d") === "abcd")

Assertions.require("a".concat(...empty) === "a")
Assertions.require("a".concat(...parts) === "abcd")

Assertions.require("".concat("e\u{301}", "x") === "e\u{301}x")
Assertions.require("".concat("e\u{301}") !== "é")

true
