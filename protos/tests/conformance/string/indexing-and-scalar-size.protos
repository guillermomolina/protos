Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("scalar at exact", () => {
        tool009LegacyCase: () => {
            ok: true

            ("e\u{301}"[0] === "e").ifFalse(() => { ok = false })
            ("e\u{301}"[1] === "\u{301}").ifFalse(() => { ok = false })
            ("😀"[0] === "😀").ifFalse(() => { ok = false })
            ("👨‍👩‍👧‍👦"[1] === "\u{200D}").ifFalse(() => { ok = false })
            ("abc".at(1) === "b").ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("scalar size", () => {
        tool009LegacyCase: () => {
            ok: true

            ("".size() == 0).ifFalse(() => { ok = false })
            ("abc".size() == 3).ifFalse(() => { ok = false })
            ("e\u{301}".size() == 2).ifFalse(() => { ok = false })
            ("😀".size() == 1).ifFalse(() => { ok = false })
            ("👨‍👩‍👧‍👦".size() == 7).ifFalse(() => { ok = false })

            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("at float error", () => {
        Assertions.signals(Error, () => {
            "abc".at(1.0)
        })
    }),
    Test("at negative error", () => {
        Assertions.signals(Error, () => {
            "abc".at(-1)
        })
    }),
    Test("at out of range error", () => {
        Assertions.signals(Error, () => {
            "abc".at(3)
        })
    }),
    Test("at string error", () => {
        Assertions.signals(Error, () => {
            "abc".at("1")
        })
    }),
    Test("at wrong arity error", () => {
        Assertions.signals(Error, () => {
            "x".at()
        })
    }),
    Test("size wrong arity error", () => {
        Assertions.signals(Error, () => {
            "x".size(1)
        })
    })
]
tests.freeze()
