Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("aggregate concat basic", () => {
        tool009LegacyCase: () => {
            ok: true

            ("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
            ("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
            ("é" !== "e\u{301}").ifFalse(() => { ok = false })
            ("é" == "e\u{301}").ifTrue(() => { ok = false })

            ok

            Assertions: import("std:test/Assertions")

            empty: Array()
            parts: Array("b", "c", "d")

            Assertions.require("a".concat() === "a")
            Assertions.require("a".concat("b") === ("a" + "b"))
            Assertions.require("a".concat("b", "c", "d") === "abcd")

            Assertions.require("a".concat(...empty) === "a")
            Assertions.require("a".concat(...parts) === "abcd")

            Assertions.require("".concat("e\u{301}", "x") === "e\u{301}x")
            Assertions.require("".concat("e\u{301}") !== "é")

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("aggregate concat dispatch independence", () => {
        tool009LegacyCase: () => {
            ok: true

            ("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
            ("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
            ("é" !== "e\u{301}").ifFalse(() => { ok = false })
            ("é" == "e\u{301}").ifTrue(() => { ok = false })

            ok

            Assertions: import("std:test/Assertions")

            // A local concat is ordinary message dispatch and overrides the inherited one.
            CustomConcat: String {
                concat: (...items) => {
                    items.size()
                }
            }

            Assertions.require(CustomConcat.concat("a", "b", "c") == 3)

            // Defining + independently must not make standard concat dispatch through +.
            CustomPlusSource: String {
                combine: (other) => {
                    "custom-plus"
                }
            }

            CustomPlus: CustomPlusSource.alias("combine", "+")

            Assertions.require((CustomPlus + "x") === "custom-plus")

            Assertions.signals(Error, () => {
                CustomPlus.concat("x")
            })

            // Neither customization changes the canonical String operations.
            Assertions.require(("a" + "b") === "ab")
            Assertions.require("a".concat("b") === "ab")

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("aggregate concat evaluation order", () => {
        tool009LegacyCase: () => {
            ok: true

            ("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
            ("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
            ("é" !== "e\u{301}").ifFalse(() => { ok = false })
            ("é" == "e\u{301}").ifTrue(() => { ok = false })

            ok

            Assertions: import("std:test/Assertions")

            trace: {
                value: 0
            }

            later: () => {
                trace.value = trace.value + 1
                "later"
            }

            Assertions.signals(Error, () => {
                "x".concat(1, later())
            })

            Assertions.require(trace.value == 1)

            ArgumentFailure: Error {}
            argumentFailure: ArgumentFailure {}

            caughtArgumentFailure: Assertions.signals(ArgumentFailure, () => {
                "x".concat(1, argumentFailure.signal())
            })

            Assertions.require(caughtArgumentFailure === argumentFailure)

            SpreadFailure: Error {}
            spreadFailure: SpreadFailure {}

            caughtSpreadFailure: Assertions.signals(SpreadFailure, () => {
                "x".concat(...spreadFailure.signal())
            })

            Assertions.require(caughtSpreadFailure === spreadFailure)

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("aggregate concat no conversion callbacks", () => {
        tool009LegacyCase: () => {
            ok: true

            ("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
            ("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
            ("é" !== "e\u{301}").ifFalse(() => { ok = false })
            ("é" == "e\u{301}").ifTrue(() => { ok = false })

            ok

            Assertions: import("std:test/Assertions")

            trace: {
                value: 0
            }

            CandidateSource: {
                toString: () => {
                    trace.value = trace.value + 1
                    "converted"
                }

                printString: () => {
                    trace.value = trace.value + 10
                    "printed"
                }

                plus: (other) => {
                    trace.value = trace.value + 100
                    "combined"
                }
            }

            candidate: CandidateSource.alias("plus", "+")

            receiver: "prefix"
            result: "sentinel"

            Assertions.signals(Error, () => {
                result = receiver.concat("valid", candidate, "later")
            })

            Assertions.require(trace.value == 0)
            Assertions.require(result === "sentinel")
            Assertions.require(receiver === "prefix")

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("aggregate concat strict domain", () => {
        tool009LegacyCase: () => {
            ok: true

            ("hello" === ("hel" + "lo")).ifFalse(() => { ok = false })
            ("hello" == ("hel" + "lo")).ifFalse(() => { ok = false })
            ("é" !== "e\u{301}").ifFalse(() => { ok = false })
            ("é" == "e\u{301}").ifTrue(() => { ok = false })

            ok

            Assertions: import("std:test/Assertions")

            Assertions.signals(Error, () => {
                "x".concat(1)
            })

            Assertions.signals(Error, () => {
                "x".concat(true)
            })

            Assertions.signals(Error, () => {
                "x".concat(false)
            })

            Assertions.signals(Error, () => {
                "x".concat(null)
            })

            Assertions.signals(Error, () => {
                "x".concat(Bytes())
            })

            Assertions.signals(Error, () => {
                value: {}
                "x".concat(value)
            })

            FakeString: String {}

            Assertions.signals(Error, () => {
                FakeString.concat("x")
            })

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
