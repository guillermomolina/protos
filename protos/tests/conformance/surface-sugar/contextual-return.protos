// D234-B2-S1 / I138: `return expression` is the contextual spelling of
// `^expression`. It targets the same captured return home, so inside a
// callback it leaves the enclosing invocation, not merely the callback.
// `return` stays an ordinary identifier everywhere else.
//
// Every Closure literal captures the return home of the activation that
// creates it; only a module-level Closure invoked as a function owns a fresh
// home. The return homes under test are therefore the module-level helpers
// below, never the Test Tool's own test Closures: a return created inside a
// test Closure would leave that test body and skip its assertions. Each test
// ends with a `reached` assertion that runs only when control came back to
// the test body normally.

Assertions: import("std:test/assertions")
Test: import("std:test/test")

findCaret: (items, trace) => {
    items.each((item) => {
        trace.visited = trace.visited + 1
        (item > 2).ifTrue() {
            ^item
        }
    })
    null
}

findReturn: (items, trace) => {
    items.each((item) => {
        trace.visited = trace.visited + 1
        (item > 2).ifTrue() {
            return item
        }
    })
    null
}

deepReturn: (trace) => {
    (() => {
        (() => {
            return 5
        })()
        trace.afterInner = true
    })()
    trace.afterOuter = true
    0
}

sumReturn: (a, b) => {
    return a + b * 2
    0
}

groupedReturn: (x) => {
    return (x) * 2
    0
}

negatedReturn: (x) => {
    return -x
    0
}

spacedMinusReturn: (x) => {
    return - x
    0
}

invertedReturn: (x) => {
    return ~x
    0
}

arrayReturn: () => {
    return[7]
    0
}

objectReturn: () => {
    return { a: 1 }
    0
}

onceReturn: (counter) => {
    return counter.next()
    counter.next()
}

newlineAfterReturn: (counter) => {
    return: 0
    return
    counter.next()
    9
}

multilineGroupReturn: () => {
    return (
        1 +
        2
    )
    0
}

blockCommentReturn: () => {
    return /* early */ 7
    0
}

lineCommentReturn: () => {
    return: 1
    return // ordinary read
    8
}

makeEscaping: () => {
    () => {
        return 42
    }
}

ensureBodyReturn: (log) => {
    (() => {
        return 42
    }).ensure(() => {
        log.cleaned = log.cleaned + 7
    })
    0
}

ensureCleanupReturn: () => {
    (() => {
        ^42
    }).ensure(() => {
        return 43
    })
    0
}

defaultReturn: (x: return 42) => {
    0
}

counter: () => {
    {
        calls: 0
        next: () => {
            this.calls = this.calls + 1
            this.calls
        }
    }
}

tests: [
    Test("return from a nested callback leaves the home invocation", () => {
        caretTrace: { visited: 0 }
        returnTrace: { visited: 0 }
        Assertions.require(findCaret([1, 3, 5], caretTrace) == 3)
        Assertions.require(findReturn([1, 3, 5], returnTrace) == 3)
        Assertions.require(returnTrace.visited == 2)
        Assertions.require(caretTrace.visited == returnTrace.visited)
        Assertions.require(findReturn([1, 2], { visited: 0 }) === null)
        reached: true
        Assertions.require(reached)
    }),
    Test("return unwinds every nested Closure up to the home", () => {
        trace: { afterInner: false; afterOuter: false }
        Assertions.require(deepReturn(trace) == 5)
        Assertions.require(trace.afterInner == false)
        Assertions.require(trace.afterOuter == false)
        reached: true
        Assertions.require(reached)
    }),
    Test("return a + b returns the whole binary expression", () => {
        Assertions.require(sumReturn(1, 3) == 7)
        reached: true
        Assertions.require(reached)
    }),
    Test("approved operand shapes are contextual returns", () => {
        Assertions.require(groupedReturn(4) == 8)
        Assertions.require(negatedReturn(4) == -4)
        Assertions.require(spacedMinusReturn(4) == -4)
        Assertions.require(invertedReturn(0) == -1)
        Assertions.require(arrayReturn()[0] == 7)
        Assertions.require(objectReturn().a == 1)
        reached: true
        Assertions.require(reached)
    }),
    Test("the operand is evaluated exactly once", () => {
        c: counter()
        Assertions.require(onceReturn(c) == 1)
        Assertions.require(c.calls == 1)
        reached: true
        Assertions.require(reached)
    }),
    Test("a newline after bare return keeps two ordinary expressions", () => {
        c: counter()
        Assertions.require(newlineAfterReturn(c) == 9)
        Assertions.require(c.calls == 1)
        reached: true
        Assertions.require(reached)
    }),
    Test("a parenthesized operand may span lines", () => {
        Assertions.require(multilineGroupReturn() == 3)
        reached: true
        Assertions.require(reached)
    }),
    Test("comments around return", () => {
        Assertions.require(blockCommentReturn() == 7)
        Assertions.require(lineCommentReturn() == 8)
        reached: true
        Assertions.require(reached)
    }),
    Test("ordinary identifier forms keep their meaning", () => {
        return: (x: 0, y: 0) => x + y + 1
        Assertions.require((return)(2) == 3)
        Assertions.require(return(4, 1) == 6)
        Assertions.require(return() == 1)
        holder: { return: (x) => x * 10 }
        Assertions.require(holder.return(2) == 20)
        double: return => return * 2
        Assertions.require(double(6) == 12)
        reached: true
        Assertions.require(reached)
    }),
    Test("grouped return keeps ordinary operators and suffixes", () => {
        return: 6
        Assertions.require(((return) - 1) == 5)
        Assertions.require(((return) ~ 3) == 5)
        Assertions.require((return % 4) == 2)
        return = Array(4, 5)
        Assertions.require((return)[1] == 5)
        reached: true
        Assertions.require(reached)
    }),
    Test("bare return slot creation and assignment stay ordinary", () => {
        return: 1
        return = 2
        Assertions.require(return == 2)
        reached: true
        Assertions.require(reached)
    }),
    Test("complete targets rooted at return stay ordinary", () => {
        return: Array(0, { name: 1 }, Array(5))
        return[0] = 9
        return[1].name = 2
        return[1].label: 3
        return[2][0] = 6
        Assertions.require(return[0] == 9)
        Assertions.require(return[1].name == 2)
        Assertions.require(return[1].label == 3)
        Assertions.require(return[2][0] == 6)
        reached: true
        Assertions.require(reached)
    }),
    Test("escaped closure using return signals InvalidReturn", () => {
        closure: makeEscaping()
        Assertions.signals(InvalidReturn, () => { closure() })
        Assertions.signals(InvalidReturn, () => { closure() })
        reached: true
        Assertions.require(reached)
    }),
    Test("return toward a home of a different Task signals InvalidReturn", () => {
        // `escape` is created inside this test invocation, so it captures
        // this test's home, owned by the test Task. Executing it in another
        // Task must signal there and never return to the test Task.
        escape: () => {
            return 42
        }
        Assertions.signals(InvalidReturn, () => {
            (() => {
                escape()
                0
            }).future().value()
        })
        reached: true
        Assertions.require(reached)
    }),
    Test("ensure cleanup runs once after a body return", () => {
        log: { cleaned: 0 }
        Assertions.require(ensureBodyReturn(log) == 42)
        Assertions.require(log.cleaned == 7)
        reached: true
        Assertions.require(reached)
    }),
    Test("return in ensure cleanup supersedes a pending caret return", () => {
        Assertions.require(ensureCleanupReturn() == 43)
        reached: true
        Assertions.require(reached)
    }),
    Test("return inside a default uses the invocation return home", () => {
        Assertions.require(defaultReturn() == 42)
        reached: true
        Assertions.require(reached)
    })
]
tests.freeze()
