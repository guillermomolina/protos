// I143 / D237-MIX-C: contextual named argument conformance.
// All observable behavior lives inside named suite-native Test bodies.
// Positional ordinals remain stable; the actual selected implementation
// owns name association; standard Object.call forwards to its selected child
// (D239-C1: the selected construct, then standard Object.construct forwards
// to the selected init).

Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("names associate by selected formal rather than source order", () => {
        f: (a, b, c) => a * 100 + b * 10 + c
        Assertions.require(f(c: 3, a: 1, b: 2) == 123)
    }),
    Test("mixed positional, spread and named positions are stable", () => {
        f: (a, b, c) => a * 100 + b * 10 + c
        Assertions.require(f(c: 3, ...[1, 2]) == 123)
        Assertions.require(f(1, c: 3, 2) == 123)
    }),
    Test("explicit null suppresses a default and absent names run defaults", () => {
        f: (a: 10, b: 20, c: 30) => [a, b, c]
        actual: f(c: null)
        Assertions.require(actual[0] == 10)
        Assertions.require(actual[1] == 20)
        Assertions.require(actual[2] === null)
    }),
    Test("named binding leaves rest empty when no positional overflow", () => {
        f: (a, b, c, ...rest) => rest
        actual: f(1, c: 3)
        Assertions.require(actual.size() == 0)
    }),
    Test("supplied values precede defaults in declaration order", () => {
        trace: { value: 0 }
        mark: (n) => {
            trace.value = trace.value * 10 + n
            n
        }
        f: (a: mark(1), b: mark(2), c: mark(3)) => trace.value
        Assertions.require(f(c: mark(9)) == 912)
    }),
    Test("custom call binds its own formal rather than forwarding", () => {
        receiver: { call: (own) => own }
        Assertions.require(receiver(own: 7) == 7)
        Assertions.signals(Error, () => { receiver(other: 7) })
    }),
    Test("super named send uses inherited implementation and dynamic this", () => {
        base: {
            read: (unused) => this.value
        }
        middle: base {
            read: () => super.read(unused: 0)
        }
        leaf: middle { value: 17 }
        Assertions.require(leaf.read() == 17)
    }),
    Test("standard Object.call forwards named arguments to init", () => {
        prototype: { init: (value: 0) => value }
        instance: prototype(value: 7)
        Assertions.require(instance.parent() === prototype)
    }),
    Test("fresh errors distinguish missing selector from bad association", () => {
        f: (value) => value
        first: Assertions.signals(Error, () => { f(bad: 1) })
        second: Assertions.signals(Error, () => { f(bad: 2) })
        Assertions.require(first !== second)
        receiver: {}
        Assertions.signals(SlotNotFound, () => {
            receiver.missing(bad: 1)
        })
    }),
    Test("selected call is rebound during named argument evaluation", () => {
        receiver: { call: (old) => old }
        replace: () => {
            receiver.call = (selected) => selected
            17
        }
        Assertions.require(receiver(selected: replace()) == 17)
        Assertions.signals(Error, () => { receiver(old: 19) })
    }),
    Test("a spread positional collides with the same named formal", () => {
        f: (first, second) => second
        Assertions.signals(Error, () => { f(first: 9, ...[1]) })
        Assertions.signals(Error, () => { f(...[1, 2], second: 9) })
    }),
    Test("copied standard Object.call forwards labels to selected init", () => {
        prototype: {
            init: (value) => {
                this.stored: value
            }
        }
        prototype.call: Object.call
        instance: prototype(value: 13)
        Assertions.require(instance.parent() === prototype)
        Assertions.require(instance.stored == 13)
    }),
    Test("standard Object.call copied under another selector forwards", () => {
        prototype: {
            init: (value) => {
                this.result: value
            }
        }
        prototype.make: Object.call
        instance: prototype.make(value: 19)
        Assertions.require(instance.parent() === prototype)
        Assertions.require(instance.result == 19)
    }),
    Test("bracket syntax rejects names at standard Array and honors a shadow", () => {
        Assertions.signals(Error, () => { [item: 5] })
        Array: (item) => item
        Assertions.require([item: 8] == 8)
        Assertions.require(Array(item: 9) == 9)
    }),
    Test("grouped slot creation remains one positional argument", () => {
        f: (value) => value
        Assertions.require(f((created: 27)) == 27)
        Assertions.require(created == 27)
    }),
    Test("the rest formal name never accepts named association", () => {
        f: (value: 1, ...rest) => value
        Assertions.signals(Error, () => { f(rest: [2]) })
        Assertions.require(f(value: 7) == 7)
    }),
    Test("contextual if condition retains slot creation semantics", () => {
        trace: { count: 0 }
        if(flag: true) {
            trace.count = trace.count + 1
        }
        Assertions.require(flag === true)
        Assertions.require(trace.count == 1)
    }),
    Test("Object.call forwards names to a custom construct's own formals", () => {
        Factory: {
            construct: (left: 1, right: 2) => left * 10 + right
        }
        Assertions.require(Factory(right: 5) == 15)
        Assertions.require(Factory(right: 3, left: 4) == 43)
        Assertions.require(Factory(7, right: 8) == 78)
        Assertions.signals(Error, () => { Factory(wrong: 1) })
        Assertions.signals(Error, () => { Factory(9, left: 1) })
    }),
    Test("Object.call then Object.construct forward names to custom init", () => {
        Point: {
            init: (x: 0, y: 0, ...rest) => {
                this.x: x
                this.y: y
                this.rest: rest
            }
        }
        p: Point(y: 2, x: 1)
        Assertions.require(p.parent() === Point)
        Assertions.require(p.x == 1)
        Assertions.require(p.y == 2)
        q: Point(...[5, 6, 7])
        Assertions.require(q.x == 5)
        Assertions.require(q.rest.size() == 1)
        Assertions.signals(Error, () => { Point(z: 1) })
        Assertions.signals(Error, () => { Point(3, x: 4) })
        Assertions.signals(Error, () => { Point(rest: [1]) })
    }),
    Test("forwarded defaults run in declaration order after supplied values", () => {
        trace: { value: 0 }
        mark: (n) => {
            trace.value = trace.value * 10 + n
            n
        }
        Thing: {
            init: (a: mark(1), b: mark(2), c: mark(3)) => {
                this.order: trace.value
            }
        }
        Assertions.require(Thing(c: mark(9)).order == 912)
    }),
    Test("named arguments are evaluated once across both forwarding stages", () => {
        trace: { count: 0 }
        once: () => {
            trace.count = trace.count + 1
            trace.count
        }
        Thing: {
            init: (value) => {
                this.value: value
            }
        }
        made: Thing(value: once())
        Assertions.require(made.value == 1)
        Assertions.require(trace.count == 1)
    }),
    Test("copied and extracted standard construct forward labels to init", () => {
        Thing: {
            init: (value) => {
                this.value: value
            }
        }
        Thing.build: Object.construct
        Assertions.require(Thing.build(value: 3).value == 3)
        Assertions.require(Thing.construct(value: 4).value == 4)
        extracted: Thing.construct
        Assertions.require(extracted(value: 5).value == 5)
        Assertions.signals(Error, () => { Thing.build(other: 1) })
        aliased: Thing.alias("build", "produce")
        produced: aliased.produce(value: 6)
        Assertions.require(produced.value == 6)
        Assertions.require(produced.parent() === aliased)
    }),
    Test("named Closure invocation selects an overridden call slot", () => {
        target: (original) => original + 100
        target.call: (selected) => selected + 1

        Assertions.require(target(selected: 8) == 9)
        Assertions.signals(Error, () => { target(original: 8) })
    }),
    Test("copied standard call on a Closure forwards names to its body", () => {
        target: (value: 10) => value
        target.call: Object.call

        Assertions.require(target(value: 24) == 24)
        Assertions.require(target() == 10)
    }),
    Test("named send observes method replacement during argument evaluation", () => {
        receiver: {
            read: (previous) => previous
        }
        replace: () => {
            receiver.read = (selected) => selected + 1
            41
        }

        Assertions.require(receiver.read(selected: replace()) == 42)
        Assertions.signals(Error, () => {
            receiver.read(previous: 2)
        })
    }),
    Test("named standard native arguments reject after evaluating values", () => {
        trace: { count: 0 }
        once: () => {
            trace.count = trace.count + 1
            trace.count
        }

        Assertions.signals(Error, () => {
            Array(element: once())
        })
        Assertions.require(trace.count == 1)
    }),
    Test("named init suspension preserves the instance and executes once", () => {
        trace: { inits: 0 }
        Thing: {
            init: (input) => {
                trace.inits = trace.inits + 1
                this.answer: input.value()
            }
        }

        made: (() => {
            Thing(input: (() => 17).future())
        }).future().value()

        Assertions.require(made.parent() === Thing)
        Assertions.require(made.answer == 17)
        Assertions.require(trace.inits == 1)
    }),
    Test("duplicate positional binding fails before defaults or body", () => {
        trace: { defaults: 0, bodies: 0 }
        defaultValue: () => {
            trace.defaults = trace.defaults + 1
            2
        }
        f: (first, second: defaultValue()) => {
            trace.bodies = trace.bodies + 1
            second
        }
        Assertions.signals(Error, () => { f(1, first: 9) })
        Assertions.require(trace.defaults == 0)
        Assertions.require(trace.bodies == 0)
    }),
    Test("failure in the first supplied argument stops later evaluation", () => {
        trace: { later: 0, bodies: 0 }
        failure: Error()
        fail: () => { failure.signal() }
        later: () => {
            trace.later = trace.later + 1
            2
        }
        f: (first, second) => {
            trace.bodies = trace.bodies + 1
            first
        }
        observed: Assertions.signals(Error, () => { f(first: fail(), second: later()) })
        Assertions.require(observed === failure)
        Assertions.require(trace.later == 0)
        Assertions.require(trace.bodies == 0)
    }),
    Test("a named callback preserves the captured non-local return home", () => {
        outer: () => {
            apply: (action) => action()
            apply(action: () => { ^42 })
            0
        }
        Assertions.require(outer() == 42)
    })
]
tests.freeze()
