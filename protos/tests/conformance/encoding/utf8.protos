Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("utf8 encode exact and fresh", () => {
        tool009LegacyCase: () => {
            first: Encoding.UTF8.encode("A\u{1f600}")
            second: Encoding.UTF8.encode("A\u{1f600}")

            (first !== second) &&
                (first.size() == 5) &&
                (first[0] == 65) &&
                (first[1] == 240) &&
                (first[2] == 159) &&
                (first[3] == 152) &&
                (first[4] == 128)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("utf8 initial bom consumed", () => {
        tool009LegacyCase: () => {
            bytes: Encoding.UTF8.encode("")
            bytes.add(239)
            bytes.add(187)
            bytes.add(191)
            bytes.add(65)

            Encoding.UTF8.decode(bytes) == "A"
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("utf8 late bom preserved", () => {
        tool009LegacyCase: () => {
            bytes: Encoding.UTF8.encode("")
            bytes.add(65)
            bytes.add(239)
            bytes.add(187)
            bytes.add(191)
            bytes.add(66)

            Encoding.UTF8.decode(bytes) == "A\u{feff}B"
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("utf8 malformed error", () => {
        Assertions.signals(EncodingError, () => {
            bytes: Encoding.UTF8.encode("")
            bytes.add(192)
            bytes.add(175)

            Encoding.UTF8.decode(bytes)
        })
    })
]
tests.freeze()
