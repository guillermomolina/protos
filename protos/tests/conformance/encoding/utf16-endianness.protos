le: Encoding.UTF16LE.encode("A\u{1f600}")
be: Encoding.UTF16BE.encode("A\u{1f600}")

(le.size() == 6) &&
    (be.size() == 6) &&
    (le[0] == 65) &&
    (le[1] == 0) &&
    (le[2] == 61) &&
    (le[3] == 216) &&
    (le[4] == 0) &&
    (le[5] == 222) &&
    (be[0] == 0) &&
    (be[1] == 65) &&
    (be[2] == 216) &&
    (be[3] == 61) &&
    (be[4] == 222) &&
    (be[5] == 0)
