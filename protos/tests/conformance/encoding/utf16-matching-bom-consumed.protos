le: Encoding.UTF8.encode("")
le.add(255)
le.add(254)
le.add(65)
le.add(0)

be: Encoding.UTF8.encode("")
be.add(254)
be.add(255)
be.add(0)
be.add(65)

(Encoding.UTF16LE.decode(le) == "A") &&
    (Encoding.UTF16BE.decode(be) == "A")
