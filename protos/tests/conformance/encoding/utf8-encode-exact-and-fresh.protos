first: Encoding.UTF8.encode("A\u{1f600}")
second: Encoding.UTF8.encode("A\u{1f600}")

(first !== second) &&
    (first.size() == 5) &&
    (first[0] == 65) &&
    (first[1] == 240) &&
    (first[2] == 159) &&
    (first[3] == 152) &&
    (first[4] == 128)
