first: Encoding.UTF8.encode("A\u{1f600}")
second: Encoding.UTF8.encode("A\u{1f600}")

(first !== second).and() {
    (first.size() == 5).and() {
        (first.at(0) == 65).and() {
            (first.at(1) == 240).and() {
                (first.at(2) == 159).and() {
                    (first.at(3) == 152).and() {
                        first.at(4) == 128
                    }
                }
            }
        }
    }
}
