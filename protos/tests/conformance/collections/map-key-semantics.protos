Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("map equal path keys collapse", () => {
        tool009LegacyCase: () => {
            a: Path.relative().child("same")
            b: Path.relative().child("same")
            m: Map()
            m.atPut(a, 10)
            m.atPut(b, 20)
            (m.size() == 1) &&
                (m.at(a) == 20)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("map invalid equality result error", () => {
        Assertions.signals(Error, () => {
            stored: {
                hash: () => { 7 }
            }

            querySource: {
                hash: () => { 7 }
                equals: (other) => { 1 }
            }
            queryView: querySource.alias("equals", "==")
            query: queryView {}

            m: Map()
            m[stored] = 1
            m.containsKey(query)
        })
    }),
    Test("map invalid hash result error", () => {
        Assertions.signals(Error, () => {
            key: {
                hash: () => { "not-an-integer" }
            }

            m: Map()
            m.containsKey(key)
        })
    }),
    Test("map lookup update contains size identity", () => {
        tool009LegacyCase: () => {
            m: Map()
            other: Map()

            m.atPut(1, 10)
            m.atPut(2, 20)
            m.atPut(1.0, 11)

            (m.at(1) == 11) &&
                m.containsKey(2) &&
                (m.size() == 2) &&
                (m !== other)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("map query equality direction representative", () => {
        tool009LegacyCase: () => {
            storedSource: {
                hash: () => { 7 }
                equals: (other) => { false }
            }
            storedView: storedSource.alias("equals", "==")
            stored: storedView {}

            querySource: {
                hash: () => { 7 }
                equals: (other) => {
                    other === stored
                }
            }
            queryView: querySource.alias("equals", "==")
            query: queryView {}

            m: Map()
            m[stored] = 11

            replacement: {}
            returned: m.atPut(query, replacement)
            representative: null
            m.each((key, value) => {
                representative = key
            })

            (returned === replacement) &&
                (m.size() == 1) &&
                (m[query] === replacement) &&
                (representative === stored)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("map recorded hash no identity shortcut", () => {
        tool009LegacyCase: () => {
            source: {
                hash: () => {
                    this.code
                }
                equals: (other) => {
                    this === other
                }
            }
            view: source.alias("equals", "==")
            key: view {
                code: 7
            }

            m: Map()
            m[key] = 1
            key.code = 8

            !m.containsKey(key)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("map reentrant mutation from hash error", () => {
        Assertions.signals(Error, () => {
            m: Map()

            key: {
                hash: () => {
                    m["nested"] = 1
                    7
                }
            }

            m[key] = 42
        })
    }),
    Test("map single hash absent insertion", () => {
        tool009LegacyCase: () => {
            state: {
                calls: 0
            }

            key: {
                hash: () => {
                    state.calls = state.calls + 1
                    state.calls
                }
            }

            marker: {}
            m: Map()
            returned: m.atPut(key, marker)
            insertionCalls: state.calls

            key.hash = () => {
                1
            }

            (returned === marker) &&
                (insertionCalls == 1) &&
                m.containsKey(key) &&
                (m[key] === marker) &&
                (m.size() == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
