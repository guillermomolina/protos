key: {}
other: {}
first: {}
replacement: {}
frozenAttempt: {}
m: IdentityMap()
m[key] = first

sameClosed: m.close() === m
m[key] = replacement

insertFailed: false
Error.handle(() => {
    m[other] = {}
    null
}, (error) => {
    insertFailed = true
    null
})

removeFailed: false
Error.handle(() => {
    m.remove(key)
    null
}, (error) => {
    removeFailed = true
    null
})

sameFrozen: m.freeze() === m
frozenReplacementFailed: false
Error.handle(() => {
    m[key] = frozenAttempt
    null
}, (error) => {
    frozenReplacementFailed = true
    null
})

sameClosed &&
    sameFrozen &&
    insertFailed &&
    removeFailed &&
    frozenReplacementFailed &&
    (m[key] === replacement) &&
    m.containsKey(key) &&
    (m.containsKey(other) == false) &&
    (m.size() == 1)
