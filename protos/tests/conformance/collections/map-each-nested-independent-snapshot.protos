m: Map()
m["a"] = 1
m["b"] = 2

outerVisits: 0
innerVisits: 0

outerReturned: m.each((key, value) => {
    outerVisits = outerVisits + 1

    (outerVisits == 1).ifTrue(() => {
        m["c"] = 3

        innerReturned: m.each((innerKey, innerValue) => {
            innerVisits = innerVisits + 1
        })

        innerReturned === m
    })
})

(outerVisits == 2) &&
    (innerVisits == 3) &&
    (outerReturned === m) &&
    (m.size() == 3)
