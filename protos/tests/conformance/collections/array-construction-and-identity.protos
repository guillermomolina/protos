Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("array copied factory receiver error", () => {
        Assertions.signals(Error, () => {
            copiedCall: Array.slotValue("call")
            ordinary: {
                call: copiedCall
            }
            ordinary(1)
        })
    }),
    Test("array factory fresh single and shallow", () => {
        tool009LegacyCase: () => {
            marker: {}
            first: Array(1, marker)
            second: Array(1, marker)
            singleton: Array(3)

            (first !== second) &&
                (first.size() == 2) &&
                (first[0] == 1) &&
                (first[1] === marker) &&
                (singleton.size() == 1) &&
                (singleton[0] == 3)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("array inherited factory parent observable", () => {
        tool009LegacyCase: () => {
            MyArray: Array {
                label: 9
            }
            xs: MyArray(10, 20)

            (xs.size() == 2) &&
                (xs[0] == 10) &&
                (xs[1] == 20) &&
                (xs.label == 9)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("array ordinary identity and equality", () => {
        tool009LegacyCase: () => {
            a: Array(1)
            b: Array(1)

            (a == a) &&
                (a === a) &&
                ((a == b) == false) &&
                ((a === b) == false)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
