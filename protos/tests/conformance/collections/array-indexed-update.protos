Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("array delegated atput receiver error", () => {
        Assertions.signals(Error, () => {
            Fake: Array {}
            Fake[0] = 1
        })
    })
    Test("array indexed assignment exact rhs", () => {
        tool009LegacyCase: () => {
            marker: {}
            xs: Array(10, 20)
            written: xs[0] = marker

            (written === marker) &&
                (xs[0] === marker) &&
                (xs.size() == 2)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("array indexed assignment ignores atput return", () => {
        tool009LegacyCase: () => {
            receiver: {
                atPut: (index, value) => 999
            }
            receiver[0] = 7
        }
        Assertions.require(tool009LegacyCase() == 7)
    })
    Test("array replacement keeps size", () => {
        tool009LegacyCase: () => {
            values: Array(1, 2)
            written: values.atPut(1, 9)
            (written == 9) &&
                (values.size() == 2) &&
                (values.at(1) == 9)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("array write float index error", () => {
        Assertions.signals(Error, () => {
            xs: Array(1)
            xs[0.0] = 2
        })
    })
    Test("array write negative index error", () => {
        Assertions.signals(Error, () => {
            xs: Array(1)
            xs[-1] = 2
        })
    })
    Test("array write out of range error", () => {
        Assertions.signals(Error, () => {
            xs: Array(1)
            xs[1] = 2
        })
    })
]
tests.freeze()
