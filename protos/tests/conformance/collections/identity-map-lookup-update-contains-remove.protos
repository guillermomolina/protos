m: IdentityMap()
key: {}
absent: {}

m.atPut(key, 5)
m.atPut(key, 7)
before: m.containsKey(key)
missing: m.containsKey(absent)
old: m.remove(key)
after: m.containsKey(key)

(before).and() {
    (missing == false).and() {
        (old == 7).and() {
            (after == false).and() {
                m.size() == 0
            }
        }
    }
}
