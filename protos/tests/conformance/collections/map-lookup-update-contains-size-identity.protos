m: Map()
other: Map()

m.atPut(1, 10)
m.atPut(2, 20)
m.atPut(1.0, 11)

(m.at(1) == 11).and() {
    m.containsKey(2).and() {
        (m.size() == 2).and() {
            m !== other
        }
    }
}
