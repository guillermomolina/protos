Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("map at if absent present lazy exact", () => {
        tool009LegacyCase: () => {
            Assertions: import("std:test/Assertions")

            state: {
                queryHashCalls: 0
                queryEqualityCalls: 0
                storedEqualityCalls: 0
            }

            storedSource: {
                hash: () => { 7 }
                storedEquals: (other) => {
                    state.storedEqualityCalls = state.storedEqualityCalls + 1
                    false
                }
            }
            storedView: storedSource.alias("storedEquals", "==")
            stored: storedView {}

            querySource: {
                hash: () => {
                    state.queryHashCalls = state.queryHashCalls + 1
                    7
                }
                queryEquals: (other) => {
                    state.queryEqualityCalls = state.queryEqualityCalls + 1
                    other === stored
                }
            }
            queryView: querySource.alias("queryEquals", "==")
            query: queryView {}

            marker: {}
            m: Map()
            m[stored] = marker

            matched: m.atIfAbsent(query, 0)

            m["null"] = null
            m["false"] = false

            nullValue: m.atIfAbsent("null", 0)
            falseValue: m.atIfAbsent("false", 0)

            Assertions.require(
                (matched === marker) &&
                (state.queryHashCalls == 1) &&
                (state.queryEqualityCalls == 1) &&
                (state.storedEqualityCalls == 0) &&
                (nullValue === null) &&
                (falseValue === false)
            )
        }
        Assertions.require(tool009LegacyCase() === null)
    })
]
tests.freeze()
