Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("map construction syntax basic", () => {
        tool009LegacyCase: () => {
            name: "language"

            mapping: %{
                name: "Protos"
                "version": 1
            }

            inline: %{ "left": 10; "right": 20 }
            empty: %{}

            holder: {
                key: "answer"
                make: () => %{
                    this.key: 42
                }
            }

            (mapping.size() == 2) &&
                (mapping["language"] == "Protos") &&
                (mapping["version"] == 1) &&
                (inline["left"] == 10) &&
                (inline["right"] == 20) &&
                (empty.size() == 0) &&
                (%{ "value": 7 }["value"] == 7) &&
                (holder.make()["answer"] == 42)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("map construction syntax bypasses atput", () => {
        tool009LegacyCase: () => {
            DerivedMap: Map {
                marker: 7

                atPut: (key, value) => {
                    ^999
                }
            }

            run: () => {
                Map: DerivedMap

                mapping: %{
                    "first": 1
                    "second": 2
                }

                (mapping.marker == 7) &&
                    (mapping["first"] == 1) &&
                    (mapping["second"] == 2)
            }

            run()
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("map construction syntax duplicate error", () => {
        Assertions.signals(Error, () => {
            %{
                "key": 1
                "key": 2
            }
        })
    })
    Test("map construction syntax factory first", () => {
        Assertions.signals(Error, () => {
            touched: 0

            run: () => {
                Map: () => {
                    ^7
                }

                touch: () => {
                    touched = touched + 1
                    1
                }

                %{
                    touch(): 10
                }

                99
            }

            (run() == 7) && (touched == 0)
        })
    })
    Test("map construction syntax order", () => {
        tool009LegacyCase: () => {
            trace: Array(null, null, null, null)
            step: 0

            record: (marker, result) => {
                trace[step] = marker
                step = step + 1
                result
            }

            mapping: %{
                record(1, "first"): record(2, 10)
                record(3, "second"): record(4, 20)
            }

            (step == 4) &&
                (trace[0] == 1) &&
                (trace[1] == 2) &&
                (trace[2] == 3) &&
                (trace[3] == 4) &&
                (mapping["first"] == 10) &&
                (mapping["second"] == 20)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
