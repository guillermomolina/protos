Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("map at if absent absent single search", () => {
        tool009LegacyCase: () => {
            Assertions: import("std:test/Assertions")

            state: {
                hashCalls: 0
                fallbackCalls: 0
            }

            querySource: {
                hash: () => {
                    state.hashCalls = state.hashCalls + 1
                    7
                }
            }
            query: querySource {}

            storedByFallback: {}
            fallbackResult: {}
            m: Map()

            result: m.atIfAbsent(query, () => {
                state.fallbackCalls = state.fallbackCalls + 1
                m[query] = storedByFallback
                fallbackResult
            })

            hashCallsAfterAtIfAbsent: state.hashCalls
            stored: m[query]

            Assertions.require(
                (result === fallbackResult) &&
                (stored === storedByFallback) &&
                (state.fallbackCalls == 1) &&
                (hashCallsAfterAtIfAbsent == 2)
            )
        }
        Assertions.require(tool009LegacyCase() === null)
    })
]
tests.freeze()
