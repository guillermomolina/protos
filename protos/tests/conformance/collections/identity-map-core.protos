Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("identity map cross numeric family distinct", () => {
        tool009LegacyCase: () => {
            m: IdentityMap()
            m.atPut(1, 10)
            m.atPut(1.0, 20)

            (m.size() == 2) &&
                (m.at(1) == 10) &&
                (m.at(1.0) == 20)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map delegated receiver error", () => {
        Assertions.signals(Error, () => {
            Fake: IdentityMap {}
            Fake.size()
        })
    }),
    Test("identity map distinct objects", () => {
        tool009LegacyCase: () => {
            a: { value: 1 }
            b: { value: 1 }
            m: IdentityMap()
            m.atPut(a, 10)
            m.atPut(b, 20)
            m.size()
        }
        Assertions.require(tool009LegacyCase() == 2)
    }),
    Test("identity map equal path keys remain distinct", () => {
        tool009LegacyCase: () => {
            a: Path.relative().child("same")
            b: Path.relative().child("same")
            m: IdentityMap()
            m.atPut(a, 10)
            m.atPut(b, 20)
            (m.size() == 2) &&
                (m.at(a) == 10) &&
                (m.at(b) == 20)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map equal strings collapse", () => {
        tool009LegacyCase: () => {
            m: IdentityMap()
            m.atPut("hel" + "lo", 1)
            m.atPut("hello", 2)
            m.size()
        }
        Assertions.require(tool009LegacyCase() == 1)
    }),
    Test("identity map factory fresh open", () => {
        tool009LegacyCase: () => {
            a: IdentityMap()
            b: IdentityMap()

            a["x"] = 1

            (a !== b) &&
                (a.size() == 1) &&
                (b.size() == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map factory wrong arity error", () => {
        Assertions.signals(Error, () => {
            IdentityMap(1)
        })
    }),
    Test("identity map no key callbacks", () => {
        tool009LegacyCase: () => {
            calls: {
                count: 0
            }

            source: {
                hash: () => {
                    calls.count = calls.count + 1
                    7
                }
                identityHash: () => {
                    calls.count = calls.count + 1
                    13
                }
                equals: (other) => {
                    calls.count = calls.count + 1
                    true
                }
            }
            view: source.alias("equals", "==")
            key: view {}

            m: IdentityMap()
            m[key] = 42
            found: m.containsKey(key)
            value: m[key]
            removed: m.remove(key)
            absent: m.containsKey(key)

            found &&
                (value == 42) &&
                (removed == 42) &&
                !absent &&
                (calls.count == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
