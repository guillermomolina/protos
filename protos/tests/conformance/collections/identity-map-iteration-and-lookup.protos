Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("identity map at if absent paths", () => {
        tool009LegacyCase: () => {
            Assertions: import("std:test/Assertions")

            state: {
                keyCallbacks: 0
                fallbackCalls: 0
            }

            source: {
                hash: () => {
                    state.keyCallbacks = state.keyCallbacks + 1
                    7
                }
                equals: (other) => {
                    state.keyCallbacks = state.keyCallbacks + 1
                    true
                }
            }
            view: source.alias("equals", "==")

            presentKey: view {}
            absentKey: view {}

            m: IdentityMap()
            m[presentKey] = null

            present: m.atIfAbsent(presentKey, 0)

            storedByFallback: {}
            fallbackResult: {}

            absent: m.atIfAbsent(absentKey, () => {
                state.fallbackCalls = state.fallbackCalls + 1
                m[absentKey] = storedByFallback
                fallbackResult
            })

            stored: m[absentKey]

            Assertions.require(
                (present === null) &&
                (absent === fallbackResult) &&
                (stored === storedByFallback) &&
                (state.fallbackCalls == 1) &&
                (state.keyCallbacks == 0)
            )
        }
        Assertions.require(tool009LegacyCase() === null)
    }),
    Test("identity map each association snapshot mutation", () => {
        tool009LegacyCase: () => {
            aKey: {}
            bKey: {}
            cKey: {}
            dKey: {}

            aValue: { tag: 1 }
            bValue: { tag: 2 }
            cValue: { tag: 3 }
            newB: {}
            newC: {}
            lateValue: {}

            m: IdentityMap()
            m[aKey] = aValue
            m[bKey] = bValue
            m[cKey] = cValue

            visits: 0
            valid: true

            returned: m.each((key, value) => {
                visits = visits + 1

                (visits == 1).ifTrue(() => {
                    valid = valid && (key === aKey) && (value === aValue)

                    m[bKey] = newB
                    m.remove(cKey)
                    m[cKey] = newC
                    m[dKey] = lateValue
                    bValue.tag = 22
                })

                (visits == 2).ifTrue(() => {
                    valid = valid &&
                        (key === bKey) &&
                        (value === bValue) &&
                        (value.tag == 22)
                })

                (visits == 3).ifTrue(() => {
                    valid = valid && (key === cKey) && (value === cValue)
                })
            })

            valid &&
                (visits == 3) &&
                (returned === m) &&
                (m[bKey] === newB) &&
                (m[cKey] === newC) &&
                (m[dKey] === lateValue)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map each noninvokable error", () => {
        Assertions.signals(Error, () => {
            m: IdentityMap()
            m["a"] = 1
            m.each(1)
        })
    }),
    Test("identity map each order return", () => {
        tool009LegacyCase: () => {
            a: {}
            b: {}
            c: {}

            m: IdentityMap()
            m[a] = 1
            m[b] = 2
            m[c] = 3

            seen: 0
            returned: m.each((key, value) => {
                seen = (seen * 10) + value
            })

            (seen == 123) && (returned === m)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map each wrong arity error", () => {
        Assertions.signals(Error, () => {
            m: IdentityMap()
            m.each()
        })
    }),
    Test("identity map lookup update contains remove", () => {
        tool009LegacyCase: () => {
            m: IdentityMap()
            key: {}
            absent: {}

            m.atPut(key, 5)
            m.atPut(key, 7)
            before: m.containsKey(key)
            missing: m.containsKey(absent)
            old: m.remove(key)
            after: m.containsKey(key)

            before &&
                (missing == false) &&
                (old == 7) &&
                (after == false) &&
                (m.size() == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("identity map missing key error", () => {
        Assertions.signals(Error, () => {
            IdentityMap().at({})
        })
    })
]
tests.freeze()
