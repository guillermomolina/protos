aKey: {}
bKey: {}
cKey: {}
dKey: {}

aValue: { tag: 1 }
bValue: { tag: 2 }
cValue: { tag: 3 }
newB: {}
newC: {}
lateValue: {}

m: IdentityMap()
m[aKey] = aValue
m[bKey] = bValue
m[cKey] = cValue

visits: 0
valid: true

returned: m.each((key, value) => {
    visits = visits + 1

    (visits == 1).ifTrue(() => {
        valid = valid && (key === aKey) && (value === aValue)

        m[bKey] = newB
        m.remove(cKey)
        m[cKey] = newC
        m[dKey] = lateValue
        bValue.tag = 22
    })

    (visits == 2).ifTrue(() => {
        valid = valid &&
            (key === bKey) &&
            (value === bValue) &&
            (value.tag == 22)
    })

    (visits == 3).ifTrue(() => {
        valid = valid && (key === cKey) && (value === cValue)
    })
})

valid &&
    (visits == 3) &&
    (returned === m) &&
    (m[bKey] === newB) &&
    (m[cKey] === newC) &&
    (m[dKey] === lateValue)
