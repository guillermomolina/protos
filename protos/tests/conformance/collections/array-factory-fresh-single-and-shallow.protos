marker: {}
first: Array(1, marker)
second: Array(1, marker)
singleton: Array(3)

(first !== second).and() {
    (first.size() == 2).and() {
        (first.at(0) == 1).and() {
            (first.at(1) === marker).and() {
                (singleton.size() == 1).and() {
                    singleton.at(0) == 3
                }
            }
        }
    }
}
