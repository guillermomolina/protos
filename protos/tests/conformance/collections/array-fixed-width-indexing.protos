first: {}
replacement: {}
surfaceReplacement: {}
values: Array(first, 20, 30)

readProtocol: values.at(UInt8(0))
readSurface: values[Int16(1)]
writtenProtocol: values.atPut(UInt32(2), replacement)
afterProtocolWrite: values[UInt64(2)]
writtenSurface: values[Int8(0)] = surfaceReplacement
afterSurfaceWrite: values.at(UInt16(0))

(readProtocol === first) &&
    (readSurface == 20) &&
    (writtenProtocol === replacement) &&
    (afterProtocolWrite === replacement) &&
    (writtenSurface === surfaceReplacement) &&
    (afterSurfaceWrite === surfaceReplacement) &&
    (values.size() == 3)
