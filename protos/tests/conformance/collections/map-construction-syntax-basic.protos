name: "language"

mapping: %{
    name: "Protos"
    "version": 1
    "version": 2
}

inline: %{ "left": 10; "right": 20 }
empty: %{}

holder: {
    key: "answer"
    make: () => %{
        this.key: 42
    }
}

(mapping.size() == 2) &&
    (mapping["language"] == "Protos") &&
    (mapping["version"] == 2) &&
    (inline["left"] == 10) &&
    (inline["right"] == 20) &&
    (empty.size() == 0) &&
    (%{ "value": 7 }["value"] == 7) &&
    (holder.make()["answer"] == 42)
