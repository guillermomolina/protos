Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("identity map cross numeric family distinct", () => {
        tool009LegacyCase: () => {
            m: IdentityMap()
            m.atPut(1, 10)
            m.atPut(1.0, 20)

            (m.size() == 2) &&
                (m.at(1) == 10) &&
                (m.at(1.0) == 20)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
