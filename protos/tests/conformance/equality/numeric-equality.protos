Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("numeric cross family equality", () => {
        tool009LegacyCase: () => {
            ok: true
            (1 == 1.0).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("numeric exact float equality", () => {
        tool009LegacyCase: () => {
            ok: true
            (9007199254740992 == 9007199254740992.0).ifFalse(() => { ok = false })
            (9007199254740993 == 9007199254740993.0).ifTrue(() => { ok = false })
            (99999999999999991611392 == 1e23).ifFalse(() => { ok = false })
            (1 == 1.5).ifTrue(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("numeric inequality true", () => {
        tool009LegacyCase: () => {
            1 != 2
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("numeric inequality false", () => {
        tool009LegacyCase: () => {
            1 != 1.0
        }
        Assertions.require(tool009LegacyCase() === false)
    }),
    Test("numeric nan signed zero equality", () => {
        tool009LegacyCase: () => {
            nan: 0.0 / 0.0
            positiveInfinity: 1.0 / 0.0
            negativeInfinity: -1.0 / 0.0

            ok: true
            (nan == nan).ifTrue(() => { ok = false })
            (nan == 0).ifTrue(() => { ok = false })
            (0.0 == -0.0).ifFalse(() => { ok = false })
            (0 == -0.0).ifFalse(() => { ok = false })
            (positiveInfinity == positiveInfinity).ifFalse(() => { ok = false })
            (positiveInfinity == negativeInfinity).ifTrue(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("numeric non number equality false", () => {
        tool009LegacyCase: () => {
            ordinary: {}

            ok: true
            (1 == ordinary).ifTrue(() => { ok = false })
            (1.0 == ordinary).ifTrue(() => { ok = false })
            (1 == null).ifTrue(() => { ok = false })
            (1 == true).ifTrue(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("numeric non number receiver error", () => {
        Assertions.signals(Error, () => {
            fakeNumber: Number {}
            fakeNumber == 1
        })
    }),
    Test("numeric value identity specials", () => {
        tool009LegacyCase: () => {
            nanA: 0.0 / 0.0
            nanB: 0.0 / 0.0

            (1.5 === 1.5) &&
                (0.0 !== -0.0) &&
                (nanA === nanB)
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
