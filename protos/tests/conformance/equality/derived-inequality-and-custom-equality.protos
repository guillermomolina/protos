Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("derived inequality evaluates once", () => {
        tool009LegacyCase: () => {
            calls: {
                left: 0
                right: 0
                equality: 0
            }

            source: {
                equals: (other) => {
                    calls.equality = calls.equality + 1
                    false
                }
            }

            view: source.alias("equals", "==")

            leftFactory: () => {
                calls.left = calls.left + 1
                view {}
            }

            rightFactory: () => {
                calls.right = calls.right + 1
                view {}
            }

            result: leftFactory() != rightFactory()

            Assertions.require(result)
            Assertions.require(calls.left == 1)
            Assertions.require(calls.right == 1)
            Assertions.require(calls.equality == 1)

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("derived inequality ignores custom inequality slot", () => {
        tool009LegacyCase: () => {
            source: {
                equals: (other) => { false }
                notEquals: (other) => { false }
            }

            view: source.alias("equals", "==").alias("notEquals", "!=")
            left: view {}
            right: view {}

            Assertions.require(left != right)

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("invalid custom equality derived inequality error", () => {
        Assertions.signals(Error, () => {
            source: {
                equals: (other) => { 1 }
            }

            view: source.alias("equals", "==")
            left: view {}
            right: view {}

            left != right
        })
    }),
    Test("object match dynamic equality exact once", () => {
        tool009LegacyCase: () => {
            calls: {
                count: 0
            }
            marker: {}

            source: {
                equals: (other) => {
                    calls.count = calls.count + 1
                    marker
                }
            }
            view: source.alias("equals", "==")
            pattern: view {}

            result: pattern.match(pattern)

            (result === marker) && (calls.count == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
