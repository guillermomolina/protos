// D242 MODULE/SOURCE separation observable from a direct-file suite-native
// case. Relative imports from a direct-file case are SOURCE imports; MODULE
// semantics are exercised through Standard Library MODULE routes.

Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("source import exposes every top-level binding", () => {
        source: import("./fixtures/range/Range.protos")
        Assertions.require(source.hasSlot("privateHelper"))
        Assertions.require(source.hasSlot("Range"))
        Assertions.require(source.privateHelper == 42)
        Assertions.require(source.Range.value == 1)
        null
    }),
    Test("source import is cached by exact identity", () => {
        first: import("./fixtures/range/Range.protos")
        equivalent: import("./fixtures/range/../range/Range.protos")
        Assertions.require(first === equivalent)
        null
    }),
    Test("module initializer is rejected as a direct source", () => {
        Assertions.signals(Error, () => {
            import("./fixtures/range/module.protos")
        })
    }),
    Test("missing source file is rejected", () => {
        Assertions.signals(Error, () => {
            import("./fixtures/range/Missing.protos")
        })
    }),
    Test("relative source traversal above the case root is rejected", () => {
        Assertions.signals(Error, () => {
            import("../../../../../../../../outside.protos")
        })
    }),
    Test("source cycles observe the partial context", () => {
        a: import("./fixtures/cycle/a.protos")
        b: import("./fixtures/cycle/b.protos")
        Assertions.require(b.sawX)
        Assertions.require(b.sawY === false)
        Assertions.require(b.partial === a)
        Assertions.require(a.y == 20)
        null
    }),
    Test("failed source import is evicted and retried", () => {
        Assertions.signals(Error, () => {
            import("./fixtures/failure/failing.protos")
        })
        counter: import("./fixtures/failure/counter.protos")
        escaped: counter.lastEscaped
        Assertions.require(escaped.marker == 1)
        retried: import("./fixtures/failure/failing.protos")
        Assertions.require(retried.marker == 2)
        Assertions.require(retried !== escaped)
        Assertions.require(escaped.marker == 1)
        null
    }),
    Test("module public object exposes only published slots", () => {
        Runtime: import("std:runtime")
        Assertions.require(Runtime.hasSlot("info"))
        Assertions.require(Runtime.slotNames().size() == 1)
        Assertions.require(Runtime.hasSlot("_runtimeMetadataFacility") === false)
        null
    }),
    Test("module import result is cached and distinct from sources", () => {
        Runtime: import("std:runtime")
        Assertions.require(import("std:runtime") === Runtime)
        Assertions.require(Runtime !== import("./fixtures/range/Range.protos"))
        null
    }),
    Test("module publishes exact prelude identities", () => {
        Ranges: import("std:collections/range")
        Assertions.require(Ranges.Range === Range)
        Assertions.require(Ranges.InvertedRange === InvertedRange)
        null
    }),
    Test("missing module directory and obsolete routes are rejected", () => {
        Assertions.signals(Error, () => { import("std:collections/no_such_module") })
        Assertions.signals(Error, () => { import("std:collections/Range") })
        Assertions.signals(Error, () => { import("std:collections/internal") })
        Assertions.signals(Error, () => { import("std:collections/internal/ArrayBulk") })
        null
    }),
    Test("extracted module closure rebinds its receiver normally", () => {
        Assertions: import("std:test/assertions")
        require: Assertions.require
        require(true)
        null
    })
]
tests.freeze()
