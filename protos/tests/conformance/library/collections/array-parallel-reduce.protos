Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Arrays: import("std:collections/Array")

tests: Array(
    Test("array parallel reduce sums", () => {
        sum: Arrays.parallelReduce(Array(3, 1, 4, 1, 5, 9, 2, 6), (left, right) => {
            left + right
        }).value()
        Assertions.require(sum == 31)
    }),
    Test("array parallel reduce empty and singleton", () => {
        empty: Arrays.parallelReduce(Array(), (left, right) => { left + right }).value()
        single: Arrays.parallelReduce(Array(7), (left, right) => { 0 }).value()
        Assertions.require(empty === null)
        Assertions.require(single == 7)
    }),
    Test("array parallel reduce uses the adjacent pair tree", () => {
        // ((10 - 1) - (2 - 3)) - 4; a sequential left fold would give 0.
        difference: Arrays.parallelReduce(Array(10, 1, 2, 3, 4), (left, right) => {
            left - right
        }).value()
        Assertions.require(difference == 6)
    }),
    Test("array parallel reduce passes explicit arguments", () => {
        // (1 + 2 + 10) + 3 + 10
        total: Arrays.parallelReduce(Array(1, 2, 3), (left, right, offset) => {
            left + right + offset
        }, 10).value()
        Assertions.require(total == 26)
    }),
    Test("array parallel reduce leftmost failing pair wins", () => {
        Assertions.signals(SlotNotFound, () => {
            Arrays.parallelReduce(Array(0, 1, 2, 3), (left, right) => {
                (left == 0).ifTrue(() => { SlotNotFound().signal() })
                (left == 2).ifTrue(() => { InvalidSuper().signal() })
                left + right
            }).value()
        })
    }),
    Test("array parallel reduce cancellation", () => {
        future: Arrays.parallelReduce(Array(1, 2), (left, right) => { left + right })
        future.cancel()
        Assertions.signals(Cancelled, () => { future.value() })
    })
)
tests.freeze()
