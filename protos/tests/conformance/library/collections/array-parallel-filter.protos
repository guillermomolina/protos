Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Arrays: import("std:collections/Array")

sameElements: (actual, expected) => {
    ok: actual.size() == expected.size()
    ok.ifTrue(() => {
        index: 0
        expected.each((element) => {
            (actual[index] == element).ifFalse(() => { ok = false })
            index = index + 1
        })
    })
    ok
}

tests: Array(
    Test("array parallel filter keeps selected elements in source order", () => {
        evens: Arrays.parallelFilter(Array(3, 1, 4, 1, 5, 9, 2, 6), (value) => {
            value.mod(2) == 0
        }).value()
        Assertions.require(sameElements(evens, Array(4, 2, 6)))
    }),
    Test("array parallel filter empty, singleton and null elements", () => {
        empty: Arrays.parallelFilter(Array(), (value) => { true }).value()
        single: Arrays.parallelFilter(Array(5), (value) => { false }).value()
        nulls: Arrays.parallelFilter(Array(1, null, 2), (value) => {
            value === null
        }).value()
        Assertions.require(sameElements(empty, Array()))
        Assertions.require(sameElements(single, Array()))
        Assertions.require(sameElements(nulls, Array(null)))
    }),
    Test("array parallel filter passes explicit arguments", () => {
        large: Arrays.parallelFilter(Array(1, 5, 10, 50), (value, limit) => {
            value > limit
        }, 7).value()
        Assertions.require(sameElements(large, Array(10, 50)))
    }),
    Test("array parallel filter invalid predicate result", () => {
        Assertions.signals(InvalidPredicateResult, () => {
            Arrays.parallelFilter(Array(1, 2), (value) => { value }).value()
        })
    }),
    Test("array parallel filter lowest failing index wins", () => {
        Assertions.signals(InvalidPredicateResult, () => {
            Arrays.parallelFilter(Array(0, 1, 2), (value) => {
                decision: true
                (value == 1).ifTrue(() => { decision = 7 })
                (value == 2).ifTrue(() => { SlotNotFound().signal() })
                decision
            }).value()
        })
    }),
    Test("array parallel filter cancellation", () => {
        future: Arrays.parallelFilter(Array(1, 2), (value) => { true })
        future.cancel()
        Assertions.signals(Cancelled, () => { future.value() })
    })
)
tests.freeze()
