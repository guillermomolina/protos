// D235-B1-F: Range and InvertedRange are frozen Core Prelude prototypes, and
// std:collections/range is a compatibility module exporting the same objects.
// D236-B1 / D239-C1: each prototype owns an ordinary construct that
// normalizes direction; Range(a, b) reaches it through the inherited
// standard Object.call.

Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: Array(
    Test("range prelude bindings need no import", () => {
        Assertions.require(Range.parent() === Object)
        Assertions.require(InvertedRange.parent() === Object)
        Assertions.require(Range !== InvertedRange)
        Assertions.require(Range(0, 2).parent() === Range)
        Assertions.require(InvertedRange(2, 0).parent() === InvertedRange)

        names: Range.slotNames()
        Assertions.require((names.size() == 6) &&
            Range.hasSlot("init") &&
            Range.hasSlot("construct") &&
            Range.hasSlot("each") &&
            Range.hasSlot("eachStep") &&
            Range.hasSlot("invert") &&
            Range.hasSlot("reverse"))
        invertedNames: InvertedRange.slotNames()
        Assertions.require((invertedNames.size() == 6) &&
            InvertedRange.hasSlot("init") &&
            InvertedRange.hasSlot("construct") &&
            InvertedRange.hasSlot("each") &&
            InvertedRange.hasSlot("eachStep") &&
            InvertedRange.hasSlot("invert") &&
            InvertedRange.hasSlot("reverse"))
        Assertions.require(Range.hasSlot("construct") === true)
        Assertions.require(InvertedRange.hasSlot("construct") === true)
        Assertions.require(Range.hasSlot("call") === false)
        Assertions.require(InvertedRange.hasSlot("call") === false)
    }),
    Test("range canonical prototypes are frozen", () => {
        Assertions.signals(Error, () => { Range.extra: 1 })
        Assertions.signals(Error, () => { Range.each = null })
        Assertions.signals(Error, () => { Range.removeSlot("invert") })
        Assertions.signals(Error, () => { InvertedRange.extra: 1 })
        Assertions.signals(Error, () => { InvertedRange.eachStep = null })
        Assertions.signals(Error, () => { InvertedRange.removeSlot("reverse") })
        Assertions.signals(Error, () => { Range.construct = null })
        Assertions.signals(Error, () => { Range.removeSlot("construct") })
        Assertions.signals(Error, () => { InvertedRange.construct = null })
        Assertions.signals(Error, () => { InvertedRange.removeSlot("construct") })
        Assertions.signals(Error, () => { Range.call: null })
        Assertions.require(Range.hasSlot("construct") && InvertedRange.hasSlot("construct"))
        Assertions.require(Range.hasSlot("call") === false)

        Assertions.require(Range.hasSlot("extra") === false)
        Assertions.require(InvertedRange.hasSlot("extra") === false)
        Assertions.require(Range(0, 1).parent() === Range)
    }),
    Test("range prelude shadowing and frozen binding assignment", () => {
        canonical: Range

        shadowed: (() => {
            Range: 7
            Range
        })()
        Assertions.require(shadowed == 7)
        Assertions.require(Range === canonical)

        Assertions.signals(Error, () => { Range = 7 })
        Assertions.signals(Error, () => { InvertedRange = 7 })
        Assertions.require(Range === canonical)
        Assertions.require(Range(0, 1).parent() === canonical)
    }),
    Test("range module exports the exact prelude identities", () => {
        Ranges: import("std:collections/range")

        names: Ranges.slotNames()
        Assertions.require((names.size() == 2) &&
            Ranges.hasSlot("Range") &&
            Ranges.hasSlot("InvertedRange"))
        Assertions.require(Range === Ranges.Range)
        Assertions.require(InvertedRange === Ranges.InvertedRange)

        again: import("std:collections/range")
        Assertions.require(again === Ranges)
        Assertions.require(again.Range === Range)

        Extracted: Ranges.Range
        Assertions.require(Extracted(0, 3).parent() === Range)
        Assertions.require(Extracted(3, 0).parent() === InvertedRange)
        ExtractedInverted: Ranges.InvertedRange
        Assertions.require(ExtractedInverted(3, 0).parent() === InvertedRange)
        Assertions.require(ExtractedInverted(0, 3).parent() === Range)
        Assertions.require(Ranges.slotNames().size() == 2)
    }),
    Test("range module member rebinding leaves the canonical prototype", () => {
        Ranges: import("std:collections/range")
        canonical: Range

        (() => {
            Ranges.Range = 7
            Assertions.require(Ranges.Range == 7)
            Assertions.require(import("std:collections/range").Range == 7)
            Assertions.require(Range === canonical)
            Assertions.require(InvertedRange === Ranges.InvertedRange)
            Assertions.require(Range(0, 2).parent() === canonical)
            Assertions.require(Range(0, 2).reverse().invert().parent() === canonical)
        }).ensure(() => {
            Ranges.Range = canonical
        })

        Assertions.require(Ranges.Range === Range)

        canonicalInverted: InvertedRange

        (() => {
            Ranges.InvertedRange = 7
            Assertions.require(Ranges.InvertedRange == 7)
            Assertions.require(InvertedRange === canonicalInverted)
            down: Range(5, 0)
            Assertions.require(down.parent() === canonicalInverted)
            Assertions.require((down.start == 5) && (down.stop == 0))
        }).ensure(() => {
            Ranges.InvertedRange = canonicalInverted
        })

        Assertions.require(Ranges.InvertedRange === InvertedRange)
    }),
    Test("range extracted construct closures keep normalization", () => {
        rangeCall: Range.construct
        invertedCall: InvertedRange.construct

        up: rangeCall(0, 3)
        down: rangeCall(3, 0)
        Assertions.require((up.parent() === Range) && (up.start == 0) && (up.stop == 3))
        Assertions.require((down.parent() === InvertedRange) && (down.start == 3) && (down.stop == 0))

        invertedDown: invertedCall(3, 0)
        invertedUp: invertedCall(0, 3)
        Assertions.require((invertedDown.parent() === InvertedRange) &&
            (invertedDown.start == 3) && (invertedDown.stop == 0))
        Assertions.require((invertedUp.parent() === Range) &&
            (invertedUp.start == 0) && (invertedUp.stop == 3))

        Assertions.signals(Error, () => { rangeCall(0) })
        Assertions.signals(Error, () => { invertedCall(0, 1.0) })
    }),
    Test("range inherited call reaches the same canonical construction", () => {
        inheritedCall: Range.call
        up: inheritedCall(0, 3)
        down: inheritedCall(3, 0)
        Assertions.require((up.parent() === Range) && (up.start == 0) && (up.stop == 3))
        Assertions.require((down.parent() === InvertedRange) && (down.start == 3))
        invertedInheritedCall: InvertedRange.call
        Assertions.require(invertedInheritedCall(0, 3).parent() === Range)
        Assertions.signals(Error, () => { inheritedCall(0) })
    }),
    Test("range inherited construct delegates to Object.construct for noncanonical receivers", () => {
        DerivedRange: (Range) {
            init: (...args) => {
                this.mark: "derived-range"
                this.count: args.size()
            }
        }

        derived: DerivedRange(9, 1, 4)
        Assertions.require(derived.parent() === DerivedRange)
        Assertions.require(derived.mark == "derived-range")
        Assertions.require(derived.count == 3)
        Assertions.require(derived.hasSlot("start") === false)

        derivedEmpty: DerivedRange()
        Assertions.require((derivedEmpty.parent() === DerivedRange) && (derivedEmpty.count == 0))

        DerivedInverted: (InvertedRange) {
            init: (...args) => {
                this.mark: "derived-inverted"
                this.count: args.size()
            }
        }

        derivedInverted: DerivedInverted(1)
        Assertions.require(derivedInverted.parent() === DerivedInverted)
        Assertions.require(derivedInverted.mark == "derived-inverted")
        Assertions.require(derivedInverted.count == 1)
        Assertions.require(derivedInverted.hasSlot("stop") === false)

        // Two descending-order Integers still use the derived init.
        derivedPair: DerivedInverted(0, 5)
        Assertions.require((derivedPair.parent() === DerivedInverted) && (derivedPair.count == 2))
    }),
    Test("range derived local call keeps ordinary precedence", () => {
        Custom: (Range) {
            call: (...args) => {
                args.size() * 100
            }
        }

        Assertions.require(Custom(3, 0) == 200)
        Assertions.require(Custom() == 0)

        CustomInverted: (InvertedRange) {
            call: (...args) => {
                "custom"
            }
        }

        Assertions.require(CustomInverted(0, 3) == "custom")
    }),
    Test("range canonical call ignores lexical shadowing at the call site", () => {
        canonicalInverted: InvertedRange
        canonicalRange: Range

        (() => {
            InvertedRange: { marker: 1 }
            down: Range(5, 0)
            Assertions.require(down.parent() === canonicalInverted)
            Assertions.require(down.parent() !== InvertedRange)
            Assertions.require((down.start == 5) && (down.stop == 0))
        })()

        (() => {
            Range: { marker: 2 }
            up: canonicalInverted(0, 5)
            Assertions.require(up.parent() === canonicalRange)
            Assertions.require(up.parent() !== Range)
        })()
    }),
    Test("range traversal observes cancellation and runs ensure once", () => {
        visited: 0
        afterCancel: 0
        afterBoundary: 0
        cleanupRuns: 0

        future: (() => {
            dependency: Future.all().then((values) => 7)

            (() => {
                Range(0, 10).each((value) => {
                    visited = visited + 1

                    if(value == 0) {
                        future.cancel()
                        afterCancel = afterCancel + 1
                    }

                    (value == 0).ifFalse(() => {
                        dependency.value()
                        afterBoundary = afterBoundary + 1
                    })
                })
            }).ensure(() => {
                cleanupRuns = cleanupRuns + 1
            })
        }).future()

        observer: (() => {
            Error.handle(
                () => future.value(),
                (ignored) => null
            )

            (visited * 1000) +
            (afterCancel * 100) +
            (cleanupRuns * 10) +
            afterBoundary
        }).future()

        Assertions.require(observer.value() === 2110)
    }),
    Test("range prelude is visible inside a P worker", () => {
        total: (() => {
            sum: 0
            Range(0, 5).each((value) => { sum = sum + value })
            InvertedRange(5, 0).eachStep(-2, (value) => { sum = sum + value })
            sum
        }).parallel().value()
        Assertions.require(total == 19)

        copy: ((start, stop) => { Range(start, stop).reverse() }).parallel(2, 6).value()
        Assertions.require(copy.parent() === InvertedRange)
        Assertions.require((copy.start == 5) && (copy.stop == 1))

        down: ((start, stop) => { Range(start, stop) }).parallel(4, 1).value()
        Assertions.require(down.parent() === InvertedRange)
        Assertions.require((down.start == 4) && (down.stop == 1))

        up: ((start, stop) => { InvertedRange(start, stop) }).parallel(1, 4).value()
        Assertions.require(up.parent() === Range)
        Assertions.require((up.start == 1) && (up.stop == 4))
    })
)
tests.freeze()
