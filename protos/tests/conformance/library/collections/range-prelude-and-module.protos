// D235-B1-F: Range and InvertedRange are frozen Core Prelude prototypes, and
// std:collections/Range is a compatibility module exporting the same objects.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("range prelude bindings need no import", () => {
        Assertions.require(Range.parent() === Object)
        Assertions.require(InvertedRange.parent() === Object)
        Assertions.require(Range !== InvertedRange)
        Assertions.require(Range(0, 2).parent() === Range)
        Assertions.require(InvertedRange(2, 0).parent() === InvertedRange)

        names: Range.slotNames()
        Assertions.require((names.size() == 5) &&
            Range.hasSlot("init") &&
            Range.hasSlot("each") &&
            Range.hasSlot("eachStep") &&
            Range.hasSlot("invert") &&
            Range.hasSlot("reverse"))
        invertedNames: InvertedRange.slotNames()
        Assertions.require((invertedNames.size() == 5) &&
            InvertedRange.hasSlot("init") &&
            InvertedRange.hasSlot("each") &&
            InvertedRange.hasSlot("eachStep") &&
            InvertedRange.hasSlot("invert") &&
            InvertedRange.hasSlot("reverse"))
        Assertions.require(Range.hasSlot("call") === false)
        Assertions.require(InvertedRange.hasSlot("call") === false)
    }),
    Test("range canonical prototypes are frozen", () => {
        Assertions.signals(Error, () => { Range.extra: 1 })
        Assertions.signals(Error, () => { Range.each = null })
        Assertions.signals(Error, () => { Range.removeSlot("invert") })
        Assertions.signals(Error, () => { InvertedRange.extra: 1 })
        Assertions.signals(Error, () => { InvertedRange.eachStep = null })
        Assertions.signals(Error, () => { InvertedRange.removeSlot("reverse") })

        Assertions.require(Range.hasSlot("extra") === false)
        Assertions.require(InvertedRange.hasSlot("extra") === false)
        Assertions.require(Range(0, 1).parent() === Range)
    }),
    Test("range prelude shadowing and frozen binding assignment", () => {
        canonical: Range

        shadowed: (() => {
            Range: 7
            Range
        })()
        Assertions.require(shadowed == 7)
        Assertions.require(Range === canonical)

        Assertions.signals(Error, () => { Range = 7 })
        Assertions.signals(Error, () => { InvertedRange = 7 })
        Assertions.require(Range === canonical)
        Assertions.require(Range(0, 1).parent() === canonical)
    }),
    Test("range module exports the exact prelude identities", () => {
        Ranges: import("std:collections/Range")

        names: Ranges.slotNames()
        Assertions.require((names.size() == 2) &&
            Ranges.hasSlot("Range") &&
            Ranges.hasSlot("InvertedRange"))
        Assertions.require(Range === Ranges.Range)
        Assertions.require(InvertedRange === Ranges.InvertedRange)

        again: import("std:collections/Range")
        Assertions.require(again === Ranges)
        Assertions.require(again.Range === Range)

        Extracted: Ranges.Range
        Assertions.require(Extracted(0, 3).parent() === Range)
    }),
    Test("range module member rebinding leaves the canonical prototype", () => {
        Ranges: import("std:collections/Range")
        canonical: Range

        (() => {
            Ranges.Range = 7
            Assertions.require(Ranges.Range == 7)
            Assertions.require(import("std:collections/Range").Range == 7)
            Assertions.require(Range === canonical)
            Assertions.require(InvertedRange === Ranges.InvertedRange)
            Assertions.require(Range(0, 2).parent() === canonical)
            Assertions.require(Range(0, 2).reverse().invert().parent() === canonical)
        }).ensure(() => {
            Ranges.Range = canonical
        })

        Assertions.require(Ranges.Range === Range)
    }),
    Test("range traversal observes cancellation and runs ensure once", () => {
        visited: 0
        afterCancel: 0
        afterBoundary: 0
        cleanupRuns: 0

        future: (() => {
            dependency: Future.all().then((values) => 7)

            (() => {
                Range(0, 10).each((value) => {
                    visited = visited + 1

                    if(value == 0) {
                        future.cancel()
                        afterCancel = afterCancel + 1
                    }

                    (value == 0).ifFalse(() => {
                        dependency.value()
                        afterBoundary = afterBoundary + 1
                    })
                })
            }).ensure(() => {
                cleanupRuns = cleanupRuns + 1
            })
        }).future()

        observer: (() => {
            Error.handle(
                () => future.value(),
                (ignored) => null
            )

            (visited * 1000) +
            (afterCancel * 100) +
            (cleanupRuns * 10) +
            afterBoundary
        }).future()

        Assertions.require(observer.value() === 2110)
    }),
    Test("range prelude is visible inside a P worker", () => {
        total: (() => {
            sum: 0
            Range(0, 5).each((value) => { sum = sum + value })
            InvertedRange(5, 0).eachStep(-2, (value) => { sum = sum + value })
            sum
        }).parallel().value()
        Assertions.require(total == 19)

        copy: ((start, stop) => { Range(start, stop).reverse() }).parallel(2, 6).value()
        Assertions.require(copy.parent() === InvertedRange)
        Assertions.require((copy.start == 5) && (copy.stop == 1))
    })
)
tests.freeze()
