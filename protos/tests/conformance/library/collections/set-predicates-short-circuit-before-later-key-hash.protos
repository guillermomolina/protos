Set: import("std:collections/Set")

badHashCalls: 0
badKey: {
    hash: () => {
        badHashCalls = badHashCalls + 1
        97
    }
}

left: Set(1, badKey)
right: Set(1)
empty: Set()

badHashCalls = 0
sameMembers: Set.sameMembers(left, right)
subset: Set.isSubset(left, empty)
superset: Set.isSuperset(empty, left)
disjoint: Set.isDisjoint(left, right)

ok: true
sameMembers.ifTrue(() => { ok = false })
subset.ifTrue(() => { ok = false })
superset.ifTrue(() => { ok = false })
disjoint.ifTrue(() => { ok = false })
(badHashCalls == 0).ifFalse(() => { ok = false })
ok
