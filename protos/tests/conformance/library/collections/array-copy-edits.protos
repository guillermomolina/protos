Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// Answers `true` iff `array` holds exactly `expected` under element `==`.
sameElements: (array, ...expected) => {
    ok: array.size() == expected.size()
    if(ok) {
        index: 0
        while(index < expected.size()) {
            (array[index] == expected[index]).ifFalse(() => { ok = false })
            index = index + 1
        }
    }
    ok
}

huge: 100000000000000000000000000000000000000000

tests: Array(
    // append and concat
    Test("array append to empty and non-empty", () => {
        Arrays: import("std:collections/Array")
        empty: Array()
        source: Array(1, 2)
        fromEmpty: Arrays.append(empty, 9)
        appended: Arrays.append(source, 3)
        Assertions.require(sameElements(fromEmpty, 9))
        Assertions.require(sameElements(appended, 1, 2, 3))
        Assertions.require(sameElements(empty))
        Assertions.require(sameElements(source, 1, 2))
        Assertions.require((fromEmpty !== empty) && (appended !== source))
    }),
    Test("array append keeps an Array as one element", () => {
        Arrays: import("std:collections/Array")
        inner: Array(2, 3)
        appended: Arrays.append(Array(1), inner)
        Assertions.require(appended.size() == 2)
        Assertions.require(appended[1] === inner)
    }),
    Test("array concat two arrays", () => {
        Arrays: import("std:collections/Array")
        left: Array(1, 2)
        right: Array(3, 4)
        combined: Arrays.concat(left, right)
        Assertions.require(sameElements(combined, 1, 2, 3, 4))
        Assertions.require(sameElements(left, 1, 2))
        Assertions.require(sameElements(right, 3, 4))
    }),
    Test("array concat with empty operands", () => {
        Arrays: import("std:collections/Array")
        empty: Array()
        source: Array(1)
        leftEmpty: Arrays.concat(empty, source)
        rightEmpty: Arrays.concat(source, empty)
        bothEmpty: Arrays.concat(empty, empty)
        Assertions.require(sameElements(leftEmpty, 1) && sameElements(rightEmpty, 1))
        Assertions.require(sameElements(bothEmpty))
        Assertions.require((leftEmpty !== source) && (rightEmpty !== source))
        Assertions.require(bothEmpty !== empty)
    }),
    Test("array concat same operand duplicates sequence", () => {
        Arrays: import("std:collections/Array")
        marker: Array(0)
        source: Array(marker, 1)
        doubled: Arrays.concat(source, source)
        Assertions.require(doubled.size() == 4)
        Assertions.require((doubled[0] === marker) && (doubled[2] === marker))
        Assertions.require((doubled[1] == 1) && (doubled[3] == 1))
        doubled[0] = 5
        Assertions.require(source[0] === marker)
        Assertions.require(doubled[2] === marker)
    }),
    Test("array append and concat answer independent storage", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2)
        appended: Arrays.append(source, 3)
        combined: Arrays.concat(source, Array())
        appended[0] = 10
        combined[1] = 20
        source[0] = 30
        Assertions.require(sameElements(appended, 10, 2, 3))
        Assertions.require(sameElements(combined, 1, 20))
        Assertions.require(sameElements(source, 30, 2))
    }),

    // slice
    Test("array slice full range answers fresh array", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        full: Arrays.slice(source, 0, 3)
        Assertions.require(sameElements(full, 1, 2, 3))
        Assertions.require(full !== source)
        full[0] = 9
        Assertions.require(source[0] == 1)
    }),
    Test("array slice empty ranges", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        atStart: Arrays.slice(source, 0, 0)
        inMiddle: Arrays.slice(source, 1, 1)
        atEnd: Arrays.slice(source, 3, 3)
        Assertions.require(sameElements(atStart) && sameElements(inMiddle))
        Assertions.require(sameElements(atEnd))
        Assertions.require((atStart !== inMiddle) && (inMiddle !== atEnd))
        Assertions.require(atStart !== source)
    }),
    Test("array slice first last and interior", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3, 4, 5)
        Assertions.require(sameElements(Arrays.slice(source, 0, 1), 1))
        Assertions.require(sameElements(Arrays.slice(source, 4, 5), 5))
        Assertions.require(sameElements(Arrays.slice(source, 1, 4), 2, 3, 4))
        Assertions.require(sameElements(source, 1, 2, 3, 4, 5))
    }),
    Test("array slice of empty array", () => {
        Arrays: import("std:collections/Array")
        source: Array()
        sliced: Arrays.slice(source, 0, 0)
        Assertions.require(sameElements(sliced))
        Assertions.require(sliced !== source)
        Assertions.signals(Error, () => { Arrays.slice(source, 0, 1) })
    }),
    Test("array slice rejects inverted and out of range bounds", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        Assertions.signals(Error, () => { Arrays.slice(source, 2, 1) })
        Assertions.signals(Error, () => { Arrays.slice(source, -1, 2) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0, -1) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0, 4) })
        Assertions.signals(Error, () => { Arrays.slice(source, 4, 4) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0, huge) })
        Assertions.signals(Error, () => { Arrays.slice(source, huge, huge) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0 - huge, 1) })
    }),
    Test("array slice rejects non-Integer bounds", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        Assertions.signals(Error, () => { Arrays.slice(source, 0.0, 1) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0, 1.0) })
        Assertions.signals(Error, () => { Arrays.slice(source, null, 1) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0, null) })
        ordinary: {}
        Assertions.signals(Error, () => { Arrays.slice(source, "0", 1) })
        Assertions.signals(Error, () => { Arrays.slice(source, ordinary, 1) })
        Assertions.signals(Error, () => { Arrays.slice(source, 0) })
    }),

    // insertAt
    Test("array insertAt start middle and end", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        Assertions.require(sameElements(Arrays.insertAt(source, 0, 0), 0, 1, 2, 3))
        Assertions.require(sameElements(Arrays.insertAt(source, 1, 9), 1, 9, 2, 3))
        Assertions.require(sameElements(Arrays.insertAt(source, 3, 4), 1, 2, 3, 4))
        Assertions.require(sameElements(source, 1, 2, 3))
    }),
    Test("array insertAt into empty array", () => {
        Arrays: import("std:collections/Array")
        source: Array()
        inserted: Arrays.insertAt(source, 0, 7)
        Assertions.require(sameElements(inserted, 7))
        Assertions.require(sameElements(source))
    }),
    Test("array insertAt keeps an Array as one element", () => {
        Arrays: import("std:collections/Array")
        inner: Array(8, 9)
        inserted: Arrays.insertAt(Array(1, 2), 1, inner)
        Assertions.require(inserted.size() == 3)
        Assertions.require((inserted[0] == 1) && (inserted[2] == 2))
        Assertions.require(inserted[1] === inner)
    }),
    Test("array insertAt preserves suffix order", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3, 4, 5, 6)
        inserted: Arrays.insertAt(source, 2, 0)
        Assertions.require(sameElements(inserted, 1, 2, 0, 3, 4, 5, 6))
        Assertions.require(sameElements(source, 1, 2, 3, 4, 5, 6))
    }),
    Test("array insertAt rejects invalid indexes", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2)
        Assertions.signals(Error, () => { Arrays.insertAt(source, -1, 0) })
        Assertions.signals(Error, () => { Arrays.insertAt(source, 3, 0) })
        Assertions.signals(Error, () => { Arrays.insertAt(source, 1.0, 0) })
        Assertions.signals(Error, () => { Arrays.insertAt(source, huge, 0) })
        Assertions.signals(Error, () => { Arrays.insertAt(source, 0 - huge, 0) })
        Assertions.signals(Error, () => { Arrays.insertAt(source, null, 0) })
        Assertions.require(sameElements(source, 1, 2))
    }),

    // removeAt
    Test("array removeAt first middle and last", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        Assertions.require(sameElements(Arrays.removeAt(source, 0), 2, 3))
        Assertions.require(sameElements(Arrays.removeAt(source, 1), 1, 3))
        Assertions.require(sameElements(Arrays.removeAt(source, 2), 1, 2))
        Assertions.require(sameElements(source, 1, 2, 3))
    }),
    Test("array removeAt only element", () => {
        Arrays: import("std:collections/Array")
        source: Array(1)
        removed: Arrays.removeAt(source, 0)
        Assertions.require(sameElements(removed))
        Assertions.require(sameElements(source, 1))
    }),
    Test("array removeAt rejects invalid indexes", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2)
        Assertions.signals(Error, () => { Arrays.removeAt(Array(), 0) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, 2) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, -1) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, 0.0) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, huge) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, 0 - huge) })
        Assertions.signals(Error, () => { Arrays.removeAt(source, null) })
        Assertions.require(sameElements(source, 1, 2))
    }),
    Test("array removeAt keeps order and identity of remaining elements", () => {
        Arrays: import("std:collections/Array")
        a: Array(1)
        b: Array(2)
        c: Array(3)
        d: Array(4)
        removed: Arrays.removeAt(Array(a, b, c, d), 1)
        Assertions.require(removed.size() == 3)
        Assertions.require(((removed[0] === a) && (removed[1] === c)) && (removed[2] === d))
    }),

    // reverse
    Test("array reverse empty and singleton", () => {
        Arrays: import("std:collections/Array")
        empty: Array()
        singleton: Array(1)
        reversedEmpty: Arrays.reverse(empty)
        reversedSingleton: Arrays.reverse(singleton)
        Assertions.require(sameElements(reversedEmpty))
        Assertions.require(sameElements(reversedSingleton, 1))
        Assertions.require((reversedEmpty !== empty) && (reversedSingleton !== singleton))
    }),
    Test("array reverse even and odd lengths", () => {
        Arrays: import("std:collections/Array")
        even: Array(1, 2, 3, 4)
        odd: Array(1, 2, 3, 4, 5)
        Assertions.require(sameElements(Arrays.reverse(even), 4, 3, 2, 1))
        Assertions.require(sameElements(Arrays.reverse(odd), 5, 4, 3, 2, 1))
        Assertions.require(sameElements(even, 1, 2, 3, 4))
        Assertions.require(sameElements(odd, 1, 2, 3, 4, 5))
    }),
    Test("array reverse preserves nested references", () => {
        Arrays: import("std:collections/Array")
        first: Array(1)
        second: Array(2)
        source: Array(first, second)
        reversed: Arrays.reverse(source)
        Assertions.require(reversed !== source)
        Assertions.require((reversed[0] === second) && (reversed[1] === first))
        Assertions.require((source[0] === first) && (source[1] === second))
    }),

    // cross-cutting contracts
    Test("array copy edits answer recognized open arrays", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        results: Array(
            Arrays.append(source, 4),
            Arrays.concat(source, source),
            Arrays.slice(source, 0, 2),
            Arrays.insertAt(source, 0, 0),
            Arrays.removeAt(source, 0),
            Arrays.reverse(source)
        )
        results.each((result) => {
            Assertions.require(Array.recognizes(result))
            Assertions.require(result !== source)
            result.lib023Probe: 23
            Assertions.require(result.lib023Probe == 23)
        })
        Assertions.require(sameElements(source, 1, 2, 3))
    }),
    Test("array copy edits read closed and frozen sources", () => {
        Arrays: import("std:collections/Array")
        closed: Array(1, 2, 3)
        closed.close()
        frozen: Array(1, 2, 3)
        frozen.freeze()
        Array(closed, frozen).each((source) => {
            results: Array(
                Arrays.append(source, 4),
                Arrays.concat(source, source),
                Arrays.slice(source, 0, 2),
                Arrays.insertAt(source, 0, 0),
                Arrays.removeAt(source, 0),
                Arrays.reverse(source)
            )
            results.each((result) => {
                result[0] = 42
                Assertions.require(result[0] == 42)
                result.lib023Probe: 23
                Assertions.require(result.lib023Probe == 23)
            })
            Assertions.require(sameElements(source, 1, 2, 3))
        })
        null
    }),
    Test("array copy edits are shallow", () => {
        Arrays: import("std:collections/Array")
        nested: Array(1)
        source: Array(nested, 2)
        appended: Arrays.append(source, 3)
        sliced: Arrays.slice(source, 0, 1)
        reversed: Arrays.reverse(source)
        nested[0] = 99
        Assertions.require((appended[0] === nested) && (sliced[0] === nested))
        Assertions.require(reversed[1] === nested)
        Assertions.require(appended[0][0] == 99)
    }),
    Test("array copy edits keep self references to the source", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, null)
        source[1] = source
        appended: Arrays.append(source, 3)
        combined: Arrays.concat(source, Array())
        sliced: Arrays.slice(source, 1, 2)
        inserted: Arrays.insertAt(source, 0, 0)
        removed: Arrays.removeAt(source, 0)
        reversed: Arrays.reverse(source)
        Assertions.require((appended[1] === source) && (combined[1] === source))
        Assertions.require((sliced[0] === source) && (inserted[2] === source))
        Assertions.require((removed[0] === source) && (reversed[0] === source))
        Assertions.require(reversed[0] !== reversed)
    }),
    Test("array copy edits accept descendant factory arrays", () => {
        Arrays: import("std:collections/Array")
        MyArray: Array {
            label: 9
        }
        source: MyArray(1, 2, 3)
        Assertions.require(sameElements(Arrays.append(source, 4), 1, 2, 3, 4))
        Assertions.require(sameElements(Arrays.concat(source, source), 1, 2, 3, 1, 2, 3))
        Assertions.require(sameElements(Arrays.slice(source, 1, 3), 2, 3))
        Assertions.require(sameElements(Arrays.insertAt(source, 1, 0), 1, 0, 2, 3))
        Assertions.require(sameElements(Arrays.removeAt(source, 1), 1, 3))
        Assertions.require(sameElements(Arrays.reverse(source), 3, 2, 1))
    }),
    Test("array copy edits reject non-Array sources", () => {
        Arrays: import("std:collections/Array")
        lookalike: Array {}
        imitation: {
            size: () => 1
            at: (index) => 1
            each: (callback) => { callback(1) }
        }
        Array(lookalike, imitation, Array, null, "abc", 1).each((candidate) => {
            Assertions.signals(Error, () => { Arrays.append(candidate, 1) })
            Assertions.signals(Error, () => { Arrays.concat(candidate, Array()) })
            Assertions.signals(Error, () => { Arrays.concat(Array(), candidate) })
            Assertions.signals(Error, () => { Arrays.slice(candidate, 0, 0) })
            Assertions.signals(Error, () => { Arrays.insertAt(candidate, 0, 1) })
            Assertions.signals(Error, () => { Arrays.removeAt(candidate, 0) })
            Assertions.signals(Error, () => { Arrays.reverse(candidate) })
        })
        null
    }),
    Test("array copy edits ignore overridden size at and each", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2, 3)
        source.size: () => 99
        source.at: (index) => 99
        source.each: (callback) => { null }
        Assertions.require(Array.recognizes(source))
        appended: Arrays.append(source, 4)
        Assertions.require(appended.size() == 4)
        Assertions.require((appended[0] == 1) && (appended[3] == 4))
        sliced: Arrays.slice(source, 1, 3)
        Assertions.require((sliced.size() == 2) && ((sliced[0] == 2) && (sliced[1] == 3)))
        Assertions.signals(Error, () => { Arrays.slice(source, 0, 4) })
        inserted: Arrays.insertAt(source, 3, 4)
        Assertions.require((inserted.size() == 4) && (inserted[3] == 4))
        Assertions.signals(Error, () => { Arrays.insertAt(source, 4, 0) })
        removed: Arrays.removeAt(source, 2)
        Assertions.require((removed.size() == 2) && ((removed[0] == 1) && (removed[1] == 2)))
        Assertions.signals(Error, () => { Arrays.removeAt(source, 3) })
        reversed: Arrays.reverse(source)
        Assertions.require((reversed.size() == 3) && ((reversed[0] == 3) && (reversed[2] == 1)))
        combined: Arrays.concat(source, source)
        Assertions.require((combined.size() == 6) && (combined[5] == 3))
    }),
    Test("array copy edits ignore excess arguments", () => {
        Arrays: import("std:collections/Array")
        source: Array(1, 2)
        Assertions.require(sameElements(Arrays.append(source, 3, 4), 1, 2, 3))
        Assertions.require(sameElements(Arrays.concat(source, Array(3), Array(4)), 1, 2, 3))
        Assertions.require(sameElements(Arrays.slice(source, 0, 1, 2), 1))
        Assertions.require(sameElements(Arrays.insertAt(source, 0, 0, 9), 0, 1, 2))
        Assertions.require(sameElements(Arrays.removeAt(source, 0, 1), 2))
        Assertions.require(sameElements(Arrays.reverse(source, 0), 2, 1))
    })
)
tests.freeze()
