Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: Array(
    Test("lib001 surfaces compose", () => {
        tool009LegacyCase: () => {
            Arrays: import("std:collections/array")
            Set: import("std:collections/set")
            IdentitySet: import("std:collections/identity_set")

            mixed: Array(3, 1, 2, 2.0)
            sorted: Arrays.sort(mixed, (left, right) => {
                left < right
            })
            normalSet: Set(...sorted)
            identitySet: IdentitySet(...sorted)

            integers: Array(3, 1, 2, 2)
            total: Arrays.reduce(
                integers,
                (accumulator, element) => {
                    accumulator + element
                },
                0
            )

            ok: true
            (Set.size(normalSet) == 3).ifFalse(() => { ok = false })
            (IdentitySet.size(identitySet) == 4).ifFalse(() => { ok = false })
            (total == 8).ifFalse(() => { ok = false })
            Set.contains(normalSet, 2.0).ifFalse(() => { ok = false })
            IdentitySet.contains(identitySet, 2).ifFalse(() => { ok = false })
            IdentitySet.contains(identitySet, 2.0).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("lib023 array copy/edit public surface", () => {
        Arrays: import("std:collections/array")
        source: Array(3, 1, 2)

        appended: Arrays.append(source, 4)
        combined: Arrays.concat(source, Array(5))
        sliced: Arrays.slice(source, 1, 3)
        inserted: Arrays.insertAt(source, 1, 0)
        removed: Arrays.removeAt(source, 0)
        reversed: Arrays.reverse(source)
        sorted: Arrays.sort(source)

        Assertions.require((appended.size() == 4) && (appended[3] == 4))
        Assertions.require((combined.size() == 4) && (combined[3] == 5))
        Assertions.require((sliced.size() == 2) && ((sliced[0] == 1) && (sliced[1] == 2)))
        Assertions.require((inserted.size() == 4) && (inserted[1] == 0))
        Assertions.require((removed.size() == 2) && (removed[0] == 1))
        Assertions.require((reversed.size() == 3) && (reversed[0] == 2))
        Assertions.require(((sorted[0] == 1) && (sorted[1] == 2)) && (sorted[2] == 3))
        Assertions.require(((source[0] == 3) && (source[1] == 1)) && (source[2] == 2))
        Assertions.require(import("std:collections/array") === Arrays)
    }),
    Test("d242 lowercase module routes resolve", () => {
        Assertions.require(import("std:collections/identity_set") !== null)
        Assertions.require(import("std:collections/set") !== null)
        null
    }),
    Test("obsolete uppercase identity set import error", () => {
        Assertions.signals(Error, () => {
            import("std:collections/IdentitySet")
        })
    }),
    Test("obsolete uppercase set import error", () => {
        Assertions.signals(Error, () => {
            import("std:collections/Set")
        })
    }),
    Test("obsolete file-backed array route import error", () => {
        Assertions.signals(Error, () => {
            import("std:collections/Array")
        })
    }),
    Test("module initializer is not a direct source alias", () => {
        Assertions.signals(Error, () => {
            import("std:collections/set/module")
        })
    }),
    Test("standard library import cache", () => {
        tool009LegacyCase: () => {
            first: import("std:collections/set")
            second: import("std:collections/set")
            first === second
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("i136 range module public surface", () => {
        Ranges: import("std:collections/range")

        Assertions.require(Ranges.hasSlot("Range"))
        Assertions.require(Ranges.hasSlot("InvertedRange"))
        Assertions.require(Ranges.hasSlot("each") === false)
        Assertions.require(Ranges.hasSlot("reverseEach") === false)

        Range: Ranges.Range
        InvertedRange: Ranges.InvertedRange

        Assertions.require(Range === Ranges.slotValue("Range"))
        Assertions.require(InvertedRange === Ranges.slotValue("InvertedRange"))
        Assertions.require(Range !== InvertedRange)
        Assertions.require(Range.parent() === Object)
        Assertions.require(InvertedRange.parent() === Object)

        Assertions.require(Range(0, 2).parent() === Range)
        Assertions.require(InvertedRange(2, 0).parent() === InvertedRange)

        again: import("std:collections/range")
        Assertions.require(again === Ranges)
        Assertions.require(again.Range === Range)
        Assertions.require(again.InvertedRange === InvertedRange)
    })
)
tests.freeze()
