// D160: parallel Array algorithms are Standard Library policy over the
// retained minimal isolated-parallel substrate, not Core Array selectors.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("array parallel algorithms are module functions", () => {
        Arrays: import("std:collections/Array")
        Assertions.require(Arrays.hasSlot("parallelMap"))
        Assertions.require(Arrays.hasSlot("parallelFilter"))
        Assertions.require(Arrays.hasSlot("parallelFindIndex"))
        Assertions.require(Arrays.hasSlot("parallelReduce"))
        Assertions.require(Arrays.hasSlot("parallelSort"))
        Assertions.require(!Arrays.hasSlot("parallelEach"))
    }),
    Test("core array has no parallel algorithm selectors", () => {
        identity: (value) => { value }
        less: (left, right) => { left < right }
        Assertions.signals(SlotNotFound, () => { Array(1).parallelMap(identity) })
        Assertions.signals(SlotNotFound, () => { Array(1).parallelFilter(identity) })
        Assertions.signals(SlotNotFound, () => { Array(1).parallelFindIndex(identity) })
        Assertions.signals(SlotNotFound, () => { Array(1).parallelReduce(less) })
        Assertions.signals(SlotNotFound, () => { Array(1).parallelSort(less) })
        Assertions.signals(SlotNotFound, () => { Array(1).parallelEach(identity) })
    }),
    Test("retained parallel substrate works without the Array module", () => {
        single: ((value, offset) => { value + offset }).parallel(41, 1)
        both: Future.all(
            ((value) => { value * 2 }).parallel(5),
            (() => { 7 }).future()
        ).value()
        Assertions.require(single.value() == 42)
        Assertions.require(both.size() == 2)
        Assertions.require(both[0] == 10)
        Assertions.require(both[1] == 7)
    })
)
tests.freeze()
