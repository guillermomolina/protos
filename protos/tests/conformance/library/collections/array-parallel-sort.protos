Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Arrays: import("std:collections/Array")

sameElements: (actual, expected) => {
    ok: actual.size() == expected.size()
    ok.ifTrue(() => {
        index: 0
        expected.each((element) => {
            (actual[index] == element).ifFalse(() => { ok = false })
            index = index + 1
        })
    })
    ok
}

tests: Array(
    Test("array parallel sort orders without mutating the source", () => {
        source: Array(3, 1, 4, 1, 5, 9, 2, 6)
        sorted: Arrays.parallelSort(source, (left, right) => { left < right }).value()
        Assertions.require(sameElements(sorted, Array(1, 1, 2, 3, 4, 5, 6, 9)))
        Assertions.require(sameElements(source, Array(3, 1, 4, 1, 5, 9, 2, 6)))
    }),
    Test("array parallel sort empty and singleton", () => {
        empty: Arrays.parallelSort(Array(), (left, right) => { 1 }).value()
        single: Arrays.parallelSort(Array(4), (left, right) => { 1 }).value()
        Assertions.require(sameElements(empty, Array()))
        Assertions.require(sameElements(single, Array(4)))
    }),
    Test("array parallel sort is stable", () => {
        sorted: Arrays.parallelSort(
            Array(Array(2, "a"), Array(1, "b"), Array(2, "c"), Array(1, "d")),
            (left, right) => { left[0] < right[0] }
        ).value()
        tags: Arrays.map(sorted, (entry) => { entry[1] })
        Assertions.require(sameElements(tags, Array("b", "d", "a", "c")))
    }),
    Test("array parallel sort passes explicit arguments", () => {
        sorted: Arrays.parallelSort(Array(1, 3, 2), (left, right, sign) => {
            left * sign < right * sign
        }, -1).value()
        Assertions.require(sameElements(sorted, Array(3, 2, 1)))
    }),
    Test("array parallel sort invalid comparator result", () => {
        Assertions.signals(InvalidComparatorResult, () => {
            Arrays.parallelSort(Array(1, 2), (left, right) => { 1 }).value()
        })
    }),
    Test("array parallel sort invalid comparator order", () => {
        Assertions.signals(InvalidComparatorOrder, () => {
            Arrays.parallelSort(Array(1, 2), (left, right) => { true }).value()
        })
    }),
    Test("array parallel sort snapshots input at call", () => {
        source: Array(2, 1)
        future: Arrays.parallelSort(source, (left, right) => { left < right })
        source[0] = 99
        Assertions.require(sameElements(future.value(), Array(1, 2)))
    })
)
tests.freeze()
