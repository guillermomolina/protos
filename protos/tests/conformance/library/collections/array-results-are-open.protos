Arrays: import("std:collections/Array")

mapped: Arrays.map(Array(1), (element) => {
    element
})
filtered: Arrays.filter(Array(1), (element) => {
    true
})
sorted: Arrays.sort(Array(2, 1), (left, right) => {
    left < right
})

mapped.lib001Probe: 1
filtered.lib001Probe: 2
sorted.lib001Probe: 3

((mapped.lib001Probe == 1) && (filtered.lib001Probe == 2)) &&
    (sorted.lib001Probe == 3)
