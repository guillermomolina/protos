Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("range bound domain rejection", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")
            Assertions: import("std:test/Assertions")

            callback: (value) => { null }
            delegatedIntegerLookalike: (1) {}

            Assertions.signals(Error, () => {
                Ranges.each(1.0, 3, callback)
            })
            Assertions.signals(Error, () => {
                Ranges.each(1, 3.0, callback)
            })
            Assertions.signals(Error, () => {
                Ranges.each(delegatedIntegerLookalike, 3, callback)
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range bounds evaluated once", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            startCalls: 0
            stopCalls: 0

            start: () => {
                startCalls = startCalls + 1
                2
            }

            stop: () => {
                stopCalls = stopCalls + 1
                5
            }

            forward: 0
            Ranges.each(start(), stop(), (value) => {
                forward = forward * 10 + value
            })

            reverse: 0
            Ranges.reverseEach(start(), stop(), (value) => {
                reverse = reverse * 10 + value
            })

            (startCalls == 2) &&
                (stopCalls == 2) &&
                (forward == 234) &&
                (reverse == 432)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range order and return", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            forward: 0
            forwardResult: Ranges.each(2, 5, (value) => {
                forward = forward * 10 + value
                999
            })

            reverse: 0
            reverseResult: Ranges.reverseEach(2, 5, (value) => {
                reverse = reverse * 10 + value
                999
            })

            (forwardResult === null) &&
                (reverseResult === null) &&
                (forward == 234) &&
                (reverse == 432)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range unbounded integer endpoints", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            base: 10000000000000000000000000000000000000000

            forwardCount: 0
            forwardFirst: null
            forwardLast: null

            Ranges.each(base, base + 3, (value) => {
                (forwardCount == 0).ifTrue(() => {
                    forwardFirst = value
                })
                forwardLast = value
                forwardCount = forwardCount + 1
            })

            reverseCount: 0
            reverseFirst: null
            reverseLast: null

            Ranges.reverseEach(base, base + 3, (value) => {
                (reverseCount == 0).ifTrue(() => {
                    reverseFirst = value
                })
                reverseLast = value
                reverseCount = reverseCount + 1
            })

            (forwardCount == 3) &&
                (forwardFirst == base) &&
                (forwardLast == base + 2) &&
                (reverseCount == 3) &&
                (reverseFirst == base + 2) &&
                (reverseLast == base)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range polymorphic callable", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            observed: 0

            callback: {
                call: (value) => {
                    observed = observed * 10 + value
                    999
                }
            }

            forwardResult: Ranges.each(1, 4, callback)
            reverseResult: Ranges.reverseEach(1, 4, callback)

            (forwardResult === null) &&
                (reverseResult === null) &&
                (observed == 123321)
        }
        Assertions.require(tool009LegacyCase())
    })
)
tests.freeze()
