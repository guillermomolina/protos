Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("range unbounded integer endpoints", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            base: 10000000000000000000000000000000000000000

            forwardCount: 0
            forwardFirst: null
            forwardLast: null

            Ranges.each(base, base + 3, (value) => {
                (forwardCount == 0).ifTrue(() => {
                    forwardFirst = value
                })
                forwardLast = value
                forwardCount = forwardCount + 1
            })

            reverseCount: 0
            reverseFirst: null
            reverseLast: null

            Ranges.reverseEach(base, base + 3, (value) => {
                (reverseCount == 0).ifTrue(() => {
                    reverseFirst = value
                })
                reverseLast = value
                reverseCount = reverseCount + 1
            })

            (forwardCount == 3) &&
                (forwardFirst == base) &&
                (forwardLast == base + 2) &&
                (reverseCount == 3) &&
                (reverseFirst == base + 2) &&
                (reverseLast == base)
        }
        Assertions.require(tool009LegacyCase())
    })
)
tests.freeze()
