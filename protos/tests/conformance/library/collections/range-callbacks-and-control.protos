Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("range callback argument contract", () => {
        calls: 0

        probe: (value, ...rest) => {
            Assertions.require(rest.size() == 0)
            Assertions.require(Integer.recognizes(value))
            calls = calls + 1
        }

        Range(2, 5).each(probe)
        InvertedRange(5, 2).each(probe)
        Range(2, 5).eachStep(2, probe)
        InvertedRange(5, 2).eachStep(-2, probe)

        Assertions.require(calls == 10)
    }),
    Test("range callback result ignored and null returned", () => {
        trace: 0
        callback: (value) => {
            trace = trace * 10 + value
            999
        }

        Assertions.require(Range(2, 5).each(callback) === null)
        Assertions.require(InvertedRange(5, 2).each(callback) === null)
        Assertions.require(Range(1, 5).eachStep(3, callback) === null)
        Assertions.require(InvertedRange(5, 1).eachStep(-3, callback) === null)
        Assertions.require(trace == 2345431452)
    }),
    Test("range callback error propagation", () => {
        exact: (run) => {
            failure: Error()
            Error.handle(
                () => {
                    run((value) => {
                        if(value == 2) {
                            failure.signal()
                        }
                        null
                    })
                    false
                },
                (caught) => {
                    caught === failure
                }
            )
        }

        Assertions.require(exact((block) => { Range(1, 4).each(block) }))
        Assertions.require(exact((block) => { InvertedRange(4, 1).each(block) }))
        Assertions.require(exact((block) => { Range(0, 4).eachStep(2, block) }))
        Assertions.require(exact((block) => { InvertedRange(4, 0).eachStep(-2, block) }))
        Assertions.require(exact((block) => { Range(4, 1).each(block) }))
        Assertions.require(exact((block) => { InvertedRange(1, 4).each(block) }))
    }),
    Test("range nonlocal return propagation", () => {
        forwardProbe: () => {
            Range(1, 6).each((value) => {
                if(value == 3) {
                    ^value
                }
            })
            99
        }

        reverseProbe: () => {
            InvertedRange(6, 1).each((value) => {
                if(value == 3) {
                    ^value
                }
            })
            99
        }

        forwardStepProbe: () => {
            Range(1, 10).eachStep(2, (value) => {
                if(value == 5) {
                    ^value
                }
            })
            99
        }

        reverseStepProbe: () => {
            InvertedRange(10, 0).eachStep(-3, (value) => {
                if(value == 4) {
                    ^value
                }
            })
            99
        }

        normalizedProbe: () => {
            Range(6, 1).each((value) => {
                if(value == 3) {
                    ^value
                }
            })
            99
        }

        normalizedStepProbe: () => {
            InvertedRange(1, 10).eachStep(2, (value) => {
                if(value == 5) {
                    ^value
                }
            })
            99
        }

        Assertions.require(normalizedProbe() == 3)
        Assertions.require(normalizedStepProbe() == 5)
        Assertions.require(forwardProbe() == 3)
        Assertions.require(reverseProbe() == 3)
        Assertions.require(forwardStepProbe() == 5)
        Assertions.require(reverseStepProbe() == 4)
    }),
    Test("range ensure cleanup under error and nonlocal return", () => {
        cleanups: 0
        visited: 0

        returnProbe: () => {
            (() => {
                InvertedRange(5, 0).each((value) => {
                    visited = visited + 1
                    (() => {
                        if(value == 3) {
                            ^value
                        }
                    }).ensure(() => {
                        cleanups = cleanups + 1
                    })
                })
                99
            }).ensure(() => {
                cleanups = cleanups + 10
            })
        }

        Assertions.require(returnProbe() == 3)
        Assertions.require(visited == 3)
        Assertions.require(cleanups == 13)

        failure: Error()
        errorCleanups: 0
        caughtExact: Error.handle(
            () => {
                (() => {
                    Range(0, 5).eachStep(2, (value) => {
                        (() => {
                            if(value == 2) {
                                failure.signal()
                            }
                        }).ensure(() => {
                            errorCleanups = errorCleanups + 1
                        })
                    })
                    false
                }).ensure(() => {
                    errorCleanups = errorCleanups + 10
                })
            },
            (caught) => {
                caught === failure
            }
        )

        Assertions.require(caughtExact)
        Assertions.require(errorCleanups == 12)

        // A normalized descending instance from Range keeps the same counts.
        normalizedCleanups: 0
        normalizedVisited: 0

        normalizedReturnProbe: () => {
            (() => {
                Range(5, 0).each((value) => {
                    normalizedVisited = normalizedVisited + 1
                    (() => {
                        if(value == 3) {
                            ^value
                        }
                    }).ensure(() => {
                        normalizedCleanups = normalizedCleanups + 1
                    })
                })
                99
            }).ensure(() => {
                normalizedCleanups = normalizedCleanups + 10
            })
        }

        Assertions.require(normalizedReturnProbe() == 3)
        Assertions.require(normalizedVisited == 3)
        Assertions.require(normalizedCleanups == 13)
    }),
    Test("range empty does not inspect callback", () => {
        Assertions.require(Range(4, 4).each(42) === null)
        Assertions.require(InvertedRange(4, 4).each(42) === null)
        Assertions.require(Range(4, 4).eachStep(3, 42) === null)
        Assertions.require(InvertedRange(4, 4).eachStep(-3, 42) === null)
        Assertions.require(Range(-1, -1).each(null) === null)
    }),
    Test("range normalized direction retains reached callback validation", () => {
        down: Range(5, 2)
        up: InvertedRange(2, 5)

        Assertions.require((down.parent() === InvertedRange) && (down.start == 5) && (down.stop == 2))
        Assertions.require((up.parent() === Range) && (up.start == 2) && (up.stop == 5))

        // These ranges are nonempty, so iteration reaches the noninvokable callback.
        Assertions.signals(Error, () => { down.each(42) })
        Assertions.signals(Error, () => { up.each(42) })

        // Unlike an empty traversal, which never inspects the callback.
        Assertions.require(Range(5, 5).each(42) === null)
        Assertions.require(InvertedRange(2, 2).each(42) === null)
    }),
    Test("range reached noninvokable callback rejection", () => {
        Assertions.signals(Error, () => { Range(1, 2).each(42) })
        Assertions.signals(Error, () => { InvertedRange(2, 1).each(42) })
        Assertions.signals(Error, () => { Range(1, 2).eachStep(5, 42) })
        Assertions.signals(Error, () => { InvertedRange(2, 1).eachStep(-5, 42) })
    }),
    Test("range polymorphic callable objects", () => {
        observed: 0
        callback: {
            call: (value, ...rest) => {
                Assertions.require(rest.size() == 0)
                observed = observed * 10 + value
                999
            }
        }

        Assertions.require(Range(1, 4).each(callback) === null)
        Assertions.require(InvertedRange(3, 0).eachStep(-2, callback) === null)
        Assertions.require(observed == 12331)
    })
)
tests.freeze()
