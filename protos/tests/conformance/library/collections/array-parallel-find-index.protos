Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Arrays: import("std:collections/Array")

tests: Array(
    Test("array parallel find index lowest match", () => {
        found: Arrays.parallelFindIndex(Array(1, 2, 3, 2), (value) => {
            value.mod(2) == 0
        }).value()
        Assertions.require(found == 1)
    }),
    Test("array parallel find index absence, empty and null elements", () => {
        missing: Arrays.parallelFindIndex(Array(1, 3), (value) => {
            value > 100
        }).value()
        empty: Arrays.parallelFindIndex(Array(), (value) => { true }).value()
        nullAt: Arrays.parallelFindIndex(Array(1, null), (value) => {
            value === null
        }).value()
        Assertions.require(missing === null)
        Assertions.require(empty === null)
        Assertions.require(nullAt == 1)
    }),
    Test("array parallel find index passes explicit arguments", () => {
        found: Arrays.parallelFindIndex(Array(4, 8, 15), (value, target) => {
            value == target
        }, 15).value()
        Assertions.require(found == 2)
    }),
    Test("array parallel find index lower failure defeats later match", () => {
        Assertions.signals(SlotNotFound, () => {
            Arrays.parallelFindIndex(Array(0, 1, 2), (value) => {
                (value == 1).ifTrue(() => { SlotNotFound().signal() })
                value == 2
            }).value()
        })
    }),
    Test("array parallel find index later failure is irrelevant after match", () => {
        found: Arrays.parallelFindIndex(Array(0, 1, 2), (value) => {
            (value == 2).ifTrue(() => { SlotNotFound().signal() })
            value == 1
        }).value()
        Assertions.require(found == 1)
    }),
    Test("array parallel find index invalid predicate result", () => {
        Assertions.signals(InvalidPredicateResult, () => {
            Arrays.parallelFindIndex(Array(1), (value) => { 123 }).value()
        })
    }),
    Test("array parallel find index cancellation", () => {
        future: Arrays.parallelFindIndex(Array(1, 2), (value) => { false })
        future.cancel()
        Assertions.signals(Cancelled, () => { future.value() })
    })
)
tests.freeze()
