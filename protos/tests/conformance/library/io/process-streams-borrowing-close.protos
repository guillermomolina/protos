ProcessStreams: import("std:io/ProcessStreams")
reader1: ProcessStreams.stdinReader(process)
reader1.close().value()
reader2: ProcessStreams.stdinReader(process)
text: reader2.readText().value()
writer1: ProcessStreams.stdoutWriter(process)
writer1.close().value()
writer2: ProcessStreams.stdoutWriter(process)
writer2.writeText("B").value()
(text == "é") &&
    (stdoutCapture.size() == 2) &&
    (stdoutCapture[0] == 0) &&
    (stdoutCapture[1] == 66)
