Files: import("std:io/Files")
path: Path.relative().child("target.bin")
payload: Encoding.Latin1.encode("close")
future: Files.writeAllBytes(filesystem, path, payload)
failed: false

IOError.handle(
    () => {
        future.value()
        null
    },
    (error) => {
        failed = true
        null
    }
)

actual: Files.readAllBytes(filesystem, path).value()
failed &&
    (actual.size() == 5) &&
    (actual.at(0) == 99) &&
    (actual.at(4) == 101)
