JSON: import("std:json/JSON")

events: Map()
count: 0
parser: JSON.eventParser((event) => {
    events.atPut(count, event)
    count = count + 1
})

parser.feed("-1")
parser.feed("2.5e")
parser.feed("+3")
parser.finish()

event: events.at(0)
(count == 1).and() {
    (event.kind == "number").and() {
        (event.value.coefficient == -125).and() {
            event.value.exponent == 2
        }
    }
}
