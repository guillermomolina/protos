JSON: import("std:json/JSON")

events: Map()
count: 0
parser: JSON.eventParser((event) => {
    events[count] = event
    count = count + 1
})

parser.feed("{\"a\":[tr")
parser.feed("ue,\"A\\uD83")
parser.feed("D\\uDE00\",-12.")
parser.feed("30e-")
parser.feed("2]}")
parser.finish()

ok: true
check: (condition) => {
    condition.ifFalse(() => { ok = false })
}

check(count == 8)
check(events[0].kind == "objectStart")
check(events[0].value === null)
check(events[1].kind == "name")
check(events[1].value == "a")
check(events[2].kind == "arrayStart")
check(events[3].kind == "boolean")
check(events[3].value === true)
check(events[4].kind == "string")
check(events[4].value == "A\u{1F600}")
check(events[5].kind == "number")
check(events[5].value.coefficient == -1230)
check(events[5].value.exponent == -4)
check(events[6].kind == "arrayEnd")
check(events[7].kind == "objectEnd")

ok
