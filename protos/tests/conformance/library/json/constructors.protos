Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("array object shape order", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            one: JSON.number(1, 0)
            arrayNode: JSON.array(one, JSON.string("x"), JSON.nullValue())
            objectNode: JSON.object(
                "first", one,
                "second", arrayNode,
                "third", JSON.boolean(true)
            )

            seen: Map()
            index: 0
            objectNode.value.each((key, node) => {
                seen[index] = key
                index = index + 1
            })

            objectNode.value["fourth"] = JSON.nullValue()

            ok: true
            (arrayNode.kind == "array").ifFalse(() => { ok = false })
            (arrayNode.value.size() == 3).ifFalse(() => { ok = false })
            (arrayNode.value[0] === one).ifFalse(() => { ok = false })
            (arrayNode.value[1].kind == "string").ifFalse(() => { ok = false })
            (arrayNode.value[2].kind == "null").ifFalse(() => { ok = false })
            (objectNode.kind == "object").ifFalse(() => { ok = false })
            (index == 3).ifFalse(() => { ok = false })
            (seen[0] == "first").ifFalse(() => { ok = false })
            (seen[1] == "second").ifFalse(() => { ok = false })
            (seen[2] == "third").ifFalse(() => { ok = false })
            (objectNode.value["first"] === one).ifFalse(() => { ok = false })
            (objectNode.value["second"] === arrayNode).ifFalse(() => { ok = false })
            (objectNode.value.containsKey("fourth")).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("constructors basic", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            nullA: JSON.nullValue()
            nullB: JSON.nullValue()
            trueNode: JSON.boolean(true)
            falseNode: JSON.boolean(false)
            stringNode: JSON.string("Ada")

            nullA.probe: 1
            trueNode.probe: 2
            stringNode.probe: 3

            ok: true
            (nullA.kind == "null").ifFalse(() => { ok = false })
            (nullA.value === null).ifFalse(() => { ok = false })
            (nullA !== nullB).ifFalse(() => { ok = false })
            (trueNode.kind == "boolean").ifFalse(() => { ok = false })
            (trueNode.value === true).ifFalse(() => { ok = false })
            (falseNode.kind == "boolean").ifFalse(() => { ok = false })
            (falseNode.value === false).ifFalse(() => { ok = false })
            (stringNode.kind == "string").ifFalse(() => { ok = false })
            (stringNode.value == "Ada").ifFalse(() => { ok = false })
            (nullA.probe == 1).ifFalse(() => { ok = false })
            (trueNode.probe == 2).ifFalse(() => { ok = false })
            (stringNode.probe == 3).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("number exact decimal", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            a: JSON.number(123, -2)
            b: JSON.number(10, -1)
            c: JSON.number(1, 0)
            d: JSON.number(0, 1000000)

            a.value.probe: 9

            ok: true
            (a.kind == "number").ifFalse(() => { ok = false })
            (a.value.coefficient == 123).ifFalse(() => { ok = false })
            (a.value.exponent == -2).ifFalse(() => { ok = false })
            (b.value.coefficient == 10).ifFalse(() => { ok = false })
            (b.value.exponent == -1).ifFalse(() => { ok = false })
            (c.value.coefficient == 1).ifFalse(() => { ok = false })
            (c.value.exponent == 0).ifFalse(() => { ok = false })
            (d.value.coefficient == 0).ifFalse(() => { ok = false })
            (d.value.exponent == 1000000).ifFalse(() => { ok = false })
            (a.value.probe == 9).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
