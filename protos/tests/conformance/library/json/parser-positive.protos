Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parse basic escapes", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            quote: JSON.parse("\"a\\\"b\"")
            backslash: JSON.parse("\"a\\\\b\"")
            slash: JSON.parse("\"\\/\"")
            newline: JSON.parse("\"\\n\"")
            carriage: JSON.parse("\"\\r\"")
            tab: JSON.parse("\"\\t\"")
            backspace: JSON.parse("\"\\b\"")
            formfeed: JSON.parse("\"\\f\"")

            ok: true
            (quote.value == "a\"b").ifFalse(() => { ok = false })
            (backslash.value == "a\\b").ifFalse(() => { ok = false })
            (slash.value == "/").ifFalse(() => { ok = false })
            (newline.value == "\n").ifFalse(() => { ok = false })
            (carriage.value == "\r").ifFalse(() => { ok = false })
            (tab.value == "\t").ifFalse(() => { ok = false })
            (backspace.value == "\b").ifFalse(() => { ok = false })
            (formfeed.value == "\f").ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse nested retained order", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            root: JSON.parse("{\"a\":[1,true,null,\"x\"],\"b\":{\"c\":2}}")

            seen: Map()
            index: 0
            root.value.each((key, node) => {
                seen[index] = key
                index = index + 1
            })

            arrayNode: root.value["a"]
            nested: root.value["b"]

            ok: true
            (root.kind == "object").ifFalse(() => { ok = false })
            (index == 2).ifFalse(() => { ok = false })
            (seen[0] == "a").ifFalse(() => { ok = false })
            (seen[1] == "b").ifFalse(() => { ok = false })
            (arrayNode.kind == "array").ifFalse(() => { ok = false })
            (arrayNode.value.size() == 4).ifFalse(() => { ok = false })
            (arrayNode.value[0].value.coefficient == 1).ifFalse(() => { ok = false })
            (arrayNode.value[1].value === true).ifFalse(() => { ok = false })
            (arrayNode.value[2].value === null).ifFalse(() => { ok = false })
            (arrayNode.value[3].value == "x").ifFalse(() => { ok = false })
            (nested.kind == "object").ifFalse(() => { ok = false })
            (nested.value["c"].value.coefficient == 2).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse raw unicode noncharacter no normalization", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")
            parsed: JSON.parse("\"﷐\"")
            parsed.value == "﷐"
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse root containers", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            arrayNode: JSON.parse("[1]")
            objectNode: JSON.parse("{\"a\":1}")

            arrayNode.probe: true
            objectNode.probe: true
            objectNode.value["b"] = JSON.boolean(true)

            ok: true
            (arrayNode.kind == "array").ifFalse(() => { ok = false })
            (arrayNode.value.size() == 1).ifFalse(() => { ok = false })
            (arrayNode.value[0].kind == "number").ifFalse(() => { ok = false })
            (arrayNode.value[0].value.coefficient == 1).ifFalse(() => { ok = false })
            (arrayNode.value[0].value.exponent == 0).ifFalse(() => { ok = false })
            (objectNode.kind == "object").ifFalse(() => { ok = false })
            (objectNode.value["a"].kind == "number").ifFalse(() => { ok = false })
            (objectNode.value["a"].value.coefficient == 1).ifFalse(() => { ok = false })
            (objectNode.value["b"].value === true).ifFalse(() => { ok = false })
            (arrayNode.probe === true).ifFalse(() => { ok = false })
            (objectNode.probe === true).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse scalars exact decimals", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            nullNode: JSON.parse("null")
            trueNode: JSON.parse("true")
            falseNode: JSON.parse("false")
            stringNode: JSON.parse("\"hello\"")
            zero: JSON.parse("0")
            negativeZero: JSON.parse("-0")
            integer: JSON.parse("123")
            decimal: JSON.parse("-12.3400e+2")
            largeExponent: JSON.parse("1e400")

            ok: true
            (nullNode.kind == "null").ifFalse(() => { ok = false })
            (nullNode.value === null).ifFalse(() => { ok = false })
            (trueNode.kind == "boolean").ifFalse(() => { ok = false })
            (trueNode.value === true).ifFalse(() => { ok = false })
            (falseNode.kind == "boolean").ifFalse(() => { ok = false })
            (falseNode.value === false).ifFalse(() => { ok = false })
            (stringNode.kind == "string").ifFalse(() => { ok = false })
            (stringNode.value == "hello").ifFalse(() => { ok = false })
            (zero.value.coefficient == 0).ifFalse(() => { ok = false })
            (zero.value.exponent == 0).ifFalse(() => { ok = false })
            (negativeZero.value.coefficient == 0).ifFalse(() => { ok = false })
            (negativeZero.value.exponent == 0).ifFalse(() => { ok = false })
            (integer.value.coefficient == 123).ifFalse(() => { ok = false })
            (integer.value.exponent == 0).ifFalse(() => { ok = false })
            (decimal.value.coefficient == -123400).ifFalse(() => { ok = false })
            (decimal.value.exponent == -2).ifFalse(() => { ok = false })
            (largeExponent.value.coefficient == 1).ifFalse(() => { ok = false })
            (largeExponent.value.exponent == 400).ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse unicode escapes and surrogate pair", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            ascii: JSON.parse("\"\\u0041\"")
            music: JSON.parse("\"\\uD834\\uDD1E\"")
            emoji: JSON.parse("\"😀\"")

            ((ascii.value == "A") && (music.value == "𝄞")) &&
                (emoji.value == "😀")
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
