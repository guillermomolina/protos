JSON: import("std:json/JSON")

quote: JSON.parse("\"a\\\"b\"")
backslash: JSON.parse("\"a\\\\b\"")
slash: JSON.parse("\"\\/\"")
newline: JSON.parse("\"\\n\"")
carriage: JSON.parse("\"\\r\"")
tab: JSON.parse("\"\\t\"")
backspace: JSON.parse("\"\\b\"")
formfeed: JSON.parse("\"\\f\"")

ok: true
(quote.value == "a\"b").ifFalse(() => { ok = false })
(backslash.value == "a\\b").ifFalse(() => { ok = false })
(slash.value == "/").ifFalse(() => { ok = false })
(newline.value == "\n").ifFalse(() => { ok = false })
(carriage.value == "\r").ifFalse(() => { ok = false })
(tab.value == "\t").ifFalse(() => { ok = false })
(backspace.value == "\b").ifFalse(() => { ok = false })
(formfeed.value == "\f").ifFalse(() => { ok = false })
ok
