JSON: import("std:json/JSON")

root: JSON.parse("{\"a\":[1,true,null,\"x\"],\"b\":{\"c\":2}}")

seen: Map()
index: 0
root.value.each((key, node) => {
    seen[index] = key
    index = index + 1
})

arrayNode: root.value["a"]
nested: root.value["b"]

ok: true
(root.kind == "object").ifFalse(() => { ok = false })
(index == 2).ifFalse(() => { ok = false })
(seen[0] == "a").ifFalse(() => { ok = false })
(seen[1] == "b").ifFalse(() => { ok = false })
(arrayNode.kind == "array").ifFalse(() => { ok = false })
(arrayNode.value.size() == 4).ifFalse(() => { ok = false })
(arrayNode.value[0].value.coefficient == 1).ifFalse(() => { ok = false })
(arrayNode.value[1].value === true).ifFalse(() => { ok = false })
(arrayNode.value[2].value === null).ifFalse(() => { ok = false })
(arrayNode.value[3].value == "x").ifFalse(() => { ok = false })
(nested.kind == "object").ifFalse(() => { ok = false })
(nested.value["c"].value.coefficient == 2).ifFalse(() => { ok = false })
ok
