Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("constructor array non node error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.array(1)
        })
    }),
    Test("constructor array payload frozen error", () => {
        JSON: import("std:json/JSON")

        node: JSON.array(JSON.nullValue())

        Assertions.signals(Error, () => {
            node.value[0] = JSON.boolean(true)
        })
    }),
    Test("constructor boolean domain error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.boolean(1)
        })
    }),
    Test("constructor number coefficient float error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.number(1.0, 0)
        })
    }),
    Test("constructor number delegated integer error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.number(Integer {}, 0)
        })
    }),
    Test("constructor number exponent float error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.number(1, 0.0)
        })
    }),
    Test("constructor object duplicate name error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.object("x", JSON.nullValue(), "x", JSON.boolean(true))
        })
    }),
    Test("constructor object non node value error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.object("x", 1)
        })
    }),
    Test("constructor object non string name error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.object(1, JSON.nullValue())
        })
    }),
    Test("constructor object odd pair count error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.object("orphan")
        })
    }),
    Test("constructor string domain error", () => {
        JSON: import("std:json/JSON")

        Assertions.signals(Error, () => {
            JSON.string(1)
        })
    })
]
tests.freeze()
