JSON: import("std:json/JSON")

output: ""
writer: JSON.eventWriter((chunk) => {
    output = output + chunk
})
parser: JSON.eventParser((event) => {
    writer.feed(event)
})

parser.feed(" {\"z\": [1, \"A\\uD83")
parser.feed("D\\uDE00\", false], \"n\": 12.30e-2} ")
parser.finish()
writer.finish()

node: JSON.parse(output)
(node.value.at("z").value.at(1).value == "A\u{1F600}").and() {
    (node.value.at("n").value.coefficient == 1230).and() {
        node.value.at("n").value.exponent == -4
    }
}
