JSON: import("std:json/JSON")

sink: ""
writes: 0
textWriter: null
textWriter = {
    writeText: (text) => {
        (() => {
            sink = sink + text
            writes = writes + 1
            textWriter
        }).future()
    }
}

event: (kind, value) => {
    {
        kind: kind
        value: value
    }
}

stream: JSON.writeEvents(textWriter)
step1: stream.feed(event("objectStart", null))
step2: step1.then((ignored) => {
    stream.feed(event("name", "a"))
})
step3: step2.then((ignored) => {
    stream.feed(event("arrayStart", null))
})
step4: step3.then((ignored) => {
    stream.feed(event("number", {
        coefficient: 12
        exponent: -1
    }))
})
step5: step4.then((ignored) => {
    stream.feed(event("boolean", false))
})
step6: step5.then((ignored) => {
    stream.feed(event("arrayEnd", null))
})
step7: step6.then((ignored) => {
    stream.feed(event("objectEnd", null))
})
finished: step7.then((ignored) => {
    stream.finish()
})

finished.then((ignored) => {
    (sink == "{\"a\":[12e-1,false]}").ifFalse(() => {
        Error().signal()
    })
    (writes == 8).ifFalse(() => {
        Error().signal()
    })
    true
})
