JSON: import("std:json/JSON")

source: "{\"n\":12345678901234567890e-7,\"s\":\"line\\n\\uD83D\\uDE00\",\"a\":[true,null]}"
tree: JSON.parse(source)
encoded: JSON.encode(tree)

output: ""
writer: JSON.eventWriter((chunk) => {
    output = output + chunk
})

parser: JSON.eventParser((event) => {
    writer.feed(event)
})

parser.feed(encoded)
parser.finish()
writer.finish()

roundTripped: JSON.parse(output)
ok: true
(output == encoded).ifFalse(() => { ok = false })
(roundTripped.kind == "object").ifFalse(() => { ok = false })
(roundTripped.value["n"].kind == "number").ifFalse(() => { ok = false })
(roundTripped.value["n"].value.coefficient == 12345678901234567890).ifFalse(() => { ok = false })
(roundTripped.value["n"].value.exponent == -7).ifFalse(() => { ok = false })
(roundTripped.value["a"].value.size() == 2).ifFalse(() => { ok = false })
ok
