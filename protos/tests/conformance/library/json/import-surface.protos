Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("import cache", () => {
        tool009LegacyCase: () => {
            first: import("std:json/json")
            second: import("std:json/json")
            first === second
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("import obsolete uppercase module error", () => {
        Assertions.signals(Error, () => {
            import("std:json/JSON")
        })
    }),
    Test("import wrong directory case error", () => {
        Assertions.signals(Error, () => {
            import("std:JSON/JSON")
        })
    })
]
tests.freeze()
