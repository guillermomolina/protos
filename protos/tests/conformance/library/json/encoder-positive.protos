Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("encode nested retained order", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            tree: JSON.object(
                "b", JSON.number(2, 0),
                "a", JSON.array(
                    JSON.boolean(true),
                    JSON.string("x")
                )
            )

            JSON.encode(tree) == "{\"b\":2,\"a\":[true,\"x\"]}"
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("encode scalars exact decimals", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            ok: true
            (JSON.encode(JSON.nullValue()) == "null").ifFalse(() => { ok = false })
            (JSON.encode(JSON.boolean(true)) == "true").ifFalse(() => { ok = false })
            (JSON.encode(JSON.boolean(false)) == "false").ifFalse(() => { ok = false })
            (JSON.encode(JSON.number(123, -2)) == "123e-2").ifFalse(() => { ok = false })
            (JSON.encode(JSON.number(-7, 5)) == "-7e5").ifFalse(() => { ok = false })
            (JSON.encode(JSON.number(0, -100)) == "0e-100").ifFalse(() => { ok = false })
            (JSON.encode(JSON.number(42, 0)) == "42").ifFalse(() => { ok = false })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("encode shared child not cycle", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            child: JSON.object("x", JSON.number(1, 0))
            tree: JSON.array(child, child)

            JSON.encode(tree) == "[{\"x\":1},{\"x\":1}]"
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("encode string roundtrip escapes unicode", () => {
        tool009LegacyCase: () => {
            JSON: import("std:json/JSON")

            text: "quote:\" slash:\\ tab:\t newline:\n noncharacter:\u{FDD0} face:\u{1F600}"
            encoded: JSON.encode(JSON.string(text))
            decoded: JSON.parse(encoded)

            (decoded.kind == "string") &&
                (decoded.value == text)
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
