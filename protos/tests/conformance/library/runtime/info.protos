Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Runtime: import("std:runtime")

fields: ["implementation", "implementationVersion", "engineVersion", "platform", "executionMode"]

tests: [
    Test("std:runtime exports exactly info", () => {
        Assertions.require(Runtime.slotNames().size() == 1)
        Assertions.require(Runtime.hasSlot("info"))
        Assertions.require(Runtime.hasSlot("_runtimeMetadataFacility") == false)
        null
    }),
    Test("info answers exactly five String fields", () => {
        snapshot: Runtime.info()
        Assertions.require(snapshot.parent() === Object)
        Assertions.require(snapshot.slotNames().size() == 5)
        fields.each((name) => {
            Assertions.require(snapshot.hasSlot(name))
            Assertions.require(snapshot.slotValue(name).parent() === String)
        })
        Assertions.require(snapshot.implementation == "Protos")
        null
    }),
    Test("info snapshots are frozen", () => {
        snapshot: Runtime.info()
        Assertions.signals(Error, () => {
            snapshot.extra: 1
        })
        Assertions.signals(Error, () => {
            snapshot.platform = "changed"
        })
        Assertions.require(snapshot.slotNames().size() == 5)
        null
    }),
    Test("every info call answers a distinct snapshot", () => {
        first: Runtime.info()
        second: Runtime.info()
        Assertions.require(first !== second)
        Assertions.require(first.engineVersion == second.engineVersion)
        null
    }),
    Test("info rejects every argument", () => {
        Assertions.signals(Error, () => {
            Runtime.info(1)
        })
        Assertions.signals(Error, () => {
            Runtime.info(1, 2)
        })
        null
    }),
    Test("metadata reads leave module state unchanged", () => {
        before: Runtime.slotValue("info")
        Runtime.info()
        Runtime.info()
        Assertions.require(Runtime.slotValue("info") === before)
        Assertions.require(Runtime.slotNames().size() == 1)
        Assertions.require(import("std:runtime") === Runtime)
        null
    })
]
tests.freeze()
