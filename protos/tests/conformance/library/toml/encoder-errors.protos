Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("encode non-table root error", () => {
        TOML: import("std:toml/TOML")

        root: TOML.integer(1)

        Assertions.signals(Error, () => {
            TOML.encode(root)
        })
    }),
    Test("encode forged node kind error", () => {
        TOML: import("std:toml/TOML")

        forged: {
            kind: "unknown"
            value: 1
        }

        Assertions.signals(Error, () => {
            TOML.encode(TOML.table("x", forged))
        })
    }),
    Test("encode cyclic table error", () => {
        TOML: import("std:toml/TOML")

        cyclic: TOML.table()
        cyclic.value["self"] = cyclic

        Assertions.signals(Error, () => {
            TOML.encode(cyclic)
        })
    })
]
tests.freeze()
