Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("semantic constructors preserve approved TOML kinds and payloads", () => {
        TOML: import("std:toml/TOML")

        text: TOML.string("hello")
        huge: TOML.integer(123456789012345678901234567890)
        negativeZero: TOML.float(-0.0)
        flag: TOML.boolean(true)
        date: TOML.localDate(2024, 2, 29)
        time: TOML.localTime(23, 59, 58, 123400, 6)
        local: TOML.localDateTime(2025, 12, 31, 7, 32, 0, 5, 1)
        offset: TOML.offsetDateTime(
            1979, 5, 27, 0, 32, 0, 999999, 6, -420
        )
        values: TOML.array(text, huge, negativeZero, flag, date, time)
        root: TOML.table(
            "name", text,
            "values", values,
            "local", local,
            "offset", offset
        )

        Assertions.require(text.kind === "string")
        Assertions.require(text.value == "hello")
        Assertions.require(huge.kind === "integer")
        Assertions.require(huge.value == 123456789012345678901234567890)
        Assertions.require(negativeZero.kind === "float")
        Assertions.require(negativeZero.value === -0.0)
        Assertions.require(flag.kind === "boolean")
        Assertions.require(flag.value === true)
        Assertions.require(date.kind === "localDate")
        Assertions.require(date.value.year == 2024)
        Assertions.require(date.value.month == 2)
        Assertions.require(date.value.day == 29)
        Assertions.require(time.kind === "localTime")
        Assertions.require(time.value.hour == 23)
        Assertions.require(time.value.minute == 59)
        Assertions.require(time.value.second == 58)
        Assertions.require(time.value.fraction.coefficient == 123400)
        Assertions.require(time.value.fraction.digits == 6)
        Assertions.require(local.kind === "localDateTime")
        Assertions.require(local.value.year == 2025)
        Assertions.require(local.value.fraction.coefficient == 5)
        Assertions.require(local.value.fraction.digits == 1)
        Assertions.require(offset.kind === "offsetDateTime")
        Assertions.require(offset.value.offsetMinutes == -420)
        Assertions.require(offset.value.fraction.coefficient == 999999)
        Assertions.require(offset.value.fraction.digits == 6)
        Assertions.require(values.kind === "array")
        Assertions.require(values.value.size() == 6)
        Assertions.require(root.kind === "table")
        Assertions.require(root.value.size() == 4)
        Assertions.require(root.value["name"].value == "hello")
        Assertions.require(root.value["values"] === values)
    }),
    Test("D104 preserves second sixty as TOML semantic data", () => {
        TOML: import("std:toml/TOML")

        time: TOML.localTime(12, 34, 60, 0, 0)
        local: TOML.localDateTime(2025, 2, 3, 4, 5, 60, 0, 0)
        offset: TOML.offsetDateTime(
            2025, 2, 3, 4, 5, 60, 123, 3, 137
        )

        Assertions.require(time.kind === "localTime")
        Assertions.require(time.value.second == 60)
        Assertions.require(local.kind === "localDateTime")
        Assertions.require(local.value.second == 60)
        Assertions.require(offset.kind === "offsetDateTime")
        Assertions.require(offset.value.second == 60)
        Assertions.require(offset.value.offsetMinutes == 137)
        Assertions.require(offset.value.fraction.coefficient == 123)
        Assertions.require(offset.value.fraction.digits == 3)
    })
]
tests.freeze()
