Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

// I079: one parser, two explicitly selected TOML specification versions. Each Test
// runs the same input through TOML 1.1 (`parse` and `parseDialect(..., "1.1")`) and
// through TOML 1.0 (`parseDialect(..., "1.0")`).

tests: [
    Test("TOML 1.1 accepts and TOML 1.0 rejects the \\e escape", () => {
        TOML: import("std:toml/TOML")

        input: "x = \"a\\eb\"\n"

        Assertions.require(TOML.parse(input).value["x"].value.size() == 3)
        Assertions.require(
            TOML.parseDialect(input, "1.1").value["x"].value.size() == 3
        )
        Assertions.signals(Error, () => {
            TOML.parseDialect(input, "1.0")
        })
    }),
    Test("TOML 1.1 accepts and TOML 1.0 rejects hexadecimal byte escapes", () => {
        TOML: import("std:toml/TOML")

        input: "x = \"\\x41\"\n"

        Assertions.require(TOML.parse(input).value["x"].value == "A")
        Assertions.require(TOML.parseDialect(input, "1.1").value["x"].value == "A")
        Assertions.signals(Error, () => {
            TOML.parseDialect(input, "1.0")
        })
    }),
    Test("TOML 1.0 rejects TOML 1.1 escapes in quoted keys and multiline strings", () => {
        TOML: import("std:toml/TOML")

        keyInput: "\"k\\x41\" = 1\n"
        multilineInput: "x = \"\"\"a\\e\"\"\"\n"

        Assertions.require(TOML.parse(keyInput).value.containsKey("kA"))
        Assertions.require(TOML.parse(multilineInput).value["x"].value.size() == 2)
        Assertions.signals(Error, () => {
            TOML.parseDialect(keyInput, "1.0")
        })
        Assertions.signals(Error, () => {
            TOML.parseDialect(multilineInput, "1.0")
        })
    }),
    Test("TOML 1.0 keeps the TOML 1.0 escapes", () => {
        TOML: import("std:toml/TOML")

        input: "x = \"\\b\\t\\n\\f\\r\\\"\\\\\\u0041\\U00000042\"\n"

        Assertions.require(TOML.parseDialect(input, "1.0").value["x"].value.size() == 9)
    }),
    Test("TOML 1.1 accepts and TOML 1.0 rejects multiline inline tables", () => {
        TOML: import("std:toml/TOML")

        input: "x = {\n  a = 1,\n  b = 2\n}\n"

        Assertions.require(TOML.parse(input).value["x"].value["b"].value == 2)
        Assertions.require(
            TOML.parseDialect(input, "1.1").value["x"].value["b"].value == 2
        )
        Assertions.signals(Error, () => {
            TOML.parseDialect(input, "1.0")
        })
    }),
    Test("TOML 1.1 accepts and TOML 1.0 rejects comments inside inline tables", () => {
        TOML: import("std:toml/TOML")

        input: "x = { a = 1, # note\n b = 2 }\n"

        Assertions.require(TOML.parse(input).value["x"].value["a"].value == 1)
        Assertions.signals(Error, () => {
            TOML.parseDialect(input, "1.0")
        })
    }),
    Test("TOML 1.1 accepts and TOML 1.0 rejects inline-table trailing commas", () => {
        TOML: import("std:toml/TOML")

        input: "x = { a = 1, }\n"

        Assertions.require(TOML.parse(input).value["x"].value["a"].value == 1)
        Assertions.require(
            TOML.parseDialect(input, "1.1").value["x"].value["a"].value == 1
        )
        Assertions.signals(Error, () => {
            TOML.parseDialect(input, "1.0")
        })
    }),
    Test("TOML 1.0 accepts single-line inline tables with multiline nested values", () => {
        TOML: import("std:toml/TOML")

        input: "x = { a = 1, b = [\n  2,\n  3,\n], c = {}, d = \"\"\"\nm\"\"\" }\n"

        root: TOML.parseDialect(input, "1.0")

        Assertions.require(root.value["x"].value["a"].value == 1)
        Assertions.require(root.value["x"].value["b"].value.size() == 2)
        Assertions.require(root.value["x"].value["c"].value.size() == 0)
        Assertions.require(root.value["x"].value["d"].value == "m")
    }),
    Test("TOML 1.1 accepts and TOML 1.0 rejects omitted temporal seconds", () => {
        TOML: import("std:toml/TOML")

        inputs: [
            "t = 07:32\n",
            "t = 1979-05-27T07:32\n",
            "t = 1979-05-27T07:32Z\n",
            "t = 1979-05-27 07:32-07:00\n"
        ]

        inputs.each((input) => {
            Assertions.require(TOML.parse(input).value["t"].value.second == 0)
            Assertions.require(
                TOML.parseDialect(input, "1.1").value["t"].value.second == 0
            )
            Assertions.signals(Error, () => {
                TOML.parseDialect(input, "1.0")
            })
        })
        null
    }),
    Test("TOML 1.0 accepts temporal values with seconds", () => {
        TOML: import("std:toml/TOML")

        root: TOML.parseDialect(
            "a = 07:32:10\n" +
            "b = 1979-05-27T07:32:10.5\n" +
            "c = 1979-05-27T07:32:10-07:00\n" +
            "d = 1979-05-27\n",
            "1.0"
        )

        Assertions.require(root.value["a"].kind === "localTime")
        Assertions.require(root.value["a"].value.second == 10)
        Assertions.require(root.value["b"].kind === "localDateTime")
        Assertions.require(root.value["c"].kind === "offsetDateTime")
        Assertions.require(root.value["d"].kind === "localDate")
    }),
    Test("TOML 1.0 integers are not limited to signed 64 bits", () => {
        TOML: import("std:toml/TOML")

        root: TOML.parseDialect("x = 9223372036854775808\n", "1.0")

        Assertions.require(root.value["x"].value == 9223372036854775808)
    }),
    Test("parseDialect rejects unknown TOML versions", () => {
        TOML: import("std:toml/TOML")

        Assertions.signals(Error, () => {
            TOML.parseDialect("x = 1\n", "1.2")
        })
        Assertions.signals(Error, () => {
            TOML.parseDialect("x = 1\n", 1)
        })
        Assertions.signals(Error, () => {
            TOML.parseDialect(1, "1.0")
        })
    })
]
tests.freeze()
