Harness: import("./Harness.protos")
Test: import("std:test/Test")

tests: [
    Test("invalid/inline-table/bad-key-syntax", () => {
        Harness.rejects(
            "tbl = { a = 1, [b] }\n"
        )
    }),
    Test("invalid/inline-table/double-comma", () => {
        Harness.rejects(
            "t = {x=3,,y=4}\n"
        )
    }),
    Test("invalid/inline-table/duplicate-key-01", () => {
        Harness.rejects(
            "# Duplicate keys within an inline table are invalid\n" +
            "a={b=1, b=2}\n"
        )
    }),
    Test("invalid/inline-table/duplicate-key-02", () => {
        Harness.rejects(
            "table1 = { table2.dupe = 1, table2.dupe = 2 }\n"
        )
    }),
    Test("invalid/inline-table/duplicate-key-03", () => {
        Harness.rejects(
            "tbl = { fruit = { apple.color = \"red\" }, fruit.apple.texture =" +
            " { smooth = true } }\n" +
            "\n"
        )
    }),
    Test("invalid/inline-table/duplicate-key-04", () => {
        Harness.rejects(
            "tbl = { a.b = \"a_b\", a.b.c = \"a_b_c\" }\n"
        )
    }),
    Test("invalid/inline-table/empty-01", () => {
        Harness.rejects(
            "t = {,}\n"
        )
    }),
    Test("invalid/inline-table/empty-02", () => {
        Harness.rejects(
            "t = {,\n" +
            "}\n"
        )
    }),
    Test("invalid/inline-table/empty-03", () => {
        Harness.rejects(
            "t = {\n" +
            ",\n" +
            "}\n"
        )
    }),
    Test("invalid/inline-table/no-close-01", () => {
        Harness.rejects(
            "a={\n"
        )
    }),
    Test("invalid/inline-table/no-close-02", () => {
        Harness.rejects(
            "a={b=1\n"
        )
    }),
    Test("invalid/inline-table/no-comma-01", () => {
        Harness.rejects(
            "t = {x = 3 y = 4}\n"
        )
    }),
    Test("invalid/inline-table/no-comma-02", () => {
        Harness.rejects(
            "arrr = { comma-missing = true valid-toml = false }\n"
        )
    }),
    Test("invalid/inline-table/overwrite-01", () => {
        Harness.rejects(
            "a.b=0\n" +
            "# Since table \"a\" is already defined, it can't be replaced by " +
            "an inline table.\n" +
            "a={}\n"
        )
    }),
    Test("invalid/inline-table/overwrite-02", () => {
        Harness.rejects(
            "a={}\n" +
            "# Inline tables are immutable and can't be extended\n" +
            "[a.b]\n"
        )
    }),
    Test("invalid/inline-table/overwrite-03", () => {
        Harness.rejects(
            "a = { b = 1 }\n" +
            "a.b = 2\n"
        )
    }),
    Test("invalid/inline-table/overwrite-04", () => {
        Harness.rejects(
            "inline-t = { nest = {} }\n" +
            "\n" +
            "[[inline-t.nest]]\n"
        )
    }),
    Test("invalid/inline-table/overwrite-05", () => {
        Harness.rejects(
            "inline-t = { nest = {} }\n" +
            "\n" +
            "[inline-t.nest]\n"
        )
    }),
    Test("invalid/inline-table/overwrite-06", () => {
        Harness.rejects(
            "a = { b = 1, b.c = 2 }\n"
        )
    }),
    Test("invalid/inline-table/overwrite-07", () => {
        Harness.rejects(
            "tab = { inner.table = [{}], inner.table.val = \"bad\" }"
        )
    }),
    Test("invalid/inline-table/overwrite-08", () => {
        Harness.rejects(
            "tab = { inner = { dog = \"best\" }, inner.cat = \"worst\" }"
        )
    }),
    Test("invalid/inline-table/overwrite-09", () => {
        Harness.rejects(
            "[tab.nested]\n" +
            "inline-t = { nest = {} }\n" +
            "\n" +
            "[tab]\n" +
            "nested.inline-t.nest = 2\n"
        )
    }),
    Test("invalid/inline-table/overwrite-10", () => {
        Harness.rejects(
            "# Set implicit \"b\", overwrite \"b\" (illegal!) and then set an" +
            "other implicit.\n" +
            "#\n" +
            "# Caused panic: https://github.com/BurntSushi/toml/issues/403\n" +
            "a = {b.a = 1, b = 2, b.c = 3}\n"
        )
    })
