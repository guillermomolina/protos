    Test("valid/multibyte", () => {
        Harness.decodes(
            "# Test multibyte throughout\n" +
            "\n" +
            "# T\u{E8}\u{1A8}\u{1AD} \u{192}\u{EF}\u{2113}\u{E8} \u{192}\u{F4}" +
            "\u{159} T\u{D3}M\u{A3}\n" +
            "# \u{D3}\u{F1}\u{2113}\u{A5} \u{1AD}\u{3BB}\u{EF}\u{1A8} \u{F4}\u{F1}" +
            "\u{E8} \u{1AD}\u{159}\u{EF}\u{E8}\u{1A8} \u{1AD}\u{F4} \u{E8}\u{20A5}" +
            "\u{FA}\u{2113}\u{E1}\u{1AD}\u{E8} \u{E1} T\u{D3}M\u{A3} \u{192}\u{EF}" +
            "\u{2113}\u{E8} \u{3C9}\u{159}\u{EF}\u{1AD}\u{1AD}\u{E8}\u{F1} \u{3B2}" +
            "\u{A5} \u{E1} \u{FA}\u{1A8}\u{E8}\u{159} \u{F4}\u{192} \u{1AD}\u{3BB}" +
            "\u{E8} \u{199}\u{EF}\u{F1}\u{3B4} \u{F4}\u{192} \u{1A5}\u{E1}\u{159}" +
            "\u{1A8}\u{E8}\u{159} \u{3C9}\u{159}\u{EF}\u{1AD}\u{E8}\u{159}\u{1A8}" +
            " \u{1A5}\u{159}\u{F4}\u{3B2}\u{E1}\u{3B2}\u{2113}\u{A5} \u{3BB}\u{E1}" +
            "\u{1AD}\u{E8}\n" +
            "\n" +
            "['\u{1D42D}\u{1D41B}\u{1D425}']\n" +
            "string = \"\u{1D4FC}\u{1D4FD}\u{1D4FB}\u{1D4F2}\u{1D4F7}\u{1D4F0}" +
            " - #\"          # \" \u{1D4FC}\u{1D4FD}\u{1D4FB}\u{1D4F2}\u{1D4F7}" +
            "\u{1D4F0}\n" +
            "\t['\u{1D42D}\u{1D41B}\u{1D425}'.sub]\n" +
            "\t'\u{1D552}\u{1D563}\u{1D563}\u{1D552}\u{1D56A}' = [ \"] \", \"" +
            " # \"]      # ] \u{1D4EA}\u{1D4FB}\u{1D4FB}\u{1D4EA}\u{1D502}\n" +
            "\t'\u{1D552}\u{1D563}\u{1D563}\u{1D552}\u{1D56A}\u{1D7DA}' = [ \"" +
            "T\u{E8}\u{1A8}\u{1AD} #11 ]\u{1A5}\u{159}\u{F4}\u{1B2}\u{E8}\u{3B4}" +
            " \u{1AD}\u{3BB}\u{E1}\u{1AD}\", \"\u{C9}\u{436}\u{1A5}\u{E8}\u{159}" +
            "\u{EF}\u{20A5}\u{E8}\u{F1}\u{1AD} #9 \u{3C9}\u{E1}\u{1A8} \u{E1}" +
            " \u{1A8}\u{FA}\u{E7}\u{E7}\u{E8}\u{1A8}\u{1A8}\" ]\n" +
            "\t# \u{DD}\u{F4}\u{FA} \u{3B4}\u{EF}\u{3B4}\u{F1}'\u{1AD} \u{1AD}" +
            "\u{3BB}\u{EF}\u{F1}\u{199} \u{EF}\u{1AD}'\u{3B4} \u{E1}\u{1A8} \u{E8}" +
            "\u{E1}\u{1A8}\u{A5} \u{E1}\u{1A8} \u{E7}\u{3BB}\u{FA}\u{E7}\u{199}" +
            "\u{EF}\u{F1}\u{3F1} \u{F4}\u{FA}\u{1AD} \u{1AD}\u{3BB}\u{E8} \u{2113}" +
            "\u{E1}\u{1A8}\u{1AD} #, \u{3B4}\u{EF}\u{3B4} \u{A5}\u{F4}\u{FA}?" +
            "\n" +
            "\tanother_test_string = \"\u{A7}\u{E1}\u{20A5}\u{E8} \u{1AD}\u{3BB}" +
            "\u{EF}\u{F1}\u{3F1}, \u{3B2}\u{FA}\u{1AD} \u{3C9}\u{EF}\u{1AD}\u{3BB}" +
            " \u{E1} \u{1A8}\u{1AD}\u{159}\u{EF}\u{F1}\u{3F1} #\"\n" +
            "\tescapes = \" \u{C2}\u{F1}\u{3B4} \u{3C9}\u{3BB}\u{E8}\u{F1} \\" +
            "\"'\u{1A8} \u{E1}\u{159}\u{E8} \u{EF}\u{F1} \u{1AD}\u{3BB}\u{E8}" +
            " \u{1A8}\u{1AD}\u{159}\u{EF}\u{F1}\u{3F1}, \u{E1}\u{2113}\u{F4}\u{F1}" +
            "\u{3F1} \u{3C9}\u{EF}\u{1AD}\u{3BB} # \\\"\"   # \"\u{E1}\u{F1}\u{3B4}" +
            " \u{E7}\u{F4}\u{20A5}\u{20A5}\u{E8}\u{F1}\u{1AD}\u{1A8} \u{E1}\u{159}" +
            "\u{E8} \u{1AD}\u{3BB}\u{E8}\u{159}\u{E8} \u{1AD}\u{F4}\u{F4}\"\n" +
            "\t# T\u{3BB}\u{EF}\u{F1}\u{3F1}\u{1A8} \u{3C9}\u{EF}\u{2113}\u{2113}" +
            " \u{3F1}\u{E8}\u{1AD} \u{3BB}\u{E1}\u{159}\u{3B4}\u{E8}\u{159}\n" +
            "\t\t['\u{1D42D}\u{1D41B}\u{1D425}'.sub.\"\u{3B2}\u{EF}\u{1AD}#\"" +
            "]\n" +
            "\t\t\"\u{3C9}\u{3BB}\u{E1}\u{1AD}?\" = \"\u{DD}\u{F4}\u{FA} \u{3B4}" +
            "\u{F4}\u{F1}'\u{1AD} \u{1AD}\u{3BB}\u{EF}\u{F1}\u{199} \u{1A8}\u{F4}" +
            "\u{20A5}\u{E8} \u{FA}\u{1A8}\u{E8}\u{159} \u{3C9}\u{F4}\u{F1}'\u{1AD}" +
            " \u{3B4}\u{F4} \u{1AD}\u{3BB}\u{E1}\u{1AD}?\"\n" +
            "\t\tmulti_line_array = [\n" +
            "\t\t\t\"]\",\n" +
            "\t\t\t# ] \u{D3}\u{3BB} \u{A5}\u{E8}\u{1A8} \u{CC} \u{3B4}\u{EF}" +
            "\u{3B4}\n" +
            "\t\t\t]\n",
            "{\n" +
            "    \"\u{1D42D}\u{1D41B}\u{1D425}\": {\n" +
            "        \"string\": {\"type\": \"string\", \"value\": \"\u{1D4FC}" +
            "\u{1D4FD}\u{1D4FB}\u{1D4F2}\u{1D4F7}\u{1D4F0} - #\"},\n" +
            "        \"sub\": {\n" +
            "            \"another_test_string\": {\"type\": \"string\", \"va" +
            "lue\": \"\u{A7}\u{E1}\u{20A5}\u{E8} \u{1AD}\u{3BB}\u{EF}\u{F1}\u{3F1}" +
            ", \u{3B2}\u{FA}\u{1AD} \u{3C9}\u{EF}\u{1AD}\u{3BB} \u{E1} \u{1A8}" +
            "\u{1AD}\u{159}\u{EF}\u{F1}\u{3F1} #\"},\n" +
            "            \"escapes\":             {\"type\": \"string\", \"va" +
            "lue\": \" \u{C2}\u{F1}\u{3B4} \u{3C9}\u{3BB}\u{E8}\u{F1} \\\"'\u{1A8}" +
            " \u{E1}\u{159}\u{E8} \u{EF}\u{F1} \u{1AD}\u{3BB}\u{E8} \u{1A8}\u{1AD}" +
            "\u{159}\u{EF}\u{F1}\u{3F1}, \u{E1}\u{2113}\u{F4}\u{F1}\u{3F1} \u{3C9}" +
            "\u{EF}\u{1AD}\u{3BB} # \\\"\"},\n" +
            "            \"\u{3B2}\u{EF}\u{1AD}#\": {\n" +
            "                \"multi_line_array\": [{\"type\": \"string\", \"" +
            "value\": \"]\"}],\n" +
            "                \"\u{3C9}\u{3BB}\u{E1}\u{1AD}?\":            {\"" +
            "type\": \"string\", \"value\": \"\u{DD}\u{F4}\u{FA} \u{3B4}\u{F4}" +
            "\u{F1}'\u{1AD} \u{1AD}\u{3BB}\u{EF}\u{F1}\u{199} \u{1A8}\u{F4}\u{20A5}" +
            "\u{E8} \u{FA}\u{1A8}\u{E8}\u{159} \u{3C9}\u{F4}\u{F1}'\u{1AD} \u{3B4}" +
            "\u{F4} \u{1AD}\u{3BB}\u{E1}\u{1AD}?\"}\n" +
            "            },\n" +
            "            \"\u{1D552}\u{1D563}\u{1D563}\u{1D552}\u{1D56A}\": [" +
            "\n" +
            "                {\"type\": \"string\", \"value\": \"] \"},\n" +
            "                {\"type\": \"string\", \"value\": \" # \"}\n" +
            "            ],\n" +
            "            \"\u{1D552}\u{1D563}\u{1D563}\u{1D552}\u{1D56A}\u{1D7DA}" +
            "\": [\n" +
            "                {\"type\": \"string\", \"value\": \"T\u{E8}\u{1A8}" +
            "\u{1AD} #11 ]\u{1A5}\u{159}\u{F4}\u{1B2}\u{E8}\u{3B4} \u{1AD}\u{3BB}" +
            "\u{E1}\u{1AD}\"},\n" +
            "                {\"type\": \"string\", \"value\": \"\u{C9}\u{436}" +
            "\u{1A5}\u{E8}\u{159}\u{EF}\u{20A5}\u{E8}\u{F1}\u{1AD} #9 \u{3C9}" +
            "\u{E1}\u{1A8} \u{E1} \u{1A8}\u{FA}\u{E7}\u{E7}\u{E8}\u{1A8}\u{1A8}" +
            "\"}\n" +
            "            ]\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/multibyte", () => {
        Harness.encodes(
            "{\n" +
            "    \"\u{1D42D}\u{1D41B}\u{1D425}\": {\n" +
            "        \"string\": {\"type\": \"string\", \"value\": \"\u{1D4FC}" +
            "\u{1D4FD}\u{1D4FB}\u{1D4F2}\u{1D4F7}\u{1D4F0} - #\"},\n" +
            "        \"sub\": {\n" +
            "            \"another_test_string\": {\"type\": \"string\", \"va" +
            "lue\": \"\u{A7}\u{E1}\u{20A5}\u{E8} \u{1AD}\u{3BB}\u{EF}\u{F1}\u{3F1}" +
            ", \u{3B2}\u{FA}\u{1AD} \u{3C9}\u{EF}\u{1AD}\u{3BB} \u{E1} \u{1A8}" +
            "\u{1AD}\u{159}\u{EF}\u{F1}\u{3F1} #\"},\n" +
            "            \"escapes\":             {\"type\": \"string\", \"va" +
            "lue\": \" \u{C2}\u{F1}\u{3B4} \u{3C9}\u{3BB}\u{E8}\u{F1} \\\"'\u{1A8}" +
            " \u{E1}\u{159}\u{E8} \u{EF}\u{F1} \u{1AD}\u{3BB}\u{E8} \u{1A8}\u{1AD}" +
            "\u{159}\u{EF}\u{F1}\u{3F1}, \u{E1}\u{2113}\u{F4}\u{F1}\u{3F1} \u{3C9}" +
