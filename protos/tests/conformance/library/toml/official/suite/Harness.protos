//! LIB010-E2-C conformance harness for the retained official toml-test v2.2.0
//! TOML 1.1 corpus. This is suite-local test support imported by the generated
//! sibling shards; it is not Standard Library API.
//!
//! Expected values arrive as the official tagged-JSON text and are read with
//! `std:json/JSON`. Comparison mirrors the official toml-test comparator
//! (`json.go` at the pinned commit) on the Protos semantic tree:
//!
//! - an object with exactly the two names `type` and `value` is a tagged
//!   atomic value; every other object is a table;
//! - strings and integers compare exactly; booleans compare by value;
//! - floats compare as binary64 values, and any `nan` spelling matches NaN;
//! - temporal values compare as the instant/value the official runner obtains
//!   with Go `time.Parse` + `time.Equal`: nanosecond precision, and offset
//!   date-times are normalized to UTC before comparison.
//!
//! These equivalences are deliberately weaker than the Protos-owned TOML tests
//! (exact fraction digits, D104 second 60, D109 Float spelling, unbounded
//! Integer); those tests stay authoritative for the stronger guarantees.
//!
//! The encoder oracle re-parses `TOML.encode` output with `TOML.parse`, which is
//! not independent of the decoder under test the way the official runner's
//! blessed decoder is. `TOML.parse` is itself held to the official decoder
//! cases, so the corpus still constrains both directions.
//!
//! Tagged scalar spellings are interpreted here, not through `TOML.parse`, so
//! the decoder is never its own oracle. Decimal float spellings become exact
//! rationals, rounded once to binary64 by `Float(Integer / Integer)`.

Arrays: import("std:collections/Array")
Assertions: import("std:test/Assertions")
JSON: import("std:json/JSON")
TOML: import("std:toml/TOML")

fail: () => {
    Error().signal()
}

power10: (exponent) => {
    result: 1
    index: 0
    while(index < exponent) {
        result = result * 10
        index = index + 1
    }
    result
}

isDigit: (octet) => {
    (octet >= 48) && (octet <= 57)
}

/// Answers the exact Integer spelled by `count` ASCII digits at `start`.
digitsAt: (octets, start, count) => {
    if((start + count) > octets.size()) {
        fail()
    }

    result: 0
    index: start
    while(index < (start + count)) {
        octet: octets[index]
        isDigit(octet).ifFalse(() => {
            fail()
        })
        result = result * 10 + (octet - 48)
        index = index + 1
    }
    result
}

expectOctet: (octets, position, expected) => {
    (position < octets.size()).ifFalse(() => {
        fail()
    })
    (octets[position] == expected).ifFalse(() => {
        fail()
    })
}

/// Answers the sign of an optional leading `+`/`-` and the first position after it.
leadingSign: (octets) => {
    negative: false
    start: 0

    if(octets.size() > 0) {
        first: octets[0]
        if(first == 45) {
            negative = true
            start = 1
        }
        if(first == 43) {
            start = 1
        }
    }

    {
        negative: negative
        start: start
    }
}

/// Answers the Integer of an official tagged `integer` spelling.
officialInteger: (text) => {
    octets: Encoding.UTF8.encode(text)
    sign: leadingSign(octets)
    count: octets.size() - sign.start

    (count > 0).ifFalse(() => {
        fail()
    })

    magnitude: digitsAt(octets, sign.start, count)
    result: magnitude
    if(sign.negative) {
        result = 0 - magnitude
    }
    result
}

/// Answers the correctly rounded binary64 Float of a decimal spelling with an
/// optional sign, fraction, and exponent.
decimalFloat: (text) => {
    octets: Encoding.UTF8.encode(text)
    length: octets.size()
    sign: leadingSign(octets)
    position: sign.start
    coefficient: 0
    digitCount: 0
    fractionDigits: 0
    inFraction: false
    scanning: true

    while(scanning) {
        scanning = false
        if(position < length) {
            octet: octets[position]
            if(isDigit(octet)) {
                coefficient = coefficient * 10 + (octet - 48)
                digitCount = digitCount + 1
                if(inFraction) {
                    fractionDigits = fractionDigits + 1
                }
                position = position + 1
                scanning = true
            }
            if(octet == 46) {
                if(inFraction) {
                    fail()
                }
                inFraction = true
                position = position + 1
                scanning = true
            }
        }
    }

    (digitCount > 0).ifFalse(() => {
        fail()
    })

    exponent: 0
    if(position < length) {
        marker: octets[position]
        ((marker == 101) || (marker == 69)).ifFalse(() => {
            fail()
        })
        position = position + 1

        exponentNegative: false
        if(position < length) {
            exponentSign: octets[position]
            if(exponentSign == 45) {
                exponentNegative = true
                position = position + 1
            }
            if(exponentSign == 43) {
                position = position + 1
            }
        }

        (position < length).ifFalse(() => {
            fail()
        })
        exponent = digitsAt(octets, position, length - position)
        if(exponentNegative) {
            exponent = 0 - exponent
        }
    }

    scale: exponent - fractionDigits
    magnitude: null
    if(scale >= 0) {
        magnitude = Float(coefficient * power10(scale))
    }
    if(scale < 0) {
        magnitude = Float(coefficient / power10(0 - scale))
    }

    result: magnitude
    if(sign.negative) {
        result = -magnitude
    }
    result
}

/// Answers the Float of an official tagged `float` spelling.
officialFloat: (text) => {
    positiveInfinity: 1.0 / 0.0
    result: null
    handled: false

    if((text == "nan") || (text == "+nan") || (text == "-nan")) {
        result = 0.0 / 0.0
        handled = true
    }
    if((text == "inf") || (text == "+inf")) {
        result = positiveInfinity
        handled = true
    }
    if(text == "-inf") {
        result = -positiveInfinity
        handled = true
    }
    handled.ifFalse(() => {
        result = decimalFloat(text)
    })
    result
}

isDateTimeSeparator: (octet) => {
    // Go: strings.NewReplacer(" ", "T", "t", "T") before time.Parse.
    (octet == 84) || (octet == 116) || (octet == 32)
}

/// Answers the date fields of `YYYY-MM-DD` at `start`.
officialDate: (octets, start) => {
    year: digitsAt(octets, start, 4)
    expectOctet(octets, start + 4, 45)
    month: digitsAt(octets, start + 5, 2)
    expectOctet(octets, start + 7, 45)
    day: digitsAt(octets, start + 8, 2)

    {
        year: year
        month: month
        day: day
    }
}

/// Answers the time fields of `HH:MM:SS[.fraction]` at `start` and the position
/// after the time.
officialTime: (octets, start) => {
    length: octets.size()
    hour: digitsAt(octets, start, 2)
    expectOctet(octets, start + 2, 58)
    minute: digitsAt(octets, start + 3, 2)
    expectOctet(octets, start + 5, 58)
    second: digitsAt(octets, start + 6, 2)
    position: start + 8
    coefficient: 0
    digits: 0

    if(position < length) {
        if(octets[position] == 46) {
            position = position + 1
            scanning: true
            while(scanning) {
                scanning = false
                if(position < length) {
                    octet: octets[position]
                    if(isDigit(octet)) {
                        coefficient = coefficient * 10 + (octet - 48)
                        digits = digits + 1
                        position = position + 1
                        scanning = true
                    }
                }
            }
            (digits > 0).ifFalse(() => {
                fail()
            })
        }
    }

    {
        hour: hour
        minute: minute
        second: second
        coefficient: coefficient
        digits: digits
        end: position
    }
}

/// Answers the offset minutes of `Z` or `+HH:MM`/`-HH:MM` occupying the rest of
/// `octets` from `start`.
officialOffset: (octets, start) => {
    length: octets.size()
    (start < length).ifFalse(() => {
        fail()
    })

    marker: octets[start]
    result: null
    if((marker == 90) || (marker == 122)) {
        (length == (start + 1)).ifFalse(() => {
            fail()
        })
        result = 0
    }
    if((marker == 43) || (marker == 45)) {
        (length == (start + 6)).ifFalse(() => {
            fail()
        })
        hours: digitsAt(octets, start + 1, 2)
        expectOctet(octets, start + 3, 58)
        minutes: digitsAt(octets, start + 4, 2)
        result = hours * 60 + minutes
        if(marker == 45) {
            result = 0 - result
        }
    }
    if(result === null) {
        fail()
    }
    result
}

/// Answers the temporal fields of an official tagged temporal spelling. Absent
/// fields are zero, so every kind exposes the same field set.
officialTemporal: (tag, text) => {
    octets: Encoding.UTF8.encode(text)
    length: octets.size()
    date: {
        year: 0
        month: 0
        day: 0
    }
    time: {
        hour: 0
        minute: 0
        second: 0
        coefficient: 0
        digits: 0
        end: 0
    }
    offsetMinutes: 0
    handled: false

    if(tag == "date-local") {
        date = officialDate(octets, 0)
        (length == 10).ifFalse(() => {
            fail()
        })
        handled = true
    }
    if(tag == "time-local") {
        time = officialTime(octets, 0)
        (time.end == length).ifFalse(() => {
            fail()
        })
        handled = true
    }
    if((tag == "datetime-local") || (tag == "datetime")) {
        date = officialDate(octets, 0)
        (length > 10).ifFalse(() => {
            fail()
        })
        isDateTimeSeparator(octets[10]).ifFalse(() => {
            fail()
        })
        time = officialTime(octets, 11)
        if(tag == "datetime") {
            offsetMinutes = officialOffset(octets, time.end)
        }
        if(tag == "datetime-local") {
            (time.end == length).ifFalse(() => {
                fail()
            })
        }
        handled = true
    }
    handled.ifFalse(() => {
        fail()
    })

    {
        year: date.year
        month: date.month
        day: date.day
        hour: time.hour
        minute: time.minute
        second: time.second
        coefficient: time.coefficient
        digits: time.digits
        offsetMinutes: offsetMinutes
    }
}

/// Answers a fraction truncated to nanoseconds, the precision of Go `time.Time`.
nanoseconds: (coefficient, digits) => {
    result: null
    if(digits <= 9) {
        result = coefficient * power10(9 - digits)
    }
    if(digits > 9) {
        result = coefficient.div(power10(digits - 9))
    }
    result
}

/// Answers the Julian Day Number of a proleptic Gregorian date with year >= 1.
dayNumber: (year, month, day) => {
    shift: (14 - month).div(12)
    shiftedYear: year + 4800 - shift
    shiftedMonth: month + 12 * shift - 3

    day +
        (153 * shiftedMonth + 2).div(5) +
        365 * shiftedYear +
        shiftedYear.div(4) -
        shiftedYear.div(100) +
        shiftedYear.div(400) -
        32045
}

/// Answers whole seconds since a fixed epoch at UTC, as Go `time.Equal` compares.
utcSeconds: (fields) => {
    dayNumber(fields.year, fields.month, fields.day) * 86400 +
        fields.hour * 3600 +
        fields.minute * 60 +
        fields.second -
        fields.offsetMinutes * 60
}

requireSameDate: (actual, expected) => {
    Assertions.require(actual.year == expected.year)
    Assertions.require(actual.month == expected.month)
    Assertions.require(actual.day == expected.day)
}

requireSameTime: (actual, expected) => {
    Assertions.require(actual.hour == expected.hour)
    Assertions.require(actual.minute == expected.minute)
    Assertions.require(actual.second == expected.second)
    Assertions.require(
        nanoseconds(actual.fraction.coefficient, actual.fraction.digits) ==
            nanoseconds(expected.coefficient, expected.digits)
    )
}

/// Answers the Protos TOML kind named by an official tag.
kindOfTag: (tag) => {
    result: null
    if(tag == "string") { result = "string" }
    if(tag == "integer") { result = "integer" }
    if(tag == "float") { result = "float" }
    if(tag == "bool") { result = "boolean" }
    if(tag == "datetime") { result = "offsetDateTime" }
    if(tag == "datetime-local") { result = "localDateTime" }
    if(tag == "date-local") { result = "localDate" }
    if(tag == "time-local") { result = "localTime" }
    if(result === null) {
        fail()
    }
    result
}

/// Answers whether a JSON node is an official tagged atomic value: an object with
/// exactly the names `type` and `value`, both of which must then be strings.
isTagged: (expected) => {
    result: false
    if(expected.kind == "object") {
        members: expected.value
        if(members.size() == 2) {
            if(members.containsKey("type") && members.containsKey("value")) {
                (members["type"].kind == "string").ifFalse(() => {
                    fail()
                })
                (members["value"].kind == "string").ifFalse(() => {
                    fail()
                })
                result = true
            }
        }
    }
    result
}

requireScalar: (node, expected) => {
    tag: expected.value["type"].value
    text: expected.value["value"].value
    kind: kindOfTag(tag)

    Assertions.require(node.kind == kind)

    if(kind == "string") {
        Assertions.require(node.value == text)
    }
    if(kind == "integer") {
        Assertions.require(node.value == officialInteger(text))
    }
    if(kind == "float") {
        expectedValue: officialFloat(text)
        if(expectedValue == expectedValue) {
            Assertions.require(node.value == expectedValue)
        }
        (expectedValue == expectedValue).ifFalse(() => {
            Assertions.require(node.value != node.value)
        })
    }
    if(kind == "boolean") {
        Assertions.require(node.value === (text == "true"))
    }
    if(kind == "localDate") {
        requireSameDate(node.value, officialTemporal(tag, text))
    }
    if(kind == "localTime") {
        requireSameTime(node.value, officialTemporal(tag, text))
    }
    if(kind == "localDateTime") {
        expectedValue: officialTemporal(tag, text)
        requireSameDate(node.value, expectedValue)
        requireSameTime(node.value, expectedValue)
    }
    if(kind == "offsetDateTime") {
        actual: node.value
        expectedValue: officialTemporal(tag, text)
        Assertions.require(utcSeconds(actual) == utcSeconds(expectedValue))
        Assertions.require(
            nanoseconds(actual.fraction.coefficient, actual.fraction.digits) ==
                nanoseconds(expectedValue.coefficient, expectedValue.digits)
        )
    }
}

/// Requires the Protos TOML node `node` to be equivalent to the official tagged
/// JSON node `expected`.
requireEquivalent: (node, expected) => {
    handled: false

    if(isTagged(expected)) {
        requireScalar(node, expected)
        handled = true
    }
    if(handled === false) {
        if(expected.kind == "object") {
            Assertions.require(node.kind == "table")
            members: expected.value
            Assertions.require(node.value.size() == members.size())
            members.each((name, child) => {
                Assertions.require(node.value.containsKey(name))
                requireEquivalent(node.value[name], child)
            })
            handled = true
        }
    }
    if(handled === false) {
        if(expected.kind == "array") {
            Assertions.require(node.kind == "array")
            items: expected.value
            Assertions.require(node.value.size() == items.size())
            index: 0
            while(index < items.size()) {
                requireEquivalent(node.value[index], items[index])
                index = index + 1
            }
            handled = true
        }
    }
    handled.ifFalse(() => {
        fail()
    })
}

temporalNode: (kind, tag, text) => {
    fields: officialTemporal(tag, text)
    result: null

    if(kind == "localDate") {
        result = TOML.localDate(fields.year, fields.month, fields.day)
    }
    if(kind == "localTime") {
        result = TOML.localTime(
            fields.hour,
            fields.minute,
            fields.second,
            fields.coefficient,
            fields.digits
        )
    }
    if(kind == "localDateTime") {
        result = TOML.localDateTime(
            fields.year,
            fields.month,
            fields.day,
            fields.hour,
            fields.minute,
            fields.second,
            fields.coefficient,
            fields.digits
        )
    }
    if(kind == "offsetDateTime") {
        result = TOML.offsetDateTime(
            fields.year,
            fields.month,
            fields.day,
            fields.hour,
            fields.minute,
            fields.second,
            fields.coefficient,
            fields.digits,
            fields.offsetMinutes
        )
    }
    result
}

/// Answers the Protos TOML semantic node for an official tagged JSON node, built
/// only through the public `std:toml/TOML` constructors.
nodeFromOfficial: (expected) => {
    result: null
    handled: false

    if(isTagged(expected)) {
        tag: expected.value["type"].value
        text: expected.value["value"].value
        kind: kindOfTag(tag)

        if(kind == "string") {
            result = TOML.string(text)
        }
        if(kind == "integer") {
            result = TOML.integer(officialInteger(text))
        }
        if(kind == "float") {
            result = TOML.float(officialFloat(text))
        }
        if(kind == "boolean") {
            ((text == "true") || (text == "false")).ifFalse(() => {
                fail()
            })
            result = TOML.boolean(text == "true")
        }
        if(result === null) {
            result = temporalNode(kind, tag, text)
        }
        handled = true
    }
    if(handled === false) {
        if(expected.kind == "object") {
            pairs: Array()
            expected.value.each((name, child) => {
                pairs = Array(...pairs, name, nodeFromOfficial(child))
            })
            result = TOML.table(...pairs)
            handled = true
        }
    }
    if(handled === false) {
        if(expected.kind == "array") {
            nodes: Arrays.map(expected.value, (item) => {
                nodeFromOfficial(item)
            })
            result = TOML.array(...nodes)
            handled = true
        }
    }
    handled.ifFalse(() => {
        fail()
    })
    result
}

/// Official valid decoder case: `source` must parse to a tree equivalent to the
/// tagged JSON text `expectedJson`.
decodes: (source, expectedJson) => {
    expected: JSON.parse(expectedJson)
    Assertions.require(expected.kind == "object")
    requireEquivalent(TOML.parse(source), expected)
}

/// Official invalid decoder case: parsing `source` must signal an Error.
rejects: (source) => {
    Assertions.signals(Error, () => {
        TOML.parse(source)
    })
}

/// Official encoder case: the tree described by `expectedJson` must encode to
/// TOML text that parses back to an equivalent tree.
encodes: (expectedJson) => {
    expected: JSON.parse(expectedJson)
    Assertions.require(expected.kind == "object")
    encoded: TOML.encode(nodeFromOfficial(expected))
    requireEquivalent(TOML.parse(encoded), expected)
}
