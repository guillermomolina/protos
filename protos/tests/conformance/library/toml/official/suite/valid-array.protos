            "    \"arr-2\": [\n" +
            "        {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "    ],\n" +
            "    \"arr-4\": [\n" +
            "        {\"type\": \"integer\", \"value\": \"5\"},\n" +
            "        {\"type\": \"integer\", \"value\": \"6\"}\n" +
            "    ]\n" +
            "}\n"
        )
    }),
    Test("encoder/array/trailing-comma", () => {
        Harness.encodes(
            "{\n" +
            "    \"arr-1\": [{\"type\": \"integer\", \"value\": \"1\"}],\n" +
            "    \"arr-3\": [{\"type\": \"integer\", \"value\": \"4\"}],\n" +
            "    \"arr-2\": [\n" +
            "        {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "    ],\n" +
            "    \"arr-4\": [\n" +
            "        {\"type\": \"integer\", \"value\": \"5\"},\n" +
            "        {\"type\": \"integer\", \"value\": \"6\"}\n" +
            "    ]\n" +
            "}\n"
        )
    })
]
tests.freeze()
