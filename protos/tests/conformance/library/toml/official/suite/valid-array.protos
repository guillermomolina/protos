    Test("valid/array/trailing-comma", () => {
        Harness.decodes(
            "arr-1 = [1,]\n" +
            "\n" +
            "arr-2 = [2,3,]\n" +
            "\n" +
            "arr-3 = [4,\n" +
            "]\n" +
            "\n" +
            "arr-4 = [\n" +
            "\t5,\n" +
            "\t6,\n" +
            "]\n",
            "{\n" +
            "    \"arr-1\": [{\"type\": \"integer\", \"value\": \"1\"}],\n" +
