            "    }],\n" +
            "    \"arr-2\": [\n" +
            "        {\"type\": \"string\", \"value\": \"str\"},\n" +
            "        {\n" +
            "            \"a\": {\n" +
            "                \"b\": {\"type\": \"integer\", \"value\": \"1\"}" +
            "\n" +
            "            }\n" +
            "        }\n" +
            "    ],\n" +
            "    \"arr-3\": [\n" +
            "        {\n" +
            "            \"a\": {\n" +
            "                \"b\": {\"type\": \"integer\", \"value\": \"1\"}" +
            "\n" +
            "            }\n" +
            "        },\n" +
            "        {\n" +
            "            \"a\": {\n" +
            "                \"b\": {\"type\": \"integer\", \"value\": \"2\"}" +
            "\n" +
            "            }\n" +
            "        }\n" +
            "    ],\n" +
            "    \"arr-4\": [\n" +
            "        {\"type\": \"string\", \"value\": \"str\"},\n" +
            "        {\n" +
            "            \"a\": {\n" +
            "                \"b\": {\"type\": \"integer\", \"value\": \"1\"}" +
            "\n" +
            "            }\n" +
            "        },\n" +
            "        {\n" +
            "            \"a\": {\n" +
            "                \"b\": {\"type\": \"integer\", \"value\": \"2\"}" +
            "\n" +
            "            }\n" +
            "        }\n" +
            "    ]\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/key-dotted-06", () => {
        Harness.decodes(
            "top.dot.dot = [\n" +
            "\t{dot.dot.dot = 1},\n" +
            "\t{dot.dot.dot = 2},\n" +
            "]\n",
            "{\n" +
            "    \"top\": {\n" +
            "        \"dot\": {\n" +
            "            \"dot\": [\n" +
            "                {\n" +
            "                    \"dot\": {\n" +
            "                        \"dot\": {\n" +
            "                            \"dot\": {\"type\": \"integer\", \"v" +
            "alue\": \"1\"}\n" +
            "                        }\n" +
            "                    }\n" +
            "                },\n" +
            "                {\n" +
            "                    \"dot\": {\n" +
            "                        \"dot\": {\n" +
            "                            \"dot\": {\"type\": \"integer\", \"v" +
            "alue\": \"2\"}\n" +
            "                        }\n" +
            "                    }\n" +
            "                }\n" +
            "            ]\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/key-dotted-06", () => {
        Harness.encodes(
            "{\n" +
            "    \"top\": {\n" +
            "        \"dot\": {\n" +
            "            \"dot\": [\n" +
            "                {\n" +
            "                    \"dot\": {\n" +
            "                        \"dot\": {\n" +
            "                            \"dot\": {\"type\": \"integer\", \"v" +
            "alue\": \"1\"}\n" +
            "                        }\n" +
            "                    }\n" +
            "                },\n" +
            "                {\n" +
            "                    \"dot\": {\n" +
            "                        \"dot\": {\n" +
            "                            \"dot\": {\"type\": \"integer\", \"v" +
            "alue\": \"2\"}\n" +
            "                        }\n" +
            "                    }\n" +
            "                }\n" +
            "            ]\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/key-dotted-07", () => {
        Harness.decodes(
            "arr = [\n" +
            "\t{a.b = [{c.d = 1}]}\n" +
            "]\n",
            "{\n" +
            "    \"arr\": [{\n" +
            "        \"a\": {\"b\": [{\n" +
            "            \"c\": {\n" +
            "                \"d\": {\"type\": \"integer\", \"value\": \"1\"}" +
            "\n" +
            "            }\n" +
            "        }]}\n" +
            "    }]\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/key-dotted-07", () => {
        Harness.encodes(
            "{\n" +
            "    \"arr\": [{\n" +
            "        \"a\": {\"b\": [{\n" +
            "            \"c\": {\n" +
            "                \"d\": {\"type\": \"integer\", \"value\": \"1\"}" +
            "\n" +
            "            }\n" +
            "        }]}\n" +
            "    }]\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/multiline", () => {
        Harness.decodes(
            "tbl_multiline = { a = 1, b = \"\"\"\n" +
            "multiline\n" +
            "\"\"\", c = \"\"\"and yet\n" +
            "another line\"\"\", d = 4 }\n",
            "{\n" +
            "    \"tbl_multiline\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"string\", \"value\": \"multiline\\n\"" +
            "},\n" +
            "        \"c\": {\"type\": \"string\", \"value\": \"and yet\\nano" +
            "ther line\"},\n" +
            "        \"d\": {\"type\": \"integer\", \"value\": \"4\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/multiline", () => {
        Harness.encodes(
            "{\n" +
            "    \"tbl_multiline\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"string\", \"value\": \"multiline\\n\"" +
            "},\n" +
            "        \"c\": {\"type\": \"string\", \"value\": \"and yet\\nano" +
            "ther line\"},\n" +
            "        \"d\": {\"type\": \"integer\", \"value\": \"4\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/nest", () => {
        Harness.decodes(
            "tbl_tbl_empty = { tbl_0 = {} }\n" +
            "tbl_tbl_val   = { tbl_1 = { one = 1 } }\n" +
            "tbl_arr_tbl   = { arr_tbl = [ { one = 1 } ] }\n" +
            "arr_tbl_tbl   = [ { tbl = { one = 1 } } ]\n" +
            "\n" +
            "# Array-of-array-of-table is interesting because it can only\n" +
            "# be represented in inline form.\n" +
            "arr_arr_tbl_empty = [ [ {} ] ]\n" +
            "arr_arr_tbl_val = [ [ { one = 1 } ] ]\n" +
            "arr_arr_tbls  = [ [ { one = 1 }, { two = 2 } ] ]\n",
            "{\n" +
            "    \"arr_arr_tbl_empty\": [[{}]],\n" +
            "    \"arr_arr_tbl_val\":   [[{\n" +
            "        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }]],\n" +
            "    \"arr_arr_tbls\":      [[\n" +
            "        {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        },\n" +
            "        {\n" +
            "            \"two\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "        }\n" +
            "    ]],\n" +
            "    \"arr_tbl_tbl\":       [{\n" +
            "        \"tbl\": {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    }],\n" +
            "    \"tbl_arr_tbl\":       {\"arr_tbl\": [{\n" +
            "        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }]},\n" +
            "    \"tbl_tbl_empty\": {\n" +
            "        \"tbl_0\": {}\n" +
            "    },\n" +
            "    \"tbl_tbl_val\": {\n" +
            "        \"tbl_1\": {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/nest", () => {
        Harness.encodes(
            "{\n" +
            "    \"arr_arr_tbl_empty\": [[{}]],\n" +
            "    \"arr_arr_tbl_val\":   [[{\n" +
            "        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }]],\n" +
            "    \"arr_arr_tbls\":      [[\n" +
            "        {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        },\n" +
            "        {\n" +
            "            \"two\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "        }\n" +
            "    ]],\n" +
            "    \"arr_tbl_tbl\":       [{\n" +
            "        \"tbl\": {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    }],\n" +
            "    \"tbl_arr_tbl\":       {\"arr_tbl\": [{\n" +
            "        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }]},\n" +
            "    \"tbl_tbl_empty\": {\n" +
            "        \"tbl_0\": {}\n" +
            "    },\n" +
            "    \"tbl_tbl_val\": {\n" +
            "        \"tbl_1\": {\n" +
            "            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/newline", () => {
        Harness.decodes(
            "# TOML 1.1 supports newlines in inline tables and trailing comma" +
            "s.\n" +
            "\n" +
            "trailing-comma-1 = {\n" +
            "\tc = 1,\n" +
            "}\n" +
            "trailing-comma-2 = { c = 1, }\n" +
            "\n" +
            "tbl-1 = {\n" +
            "\thello = \"world\",\n" +
            "\t1     = 2,\n" +
            "\tarr   = [1,\n" +
            "\t         2,\n" +
            "\t         3,\n" +
            "\t        ],\n" +
            "\ttbl = {\n" +
            "\t\t k = 1,\n" +
            "\t}\n" +
            "}\n" +
            "\n" +
            "tbl-2 = {\n" +
            "\tk = \"\"\"\n" +
            "\tHello\n" +
            "\t\"\"\"\n" +
            "}\n" +
            "\n" +
            "no-newline-before-brace = {\n" +
            "a = 1,\n" +
            "b = 2}\n" +
            "\n" +
            "no-newline-before-brace-with-comma = {\n" +
            "a = 1,\n" +
            "b = 2,}\n",
            "{\n" +
            "    \"no-newline-before-brace\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "    },\n" +
            "    \"no-newline-before-brace-with-comma\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "    },\n" +
            "    \"tbl-1\": {\n" +
            "        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"hello\": {\"type\": \"string\", \"value\": \"world\"}," +
            "\n" +
            "        \"arr\": [\n" +
            "            {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "        ],\n" +
            "        \"tbl\": {\n" +
            "            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    },\n" +
            "    \"tbl-2\": {\n" +
            "        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\" +
            "t\"}\n" +
            "    },\n" +
            "    \"trailing-comma-1\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    },\n" +
            "    \"trailing-comma-2\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/newline", () => {
        Harness.encodes(
            "{\n" +
            "    \"no-newline-before-brace\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "    },\n" +
            "    \"no-newline-before-brace-with-comma\": {\n" +
            "        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n" +
            "    },\n" +
            "    \"tbl-1\": {\n" +
            "        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"hello\": {\"type\": \"string\", \"value\": \"world\"}," +
            "\n" +
            "        \"arr\": [\n" +
            "            {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "        ],\n" +
            "        \"tbl\": {\n" +
            "            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    },\n" +
            "    \"tbl-2\": {\n" +
            "        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\" +
            "t\"}\n" +
            "    },\n" +
            "    \"trailing-comma-1\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    },\n" +
            "    \"trailing-comma-2\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/newline-comment", () => {
        Harness.decodes(
            "# Identical to newline.toml, but with comments that shouldn't af" +
            "fect the\n" +
            "# results.\n" +
            "\n" +
            "trailing-comma-1 = {#comment\n" +
            "\t# comment\n" +
            "\tc = 1,#comment\n" +
            "\t#comment\n" +
            "}#comment\n" +
            "trailing-comma-2 = { c = 1, }#comment\n" +
            "\n" +
            "tbl-1 = {#comment\n" +
            "\thello = \"world\",#comment\n" +
            "\t1     = 2,#comment\n" +
            "\tarr   = [1,#comment\n" +
            "\t         2,#comment\n" +
            "\t         3,#comment\n" +
            "\t        ],#comment\n" +
            "\ttbl = {#comment\n" +
            "\t\t k = 1,#comment\n" +
            "\t}#comment\n" +
            "}#comment\n" +
            "\n" +
            "tbl-2 = {#comment\n" +
            "\tk = \"\"\"\n" +
            "\tHello\n" +
            "\t\"\"\"#comment\n" +
            "}#comment\n",
            "{\n" +
            "    \"tbl-1\": {\n" +
            "        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"hello\": {\"type\": \"string\", \"value\": \"world\"}," +
            "\n" +
            "        \"arr\": [\n" +
            "            {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "        ],\n" +
            "        \"tbl\": {\n" +
            "            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    },\n" +
            "    \"tbl-2\": {\n" +
            "        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\" +
            "t\"}\n" +
            "    },\n" +
            "    \"trailing-comma-1\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    },\n" +
            "    \"trailing-comma-2\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/newline-comment", () => {
        Harness.encodes(
            "{\n" +
            "    \"tbl-1\": {\n" +
            "        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"hello\": {\"type\": \"string\", \"value\": \"world\"}," +
            "\n" +
            "        \"arr\": [\n" +
            "            {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "        ],\n" +
            "        \"tbl\": {\n" +
            "            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "        }\n" +
            "    },\n" +
            "    \"tbl-2\": {\n" +
            "        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\" +
            "t\"}\n" +
            "    },\n" +
            "    \"trailing-comma-1\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    },\n" +
            "    \"trailing-comma-2\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/inline-table/spaces", () => {
        Harness.decodes(
            "# https://github.com/toml-lang/toml-test/issues/146\n" +
            "clap-1 = { version = \"4\"  , features = [\"derive\", \"cargo\"]" +
            " }\n" +
            "\n" +
            "# Contains some literal tabs!\n" +
            "clap-2 = { version = \"4\"\t   \t,\t  \tfeatures = [   \"derive\"" +
            " \t  ,  \t  \"cargo\"   ]   , nest   =   {  \t  \"a\"   =   'x' " +
            " , \t  'b'   = [ 1.5    ,   9.0  ]  }  }\n",
            "{\n" +
            "    \"clap-1\": {\n" +
            "        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n" +
            "        \"features\": [\n" +
            "            {\"type\": \"string\", \"value\": \"derive\"},\n" +
            "            {\"type\": \"string\", \"value\": \"cargo\"}\n" +
            "        ]\n" +
            "    },\n" +
            "    \"clap-2\": {\n" +
            "        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n" +
            "        \"features\": [\n" +
            "            {\"type\": \"string\", \"value\": \"derive\"},\n" +
            "            {\"type\": \"string\", \"value\": \"cargo\"}\n" +
            "        ],\n" +
            "        \"nest\": {\n" +
            "            \"a\": {\"type\": \"string\", \"value\": \"x\"},\n" +
            "            \"b\": [\n" +
            "                {\"type\": \"float\", \"value\": \"1.5\"},\n" +
            "                {\"type\": \"float\", \"value\": \"9\"}\n" +
            "            ]\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/inline-table/spaces", () => {
        Harness.encodes(
            "{\n" +
            "    \"clap-1\": {\n" +
            "        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n" +
            "        \"features\": [\n" +
            "            {\"type\": \"string\", \"value\": \"derive\"},\n" +
            "            {\"type\": \"string\", \"value\": \"cargo\"}\n" +
            "        ]\n" +
            "    },\n" +
            "    \"clap-2\": {\n" +
            "        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n" +
            "        \"features\": [\n" +
            "            {\"type\": \"string\", \"value\": \"derive\"},\n" +
            "            {\"type\": \"string\", \"value\": \"cargo\"}\n" +
            "        ],\n" +
            "        \"nest\": {\n" +
            "            \"a\": {\"type\": \"string\", \"value\": \"x\"},\n" +
            "            \"b\": [\n" +
            "                {\"type\": \"float\", \"value\": \"1.5\"},\n" +
            "                {\"type\": \"float\", \"value\": \"9\"}\n" +
            "            ]\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    })
]
tests.freeze()
