            "}\n" +
            "            }\n" +
            "        }\n" +
            "    },\n" +
            "    \"x\": {\n" +
            "        \"1\": {\n" +
            "            \"2\": {\n" +
            "                \"key\": {\"type\": \"integer\", \"value\": \"8\"" +
            "}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/no-eol", () => {
        Harness.decodes(
            "[table]\n",
            "{\n" +
            "    \"table\": {}\n" +
            "}\n"
        )
    }),
    Test("encoder/table/no-eol", () => {
        Harness.encodes(
            "{\n" +
            "    \"table\": {}\n" +
            "}\n"
        )
    }),
    Test("valid/table/sub", () => {
        Harness.decodes(
            "[a]\n" +
            "key = 1\n" +
            "\n" +
            "# a.extend is a key inside the \"a\" table.\n" +
            "[a.extend]\n" +
            "key = 2\n" +
            "\n" +
            "[a.extend.more]\n" +
            "key = 3\n",
            "{\n" +
            "    \"a\": {\n" +
            "        \"key\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"extend\": {\n" +
            "            \"key\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            \"more\": {\n" +
            "                \"key\": {\"type\": \"integer\", \"value\": \"3\"" +
            "}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/sub", () => {
        Harness.encodes(
            "{\n" +
            "    \"a\": {\n" +
            "        \"key\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "        \"extend\": {\n" +
            "            \"key\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            \"more\": {\n" +
            "                \"key\": {\"type\": \"integer\", \"value\": \"3\"" +
            "}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/sub-empty", () => {
        Harness.decodes(
            "[a]\n" +
            "[a.b]\n",
            "{\n" +
            "    \"a\": {\n" +
            "        \"b\": {}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/sub-empty", () => {
        Harness.encodes(
            "{\n" +
            "    \"a\": {\n" +
            "        \"b\": {}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/whitespace", () => {
        Harness.decodes(
            "[\"valid key\"]\n",
            "{\n" +
            "    \"valid key\": {}\n" +
            "}\n"
        )
    }),
    Test("encoder/table/whitespace", () => {
        Harness.encodes(
            "{\n" +
            "    \"valid key\": {}\n" +
            "}\n"
        )
    }),
    Test("valid/table/with-literal-string", () => {
        Harness.decodes(
            "['a']\n" +
            "[a.'\"b\"']\n" +
            "[a.'\"b\"'.c]\n" +
            "answer = 42 \n",
            "{\n" +
            "    \"a\": {\n" +
            "        \"\\\"b\\\"\": {\n" +
            "            \"c\": {\n" +
            "                \"answer\": {\"type\": \"integer\", \"value\": \"" +
            "42\"}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/with-literal-string", () => {
        Harness.encodes(
            "{\n" +
            "    \"a\": {\n" +
            "        \"\\\"b\\\"\": {\n" +
            "            \"c\": {\n" +
            "                \"answer\": {\"type\": \"integer\", \"value\": \"" +
            "42\"}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/with-pound", () => {
        Harness.decodes(
            "[\"key#group\"]\n" +
            "answer = 42\n",
            "{\n" +
            "    \"key#group\": {\n" +
            "        \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/with-pound", () => {
        Harness.encodes(
            "{\n" +
            "    \"key#group\": {\n" +
            "        \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/with-single-quotes", () => {
        Harness.decodes(
            "['a']\n" +
            "[a.'b']\n" +
            "[a.'b'.c]\n" +
            "answer = 42 \n",
            "{\n" +
            "    \"a\": {\n" +
            "        \"b\": {\n" +
            "            \"c\": {\n" +
            "                \"answer\": {\"type\": \"integer\", \"value\": \"" +
            "42\"}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/with-single-quotes", () => {
        Harness.encodes(
            "{\n" +
            "    \"a\": {\n" +
            "        \"b\": {\n" +
            "            \"c\": {\n" +
            "                \"answer\": {\"type\": \"integer\", \"value\": \"" +
            "42\"}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/without-super", () => {
        Harness.decodes(
            "# [x] you\n" +
            "# [x.y] don't\n" +
            "# [x.y.z] need these\n" +
            "[x.y.z.w] # for this to work\n" +
            "[x] # defining a super-table afterwards is ok\n",
            "{\n" +
            "    \"x\": {\n" +
            "        \"y\": {\n" +
            "            \"z\": {\n" +
            "                \"w\": {}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/without-super", () => {
        Harness.encodes(
            "{\n" +
            "    \"x\": {\n" +
            "        \"y\": {\n" +
            "            \"z\": {\n" +
            "                \"w\": {}\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/table/without-super-with-values", () => {
        Harness.decodes(
            "# [x] you\n" +
            "# [x.y] don't\n" +
            "# [x.y.z] need these\n" +
            "[x.y.z.w] # for this to work\n" +
            "a = 1\n" +
            "b = 2\n" +
            "[x] # defining a super-table afterwards is ok\n" +
            "c = 3\n" +
            "d = 4\n",
            "{\n" +
            "    \"x\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"3\"},\n" +
            "        \"d\": {\"type\": \"integer\", \"value\": \"4\"},\n" +
            "        \"y\": {\n" +
            "            \"z\": {\n" +
            "                \"w\": {\n" +
            "                    \"a\": {\"type\": \"integer\", \"value\": \"" +
            "1\"},\n" +
            "                    \"b\": {\"type\": \"integer\", \"value\": \"" +
            "2\"}\n" +
            "                }\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/table/without-super-with-values", () => {
        Harness.encodes(
            "{\n" +
            "    \"x\": {\n" +
            "        \"c\": {\"type\": \"integer\", \"value\": \"3\"},\n" +
            "        \"d\": {\"type\": \"integer\", \"value\": \"4\"},\n" +
            "        \"y\": {\n" +
            "            \"z\": {\n" +
            "                \"w\": {\n" +
            "                    \"a\": {\"type\": \"integer\", \"value\": \"" +
            "1\"},\n" +
            "                    \"b\": {\"type\": \"integer\", \"value\": \"" +
            "2\"}\n" +
            "                }\n" +
            "            }\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    })
]
tests.freeze()
