            "\"\u{28E}\u{1DD}\u{29E}\" = \"value\"\n" +
            "'key2' = \"value\"\n" +
            "'quoted \"value\"' = \"value\"\n",
            "{\n" +
            "    \"127.0.0.1\":          {\"type\": \"string\", \"value\": \"" +
            "value\"},\n" +
            "    \"character encoding\": {\"type\": \"string\", \"value\": \"" +
            "value\"},\n" +
            "    \"key2\":               {\"type\": \"string\", \"value\": \"" +
            "value\"},\n" +
            "    \"quoted \\\"value\\\"\":   {\"type\": \"string\", \"value\"" +
            ": \"value\"},\n" +
            "    \"\u{28E}\u{1DD}\u{29E}\":                {\"type\": \"strin" +
            "g\", \"value\": \"value\"}\n" +
            "}\n"
