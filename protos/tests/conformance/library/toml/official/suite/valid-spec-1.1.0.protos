            "        {\n" +
            "            \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "            \"y\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            \"z\": {\"type\": \"integer\", \"value\": \"3\"}\n" +
            "        },\n" +
            "        {\n" +
            "            \"x\": {\"type\": \"integer\", \"value\": \"7\"},\n" +
            "            \"y\": {\"type\": \"integer\", \"value\": \"8\"},\n" +
            "            \"z\": {\"type\": \"integer\", \"value\": \"9\"}\n" +
            "        },\n" +
            "        {\n" +
            "            \"x\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "            \"y\": {\"type\": \"integer\", \"value\": \"4\"},\n" +
            "            \"z\": {\"type\": \"integer\", \"value\": \"8\"}\n" +
            "        }\n" +
            "    ]\n" +
            "}\n"
        )
    }),
    Test("valid/spec-1.1.0/common-6", () => {
        Harness.decodes(
            "name = \"Orange\"\n" +
            "physical.color = \"orange\"\n" +
            "physical.shape = \"round\"\n" +
            "site.\"google.com\" = true\n",
            "{\n" +
            "    \"name\": {\"type\": \"string\", \"value\": \"Orange\"},\n" +
            "    \"physical\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"orange\"}" +
            ",\n" +
            "        \"shape\": {\"type\": \"string\", \"value\": \"round\"}\n" +
            "    },\n" +
            "    \"site\": {\n" +
            "        \"google.com\": {\"type\": \"bool\", \"value\": \"true\"" +
            "}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/spec-1.1.0/common-6", () => {
        Harness.encodes(
            "{\n" +
            "    \"name\": {\"type\": \"string\", \"value\": \"Orange\"},\n" +
            "    \"physical\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"orange\"}" +
            ",\n" +
            "        \"shape\": {\"type\": \"string\", \"value\": \"round\"}\n" +
            "    },\n" +
            "    \"site\": {\n" +
            "        \"google.com\": {\"type\": \"bool\", \"value\": \"true\"" +
            "}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/spec-1.1.0/common-7", () => {
        Harness.decodes(
            "fruit.name = \"banana\"       # this is best practice\n" +
            "fruit. color = \"yellow\"     # same as fruit.color\n" +
            "fruit . flavor = \"banana\"   # same as fruit.flavor\n",
            "{\n" +
            "    \"fruit\": {\n" +
            "        \"color\":  {\"type\": \"string\", \"value\": \"yellow\"" +
            "},\n" +
            "        \"flavor\": {\"type\": \"string\", \"value\": \"banana\"" +
            "},\n" +
            "        \"name\":   {\"type\": \"string\", \"value\": \"banana\"" +
            "}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/spec-1.1.0/common-7", () => {
        Harness.encodes(
            "{\n" +
            "    \"fruit\": {\n" +
            "        \"color\":  {\"type\": \"string\", \"value\": \"yellow\"" +
            "},\n" +
            "        \"flavor\": {\"type\": \"string\", \"value\": \"banana\"" +
            "},\n" +
            "        \"name\":   {\"type\": \"string\", \"value\": \"banana\"" +
            "}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/spec-1.1.0/common-8", () => {
        Harness.decodes(
            "# This makes the key \"fruit\" into a table.\n" +
            "fruit.apple.smooth = true\n" +
            "\n" +
            "# So then you can add to the table \"fruit\" like so:\n" +
            "fruit.orange = 2\n",
            "{\n" +
            "    \"fruit\": {\n" +
            "        \"orange\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"apple\": {\n" +
            "            \"smooth\": {\"type\": \"bool\", \"value\": \"true\"" +
            "}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/spec-1.1.0/common-8", () => {
        Harness.encodes(
            "{\n" +
            "    \"fruit\": {\n" +
            "        \"orange\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "        \"apple\": {\n" +
            "            \"smooth\": {\"type\": \"bool\", \"value\": \"true\"" +
            "}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/spec-1.1.0/common-9", () => {
        Harness.decodes(
            "# VALID BUT DISCOURAGED\n" +
            "\n" +
            "apple.type = \"fruit\"\n" +
            "orange.type = \"fruit\"\n" +
            "\n" +
            "apple.skin = \"thin\"\n" +
            "orange.skin = \"thick\"\n" +
            "\n" +
            "apple.color = \"red\"\n" +
            "orange.color = \"orange\"\n",
            "{\n" +
            "    \"apple\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"red\"},\n" +
            "        \"skin\":  {\"type\": \"string\", \"value\": \"thin\"},\n" +
            "        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n" +
            "    },\n" +
            "    \"orange\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"orange\"}" +
            ",\n" +
            "        \"skin\":  {\"type\": \"string\", \"value\": \"thick\"}," +
            "\n" +
            "        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/spec-1.1.0/common-9", () => {
        Harness.encodes(
            "{\n" +
            "    \"apple\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"red\"},\n" +
            "        \"skin\":  {\"type\": \"string\", \"value\": \"thin\"},\n" +
            "        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n" +
            "    },\n" +
            "    \"orange\": {\n" +
            "        \"color\": {\"type\": \"string\", \"value\": \"orange\"}" +
            ",\n" +
            "        \"skin\":  {\"type\": \"string\", \"value\": \"thick\"}," +
            "\n" +
            "        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n" +
            "    }\n" +
            "}\n"
        )
    })
]
