            "value\"},\n" +
            "    \"quoted \\\"value\\\"\":   {\"type\": \"string\", \"value\"" +
            ": \"value\"},\n" +
            "    \"\u{28E}\u{1DD}\u{29E}\":                {\"type\": \"strin" +
            "g\", \"value\": \"value\"}\n" +
            "}\n"
        )
    }),
    Test("valid/spec-1.1.0/common-40", () => {
        Harness.decodes(
            "[a.b.c]            # this is best practice\n" +
            "[ d.e.f ]          # same as [d.e.f]\n" +
            "[ g .  h  . i ]    # same as [g.h.i]\n" +
            "[ j . \"\u{29E}\" . 'l' ]  # same as [j.\"\u{29E}\".'l']\n",
            "{\n" +
            "    \"a\": {\n" +
            "        \"b\": {\n" +
            "            \"c\": {}\n" +
            "        }\n" +
            "    },\n" +
            "    \"d\": {\n" +
            "        \"e\": {\n" +
            "            \"f\": {}\n" +
            "        }\n" +
            "    },\n" +
            "    \"g\": {\n" +
            "        \"h\": {\n" +
            "            \"i\": {}\n" +
            "        }\n" +
            "    },\n" +
