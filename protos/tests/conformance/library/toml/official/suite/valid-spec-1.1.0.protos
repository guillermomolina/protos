            "shape = \"round\"\n" +
            "\n" +
            "[[fruits.varieties]]  # nested array of tables\n" +
            "name = \"red delicious\"\n" +
            "\n" +
            "[[fruits.varieties]]\n" +
            "name = \"granny smith\"\n" +
            "\n" +
            "\n" +
            "[[fruits]]\n" +
