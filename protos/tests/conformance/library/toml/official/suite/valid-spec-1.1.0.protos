            "\n" +
            "[[fruits.varieties]]\n" +
            "name = \"plantain\"\n",
            "{\n" +
            "    \"fruits\": [\n" +
            "        {\n" +
            "            \"name\": {\"type\": \"string\", \"value\": \"apple\"" +
            "},\n" +
            "            \"physical\": {\n" +
            "                \"color\": {\"type\": \"string\", \"value\": \"r" +
            "ed\"},\n" +
            "                \"shape\": {\"type\": \"string\", \"value\": \"r" +
            "ound\"}\n" +
            "            },\n" +
            "            \"varieties\": [\n" +
            "                {\n" +
            "                    \"name\": {\"type\": \"string\", \"value\": " +
            "\"red delicious\"}\n" +
            "                },\n" +
            "                {\n" +
            "                    \"name\": {\"type\": \"string\", \"value\": " +
            "\"granny smith\"}\n" +
            "                }\n" +
            "            ]\n" +
            "        },\n" +
            "        {\n" +
            "            \"name\":      {\"type\": \"string\", \"value\": \"b" +
            "anana\"},\n" +
            "            \"varieties\": [{\n" +
            "                \"name\": {\"type\": \"string\", \"value\": \"pl" +
            "antain\"}\n" +
            "            }]\n" +
            "        }\n" +
            "    ]\n" +
            "}\n"
        )
    }),
