        Harness.encodes(
            "{\n" +
            "    \"lower\": {\"type\": \"datetime\", \"value\": \"1987-07-05T" +
            "17:45:00Z\"},\n" +
            "    \"space\": {\"type\": \"datetime\", \"value\": \"1987-07-05T" +
            "17:45:00Z\"}\n" +
            "}\n"
        )
    }),
