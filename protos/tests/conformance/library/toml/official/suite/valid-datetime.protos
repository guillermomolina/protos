    Test("valid/datetime/datetime", () => {
        Harness.decodes(
            "space = 1987-07-05 17:45:00Z\n" +
            "\n" +
            "# ABNF is case-insensitive, both \"Z\" and \"z\" must be support" +
            "ed.\n" +
            "lower = 1987-07-05t17:45:00z\n",
            "{\n" +
            "    \"lower\": {\"type\": \"datetime\", \"value\": \"1987-07-05T" +
            "17:45:00Z\"},\n" +
            "    \"space\": {\"type\": \"datetime\", \"value\": \"1987-07-05T" +
            "17:45:00Z\"}\n" +
            "}\n"
        )
    }),
