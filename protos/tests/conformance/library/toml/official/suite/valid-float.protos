    Test("valid/float/inf-and-nan", () => {
        Harness.decodes(
            "# We don't encode +nan and -nan back with the signs; many langua" +
            "ges don't\n" +
            "# support a sign on NaN (it doesn't really make much sense).\n" +
            "nan = nan\n" +
            "nan_neg = -nan\n" +
            "nan_plus = +nan\n" +
            "infinity = inf\n" +
            "infinity_neg = -inf\n" +
            "infinity_plus = +inf\n",
            "{\n" +
            "    \"infinity\":      {\"type\": \"float\", \"value\": \"inf\"}" +
            ",\n" +
            "    \"infinity_neg\":  {\"type\": \"float\", \"value\": \"-inf\"" +
            "},\n" +
            "    \"infinity_plus\": {\"type\": \"float\", \"value\": \"inf\"}" +
            ",\n" +
            "    \"nan\":           {\"type\": \"float\", \"value\": \"nan\"}" +
            ",\n" +
            "    \"nan_neg\":       {\"type\": \"float\", \"value\": \"nan\"}" +
            ",\n" +
            "    \"nan_plus\":      {\"type\": \"float\", \"value\": \"nan\"}" +
            "\n" +
            "}\n"
        )
    }),
