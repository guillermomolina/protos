    Test("valid/string/quoted-unicode", () => {
        Harness.decodes(
            "\n" +
            "escaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\" +
            "u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\n" +
            "not_escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007" +
            "f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010fff" +
            "f'\n" +
            "\n" +
            "basic_string = \"~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000}" +
            " \u{10FFFF}\"\n" +
            "literal_string = '~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000}" +
            " \u{10FFFF}'\n",
            "{\n" +
            "    \"basic_string\":   {\"type\": \"string\", \"value\": \"~ \u{80}" +
            " \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}\"},\n" +
            "    \"escaped_string\": {\"type\": \"string\", \"value\": \"\\u0" +
            "000 \\b \\f A \u{7F} \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000}" +
            " \u{10FFFF}\"},\n" +
            "    \"literal_string\": {\"type\": \"string\", \"value\": \"~ \u{80}" +
            " \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}\"},\n" +
            "    \"not_escaped_string\": {\n" +
            "        \"type\":  \"string\",\n" +
            "        \"value\": \"\\\\u0000 \\\\u0008 \\\\u000c \\\\U00000041" +
            " \\\\u007f \\\\u0080 \\\\u00ff \\\\ud7ff \\\\ue000 \\\\uffff \\\\" +
            "U00010000 \\\\U0010ffff\"\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/string/quoted-unicode", () => {
        Harness.encodes(
            "{\n" +
