            "    \"whitespace-after-bs\": {\"type\": \"string\", \"value\": \"" +
            "The quick brown fox jumps over the lazy dog.\"}\n" +
            "}\n"
        )
    }),
    Test("valid/string/multiline-empty", () => {
        Harness.decodes(
            "empty-1 = \"\"\"\"\"\"\n" +
            "\n" +
            "# A newline immediately following the opening delimiter will be " +
            "trimmed.\n" +
            "empty-2 = \"\"\"\n" +
            "\"\"\"\n" +
            "\n" +
            "# \\ at the end of line trims newlines as well; note that last \\" +
            " is followed by\n" +
            "# two spaces, which are ignored.\n" +
            "empty-3 = \"\"\"\\\n" +
            "    \"\"\"\n" +
            "empty-4 = \"\"\"\\\n" +
            "   \\\n" +
            "   \\  \n" +
            "   \"\"\"\n" +
            "\n",
            "{\n" +
            "    \"empty-1\": {\"type\": \"string\", \"value\": \"\"},\n" +
            "    \"empty-2\": {\"type\": \"string\", \"value\": \"\"},\n" +
            "    \"empty-3\": {\"type\": \"string\", \"value\": \"\"},\n" +
            "    \"empty-4\": {\"type\": \"string\", \"value\": \"\"}\n" +
            "}\n"
        )
    }),
    Test("encoder/string/multiline-empty", () => {
        Harness.encodes(
            "{\n" +
            "    \"empty-1\": {\"type\": \"string\", \"value\": \"\"},\n" +
            "    \"empty-2\": {\"type\": \"string\", \"value\": \"\"},\n" +
