    Test("valid/string/unicode-escape", () => {
        Harness.decodes(
            "delta-1 = \"\\u03B4\"\n" +
            "delta-2 = \"\\U000003B4\"\n" +
            "a       = \"\\u0061\"\n" +
            "b       = \"\\u0062\"\n" +
            "c       = \"\\U00000063\"\n" +
            "null-1  = \"\\u0000\"\n" +
            "null-2  = \"\\U00000000\"\n" +
            "\n" +
            "ml-delta-1 = \"\"\"\\u03B4\"\"\"\n" +
            "ml-delta-2 = \"\"\"\\U000003B4\"\"\"\n" +
            "ml-a       = \"\"\"\\u0061\"\"\"\n" +
            "ml-b       = \"\"\"\\u0062\"\"\"\n" +
            "ml-c       = \"\"\"\\U00000063\"\"\"\n" +
            "ml-null-1  = \"\"\"\\u0000\"\"\"\n" +
            "ml-null-2  = \"\"\"\\U00000000\"\"\"\n",
            "{\n" +
            "    \"a\":          {\"type\": \"string\", \"value\": \"a\"},\n" +
            "    \"b\":          {\"type\": \"string\", \"value\": \"b\"},\n" +
            "    \"c\":          {\"type\": \"string\", \"value\": \"c\"},\n" +
            "    \"delta-1\":    {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"delta-2\":    {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-a\":       {\"type\": \"string\", \"value\": \"a\"},\n" +
            "    \"ml-b\":       {\"type\": \"string\", \"value\": \"b\"},\n" +
            "    \"ml-c\":       {\"type\": \"string\", \"value\": \"c\"},\n" +
            "    \"ml-delta-1\": {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-delta-2\": {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-null-1\":  {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"ml-null-2\":  {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"null-1\":     {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"null-2\":     {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "}\n" +
            "}\n"
        )
    }),
    Test("encoder/string/unicode-escape", () => {
        Harness.encodes(
            "{\n" +
            "    \"a\":          {\"type\": \"string\", \"value\": \"a\"},\n" +
            "    \"b\":          {\"type\": \"string\", \"value\": \"b\"},\n" +
            "    \"c\":          {\"type\": \"string\", \"value\": \"c\"},\n" +
            "    \"delta-1\":    {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"delta-2\":    {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-a\":       {\"type\": \"string\", \"value\": \"a\"},\n" +
            "    \"ml-b\":       {\"type\": \"string\", \"value\": \"b\"},\n" +
            "    \"ml-c\":       {\"type\": \"string\", \"value\": \"c\"},\n" +
            "    \"ml-delta-1\": {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-delta-2\": {\"type\": \"string\", \"value\": \"\u{3B4}\"" +
            "},\n" +
            "    \"ml-null-1\":  {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"ml-null-2\":  {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"null-1\":     {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "},\n" +
            "    \"null-2\":     {\"type\": \"string\", \"value\": \"\\u0000\"" +
            "}\n" +
            "}\n"
        )
    }),
    Test("valid/string/with-pound", () => {
        Harness.decodes(
            "pound = \"We see no # comments here.\"\n" +
            "poundcomment = \"But there are # some comments here.\" # Did I #" +
            " mess you up?\n",
            "{\n" +
            "    \"pound\":        {\"type\": \"string\", \"value\": \"We see" +
            " no # comments here.\"},\n" +
            "    \"poundcomment\": {\"type\": \"string\", \"value\": \"But th" +
            "ere are # some comments here.\"}\n" +
            "}\n"
        )
    }),
    Test("encoder/string/with-pound", () => {
        Harness.encodes(
            "{\n" +
            "    \"pound\":        {\"type\": \"string\", \"value\": \"We see" +
            " no # comments here.\"},\n" +
            "    \"poundcomment\": {\"type\": \"string\", \"value\": \"But th" +
            "ere are # some comments here.\"}\n" +
            "}\n"
        )
    })
]
tests.freeze()
