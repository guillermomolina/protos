            "    \"s5\": {\"type\": \"string\", \"value\": \"\u{A7}\"},\n" +
            "    \"s6\": {\"type\": \"string\", \"value\": \"\u{A7}\"},\n" +
            "    \"s7\": {\"type\": \"string\", \"value\": \"\u{A7}\"}\n" +
            "}\n"
        )
    }),
