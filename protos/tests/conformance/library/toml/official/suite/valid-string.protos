    Test("valid/string/hex-escape", () => {
        Harness.decodes(
            "# \\x for the first 255 codepoints\n" +
            "\n" +
            "whitespace      = \"\\x20 \\x09 \\x1b \\x0d\\x0a\"\n" +
            "bs              = \"\\x7f\"\n" +
            "nul             = \"\\x00\"\n" +
            "hello           = \"\\x68\\x65\\x6c\\x6c\\x6f\\x0a\"\n" +
            "higher-than-127 = \"S\\xf8rmirb\\xe6ren\"\n" +
            "\n" +
            "multiline = \"\"\"\n" +
            "\\x20 \\x09 \\x1b \\x0d\\x0a\n" +
            "\\x7f\n" +
            "\\x00\n" +
            "\\x68\\x65\\x6c\\x6c\\x6f\\x0a\n" +
            "\\x53\\xF8\\x72\\x6D\\x69\\x72\\x62\\xE6\\x72\\x65\\x6E\n" +
            "\"\"\"\n" +
            "\n" +
            "# Not inside literals.\n" +
            "literal = '\\x20 \\x09 \\x0d\\x0a'\n" +
            "multiline-literal = '''\n" +
            "\\x20 \\x09 \\x0d\\x0a\n" +
            "'''\n",
            "{\n" +
            "    \"bs\":                {\"type\": \"string\", \"value\": \"\u{7F}" +
            "\"},\n" +
            "    \"hello\":             {\"type\": \"string\", \"value\": \"h" +
            "ello\\n\"},\n" +
            "    \"higher-than-127\":   {\"type\": \"string\", \"value\": \"S" +
            "\u{F8}rmirb\u{E6}ren\"},\n" +
            "    \"literal\":           {\"type\": \"string\", \"value\": \"\\" +
            "\\x20 \\\\x09 \\\\x0d\\\\x0a\"},\n" +
            "    \"multiline\":         {\"type\": \"string\", \"value\": \" " +
            " \\t \\u001b \\r\\n\\n\u{7F}\\n\\u0000\\nhello\\n\\nS\u{F8}rmirb" +
            "\u{E6}ren\\n\"},\n" +
            "    \"multiline-literal\": {\"type\": \"string\", \"value\": \"\\" +
            "\\x20 \\\\x09 \\\\x0d\\\\x0a\\n\"},\n" +
            "    \"nul\":               {\"type\": \"string\", \"value\": \"\\" +
            "u0000\"},\n" +
            "    \"whitespace\":        {\"type\": \"string\", \"value\": \" " +
            " \\t \\u001b \\r\\n\"}\n" +
            "}\n"
        )
    }),
