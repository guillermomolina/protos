    Test("invalid/table/array-implicit", () => {
        Harness.rejects(
            "# This test is a bit tricky. It should fail because the first us" +
            "e of\n" +
            "# `[[albums.songs]]` without first declaring `albums` implies th" +
            "at `albums`\n" +
            "# must be a table. The alternative would be quite weird. Namely," +
            " it wouldn't\n" +
            "# comply with the TOML spec: \"Each double-bracketed sub-table w" +
            "ill belong to \n" +
            "# the most *recently* defined table element *above* it.\"\n" +
            "#\n" +
            "# This is in contrast to the *valid* test, table-array-implicit " +
            "where\n" +
            "# `[[albums.songs]]` works by itself, so long as `[[albums]]` is" +
            "n't declared\n" +
            "# later. (Although, `[albums]` could be.)\n" +
            "[[albums.songs]]\n" +
            "name = \"Glory Days\"\n" +
            "\n" +
            "[[albums]]\n" +
            "name = \"Born in the USA\"\n"
        )
    }),
    Test("invalid/table/array-no-close-01", () => {
