    Test("valid/key/escapes", () => {
        Harness.decodes(
            "\"\\n\" = \"newline\"\n" +
            "\"\\b\" = \"bell\"\n" +
            "\"\\u00c0\" = \"latin capital letter A with grave\"\n" +
            "\"\\\"\" = \"just a quote\"\n" +
            "\n" +
            "[\"backsp\\b\\b\"]\n" +
            "\n" +
            "[\"\\\"quoted\\\"\"]\n" +
            "quote = true\n" +
            "\n" +
            "[\"a.b\".\"\\u00c0\"]\n",
            "{\n" +
            "    \"\\b\":         {\"type\": \"string\", \"value\": \"bell\"}" +
            ",\n" +
            "    \"\\n\":         {\"type\": \"string\", \"value\": \"newline" +
            "\"},\n" +
            "    \"\\\"\":         {\"type\": \"string\", \"value\": \"just a" +
            " quote\"},\n" +
            "    \"backsp\\b\\b\": {},\n" +
            "    \"\u{C0}\":          {\"type\": \"string\", \"value\": \"lat" +
            "in capital letter A with grave\"},\n" +
            "    \"\\\"quoted\\\"\": {\n" +
            "        \"quote\": {\"type\": \"bool\", \"value\": \"true\"}\n" +
            "    },\n" +
            "    \"a.b\": {\n" +
            "        \"\u{C0}\": {}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/key/escapes", () => {
        Harness.encodes(
            "{\n" +
