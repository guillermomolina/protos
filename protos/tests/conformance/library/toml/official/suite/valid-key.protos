    Test("valid/key/quoted-dots", () => {
        Harness.decodes(
            "plain = 1\n" +
            "\"with.dot\" = 2\n" +
            "\n" +
            "[plain_table]\n" +
            "plain = 3\n" +
            "\"with.dot\" = 4\n" +
            "\n" +
            "[table.withdot]\n" +
            "plain = 5\n" +
            "\"key.with.dots\" = 6\n" +
            "\"escaped\\u002edot\" = 7\n",
            "{\n" +
            "    \"plain\":    {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "    \"with.dot\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "    \"plain_table\": {\n" +
            "        \"plain\":    {\"type\": \"integer\", \"value\": \"3\"}," +
            "\n" +
            "        \"with.dot\": {\"type\": \"integer\", \"value\": \"4\"}\n" +
            "    },\n" +
            "    \"table\": {\n" +
            "        \"withdot\": {\n" +
            "            \"escaped.dot\":   {\"type\": \"integer\", \"value\"" +
            ": \"7\"},\n" +
            "            \"key.with.dots\": {\"type\": \"integer\", \"value\"" +
            ": \"6\"},\n" +
            "            \"plain\":         {\"type\": \"integer\", \"value\"" +
            ": \"5\"}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/key/quoted-dots", () => {
        Harness.encodes(
            "{\n" +
            "    \"plain\":    {\"type\": \"integer\", \"value\": \"1\"},\n" +
            "    \"with.dot\": {\"type\": \"integer\", \"value\": \"2\"},\n" +
            "    \"plain_table\": {\n" +
            "        \"plain\":    {\"type\": \"integer\", \"value\": \"3\"}," +
            "\n" +
            "        \"with.dot\": {\"type\": \"integer\", \"value\": \"4\"}\n" +
            "    },\n" +
            "    \"table\": {\n" +
            "        \"withdot\": {\n" +
            "            \"escaped.dot\":   {\"type\": \"integer\", \"value\"" +
            ": \"7\"},\n" +
            "            \"key.with.dots\": {\"type\": \"integer\", \"value\"" +
            ": \"6\"},\n" +
            "            \"plain\":         {\"type\": \"integer\", \"value\"" +
            ": \"5\"}\n" +
            "        }\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("valid/key/quoted-unicode", () => {
        Harness.decodes(
            "\n" +
            "\"\\u0000\" = \"null\"\n" +
            "'\\u0000' = \"different key\"\n" +
            "\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\" +
            "ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\n" +
            "\n" +
            "\"~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "\" = \"basic key\"\n" +
            "'l ~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "' = \"literal key\"\n",
            "{\n" +
            "    \"\\u0000\":               {\"type\": \"string\", \"value\":" +
            " \"null\"},\n" +
            "    \"\\b \\f A \u{7F} \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} " +
            "\u{10000} \u{10FFFF}\": {\"type\": \"string\", \"value\": \"esca" +
            "ped key\"},\n" +
            "    \"\\\\u0000\":              {\"type\": \"string\", \"value\"" +
            ": \"different key\"},\n" +
            "    \"l ~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "\":      {\"type\": \"string\", \"value\": \"literal key\"},\n" +
            "    \"~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "\":        {\"type\": \"string\", \"value\": \"basic key\"}\n" +
            "}\n"
        )
    }),
    Test("encoder/key/quoted-unicode", () => {
        Harness.encodes(
            "{\n" +
            "    \"\\u0000\":               {\"type\": \"string\", \"value\":" +
            " \"null\"},\n" +
            "    \"\\b \\f A \u{7F} \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} " +
            "\u{10000} \u{10FFFF}\": {\"type\": \"string\", \"value\": \"esca" +
            "ped key\"},\n" +
            "    \"\\\\u0000\":              {\"type\": \"string\", \"value\"" +
            ": \"different key\"},\n" +
            "    \"l ~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "\":      {\"type\": \"string\", \"value\": \"literal key\"},\n" +
            "    \"~ \u{80} \u{FF} \u{D7FF} \u{E000} \u{FFFF} \u{10000} \u{10FFFF}" +
            "\":        {\"type\": \"string\", \"value\": \"basic key\"}\n" +
            "}\n"
        )
    }),
    Test("valid/key/space", () => {
        Harness.decodes(
            "# Keep whitespace inside quotes keys at all positions.\n" +
            "\"a b\"   = 1\n" +
            "\" c d \" = 2\n" +
            "\"  much \t\t  whitespace  \t\\n  \\r\\n  \" = 3\n" +
            "\n" +
            "[ \" tbl \" ]\n" +
            "\"\\ttab\\ttab\\t\" = \"tab\"\n",
            "{\n" +
            "    \"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \": {\"type\": " +
            "\"integer\", \"value\": \"3\"},\n" +
            "    \" c d \":                             {\"type\": \"integer\"" +
            ", \"value\": \"2\"},\n" +
            "    \"a b\":                               {\"type\": \"integer\"" +
            ", \"value\": \"1\"},\n" +
            "    \" tbl \": {\n" +
            "        \"\\ttab\\ttab\\t\": {\"type\": \"string\", \"value\": \"" +
            "tab\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
    Test("encoder/key/space", () => {
        Harness.encodes(
            "{\n" +
            "    \"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \": {\"type\": " +
            "\"integer\", \"value\": \"3\"},\n" +
            "    \" c d \":                             {\"type\": \"integer\"" +
            ", \"value\": \"2\"},\n" +
            "    \"a b\":                               {\"type\": \"integer\"" +
            ", \"value\": \"1\"},\n" +
            "    \" tbl \": {\n" +
            "        \"\\ttab\\ttab\\t\": {\"type\": \"string\", \"value\": \"" +
            "tab\"}\n" +
            "    }\n" +
            "}\n"
        )
    }),
