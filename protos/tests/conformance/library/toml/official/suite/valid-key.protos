            " {\"type\": \"integer\", \"value\": \"1\"}\n" +
            "}\n"
        )
    }),
    Test("encoder/key/special-chars", () => {
        Harness.encodes(
            "{\n" +
            "    \"=~!@$^\\u0026*()_+-`1234567890[]|/?\\u003e\\u003c.,;:'=\":" +
            " {\"type\": \"integer\", \"value\": \"1\"}\n" +
