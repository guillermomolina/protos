        Harness.decodes(
            "sectioN = \"NN\"\n" +
            "\n" +
            "[section]\n" +
            "name = \"lower\"\n" +
            "NAME = \"upper\"\n" +
            "Name = \"capitalized\"\n" +
            "\n" +
            "[Section]\n" +
            "name = \"different section!!\"\n" +
            "\"\u{3BC}\" = \"greek small letter mu\"\n" +
            "\"\u{39C}\" = \"greek capital letter MU\"\n" +
            "M = \"latin letter M\"\n" +
            "\n",
            "{\n" +
            "    \"sectioN\": {\"type\": \"string\", \"value\": \"NN\"},\n" +
            "    \"Section\": {\n" +
