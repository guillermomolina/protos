Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("encode all ten semantic kinds with deterministic inline presentation", () => {
        TOML: import("std:toml/TOML")

        root: TOML.table(
            "text", TOML.string("hello"),
            "integer", TOML.integer(123456789012345678901234567890),
            "float", TOML.float(0.1),
            "boolean", TOML.boolean(true),
            "date", TOML.localDate(2024, 2, 29),
            "time", TOML.localTime(23, 59, 60, 123, 5),
            "local", TOML.localDateTime(2025, 1, 2, 3, 4, 5, 6, 3),
            "offset", TOML.offsetDateTime(1979, 5, 27, 0, 32, 0, 0, 0, -420),
            "array", TOML.array(
                TOML.integer(1),
                TOML.table("nested", TOML.string("yes"))
            ),
            "table", TOML.table(
                "inner", TOML.boolean(false)
            )
        )
        text: TOML.encode(root)
        parsed: TOML.parse(text)

        Assertions.require(parsed.value["text"].value == "hello")
        Assertions.require(
            parsed.value["integer"].value == 123456789012345678901234567890
        )
        Assertions.require(parsed.value["float"].value == 0.1)
        Assertions.require(parsed.value["boolean"].value === true)
        Assertions.require(parsed.value["date"].value.year == 2024)
        Assertions.require(parsed.value["time"].value.second == 60)
        Assertions.require(parsed.value["time"].value.fraction.coefficient == 123)
        Assertions.require(parsed.value["time"].value.fraction.digits == 5)
        Assertions.require(parsed.value["local"].value.hour == 3)
        Assertions.require(parsed.value["offset"].value.offsetMinutes == -420)
        Assertions.require(parsed.value["array"].value.size() == 2)
        Assertions.require(parsed.value["array"].value[1].kind === "table")
        Assertions.require(
            parsed.value["array"].value[1].value["nested"].value == "yes"
        )
        Assertions.require(parsed.value["table"].value["inner"].value === false)
    }),
    Test("D109 encodes canonical shortest round-trip float tokens", () => {
        TOML: import("std:toml/TOML")

        encoded: TOML.encode(
            TOML.table(
                "one", TOML.float(1.0),
                "ten", TOML.float(10.0),
                "tenth", TOML.float(0.1),
                "negativeZero", TOML.float(-0.0),
                "positiveInfinity", TOML.float(1.0 / 0.0),
                "negativeInfinity", TOML.float(0.0 - (1.0 / 0.0)),
                "nan", TOML.float(0.0 / 0.0)
            )
        )

        Assertions.require(
            encoded ==
                "\"one\" = 1.0\n" +
                "\"ten\" = 1e1\n" +
                "\"tenth\" = 0.1\n" +
                "\"negativeZero\" = -0.0\n" +
                "\"positiveInfinity\" = inf\n" +
                "\"negativeInfinity\" = -inf\n" +
                "\"nan\" = nan\n"
        )
    }),
    Test("D109 round-trips hard binary64 values without host display semantics", () => {
        TOML: import("std:toml/TOML")

        tiny: 5e-324
        huge: 1.7976931348623157e308
        awkward: 1.2345678901234567

        root: TOML.table(
            "tiny", TOML.float(tiny),
            "huge", TOML.float(huge),
            "awkward", TOML.float(awkward),
            "negativeZero", TOML.float(-0.0)
        )

        parsed: TOML.parse(TOML.encode(root))
        parsedNegativeZero: parsed.value["negativeZero"].value

        Assertions.require(parsed.value["tiny"].value == tiny)
        Assertions.require(parsed.value["huge"].value == huge)
        Assertions.require(parsed.value["awkward"].value == awkward)
        Assertions.require((1.0 / parsedNegativeZero) == (0.0 - (1.0 / 0.0)))
    }),
    Test("encode escapes keys and String values as basic strings", () => {
        TOML: import("std:toml/TOML")

        encoded: TOML.encode(
            TOML.table(
                "space key",
                TOML.string("quote\" slash\\ newline\n")
            )
        )

        Assertions.require(
            encoded ==
                "\"space key\" = \"quote\\\" slash\\\\ newline\\u000A\"\n"
        )
    }),
    Test("encode round-trips nested Arrays at ordinary depth", () => {
        TOML: import("std:toml/TOML")

        node: TOML.integer(7)
        remaining: 32
        (() => remaining > 0).whileTrue(() => {
            node = TOML.array(node)
            remaining = remaining - 1
        })

        parsed: TOML.parse(TOML.encode(TOML.table("deep", node)))
        decoded: parsed.value["deep"]

        remaining = 32
        (() => remaining > 0).whileTrue(() => {
            Assertions.require(decoded.kind === "array")
            Assertions.require(decoded.value.size() == 1)
            decoded = decoded.value[0]
            remaining = remaining - 1
        })

        Assertions.require(decoded.kind === "integer")
        Assertions.require(decoded.value == 7)
    }),
    Test("encode round-trips nested inline Tables at ordinary depth", () => {
        TOML: import("std:toml/TOML")

        node: TOML.integer(9)
        remaining: 32
        (() => remaining > 0).whileTrue(() => {
            node = TOML.table("a", node)
            remaining = remaining - 1
        })

        parsed: TOML.parse(TOML.encode(TOML.table("deep", node)))
        decoded: parsed.value["deep"]

        remaining = 32
        (() => remaining > 0).whileTrue(() => {
            Assertions.require(decoded.kind === "table")
            decoded = decoded.value["a"]
            remaining = remaining - 1
        })

        Assertions.require(decoded.kind === "integer")
        Assertions.require(decoded.value == 9)
    }),
    Test("encode shared acyclic containers with deterministic temporal spelling", () => {
        TOML: import("std:toml/TOML")

        shared: TOML.table("value", TOML.integer(1))
        encoded: TOML.encode(
            TOML.table(
                "left", shared,
                "right", shared,
                "time", TOML.localTime(23, 59, 60, 123, 5),
                "offset", TOML.offsetDateTime(
                    1979, 5, 27, 0, 32, 0, 0, 0, 0
                )
            )
        )

        parsed: TOML.parse(encoded)

        Assertions.require(parsed.value["left"].value["value"].value == 1)
        Assertions.require(parsed.value["right"].value["value"].value == 1)
        Assertions.require(parsed.value["time"].value.second == 60)
        Assertions.require(parsed.value["time"].value.fraction.coefficient == 123)
        Assertions.require(parsed.value["time"].value.fraction.digits == 5)
        Assertions.require(parsed.value["offset"].value.offsetMinutes == 0)
        Assertions.require(
            encoded ==
                "\"left\" = {\"value\" = 1}\n" +
                "\"right\" = {\"value\" = 1}\n" +
                "\"time\" = 23:59:60.00123\n" +
                "\"offset\" = 1979-05-27T00:32:00Z\n"
        )
    })
]
tests.freeze()
