Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parse TOML 1.1 strings numbers booleans and heterogeneous arrays", () => {
        TOML: import("std:toml/TOML")

        input:
            "basic = \"a\\x41\\e\"\n" +
            "literal = 'raw'\n" +
            "multi = \"\"\"hello\\nworld\"\"\"\n" +
            "huge = 1234567890123456789012345678901234567890\n" +
            "hex = 0xCA_FE\n" +
            "oct = 0o755\n" +
            "bin = 0b1010_0110\n" +
            "finite = 1_2.5_0e+1\n" +
            "negativeZero = -0.0\n" +
            "positiveInfinity = +inf\n" +
            "negativeInfinity = -inf\n" +
            "notNumber = nan\n" +
            "items = [1, \"x\", true, 2.5]\n"

        root: TOML.parse(input)

        Assertions.require(root.kind === "table")
        Assertions.require(root.value["basic"].kind === "string")
        Assertions.require(root.value["basic"].value.size() == 3)
        Assertions.require(root.value["literal"].value == "raw")
        Assertions.require(root.value["multi"].value == "hello\nworld")
        Assertions.require(root.value["huge"].kind === "integer")
        Assertions.require(
            root.value["huge"].value == 1234567890123456789012345678901234567890
        )
        Assertions.require(root.value["hex"].value == 51966)
        Assertions.require(root.value["oct"].value == 493)
        Assertions.require(root.value["bin"].value == 166)
        Assertions.require(root.value["finite"].kind === "float")
        Assertions.require(root.value["finite"].value == 125.0)
        Assertions.require((1.0 / root.value["negativeZero"].value) == (-1.0 / 0.0))
        Assertions.require(root.value["positiveInfinity"].value == (1.0 / 0.0))
        Assertions.require(root.value["negativeInfinity"].value == (-1.0 / 0.0))
        Assertions.require(
            (root.value["notNumber"].value == root.value["notNumber"].value) === false
        )
        Assertions.require(root.value["items"].kind === "array")
        Assertions.require(root.value["items"].value.size() == 4)
        Assertions.require(root.value["items"].value[0].kind === "integer")
        Assertions.require(root.value["items"].value[1].kind === "string")
        Assertions.require(root.value["items"].value[2].kind === "boolean")
        Assertions.require(root.value["items"].value[3].kind === "float")
    }),
    Test("parse all temporal kinds with optional seconds and D104 leap second", () => {
        TOML: import("std:toml/TOML")

        input:
            "date = 1979-05-27\n" +
            "time = 07:32\n" +
            "leap = 23:59:60.123400\n" +
            "local = 1979-05-27T07:32\n" +
            "offset = 1979-05-27 00:32:60.999-07:30\n" +
            "zulu = 1979-05-27t07:32:00Z\n"

        root: TOML.parse(input)
        date: root.value["date"]
        time: root.value["time"]
        leap: root.value["leap"]
        local: root.value["local"]
        offset: root.value["offset"]
        zulu: root.value["zulu"]

        Assertions.require(date.kind === "localDate")
        Assertions.require(date.value.year == 1979)
        Assertions.require(date.value.month == 5)
        Assertions.require(date.value.day == 27)
        Assertions.require(time.kind === "localTime")
        Assertions.require(time.value.hour == 7)
        Assertions.require(time.value.minute == 32)
        Assertions.require(time.value.second == 0)
        Assertions.require(leap.kind === "localTime")
        Assertions.require(leap.value.second == 60)
        Assertions.require(leap.value.fraction.coefficient == 123400)
        Assertions.require(leap.value.fraction.digits == 6)
        Assertions.require(local.kind === "localDateTime")
        Assertions.require(local.value.second == 0)
        Assertions.require(offset.kind === "offsetDateTime")
        Assertions.require(offset.value.second == 60)
        Assertions.require(offset.value.offsetMinutes == -450)
        Assertions.require(offset.value.fraction.coefficient == 999)
        Assertions.require(offset.value.fraction.digits == 3)
        Assertions.require(zulu.kind === "offsetDateTime")
        Assertions.require(zulu.value.offsetMinutes == 0)
    }),
    Test("parse tables dotted keys TOML 1.1 inline tables and arrays of tables", () => {
        TOML: import("std:toml/TOML")

        input:
            "title = \"demo\"\n" +
            "owner.name = \"Tom\"\n" +
            "[database]\n" +
            "ports = [8000, 8001]\n" +
            "inline = {\n" +
            "  a = 1,\n" +
            "  # comment between TOML 1.1 inline-table pairs\n" +
            "  nested = { c = 2, },\n" +
            "}\n" +
            "[[products]]\n" +
            "name = \"Hammer\"\n" +
            "[[products]]\n" +
            "name = \"Nail\"\n"

        root: TOML.parse(input)
        owner: root.value["owner"]
        database: root.value["database"]
        inline: database.value["inline"]
        products: root.value["products"]

        Assertions.require(root.value["title"].value == "demo")
        Assertions.require(owner.kind === "table")
        Assertions.require(owner.value["name"].value == "Tom")
        Assertions.require(database.kind === "table")
        Assertions.require(database.value["ports"].value.size() == 2)
        Assertions.require(inline.kind === "table")
        Assertions.require(inline.value["a"].value == 1)
        Assertions.require(inline.value["nested"].kind === "table")
        Assertions.require(inline.value["nested"].value["c"].value == 2)
        Assertions.require(products.kind === "array")
        Assertions.require(products.value.size() == 2)
        Assertions.require(products.value[0].kind === "table")
        Assertions.require(products.value[0].value["name"].value == "Hammer")
        Assertions.require(products.value[1].value["name"].value == "Nail")
    }),
    Test("parse comment containing horizontal tab", () => {
        TOML: import("std:toml/TOML")

        root: TOML.parse("value = 1 # horizontal\tcomment\n")

        Assertions.require(root.kind === "table")
        Assertions.require(root.value["value"].kind === "integer")
        Assertions.require(root.value["value"].value == 1)
    })
]
tests.freeze()
