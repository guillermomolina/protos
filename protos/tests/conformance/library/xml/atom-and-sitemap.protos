Assertions: import("std:test/assertions")
Test: import("std:test/test")
XML: import("std:xml/xml")
F: import("./official/suite/Fixtures.protos")

// These fixtures are original synthetic documents, not captured service responses.
tests: [
    Test("synthetic Atom is queried by expanded names and ordinary attributes", () => {
        atom: "http://www.w3.org/2005/Atom"
        document: XML.parse("<feed xmlns='http://www.w3.org/2005/Atom'><title>News</title><entry><title>A &amp; B</title><author><name>Ada</name></author><link href='https://example.invalid/a'/></entry></feed>")
        entry: XML.firstElement(document.root, atom, "entry")
        Assertions.require(XML.elements(document.root, atom, "entry").size() == 1)
        Assertions.require(XML.textContent(XML.firstElement(entry, atom, "title")) == "A & B")
        author: XML.firstElement(entry, atom, "author")
        Assertions.require(XML.textContent(XML.firstElement(author, atom, "name")) == "Ada")
        Assertions.require(XML.attribute(XML.firstElement(entry, atom, "link"), null, "href") == "https://example.invalid/a")
        true
    }),
    Test("synthetic sitemap generation preserves namespaces and escaped URL text", () => {
        uri: "http://www.sitemaps.org/schemas/sitemap/0.9"
        expandedName: (local) => { { namespaceURI: uri; localName: local; prefix: null } }
        location: { kind: "element"; name: expandedName("loc"); attributes: []; namespaceDeclarations: []; children: [{ kind: "text"; value: "https://example.invalid/?a=1&b=2" }] }
        url: { kind: "element"; name: expandedName("url"); attributes: []; namespaceDeclarations: []; children: [location] }
        elementRoot: { kind: "element"; name: expandedName("urlset"); attributes: []; namespaceDeclarations: [{ prefix: null; namespaceURI: uri }]; children: [url] }
        document: { kind: "document"; declaration: null; prolog: []; root: elementRoot; epilog: [] }
        encoded: XML.encode(document)
        Assertions.require(encoded == "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://example.invalid/?a=1&amp;b=2</loc></url></urlset>")
        Assertions.require(F.equal(XML.parse(encoded), document))
        true
    })
]
tests.freeze()
