Assertions: import("std:test/assertions")
Test: import("std:test/test")
XML: import("std:xml/xml")
F: import("./Fixtures.protos")

tests: [
    Test("deep nesting uses explicit parser tree and encoder stacks", () => {
        count: 200
        source: F.repeat("<r>", count).concat("x", F.repeat("</r>", count))
        document: XML.parse(source, { maxDepth: count })
        Assertions.require(XML.textContent(document.root) == "x")
        Assertions.require(XML.encode(document, { maxDepth: count }) == source)
        failure: Assertions.signals(XML.XmlError, () => { XML.parse(source, { maxDepth: count - 1 }) })
        Assertions.require(failure.limit == "maxDepth")
        true
    }),
    Test("large contiguous text emits complete blocks before finish without retaining a tree", () => {
        blocks: 0; scalars: 0
        parser: XML.eventParser((event) => {
            if(event.kind == "text") { blocks = blocks + 1; scalars = scalars + event.value.size() }
        }, { maxNodes: 2 })
        parser.feed("<r>")
        chunk: F.repeat("😀", 4096)
        i: 0
        while(i < 32) { parser.feed(chunk); i = i + 1; Assertions.require(blocks == i) }
        parser.feed("</r>"); parser.finish(); Assertions.require(scalars == 131072)
        true
    }),
    Test("many children and namespace changes preserve order and scope restoration", () => {
        source: "<r xmlns:p='outer'>".concat(F.repeat("<p:a xmlns:p='inner'/><p:b/>", 1024), "</r>")
        document: XML.parse(source)
        Assertions.require(document.root.children.size() == 2048)
        Assertions.require(document.root.children[2046].name.namespaceURI == "inner")
        Assertions.require(document.root.children[2047].name.namespaceURI == "outer")
        Assertions.require(F.equal(XML.parse(XML.encode(document)), document))
        true
    }),
    Test("long names references and escaped output honor explicit bounded workloads", () => {
        expandedName: F.repeat("n", 1000)
        source: "<".concat(expandedName, ">", F.repeat("&#00000000000000000000000065;", 1024), "</", expandedName, ">")
        document: XML.parse(source)
        Assertions.require(XML.textContent(document.root) == F.repeat("A", 1024))
        failure: Assertions.signals(XML.XmlError, () => { XML.parse("<".concat(F.repeat("n", 1025), "/>")) })
        Assertions.require(failure.limit == "maxNameScalars")
        F.error("syntax", () => { XML.parse("<r>&#999999999999999999999999999999;</r>") }, 3)
        document = XML.parse("<r>".concat(F.repeat("&amp;", 8192), "</r>"))
        Assertions.require(XML.encode(document).size() == 40967)
        true
    })
]
tests.freeze()
