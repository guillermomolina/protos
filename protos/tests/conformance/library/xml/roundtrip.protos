Assertions: import("std:test/assertions")
Test: import("std:test/test")
XML: import("std:xml/xml")
F: import("./Fixtures.protos")

tests: [
    Test("representable documents round-trip with declared encoding deliberately omitted", () => {
        for(source in ["<r/>", "<?xml version='1.0' standalone='no'?><r a='&#13;'>&lt;😀<![CDATA[x]]><!--c--><?p data?><a/>tail</r>", "<r xmlns='u' xmlns:p='v'><p:a xmlns:p='w'/><p:a/><a xmlns=''/></r>"]) {
            original: XML.parse(source); copy: XML.parse(XML.encode(original))
            Assertions.require(F.equal(original, copy))
        }
        document: XML.parse("<?xml version='1.0' encoding='UTF-8'?><r/>")
        Assertions.require(XML.parse(XML.encode(document)).declaration.encoding === null)
        true
    }),
    Test("acyclic alias appearances serialize independently while cycles are rejected", () => {
        leaf: XML.parse("<a>x</a>").root
        elementRoot: { kind: "element"; name: leaf.name; attributes: []; namespaceDeclarations: []; children: [leaf, leaf] }
        document: { kind: "document"; declaration: null; prolog: []; root: elementRoot; epilog: [] }
        Assertions.require(XML.encode(document) == "<a><a>x</a><a>x</a></a>")
        elementRoot.children = [elementRoot]
        F.error("argument", () => { XML.encode(document) })
        true
    }),
    Test("canonical tree encoding rejects adjacent or empty Text and invalid misc nodes", () => {
        original: XML.parse("<r/>")
        elementRoot: { kind: "element"; name: original.root.name; attributes: []; namespaceDeclarations: []; children: [{ kind: "text"; value: "a" }, { kind: "text"; value: "b" }] }
        document: { kind: "document"; declaration: null; prolog: []; root: elementRoot; epilog: [] }
        F.error("argument", () => { XML.encode(document) })
        elementRoot.children = [{ kind: "text"; value: "" }]
        F.error("argument", () => { XML.encode(document) })
        elementRoot.children = []; document.prolog = [elementRoot]
        F.error("argument", () => { XML.encode(document) })
        true
    })
]
tests.freeze()
