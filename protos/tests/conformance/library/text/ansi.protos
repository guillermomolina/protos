Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Style: import("std:text/Style")
StyledText: import("std:text/StyledText")
ANSI: import("std:text/ANSI")

esc: "\u{1B}"
sgr: (code) => {
    esc.concat("[", code, "m")
}
reset: sgr("0")
red: (text) => {
    StyledText(text, Style("red"))
}
blue: (text) => {
    StyledText(text, Style("blue"))
}

// True exactly when `text` contains U+001B.
hasEscape: (text) => {
    found: false
    index: 0
    (() => index < text.size()).whileTrue() {
        (text[index] == esc).ifTrue(() => {
            found = true
        })
        index = index + 1
    }
    found
}

// An object whose reflective and equality behavior records any invocation.
hostile: (parentValue, log) => {
    probe: (parentValue) {
        parent: () => {
            log[0] = true
            StyledText
        }
        slotNames: () => {
            log[0] = true
            []
        }
        hasSlot: (name) => {
            log[0] = true
            false
        }
        slotValue: (name) => {
            log[0] = true
            null
        }
        equals: (other) => {
            log[0] = true
            true
        }
        hash: () => {
            log[0] = true
            0
        }
    }
    probe
}

tests: [
    Test("module exposes only render", () => {
        Assertions.require(ANSI.hasSlot("render"))
        Assertions.require(ANSI.slotNames().size() == 1)
        ["_styleFacility", "_styledTextFacility", "enabled", "detect", "supportsColor", "renderTo", "writer", "Style", "Color", "reset", "codes"].each((name) => {
            Assertions.require(ANSI.hasSlot(name) === false)
        })
        null
    }),
    Test("render answers a String for both styling modes", () => {
        Assertions.require(String.recognizes(ANSI.render(StyledText("a"), true)))
        Assertions.require(String.recognizes(ANSI.render(StyledText("a"), false)))
    }),
    Test("render rejects values that are not styled text", () => {
        unfrozen: (StyledText) {}
        frozen: (StyledText) {}
        frozen.freeze()
        malformed: (StyledText) {
            runs: [["text", Style("red")]]
        }
        malformed.freeze()
        child: (StyledText("text")) {}
        child.freeze()
        invalid: [null, true, 1, "text", Style("red"), [], Map(), {}, StyledText, ANSI, unfrozen, frozen, malformed, child]
        invalid.each((value) => {
            Assertions.signals(Error, () => {
                ANSI.render(value, true)
            })
            Assertions.signals(Error, () => {
                ANSI.render(value, false)
            })
        })
        null
    }),
    Test("render rejects styling flags that are not exactly true or false", () => {
        text: StyledText("a", Style("red"))
        [null, 0, 1, "true", "false", [], {}, Style("red"), text].each((flag) => {
            Assertions.signals(Error, () => {
                ANSI.render(text, flag)
            })
        })
        Assertions.signals(Error, () => {
            ANSI.render(text)
        })
        Assertions.signals(Error, () => {
            ANSI.render(text, true, true)
        })
        null
    }),
    Test("render validation never invokes candidate behavior", () => {
        log: [false]
        probe: hostile(StyledText, log)
        probe.freeze()
        Assertions.signals(Error, () => {
            ANSI.render(probe, true)
        })
        Assertions.signals(Error, () => {
            ANSI.render(probe, false)
        })
        flag: hostile(Object, log)
        Assertions.signals(Error, () => {
            ANSI.render(StyledText("a"), flag)
        })
        Assertions.require(log[0] === false)
    }),
    Test("disabled rendering answers the concatenated text without escapes", () => {
        cases: [
            [StyledText("plain"), "plain"],
            [red("styled"), "styled"],
            [StyledText.concat("A", red("B"), "C"), "ABC"],
            [StyledText.concat(red("a"), blue("b"), StyledText("c", Style("green")), "d", red("e")), "abcde"],
            [StyledText.concat(), ""],
            [StyledText("", Style("red")), ""]
        ]
        cases.each((pair) => {
            rendered: ANSI.render(pair[0], false)
            Assertions.require(rendered == pair[1])
            Assertions.require(hasEscape(rendered) === false)
        })
        null
    }),
    Test("enabled rendering uses the basic foreground codes", () => {
        [["black", "30"], ["red", "31"], ["green", "32"], ["yellow", "33"], ["blue", "34"], ["magenta", "35"], ["cyan", "36"], ["white", "37"]].each((pair) => {
            rendered: ANSI.render(StyledText("x", Style(pair[0])), true)
            Assertions.require(rendered == sgr(pair[1]).concat("x", reset))
        })
        null
    }),
    Test("enabled rendering of default text generates no escapes", () => {
        Assertions.require(ANSI.render(StyledText("hello"), true) == "hello")
        Assertions.require(ANSI.render(StyledText("hello", Style("default")), true) == "hello")
        Assertions.require(ANSI.render(StyledText.concat("a", "b", "c"), true) == "abc")
        Assertions.require(hasEscape(ANSI.render(StyledText.concat("a", "b", "c"), true)) === false)
    }),
    Test("enabled rendering follows the foreground transitions", () => {
        // default -> color, color -> default
        Assertions.require(ANSI.render(StyledText.concat("a", red("b"), "c"), true) == "a".concat(sgr("31"), "b", reset, "c"))
        // same color -> same color
        Assertions.require(ANSI.render(StyledText.concat(red("a"), red("b")), true) == sgr("31").concat("ab", reset))
        Assertions.require(ANSI.render(StyledText.concat(red("a"), StyledText("", Style("blue")), red("b")), true) == sgr("31").concat("ab", reset))
        // color A -> color B
        Assertions.require(ANSI.render(StyledText.concat(red("a"), blue("b")), true) == sgr("31").concat("a", reset, sgr("34"), "b", reset))
        // end with an active color
        Assertions.require(ANSI.render(StyledText.concat("a", blue("b")), true) == "a".concat(sgr("34"), "b", reset))
        // end in default after colors
        Assertions.require(ANSI.render(StyledText.concat(red("a"), blue("b"), "c"), true) == sgr("31").concat("a", reset, sgr("34"), "b", reset, "c"))
    }),
    Test("empty styled text renders as the empty String", () => {
        [StyledText(""), StyledText("", Style("red")), StyledText.concat(), StyledText.concat("", StyledText("", Style("blue")))].each((text) => {
            Assertions.require(ANSI.render(text, false) == "")
            Assertions.require(ANSI.render(text, true) == "")
        })
        null
    }),
    Test("run text passes through unchanged", () => {
        existing: esc.concat("[1mbold", esc, "[0m")
        texts: ["line\nnext\r\n", "tab\tbell\u{7}nul-free\u{1F}", "ñandú 日本 🙂", "e\u{301} combining", "\u{202E}bidi\u{202C}", existing]
        texts.each((text) => {
            Assertions.require(ANSI.render(StyledText(text), false) == text)
            Assertions.require(ANSI.render(StyledText(text), true) == text)
            Assertions.require(ANSI.render(StyledText(text, Style("green")), false) == text)
            Assertions.require(ANSI.render(StyledText(text, Style("green")), true) == sgr("32").concat(text, reset))
        })
        Assertions.require(ANSI.render(StyledText.concat(existing, red("x")), true) == existing.concat(sgr("31"), "x", reset))
        null
    })
]
