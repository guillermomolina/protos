Assertions: import("std:test/assertions")
Test: import("std:test/test")
Markdown: import("std:markdown")

tests: [
    Test("forward full collapsed and shortcut references resolve first definition", () => {
        nodes: Markdown.parse("[x][r] [r][] [r]\n\n[r]: /first \"t\"\n[r]: /second").children[0].children
        for(i in [0, 2, 4]) {
            Assertions.require(nodes[i].kind == "link")
            Assertions.require(nodes[i].destination == "/first")
            Assertions.require(nodes[i].title == "t")
        }
        null
    }),
    Test("reference-only paragraphs disappear", () => {
        root: Markdown.parse("[r]: /u")
        Assertions.require(root.children.size() == 0)
    }),
    Test("expanding full Unicode fold matches sharp S", () => {
        node: Markdown.parse("[STRASSE]\n\n[Straße]: /u").children[0].children[0]
        Assertions.require(node.kind == "link")
        Assertions.require(node.destination == "/u")
    }),
    Test("reference normalization does not add NFC", () => {
        node: Markdown.parse("[é]\n\n[e\u{301}]: /u").children[0].children[0]
        Assertions.require(node.kind == "text")
    }),
    Test("label whitespace collapses without entity decoding", () => {
        node: Markdown.parse("[A B]\n\n[a\t b]: /u").children[0].children[0]
        Assertions.require(node.kind == "link")
        literal: Markdown.parse("[&amp;]\n\n[&]: /u").children[0].children[0]
        Assertions.require(literal.kind == "text")
    }),
    Test("links cannot nest but images remain eligible", () => {
        root: Markdown.parse("[outer [inner](i)](o)")
        Assertions.require(root.children[0].children[1].kind == "link")
        image: Markdown.parse("[![alt](i)](o)").children[0].children[0]
        Assertions.require(image.kind == "link")
        Assertions.require(image.children[0].kind == "image")
    }),
    Test("definition inside blockquote is available outside", () => {
        root: Markdown.parse("[r]\n\n> [r]: /u")
        Assertions.require(root.children[0].children[0].kind == "link")
    }),
    Test("reference labels collapse ASCII vertical whitespace", () => {
        for(separator in ["\u{b}", "\u{c}"]) {
            source: "[a b]\n\n[a".concat(separator, "b]: /u")
            node: Markdown.parse(source).children[0].children[0]
            Assertions.require(node.kind == "link")
            Assertions.require(node.destination == "/u")
        }
        null
    }),
    Test("reference labels do not collapse nonbreaking spaces", () => {
        node: Markdown.parse("[a b]\n\n[a\u{a0}b]: /u").children[0].children[0]
        Assertions.require(node.kind == "text")
        Assertions.require(node.value == "[a b]")
    })
]
tests.freeze()
