Assertions: import("std:test/assertions")
Test: import("std:test/test")
Markdown: import("std:markdown")

tests: [
    Test("Markdown exports exactly two own public slots", () => {
        Assertions.require(Markdown.slotNames().size() == 2)
        Assertions.require(Markdown.hasSlot("parse"))
        Assertions.require(Markdown.hasSlot("MarkdownLimitError"))
        Assertions.require(Markdown.MarkdownLimitError.parent() === Error)
        Assertions.require(Markdown.hasSlot("Parser") === false)
    }),
    Test("empty input is a fresh empty document", () => {
        first: Markdown.parse("")
        second: Markdown.parse("")
        Assertions.require(first.kind == "document")
        Assertions.require(first.children.size() == 0)
        Assertions.require(first !== second)
        Assertions.require(first.children !== second.children)
    })
]
tests.freeze()
