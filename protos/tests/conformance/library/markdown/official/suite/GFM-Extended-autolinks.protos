    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-627", () => {
        tree: Markdown.parse("www.google.com/search?q=commonmark&hl=en\n\nwww.google.com/search?q=commonmark&hl;\n", profile: "commonmark-0.31.2-gfm-extensions")
        Assertions.require(Harness.render(tree) == "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en\">www.google.com/search?q=commonmark&amp;hl=en</a></p>\n<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n")
