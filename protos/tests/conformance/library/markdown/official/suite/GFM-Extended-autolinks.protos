    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-629", () => {
        tree: Markdown.parse("http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n", profile: "commonmark-0.31.2-gfm-extensions")
        Assertions.require(Harness.render(tree) == "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n")
    }),
    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-630", () => {
        tree: Markdown.parse("foo@bar.baz\n", profile: "commonmark-0.31.2-gfm-extensions")
        Assertions.require(Harness.render(tree) == "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n")
    }),
    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-631", () => {
        tree: Markdown.parse("hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n", profile: "commonmark-0.31.2-gfm-extensions")
        Assertions.require(Harness.render(tree) == "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n")
    }),
    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-632", () => {
