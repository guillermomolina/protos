    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-623", () => {
        tree: Markdown.parse("Visit www.commonmark.org/help for more information.\n", profile: "commonmark-0.31.2-gfm-extensions")
        Assertions.require(Harness.render(tree) == "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n")
    }),
    Test("commonmark-0.31.2-gfm-extensions/Extended-autolinks/example-624", () => {
