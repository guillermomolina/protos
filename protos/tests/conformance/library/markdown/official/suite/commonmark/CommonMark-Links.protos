    Test("commonmark-0.31.2/Links/example-559", () => {
        tree: Markdown.parse("[[*foo* bar]]\n\n[*foo* bar]: /url \"title\"\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>[<a href=\"/url\" title=\"title\"><em>foo</em> bar</a>]</p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-560", () => {
        tree: Markdown.parse("[[bar [foo]\n\n[foo]: /url\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>[[bar <a href=\"/url\">foo</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-561", () => {
        tree: Markdown.parse("[Foo]\n\n[foo]: /url \"title\"\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url\" title=\"title\">Foo</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-562", () => {
        tree: Markdown.parse("[foo] bar\n\n[foo]: /url\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url\">foo</a> bar</p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-563", () => {
        tree: Markdown.parse("\\[foo]\n\n[foo]: /url \"title\"\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>[foo]</p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-564", () => {
        tree: Markdown.parse("[foo*]: /url\n\n*[foo*]\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>*<a href=\"/url\">foo*</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-565", () => {
        tree: Markdown.parse("[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url2\">foo</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-566", () => {
        tree: Markdown.parse("[foo][]\n\n[foo]: /url1\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url1\">foo</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-567", () => {
        tree: Markdown.parse("[foo]()\n\n[foo]: /url1\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"\">foo</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-568", () => {
        tree: Markdown.parse("[foo](not a link)\n\n[foo]: /url1\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url1\">foo</a>(not a link)</p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-569", () => {
        tree: Markdown.parse("[foo][bar][baz]\n\n[baz]: /url\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>[foo]<a href=\"/url\">bar</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-570", () => {
        tree: Markdown.parse("[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>\n")
    }),
    Test("commonmark-0.31.2/Links/example-571", () => {
        tree: Markdown.parse("[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n", profile: "commonmark-0.31.2")
        Assertions.require(Harness.render(tree) == "<p>[foo]<a href=\"/url1\">bar</a></p>\n")
    })
]
tests.freeze()
