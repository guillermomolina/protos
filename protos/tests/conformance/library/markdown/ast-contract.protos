    Test("unordered lists have canonical null start and ordinary task state", () => {
        list: Markdown.parse("- x").children[0]
        Assertions.require(list.ordered === false)
        Assertions.require(list.start === null)
        Assertions.require(list.tight === true)
        Assertions.require(list.children[0].task === null)
    }),
    Test("ordered lists retain five and zero starts", () => {
        for(start in [0, 5]) {
            list: Markdown.parse(JSON.encode(JSON.number(start, 0)) + ". x").children[0]
            Assertions.require(list.ordered === true)
            Assertions.require(list.start == start)
        }
        null
    }),
    Test("text coalesces across entity and escape boundaries", () => {
        children: Markdown.parse("a&amp;\\*b").children[0].children
        Assertions.require(children.size() == 1)
        Assertions.require(children[0].value == "a&*b")
    })
]
tests.freeze()
