Assertions: import("std:test/assertions")
JSON: import("std:json/json")
Test: import("std:test/test")
Markdown: import("std:markdown")

tests: [
    Test("exact own slots for document", () => {
        root: Markdown.parse("", profile: "commonmark-0.31.2-gfm-extensions")
        stack: { node: root; next: null }
        found: null
        while(stack !== null) {
            node: stack.node
            stack = stack.next
            if(node.kind == "document") { found = node }
            if(node.hasSlot("children")) {
                for(child in node.children) { stack = { node: child; next: stack } }
            }
        }
        Assertions.require(found !== null)
        Assertions.require(found.slotNames().size() == 2)
        for(name in ["kind", "children"]) { Assertions.require(found.hasSlot(name)) }
        Assertions.require(found.parent() === Object)
        Assertions.require(found.hasSlot("span") === false)
        Assertions.require(found.hasSlot("parent") === false)
    }),
