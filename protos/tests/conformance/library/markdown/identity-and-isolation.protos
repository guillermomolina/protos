Assertions: import("std:test/assertions")
Test: import("std:test/test")
Markdown: import("std:markdown")

tests: [
    Test("mutating a result leaves other invocations independent", () => {
        a: Markdown.parse("*x*", positions: true)
        b: Markdown.parse("*x*", positions: true)
        Assertions.require(a !== b)
        Assertions.require(a.children !== b.children)
        Assertions.require(a.span !== b.span)
        a.children[0].children[0].children[0].value = "changed"
        a.span.start = 99
        Assertions.require(b.children[0].children[0].children[0].value == "x")
        Assertions.require(b.span.start == 0)
        a.extra: true
        Assertions.require(a.extra === true)
    }),
    Test("children arrays and span objects are open ordinary independent values", () => {
        root: Markdown.parse("a\n\nb", positions: true)
        Assertions.require(root.children[0].span !== root.children[1].span)
        root.children[0].span.extra: true
        root.children[0].children[0] = { kind: "text"; value: "replacement" }
        Assertions.require(root.children[1].children[0].value == "b")
    }),
    Test("empty documents have independent open children arrays", () => {
        a: Markdown.parse("", positions: true)
        b: Markdown.parse("", positions: true)
        Assertions.require(a !== b)
        Assertions.require(a.children !== b.children)
        Assertions.require(a.span !== b.span)
        a.children.probe: true
        Assertions.require(b.children.hasSlot("probe") === false)
    }),
    Test("table alignments are fresh mutable arrays", () => {
        source: "|a|b|\n|:-|-:|"
        a: Markdown.parse(source, profile: "commonmark-0.31.2-gfm-extensions").children[0]
        b: Markdown.parse(source, profile: "commonmark-0.31.2-gfm-extensions").children[0]
        Assertions.require(a.alignments !== b.alignments)
        Assertions.require(a.alignments[0] == "left")
        Assertions.require(a.alignments[1] == "right")
        a.alignments[0] = null
        Assertions.require(b.alignments[0] == "left")
    })
]
tests.freeze()
