Assertions: import("std:test/assertions")
Test: import("std:test/test")
Markdown: import("std:markdown")

tests: [
    Test("source domain rejects conversions and delegating impostors", () => {
        for(value in [null, 1, true, {}, String {}]) { Assertions.signals(Error, () => { Markdown.parse(value) }) }
        null
    }),
    Test("profile rejects aliases non-Strings and explicit null", () => {
        for(value in [null, 1, "commonmark", "gfm", "COMMONMARK-0.31.2"]) { Assertions.signals(Error, () => { Markdown.parse("", profile: value) }) }
        null
    }),
    Test("positions accepts only canonical Boolean values", () => {
        for(value in [null, 0, 1, "true", {}]) { Assertions.signals(Error, () => { Markdown.parse("", positions: value) }) }
        Assertions.require(Markdown.parse("", positions: false).hasSlot("span") === false)
        Assertions.require(Markdown.parse("", positions: true).hasSlot("span"))
    }),
    Test("ordinary named association preserves declaration defaults", () => {
        root: Markdown.parse(positions: true, source: "# x")
        Assertions.require(root.children[0].level == 1)
        Assertions.require(root.hasSlot("span"))
    }),
    Test("argument validation precedes the input scalar limit", () => {
        Fixtures: import("./Fixtures.protos")
        source: Fixtures.repeat("x", 1048577)
        error: Assertions.signals(Error, () => { Markdown.parse(source, profile: "invalid") })
        Assertions.require(error.parent() === Error)
    })
]
tests.freeze()
