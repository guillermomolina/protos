Assertions: import("std:test/assertions")
JSON: import("std:json/json")
Test: import("std:test/test")
Markdown: import("std:markdown")
Fixtures: import("./Fixtures.protos")

tests: [
    Test("unmatched delimiters and backticks preserve literal content", () => {
        for(source in [Fixtures.repeat("*a ", 100), Fixtures.repeat("`a ``b ", 100), Fixtures.repeat("[", 500)]) {
            root: Markdown.parse(source)
            Assertions.require(root.kind == "document")
        }
        null
    }),
    Test("balanced destination parentheses do not impose a private depth limit", () => {
        destination: "u".concat(Fixtures.repeat("(", 300), "x", Fixtures.repeat(")", 300))
        node: Markdown.parse("[x](".concat(destination, ")")).children[0].children[0]
        Assertions.require(node.destination == destination)
    }),
    Test("large reference sets resolve forward and repeated uses", () => {
        source: "[r99] [r0] [r99]\n\n"
        i: 0
        while(i < 100) { source = source.concat("[r", JSON.encode(JSON.number(i, 0)), "]: /", JSON.encode(JSON.number(i, 0)), "\n"); i = i + 1 }
        nodes: Markdown.parse(source).children[0].children
        Assertions.require(nodes[0].destination == "/99")
        Assertions.require(nodes[2].destination == "/0")
        Assertions.require(nodes[4].destination == "/99")
    })
]
tests.freeze()
