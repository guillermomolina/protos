//! Test fixture construction only; no parser invocation during discovery.
repeat: (text, count) => {
    result: ""
    chunk: text
    remaining: count
    while(remaining > 0) {
        if(remaining % 2 == 1) { result = result.concat(chunk) }
        remaining = remaining.div(2)
        if(remaining > 0) { chunk = chunk.concat(chunk) }
    }
    result
}

nodeBoundary: (target) => {
    // document + table + header row + two cells + two text nodes = 7.
    rows: (target - 7).div(3)
    remainder: target - 7 - rows * 3
    "|a|b|\n|-|-|\n".concat(repeat("| | |\n", rows), "\n", repeat("***\n\n", remainder))
}

textBoundary: (target) => {
    width: 4096
    uses: (target - 1).div(width + 2)
    tail: target - uses * (width + 2)
    "[r]: ".concat(repeat("u", width), "\n\n", repeat("[x][r] ", uses), repeat("x", tail))
}

depthBoundary: (target) => { repeat("> ", target - 2).concat("x") }

// Independent test oracle over public values only. No parser counters or
// private Limits operations participate in these measurements.
measure: (root, source) => {
    nodes: 0
    depth: 0
    text: 0
    stack: { node: root; depth: 0; next: null }
    while(stack !== null) {
        entry: stack
        stack = entry.next
        nodes = nodes + 1
        if(entry.depth > depth) { depth = entry.depth }
        for(name in ["value", "info", "destination", "title"]) {
            if(entry.node.hasSlot(name)) {
                value: entry.node.slotValue(name)
                if(value !== null) { text = text + value.size() }
            }
        }
        if(entry.node.hasSlot("children")) {
            for(child in entry.node.children) { stack = { node: child; depth: entry.depth + 1; next: stack } }
        }
    }
    { input: source.size(); nodes: nodes; depth: depth; text: text }
}

nodeDimensions: (target) => {
    rows: (target - 7).div(3)
    remainder: target - 7 - rows * 3
    { input: 12 + 6 * rows + 1 + 5 * remainder; nodes: target; depth: 4; text: 2 }
}
textDimensions: (target) => {
    width: 4096
    uses: (target - 1).div(width + 2)
    tail: target - uses * (width + 2)
    { input: 5 + width + 2 + uses * 7 + tail; nodes: 3 * uses + 2; depth: 3; text: target }
}
