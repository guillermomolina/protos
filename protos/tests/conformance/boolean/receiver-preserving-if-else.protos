// D211 contextual if/else. The file name is the historical location of the
// retired D200 receiver-preserving Object.if/Object.else coverage.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("standard Object publishes no if, else, elseIf or elif", () => {
        Assertions.require(Object.hasSlot("if") === false)
        Assertions.require(Object.hasSlot("else") === false)
        Assertions.signals(Error, () => { true.if(() => { 1 }) })
        Assertions.signals(Error, () => { false.else(() => { 1 }) })
        Assertions.signals(Error, () => { true.elseIf(() => { 1 }) })
        Assertions.signals(Error, () => { false.elif(() => { 1 }) })
    }),
    Test("single arm returns the selected result or null", () => {
        Assertions.require(if(true) { 42 } == 42)
        Assertions.require(if(false) { 42 } === null)
    }),
    Test("two arms return the selected branch result", () => {
        Assertions.require(if(true) { 1 } else { 2 } == 1)
        Assertions.require(if(false) { 1 } else { 2 } == 2)
    }),
    Test("selected result is not the Boolean condition", () => {
        Assertions.require(if(true) { false } else { true } === false)
        Assertions.require(if(false) { false } else { null } === null)
    }),
    Test("selected object identity is preserved", () => {
        value: { marker: 42 }
        result: if(true) {
            value
        } else {
            {}
        }
        Assertions.require(result === value)
    }),
    Test("selected future identity is preserved and not awaited", () => {
        pending: (() => { 7 }).future()
        result: if(false) {
            null
        } else {
            pending
        }
        Assertions.require(result === pending)
        failing: null
        produced: if(true) {
            failing = (() => { Error().signal() }).future()
            failing
        }
        Assertions.require(produced === failing)
        Assertions.signals(Error, () => { produced.value() })
    }),
    Test("condition is evaluated eagerly exactly once", () => {
        count: 0
        next: () => {
            count = count + 1
            true
        }
        result: if(next()) {
            42
        } else {
            0
        }
        Assertions.require((count == 1) && (result == 42))
        if(next()) { 1 }
        Assertions.require(count == 2)
    }),
    Test("condition is evaluated before either branch body", () => {
        log: ""
        if((() => {
            log = log + "c"
            false
        })()) {
            log = log + "t"
        } else {
            log = log + "f"
        }
        Assertions.require(log == "cf")
    }),
    Test("unselected branch body is not executed", () => {
        log: ""
        if(true) { log = log + "a" } else { log = log + "b" }
        if(false) { log = log + "c" } else { log = log + "d" }
        if(false) { log = log + "e" }
        Assertions.require(log == "ad")
    }),
    Test("custom two-arm selector receives both branch Closures in order", () => {
        custom: {
            ifTrueIfFalse: (yes, no) => {
                yes() + no()
            }
        }
        Assertions.require(if(custom) { "t" } else { "f" } == "tf")
    }),
    Test("custom ifTrue override is dispatched", () => {
        custom: {
            ifTrue: (body) => {
                body() + 10
            }
        }
        Assertions.require(if(custom) { 32 } == 42)
    }),
    Test("custom if and else member names remain usable", () => {
        custom: {
            if: (body) => { 42 }
            else: (body) => { 43 }
        }
        Assertions.require(custom.if() { 7 } == 42)
        Assertions.require(custom.else() { 7 } == 43)
    }),
    Test("standard selectors are strict about the condition", () => {
        Assertions.signals(Error, () => { if(0) { 1 } })
        Assertions.signals(Error, () => { if(null) { 1 } else { 2 } })
        Assertions.signals(Error, () => { if({}) { 1 } else { 2 } })
    }),
    Test("contextual if composes with postfix suffixes", () => {
        item: { name: "box" }
        Assertions.require(if(true) { item }.name == "box")
        Assertions.require((if(false) { item } else { item }).name == "box")
        Assertions.require(if(true) { [1, 2] } else { [3] }[1] == 2)
    }),
    Test("nested conditionals pair structurally", () => {
        pick: (a, b) => {
            if(a) {
                if(b) { 1 } else { 2 }
            } else {
                3
            }
        }
        Assertions.require(pick(true, true) == 1)
        Assertions.require(pick(true, false) == 2)
        Assertions.require(pick(false, true) == 3)
    }),
    Test("error from the selected branch propagates", () => {
        result: Error.handle(
            () => {
                if(false) { 1 } else { Error().signal() }
            },
            (caught) => { 42 })
        Assertions.require(result == 42)
    }),
    Test("non local return through the selected branch", () => {
        viaTrue: () => {
            if(true) { ^1 }
            100
        }
        viaFalse: () => {
            if(false) { 100 } else { ^2 }
            100
        }
        Assertions.require(viaTrue() + viaFalse() == 3)
    }),
    Test("cancellation observed by the selected branch propagates", () => {
        future: (() => { 42 }).future()
        future.cancel()
        Assertions.signals(Cancelled, () => {
            if(true) { future.value() }
        })
    }),
    Test("selected branch may suspend inside a task without replay", () => {
        outcome: (() => {
            count: 0
            pending: (() => { 41 }).future()
            result: if(true) {
                count = count + 1
                pending.value() + 1
            } else {
                count = count + 100
                0
            }
            [result, count]
        }).future().value()
        Assertions.require(outcome[0] == 42)
        Assertions.require(outcome[1] == 1)
    })
]
tests.freeze()
