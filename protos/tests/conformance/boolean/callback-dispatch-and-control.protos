Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("selected callback may be a non-closure invokable object", () => {
        tool009LegacyCase: () => {
            callable: {
                value: 7
                call: () => { value }
            }
            truthy: { call: () => { true } }
            a: true.ifTrue(callable) * 100
            b: false.ifFalse(callable) * 10
            c: true.ifTrueIfFalse(callable, 0)
            d: true.and(truthy).ifTrueIfFalse(() => { 1000 }, () => { 0 })
            e: false.or(truthy).ifTrueIfFalse(() => { 10000 }, () => { 0 })
            a + b + c + d + e
        }
        Assertions.require(tool009LegacyCase() == 11777)
    }),
    Test("selected non-closure callback with non-invokable call signals error", () => {
        Assertions.signals(Error, () => {
            true.ifTrue({ call: 1 })
        })
    }),
    Test("non local return through selected callbacks", () => {
        tool009LegacyCase: () => {
            viaIfTrue: () => {
                true.ifTrue(() => { ^1 })
                100
            }
            viaIfFalse: () => {
                false.ifFalse(() => { ^2 })
                100
            }
            viaIfTrueIfFalse: () => {
                false.ifTrueIfFalse(() => { 100 }, () => { ^3 })
                100
            }
            viaAnd: () => {
                true.and(() => { ^4 })
                100
            }
            viaOr: () => {
                false.or(() => { ^5 })
                100
            }
            viaIfTrue() + viaIfFalse() + viaIfTrueIfFalse() + viaAnd() + viaOr()
        }
        Assertions.require(tool009LegacyCase() == 15)
    }),
    Test("error from selected callback propagates", () => {
        tool009LegacyCase: () => {
            Error.handle(
                () => { true.ifTrue(() => { Error().signal() }) },
                (caught) => { 42 })
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("custom same-name selector stays ordinary", () => {
        tool009LegacyCase: () => {
            invoked: 0
            custom: {
                ifTrue: (callback) => { 11 }
                and: (callback) => { 22 }
            }
            first: custom.ifTrue(() => { invoked = invoked + 1 })
            second: custom.and(() => { invoked = invoked + 1 })
            first + second + invoked
        }
        Assertions.require(tool009LegacyCase() == 33)
    }),
    Test("copied standard ifTrue keeps its non-boolean receiver", () => {
        Assertions.signals(Error, () => {
            copied: Object.slotValue("ifTrue")
            holder: {
                ifTrue: copied
            }
            holder.ifTrue(() => { 1 })
        })
    })
]
tests.freeze()
