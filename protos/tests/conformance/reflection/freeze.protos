Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("freeze arity", () => {
        Assertions.signals(Error, () => {
            value: {
                existing: 1
            }
            value.freeze(1)
        })
    })
    Test("freeze array indexed replacement rejected", () => {
        tool009LegacyCase: () => {
            value: Array(1)
            same: value.freeze() === value
            failed: false
            Error.handle(() => {
                value[0] = 2
                null
            }, (error) => {
                failed = true
                null
            })
            same && failed && (value[0] == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze exact receiver idempotent", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            first: value.freeze()
            second: value.freeze()
            (first === value) && (second === value) && (first === second)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze from closed rejects existing assignment", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.close()
            same: value.freeze() === value
            failed: false
            Error.handle(() => {
                value.existing = 2
                null
            }, (error) => {
                failed = true
                null
            })
            same && failed && (value.existing == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze frozen root idempotent", () => {
        tool009LegacyCase: () => {
            same: Object.freeze() === Object
            failed: false
            before: Object.hasSlot("slotNames")
            Error.handle(() => {
                Object.removeSlot("slotNames")
                null
            }, (error) => {
                failed = true
                null
            })
            same && before && failed && Object.hasSlot("slotNames")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze is shallow", () => {
        tool009LegacyCase: () => {
            inner: {
                existing: 1
            }
            outer: {
                child: inner
            }
            same: outer.freeze() === outer
            inner.existing = 2
            inner.added: 3
            same && (outer.child === inner) && (inner.existing == 2) && (inner.added == 3)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze map keyed replacement rejected", () => {
        tool009LegacyCase: () => {
            value: Map()
            value["a"] = 1
            same: value.freeze() === value
            failed: false
            Error.handle(() => {
                value["a"] = 2
                null
            }, (error) => {
                failed = true
                null
            })
            same && failed && (value["a"] == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze rejects existing assignment", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.freeze()
            failed: false
            Error.handle(() => {
                value.existing = 2
                null
            }, (error) => {
                failed = true
                null
            })
            failed && (value.existing == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze rejects remove preserves local", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.freeze()
            failed: false
            Error.handle(() => {
                value.removeSlot("existing")
                null
            }, (error) => {
                failed = true
                null
            })
            failed && value.hasSlot("existing") && (value.existing == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("freeze rejects slot creation", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.freeze()
            failed: false
            Error.handle(() => {
                value.added: 2
                null
            }, (error) => {
                failed = true
                null
            })
            failed && !value.hasSlot("added")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
