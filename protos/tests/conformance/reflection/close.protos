Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("close allows existing assignment", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.close()
            value.existing = 2
            value.existing == 2
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close arity", () => {
        Assertions.signals(Error, () => {
            value: {
                existing: 1
            }
            value.close(1)
        })
    })
    Test("close array indexed replacement remains allowed", () => {
        tool009LegacyCase: () => {
            value: Array(1)
            same: value.close() === value
            value[0] = 2
            same && (value[0] == 2)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close exact receiver idempotent", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            first: value.close()
            second: value.close()
            (first === value) && (second === value) && (first === second)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close frozen root idempotent", () => {
        tool009LegacyCase: () => {
            same: Object.close() === Object
            failed: false
            before: Object.hasSlot("slotNames")

            Error.handle(() => {
                Object.removeSlot("slotNames")
                null
            }, (error) => {
                failed = true
                null
            })

            same && before && failed && Object.hasSlot("slotNames")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close is shallow", () => {
        tool009LegacyCase: () => {
            inner: {
                existing: 1
            }
            outer: {
                child: inner
            }
            outer.close()
            inner.added: 2
            (outer.child === inner) && (inner.existing == 1) && (inner.added == 2)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close rejects remove preserves local", () => {
        tool009LegacyCase: () => {
            payload: {
                marker: 7
            }
            value: {
                existing: payload
            }
            value.close()
            failed: false

            Error.handle(() => {
                value.removeSlot("existing")
                null
            }, (error) => {
                failed = true
                null
            })

            failed && value.hasSlot("existing") && (value.slotValue("existing") === payload)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
    Test("close rejects slot creation", () => {
        tool009LegacyCase: () => {
            value: {
                existing: 1
            }
            value.close()
            failed: false

            Error.handle(() => {
                value.added: 2
                null
            }, (error) => {
                failed = true
                null
            })

            failed && (value.hasSlot("added") === false) && (value.existing == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
