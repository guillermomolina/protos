Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("slot names arity", () => {
        Assertions.signals(Error, () => {
            value: {}
            value.slotNames(1)
        })
    }),
    Test("slot names empty fresh standard array", () => {
        tool009LegacyCase: () => {
            value: {}
            first: value.slotNames()
            second: value.slotNames()

            (first.size() == 0) &&
                (second.size() == 0) &&
                (first !== second) &&
                (first.parent() === Array) &&
                (second.parent() === Array)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("slot names fresh independent snapshot", () => {
        tool009LegacyCase: () => {
            value: {
                alpha: 1
                beta: 2
            }

            first: value.slotNames()
            second: value.slotNames()
            first[0] = "mutated"
            third: value.slotNames()

            (first !== second) &&
                (second !== third) &&
                (first[0] == "mutated") &&
                (second[0] == "alpha") &&
                (second[1] == "beta") &&
                (third[0] == "alpha") &&
                (third[1] == "beta")
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("slot names local order", () => {
        tool009LegacyCase: () => {
            base: {
                inherited: 99
            }
            child: base {
                beta: 2
                alphabet: 3
                alpha: 1
            }

            names: child.slotNames()
            (names.size() == 3) &&
                (names[0] == "alpha") &&
                (names[1] == "alphabet") &&
                (names[2] == "beta")
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("slot names represented values", () => {
        tool009LegacyCase: () => {
            first: (42).slotNames()
            second: (42).slotNames()
            text: ("hello").slotNames()

            (first.size() == 0) &&
                (second.size() == 0) &&
                (text.size() == 0) &&
                (first !== second) &&
                (first.parent() === Array) &&
                (second.parent() === Array) &&
                (text.parent() === Array)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("slot names unicode scalar order", () => {
        tool009LegacyCase: () => {
            value: {
                z: 1
                Ａ: 2
                𐐀: 3
            }

            names: value.slotNames()
            (names.size() == 3) &&
                (names[0] == "z") &&
                (names[1] == "Ａ") &&
                (names[2] == "𐐀")
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
