Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("object match receiver equality", () => {
        tool009LegacyCase: () => {
            state: {
                matcherCalls: 0
                subjectCalls: 0
            }

            MatcherBase: {
                equalTo: (other) => {
                    state.matcherCalls = state.matcherCalls + 1
                    true
                }
            }
            Matcher: MatcherBase.alias("equalTo", "==")

            SubjectBase: {
                equalTo: (other) => {
                    state.subjectCalls = state.subjectCalls + 1
                    false
                }
            }
            Subject: SubjectBase.alias("equalTo", "==")

            matched: Matcher.match(Subject)

            matched &&
                state.matcherCalls == 1 &&
                state.subjectCalls == 0
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
