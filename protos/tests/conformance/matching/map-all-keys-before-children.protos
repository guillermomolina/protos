state: {
    keys: 0
    firstChildren: 0
    secondChildren: 0
}

subject: Map()
subject["a"] = 1
subject["b"] = 2

keyA: () => {
    state.keys = state.keys * 10 + 1
    "a"
}

keyB: () => {
    state.keys = state.keys * 10 + 2
    "b"
}

firstPattern: {
    match: (value) => {
        state.firstChildren = state.firstChildren + 1
        subject["b"] = 99
        value == 1
    }
}

secondPattern: {
    match: (value) => {
        state.secondChildren = state.secondChildren + 1
        (state.keys == 12) && (value == 2)
    }
}

subject match {
    case %{ keyA(): firstPattern, keyB(): secondPattern } =>
        (state.firstChildren == 1) &&
        (state.secondChildren == 1) &&
        (subject["b"] == 99)
    case _ => false
}
