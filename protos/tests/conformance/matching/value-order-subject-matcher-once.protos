state: {
    subjectCalls: 0
    missCalls: 0
    winnerFactoryCalls: 0
    winnerCalls: 0
    bodyCalls: 0
}

subject: {}

subjectFactory: () => {
    state.subjectCalls = state.subjectCalls + 1
    subject
}

miss: {
    match: (candidate) => {
        state.missCalls = state.missCalls + 1
        false
    }
}

winnerFactory: () => {
    state.winnerFactoryCalls = state.winnerFactoryCalls + 1
    {
        match: (candidate) => {
            state.winnerCalls = state.winnerCalls + 1
            candidate === subject
        }
    }
}

result: subjectFactory() match {
    case miss => 0
    case winnerFactory() => {
        state.bodyCalls = state.bodyCalls + 1
        42
    }
    case missingPattern => 99
}

(result == 42) &&
    (state.subjectCalls == 1) &&
    (state.missCalls == 1) &&
    (state.winnerFactoryCalls == 1) &&
    (state.winnerCalls == 1) &&
    (state.bodyCalls == 1)
