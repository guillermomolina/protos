state: {
    order: 0
    keyCalls: 0
}

subject: Map()
subject["a"] = 1
subject["b"] = 2

keyA: () => {
    state.order = state.order * 10 + 1
    state.keyCalls = state.keyCalls + 1
    subject["late"] = 99
    "a"
}

keyB: () => {
    state.order = state.order * 10 + 2
    state.keyCalls = state.keyCalls + 1
    "b"
}

result: subject match {
    case %{ keyA(): @a, keyB(): @b, ...@rest } =>
        (a == 1) &&
        (b == 2) &&
        (state.order == 12) &&
        (state.keyCalls == 2) &&
        (rest.size() == 0) &&
        (subject.size() == 3)
    case _ => false
}

result
