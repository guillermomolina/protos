Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("add", () => {
        tool009LegacyCase: () => {
            1.5 + 2.25
        }
        Assertions.require(tool009LegacyCase() === 3.75)
    }),
    Test("subtract", () => {
        tool009LegacyCase: () => {
            1.5 - 2.25
        }
        Assertions.require(tool009LegacyCase() === -0.75)
    }),
    Test("multiply", () => {
        tool009LegacyCase: () => {
            1.5 * 2.0
        }
        Assertions.require(tool009LegacyCase() === 3.0)
    }),
    Test("divide", () => {
        tool009LegacyCase: () => {
            1.0 / 2.0
        }
        Assertions.require(tool009LegacyCase() === 0.5)
    }),
    Test("mixed huge denominator converts before division", () => {
        huge: 
        Assertions.require((0.5 / huge) === 0.0)
        Assertions.require((-0.5 / huge) === -0.0)
    }),
    Test("mixed huge multiplication produces NaN", () => {
        huge: 
        Assertions.require((0.0 * huge) === (0.0 / 0.0))
    }),
    Test("Float divided by Integer zero follows IEEE", () => {
        Assertions.require((1.0 / 0) === (1.0 / 0.0))
    }),
    Test("negated normal", () => {
        tool009LegacyCase: () => {
            -1.5
        }
        Assertions.require(tool009LegacyCase() === -1.5)
    })
]
tests.freeze()
