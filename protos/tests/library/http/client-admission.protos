Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Client")

// Latin1 keeps every test octet byte-exact, including obs-text 0x80-0xFF.
ascii: (text) => {
    Encoding.Latin1.encode(text)
}

text: (bytes) => {
    Encoding.Latin1.decode(bytes)
}

// Deterministic scripted duplex. Each read answers the next queued response
// chunk, split to maxBytes, and null once the chunks are exhausted; every
// requested maxBytes is recorded. Writes are captured at invocation.
// Optional hooks: readFailure, writeFailure, closeFailure (Errors), and
// onWrite (a callback run by each write).
duplexOf: (chunks) => {
    next: 0
    offset: 0
    output: ascii("")
    reads: 0
    writes: 0
    closes: 0
    shutdowns: 0
    requested: []
    closeCompleted: false
    readFailure: null
    writeFailure: null
    closeFailure: null
    onWrite: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            requested = Array(...requested, maxBytes)
            failure: readFailure
            result: null
            if((failure === null) && (next < chunks.size())) {
                chunk: chunks[next]
                end: chunk.size()
                if((end - offset) > maxBytes) {
                    end = offset + maxBytes
                }
                result = ascii("")
                index: offset
                while(index < end) {
                    result.add(chunk[index])
                    index = index + 1
                }
                if(end == chunk.size()) {
                    next = next + 1
                    offset = 0
                } else {
                    offset = end
                }
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            if(onWrite !== null) {
                onWrite(bytes)
            }
            failure: writeFailure
            if(failure === null) {
                bytes.each((octet) => {
                    output.add(octet)
                })
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                fixture
            }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                closeCompleted = true
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        shutdownRead: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        shutdownWrite: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        written: () => {
            text(output)
        }
        readCount: () => {
            reads
        }
        readSizes: () => {
            requested
        }
        unreadChunks: () => {
            chunks.size() - next
        }
        writeCount: () => {
            writes
        }
        closeCount: () => {
            closes
        }
        shutdownCount: () => {
            shutdowns
        }
        closeDone: () => {
            closeCompleted
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failWritesWith: (error) => {
            writeFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        whenWriting: (callback) => {
            onWrite = callback
        }
    }
    fixture
}

// Answers the Error a Future fails with, or null when it resolves.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

// Answers whether the Future ends cancelled.
cancelledOf: (future) => {
    Cancelled.handle(
        () => {
            future.value()
            false
        },
        (cancellation) => {
            true
        }
    )
}

hostField: () => {
    ["Host", ascii("example.org")]
}

requestOf: (method, target, headers, body) => {
    request: {
        method: method
        target: ascii(target)
        headers: headers
        body: body
    }
    request
}

get: () => {
    requestOf("GET", "/", [hostField()], null)
}

getBytes: "GET / HTTP/1.1\r\nHost: example.org\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"

// Reads a body to its logical end with reads of size, answering its text.
drain: (body, size) => {
    collected: ascii("")
    done: false
    while(!done) {
        chunk: body.read(size).value()
        if(chunk === null) {
            done = true
        } else {
            Assertions.require(chunk.size() > 0)
            Assertions.require(chunk.size() <= size)
            chunk.each((octet) => {
                collected.add(octet)
            })
        }
    }
    text(collected)
}

// A callback answering {status, headers, body} with the body drained.
capture: (response) => {
    seen: {
        status: response.status
        version: response.version
        headers: response.headers
        body: drain(response.body, 4096)
    }
    seen
}

// Runs one borrowed exchange and answers {duplex, value, failure}.
exchangeWith: (chunks, request, onResponse, limits) => {
    dx: duplexOf(chunks)
    future: http.Client.exchangeOne(dx, request, onResponse, limits)
    caught: failureOf(future)
    answer: null
    if(caught === null) {
        answer = future.value()
    }
    outcome: {
        duplex: dx
        value: answer
        failure: caught
    }
    outcome
}

exchange: (chunks, onResponse) => {
    exchangeWith(chunks, get(), onResponse, null)
}

ok: "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"

okResult: (response) => {
    response.status
}

limitNames: [
    "maxStatusLineBytes",
    "maxHeaderBytes",
    "maxHeaderFields",
    "maxChunkLineBytes",
    "maxTrailerBytes",
    "maxTrailerFields",
    "maxResponseBodyBytes",
    "maxInformationalResponses",
    "maxPrefetchBytes",
    "ioChunkBytes"
]

// A final 200 response head with count extra header fields.
responseWithFields: (count) => {
    head: "HTTP/1.1 200 OK\r\n"
    index: 0
    while(index < count) {
        head = head + "X-Field: v\r\n"
        index = index + 1
    }
    ascii(head + "\r\n")
}

invalidAdmission: (duplex, request, onResponse, limits) => {
    failureOf(http.Client.exchangeOne(duplex, request, onResponse, limits))
}

// Asserts that request is rejected at admission with no effect.
assertInadmissible: (request) => {
    invoked: false
    dx: duplexOf([ascii(ok)])
    failure: invalidAdmission(dx, request, (response) => {
        invoked = true
        null
    }, null)
    Assertions.require(failure.parent() === InvalidIOArgument)
    Assertions.require(dx.readCount() == 0)
    Assertions.require(dx.writeCount() == 0)
    Assertions.require(dx.closeCount() == 0)
    Assertions.require(!invoked)
}

tests: [
    Test("module exports exactly Client and ClientError", () => {
        names: http.slotNames()
        Assertions.require(names.size() == 2)
        Assertions.require(http.hasSlot("Client"))
        Assertions.require(http.hasSlot("ClientError"))
        Assertions.require(!http.hasSlot("_httpAsyncFacility"))
    }),
    Test("Client and ClientError are not Prelude bindings", () => {
        Assertions.signals(SlotNotFound, () => { Client })
        Assertions.signals(SlotNotFound, () => { ClientError })
    }),
    Test("ClientError delegates directly to Error", () => {
        Assertions.require(http.ClientError.parent() === Error)
    }),
    Test("the Client imports independently of the Server and Host modules", () => {
        // This source imports neither std:http/Server nor std:http/Host.
        outcome: exchange([ascii(ok)], okResult)
        Assertions.require(outcome.failure === null)
        Assertions.require(outcome.value == 200)
    }),
    Test("borrowed admission resolves to the callback result without closing", () => {
        dx: duplexOf([ascii(ok)])
        service: http.Client.exchangeOne(dx, get(), okResult, null)
        Assertions.require(service.value() == 200)
        Assertions.require(dx.closeCount() == 0)
        Assertions.require(dx.shutdownCount() == 0)
        Assertions.require(dx.written() == getBytes)
    }),
    Test("owning admission resolves and closes exactly once", () => {
        dx: duplexOf([ascii(ok)])
        service: http.Client.exchangeOne.owning(dx, get(), okResult, null)
        Assertions.require(service.value() == 200)
        Assertions.require(dx.closeCount() == 1)
        Assertions.require(dx.closeDone())
    }),
    Test("a duplex without ByteReadable or ByteWritable is rejected", () => {
        writeOnly: {
            write: (bytes) => {
                null
            }
        }
        readOnly: {
            read: (maxBytes) => {
                null
            }
        }
        Assertions.require(invalidAdmission(5, get(), okResult, null).parent() === InvalidIOArgument)
        Assertions.require(invalidAdmission(writeOnly, get(), okResult, null).parent() === InvalidIOArgument)
        Assertions.require(invalidAdmission(readOnly, get(), okResult, null).parent() === InvalidIOArgument)
    }),
    Test("owning requires Closable but borrowing does not", () => {
        reads: 0
        unclosable: {
            read: (maxBytes) => {
                reads = reads + 1
                (() => { null }).future()
            }
            write: (bytes) => {
                (() => { null }).future()
            }
        }
        failure: failureOf(http.Client.exchangeOne.owning(unclosable, get(), okResult, null))
        Assertions.require(failure.parent() === InvalidIOArgument)
        Assertions.require(reads == 0)
        borrowed: failureOf(http.Client.exchangeOne(unclosable, get(), okResult, null))
        Assertions.require(borrowed.parent() === http.ClientError)
        Assertions.require(borrowed.kind == "malformedResponse")
        Assertions.require(reads > 0)
    }),
    Test("a non-callable callback is rejected", () => {
        notCallable: {
            call: 5
        }
        dx: duplexOf([ascii(ok)])
        Assertions.require(invalidAdmission(dx, get(), notCallable, null).parent() === InvalidIOArgument)
        Assertions.require(dx.readCount() == 0)
        Assertions.require(dx.writeCount() == 0)
    }),
    Test("a request that is not an ordinary object is rejected", () => {
        assertInadmissible(null)
        assertInadmissible(5)
        assertInadmissible("GET / HTTP/1.1")
        assertInadmissible([get()])
    }),
    Test("a request with a missing own slot is rejected", () => {
        missingBody: {
            method: "GET"
            target: ascii("/")
            headers: [hostField()]
        }
        missingHeaders: {
            method: "GET"
            target: ascii("/")
            body: null
        }
        assertInadmissible(missingBody)
        assertInadmissible(missingHeaders)
    }),
    Test("additional own request slots are ignored", () => {
        extra: {
            method: "GET"
            target: ascii("/")
            headers: [hostField()]
            body: null
            version: "1.1"
            timeout: 5
            label: ascii("ignored")
        }
        outcome: exchangeWith([ascii(ok)], extra, okResult, null)
        Assertions.require(outcome.failure === null)
        Assertions.require(outcome.value == 200)
        Assertions.require(outcome.duplex.written() == getBytes)
    }),
    Test("inherited request slots are never read", () => {
        base: get()
        assertInadmissible(base {})
    }),
    Test("request slots of the wrong type are rejected", () => {
        assertInadmissible(requestOf(5, "/", [hostField()], null))
        stringTarget: get()
        stringTarget.target = "/"
        assertInadmissible(stringTarget)
        assertInadmissible(requestOf("GET", "/", hostField(), null))
        assertInadmissible(requestOf("GET", "/", [hostField()], "body"))
        assertInadmissible(requestOf("GET", "/", [hostField()], 5))
    }),
    Test("null limits select the defaults", () => {
        accepted: exchange([responseWithFields(100)], okResult)
        Assertions.require(accepted.failure === null)
        rejected: exchange([responseWithFields(101)], okResult)
        Assertions.require(rejected.failure.parent() === http.ClientError)
        Assertions.require(rejected.failure.kind == "responseLimit")
    }),
    Test("every recognized limit is accepted as an override", () => {
        index: 0
        while(index < limitNames.size()) {
            name: limitNames[index]
            limits: {
                maxStatusLineBytes: 8192
                maxHeaderBytes: 32768
                maxHeaderFields: 100
                maxChunkLineBytes: 8192
                maxTrailerBytes: 8192
                maxTrailerFields: 100
                maxResponseBodyBytes: 33554432
                maxInformationalResponses: 8
                maxPrefetchBytes: 65536
                ioChunkBytes: 16384
            }
            Assertions.require(limits.hasSlot(name))
            Assertions.require(exchangeWith([ascii(ok)], get(), okResult, limits).failure === null)
            index = index + 1
        }
    }),
    Test("the largest admitted limit value is 2147483647", () => {
        limits: {
            maxResponseBodyBytes: 2147483647
        }
        Assertions.require(exchangeWith([ascii(ok)], get(), okResult, limits).failure === null)
    }),
    Test("a known limit override applies", () => {
        limits: {
            maxHeaderFields: 2
        }
        Assertions.require(exchangeWith([responseWithFields(2)], get(), okResult, limits).failure === null)
        rejected: exchangeWith([responseWithFields(3)], get(), okResult, limits)
        Assertions.require(rejected.failure.kind == "responseLimit")
    }),
    Test("server limit names are not Client limits", () => {
        dx: duplexOf([ascii(ok)])
        serverName: {
            maxRequestBodyBytes: 10
        }
        Assertions.require(invalidAdmission(dx, get(), okResult, serverName).parent() === InvalidIOArgument)
        Assertions.require(dx.readCount() == 0)
    }),
    Test("an unknown limit slot is rejected", () => {
        limits: {
            maxHeadrFields: 10
        }
        dx: duplexOf([ascii(ok)])
        Assertions.require(invalidAdmission(dx, get(), okResult, limits).parent() === InvalidIOArgument)
        Assertions.require(dx.readCount() == 0)
    }),
    Test("zero, negative, non-Integer, and out-of-range limit values are rejected", () => {
        values: [0, -1, "8", 1.5, null, true, 2147483648, 9223372036854775807]
        index: 0
        while(index < values.size()) {
            limits: {
                ioChunkBytes: values[index]
            }
            dx: duplexOf([ascii(ok)])
            Assertions.require(invalidAdmission(dx, get(), okResult, limits).parent() === InvalidIOArgument)
            Assertions.require(dx.readCount() == 0)
            Assertions.require(dx.writeCount() == 0)
            index = index + 1
        }
    }),
    Test("limits of the wrong type are rejected", () => {
        wrongTypes: [5, "limits", [1], true]
        index: 0
        while(index < wrongTypes.size()) {
            dx: duplexOf([ascii(ok)])
            Assertions.require(invalidAdmission(dx, get(), okResult, wrongTypes[index]).parent() === InvalidIOArgument)
            index = index + 1
        }
    }),
    Test("inherited limit slots are ignored", () => {
        base: {
            maxHeadrFields: 1
            maxHeaderFields: 0
        }
        Assertions.require(exchangeWith([ascii(ok)], get(), okResult, base {}).failure === null)
    }),
    Test("limits are captured at admission", () => {
        limits: {
            maxHeaderFields: 2
        }
        dx: duplexOf([responseWithFields(3)])
        service: http.Client.exchangeOne(dx, get(), okResult, limits)
        limits.maxHeaderFields = 1000
        Assertions.require(failureOf(service).kind == "responseLimit")
    }),
    Test("invalid arguments answer fresh failed Futures", () => {
        dx: duplexOf([ascii(ok)])
        first: http.Client.exchangeOne(dx, get(), okResult, 5)
        second: http.Client.exchangeOne.owning(dx, get(), okResult, 5)
        Assertions.require(first !== second)
        firstFailure: failureOf(first)
        secondFailure: failureOf(second)
        Assertions.require(firstFailure !== secondFailure)
        Assertions.require(firstFailure.parent() === InvalidIOArgument)
        Assertions.require(secondFailure.parent() === InvalidIOArgument)
    }),
    Test("admitted exchanges answer fresh Futures", () => {
        first: http.Client.exchangeOne(duplexOf([ascii(ok)]), get(), okResult, null)
        second: http.Client.exchangeOne(duplexOf([ascii(ok)]), get(), okResult, null)
        Assertions.require(first !== second)
        Assertions.require(first.value() == 200)
        Assertions.require(second.value() == 200)
    }),
    Test("invalid owning admission performs no I/O and never closes", () => {
        limits: {
            maxHeaderFields: 0
        }
        invoked: false
        dx: duplexOf([ascii(ok)])
        failure: failureOf(http.Client.exchangeOne.owning(dx, get(), (response) => {
            invoked = true
            null
        }, limits))
        Assertions.require(failure.parent() === InvalidIOArgument)
        Assertions.require(dx.closeCount() == 0)
        Assertions.require(dx.readCount() == 0)
        Assertions.require(dx.writeCount() == 0)
        Assertions.require(!invoked)
    })
]
