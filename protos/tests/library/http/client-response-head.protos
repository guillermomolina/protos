Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Client")

// Latin1 keeps every test octet byte-exact, including obs-text 0x80-0xFF.
ascii: (text) => {
    Encoding.Latin1.encode(text)
}

text: (bytes) => {
    Encoding.Latin1.decode(bytes)
}

// Deterministic scripted duplex. Each read answers the next queued response
// chunk, split to maxBytes, and null once the chunks are exhausted; every
// requested maxBytes is recorded. Writes are captured at invocation.
// Optional hooks: readFailure, writeFailure, closeFailure (Errors), and
// onWrite (a callback run by each write).
duplexOf: (chunks) => {
    next: 0
    offset: 0
    output: ascii("")
    reads: 0
    writes: 0
    closes: 0
    shutdowns: 0
    requested: []
    closeCompleted: false
    readFailure: null
    writeFailure: null
    closeFailure: null
    onWrite: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            requested = Array(...requested, maxBytes)
            failure: readFailure
            result: null
            if((failure === null) && (next < chunks.size())) {
                chunk: chunks[next]
                end: chunk.size()
                if((end - offset) > maxBytes) {
                    end = offset + maxBytes
                }
                result = ascii("")
                index: offset
                while(index < end) {
                    result.add(chunk[index])
                    index = index + 1
                }
                if(end == chunk.size()) {
                    next = next + 1
                    offset = 0
                } else {
                    offset = end
                }
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            if(onWrite !== null) {
                onWrite(bytes)
            }
            failure: writeFailure
            if(failure === null) {
                bytes.each((octet) => {
                    output.add(octet)
                })
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                fixture
            }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                closeCompleted = true
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        shutdownRead: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        shutdownWrite: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        written: () => {
            text(output)
        }
        readCount: () => {
            reads
        }
        readSizes: () => {
            requested
        }
        unreadChunks: () => {
            chunks.size() - next
        }
        writeCount: () => {
            writes
        }
        closeCount: () => {
            closes
        }
        shutdownCount: () => {
            shutdowns
        }
        closeDone: () => {
            closeCompleted
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failWritesWith: (error) => {
            writeFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        whenWriting: (callback) => {
            onWrite = callback
        }
    }
    fixture
}

// Answers the Error a Future fails with, or null when it resolves.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

// Answers whether the Future ends cancelled.
cancelledOf: (future) => {
    Cancelled.handle(
        () => {
            future.value()
            false
        },
        (cancellation) => {
            true
        }
    )
}

hostField: () => {
    ["Host", ascii("example.org")]
}

requestOf: (method, target, headers, body) => {
    request: {
        method: method
        target: ascii(target)
        headers: headers
        body: body
    }
    request
}

get: () => {
    requestOf("GET", "/", [hostField()], null)
}

getBytes: "GET / HTTP/1.1\r\nHost: example.org\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"

// Reads a body to its logical end with reads of size, answering its text.
drain: (body, size) => {
    collected: ascii("")
    done: false
    while(!done) {
        chunk: body.read(size).value()
        if(chunk === null) {
            done = true
        } else {
            Assertions.require(chunk.size() > 0)
            Assertions.require(chunk.size() <= size)
            chunk.each((octet) => {
                collected.add(octet)
            })
        }
    }
    text(collected)
}

// A callback answering {status, headers, body} with the body drained.
capture: (response) => {
    seen: {
        status: response.status
        version: response.version
        headers: response.headers
        body: drain(response.body, 4096)
    }
    seen
}

// Runs one borrowed exchange and answers {duplex, value, failure}.
exchangeWith: (chunks, request, onResponse, limits) => {
    dx: duplexOf(chunks)
    future: http.Client.exchangeOne(dx, request, onResponse, limits)
    caught: failureOf(future)
    answer: null
    if(caught === null) {
        answer = future.value()
    }
    outcome: {
        duplex: dx
        value: answer
        failure: caught
    }
    outcome
}

exchange: (chunks, onResponse) => {
    exchangeWith(chunks, get(), onResponse, null)
}

ClientHead: import("std:http/internal/ClientHead")

limitsOf: (statusLine, headerBytes, headerFields) => {
    limits: {
        maxStatusLineBytes: statusLine
        maxHeaderBytes: headerBytes
        maxHeaderFields: headerFields
    }
    limits
}

defaults: () => {
    limitsOf(8192, 32768, 100)
}

// Feeds input in slices of sliceSize and answers {state, head, failure,
// consumed}, where consumed totals the octets taken by every feed.
parseIn: (input, sliceSize, limits) => {
    parser: ClientHead.responseHeadParser(limits)
    bytes: ascii(input)
    offset: 0
    total: 0
    last: null
    while(((last === null) || (last.state == "NEED_MORE")) && (offset < bytes.size())) {
        length: sliceSize
        if((bytes.size() - offset) < length) {
            length = bytes.size() - offset
        }
        last = parser.feed(bytes, offset, length)
        total = total + last.consumed
        offset = offset + length
    }
    outcome: {
        state: last.state
        head: last.head
        failure: last.failure
        consumed: total
    }
    outcome
}

parse: (input) => {
    parseIn(input, 1000000, defaults())
}

// Answers the parse of input after checking that every slice size agrees.
parseEverySplit: (input) => {
    whole: parse(input)
    size: 1
    while(size < ascii(input).size()) {
        split: parseIn(input, size, defaults())
        Assertions.require(split.state == whole.state)
        Assertions.require(split.consumed == whole.consumed)
        if(whole.state == "ACCEPTED") {
            Assertions.require(split.head.status == whole.head.status)
            Assertions.require(split.head.framing == whole.head.framing)
            Assertions.require(split.head.headers.size() == whole.head.headers.size())
        } else {
            if(whole.state == "REJECTED") {
                Assertions.require(split.failure.kind == whole.failure.kind)
            }
        }
        size = size + 1
    }
    whole
}

accepted: (input) => {
    result: parseEverySplit(input)
    Assertions.require(result.state == "ACCEPTED")
    result.head
}

rejectedAs: (input, kind) => {
    result: parseEverySplit(input)
    Assertions.require(result.state == "REJECTED")
    Assertions.require(result.failure.kind == kind)
}

malformed: (input) => {
    rejectedAs(input, "malformedResponse")
}

// Counts callback invocations; handler answers the captured response.
counted: () => {
    calls: 0
    tally: {
        handler: (response) => {
            calls = calls + 1
            capture(response)
        }
        count: () => {
            calls
        }
    }
    tally
}

never: (response) => {
    Error().signal()
}

final200: "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"

tests: [
    Test("200, 404, and 500 are ordinary final heads", () => {
        [[200, "200"], [404, "404"], [500, "500"]].each((code) => {
            head: accepted("HTTP/1.1 " + code[1] + " Reason\r\nContent-Length: 0\r\n\r\n")
            Assertions.require(head.status == code[0])
            Assertions.require(!head.informational)
            Assertions.require(head.framing == "CONTENT_LENGTH")
            Assertions.require(head.contentLength == 0)
        })
        null
    }),
    Test("100 and 103 are informational heads without a body", () => {
        continued: accepted("HTTP/1.1 100 Continue\r\n\r\n")
        Assertions.require(continued.informational)
        Assertions.require(continued.framing == "NONE")
        hints: accepted("HTTP/1.1 103 Early Hints\r\nLink: </s.css>; rel=preload\r\n\r\n")
        Assertions.require(hints.status == 103)
        Assertions.require(hints.informational)
        Assertions.require(hints.headers.size() == 1)
    }),
    Test("101 Switching Protocols is unsupported", () => {
        rejectedAs("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n\r\n", "unsupportedFeature")
    }),
    Test("only HTTP/1.1 is supported and malformed versions are malformed", () => {
        rejectedAs("HTTP/1.0 200 OK\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/2.0 200 OK\r\n\r\n", "unsupportedFeature")
        malformed("HTTP/2 200 OK\r\n\r\n")
        malformed("http/1.1 200 OK\r\n\r\n")
        malformed("HTTP/1.11 200 OK\r\n\r\n")
        malformed("HTTPS/1.1 200 OK\r\n\r\n")
        malformed("HTTP/1.1x200 OK\r\n\r\n")
    }),
    Test("status codes are exactly three digits from 100 to 599", () => {
        malformed("HTTP/1.1 099 Low\r\n\r\n")
        malformed("HTTP/1.1 600 High\r\n\r\n")
        malformed("HTTP/1.1 20 OK\r\n\r\n")
        malformed("HTTP/1.1 2000 OK\r\n\r\n")
        malformed("HTTP/1.1 2x0 OK\r\n\r\n")
        malformed("HTTP/1.1 +20 OK\r\n\r\n")
        Assertions.require(accepted("HTTP/1.1 599 \r\n\r\n").status == 599)
    }),
    Test("missing or malformed status lines are malformed", () => {
        malformed("\r\n\r\n")
        malformed("HTTP/1.1\r\n\r\n")
        malformed("HTTP/1.1 200\r\n\r\n")
        malformed("HTTP/1.1  200 OK\r\n\r\n")
        malformed(" HTTP/1.1 200 OK\r\n\r\n")
        malformed("HTTP/1.1 200 O\u{0}K\r\n\r\n")
        malformed("HTTP/1.1 200 O\u{7F}K\r\n\r\n")
        Assertions.require(accepted("HTTP/1.1 200 \r\n\r\n").status == 200)
        Assertions.require(accepted("HTTP/1.1 200 caf\u{E9} \t ok\r\n\r\n").status == 200)
    }),
    Test("CRLF handling is strict", () => {
        malformed("HTTP/1.1 200 OK\n\r\n")
        malformed("HTTP/1.1 200 OK\rX\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\r\n\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\r\r\n\r\n")
    }),
    Test("header names, values, and obs-fold are validated", () => {
        malformed("HTTP/1.1 200 OK\r\nA : b\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\n: b\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nNo-Colon\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA(b): c\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\r\n c\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\r\n\tc\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\u{0}c\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nA: b\u{7F}c\r\n\r\n")
    }),
    Test("casing, order, duplicates, and binary values are preserved", () => {
        head: accepted("HTTP/1.1 200 OK\r\nX-B: 2\r\nset-cookie: a\r\nSet-Cookie: b\r\nX-Bin: \u{80}\u{FF}\r\nX-Empty:\r\n\r\n")
        headers: head.headers
        Assertions.require(headers.size() == 5)
        Assertions.require(headers[0][0] == "X-B")
        Assertions.require(text(headers[0][1]) == "2")
        Assertions.require(headers[1][0] == "set-cookie")
        Assertions.require(headers[2][0] == "Set-Cookie")
        Assertions.require(text(headers[2][1]) == "b")
        Assertions.require(headers[3][1].size() == 2)
        Assertions.require(headers[3][1][0] == 128)
        Assertions.require(headers[3][1][1] == 255)
        Assertions.require(headers[4][1].size() == 0)
    }),
    Test("only outer OWS is removed from field values", () => {
        head: accepted("HTTP/1.1 200 OK\r\nX: \t a  b\t \r\n\r\n")
        Assertions.require(text(head.headers[0][1]) == "a  b")
    }),
    Test("the status-line limit counts the whole line including CRLF", () => {
        line: "HTTP/1.1 200 OK\r\n\r\n"
        Assertions.require(parseIn(line, 1, limitsOf(17, 32768, 100)).state == "ACCEPTED")
        Assertions.require(parseIn(line, 1, limitsOf(16, 32768, 100)).failure.kind == "responseLimit")
    }),
    Test("header-byte and header-field limits apply", () => {
        input: "HTTP/1.1 200 OK\r\nA: b\r\nC: d\r\n\r\n"
        Assertions.require(parseIn(input, 3, limitsOf(8192, 14, 100)).state == "ACCEPTED")
        Assertions.require(parseIn(input, 3, limitsOf(8192, 13, 100)).failure.kind == "responseLimit")
        Assertions.require(parseIn(input, 3, limitsOf(8192, 32768, 2)).state == "ACCEPTED")
        Assertions.require(parseIn(input, 3, limitsOf(8192, 32768, 1)).failure.kind == "responseLimit")
    }),
    Test("a valid Content-Length selects fixed framing", () => {
        head: accepted("HTTP/1.1 200 OK\r\ncontent-LENGTH: 42 \r\n\r\n")
        Assertions.require(head.framing == "CONTENT_LENGTH")
        Assertions.require(head.contentLength == 42)
        Assertions.require(accepted("HTTP/1.1 200 OK\r\nContent-Length: 9223372036854775807\r\n\r\n").contentLength == 9223372036854775807)
    }),
    Test("invalid, duplicated, and comma-list Content-Length is malformed", () => {
        ["", "-1", "+1", "0x5", "5 5", "5,5", "5, 5", "1.0", "9223372036854775808", "99999999999999999999"].each((value) => {
            malformed("HTTP/1.1 200 OK\r\nContent-Length: " + value + "\r\n\r\n")
        })
        malformed("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\n")
    }),
    Test("Transfer-Encoding chunked selects chunked framing", () => {
        Assertions.require(accepted("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n").framing == "CHUNKED")
        Assertions.require(accepted("HTTP/1.1 200 OK\r\ntransfer-encoding: CHUNKED\r\n\r\n").framing == "CHUNKED")
        Assertions.require(accepted("HTTP/1.1 200 OK\r\nTransfer-Encoding:  chunked \t\r\n\r\n").framing == "CHUNKED")
    }),
    Test("unsupported transfer codings are unsupported features", () => {
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked;q=1\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: x;a=\"b,c\"\r\n\r\n", "unsupportedFeature")
        rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked;q=\"x\"\r\n\r\n", "unsupportedFeature")
    }),
    Test("BWS around a transfer-parameter equals sign is valid but parameters stay unsupported", () => {
        ["gzip; q = 1", "gzip; q= 1", "gzip; q = \"a\"", "chunked; x = \"a\"", "chunked; x= \"a\"", "chunked; x =a"].each((value) => {
            rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: " + value + "\r\n\r\n", "unsupportedFeature")
        })
        Assertions.require(accepted("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n").framing == "CHUNKED")
        null
    }),
    Test("malformed transfer-parameter syntax stays malformed", () => {
        ["chunked; x =", "chunked; =a", "chunked; x = \"unterminated"].each((value) => {
            malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: " + value + "\r\n\r\n")
        })
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip; q = 1\r\nContent-Length: 5\r\n\r\n")
        null
    }),
    Test("parameter syntax classification reaches the public exchange without a callback", () => {
        [
            ["HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip; q = 1\r\n\r\n", "unsupportedFeature"],
            ["HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked; x = \"a\"\r\n\r\n", "unsupportedFeature"],
            ["HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked; x =\r\n\r\n", "malformedResponse"],
            ["HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip; q = 1\r\nContent-Length: 5\r\n\r\n", "malformedResponse"]
        ].each((entry) => {
            tally: counted()
            outcome: exchange([ascii(entry[0])], tally.handler)
            Assertions.require(outcome.failure.parent() === http.ClientError)
            Assertions.require(outcome.failure.kind == entry[1])
            Assertions.require(tally.count() == 0)
        })
        null
    }),
    Test("empty transfer-coding list elements are never discarded", () => {
        [", chunked", "chunked,", "chunked, ", ", chunked ,", "chunked,,chunked", "chunked , ,"].each((value) => {
            rejectedAs("HTTP/1.1 200 OK\r\nTransfer-Encoding: " + value + "\r\n\r\n", "unsupportedFeature")
        })
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: , ,\r\n\r\n")
    }),
    Test("malformed transfer-coding syntax is malformed", () => {
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding:\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: ,\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked x\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked;\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked;q\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked;q=\"a\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: (chunked)\r\n\r\n")
    }),
    Test("Transfer-Encoding with Content-Length is malformed", () => {
        malformed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\n")
        malformed("HTTP/1.1 200 OK\r\nContent-Length: 3\r\nTransfer-Encoding: gzip\r\n\r\n")
    }),
    Test("no-content statuses and absent framing select their modes", () => {
        Assertions.require(accepted("HTTP/1.1 204 No Content\r\n\r\n").framing == "NONE")
        Assertions.require(accepted("HTTP/1.1 205 Reset\r\n\r\n").framing == "NONE")
        Assertions.require(accepted("HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\n\r\n").framing == "NONE")
        Assertions.require(accepted("HTTP/1.1 200 OK\r\nX: y\r\n\r\n").framing == "CLOSE_DELIMITED")
    }),
    Test("the parser stops exactly after the head", () => {
        head: "HTTP/1.1 100 Continue\r\n\r\n"
        result: parseIn(head + "HTTP/1.1 200 OK\r\n\r\n", 1000, defaults())
        Assertions.require(result.state == "ACCEPTED")
        Assertions.require(result.consumed == ascii(head).size())
        body: parseIn(final200, 1000, defaults())
        Assertions.require(body.consumed == (ascii(final200).size() - 2))
    }),
    Test("feeding a terminal parser signals an Error", () => {
        parser: ClientHead.responseHeadParser(defaults())
        bytes: ascii("HTTP/1.1 200 OK\r\n\r\n")
        Assertions.require(parser.feed(bytes, 0, bytes.size()).state == "ACCEPTED")
        Assertions.signals(Error, () => {
            parser.feed(bytes, 0, 1)
        })
    }),
    Test("final 200, 404, and 500 responses invoke the callback once", () => {
        [[200, "200"], [404, "404"], [500, "500"]].each((code) => {
            handler: counted()
            outcome: exchange([ascii("HTTP/1.1 " + code[1] + " X\r\nContent-Length: 2\r\n\r\nhi")], handler.handler)
            Assertions.require(outcome.failure === null)
            Assertions.require(outcome.value.status == code[0])
            Assertions.require(outcome.value.version == "1.1")
            Assertions.require(outcome.value.body == "hi")
            Assertions.require(handler.count() == 1)
        })
        null
    }),
    Test("100 and 103 precede the final response and are not exposed", () => {
        handler: counted()
        outcome: exchange([ascii("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </a>\r\n\r\n" + final200)], handler.handler)
        Assertions.require(outcome.value.status == 200)
        Assertions.require(outcome.value.headers.size() == 1)
        Assertions.require(outcome.value.headers[0][0] == "Content-Length")
        Assertions.require(outcome.value.body == "ok")
        Assertions.require(handler.count() == 1)
    }),
    Test("the informational-response count is bounded", () => {
        continues: (count) => {
            input: ""
            index: 0
            while(index < count) {
                input = input + "HTTP/1.1 100 Continue\r\n\r\n"
                index = index + 1
            }
            ascii(input + final200)
        }
        Assertions.require(exchange([continues(8)], capture).failure === null)
        rejected: exchange([continues(9)], never)
        Assertions.require(rejected.failure.parent() === http.ClientError)
        Assertions.require(rejected.failure.kind == "responseLimit")
        limits: {
            maxInformationalResponses: 1
        }
        Assertions.require(exchangeWith([continues(1)], get(), capture, limits).failure === null)
        Assertions.require(exchangeWith([continues(2)], get(), never, limits).failure.kind == "responseLimit")
    }),
    Test("101 fails the exchange without a callback", () => {
        outcome: exchange([ascii("HTTP/1.1 101 Switching Protocols\r\n\r\n")], never)
        Assertions.require(outcome.failure.parent() === http.ClientError)
        Assertions.require(outcome.failure.kind == "unsupportedFeature")
    }),
    Test("response headers keep their wire form and are fresh copies", () => {
        outcome: exchange([ascii("HTTP/1.1 200 OK\r\nx-ONE: a\r\nX-One: b \r\nContent-Length: 0\r\n\r\n")], (response) => {
            first: response.headers[0][1]
            first.add(33)
            response.headers
        })
        headers: outcome.value
        Assertions.require(headers.size() == 3)
        Assertions.require(headers[0][0] == "x-ONE")
        Assertions.require(text(headers[0][1]) == "a!")
        Assertions.require(headers[1][0] == "X-One")
        Assertions.require(text(headers[1][1]) == "b")
    }),
    Test("a one-byte-per-read response is parsed identically", () => {
        input: ascii("HTTP/1.1 103 Early Hints\r\nLink: </a>\r\n\r\nHTTP/1.1 200 OK\r\nX: y\r\nContent-Length: 3\r\n\r\nabc")
        chunks: []
        input.each((octet) => {
            single: ascii("")
            single.add(octet)
            chunks = Array(...chunks, single)
        })
        handler: counted()
        outcome: exchange(chunks, handler.handler)
        Assertions.require(outcome.value.status == 200)
        Assertions.require(outcome.value.body == "abc")
        Assertions.require(handler.count() == 1)
    }),
    Test("every two-read split of a response is parsed identically", () => {
        input: ascii("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nno\r\n0\r\n\r\n")
        split: 1
        while(split < input.size()) {
            first: ascii("")
            second: ascii("")
            index: 0
            input.each((octet) => {
                if(index < split) {
                    first.add(octet)
                } else {
                    second.add(octet)
                }
                index = index + 1
            })
            handler: counted()
            outcome: exchange([first, second], handler.handler)
            Assertions.require(outcome.value.status == 404)
            Assertions.require(outcome.value.body == "no")
            Assertions.require(handler.count() == 1)
            split = split + 1
        }
    }),
    Test("EOF before a complete final head is malformed", () => {
        [
            "",
            "HTTP/1.1 200 OK\r\n",
            "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n",
            "HTTP/1.1 100 Continue\r\n\r\n"
        ].each((input) => {
            chunks: []
            if(input != "") {
                chunks = [ascii(input)]
            }
            outcome: exchange(chunks, never)
            Assertions.require(outcome.failure.parent() === http.ClientError)
            Assertions.require(outcome.failure.kind == "malformedResponse")
        })
        null
    }),
    Test("framing conflicts and excessive declared lengths fail before the callback", () => {
        conflict: exchange([ascii("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabc")], never)
        Assertions.require(conflict.failure.kind == "malformedResponse")
        limits: {
            maxResponseBodyBytes: 4
        }
        tooLong: exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabcde")], get(), never, limits)
        Assertions.require(tooLong.failure.kind == "responseLimit")
        Assertions.require(exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nabcd")], get(), capture, limits).value.body == "abcd")
    }),
    Test("HEAD and 304 Content-Length above the body limit is representation metadata", () => {
        limits: {
            maxResponseBodyBytes: 4
        }
        headExchange: exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 9223372036854775807\r\n\r\n")], requestOf("HEAD", "/", [hostField()], null), capture, limits)
        Assertions.require(headExchange.failure === null)
        Assertions.require(headExchange.value.status == 200)
        Assertions.require(headExchange.value.body == "")
        notModified: exchangeWith([ascii("HTTP/1.1 304 Not Modified\r\nContent-Length: 1000\r\n\r\n")], get(), capture, limits)
        Assertions.require(notModified.failure === null)
        Assertions.require(notModified.value.status == 304)
        Assertions.require(notModified.value.body == "")
    }),
    Test("HEAD and 304 Content-Length syntax and conflicts are still validated", () => {
        head: requestOf("HEAD", "/", [hostField()], null)
        Assertions.require(exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5, 5\r\n\r\n")], head, never, null).failure.kind == "malformedResponse")
        Assertions.require(exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\n")], head, never, null).failure.kind == "malformedResponse")
        Assertions.require(exchange([ascii("HTTP/1.1 304 Not Modified\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n")], never).failure.kind == "malformedResponse")
    }),
    Test("forbidden framing fields on 1xx, 204, and 205 heads are malformed", () => {
        malformed("HTTP/1.1 100 Continue\r\nContent-Length: 0\r\n\r\n")
        malformed("HTTP/1.1 103 Early Hints\r\nContent-Length: 100\r\n\r\n")
        malformed("HTTP/1.1 100 Continue\r\nTransfer-Encoding: chunked\r\n\r\n")
        malformed("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n")
        malformed("HTTP/1.1 204 No Content\r\nContent-Length: 100\r\n\r\n")
        malformed("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n")
        malformed("HTTP/1.1 205 Reset Content\r\nContent-Length: 100\r\n\r\n")
        malformed("HTTP/1.1 205 Reset Content\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n")
        Assertions.require(accepted("HTTP/1.1 205 Reset Content\r\nContent-Length: 0\r\n\r\n").framing == "NONE")
        rejectedAs("HTTP/1.1 101 Switching Protocols\r\nContent-Length: 0\r\n\r\n", "unsupportedFeature")
    }),
    Test("forbidden framing on a final head never reaches the callback", () => {
        [
            "HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n",
            "HTTP/1.1 204 No Content\r\nContent-Length: 100\r\n\r\n",
            "HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n",
            "HTTP/1.1 205 Reset Content\r\nContent-Length: 100\r\n\r\n"
        ].each((input) => {
            tally: counted()
            outcome: exchange([ascii(input)], tally.handler)
            Assertions.require(outcome.failure.parent() === http.ClientError)
            Assertions.require(outcome.failure.kind == "malformedResponse")
            Assertions.require(tally.count() == 0)
        })
        null
    }),
    Test("a forbidden framing field on an informational head fails before the final response", () => {
        [
            "HTTP/1.1 100 Continue\r\nContent-Length: 0\r\n\r\n",
            "HTTP/1.1 103 Early Hints\r\nContent-Length: 100\r\n\r\n",
            "HTTP/1.1 100 Continue\r\nTransfer-Encoding: chunked\r\n\r\n"
        ].each((input) => {
            tally: counted()
            outcome: exchange([ascii(input + final200)], tally.handler)
            Assertions.require(outcome.failure.kind == "malformedResponse")
            Assertions.require(tally.count() == 0)
        })
        null
    }),
    Test("valid 205 heads expose an empty body", () => {
        [
            "HTTP/1.1 205 Reset Content\r\n\r\n",
            "HTTP/1.1 205 Reset Content\r\nContent-Length: 0\r\n\r\n"
        ].each((input) => {
            tally: counted()
            outcome: exchange([ascii(input)], tally.handler)
            Assertions.require(outcome.failure === null)
            Assertions.require(outcome.value.status == 205)
            Assertions.require(outcome.value.body == "")
            Assertions.require(tally.count() == 1)
        })
        null
    }),
    Test("a body-bearing Content-Length above the body limit fails before the callback", () => {
        limits: {
            maxResponseBodyBytes: 4
        }
        tally: counted()
        rejected: exchangeWith([ascii("HTTP/1.1 200 OK\r\nContent-Length: 1000\r\n\r\n")], get(), tally.handler, limits)
        Assertions.require(tally.count() == 0)
        Assertions.require(rejected.failure.parent() === http.ClientError)
        Assertions.require(rejected.failure.kind == "responseLimit")
        Assertions.require(rejected.duplex.readCount() == 1)
    }),
    Test("ClientError occurrences are fresh and carry no status", () => {
        first: exchange([ascii("BAD\r\n\r\n")], never).failure
        second: exchange([ascii("BAD\r\n\r\n")], never).failure
        Assertions.require(first.parent() === http.ClientError)
        Assertions.require(first !== second)
        Assertions.require(first.kind == "malformedResponse")
        Assertions.require(!first.hasSlot("status"))
    })
]
