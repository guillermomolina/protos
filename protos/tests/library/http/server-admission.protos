Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Server")

// Latin1 keeps every test octet byte-exact, including obs-text 0x80-0xFF.
ascii: (text) => {
    Encoding.Latin1.encode(text)
}

text: (bytes) => {
    Encoding.Latin1.decode(bytes)
}

// Deterministic in-memory duplex. Each read answers the next queued chunk,
// split to maxBytes, and null once the chunks are exhausted. Writes are
// captured at invocation. Optional hooks: readFailure, writeFailure,
// closeFailure (Errors), and onWrite (a callback run by each write).
duplexOf: (chunks) => {
    next: 0
    offset: 0
    output: ascii("")
    reads: 0
    writes: 0
    closes: 0
    closeCompleted: false
    readFailure: null
    writeFailure: null
    closeFailure: null
    onWrite: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            failure: readFailure
            result: null
            if((failure === null) && (next < chunks.size())) {
                chunk: chunks[next]
                end: chunk.size()
                if((end - offset) > maxBytes) {
                    end = offset + maxBytes
                }
                result = ascii("")
                index: offset
                while(index < end) {
                    result.add(chunk[index])
                    index = index + 1
                }
                if(end == chunk.size()) {
                    next = next + 1
                    offset = 0
                } else {
                    offset = end
                }
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            if(onWrite !== null) {
                onWrite(bytes)
            }
            failure: writeFailure
            if(failure === null) {
                bytes.each((octet) => {
                    output.add(octet)
                })
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                fixture
            }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                closeCompleted = true
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        written: () => {
            text(output)
        }
        readCount: () => {
            reads
        }
        writeCount: () => {
            writes
        }
        closeCount: () => {
            closes
        }
        closeDone: () => {
            closeCompleted
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failWritesWith: (error) => {
            writeFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        whenWriting: (callback) => {
            onWrite = callback
        }
    }
    fixture
}

// Answers the Error a Future fails with, or null when it resolves.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

responseOf: (status, headers, body) => {
    response: {
        status: status
        headers: headers
        body: body
    }
    response
}

ok: (request) => {
    responseOf(200, [], null)
}

getRequest: () => {
    ascii("GET / HTTP/1.1\r\nHost: example.org\r\n\r\n")
}

// Serves one request from chunks with handler and answers {duplex, failure}.
serveWith: (chunks, handler, limits) => {
    servedDuplex: duplexOf(chunks)
    caught: failureOf(http.Server.serveOne(servedDuplex, handler, limits))
    outcome: {
        duplex: servedDuplex
        failure: caught
    }
    outcome
}

serve: (chunks, handler) => {
    serveWith(chunks, handler, null)
}

statusLine: (status) => {
    "HTTP/1.1 " + status + " \r\n"
}

emptyResponse: (status) => {
    statusLine(status) + "Content-Length: 0\r\nConnection: close\r\n\r\n"
}

limitNames: [
    "maxRequestLineBytes",
    "maxHeaderBytes",
    "maxHeaderFields",
    "maxChunkLineBytes",
    "maxTrailerBytes",
    "maxTrailerFields",
    "maxRequestBodyBytes",
    "maxPrefetchBytes",
    "ioChunkBytes"
]

// A request with Host plus extra header fields.
requestWithFields: (extra) => {
    head: "GET / HTTP/1.1\r\nHost: example.org\r\n"
    index: 0
    while(index < extra) {
        head = head + "X-Field: v\r\n"
        index = index + 1
    }
    ascii(head + "\r\n")
}

invalidAdmission: (duplex, handler, limits) => {
    failureOf(http.Server.serveOne(duplex, handler, limits))
}

tests: [
    Test("module exports exactly Server and HttpError", () => {
        names: http.slotNames()
        Assertions.require(names.size() == 2)
        Assertions.require(names[0] == "HttpError")
        Assertions.require(names[1] == "Server")
        Assertions.require(!http.hasSlot("_httpAsyncFacility"))
    }),
    Test("Server and HttpError are not Prelude bindings", () => {
        Assertions.signals(SlotNotFound, () => { Server })
        Assertions.signals(SlotNotFound, () => { HttpError })
    }),
    Test("HttpError delegates directly to Error", () => {
        Assertions.require(http.HttpError.parent() === Error)
    }),
    Test("every HTTP failure is a fresh HttpError occurrence", () => {
        first: serve([ascii("BAD\r\n\r\n")], ok).failure
        second: serve([ascii("BAD\r\n\r\n")], ok).failure
        Assertions.require(first.parent() === http.HttpError)
        Assertions.require(second.parent() === http.HttpError)
        Assertions.require(first !== second)
        Assertions.require(first.kind == "malformedRequest")
        Assertions.require(first.status == 400)
    }),
    Test("borrowed admission serves and resolves to null", () => {
        dx: duplexOf([getRequest()])
        service: http.Server.serveOne(dx, ok, null)
        Assertions.require(service.value() === null)
        Assertions.require(dx.closeCount() == 0)
        Assertions.require(dx.written() == emptyResponse("200"))
    }),
    Test("owning admission serves, resolves to null, and closes once", () => {
        dx: duplexOf([getRequest()])
        service: http.Server.serveOne.owning(dx, ok, null)
        Assertions.require(service.value() === null)
        Assertions.require(dx.closeCount() == 1)
        Assertions.require(dx.closeDone())
    }),
    Test("a duplex that is not an object is rejected", () => {
        failure: invalidAdmission(5, ok, null)
        Assertions.require(failure.parent() === InvalidIOArgument)
    }),
    Test("a duplex without ByteReadable is rejected", () => {
        writeOnly: {
            write: (bytes) => {
                null
            }
        }
        Assertions.require(invalidAdmission(writeOnly, ok, null).parent() === InvalidIOArgument)
    }),
    Test("a duplex without ByteWritable is rejected", () => {
        readOnly: {
            read: (maxBytes) => {
                null
            }
        }
        Assertions.require(invalidAdmission(readOnly, ok, null).parent() === InvalidIOArgument)
    }),
    Test("owning requires Closable but borrowing does not", () => {
        reads: 0
        unclosable: {
            read: (maxBytes) => {
                reads = reads + 1
                (() => { null }).future()
            }
            write: (bytes) => {
                (() => { null }).future()
            }
        }
        failure: failureOf(http.Server.serveOne.owning(unclosable, ok, null))
        Assertions.require(failure.parent() === InvalidIOArgument)
        Assertions.require(reads == 0)
        borrowed: failureOf(http.Server.serveOne(unclosable, ok, null))
        Assertions.require(borrowed.parent() === http.HttpError)
        Assertions.require(reads > 0)
    }),
    Test("a non-callable handler is rejected", () => {
        notCallable: {
            call: 5
        }
        dx: duplexOf([getRequest()])
        Assertions.require(invalidAdmission(dx, notCallable, null).parent() === InvalidIOArgument)
        Assertions.require(dx.readCount() == 0)
    }),
    Test("null limits select the defaults", () => {
        accepted: serve([requestWithFields(99)], ok)
        Assertions.require(accepted.failure === null)
        rejected: serve([requestWithFields(100)], ok)
        Assertions.require(rejected.failure.kind == "requestLimit")
        Assertions.require(rejected.failure.status == 431)
        Assertions.require(rejected.duplex.written() == emptyResponse("431"))
    }),
    Test("every recognized limit is accepted as an override", () => {
        index: 0
        while(index < limitNames.size()) {
            name: limitNames[index]
            limits: {
                maxRequestLineBytes: 8192
                maxHeaderBytes: 32768
                maxHeaderFields: 100
                maxChunkLineBytes: 8192
                maxTrailerBytes: 8192
                maxTrailerFields: 100
                maxRequestBodyBytes: 33554432
                maxPrefetchBytes: 65536
                ioChunkBytes: 16384
            }
            Assertions.require(limits.hasSlot(name))
            Assertions.require(serveWith([getRequest()], ok, limits).failure === null)
            index = index + 1
        }
    }),
    Test("a known limit override applies", () => {
        limits: {
            maxHeaderFields: 2
        }
        accepted: serveWith([requestWithFields(1)], ok, limits)
        Assertions.require(accepted.failure === null)
        rejected: serveWith([requestWithFields(2)], ok, limits)
        Assertions.require(rejected.failure.status == 431)
    }),
    Test("an unknown limit slot is rejected", () => {
        limits: {
            maxHeadrFields: 10
        }
        dx: duplexOf([getRequest()])
        Assertions.require(invalidAdmission(dx, ok, limits).parent() === InvalidIOArgument)
        Assertions.require(dx.readCount() == 0)
    }),
    Test("invalid limit values are rejected", () => {
        values: [0, -1, "8", 1.5, null, 9223372036854775808]
        index: 0
        while(index < values.size()) {
            value: values[index]
            limits: {
                ioChunkBytes: value
            }
            dx: duplexOf([getRequest()])
            Assertions.require(invalidAdmission(dx, ok, limits).parent() === InvalidIOArgument)
            Assertions.require(dx.readCount() == 0)
            index = index + 1
        }
    }),
    Test("limits of the wrong type are rejected", () => {
        wrongTypes: [5, "limits", [1], true]
        index: 0
        while(index < wrongTypes.size()) {
            limits: wrongTypes[index]
            dx: duplexOf([getRequest()])
            Assertions.require(invalidAdmission(dx, ok, limits).parent() === InvalidIOArgument)
            index = index + 1
        }
    }),
    Test("inherited limit slots are ignored", () => {
        base: {
            maxHeadrFields: 1
            maxHeaderFields: 0
        }
        limits: base {}
        Assertions.require(serveWith([getRequest()], ok, limits).failure === null)
    }),
    Test("limits are captured at admission", () => {
        limits: {
            maxHeaderFields: 2
        }
        dx: duplexOf([requestWithFields(2)])
        service: http.Server.serveOne(dx, ok, limits)
        limits.maxHeaderFields = 1000
        failure: failureOf(service)
        Assertions.require(failure.status == 431)
    }),
    Test("invalid arguments answer fresh failed Futures", () => {
        dx: duplexOf([getRequest()])
        first: http.Server.serveOne(dx, ok, 5)
        second: http.Server.serveOne(dx, ok, 5)
        Assertions.require(first !== second)
        firstFailure: failureOf(first)
        secondFailure: failureOf(second)
        Assertions.require(firstFailure !== secondFailure)
        Assertions.require(firstFailure.parent() === InvalidIOArgument)
    }),
    Test("invalid arguments perform no I/O and never invoke the handler", () => {
        invoked: false
        handler: (request) => {
            invoked = true
            ok(request)
        }
        dx: duplexOf([getRequest()])
        failureOf(http.Server.serveOne(dx, handler, "limits"))
        Assertions.require(dx.readCount() == 0)
        Assertions.require(dx.writeCount() == 0)
        Assertions.require(!invoked)
    }),
    Test("invalid owning admission never closes the duplex", () => {
        limits: {
            maxHeaderFields: 0
        }
        dx: duplexOf([getRequest()])
        failure: failureOf(http.Server.serveOne.owning(dx, ok, limits))
        Assertions.require(failure.parent() === InvalidIOArgument)
        Assertions.require(dx.closeCount() == 0)
        Assertions.require(dx.readCount() == 0)
    })
]
