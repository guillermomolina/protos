Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Client")

// Latin1 keeps every test octet byte-exact, including obs-text 0x80-0xFF.
ascii: (text) => {
    Encoding.Latin1.encode(text)
}

text: (bytes) => {
    Encoding.Latin1.decode(bytes)
}

// Deterministic scripted duplex. Each read answers the next queued response
// chunk, split to maxBytes, and null once the chunks are exhausted; every
// requested maxBytes is recorded. Writes are captured at invocation.
// Optional hooks: readFailure, writeFailure, closeFailure (Errors), and
// onWrite (a callback run by each write).
duplexOf: (chunks) => {
    next: 0
    offset: 0
    output: ascii("")
    reads: 0
    writes: 0
    closes: 0
    shutdowns: 0
    requested: []
    closeCompleted: false
    readFailure: null
    writeFailure: null
    closeFailure: null
    onWrite: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            requested = Array(...requested, maxBytes)
            failure: readFailure
            result: null
            if((failure === null) && (next < chunks.size())) {
                chunk: chunks[next]
                end: chunk.size()
                if((end - offset) > maxBytes) {
                    end = offset + maxBytes
                }
                result = ascii("")
                index: offset
                while(index < end) {
                    result.add(chunk[index])
                    index = index + 1
                }
                if(end == chunk.size()) {
                    next = next + 1
                    offset = 0
                } else {
                    offset = end
                }
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            if(onWrite !== null) {
                onWrite(bytes)
            }
            failure: writeFailure
            if(failure === null) {
                bytes.each((octet) => {
                    output.add(octet)
                })
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                fixture
            }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                closeCompleted = true
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        shutdownRead: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        shutdownWrite: () => {
            shutdowns = shutdowns + 1
            (() => { null }).future()
        }
        written: () => {
            text(output)
        }
        readCount: () => {
            reads
        }
        readSizes: () => {
            requested
        }
        unreadChunks: () => {
            chunks.size() - next
        }
        writeCount: () => {
            writes
        }
        closeCount: () => {
            closes
        }
        shutdownCount: () => {
            shutdowns
        }
        closeDone: () => {
            closeCompleted
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failWritesWith: (error) => {
            writeFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        whenWriting: (callback) => {
            onWrite = callback
        }
    }
    fixture
}

// Answers the Error a Future fails with, or null when it resolves.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

// Answers whether the Future ends cancelled.
cancelledOf: (future) => {
    Cancelled.handle(
        () => {
            future.value()
            false
        },
        (cancellation) => {
            true
        }
    )
}

hostField: () => {
    ["Host", ascii("example.org")]
}

requestOf: (method, target, headers, body) => {
    request: {
        method: method
        target: ascii(target)
        headers: headers
        body: body
    }
    request
}

get: () => {
    requestOf("GET", "/", [hostField()], null)
}

getBytes: "GET / HTTP/1.1\r\nHost: example.org\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"

// Reads a body to its logical end with reads of size, answering its text.
drain: (body, size) => {
    collected: ascii("")
    done: false
    while(!done) {
        chunk: body.read(size).value()
        if(chunk === null) {
            done = true
        } else {
            Assertions.require(chunk.size() > 0)
            Assertions.require(chunk.size() <= size)
            chunk.each((octet) => {
                collected.add(octet)
            })
        }
    }
    text(collected)
}

// A callback answering {status, headers, body} with the body drained.
capture: (response) => {
    seen: {
        status: response.status
        version: response.version
        headers: response.headers
        body: drain(response.body, 4096)
    }
    seen
}

// Runs one borrowed exchange and answers {duplex, value, failure}.
exchangeWith: (chunks, request, onResponse, limits) => {
    dx: duplexOf(chunks)
    future: http.Client.exchangeOne(dx, request, onResponse, limits)
    caught: failureOf(future)
    answer: null
    if(caught === null) {
        answer = future.value()
    }
    outcome: {
        duplex: dx
        value: answer
        failure: caught
    }
    outcome
}

exchange: (chunks, onResponse) => {
    exchangeWith(chunks, get(), onResponse, null)
}

// Task-count properties (one service Task, no Task per body read, no leaked
// Task) are asserted by ProtosHttpClientIntegrationTest, whose native
// fixtures make every live Task attributable.

ok: "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"

withBody: "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"

status: (response) => {
    response.status
}

failingCallback: (response) => {
    Error().signal()
}

// A duplex over inner whose read or write first runs hook.
hookedDuplex: (inner, readHook, writeHook) => {
    hooked: {
        read: (maxBytes) => {
            readHook()
            inner.read(maxBytes)
        }
        write: (bytes) => {
            writeHook()
            inner.write(bytes)
        }
        close: () => {
            inner.close()
        }
        shutdownRead: () => {
            inner.shutdownRead()
        }
        shutdownWrite: () => {
            inner.shutdownWrite()
        }
    }
    hooked
}

nothing: () => {
    null
}

// Runs one owning exchange and answers {duplex, value, failure}.
exchangeOwning: (chunks, onResponse, configure) => {
    owned: duplexOf(chunks)
    configure(owned)
    future: http.Client.exchangeOne.owning(owned, get(), onResponse, null)
    caught: failureOf(future)
    answer: null
    if(caught === null) {
        answer = future.value()
    }
    outcome: {
        duplex: owned
        value: answer
        failure: caught
    }
    outcome
}

unconfigured: (duplex) => {
    null
}

tests: [
    Test("a borrowed duplex is never closed or half-closed", () => {
        [
            exchange([ascii(ok)], status),
            exchange([ascii("BAD\r\n\r\n")], status),
            exchange([ascii(ok)], failingCallback)
        ].each((outcome) => {
            Assertions.require(outcome.duplex.closeCount() == 0)
            Assertions.require(outcome.duplex.shutdownCount() == 0)
        })
        null
    }),
    Test("an owned duplex is closed exactly once after normal completion", () => {
        outcome: exchangeOwning([ascii(ok)], status, unconfigured)
        Assertions.require(outcome.failure === null)
        Assertions.require(outcome.value == 200)
        Assertions.require(outcome.duplex.closeCount() == 1)
        Assertions.require(outcome.duplex.closeDone())
        Assertions.require(outcome.duplex.shutdownCount() == 0)
    }),
    Test("an owned duplex is closed exactly once on every failure path", () => {
        readError: IOError {}
        writeError: IOError {}
        outcomes: [
            exchangeOwning([ascii("BAD\r\n\r\n")], status, unconfigured),
            exchangeOwning([ascii(ok)], failingCallback, unconfigured),
            exchangeOwning([ascii(ok)], status, (duplex) => {
                duplex.failReadsWith(readError)
            }),
            exchangeOwning([ascii(ok)], status, (duplex) => {
                duplex.failWritesWith(writeError)
            })
        ]
        outcomes.each((outcome) => {
            Assertions.require(outcome.failure !== null)
            Assertions.require(outcome.duplex.closeCount() == 1)
            Assertions.require(outcome.duplex.closeDone())
            Assertions.require(outcome.duplex.shutdownCount() == 0)
        })
        Assertions.require(outcomes[0].failure.parent() === http.ClientError)
        Assertions.require(outcomes[2].failure === readError)
        Assertions.require(outcomes[3].failure === writeError)
    }),
    Test("the callback's Error keeps its identity", () => {
        callbackError: Error {}
        outcome: exchange([ascii(withBody)], (response) => {
            callbackError.signal()
        })
        Assertions.require(outcome.failure === callbackError)
    }),
    Test("lower read and write IOErrors keep their identity and are not ClientErrors", () => {
        readError: IOError {}
        dx: duplexOf([ascii(ok)])
        dx.failReadsWith(readError)
        Assertions.require(failureOf(http.Client.exchangeOne(dx, get(), status, null)) === readError)
        Assertions.require(dx.readCount() == 1)
        Assertions.require(dx.writeCount() == 1)

        writeError: IOError {}
        other: duplexOf([ascii(ok)])
        other.failWritesWith(writeError)
        Assertions.require(failureOf(http.Client.exchangeOne(other, get(), status, null)) === writeError)
        Assertions.require(other.writeCount() == 1)
        Assertions.require(other.readCount() == 0)
    }),
    Test("a lower read failure during the body reaches the body read with its identity", () => {
        bodyError: IOError {}
        dx: duplexOf([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n"), ascii("hello")])
        reached: null
        service: http.Client.exchangeOne(dx, get(), (response) => {
            dx.failReadsWith(bodyError)
            reached = failureOf(response.body.read(5))
            "handled"
        }, null)
        Assertions.require(service.value() == "handled")
        Assertions.require(reached === bodyError)
    }),
    Test("cancellation before the first service instruction closes only an owned duplex", () => {
        invoked: false
        callback: (response) => {
            invoked = true
            null
        }
        owned: duplexOf([ascii(ok)])
        service: http.Client.exchangeOne.owning(owned, get(), callback, null)
        service.cancel()
        Assertions.require(cancelledOf(service))
        Assertions.require(owned.closeCount() == 1)
        Assertions.require(owned.closeDone())
        Assertions.require(owned.readCount() == 0)
        Assertions.require(owned.writeCount() == 0)

        borrowed: duplexOf([ascii(ok)])
        other: http.Client.exchangeOne(borrowed, get(), callback, null)
        other.cancel()
        Assertions.require(cancelledOf(other))
        Assertions.require(borrowed.closeCount() == 0)
        Assertions.require(borrowed.writeCount() == 0)
        Assertions.require(!invoked)
    }),
    Test("cancellation during input closes only an owned duplex", () => {
        borrowedInner: duplexOf([ascii(ok)])
        borrowed: null
        borrowed = http.Client.exchangeOne(hookedDuplex(borrowedInner, () => { borrowed.cancel() }, nothing), get(), status, null)
        Assertions.require(cancelledOf(borrowed))
        Assertions.require(borrowedInner.closeCount() == 0)

        ownedInner: duplexOf([ascii(ok)])
        owned: null
        owned = http.Client.exchangeOne.owning(hookedDuplex(ownedInner, () => { owned.cancel() }, nothing), get(), status, null)
        Assertions.require(cancelledOf(owned))
        Assertions.require(ownedInner.closeCount() == 1)
        Assertions.require(ownedInner.closeDone())
    }),
    Test("cancellation during output closes the owned duplex without reading", () => {
        inner: duplexOf([ascii(ok)])
        service: null
        service = http.Client.exchangeOne.owning(hookedDuplex(inner, nothing, () => { service.cancel() }), get(), status, null)
        Assertions.require(cancelledOf(service))
        Assertions.require(inner.closeCount() == 1)
        Assertions.require(inner.closeDone())
        Assertions.require(inner.readCount() == 0)
    }),
    Test("cancellation during the callback unwinds and retires the body", () => {
        dx: duplexOf([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n"), ascii("hello")])
        resumed: false
        escaped: null
        service: null
        service = http.Client.exchangeOne.owning(dx, get(), (response) => {
            escaped = response.body
            service.cancel()
            response.body.read(5).value()
            resumed = true
            null
        }, null)
        Assertions.require(cancelledOf(service))
        Assertions.require(!resumed)
        Assertions.require(dx.closeCount() == 1)
        Assertions.require(failureOf(escaped.read(1)).parent() === IOLifecycleError)
    }),
    Test("close completion precedes service Future completion", () => {
        owned: duplexOf([ascii(ok)])
        service: http.Client.exchangeOne.owning(owned, get(), status, null)
        Assertions.require(service.value() == 200)
        Assertions.require(owned.closeDone())
    }),
    Test("an owning close failure supersedes every earlier outcome", () => {
        closeError: IOError {}
        failClose: (duplex) => {
            duplex.failCloseWith(closeError)
        }
        Assertions.require(exchangeOwning([ascii(ok)], status, failClose).failure === closeError)
        Assertions.require(exchangeOwning([ascii(ok)], failingCallback, failClose).failure === closeError)
        Assertions.require(exchangeOwning([ascii("BAD\r\n\r\n")], status, failClose).failure === closeError)
    }),
    Test("a late framing failure plus a close failure answers the close failure", () => {
        closeError: IOError {}
        reached: null
        outcome: exchangeOwning([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nab")], (response) => {
            Error.handle(
                () => {
                    drain(response.body, 10)
                },
                (error) => {
                    reached = error
                    error
                }
            )
            null
        }, (duplex) => {
            duplex.failCloseWith(closeError)
        })
        Assertions.require(reached.parent() === http.ClientError)
        Assertions.require(outcome.failure === closeError)
        Assertions.require(outcome.duplex.closeCount() == 1)
    }),
    Test("a close failure after a pre-start cancellation supersedes the cancellation", () => {
        closeError: IOError {}
        owned: duplexOf([ascii(ok)])
        owned.failCloseWith(closeError)
        service: http.Client.exchangeOne.owning(owned, get(), status, null)
        service.cancel()
        Assertions.require(failureOf(service) === closeError)
        Assertions.require(owned.closeCount() == 1)
        Assertions.require(owned.writeCount() == 0)
    }),
    Test("the response body is retired after normal return and callback failure", () => {
        escapedNormal: null
        exchange([ascii(withBody)], (response) => {
            escapedNormal = response.body
            null
        })
        escapedFailed: null
        failed: exchange([ascii(withBody)], (response) => {
            escapedFailed = response.body
            Error().signal()
        })
        Assertions.require(failed.failure !== null)
        first: failureOf(escapedNormal.read(1))
        second: failureOf(escapedFailed.read(1))
        Assertions.require(first.parent() === IOLifecycleError)
        Assertions.require(second.parent() === IOLifecycleError)
        Assertions.require(first !== second)
    }),
    Test("a returned pending Future is adopted without extending body lifetime", () => {
        dx: duplexOf([ascii(withBody)])
        service: http.Client.exchangeOne(dx, get(), (response) => {
            body: response.body
            (() => {
                failureOf(body.read(1)).parent() === IOLifecycleError
            }).future()
        }, null)
        Assertions.require(service.value() === true)
    }),
    Test("a returned resolved Future and plain values become the result", () => {
        Assertions.require(exchange([ascii(ok)], (response) => {
            (() => { 42 }).future()
        }).value == 42)
        Assertions.require(exchange([ascii(ok)], (response) => {
            null
        }).value === null)
    }),
    Test("a failed exchange is never retried", () => {
        readError: IOError {}
        dx: duplexOf([ascii(ok)])
        dx.failReadsWith(readError)
        failureOf(http.Client.exchangeOne(dx, get(), status, null))
        Assertions.require(dx.writeCount() == 1)
        Assertions.require(dx.readCount() == 1)
        framing: exchange([ascii("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nab")], (response) => {
            drain(response.body, 10)
        })
        Assertions.require(framing.failure.kind == "malformedResponse")
        Assertions.require(framing.duplex.writeCount() == 1)
    }),
    Test("Tasks started by the callback follow structured completion", () => {
        childDone: false
        child: null
        outcome: exchange([ascii(ok)], (response) => {
            child = (() => {
                childDone = true
                7
            }).future()
            null
        })
        Assertions.require(outcome.failure === null)
        Assertions.require(childDone)
        Assertions.require(child.value() == 7)
    })
]

