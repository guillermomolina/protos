Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Server")

// Latin1 keeps every test octet byte-exact, including obs-text 0x80-0xFF.
ascii: (text) => {
    Encoding.Latin1.encode(text)
}

text: (bytes) => {
    Encoding.Latin1.decode(bytes)
}

// Deterministic in-memory duplex. Each read answers the next queued chunk,
// split to maxBytes, and null once the chunks are exhausted. Writes are
// captured at invocation. Optional hooks: readFailure, writeFailure,
// closeFailure (Errors), and onWrite (a callback run by each write).
duplexOf: (chunks) => {
    next: 0
    offset: 0
    output: ascii("")
    reads: 0
    writes: 0
    closes: 0
    closeCompleted: false
    readFailure: null
    writeFailure: null
    closeFailure: null
    onWrite: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            failure: readFailure
            result: null
            if((failure === null) && (next < chunks.size())) {
                chunk: chunks[next]
                end: chunk.size()
                if((end - offset) > maxBytes) {
                    end = offset + maxBytes
                }
                result = ascii("")
                index: offset
                while(index < end) {
                    result.add(chunk[index])
                    index = index + 1
                }
                if(end == chunk.size()) {
                    next = next + 1
                    offset = 0
                } else {
                    offset = end
                }
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            if(onWrite !== null) {
                onWrite(bytes)
            }
            failure: writeFailure
            if(failure === null) {
                bytes.each((octet) => {
                    output.add(octet)
                })
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                fixture
            }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                closeCompleted = true
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        written: () => {
            text(output)
        }
        readCount: () => {
            reads
        }
        writeCount: () => {
            writes
        }
        closeCount: () => {
            closes
        }
        closeDone: () => {
            closeCompleted
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failWritesWith: (error) => {
            writeFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        whenWriting: (callback) => {
            onWrite = callback
        }
    }
    fixture
}

// Answers the Error a Future fails with, or null when it resolves.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

responseOf: (status, headers, body) => {
    response: {
        status: status
        headers: headers
        body: body
    }
    response
}

ok: (request) => {
    responseOf(200, [], null)
}

getRequest: () => {
    ascii("GET / HTTP/1.1\r\nHost: example.org\r\n\r\n")
}

// Serves one request from chunks with handler and answers {duplex, failure}.
serveWith: (chunks, handler, limits) => {
    servedDuplex: duplexOf(chunks)
    caught: failureOf(http.Server.serveOne(servedDuplex, handler, limits))
    outcome: {
        duplex: servedDuplex
        failure: caught
    }
    outcome
}

serve: (chunks, handler) => {
    serveWith(chunks, handler, null)
}

statusLine: (status) => {
    "HTTP/1.1 " + status + " \r\n"
}

emptyResponse: (status) => {
    statusLine(status) + "Content-Length: 0\r\nConnection: close\r\n\r\n"
}

// Serves one GET (or HEAD) and answers the handler's fixed response outcome.
respond: (response) => {
    serve([getRequest()], (request) => {
        response
    })
}

respondToHead: (response) => {
    serve([ascii("HEAD / HTTP/1.1\r\nHost: example.org\r\n\r\n")], (request) => {
        response
    })
}

newLog: () => {
    log: {
        entries: []
    }
    log
}

record: (log, entry) => {
    log.entries = Array(...log.entries, entry)
}

// A ByteReadable over chunks that records each read into log and counts
// close invocations.
streamOf: (chunks, log) => {
    index: 0
    closes: 0
    stream: {
        read: (maxBytes) => {
            record(log, "read")
            chunk: null
            if(index < chunks.size()) {
                chunk = chunks[index]
                index = index + 1
            }
            (() => { chunk }).future()
        }
        close: () => {
            closes = closes + 1
            (() => { null }).future()
        }
        readCount: () => {
            index
        }
        closeCount: () => {
            closes
        }
    }
    stream
}

isInvalidResponse: (outcome) => {
    (outcome.failure !== null) &&
        (outcome.failure.parent() === http.HttpError) &&
        (outcome.failure.kind == "invalidResponse") &&
        !outcome.failure.hasSlot("status")
}

tests: [
    Test("status outside 200 through 599 is an invalid response", () => {
        statuses: [100, 101, 199, 600, "200", null]
        index: 0
        while(index < statuses.size()) {
            status: statuses[index]
            outcome: respond(responseOf(status, [], null))
            Assertions.require(isInvalidResponse(outcome))
            Assertions.require(outcome.duplex.written() == emptyResponse("500"))
            index = index + 1
        }
    }),
    Test("a response without the required own slots is invalid", () => {
        missingBody: {
            status: 200
            headers: []
        }
        Assertions.require(isInvalidResponse(respond(missingBody)))
        base: responseOf(200, [], null)
        inherited: base {}
        Assertions.require(isInvalidResponse(respond(inherited)))
        Assertions.require(isInvalidResponse(respond(responseOf(200, "headers", null))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [["A", ascii("1"), ascii("2")]], null))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [], "body"))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [], 5))))
    }),
    Test("reserved framing fields are rejected case-insensitively", () => {
        names: ["Content-Length", "transfer-encoding", "CONNECTION", "Upgrade", "Trailer", "te", "Keep-Alive", "proxy-connection"]
        index: 0
        while(index < names.size()) {
            name: names[index]
            outcome: respond(responseOf(200, [[name, ascii("1")]], null))
            Assertions.require(isInvalidResponse(outcome))
            index = index + 1
        }
    }),
    Test("invalid field names and values are rejected without coercion", () => {
        Assertions.require(isInvalidResponse(respond(responseOf(200, [["Bad Name", ascii("v")]], null))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [["", ascii("v")]], null))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [["X", ascii("a\r\nb")]], null))))
        Assertions.require(isInvalidResponse(respond(responseOf(200, [["X", "text"]], null))))
    }),
    Test("binary and duplicate header values are emitted in order", () => {
        value: ascii("")
        value.add(128)
        value.add(255)
        outcome: respond(responseOf(200, [["X-A", ascii("1")], ["X-Bin", value], ["X-A", ascii("2")]], null))
        Assertions.require(outcome.failure === null)
        Assertions.require(outcome.duplex.written() ==
            statusLine("200") + "X-A: 1\r\nX-Bin: " + text(value) + "\r\nX-A: 2\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    }),
    Test("the response is captured before emission", () => {
        dx: duplexOf([getRequest()])
        body: ascii("abc")
        headers: [["X", ascii("1")]]
        dx.whenWriting((bytes) => {
            body[0] = 122
            body.add(33)
            headers[0][1] = ascii("changed")
        })
        service: http.Server.serveOne(dx, (request) => {
            responseOf(200, headers, body)
        }, null)
        service.value()
        Assertions.require(dx.written() ==
            statusLine("200") + "X: 1\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")
    }),
    Test("a null body is framed with Content-Length 0", () => {
        outcome: respond(responseOf(200, [], null))
        Assertions.require(outcome.duplex.written() == emptyResponse("200"))
    }),
    Test("an empty Bytes body is framed with Content-Length 0", () => {
        outcome: respond(responseOf(201, [], ascii("")))
        Assertions.require(outcome.duplex.written() == emptyResponse("201"))
    }),
    Test("a Bytes body is emitted with its exact length", () => {
        outcome: respond(responseOf(404, [], ascii("missing")))
        Assertions.require(outcome.duplex.written() ==
            statusLine("404") + "Content-Length: 7\r\nConnection: close\r\n\r\nmissing")
    }),
    Test("a ByteReadable body is streamed with exact chunked framing", () => {
        stream: streamOf([ascii("hello"), ascii(" world")], newLog())
        outcome: respond(responseOf(200, [], stream))
        Assertions.require(outcome.failure === null)
        Assertions.require(outcome.duplex.written() ==
            statusLine("200") + "Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n" +
            "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n")
        Assertions.require(stream.closeCount() == 0)
    }),
    Test("an empty ByteReadable body emits only the last chunk", () => {
        stream: streamOf([], newLog())
        outcome: respond(responseOf(200, [], stream))
        Assertions.require(outcome.duplex.written() ==
            statusLine("200") + "Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n0\r\n\r\n")
    }),
    Test("streaming waits for each write before the next read", () => {
        events: newLog()
        dx: duplexOf([getRequest()])
        dx.whenWriting((bytes) => {
            record(events, "write")
        })
        stream: streamOf([ascii("a"), ascii("b")], events)
        service: http.Server.serveOne(dx, (request) => {
            responseOf(200, [], stream)
        }, null)
        service.value()
        expected: ["write", "read", "write", "read", "write", "read", "write"]
        Assertions.require(events.entries.size() == expected.size())
        index: 0
        while(index < expected.size()) {
            Assertions.require(events.entries[index] == expected[index])
            index = index + 1
        }
    }),
    Test("204 and 304 emit no framing field and no content", () => {
        Assertions.require(respond(responseOf(204, [], null)).duplex.written() ==
            statusLine("204") + "Connection: close\r\n\r\n")
        Assertions.require(respond(responseOf(304, [], ascii(""))).duplex.written() ==
            statusLine("304") + "Connection: close\r\n\r\n")
    }),
    Test("205 always emits Content-Length 0", () => {
        Assertions.require(respond(responseOf(205, [], null)).duplex.written() == emptyResponse("205"))
    }),
    Test("204 205 and 304 reject content without reading a stream", () => {
        Assertions.require(isInvalidResponse(respond(responseOf(204, [], ascii("abc")))))
        stream: streamOf([ascii("x")], newLog())
        Assertions.require(isInvalidResponse(respond(responseOf(205, [], stream))))
        Assertions.require(stream.readCount() == 0)
        empty: streamOf([], newLog())
        Assertions.require(isInvalidResponse(respond(responseOf(304, [], empty))))
        Assertions.require(empty.readCount() == 0)
    }),
    Test("HEAD with a null body emits Content-Length 0", () => {
        Assertions.require(respondToHead(responseOf(200, [], null)).duplex.written() == emptyResponse("200"))
    }),
    Test("HEAD with Bytes emits the length but no content", () => {
        Assertions.require(respondToHead(responseOf(200, [], ascii("hello"))).duplex.written() ==
            statusLine("200") + "Content-Length: 5\r\nConnection: close\r\n\r\n")
    }),
    Test("HEAD with a ByteReadable neither reads nor frames it", () => {
        stream: streamOf([ascii("hello")], newLog())
        outcome: respondToHead(responseOf(200, [], stream))
        Assertions.require(outcome.failure === null)
        Assertions.require(stream.readCount() == 0)
        Assertions.require(stream.closeCount() == 0)
        Assertions.require(outcome.duplex.written() == statusLine("200") + "Connection: close\r\n\r\n")
    }),
    Test("a returned Future is an invalid response", () => {
        outcome: serve([getRequest()], (request) => {
            (() => { responseOf(200, [], null) }).future()
        })
        Assertions.require(isInvalidResponse(outcome))
        Assertions.require(outcome.duplex.written() == emptyResponse("500"))
    }),
    Test("a handler failure keeps its identity after a best-effort 500", () => {
        handlerError: Error {}
        outcome: serve([getRequest()], (request) => {
            handlerError.signal()
        })
        Assertions.require(outcome.failure === handlerError)
        Assertions.require(outcome.duplex.written() == emptyResponse("500"))
    }),
    Test("a failed response write is not retried", () => {
        writeError: IOError {}
        dx: duplexOf([getRequest()])
        dx.failWritesWith(writeError)
        failure: failureOf(http.Server.serveOne(dx, ok, null))
        Assertions.require(failure === writeError)
        Assertions.require(dx.writeCount() == 1)
    }),
    Test("a failed best-effort 400 after an initial rejection propagates the write Error", () => {
        writeError: IOError {}
        dx: duplexOf([ascii("BAD\r\n\r\n")])
        dx.failWritesWith(writeError)
        failure: failureOf(http.Server.serveOne(dx, ok, null))
        Assertions.require(failure === writeError)
        Assertions.require(dx.writeCount() == 1)
    }),
    Test("a failed best-effort 500 after a handler failure propagates the write Error", () => {
        writeError: IOError {}
        dx: duplexOf([getRequest()])
        dx.failWritesWith(writeError)
        failure: failureOf(http.Server.serveOne(dx, (request) => {
            Error().signal()
        }, null))
        Assertions.require(failure === writeError)
        Assertions.require(dx.writeCount() == 1)
    }),
    Test("a failed best-effort 400 after a late framer failure keeps the HttpError", () => {
        writeError: IOError {}
        dx: duplexOf([ascii("POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n")])
        dx.failWritesWith(writeError)
        original: null
        failure: failureOf(http.Server.serveOne(dx, (request) => {
            original = failureOf(request.body.read(4))
            ok(request)
        }, null))
        Assertions.require(original.kind == "malformedRequest")
        Assertions.require(failure === original)
        Assertions.require(dx.writeCount() == 1)
    }),
    Test("a stream failure after commitment writes no last chunk and no second response", () => {
        streamError: Error {}
        reads: 0
        stream: {
            read: (maxBytes) => {
                reads = reads + 1
                count: reads
                (() => {
                    if(count > 1) {
                        streamError.signal()
                    }
                    ascii("abc")
                }).future()
            }
        }
        outcome: respond(responseOf(200, [], stream))
        Assertions.require(outcome.failure === streamError)
        Assertions.require(outcome.duplex.written() ==
            statusLine("200") + "Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n")
    })
]
