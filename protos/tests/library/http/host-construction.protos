Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
http: import("std:http/Host")
HostConfig: import("std:http/internal/HostConfig")

// The suite has no Network: every construction below is rejected before any
// listener custody, Worker or I/O could exist (HTTP.md §15.2).
handlerModule: "std:http/Server"

construct: (listener) => {
    Assertions.signals(InvalidIOArgument, () => {
        http.Host.owning(listener, handlerModule, "Server")
    })
}

// HTTP.md §15.13: the factory variant validates the same structural
// arguments, before custody, and never examines initialization first.
constructWithFactory: (listener, factoryModule, factoryBinding, initialization) => {
    Assertions.signals(InvalidIOArgument, () => {
        http.Host.owningWithFactory(listener, factoryModule, factoryBinding, initialization)
    })
}

// D237: an association failure is a fresh generic Error signalled before the
// selected Closure runs, never an InvalidIOArgument.
associationError: (action) => {
    failure: Assertions.signals(Error, action)
    Assertions.require(failure.parent() === Error)
    failure
}

tests: [
    Test("module exports exactly Host and HostError", () => {
        names: http.slotNames()
        Assertions.require(names.size() == 2)
        Assertions.require(names[0] == "Host")
        Assertions.require(names[1] == "HostError")
        Assertions.require(!http.hasSlot("_httpAsyncFacility"))
    }),
    Test("Host and HostError are not Prelude bindings", () => {
        Assertions.signals(SlotNotFound, () => { Host })
        Assertions.signals(SlotNotFound, () => { HostError })
    }),
    Test("HostError delegates directly to Error", () => {
        Assertions.require(http.HostError.parent() === Error)
    }),
    Test("the host facility exposes only owning, owningWithFactory and no serve variant", () => {
        names: http.Host.slotNames()
        Assertions.require(names.size() == 2)
        Assertions.require(names[0] == "owning")
        Assertions.require(names[1] == "owningWithFactory")
        Assertions.require(!http.Host.hasSlot("borrowing"))
        server: import("std:http/Server").Server
        Assertions.require(!server.hasSlot("serve"))
    }),
    Test("an invalid workers value signals InvalidIOArgument before the listener is examined", () => {
        for(workers in [0, -1, 2147483648, "1", 1.0, null]) {
            Assertions.signals(InvalidIOArgument, () => {
                http.Host.owning(null, handlerModule, "Server", workers: workers)
            })
        }
        null
    }),
    Test("an invalid maxConnections value signals InvalidIOArgument", () => {
        for(maxConnections in [0, -1, 2147483648, "64", null]) {
            Assertions.signals(InvalidIOArgument, () => {
                http.Host.owning(null, handlerModule, "Server", maxConnections: maxConnections)
            })
        }
        null
    }),
    Test("an invalid maxPendingAccepts value signals InvalidIOArgument", () => {
        for(maxPendingAccepts in [0, -1, 65, "1", null]) {
            Assertions.signals(InvalidIOArgument, () => {
                http.Host.owning(null, handlerModule, "Server", maxPendingAccepts: maxPendingAccepts)
            })
        }
        null
    }),
    Test("an ordinary object as a numeric option signals InvalidIOArgument", () => {
        Assertions.require(Integer.recognizes({}) == false)
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", workers: {})
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", maxConnections: {})
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", maxPendingAccepts: {})
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, workers: {})
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, maxConnections: {})
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, maxPendingAccepts: {})
        })
    }),
    Test("the ordering workers <= maxPendingAccepts <= maxConnections is required", () => {
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", workers: 3, maxPendingAccepts: 2)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", maxConnections: 4, maxPendingAccepts: 5)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", workers: 5, maxConnections: 4, maxPendingAccepts: 4)
        })
    }),
    Test("the maxPendingAccepts default is the bound workers value", () => {
        // workers: 65 alone defaults maxPendingAccepts to 65, which exceeds
        // the default maxConnections of 64.
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", workers: 65)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, workers: 65)
        })
        // The default reads workers as bound, even when workers is supplied
        // after maxConnections in the source.
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", maxConnections: 8, workers: 9)
        })
    }),
    Test("an invalid limits object signals InvalidIOArgument", () => {
        for(limits in [1, "limits", [], { maxHeaderFields: 0 }, { unknownLimit: 1 }]) {
            Assertions.signals(InvalidIOArgument, () => {
                http.Host.owning(null, handlerModule, "Server", limits: limits)
            })
        }
        null
    }),
    Test("an unknown label or a positional and named collision is an association Error", () => {
        invoked: false
        fake: {
            acceptCapability: () => {
                invoked = true
                null
            }
            close: () => {
                invoked = true
                null
            }
        }
        associationError(() => {
            http.Host.owning(fake, handlerModule, "Server", backlog: 1)
        })
        associationError(() => {
            http.Host.owning(fake, handlerModule, "Server", cpus: 1)
        })
        associationError(() => {
            http.Host.owning(fake, handlerModule, "Server", options: { workers: 1 })
        })
        associationError(() => {
            http.Host.owning(fake, handlerModule, "Server", 1, workers: 1)
        })
        associationError(() => {
            http.Host.owningWithFactory(fake, handlerModule, "Server", null, backlog: 1)
        })
        associationError(() => {
            http.Host.owningWithFactory(fake, handlerModule, "Server", null, initialization: null)
        })
        // An association Error wins even over an invalid named value.
        associationError(() => {
            http.Host.owning(fake, handlerModule, "Server", workers: 0, backlog: 1)
        })
        Assertions.require(!invoked)
    }),
    Test("a trailing null is a positional workers value, not default options", () => {
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, "Server", null)
        })
    }),
    Test("handler module and binding must be Strings", () => {
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, () => { 1 }, "Server")
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(null, handlerModule, 1)
        })
    }),
    Test("no listener is acquired implicitly", () => {
        Assertions.require(!http.hasSlot("network"))
        Assertions.require(!http.Host.hasSlot("network"))
        construct(null)
        construct({})
        construct(42)
        construct("127.0.0.1:8080")
    }),
    Test("an ordinary object posing as a listener is never invoked", () => {
        invoked: false
        fake: {
            acceptCapability: () => {
                invoked = true
                null
            }
            close: () => {
                invoked = true
                null
            }
        }
        construct(fake)
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owning(fake, handlerModule, "Server", workers: 0)
        })
        Assertions.require(!invoked)
    }),
    Test("owningWithFactory rejects invalid named options before the listener is examined", () => {
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, workers: 0)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, maxConnections: 0)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, maxPendingAccepts: 65)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, workers: 3, maxPendingAccepts: 2)
        })
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", null, limits: { maxHeaderFields: 0 })
        })
    }),
    Test("owningWithFactory requires factory module and binding Strings", () => {
        constructWithFactory(null, () => { 1 }, "Server", null)
        constructWithFactory(null, handlerModule, 1, null)
        constructWithFactory(null, null, "Server", null)
        constructWithFactory(null, handlerModule, null, null)
    }),
    Test("owningWithFactory acquires no listener implicitly and never invokes a fake one", () => {
        invoked: false
        fake: {
            acceptCapability: () => {
                invoked = true
                null
            }
            close: () => {
                invoked = true
                null
            }
        }
        for(listener in [null, {}, 42, "127.0.0.1:8080", fake]) {
            constructWithFactory(listener, handlerModule, "Server", null)
        }
        Assertions.require(!invoked)
    }),
    Test("a structural rejection precedes any examination of initialization", () => {
        // A non-transferable initialization is not a structural argument: an
        // invalid listener, option or String is still an InvalidIOArgument.
        hostile: {
            run: () => { 1 }
            pending: (() => { 1 }).future()
        }
        constructWithFactory(null, handlerModule, "Server", hostile)
        Assertions.signals(InvalidIOArgument, () => {
            http.Host.owningWithFactory(null, handlerModule, "Server", hostile, workers: 0)
        })
        constructWithFactory(null, handlerModule, 1, hostile)
        hostile.pending.value()
    }),
    Test("every rejection is a fresh InvalidIOArgument", () => {
        first: construct(null)
        second: construct(null)
        Assertions.require(first.parent() === InvalidIOArgument)
        Assertions.require(second.parent() === InvalidIOArgument)
        Assertions.require(first !== second)
    }),
    Test("quotas split each limit as floor(L / W) plus one below L mod W", () => {
        Assertions.require(HostConfig.quota(10, 3, 0) == 4)
        Assertions.require(HostConfig.quota(10, 3, 1) == 3)
        Assertions.require(HostConfig.quota(10, 3, 2) == 3)
        Assertions.require(HostConfig.quota(64, 1, 0) == 64)
        Assertions.require(HostConfig.quota(5, 5, 4) == 1)
        Assertions.require(HostConfig.quota(7, 4, 2) == 2)
        Assertions.require(HostConfig.quota(7, 4, 3) == 1)
    }),
    Test("quotas sum exactly to the global limit", () => {
        for(pair in [[64, 1], [64, 3], [7, 4], [2147483647, 7], [9, 9]]) {
            total: 0
            index: 0
            previous: null
            while(index < pair[1]) {
                share: HostConfig.quota(pair[0], pair[1], index)
                Assertions.require(share >= 1)
                if(previous !== null) {
                    Assertions.require((previous == share) || (previous == share + 1))
                }
                previous = share
                total = total + share
                index = index + 1
            }
            Assertions.require(total == pair[0])
        }
        null
    })
]
tests.freeze()
