Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Level: import("std:logging/Level")

ordered: [Level.TRACE, Level.DEBUG, Level.INFO, Level.WARN, Level.ERROR]

rejectsCompare: (left, right) => {
    Assertions.signals(Error, () => {
        Level.compare(left, right)
    })
    true
}

tests: [
    Test("levels are their canonical String values", () => {
        Assertions.require(Level.TRACE === "TRACE")
        Assertions.require(Level.DEBUG === "DEBUG")
        Assertions.require(Level.INFO === "INFO")
        Assertions.require(Level.WARN === "WARN")
        Assertions.require(Level.ERROR === "ERROR")
        Assertions.require(import("std:logging/Level").INFO === Level.INFO)
    }),
    Test("exactly five levels and no FATAL", () => {
        Assertions.require(Level.hasSlot("FATAL") == false)
        Assertions.require(Level.hasSlot("CRITICAL") == false)
        Assertions.require(Level.hasSlot("OFF") == false)
        ordered.each((level) => {
            Assertions.require(Level.compare(level, level) == 0)
        })
    }),
    Test("severity order is TRACE < DEBUG < INFO < WARN < ERROR", () => {
        leftIndex: 0
        ordered.each((left) => {
            rightIndex: 0
            ordered.each((right) => {
                expected: 0
                (leftIndex < rightIndex).ifTrue(() => {
                    expected = -1
                })
                (leftIndex > rightIndex).ifTrue(() => {
                    expected = 1
                })
                Assertions.require(Level.compare(left, right) == expected)
                rightIndex = rightIndex + 1
            })
            leftIndex = leftIndex + 1
        })
    }),
    Test("compare rejects values that are not canonical levels", () => {
        rejectsCompare("FATAL", Level.INFO)
        rejectsCompare(Level.INFO, "info")
        rejectsCompare(null, Level.INFO)
        rejectsCompare(Level.INFO, 2)
        rejectsCompare({ name: "INFO" }, Level.INFO)
        rejectsCompare(Level.INFO, ["INFO"])
    })
]
