Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Level: import("std:logging/Level")
Logger: import("std:logging/Logger")
Instant: import("std:datetime/Instant")

Failure: Error {}

// A minimal test sink that records every emitted event in order.
recorder: () => {
    events: []
    {
        events: events
        emit: (event) => {
            this.events = Array(...this.events, event)
        }
    }
}

// A test sink whose `emit` always signals, counting its invocations.
failingSink: () => {
    {
        calls: 0
        emit: (event) => {
            this.calls = this.calls + 1
            Failure().signal()
        }
    }
}

// A zero-argument time source answering successive instants from `start`,
// counting its invocations.
countingSource: (start) => {
    state: { calls: 0 }
    source: () => {
        state.calls = state.calls + 1
        Instant(start + state.calls - 1)
    }
    {
        state: state
        source: source
    }
}

// A time source that answers `result` and counts its invocations.
answering: (result) => {
    state: { calls: 0 }
    source: () => {
        state.calls = state.calls + 1
        result
    }
    {
        state: state
        source: source
    }
}

tests: [
    Test("minimum level filters less severe calls", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        logger.trace("t")
        logger.debug("d")
        logger.info("i")
        logger.warn("w")
        logger.error("e")
        Assertions.require(sink.events.size() == 3)
        Assertions.require(sink.events[0].level === Level.INFO)
        Assertions.require(sink.events[1].level === Level.WARN)
        Assertions.require(sink.events[2].level === Level.ERROR)
        Assertions.require(sink.events[2].message == "e")

        Assertions.require(logger.isEnabled(Level.TRACE) == false)
        Assertions.require(logger.isEnabled(Level.DEBUG) == false)
        Assertions.require(logger.isEnabled(Level.INFO))
        Assertions.require(logger.isEnabled(Level.WARN))
        Assertions.require(logger.isEnabled(Level.ERROR))

        everything: Logger(Level.TRACE, sink)
        everything.trace("t")
        everything.log(Level.DEBUG, "d")
        Assertions.require(sink.events.size() == 5)
        Assertions.require(sink.events[3].level === Level.TRACE)
        Assertions.require(sink.events[4].level === Level.DEBUG)
    }),
    Test("a disabled call inspects no data, creates no event, and skips the sink", () => {
        sink: failingSink()
        logger: Logger(Level.WARN, sink)
        cyclic: [1, 1]
        cyclic[1] = cyclic

        Assertions.require(logger.debug("d", %{ "cycle": cyclic; "object": { secret: 1 } }, "not an error") === null)
        Assertions.require(logger.trace(42, ["not a map"], 7) === null)
        Assertions.require(logger.log(Level.INFO, null, "not a map") === null)
        Assertions.require(sink.calls == 0)
    }),
    Test("isEnabled lets callers skip building expensive data", () => {
        builds: 0
        buildFields: () => {
            builds = builds + 1
            %{ "report": [1, 2, 3] }
        }

        quiet: recorder()
        quietLogger: Logger(Level.INFO, quiet)
        quietLogger.isEnabled(Level.DEBUG).ifTrue(() => {
            quietLogger.debug("expensive diagnostics", buildFields())
        })
        Assertions.require(builds == 0)
        Assertions.require(quiet.events.size() == 0)

        verbose: recorder()
        verboseLogger: Logger(Level.DEBUG, verbose)
        verboseLogger.isEnabled(Level.DEBUG).ifTrue(() => {
            verboseLogger.debug("expensive diagnostics", buildFields())
        })
        Assertions.require(builds == 1)
        Assertions.require(verbose.events.size() == 1)
        Assertions.require(verbose.events[0].fields["report"].size() == 3)
    }),
    Test("simple info emits exactly one event with no fields or error", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        Assertions.require(logger.info("started") === null)
        Assertions.require(sink.events.size() == 1)
        event: sink.events[0]
        Assertions.require(event.level === Level.INFO)
        Assertions.require(event.message == "started")
        Assertions.require(event.fields.size() == 0)
        Assertions.require(event.error === null)
    }),
    Test("call-site structured fields reach the sink", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        logger.info("cache refreshed", %{ "entries": 42; "tags": ["hot", "warm"] })
        event: sink.events[0]
        Assertions.require(event.message == "cache refreshed")
        Assertions.require(event.fields.size() == 2)
        Assertions.require(event.fields["entries"] == 42)
        Assertions.require(event.fields["tags"][1] == "warm")
    }),
    Test("an Error is attached by identity", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        failure: Failure()
        logger.error("request failed", %{ "requestId": "r-7" }, failure)
        logger.warn("retrying", null, failure)
        Assertions.require(sink.events.size() == 2)
        Assertions.require(sink.events[0].level === Level.ERROR)
        Assertions.require(sink.events[0].error === failure)
        Assertions.require(sink.events[0].fields["requestId"] == "r-7")
        Assertions.require(sink.events[1].error === failure)
        Assertions.require(sink.events[1].fields.size() == 0)
    }),
    Test("with derives a logger and leaves the original unchanged", () => {
        sink: recorder()
        base: Logger(Level.INFO, sink)
        derived: base.with(%{ "service": "api" })
        Assertions.require(derived !== base)
        Assertions.require(base.fields.size() == 0)
        Assertions.require(derived.fields["service"] == "api")
        Assertions.require(derived.sink === base.sink)
        Assertions.require(derived.minimumLevel === base.minimumLevel)
        Assertions.require(derived.isEnabled(Level.DEBUG) == false)

        base.info("plain")
        derived.info("contextual")
        derived.debug("filtered")
        Assertions.require(sink.events.size() == 2)
        Assertions.require(sink.events[0].fields.size() == 0)
        Assertions.require(sink.events[1].fields["service"] == "api")
    }),
    Test("successive derivations accumulate context", () => {
        sink: recorder()
        root: Logger(Level.TRACE, sink)
        first: root.with(%{ "a": 1 })
        second: first.with(%{ "b": 2 })
        third: second.with(%{ "c": 3 })
        third.trace("deep")
        first.trace("shallow")
        Assertions.require(sink.events[0].fields.size() == 3)
        Assertions.require(sink.events[0].fields["a"] == 1)
        Assertions.require(sink.events[0].fields["b"] == 2)
        Assertions.require(sink.events[0].fields["c"] == 3)
        Assertions.require(sink.events[1].fields.size() == 1)
        Assertions.require(second.fields.size() == 2)
    }),
    Test("precedence is base < derived < call site", () => {
        sink: recorder()
        base: Logger(Level.INFO, sink).with(%{ "key": "base"; "onlyBase": 1 })
        derived: base.with(%{ "key": "derived"; "onlyDerived": 2 })

        derived.info("call site wins", %{ "key": "call"; "onlyCall": 3 })
        derived.info("derived wins")
        base.info("base only")

        callEvent: sink.events[0]
        Assertions.require(callEvent.fields.size() == 4)
        Assertions.require(callEvent.fields["key"] == "call")
        Assertions.require(callEvent.fields["onlyBase"] == 1)
        Assertions.require(callEvent.fields["onlyDerived"] == 2)
        Assertions.require(callEvent.fields["onlyCall"] == 3)
        Assertions.require(sink.events[1].fields["key"] == "derived")
        Assertions.require(sink.events[2].fields["key"] == "base")
        Assertions.require(derived.fields["key"] == "derived")
    }),
    Test("mutating supplied context does not change a derived logger", () => {
        sink: recorder()
        nested: [1]
        supplied: %{ "list": nested }
        derived: Logger(Level.INFO, sink).with(supplied)

        supplied["late"] = true
        supplied["list"] = "replaced"
        nested[0] = 2

        Assertions.require(derived.fields.size() == 1)
        Assertions.require(derived.fields["list"].size() == 1)
        Assertions.require(derived.fields["list"][0] == 1)
        derived.info("after mutation")
        Assertions.require(sink.events[0].fields.size() == 1)
        Assertions.require(sink.events[0].fields["list"].size() == 1)
        Assertions.signals(Error, () => {
            derived.fields["list"][0] = 3
        })
    }),
    Test("mutating call-site data does not change an emitted event", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        nested: %{ "count": 1 }
        list: [nested]
        fields: %{ "list": list }
        logger.info("materialized", fields)

        fields["list"] = null
        list[0] = "extra"
        nested["count"] = 2

        event: sink.events[0]
        Assertions.require(event.fields["list"].size() == 1)
        Assertions.require(event.fields["list"][0]["count"] == 1)
    }),
    Test("the sink receives exactly the expected event once", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink).with(%{ "service": "api" })
        failure: Failure()
        logger.error("boom", %{ "attempt": 3 }, failure)
        Assertions.require(sink.events.size() == 1)
        event: sink.events[0]
        Assertions.require(event.slotNames().size() == 5)
        Assertions.require(event.timestamp === null)
        Assertions.require(event.level === Level.ERROR)
        Assertions.require(event.message == "boom")
        Assertions.require(event.fields.size() == 2)
        Assertions.require(event.fields["service"] == "api")
        Assertions.require(event.fields["attempt"] == 3)
        Assertions.require(event.error === failure)
        Assertions.signals(Error, () => {
            event.message = "changed"
        })
    }),
    Test("an Error signalled by the sink does not escape the logging call", () => {
        sink: failingSink()
        logger: Logger(Level.INFO, sink)
        Assertions.require(logger.info("first") === null)
        Assertions.require(logger.error("second", %{ "k": 1 }, Error()) === null)
        Assertions.require(logger.with(%{ "k": 2 }).warn("third") === null)
        Assertions.require(sink.calls == 3)
    }),
    Test("sink containment does not hide invalid enabled arguments", () => {
        sink: failingSink()
        logger: Logger(Level.INFO, sink)
        Assertions.signals(Error, () => {
            logger.info(42)
        })
        Assertions.signals(Error, () => {
            logger.info("m", ["not a map"])
        })
        Assertions.signals(Error, () => {
            logger.info("m", %{ "object": { secret: 1 } })
        })
        Assertions.signals(Error, () => {
            logger.info("m", %{ 1: "integer key" })
        })
        Assertions.signals(Error, () => {
            logger.info("m", null, "not an error")
        })
        Assertions.signals(Error, () => {
            logger.info("m", null, null, "extra")
        })
        Assertions.require(sink.calls == 0)
    }),
    Test("a logger without a time source emits events without a timestamp", () => {
        sink: recorder()
        Logger(Level.INFO, sink).info("two arguments")
        Logger(Level.INFO, sink, null).with(%{ "k": 1 }).warn("explicit null")
        Assertions.require(sink.events.size() == 2)
        Assertions.require(sink.events[0].timestamp === null)
        Assertions.require(sink.events[1].timestamp === null)
    }),
    Test("an enabled call invokes the time source exactly once and stores its Instant", () => {
        sink: recorder()
        instant: Instant(1791342922123456789)
        clock: answering(instant)
        logger: Logger(Level.INFO, sink, clock.source)
        Assertions.require(clock.state.calls == 0)

        Assertions.require(logger.error("stamped", %{ "k": 1 }, Failure()) === null)
        Assertions.require(clock.state.calls == 1)
        Assertions.require(sink.events.size() == 1)
        Assertions.require(sink.events[0].timestamp === instant)
        Assertions.require(sink.events[0].fields["k"] == 1)

        logger.info("again")
        Assertions.require(clock.state.calls == 2)
        Assertions.require(sink.events.size() == 2)
    }),
    Test("a disabled call never reads the time source", () => {
        sink: failingSink()
        clock: countingSource(0)
        logger: Logger(Level.WARN, sink, clock.source)
        cyclic: [1, 1]
        cyclic[1] = cyclic

        Assertions.require(logger.isEnabled(Level.DEBUG) == false)
        Assertions.require(logger.debug("d", %{ "cycle": cyclic; "object": { secret: 1 } }, "not an error") === null)
        Assertions.require(logger.trace(42, ["not a map"], 7) === null)
        Assertions.require(logger.log(Level.INFO, null, "not a map") === null)
        Assertions.require(clock.state.calls == 0)
        Assertions.require(sink.calls == 0)
    }),
    Test("invalid enabled fields fail before the time source is read", () => {
        sink: recorder()
        clock: countingSource(0)
        logger: Logger(Level.INFO, sink, clock.source)
        Assertions.signals(Error, () => {
            logger.info("m", ["not a map"])
        })
        Assertions.signals(Error, () => {
            logger.info("m", %{ 1: "integer key" })
        })
        Assertions.require(clock.state.calls == 0)
        Assertions.require(sink.events.size() == 0)
    }),
    Test("derived loggers share the time source without reading it", () => {
        sink: recorder()
        clock: countingSource(10)
        base: Logger(Level.INFO, sink, clock.source).with(%{ "key": "base" })
        derived: base.with(%{ "key": "derived"; "onlyDerived": 2 })
        Assertions.require(clock.state.calls == 0)

        derived.info("call site wins", %{ "key": "call" })
        base.info("base")
        Assertions.require(clock.state.calls == 2)
        Assertions.require(sink.events[0].timestamp.nanoseconds == 10)
        Assertions.require(sink.events[0].fields["key"] == "call")
        Assertions.require(sink.events[0].fields["onlyDerived"] == 2)
        Assertions.require(sink.events[1].timestamp.nanoseconds == 11)
        Assertions.require(sink.events[1].fields["key"] == "base")
    }),
    Test("a failing time source signals Error and emits nothing", () => {
        sink: recorder()
        calls: { count: 0 }
        signalling: () => {
            calls.count = calls.count + 1
            Failure().signal()
        }
        Assertions.signals(Failure, () => {
            Logger(Level.INFO, sink, signalling).info("m")
        })
        Assertions.require(calls.count == 1)

        nullClock: answering(null)
        Assertions.signals(Error, () => {
            Logger(Level.INFO, sink, nullClock.source).info("m")
        })
        Assertions.require(nullClock.state.calls == 1)

        [0, "1970-01-01T00:00:00Z", Instant, { nanoseconds: 0 }].each((result) => {
            clock: answering(result)
            Assertions.signals(Error, () => {
                Logger(Level.INFO, sink, clock.source).warn("m")
            })
            Assertions.require(clock.state.calls == 1)
        })
        Assertions.require(sink.events.size() == 0)
    }),
    Test("a time-source failure is not contained as a sink failure", () => {
        sink: failingSink()
        clock: answering("not an instant")
        Assertions.signals(Error, () => {
            Logger(Level.INFO, sink, clock.source).info("m")
        })
        Assertions.require(sink.calls == 0)

        stamped: Logger(Level.INFO, sink, countingSource(0).source)
        Assertions.require(stamped.info("contained") === null)
        Assertions.require(sink.calls == 1)
    }),
    Test("invalid levels, sinks, and contexts signal Error", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        Assertions.signals(Error, () => {
            Logger("FATAL", sink)
        })
        Assertions.signals(Error, () => {
            Logger(null, sink)
        })
        Assertions.signals(Error, () => {
            Logger(Level.INFO, null)
        })
        Assertions.signals(Error, () => {
            logger.isEnabled("VERBOSE")
        })
        Assertions.signals(Error, () => {
            logger.log("VERBOSE", "m")
        })
        Assertions.signals(Error, () => {
            logger.log(null, "m")
        })
        Assertions.signals(Error, () => {
            logger.with(null)
        })
        Assertions.signals(Error, () => {
            logger.with([1])
        })
        Assertions.signals(Error, () => {
            logger.with(%{ 1: 2 })
        })
        Assertions.signals(Error, () => {
            logger.with(%{ "closure": () => { 1 } })
        })
        Assertions.require(sink.events.size() == 0)
    }),
    Test("a logger is frozen and holds no ambient authority", () => {
        sink: recorder()
        logger: Logger(Level.INFO, sink)
        Assertions.require(logger.slotNames().size() == 11)
        Assertions.require(logger.sink === sink)
        Assertions.require(Logger(Level.INFO, sink, () => { Instant(0) }).slotNames().size() == 11)
        Assertions.signals(Error, () => {
            logger.minimumLevel = Level.TRACE
        })
        Assertions.signals(Error, () => {
            logger.fields["late"] = true
        })
        Assertions.require(Logger.hasSlot("default") == false)
        Assertions.require(Logger.hasSlot("global") == false)
        Assertions.require(Logger.hasSlot("registry") == false)
    })
]
