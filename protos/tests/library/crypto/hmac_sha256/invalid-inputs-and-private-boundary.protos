Assertions: import("std:test/assertions")
Test: import("std:test/test")
HMAC: import("std:crypto/hmac_sha256")

emptyBytes: () => Encoding.UTF8.encode("")

repeatedBytes: (value, count) => {
    result: emptyBytes()
    index: 0
    while(index < count) {
        result.add(value)
        index = index + 1
    }
    result
}

fromOctets: (values) => {
    result: emptyBytes()
    for(value in values) {
        result.add(value)
    }
    result
}

sameOctets: (actual, expected) => {
    ok: actual.size() == expected.size()
    if(ok) {
        index: 0
        for(value in expected) {
            (actual[index] == value).ifFalse(() => {
                ok = false
            })
            index = index + 1
        }
    }
    ok
}

tests: [
    Test("invalid key domain", () => {
        Assertions.signals(Error, () => {
            HMAC.digest(Array(), emptyBytes())
        })
        Assertions.signals(Error, () => {
            HMAC.verify("key", emptyBytes(), repeatedBytes(0, 32))
        })
    }),
    Test("invalid message domain", () => {
        Assertions.signals(Error, () => {
            HMAC.digest(emptyBytes(), "message")
        })
        Assertions.signals(Error, () => {
            HMAC.verify(emptyBytes(), Array(), repeatedBytes(0, 32))
        })
    }),
    Test("invalid tag domain", () => {
        Assertions.signals(Error, () => {
            HMAC.verify(emptyBytes(), emptyBytes(), Array())
        })
        Assertions.signals(Error, () => {
            HMAC.verify(emptyBytes(), emptyBytes(), null)
        })
    }),
    Test("oversized key 4097", () => {
        key: repeatedBytes(170, 4097)
        Assertions.signals(Error, () => {
            HMAC.digest(key, emptyBytes())
        })
        Assertions.signals(Error, () => {
            HMAC.verify(key, emptyBytes(), repeatedBytes(0, 32))
        })
    }),
    Test("ordinary objects cannot impersonate Bytes", () => {
        fake: {
            size: () => 32
            at: (index) => 0
            each: (visitor) => null
        }
        Assertions.signals(Error, () => {
            HMAC.digest(fake, emptyBytes())
        })
        Assertions.signals(Error, () => {
            HMAC.verify(emptyBytes(), fake, repeatedBytes(0, 32))
        })
        Assertions.signals(Error, () => {
            HMAC.verify(emptyBytes(), emptyBytes(), fake)
        })
    }),
    Test("only digest and verify are exported", () => {
        names: HMAC.slotNames()
        Assertions.require(names.size() == 2)

        foundDigest: false
        foundVerify: false

        for(name in names) {
            if(name == "digest") {
                foundDigest = true
            }
            if(name == "verify") {
                foundVerify = true
            }
        }

        Assertions.require(foundDigest && foundVerify)
    })
]
tests.freeze()
