Assertions: import("std:test/assertions")
Test: import("std:test/test")
HMAC: import("std:crypto/hmac_sha256")

emptyBytes: () => Encoding.UTF8.encode("")

repeatedBytes: (value, count) => {
    result: emptyBytes()
    index: 0
    while(index < count) {
        result.add(value)
        index = index + 1
    }
    result
}

fromOctets: (values) => {
    result: emptyBytes()
    for(value in values) {
        result.add(value)
    }
    result
}

sameOctets: (actual, expected) => {
    ok: actual.size() == expected.size()
    if(ok) {
        index: 0
        for(value in expected) {
            (actual[index] == value).ifFalse(() => {
                ok = false
            })
            index = index + 1
        }
    }
    ok
}

tests: [
    Test("matching tag and independent results", () => {
        key: Encoding.UTF8.encode("public test key")
        message: Encoding.UTF8.encode("message")
        first: HMAC.digest(key, message)
        second: HMAC.digest(key, message)

        Assertions.require(first !== second)
        Assertions.require(first.size() == 32)
        Assertions.require(sameOctets(first, second))
        Assertions.require(HMAC.verify(key, message, first))
    }),
    Test("wrong first middle and last octet", () => {
        key: Encoding.UTF8.encode("test key")
        message: Encoding.UTF8.encode("test data")
        correct: HMAC.digest(key, message)

        first: fromOctets(correct)
        middle: fromOctets(correct)
        last: fromOctets(correct)

        first[0] = (first[0] + 1).mod(256)
        middle[16] = (middle[16] + 1).mod(256)
        last[31] = (last[31] + 1).mod(256)

        Assertions.require(HMAC.verify(key, message, correct))
        Assertions.require(!HMAC.verify(key, message, first))
        Assertions.require(!HMAC.verify(key, message, middle))
        Assertions.require(!HMAC.verify(key, message, last))
    }),
    Test("wrong tag lengths", () => {
        key: Encoding.UTF8.encode("test key")
        message: Encoding.UTF8.encode("message")

        // Verify each length independently, without a nested iteration
        // callback. All five boundaries must return false, not Error.
        Assertions.require(!HMAC.verify(key, message, repeatedBytes(0, 0)))
        Assertions.require(!HMAC.verify(key, message, repeatedBytes(0, 1)))
        Assertions.require(!HMAC.verify(key, message, repeatedBytes(0, 16)))
        Assertions.require(!HMAC.verify(key, message, repeatedBytes(0, 31)))
        Assertions.require(!HMAC.verify(key, message, repeatedBytes(0, 33)))
    }),
    Test("truncated prefix is rejected", () => {
        key: Encoding.UTF8.encode("test key")
        message: Encoding.UTF8.encode("message")
        full: HMAC.digest(key, message)
        truncated: emptyBytes()

        index: 0
        while(index < 16) {
            truncated.add(full[index])
            index = index + 1
        }

        Assertions.require(!HMAC.verify(key, message, truncated))
    }),
    Test("caller mutations do not change previous results", () => {
        key: Encoding.UTF8.encode("test key")
        message: Encoding.UTF8.encode("message")
        first: HMAC.digest(key, message)
        saved: fromOctets(first)

        key.add(0)
        message.add(255)

        Assertions.require(sameOctets(first, saved))

        second: HMAC.digest(key, message)
        Assertions.require(first !== second)
        Assertions.require(!sameOctets(first, second))

        first.add(0)
        Assertions.require(sameOctets(saved, fromOctets(saved)))
        Assertions.require(first.size() == 33)
        Assertions.require(second.size() == 32)
    }),
    Test("input identities remain unchanged", () => {
        key: fromOctets(Array(0, 255, 1, 128))
        message: fromOctets(Array(254, 3, 0))
        keyCopy: fromOctets(key)
        messageCopy: fromOctets(message)

        tag: HMAC.digest(key, message)
        Assertions.require(sameOctets(key, keyCopy))
        Assertions.require(sameOctets(message, messageCopy))
        Assertions.require(HMAC.verify(key, message, tag))
        Assertions.require(sameOctets(key, keyCopy))
        Assertions.require(sameOctets(message, messageCopy))
    }),
    Test("actual Bytes ignore shadowed indexed selectors", () => {
        key: Encoding.UTF8.encode("Jefe")
        message: Encoding.UTF8.encode("what do ya want for nothing?")
        tag: HMAC.digest(key, message)

        calls: {
            size: 0
            at: 0
            each: 0
        }

        key.size: () => {
            calls.size = calls.size + 1
            Error().signal()
        }
        key.at: (index) => {
            calls.at = calls.at + 1
            Error().signal()
        }
        key.each: (visitor) => {
            calls.each = calls.each + 1
            Error().signal()
        }

        message.size: () => {
            calls.size = calls.size + 1
            Error().signal()
        }
        message.at: (index) => {
            calls.at = calls.at + 1
            Error().signal()
        }
        message.each: (visitor) => {
            calls.each = calls.each + 1
            Error().signal()
        }

        tag.size: () => {
            calls.size = calls.size + 1
            Error().signal()
        }
        tag.at: (index) => {
            calls.at = calls.at + 1
            Error().signal()
        }
        tag.each: (visitor) => {
            calls.each = calls.each + 1
            Error().signal()
        }

        Assertions.require(HMAC.verify(key, message, tag))

        another: HMAC.digest(key, message)
        Assertions.require(HMAC.verify(key, message, another))

        Assertions.require(calls.size == 0)
        Assertions.require(calls.at == 0)
        Assertions.require(calls.each == 0)
    }),
    Test("mutating one result does not alter another", () => {
        key: Encoding.UTF8.encode("test-key")
        message: Encoding.UTF8.encode("test-message")

        first: HMAC.digest(key, message)
        second: HMAC.digest(key, message)
        saved: fromOctets(second)

        Assertions.require(first !== second)
        Assertions.require(sameOctets(first, second))

        first[0] = (first[0] + 1).mod(256)
        first.add(255)

        Assertions.require(!sameOctets(first, second))
        Assertions.require(sameOctets(second, saved))
        Assertions.require(HMAC.verify(key, message, second))
        Assertions.require(!HMAC.verify(key, message, first))
    })
]
tests.freeze()
