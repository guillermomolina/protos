Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("abc", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("abc")
            digest: SHA256.digest(input)
            expected: Array(186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("empty", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("")
            digest: SHA256.digest(input)
            expected: Array(227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("a55", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            digest: SHA256.digest(input)
            expected: Array(159, 67, 144, 248, 211, 12, 45, 217, 46, 201, 240, 149, 182, 94, 43, 154, 233, 176, 169, 37, 165, 37, 142, 36, 28, 159, 30, 145, 15, 115, 67, 24)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("a56", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            digest: SHA256.digest(input)
            expected: Array(179, 84, 57, 164, 172, 111, 9, 72, 182, 214, 249, 227, 198, 175, 15, 95, 89, 12, 226, 15, 27, 222, 112, 144, 239, 121, 112, 104, 110, 198, 115, 138)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("a64", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            digest: SHA256.digest(input)
            expected: Array(255, 224, 84, 254, 122, 224, 203, 109, 198, 92, 58, 249, 182, 29, 82, 9, 244, 57, 133, 29, 180, 61, 11, 165, 153, 115, 55, 223, 21, 70, 104, 235)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("binary", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("")
            input.add(0)
            input.add(255)
            input.add(1)
            input.add(254)

            digest: SHA256.digest(input)
            expected: Array(93, 141, 145, 5, 145, 210, 114, 147, 138, 239, 95, 150, 110, 8, 22, 227, 116, 190, 175, 123, 90, 223, 2, 204, 165, 248, 247, 112, 89, 108, 44, 227)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("multi", () => {
        tool009LegacyCase: () => {
            SHA256: import("std:crypto/SHA256")
            input: Encoding.UTF8.encode("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
            digest: SHA256.digest(input)
            expected: Array(36, 141, 106, 97, 210, 6, 56, 184, 229, 192, 38, 147, 12, 62, 96, 57, 163, 60, 228, 89, 100, 255, 33, 103, 246, 236, 237, 212, 25, 219, 6, 193)

            ok: digest.size() == 32
            index: 0
            expected.each((octet) => {
                (digest[index] == octet).ifFalse(() => {
                    ok = false
                })
                index = index + 1
            })
            ok
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
