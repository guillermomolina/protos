Assertions: import("std:test/assertions")
Test: import("std:test/test")
Password: import("std:crypto/password")

prefix: "protos-password-v1:nfc:$argon2id$v=19$m=65536,t=3,p=4$"
saltText: "AAECAwQFBgcICQoLDA0ODw"
tagText: "vUrOhcKV+zjYROFncankOSUoKsmCyGVr5Vou9s8g/Vg"
valid: prefix + saltText + "$" + tagText

expectInvalid: (record) => {
    Assertions.signals(Password.PasswordError, () => {
        Password.needsRehash(record)
    })
}

// A malformed record must fail through the verification Future.
// It must never become a successful false comparison.
expectInvalidVerification: (record) => {
    Assertions.signals(Password.PasswordError, () => {
        Password.verify("password", record).value()
    })
}

tests: [
    Test("canonical baseline does not need rehash", () => {
        Assertions.require(!Password.needsRehash(valid))
    }),
    Test("incorrect record argument domain", () => {
        expectInvalid(null)
        expectInvalid(Array())
        expectInvalid(123)
    }),
    Test("missing fields and truncated base64", () => {
        expectInvalid("")
        expectInvalid(prefix)
        expectInvalid(prefix + saltText)
        expectInvalid(prefix + saltText + "$")
        expectInvalid(prefix + saltText + "$" + "vUrOhcKV")
    }),
    Test("different algorithms and version are not accepted", () => {
        expectInvalid(
            "protos-password-v1:nfc:$argon2i$v=19$m=65536,t=3,p=4$" +
            saltText + "$" + tagText)
        expectInvalid(
            "protos-password-v1:nfc:$argon2id$v=16$m=65536,t=3,p=4$" +
            saltText + "$" + tagText)
    }),
    Test("modified work parameters are rejected before KDF", () => {
        expectInvalid(
            "protos-password-v1:nfc:$argon2id$v=19$m=8192,t=3,p=4$" +
            saltText + "$" + tagText)
        expectInvalid(
            "protos-password-v1:nfc:$argon2id$v=19$m=65536,t=2,p=4$" +
            saltText + "$" + tagText)
        expectInvalid(
            "protos-password-v1:nfc:$argon2id$v=19$m=65536,t=3,p=1$" +
            saltText + "$" + tagText)
    }),
    Test("padded and noncanonical base64 are rejected", () => {
        expectInvalid(prefix + saltText + "==" + "$" + tagText)
        expectInvalid(prefix + saltText + "$" + tagText + "=")
        expectInvalid(
            prefix + "AAECAwQFBgcICQoLDA0ODx" + "$" + tagText)
        expectInvalid(
            prefix + saltText + "$" +
            "vUrOhcKV+zjYROFncankOSUoKsmCyGVr5Vou9s8g/Vh")
    }),
    Test("unexpected characters and trailing fields", () => {
        expectInvalid(prefix + saltText + "$" + tagText + "$extra")
        expectInvalid(prefix + saltText + "$" + tagText + " ")
        expectInvalid(prefix + saltText + "$" + tagText + "\n")
    }),
    Test("malformed records fail verification rather than returning false", () => {
        expectInvalidVerification("")
        expectInvalidVerification(prefix)
        expectInvalidVerification(prefix + saltText + "$")
        expectInvalidVerification(prefix + saltText + "$" + tagText + "=")
        expectInvalidVerification(
            "protos-password-v1:nfc:$argon2id$v=19$m=1024,t=3,p=4$" +
            saltText + "$" + tagText)
    }),
    Test("non-String verification records fail with PasswordError", () => {
        expectInvalidVerification(null)
        expectInvalidVerification(Array())
        expectInvalidVerification(123)
    })
]
tests.freeze()
