Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
SemVer: import("std:semver/SemVer")

requireEqual: (text) => {
    a: SemVer.parse(text)
    b: SemVer.parse(text)
    Assertions.require((a == b) === true)
    Assertions.require((b == a) === true)
    Assertions.require((a != b) === false)
    Assertions.require((a === b) == false)
    Assertions.require(Integer.recognizes(a.hash()))
    Assertions.require(a.hash() == b.hash())
    Assertions.require(a.hash() == a.hash())
    true
}

requireUnequal: (left, right) => {
    a: SemVer.parse(left)
    b: SemVer.parse(right)
    Assertions.require((a == b) === false)
    Assertions.require((b == a) === false)
    Assertions.require((a != b) === true)
    true
}

tests: [
    Test("equality of independent parses", () => {
        requireEqual("1.2.3")
        requireEqual("0.0.0")
        requireEqual("1.2.3-alpha")
        requireEqual("1.2.3-alpha+build")
        requireEqual("1.2.3-alpha.7.rc-1+001.linux")
        requireEqual("1.0.0+001")
        requireEqual("999999999999999999999999999.18446744073709551616.0-999999999999999999999")
        version: SemVer.parse("1.2.3")
        Assertions.require((version == version) === true)
    }),
    Test("identity remains object identity", () => {
        Assertions.require((SemVer.parse("1.2.3") === SemVer.parse("1.2.3")) == false)
        Assertions.require((SemVer.parse("1.2.3") !== SemVer.parse("1.2.3")) == true)
    }),
    Test("equality includes build metadata", () => {
        linux: SemVer.parse("1.2.3+linux")
        windows: SemVer.parse("1.2.3+windows")
        Assertions.require(SemVer.comparePrecedence(linux, windows) == 0)
        Assertions.require((linux == windows) === false)
        requireUnequal("1.0.0+abc", "1.0.0+def")
        requireUnequal("1.0.0-alpha+001", "1.0.0-alpha+999")
        requireUnequal("1.0.0", "1.0.0+a")
        requireUnequal("1.0.0+a", "1.0.0+a.b")
        requireUnequal("1.0.0+a.b", "1.0.0+b.a")
        requireUnequal("1.0.0+001", "1.0.0+1")
    }),
    Test("equality distinguishes core and prerelease", () => {
        requireUnequal("1.2.3", "2.2.3")
        requireUnequal("1.2.3", "1.3.3")
        requireUnequal("1.2.3", "1.2.4")
        requireUnequal("18446744073709551616.0.0", "18446744073709551617.0.0")
        requireUnequal("1.0.0", "1.0.0-alpha")
        requireUnequal("1.0.0-alpha", "1.0.0-alpha.1")
        requireUnequal("1.0.0-alpha", "1.0.0-beta")
        requireUnequal("1.0.0-alpha", "1.0.0-Alpha")
        requireUnequal("1.0.0-1", "1.0.0-2")
        requireUnequal("1.0.0-1a", "1.0.0-1")
        requireUnequal("1.0.0-a.1", "1.0.0-1.a")
    }),
    Test("equality with non-versions is false", () => {
        version: SemVer.parse("1.2.3")
        Assertions.require((version == "1.2.3") === false)
        Assertions.require((version == 1) === false)
        Assertions.require((version == null) === false)
        Assertions.require((version == { major: 1 }) === false)
    }),
    Test("hash supports Map keys", () => {
        m: Map()
        m[SemVer.parse("1.2.3-alpha+linux")] = "linux"
        m[SemVer.parse("1.2.3-alpha+windows")] = "windows"
        Assertions.require(m.size() == 2)
        Assertions.require(m[SemVer.parse("1.2.3-alpha+linux")] == "linux")
        Assertions.require(m.containsKey(SemVer.parse("1.2.3-alpha+windows")))
        Assertions.require(m.containsKey(SemVer.parse("1.2.3-alpha")) == false)
        m[SemVer.parse("1.2.3-alpha+linux")] = "replaced"
        Assertions.require(m.size() == 2)
        Assertions.require(m[SemVer.parse("1.2.3-alpha+linux")] == "replaced")
    }),
    Test("equality and hash do not mutate", () => {
        a: SemVer.parse("1.2.3-alpha.7+001")
        b: SemVer.parse("1.2.3-alpha.7+001")
        prerelease: a.prerelease
        Assertions.require(a == b)
        Assertions.require(a.hash() == b.hash())
        Assertions.require(a.prerelease === prerelease)
        Assertions.require(a.prerelease.size() == 2)
        Assertions.require(a.prerelease[1] == 7)
        Assertions.require(SemVer.format(a) == "1.2.3-alpha.7+001")
    })
]
