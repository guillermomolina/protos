CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

tail: CommandLine.positional({
    key: "tail"
    minOccurrences: 0
    maxOccurrences: null
    valueName: "ARG"
    help: null
})

run: CommandLine.command({
    name: "run"
    help: null
    options: Array()
    positionals: Array()
    subcommands: Array()
})

root: CommandLine.command({
    name: "tool"
    help: null
    options: Array()
    positionals: Array(tail)
    subcommands: Array(run)
})

escaped: CommandLine.parse(root, Array("--", "run", "other"))

require(escaped.command.endOfOptionsIndex == 0)
require(escaped.command.subcommand === null)
require(escaped.command.positionals.size() == 2)
require(escaped.command.positionals[0].key == "tail")
require(escaped.command.positionals[0].value == "run")
require(escaped.command.positionals[0].tokenIndex == 1)
require(escaped.command.positionals[1].value == "other")
require(escaped.command.positionals[1].tokenIndex == 2)

true
