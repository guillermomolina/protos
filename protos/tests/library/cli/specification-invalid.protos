CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

require(reject(() => {
    CommandLine.option({
        key: ""
        long: "jobs"
        short: "j"
        minValues: 1
        maxValues: 1
        minOccurrences: 0
        maxOccurrences: 1
        valueName: null
        help: null
    })
}))

