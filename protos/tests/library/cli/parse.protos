Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parse delimiter", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            output: CommandLine.option({
                key: "output"
                long: "output"
                short: "o"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "VALUE"
                help: null
            })

            tail: CommandLine.positional({
                key: "tail"
                minOccurrences: 0
                maxOccurrences: null
                valueName: "ARG"
                help: null
            })

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(output)
                positionals: Array(tail)
                subcommands: Array()
            })

            delimited: CommandLine.parse(
                spec,
                Array("--output=value", "--", "--unknown", "-x", "plain")
            )

            require(delimited.command.options.size() == 1)
            require(delimited.command.options[0].value == "value")
            require(delimited.command.options[0].tokenIndex == 0)
            require(delimited.command.options[0].valueTokenIndex == 0)
            require(delimited.command.endOfOptionsIndex == 1)
            require(delimited.command.positionals.size() == 3)
            require(delimited.command.positionals[0].value == "--unknown")
            require(delimited.command.positionals[0].tokenIndex == 2)
            require(delimited.command.positionals[1].value == "-x")
            require(delimited.command.positionals[1].tokenIndex == 3)
            require(delimited.command.positionals[2].value == "plain")
            require(delimited.command.positionals[2].tokenIndex == 4)

            literalDelimiterValue: CommandLine.parse(
                spec,
                Array("--output", "--", "tail")
            )

            require(literalDelimiterValue.command.options.size() == 1)
            require(literalDelimiterValue.command.options[0].value == "--")
            require(literalDelimiterValue.command.options[0].tokenIndex == 0)
            require(literalDelimiterValue.command.options[0].valueTokenIndex == 1)
            require(literalDelimiterValue.command.endOfOptionsIndex === null)
            require(literalDelimiterValue.command.positionals.size() == 1)
            require(literalDelimiterValue.command.positionals[0].value == "tail")
            require(literalDelimiterValue.command.positionals[0].tokenIndex == 2)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse failures", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            flag: CommandLine.option({
                key: "verbose"
                long: "verbose"
                short: "v"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            })

            value: CommandLine.option({
                key: "output"
                long: "output"
                short: "o"
                minValues: 1
                maxValues: 1
                minOccurrences: 1
                maxOccurrences: 1
                valueName: "VALUE"
                help: null
            })

            target: CommandLine.positional({
                key: "target"
                minOccurrences: 1
                maxOccurrences: 1
                valueName: "TARGET"
                help: null
            })

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(flag, value)
                positionals: Array(target)
                subcommands: Array()
            })

            require(reject(() => {
                CommandLine.parse(spec, Array("--unknown", "--output", "x", "target"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("-x", "--output", "x", "target"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("-vo", "x", "target"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("--output"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("target"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("--output", "a", "--output", "b", "target"))
            }))

            require(reject(() => {
                CommandLine.parse(spec, Array("--verbose=value", "--output", "x", "target"))
            }))

            require(reject(() => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array(target)
                        subcommands: Array()
                    }),
                    Array()
                )
            }))

            require(reject(() => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array("unexpected")
                )
            }))

            require(reject(() => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array("-")
                )
            }))

            require(reject(() => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    {}
                )
            }))

            require(reject(() => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array(1)
                )
            }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse options", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            flag: (key, longName, shortName, maxOccurrences) => {
                CommandLine.option({
                    key: key
                    long: longName
                    short: shortName
                    minValues: 0
                    maxValues: 0
                    minOccurrences: 0
                    maxOccurrences: maxOccurrences
                    valueName: null
                    help: null
                })
            }

            valued: (key, longName, shortName, minOccurrences, maxOccurrences) => {
                CommandLine.option({
                    key: key
                    long: longName
                    short: shortName
                    minValues: 1
                    maxValues: 1
                    minOccurrences: minOccurrences
                    maxOccurrences: maxOccurrences
                    valueName: "VALUE"
                    help: null
                })
            }

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(
                    flag("verbose", "verbose", "v", 1),
                    valued("output", "output", "o", 1, 1),
                    valued("define", "define", "D", 0, null),
                    flag("all", null, "a", 1),
                    flag("brief", null, "b", 1),
                    flag("check", null, "c", 1)
                )
                positionals: Array()
                subcommands: Array()
            })

            input: Array(
                "--verbose",
                "--output=result.txt",
                "-abc",
                "--define",
                "--literal",
                "-D",
                "x=y"
            )

            parsed: CommandLine.parse(spec, input)

            input[0] = "changed-after-parse"

            require(parsed.kind == "parseResult")
            require(parsed.arguments.size() == 7)
            require(parsed.arguments[0] == "--verbose")
            require(parsed.command.kind == "commandResult")
            require(parsed.command.name == "tool")
            require(parsed.command.tokenIndex === null)
            require(parsed.command.endOfOptionsIndex === null)
            require(parsed.command.subcommand === null)
            require(parsed.command.positionals.size() == 0)

            options: parsed.command.options
            require(options.size() == 7)

            require(options[0].kind == "optionOccurrence")
            require(options[0].key == "verbose")
            require(options[0].spelling == "--verbose")
            require(options[0].tokenIndex == 0)
            require(options[0].value === null)
            require(options[0].valueTokenIndex === null)

            require(options[1].key == "output")
            require(options[1].spelling == "--output")
            require(options[1].tokenIndex == 1)
            require(options[1].value == "result.txt")
            require(options[1].valueTokenIndex == 1)

            require(options[2].key == "all")
            require(options[2].spelling == "-a")
            require(options[2].tokenIndex == 2)
            require(options[3].key == "brief")
            require(options[3].spelling == "-b")
            require(options[3].tokenIndex == 2)
            require(options[4].key == "check")
            require(options[4].spelling == "-c")
            require(options[4].tokenIndex == 2)

            require(options[5].key == "define")
            require(options[5].spelling == "--define")
            require(options[5].tokenIndex == 3)
            require(options[5].value == "--literal")
            require(options[5].valueTokenIndex == 4)

            require(options[6].key == "define")
            require(options[6].spelling == "-D")
            require(options[6].tokenIndex == 5)
            require(options[6].value == "x=y")
            require(options[6].valueTokenIndex == 6)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse positionals d111", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            positional: (key, minimum, maximum) => {
                CommandLine.positional({
                    key: key
                    minOccurrences: minimum
                    maxOccurrences: maximum
                    valueName: key
                    help: null
                })
            }

            specFor: (leftMinimum, leftMaximum, rightMinimum, rightMaximum) => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        positional("A", leftMinimum, leftMaximum),
                        positional("B", rightMinimum, rightMaximum)
                    )
                    subcommands: Array()
                })
            }

            requiredTail: specFor(0, 1, 1, 1)

            one: CommandLine.parse(requiredTail, Array("x"))
            require(one.command.positionals.size() == 1)
            require(one.command.positionals[0].key == "B")
            require(one.command.positionals[0].value == "x")
            require(one.command.positionals[0].tokenIndex == 0)

            two: CommandLine.parse(requiredTail, Array("x", "y"))
            require(two.command.positionals.size() == 2)
            require(two.command.positionals[0].key == "A")
            require(two.command.positionals[0].value == "x")
            require(two.command.positionals[0].tokenIndex == 0)
            require(two.command.positionals[1].key == "B")
            require(two.command.positionals[1].value == "y")
            require(two.command.positionals[1].tokenIndex == 1)

            optionalTail: specFor(0, 1, 0, 1)
            optionalOne: CommandLine.parse(optionalTail, Array("x"))
            require(optionalOne.command.positionals.size() == 1)
            require(optionalOne.command.positionals[0].key == "A")
            require(optionalOne.command.positionals[0].value == "x")

            requiredRest: specFor(0, 1, 1, null)
            requiredRestOne: CommandLine.parse(requiredRest, Array("x"))
            require(requiredRestOne.command.positionals.size() == 1)
            require(requiredRestOne.command.positionals[0].key == "B")
            require(requiredRestOne.command.positionals[0].value == "x")

            requiredRestTwo: CommandLine.parse(requiredRest, Array("x", "y"))
            require(requiredRestTwo.command.positionals.size() == 2)
            require(requiredRestTwo.command.positionals[0].key == "A")
            require(requiredRestTwo.command.positionals[0].value == "x")
            require(requiredRestTwo.command.positionals[1].key == "B")
            require(requiredRestTwo.command.positionals[1].value == "y")

            optionalRest: specFor(0, 1, 0, null)
            optionalRestOne: CommandLine.parse(optionalRest, Array("x"))
            require(optionalRestOne.command.positionals.size() == 1)
            require(optionalRestOne.command.positionals[0].key == "A")
            require(optionalRestOne.command.positionals[0].value == "x")

            optionalRestTwo: CommandLine.parse(optionalRest, Array("x", "y"))
            require(optionalRestTwo.command.positionals.size() == 2)
            require(optionalRestTwo.command.positionals[0].key == "A")
            require(optionalRestTwo.command.positionals[0].value == "x")
            require(optionalRestTwo.command.positionals[1].key == "B")
            require(optionalRestTwo.command.positionals[1].value == "y")

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
