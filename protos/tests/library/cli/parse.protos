Assertions: import("std:test/assertions")
Test: import("std:test/test")

CommandLine: import("std:cli/command_line")

occurrenceSpec: (maximum, positionalMinimum, positionalMaximum) => {
    CommandLine.command({
        name: "tool"
        help: null
        options: Array(
            CommandLine.option(
                key: "verbose", long: "verbose", short: "v",
                minValues: 0, maxValues: 0,
                minOccurrences: 0, maxOccurrences: maximum,
                valueName: null, help: null
            ),
            CommandLine.option(
                key: "define", long: "define", short: "D",
                minValues: 1, maxValues: 1,
                minOccurrences: 0, maxOccurrences: null,
                valueName: "VALUE", help: null
            )
        )
        positionals: Array(CommandLine.positional(
            key: "tail", minOccurrences: positionalMinimum,
            maxOccurrences: positionalMaximum, valueName: "ARG", help: null
        ))
        subcommands: Array()
    })
}

tests: [
    Test("parse delimiter", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/command_line")

            output: CommandLine.option(
                key: "output",
                long: "output",
                short: "o",
                minValues: 1,
                maxValues: 1,
                minOccurrences: 0,
                maxOccurrences: 1,
                valueName: "VALUE",
                help: null
            )

            tail: CommandLine.positional(
                key: "tail",
                minOccurrences: 0,
                maxOccurrences: null,
                valueName: "ARG",
                help: null
            )

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(output)
                positionals: Array(tail)
                subcommands: Array()
            })

            delimited: CommandLine.parse(
                spec,
                Array("--output=value", "--", "--unknown", "-x", "plain")
            )

            Assertions.require(delimited.command.options.size() == 1)
            Assertions.require(delimited.command.options[0].value == "value")
            Assertions.require(delimited.command.options[0].tokenIndex == 0)
            Assertions.require(delimited.command.options[0].valueTokenIndex == 0)
            Assertions.require(delimited.command.endOfOptionsIndex == 1)
            Assertions.require(delimited.command.positionals.size() == 3)
            Assertions.require(delimited.command.positionals[0].value == "--unknown")
            Assertions.require(delimited.command.positionals[0].tokenIndex == 2)
            Assertions.require(delimited.command.positionals[1].value == "-x")
            Assertions.require(delimited.command.positionals[1].tokenIndex == 3)
            Assertions.require(delimited.command.positionals[2].value == "plain")
            Assertions.require(delimited.command.positionals[2].tokenIndex == 4)

            literalDelimiterValue: CommandLine.parse(
                spec,
                Array("--output", "--", "tail")
            )

            Assertions.require(literalDelimiterValue.command.options.size() == 1)
            Assertions.require(literalDelimiterValue.command.options[0].value == "--")
            Assertions.require(literalDelimiterValue.command.options[0].tokenIndex == 0)
            Assertions.require(literalDelimiterValue.command.options[0].valueTokenIndex == 1)
            Assertions.require(literalDelimiterValue.command.endOfOptionsIndex === null)
            Assertions.require(literalDelimiterValue.command.positionals.size() == 1)
            Assertions.require(literalDelimiterValue.command.positionals[0].value == "tail")
            Assertions.require(literalDelimiterValue.command.positionals[0].tokenIndex == 2)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse failures", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/command_line")

            flag: CommandLine.option(
                key: "verbose",
                long: "verbose",
                short: "v",
                minValues: 0,
                maxValues: 0,
                minOccurrences: 0,
                maxOccurrences: 1,
                valueName: null,
                help: null
            )

            value: CommandLine.option(
                key: "output",
                long: "output",
                short: "o",
                minValues: 1,
                maxValues: 1,
                minOccurrences: 1,
                maxOccurrences: 1,
                valueName: "VALUE",
                help: null
            )

            target: CommandLine.positional(
                key: "target",
                minOccurrences: 1,
                maxOccurrences: 1,
                valueName: "TARGET",
                help: null
            )

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(flag, value)
                positionals: Array(target)
                subcommands: Array()
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("--unknown", "--output", "x", "target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("-x", "--output", "x", "target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("-vo", "x", "target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("--output"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("--output", "a", "--output", "b", "target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(spec, Array("--verbose=value", "--output", "x", "target"))
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array(target)
                        subcommands: Array()
                    }),
                    Array()
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array("unexpected")
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array("-")
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    {}
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.parse(
                    CommandLine.command({
                        name: "tool"
                        help: null
                        options: Array()
                        positionals: Array()
                        subcommands: Array()
                    }),
                    Array(1)
                )
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse options", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/command_line")

            flag: (key, longName, shortName, maxOccurrences) => {
                CommandLine.option(
                    key: key,
                    long: longName,
                    short: shortName,
                    minValues: 0,
                    maxValues: 0,
                    minOccurrences: 0,
                    maxOccurrences: maxOccurrences,
                    valueName: null,
                    help: null
                )
            }

            valued: (key, longName, shortName, minOccurrences, maxOccurrences) => {
                CommandLine.option(
                    key: key,
                    long: longName,
                    short: shortName,
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: minOccurrences,
                    maxOccurrences: maxOccurrences,
                    valueName: "VALUE",
                    help: null
                )
            }

            spec: CommandLine.command({
                name: "tool"
                help: null
                options: Array(
                    flag("verbose", "verbose", "v", 1),
                    valued("output", "output", "o", 1, 1),
                    valued("define", "define", "D", 0, null),
                    flag("all", null, "a", 1),
                    flag("brief", null, "b", 1),
                    flag("check", null, "c", 1)
                )
                positionals: Array()
                subcommands: Array()
            })

            input: Array(
                "--verbose",
                "--output=result.txt",
                "-abc",
                "--define",
                "--literal",
                "-D",
                "x=y"
            )

            parsed: CommandLine.parse(spec, input)

            input[0] = "changed-after-parse"

            Assertions.require(parsed.kind == "parseResult")
            Assertions.require(parsed.arguments.size() == 7)
            Assertions.require(parsed.arguments[0] == "--verbose")
            Assertions.require(parsed.command.kind == "commandResult")
            Assertions.require(parsed.command.name == "tool")
            Assertions.require(parsed.command.tokenIndex === null)
            Assertions.require(parsed.command.endOfOptionsIndex === null)
            Assertions.require(parsed.command.subcommand === null)
            Assertions.require(parsed.command.positionals.size() == 0)

            options: parsed.command.options
            Assertions.require(options.size() == 7)

            Assertions.require(options[0].kind == "optionOccurrence")
            Assertions.require(options[0].key == "verbose")
            Assertions.require(options[0].spelling == "--verbose")
            Assertions.require(options[0].tokenIndex == 0)
            Assertions.require(options[0].value === null)
            Assertions.require(options[0].valueTokenIndex === null)

            Assertions.require(options[1].key == "output")
            Assertions.require(options[1].spelling == "--output")
            Assertions.require(options[1].tokenIndex == 1)
            Assertions.require(options[1].value == "result.txt")
            Assertions.require(options[1].valueTokenIndex == 1)

            Assertions.require(options[2].key == "all")
            Assertions.require(options[2].spelling == "-a")
            Assertions.require(options[2].tokenIndex == 2)
            Assertions.require(options[3].key == "brief")
            Assertions.require(options[3].spelling == "-b")
            Assertions.require(options[3].tokenIndex == 2)
            Assertions.require(options[4].key == "check")
            Assertions.require(options[4].spelling == "-c")
            Assertions.require(options[4].tokenIndex == 2)

            Assertions.require(options[5].key == "define")
            Assertions.require(options[5].spelling == "--define")
            Assertions.require(options[5].tokenIndex == 3)
            Assertions.require(options[5].value == "--literal")
            Assertions.require(options[5].valueTokenIndex == 4)

            Assertions.require(options[6].key == "define")
            Assertions.require(options[6].spelling == "-D")
            Assertions.require(options[6].tokenIndex == 5)
            Assertions.require(options[6].value == "x=y")
            Assertions.require(options[6].valueTokenIndex == 6)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse positionals d111", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/command_line")

            positional: (key, minimum, maximum) => {
                CommandLine.positional(
                    key: key,
                    minOccurrences: minimum,
                    maxOccurrences: maximum,
                    valueName: key,
                    help: null
                )
            }

            specFor: (leftMinimum, leftMaximum, rightMinimum, rightMaximum) => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        positional("A", leftMinimum, leftMaximum),
                        positional("B", rightMinimum, rightMaximum)
                    )
                    subcommands: Array()
                })
            }

            requiredTail: specFor(0, 1, 1, 1)

            one: CommandLine.parse(requiredTail, Array("x"))
            Assertions.require(one.command.positionals.size() == 1)
            Assertions.require(one.command.positionals[0].key == "B")
            Assertions.require(one.command.positionals[0].value == "x")
            Assertions.require(one.command.positionals[0].tokenIndex == 0)

            two: CommandLine.parse(requiredTail, Array("x", "y"))
            Assertions.require(two.command.positionals.size() == 2)
            Assertions.require(two.command.positionals[0].key == "A")
            Assertions.require(two.command.positionals[0].value == "x")
            Assertions.require(two.command.positionals[0].tokenIndex == 0)
            Assertions.require(two.command.positionals[1].key == "B")
            Assertions.require(two.command.positionals[1].value == "y")
            Assertions.require(two.command.positionals[1].tokenIndex == 1)

            optionalTail: specFor(0, 1, 0, 1)
            optionalOne: CommandLine.parse(optionalTail, Array("x"))
            Assertions.require(optionalOne.command.positionals.size() == 1)
            Assertions.require(optionalOne.command.positionals[0].key == "A")
            Assertions.require(optionalOne.command.positionals[0].value == "x")

            requiredRest: specFor(0, 1, 1, null)
            requiredRestOne: CommandLine.parse(requiredRest, Array("x"))
            Assertions.require(requiredRestOne.command.positionals.size() == 1)
            Assertions.require(requiredRestOne.command.positionals[0].key == "B")
            Assertions.require(requiredRestOne.command.positionals[0].value == "x")

            requiredRestTwo: CommandLine.parse(requiredRest, Array("x", "y"))
            Assertions.require(requiredRestTwo.command.positionals.size() == 2)
            Assertions.require(requiredRestTwo.command.positionals[0].key == "A")
            Assertions.require(requiredRestTwo.command.positionals[0].value == "x")
            Assertions.require(requiredRestTwo.command.positionals[1].key == "B")
            Assertions.require(requiredRestTwo.command.positionals[1].value == "y")

            optionalRest: specFor(0, 1, 0, null)
            optionalRestOne: CommandLine.parse(optionalRest, Array("x"))
            Assertions.require(optionalRestOne.command.positionals.size() == 1)
            Assertions.require(optionalRestOne.command.positionals[0].key == "A")
            Assertions.require(optionalRestOne.command.positionals[0].value == "x")

            optionalRestTwo: CommandLine.parse(optionalRest, Array("x", "y"))
            Assertions.require(optionalRestTwo.command.positionals.size() == 2)
            Assertions.require(optionalRestTwo.command.positionals[0].key == "A")
            Assertions.require(optionalRestTwo.command.positionals[0].value == "x")
            Assertions.require(optionalRestTwo.command.positionals[1].key == "B")
            Assertions.require(optionalRestTwo.command.positionals[1].value == "y")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("occurrence arrays have exact lengths across growth boundaries", () => {
        spec: occurrenceSpec(null, 0, null)
        for(length in Array(0, 1, 2, 3, 7, 8, 9, 31, 32, 33, 127, 128, 129)) {
            input: Array()
            value: "value"
            argument: "arg"
            index: 0
            while(index < length) {
                input = Array(...input, "--define", value, argument)
                value = value + "x"
                argument = argument + "x"
                index = index + 1
            }

            parsed: CommandLine.parse(spec, input)
            options: parsed.command.options
            positionals: parsed.command.positionals
            Assertions.require(parsed.arguments.size() == length * 3)
            Assertions.require(options.size() == length)
            Assertions.require(positionals.size() == length)
            index = 0
            value = "value"
            argument = "arg"
            while(index < length) {
                Assertions.require(options[index].key == "define")
                Assertions.require(options[index].spelling == "--define")
                Assertions.require(options[index].value == value)
                Assertions.require(options[index].tokenIndex == index * 3)
                Assertions.require(options[index].valueTokenIndex == index * 3 + 1)
                Assertions.require(positionals[index].key == "tail")
                Assertions.require(positionals[index].value == argument)
                Assertions.require(positionals[index].tokenIndex == index * 3 + 2)
                value = value + "x"
                argument = argument + "x"
                index = index + 1
            }
            Assertions.signals(Error, () => { options.marker: true })
            Assertions.signals(Error, () => { positionals.marker: true })
            if(length > 0) {
                Assertions.signals(Error, () => { options[0] = null })
                Assertions.signals(Error, () => { positionals[0] = null })
            }
        }
        null
    }),
    Test("repeatable short clusters retain every flag occurrence", () => {
        spec: occurrenceSpec(null, 0, null)
        for(length in Array(1, 2, 3, 7, 8, 9, 31, 32, 33, 127, 128, 129)) {
            cluster: "-"
            index: 0
            while(index < length) {
                cluster = cluster + "v"
                index = index + 1
            }
            parsed: CommandLine.parse(spec, Array(cluster, "-vv"))
            options: parsed.command.options
            Assertions.require(options.size() == length + 2)
            Assertions.require(parsed.command.positionals.size() == 0)
            index = 0
            while(index < options.size()) {
                expectedToken: 0
                if(index >= length) { expectedToken = 1 }
                Assertions.require(options[index].key == "verbose")
                Assertions.require(options[index].spelling == "-v")
                Assertions.require(options[index].tokenIndex == expectedToken)
                Assertions.require(options[index].value === null)
                Assertions.require(options[index].valueTokenIndex === null)
                index = index + 1
            }
        }
        null
    }),
    Test("mixed occurrences retain provenance and independent snapshots", () => {
        spec: occurrenceSpec(null, 0, null)
        input: Array("first", "--define=one", "-D", "two", "second",
            "--define=three", "--", "--define=four", "-v")
        first: CommandLine.parse(spec, input)
        second: CommandLine.parse(spec, input)
        third: CommandLine.parse(spec, input)
        Assertions.require((first === second) == false)
        Assertions.require((first.command === second.command) == false)
        Assertions.require((first.arguments === second.arguments) == false)
        Assertions.require((first.command.options === second.command.options) == false)
        Assertions.require((first.command.positionals === second.command.positionals) == false)
        Assertions.require((second === third) == false)
        Assertions.require((second.command === third.command) == false)
        Assertions.require((second.arguments === third.arguments) == false)
        Assertions.require((second.command.options === third.command.options) == false)
        Assertions.require((second.command.positionals === third.command.positionals) == false)
        for(parsed in Array(first, second, third)) {
            options: parsed.command.options
            positionals: parsed.command.positionals
            Assertions.require(options.size() == 3)
            Assertions.require(positionals.size() == 4)
            Assertions.require(parsed.command.endOfOptionsIndex == 6)
            expectedValues: Array("one", "two", "three")
            expectedSpellings: Array("--define", "-D", "--define")
            expectedTokens: Array(1, 2, 5)
            expectedValueTokens: Array(1, 3, 5)
            index: 0
            while(index < 3) {
                Assertions.require(options[index].key == "define")
                Assertions.require(options[index].value == expectedValues[index])
                Assertions.require(options[index].spelling == expectedSpellings[index])
                Assertions.require(options[index].tokenIndex == expectedTokens[index])
                Assertions.require(options[index].valueTokenIndex == expectedValueTokens[index])
                Assertions.require((first.command.options[index] === second.command.options[index]) == false)
                index = index + 1
            }
            expectedPositionals: Array("first", "second", "--define=four", "-v")
            expectedPositionalTokens: Array(0, 4, 7, 8)
            index = 0
            while(index < 4) {
                Assertions.require(positionals[index].value == expectedPositionals[index])
                Assertions.require(positionals[index].tokenIndex == expectedPositionalTokens[index])
                Assertions.require((first.command.positionals[index] === second.command.positionals[index]) == false)
                index = index + 1
            }
        }
        input[0] = "changed"
        input[1] = "--define=changed"
        for(parsed in Array(first, second, third)) {
            Assertions.require(parsed.arguments[0] == "first")
            Assertions.require(parsed.arguments[1] == "--define=one")
            Assertions.require(parsed.command.options[0].value == "one")
            Assertions.require(parsed.command.positionals[0].value == "first")
        }
        null
    }),
    Test("failed accumulation does not affect subsequent parses", () => {
        spec: occurrenceSpec(1, 1, 1)
        prefix: Array("--define=a", "--define=b", "--define=c", "-v", "target")
        for(invalid in Array(
            Array(...prefix, "--unknown"),
            Array(...prefix, "-v"),
            Array(...prefix, "excess")
        )) {
            Assertions.signals(Error, () => { CommandLine.parse(spec, invalid) })
            parsed: CommandLine.parse(spec, prefix)
            Assertions.require(parsed.arguments.size() == 5)
            Assertions.require(parsed.command.options.size() == 4)
            Assertions.require(parsed.command.positionals.size() == 1)
            index: 0
            for(value in Array("a", "b", "c")) {
                occurrence: parsed.command.options[index]
                Assertions.require(occurrence.key == "define")
                Assertions.require(occurrence.spelling == "--define")
                Assertions.require(occurrence.tokenIndex == index)
                Assertions.require(occurrence.value == value)
                Assertions.require(occurrence.valueTokenIndex == index)
                index = index + 1
            }
            flag: parsed.command.options[3]
            Assertions.require(flag.key == "verbose")
            Assertions.require(flag.spelling == "-v")
            Assertions.require(flag.tokenIndex == 3)
            Assertions.require(flag.value === null)
            Assertions.require(flag.valueTokenIndex === null)
            Assertions.require(parsed.command.positionals[0].key == "tail")
            Assertions.require(parsed.command.positionals[0].value == "target")
            Assertions.require(parsed.command.positionals[0].tokenIndex == 4)
        }
        null
    })
]
tests.freeze()
