Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("specification invalid", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "",
                    long: "jobs",
                    short: "j",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "1jobs",
                    short: "j",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "jobs",
                    short: "jj",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: null,
                    short: null,
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "jobs",
                    short: "j",
                    minValues: 0,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "jobs",
                    short: "j",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 2,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "same"
                            long: "first"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "same"
                            long: "second"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "a"
                            long: "same"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "b"
                            long: "same"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        {
                            key: "rest"
                            minOccurrences: 0
                            maxOccurrences: null
                            valueName: "ARG"
                            help: null
                        },
                        {
                            key: "tail"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        }
                    )
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array(
                        {
                            name: "run"
                            help: null
                            options: Array()
                            positionals: Array()
                            subcommands: Array()
                        },
                        {
                            name: "run"
                            help: null
                            options: Array()
                            positionals: Array()
                            subcommands: Array()
                        }
                    )
                })
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("specification snapshot", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            rootOption: {
                key: "jobs"
                long: "jobs"
                short: "j"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "COUNT"
                help: "Workers"
            }

            rootPositional: {
                key: "target"
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "TARGET"
                help: null
            }

            childOption: {
                key: "force"
                long: "force"
                short: "f"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            childOptions: Array(childOption)
            child: {
                name: "run"
                help: "Run"
                options: childOptions
                positionals: Array()
                subcommands: Array()
            }

            rootOptions: Array(rootOption)
            rootPositionals: Array(rootPositional)
            children: Array(child)
            descriptor: {
                name: "tool"
                help: "Tool"
                options: rootOptions
                positionals: rootPositionals
                subcommands: children
            }

            spec: CommandLine.command(descriptor)

            rootOption.key = "changed-root-key"
            rootOption.long = "changed-root-long"
            rootPositional.key = "changed-positional"
            childOption.key = "changed-child-key"
            child.name = "changed-child-name"
            descriptor.name = "changed-root-name"

            rootOptions[0] = {
                key: "replacement"
                long: "replacement"
                short: "r"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            rootPositionals[0] = {
                key: "replacement-positional"
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            childOptions[0] = {
                key: "replacement-child"
                long: "replacement-child"
                short: null
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            children[0] = {
                name: "replacement-child"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array()
            }

            Assertions.require(spec.name == "tool")
            Assertions.require(spec.options.size() == 1)
            Assertions.require(spec.options[0].key == "jobs")
            Assertions.require(spec.options[0].long == "jobs")
            Assertions.require(spec.positionals.size() == 1)
            Assertions.require(spec.positionals[0].key == "target")
            Assertions.require(spec.subcommands.size() == 1)
            Assertions.require(spec.subcommands[0].name == "run")
            Assertions.require(spec.subcommands[0].options.size() == 1)
            Assertions.require(spec.subcommands[0].options[0].key == "force")

            Assertions.signals(Error, () => {
                spec.name = "changed"
            })

            Assertions.signals(Error, () => {
                spec.options[0] = spec.options[0]
            })

            Assertions.signals(Error, () => {
                spec.options[0].key = "changed"
            })

            Assertions.signals(Error, () => {
                spec.subcommands[0].name = "changed"
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("specification valid", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            optionDescriptor: {
                key: "jobs"
                long: "jobs"
                short: "j"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "COUNT"
                help: "Number of workers"
            }

            positionalDescriptor: {
                key: "files"
                minOccurrences: 1
                maxOccurrences: null
                valueName: "FILE"
                help: "Input files"
            }

            childDescriptor: {
                name: "run"
                help: "Run a target"
                options: Array({
                    key: "force"
                    long: "force"
                    short: "f"
                    minValues: 0
                    maxValues: 0
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: null
                    help: null
                })
                positionals: Array()
                subcommands: Array()
            }

            makeOption: () => {
                CommandLine.option(
                    key: optionDescriptor.key,
                    long: optionDescriptor.long,
                    short: optionDescriptor.short,
                    minValues: optionDescriptor.minValues,
                    maxValues: optionDescriptor.maxValues,
                    minOccurrences: optionDescriptor.minOccurrences,
                    maxOccurrences: optionDescriptor.maxOccurrences,
                    valueName: optionDescriptor.valueName,
                    help: optionDescriptor.help
                )
            }

            first: makeOption()
            second: makeOption()
            positional: CommandLine.positional(
                key: positionalDescriptor.key,
                minOccurrences: positionalDescriptor.minOccurrences,
                maxOccurrences: positionalDescriptor.maxOccurrences,
                valueName: positionalDescriptor.valueName,
                help: positionalDescriptor.help
            )
            command: CommandLine.command({
                name: "tool"
                help: "Tool root"
                options: Array(optionDescriptor)
                positionals: Array(positionalDescriptor)
                subcommands: Array(childDescriptor)
            })

            Assertions.require(first !== second)
            Assertions.require(first !== optionDescriptor)
            Assertions.require(first.kind == "option")
            Assertions.require(first.key == "jobs")
            Assertions.require(first.long == "jobs")
            Assertions.require(first.short == "j")
            Assertions.require(first.minValues == 1)
            Assertions.require(first.maxValues == 1)
            Assertions.require(first.minOccurrences == 0)
            Assertions.require(first.maxOccurrences == 1)
            Assertions.require(first.valueName == "COUNT")
            Assertions.require(first.help == "Number of workers")

            Assertions.require(positional !== positionalDescriptor)
            Assertions.require(positional.kind == "positional")
            Assertions.require(positional.key == "files")
            Assertions.require(positional.minOccurrences == 1)
            Assertions.require(positional.maxOccurrences === null)
            Assertions.require(positional.valueName == "FILE")
            Assertions.require(positional.help == "Input files")

            Assertions.require(command.kind == "command")
            Assertions.require(command.name == "tool")
            Assertions.require(command.options.size() == 1)
            Assertions.require(command.options[0] !== optionDescriptor)
            Assertions.require(command.options[0].key == "jobs")
            Assertions.require(command.positionals.size() == 1)
            Assertions.require(command.positionals[0] !== positionalDescriptor)
            Assertions.require(command.positionals[0].key == "files")
            Assertions.require(command.subcommands.size() == 1)
            Assertions.require(command.subcommands[0] !== childDescriptor)
            Assertions.require(command.subcommands[0].name == "run")
            Assertions.require(command.subcommands[0].options.size() == 1)
            Assertions.require(command.subcommands[0].options[0].key == "force")

            Assertions.require(CommandLine.hasSlot("option"))
            Assertions.require(CommandLine.hasSlot("positional"))
            Assertions.require(CommandLine.hasSlot("command"))
            Assertions.require(CommandLine.hasSlot("parse"))
            Assertions.require(CommandLine.hasSlot("renderHelp"))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("specification named parameters", () => {
        CommandLine: import("std:cli/CommandLine")

        // Every one of the nine option parameters is required, even the ones
        // that accept null: omitting any single one signals an Error.
        Assertions.signals(Error, () => {
            CommandLine.option(long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N")
        })

        // Every one of the five positional parameters is required.
        Assertions.signals(Error, () => {
            CommandLine.positional(minOccurrences: 0, maxOccurrences: 1, valueName: "T", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", maxOccurrences: 1, valueName: "T", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, valueName: "T", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: 1, help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: 1, valueName: "T")
        })

        // An explicit null is a supplied value, distinct from omission.
        flag: CommandLine.option(key: "verbose", long: "verbose", short: null, minValues: 0, maxValues: 0, minOccurrences: 0, maxOccurrences: null, valueName: null, help: null)
        Assertions.require(flag.short === null)
        Assertions.require(flag.maxOccurrences === null)
        Assertions.require(flag.valueName === null)
        Assertions.require(flag.help === null)
        Assertions.signals(Error, () => {
            CommandLine.option(key: "verbose", long: "verbose", minValues: 0, maxValues: 0, minOccurrences: 0, maxOccurrences: null, valueName: null, help: null)
        })
        rest: CommandLine.positional(key: "rest", minOccurrences: 0, maxOccurrences: null, valueName: "ARG", help: null)
        Assertions.require(rest.maxOccurrences === null)
        Assertions.require(rest.help === null)
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "rest", minOccurrences: 0, valueName: "ARG", help: null)
        })

        // Supplied values are validated by the existing normalizers.
        Assertions.signals(Error, () => {
            CommandLine.option(key: 1, long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: "1", maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 2, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 2, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: null, help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.option(key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: 7)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 2, maxOccurrences: 1, valueName: "T", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: "1", valueName: "T", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: 1, valueName: null, help: null)
        })

        // D237: an unknown label, or a label naming a parameter already
        // supplied positionally, signals an Error before the body executes.
        // The argument expressions are still evaluated first.
        evaluated: 0
        count: (value) => {
            evaluated = evaluated + 1
            value
        }
        Assertions.signals(Error, () => {
            CommandLine.option(key: count("jobs"), long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null, extra: count(1))
        })
        Assertions.require(evaluated == 2)
        Assertions.signals(Error, () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: 1, valueName: "T", help: null, kind: "positional")
        })
        Assertions.signals(Error, () => {
            CommandLine.option("jobs", key: "jobs", long: "jobs", short: "j", minValues: 1, maxValues: 1, minOccurrences: 0, maxOccurrences: 1, valueName: "N", help: null)
        })
        Assertions.signals(Error, () => {
            CommandLine.positional("target", key: "target", minOccurrences: 0, maxOccurrences: 1, valueName: "T", help: null)
        })

        // Input expressions are evaluated exactly once in textual order,
        // independently of the declared parameter order.
        order: ""
        trace: (name, value) => {
            order = order + name + ";"
            value
        }
        traced: CommandLine.option(
            help: trace("help", "Workers"),
            valueName: trace("valueName", "N"),
            maxOccurrences: trace("maxOccurrences", 1),
            minOccurrences: trace("minOccurrences", 0),
            maxValues: trace("maxValues", 1),
            minValues: trace("minValues", 1),
            short: trace("short", "j"),
            long: trace("long", "jobs"),
            key: trace("key", "jobs")
        )
        Assertions.require(order == "help;valueName;maxOccurrences;minOccurrences;maxValues;minValues;short;long;key;")
        Assertions.require(traced.key == "jobs")
        Assertions.require(traced.help == "Workers")

        // Each call answers an independent, frozen canonical record with
        // exactly the canonical slots.
        makeTarget: () => {
            CommandLine.positional(key: "target", minOccurrences: 0, maxOccurrences: 1, valueName: "T", help: null)
        }
        firstTarget: makeTarget()
        secondTarget: makeTarget()
        Assertions.require(firstTarget !== secondTarget)
        Assertions.require(firstTarget.kind == "positional")
        Assertions.require(firstTarget.slotNames().size() == 6)
        Assertions.require(traced.slotNames().size() == 10)
        Assertions.signals(Error, () => {
            firstTarget.key = "changed"
        })
        Assertions.signals(Error, () => {
            traced.key = "changed"
        })
        Assertions.require(secondTarget.key == "target")

        // command keeps its ordinary descriptor-tree API: shared descriptor
        // references are reused, cycles are rejected and deep chains are
        // traversed without execution-stack growth.
        sharedOption: {
            key: "force"
            long: "force"
            short: null
            minValues: 0
            maxValues: 0
            minOccurrences: 0
            maxOccurrences: 1
            valueName: null
            help: null
        }
        sharedChild: {
            name: "run"
            help: null
            options: Array(sharedOption)
            positionals: Array()
            subcommands: Array()
        }
        sharedRoot: CommandLine.command({
            name: "tool"
            help: null
            options: Array(sharedOption)
            positionals: Array()
            subcommands: Array(
                sharedChild,
                {
                    name: "build"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array(sharedChild)
                }
            )
        })
        Assertions.require(sharedRoot.options[0].key == "force")
        Assertions.require(sharedRoot.subcommands[0].options[0].key == "force")
        Assertions.require(sharedRoot.subcommands[1].subcommands[0].name == "run")

        Assertions.signals(Error, () => {
            loopChildren: Array(null)
            loop: {
                name: "loop"
                help: null
                options: Array()
                positionals: Array()
                subcommands: loopChildren
            }
            loopChildren[0] = loop
            CommandLine.command(loop)
        })

        // Test scale only: not a public maximum depth or a claimed safe bound.
        deep: {
            name: "leaf"
            help: null
            options: Array(sharedOption)
            positionals: Array()
            subcommands: Array()
        }
        level: 0
        while(level < 4096) {
            deep = {
                name: "node"
                help: null
                options: Array(sharedOption)
                positionals: Array()
                subcommands: Array(deep)
            }
            level = level + 1
        }
        deepSpec: CommandLine.command(deep)
        Assertions.require(deepSpec.name == "node")
        Assertions.require(deepSpec.options[0].key == "force")
    }),
    Test("result model", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.require(CommandLine.hasSlot("parseResult") === false)
            Assertions.require(CommandLine.hasSlot("commandResult") === false)
            Assertions.require(CommandLine.hasSlot("optionOccurrence") === false)
            Assertions.require(CommandLine.hasSlot("positionalOccurrence") === false)

            argumentsInput: Array(
                "--verbose",
                "package",
                "install",
                "--",
                "-literal"
            )

            arguments: Array(...argumentsInput)
            arguments.freeze()

            verbose: {
                kind: "optionOccurrence"
                key: "verbose"
                spelling: "--verbose"
                tokenIndex: 0
                value: null
                valueTokenIndex: null
            }
            verbose.freeze()

            rootOptions: Array(verbose)
            rootOptions.freeze()
            rootPositionals: Array()
            rootPositionals.freeze()

            leafPositional: {
                kind: "positionalOccurrence"
                key: "files"
                value: "-literal"
                tokenIndex: 4
            }
            leafPositional.freeze()

            leafOptions: Array()
            leafOptions.freeze()
            leafPositionals: Array(leafPositional)
            leafPositionals.freeze()

            leaf: {
                kind: "commandResult"
                name: "install"
                tokenIndex: 2
                endOfOptionsIndex: 3
                options: leafOptions
                positionals: leafPositionals
                subcommand: null
            }
            leaf.freeze()

            packageOptions: Array()
            packageOptions.freeze()
            packagePositionals: Array()
            packagePositionals.freeze()

            packageResult: {
                kind: "commandResult"
                name: "package"
                tokenIndex: 1
                endOfOptionsIndex: null
                options: packageOptions
                positionals: packagePositionals
                subcommand: leaf
            }
            packageResult.freeze()

            root: {
                kind: "commandResult"
                name: "tool"
                tokenIndex: null
                endOfOptionsIndex: null
                options: rootOptions
                positionals: rootPositionals
                subcommand: packageResult
            }
            root.freeze()

            parsed: {
                kind: "parseResult"
                arguments: arguments
                command: root
            }
            parsed.freeze()

            argumentsInput[0] = "changed-after-snapshot"

            Assertions.require(parsed.kind == "parseResult")
            Assertions.require(parsed.arguments[0] == "--verbose")
            Assertions.require(parsed.arguments[1] == "package")
            Assertions.require(parsed.arguments[2] == "install")
            Assertions.require(parsed.arguments[3] == "--")
            Assertions.require(parsed.arguments[4] == "-literal")

            Assertions.require(parsed.command.kind == "commandResult")
            Assertions.require(parsed.command.name == "tool")
            Assertions.require(parsed.command.tokenIndex === null)
            Assertions.require(parsed.command.subcommand.name == "package")
            Assertions.require(parsed.command.subcommand.tokenIndex == 1)
            Assertions.require(parsed.command.subcommand.subcommand.name == "install")
            Assertions.require(parsed.command.subcommand.subcommand.tokenIndex == 2)
            Assertions.require(parsed.command.subcommand.subcommand.endOfOptionsIndex == 3)
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].key == "files")
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].value == "-literal")
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].tokenIndex == 4)

            Assertions.signals(Error, () => {
                parsed.arguments[0] = "changed"
            })

            Assertions.signals(Error, () => {
                parsed.command.name = "changed"
            })

            Assertions.signals(Error, () => {
                parsed.command.options[0].key = "changed"
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("result provenance", () => {
        tool009LegacyCase: () => {
            arguments: Array(
                "--output=value",
                "-abc",
                "--output",
                "--",
                "--",
                "tail"
            )
            arguments.freeze()

            attached: {
                kind: "optionOccurrence"
                key: "output"
                spelling: "--output"
                tokenIndex: 0
                value: "value"
                valueTokenIndex: 0
            }
            attached.freeze()

            clusterA: {
                kind: "optionOccurrence"
                key: "all"
                spelling: "-a"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterA.freeze()

            clusterB: {
                kind: "optionOccurrence"
                key: "brief"
                spelling: "-b"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterB.freeze()

            clusterC: {
                kind: "optionOccurrence"
                key: "check"
                spelling: "-c"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterC.freeze()

            literalDoubleDash: {
                kind: "optionOccurrence"
                key: "output"
                spelling: "--output"
                tokenIndex: 2
                value: "--"
                valueTokenIndex: 3
            }
            literalDoubleDash.freeze()

            tail: {
                kind: "positionalOccurrence"
                key: "tail"
                value: "tail"
                tokenIndex: 5
            }
            tail.freeze()

            options: Array(
                attached,
                clusterA,
                clusterB,
                clusterC,
                literalDoubleDash
            )
            options.freeze()

            positionals: Array(tail)
            positionals.freeze()

            command: {
                kind: "commandResult"
                name: "tool"
                tokenIndex: null
                endOfOptionsIndex: 4
                options: options
                positionals: positionals
                subcommand: null
            }
            command.freeze()

            parsed: {
                kind: "parseResult"
                arguments: arguments
                command: command
            }
            parsed.freeze()

            Assertions.require(parsed.command.options[0].spelling == "--output")
            Assertions.require(parsed.command.options[0].tokenIndex == 0)
            Assertions.require(parsed.command.options[0].value == "value")
            Assertions.require(parsed.command.options[0].valueTokenIndex == 0)

            Assertions.require(parsed.command.options[1].spelling == "-a")
            Assertions.require(parsed.command.options[1].tokenIndex == 1)
            Assertions.require(parsed.command.options[2].spelling == "-b")
            Assertions.require(parsed.command.options[2].tokenIndex == 1)
            Assertions.require(parsed.command.options[3].spelling == "-c")
            Assertions.require(parsed.command.options[3].tokenIndex == 1)

            Assertions.require(parsed.arguments[3] == "--")
            Assertions.require(parsed.arguments[4] == "--")
            Assertions.require(parsed.command.options[4].value == "--")
            Assertions.require(parsed.command.options[4].valueTokenIndex == 3)
            Assertions.require(parsed.command.endOfOptionsIndex == 4)
            Assertions.require(parsed.command.positionals[0].tokenIndex == 5)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("valuename d119", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            flag: CommandLine.option(
                key: "verbose",
                long: "verbose",
                short: "v",
                minValues: 0,
                maxValues: 0,
                minOccurrences: 0,
                maxOccurrences: 1,
                valueName: null,
                help: null
            )

            valued: CommandLine.option(
                key: "output",
                long: "output",
                short: "o",
                minValues: 1,
                maxValues: 1,
                minOccurrences: 0,
                maxOccurrences: 1,
                valueName: "file-path",
                help: null
            )

            positional: CommandLine.positional(
                key: "target",
                minOccurrences: 1,
                maxOccurrences: 1,
                valueName: "target-name",
                help: null
            )

            Assertions.require(flag.valueName === null)
            Assertions.require(valued.valueName == "file-path")
            Assertions.require(positional.valueName == "target-name")

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "broken",
                    long: "broken",
                    short: null,
                    minValues: 0,
                    maxValues: 0,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "broken",
                    long: "broken",
                    short: null,
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: null,
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "broken",
                    long: "broken",
                    short: null,
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.positional(
                    key: "broken",
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: null,
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.positional(
                    key: "broken",
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "",
                    help: null
                )
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("adversarial", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "first"
                            long: "first"
                            short: "x"
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "second"
                            long: "second"
                            short: "x"
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        {
                            key: "same"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        },
                        {
                            key: "same"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        }
                    )
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: 7,
                    long: "jobs",
                    short: "j",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "mañana",
                    short: "j",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "jobs",
                    short: "-",
                    minValues: 1,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool_name"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: {}
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option(
                    key: "jobs",
                    long: "jobs",
                    short: "j",
                    minValues: 1.0,
                    maxValues: 1,
                    minOccurrences: 0,
                    maxOccurrences: 1,
                    valueName: "VALUE",
                    help: null
                )
            })

            Assertions.signals(Error, () => {
                child: {
                    name: "run"
                    help: null
                    options: Array({
                        key: "broken"
                        long: "broken"
                        short: null
                        minValues: 0
                        maxValues: 0
                        minOccurrences: 0
                        valueName: null
                        help: null
                    })
                    positionals: Array()
                    subcommands: Array()
                }

                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array(child)
                })
            })

            Assertions.signals(Error, () => {
                children: Array(null)
                root: {
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: children
                }
                children[0] = root
                CommandLine.command(root)
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
