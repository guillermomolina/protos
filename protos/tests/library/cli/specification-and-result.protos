Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("specification invalid", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: ""
                    long: "jobs"
                    short: "j"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "1jobs"
                    short: "j"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "jobs"
                    short: "jj"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: null
                    short: null
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "jobs"
                    short: "j"
                    minValues: 0
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "jobs"
                    short: "j"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 2
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "same"
                            long: "first"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "same"
                            long: "second"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "a"
                            long: "same"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "b"
                            long: "same"
                            short: null
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        {
                            key: "rest"
                            minOccurrences: 0
                            maxOccurrences: null
                            valueName: "ARG"
                            help: null
                        },
                        {
                            key: "tail"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        }
                    )
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array(
                        {
                            name: "run"
                            help: null
                            options: Array()
                            positionals: Array()
                            subcommands: Array()
                        },
                        {
                            name: "run"
                            help: null
                            options: Array()
                            positionals: Array()
                            subcommands: Array()
                        }
                    )
                })
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("specification snapshot", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            rootOption: {
                key: "jobs"
                long: "jobs"
                short: "j"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "COUNT"
                help: "Workers"
            }

            rootPositional: {
                key: "target"
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "TARGET"
                help: null
            }

            childOption: {
                key: "force"
                long: "force"
                short: "f"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            childOptions: Array(childOption)
            child: {
                name: "run"
                help: "Run"
                options: childOptions
                positionals: Array()
                subcommands: Array()
            }

            rootOptions: Array(rootOption)
            rootPositionals: Array(rootPositional)
            children: Array(child)
            descriptor: {
                name: "tool"
                help: "Tool"
                options: rootOptions
                positionals: rootPositionals
                subcommands: children
            }

            spec: CommandLine.command(descriptor)

            rootOption.key = "changed-root-key"
            rootOption.long = "changed-root-long"
            rootPositional.key = "changed-positional"
            childOption.key = "changed-child-key"
            child.name = "changed-child-name"
            descriptor.name = "changed-root-name"

            rootOptions[0] = {
                key: "replacement"
                long: "replacement"
                short: "r"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            rootPositionals[0] = {
                key: "replacement-positional"
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            childOptions[0] = {
                key: "replacement-child"
                long: "replacement-child"
                short: null
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }

            children[0] = {
                name: "replacement-child"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array()
            }

            Assertions.require(spec.name == "tool")
            Assertions.require(spec.options.size() == 1)
            Assertions.require(spec.options[0].key == "jobs")
            Assertions.require(spec.options[0].long == "jobs")
            Assertions.require(spec.positionals.size() == 1)
            Assertions.require(spec.positionals[0].key == "target")
            Assertions.require(spec.subcommands.size() == 1)
            Assertions.require(spec.subcommands[0].name == "run")
            Assertions.require(spec.subcommands[0].options.size() == 1)
            Assertions.require(spec.subcommands[0].options[0].key == "force")

            Assertions.signals(Error, () => {
                spec.name = "changed"
            })

            Assertions.signals(Error, () => {
                spec.options[0] = spec.options[0]
            })

            Assertions.signals(Error, () => {
                spec.options[0].key = "changed"
            })

            Assertions.signals(Error, () => {
                spec.subcommands[0].name = "changed"
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("specification valid", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            optionDescriptor: {
                key: "jobs"
                long: "jobs"
                short: "j"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "COUNT"
                help: "Number of workers"
            }

            positionalDescriptor: {
                key: "files"
                minOccurrences: 1
                maxOccurrences: null
                valueName: "FILE"
                help: "Input files"
            }

            childDescriptor: {
                name: "run"
                help: "Run a target"
                options: Array({
                    key: "force"
                    long: "force"
                    short: "f"
                    minValues: 0
                    maxValues: 0
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: null
                    help: null
                })
                positionals: Array()
                subcommands: Array()
            }

            first: CommandLine.option(optionDescriptor)
            second: CommandLine.option(optionDescriptor)
            positional: CommandLine.positional(positionalDescriptor)
            command: CommandLine.command({
                name: "tool"
                help: "Tool root"
                options: Array(optionDescriptor)
                positionals: Array(positionalDescriptor)
                subcommands: Array(childDescriptor)
            })

            Assertions.require(first !== second)
            Assertions.require(first !== optionDescriptor)
            Assertions.require(first.kind == "option")
            Assertions.require(first.key == "jobs")
            Assertions.require(first.long == "jobs")
            Assertions.require(first.short == "j")
            Assertions.require(first.minValues == 1)
            Assertions.require(first.maxValues == 1)
            Assertions.require(first.minOccurrences == 0)
            Assertions.require(first.maxOccurrences == 1)
            Assertions.require(first.valueName == "COUNT")
            Assertions.require(first.help == "Number of workers")

            Assertions.require(positional !== positionalDescriptor)
            Assertions.require(positional.kind == "positional")
            Assertions.require(positional.key == "files")
            Assertions.require(positional.minOccurrences == 1)
            Assertions.require(positional.maxOccurrences === null)
            Assertions.require(positional.valueName == "FILE")
            Assertions.require(positional.help == "Input files")

            Assertions.require(command.kind == "command")
            Assertions.require(command.name == "tool")
            Assertions.require(command.options.size() == 1)
            Assertions.require(command.options[0] !== optionDescriptor)
            Assertions.require(command.options[0].key == "jobs")
            Assertions.require(command.positionals.size() == 1)
            Assertions.require(command.positionals[0] !== positionalDescriptor)
            Assertions.require(command.positionals[0].key == "files")
            Assertions.require(command.subcommands.size() == 1)
            Assertions.require(command.subcommands[0] !== childDescriptor)
            Assertions.require(command.subcommands[0].name == "run")
            Assertions.require(command.subcommands[0].options.size() == 1)
            Assertions.require(command.subcommands[0].options[0].key == "force")

            Assertions.require(CommandLine.hasSlot("option"))
            Assertions.require(CommandLine.hasSlot("positional"))
            Assertions.require(CommandLine.hasSlot("command"))
            Assertions.require(CommandLine.hasSlot("parse"))
            Assertions.require(CommandLine.hasSlot("renderHelp"))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("result model", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.require(CommandLine.hasSlot("parseResult") === false)
            Assertions.require(CommandLine.hasSlot("commandResult") === false)
            Assertions.require(CommandLine.hasSlot("optionOccurrence") === false)
            Assertions.require(CommandLine.hasSlot("positionalOccurrence") === false)

            argumentsInput: Array(
                "--verbose",
                "package",
                "install",
                "--",
                "-literal"
            )

            arguments: Array(...argumentsInput)
            arguments.freeze()

            verbose: {
                kind: "optionOccurrence"
                key: "verbose"
                spelling: "--verbose"
                tokenIndex: 0
                value: null
                valueTokenIndex: null
            }
            verbose.freeze()

            rootOptions: Array(verbose)
            rootOptions.freeze()
            rootPositionals: Array()
            rootPositionals.freeze()

            leafPositional: {
                kind: "positionalOccurrence"
                key: "files"
                value: "-literal"
                tokenIndex: 4
            }
            leafPositional.freeze()

            leafOptions: Array()
            leafOptions.freeze()
            leafPositionals: Array(leafPositional)
            leafPositionals.freeze()

            leaf: {
                kind: "commandResult"
                name: "install"
                tokenIndex: 2
                endOfOptionsIndex: 3
                options: leafOptions
                positionals: leafPositionals
                subcommand: null
            }
            leaf.freeze()

            packageOptions: Array()
            packageOptions.freeze()
            packagePositionals: Array()
            packagePositionals.freeze()

            packageResult: {
                kind: "commandResult"
                name: "package"
                tokenIndex: 1
                endOfOptionsIndex: null
                options: packageOptions
                positionals: packagePositionals
                subcommand: leaf
            }
            packageResult.freeze()

            root: {
                kind: "commandResult"
                name: "tool"
                tokenIndex: null
                endOfOptionsIndex: null
                options: rootOptions
                positionals: rootPositionals
                subcommand: packageResult
            }
            root.freeze()

            parsed: {
                kind: "parseResult"
                arguments: arguments
                command: root
            }
            parsed.freeze()

            argumentsInput[0] = "changed-after-snapshot"

            Assertions.require(parsed.kind == "parseResult")
            Assertions.require(parsed.arguments[0] == "--verbose")
            Assertions.require(parsed.arguments[1] == "package")
            Assertions.require(parsed.arguments[2] == "install")
            Assertions.require(parsed.arguments[3] == "--")
            Assertions.require(parsed.arguments[4] == "-literal")

            Assertions.require(parsed.command.kind == "commandResult")
            Assertions.require(parsed.command.name == "tool")
            Assertions.require(parsed.command.tokenIndex === null)
            Assertions.require(parsed.command.subcommand.name == "package")
            Assertions.require(parsed.command.subcommand.tokenIndex == 1)
            Assertions.require(parsed.command.subcommand.subcommand.name == "install")
            Assertions.require(parsed.command.subcommand.subcommand.tokenIndex == 2)
            Assertions.require(parsed.command.subcommand.subcommand.endOfOptionsIndex == 3)
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].key == "files")
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].value == "-literal")
            Assertions.require(parsed.command.subcommand.subcommand.positionals[0].tokenIndex == 4)

            Assertions.signals(Error, () => {
                parsed.arguments[0] = "changed"
            })

            Assertions.signals(Error, () => {
                parsed.command.name = "changed"
            })

            Assertions.signals(Error, () => {
                parsed.command.options[0].key = "changed"
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("result provenance", () => {
        tool009LegacyCase: () => {
            arguments: Array(
                "--output=value",
                "-abc",
                "--output",
                "--",
                "--",
                "tail"
            )
            arguments.freeze()

            attached: {
                kind: "optionOccurrence"
                key: "output"
                spelling: "--output"
                tokenIndex: 0
                value: "value"
                valueTokenIndex: 0
            }
            attached.freeze()

            clusterA: {
                kind: "optionOccurrence"
                key: "all"
                spelling: "-a"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterA.freeze()

            clusterB: {
                kind: "optionOccurrence"
                key: "brief"
                spelling: "-b"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterB.freeze()

            clusterC: {
                kind: "optionOccurrence"
                key: "check"
                spelling: "-c"
                tokenIndex: 1
                value: null
                valueTokenIndex: null
            }
            clusterC.freeze()

            literalDoubleDash: {
                kind: "optionOccurrence"
                key: "output"
                spelling: "--output"
                tokenIndex: 2
                value: "--"
                valueTokenIndex: 3
            }
            literalDoubleDash.freeze()

            tail: {
                kind: "positionalOccurrence"
                key: "tail"
                value: "tail"
                tokenIndex: 5
            }
            tail.freeze()

            options: Array(
                attached,
                clusterA,
                clusterB,
                clusterC,
                literalDoubleDash
            )
            options.freeze()

            positionals: Array(tail)
            positionals.freeze()

            command: {
                kind: "commandResult"
                name: "tool"
                tokenIndex: null
                endOfOptionsIndex: 4
                options: options
                positionals: positionals
                subcommand: null
            }
            command.freeze()

            parsed: {
                kind: "parseResult"
                arguments: arguments
                command: command
            }
            parsed.freeze()

            Assertions.require(parsed.command.options[0].spelling == "--output")
            Assertions.require(parsed.command.options[0].tokenIndex == 0)
            Assertions.require(parsed.command.options[0].value == "value")
            Assertions.require(parsed.command.options[0].valueTokenIndex == 0)

            Assertions.require(parsed.command.options[1].spelling == "-a")
            Assertions.require(parsed.command.options[1].tokenIndex == 1)
            Assertions.require(parsed.command.options[2].spelling == "-b")
            Assertions.require(parsed.command.options[2].tokenIndex == 1)
            Assertions.require(parsed.command.options[3].spelling == "-c")
            Assertions.require(parsed.command.options[3].tokenIndex == 1)

            Assertions.require(parsed.arguments[3] == "--")
            Assertions.require(parsed.arguments[4] == "--")
            Assertions.require(parsed.command.options[4].value == "--")
            Assertions.require(parsed.command.options[4].valueTokenIndex == 3)
            Assertions.require(parsed.command.endOfOptionsIndex == 4)
            Assertions.require(parsed.command.positionals[0].tokenIndex == 5)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("valuename d119", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            flag: CommandLine.option({
                key: "verbose"
                long: "verbose"
                short: "v"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            })

            valued: CommandLine.option({
                key: "output"
                long: "output"
                short: "o"
                minValues: 1
                maxValues: 1
                minOccurrences: 0
                maxOccurrences: 1
                valueName: "file-path"
                help: null
            })

            positional: CommandLine.positional({
                key: "target"
                minOccurrences: 1
                maxOccurrences: 1
                valueName: "target-name"
                help: null
            })

            Assertions.require(flag.valueName === null)
            Assertions.require(valued.valueName == "file-path")
            Assertions.require(positional.valueName == "target-name")

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "broken"
                    long: "broken"
                    short: null
                    minValues: 0
                    maxValues: 0
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "broken"
                    long: "broken"
                    short: null
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: null
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "broken"
                    long: "broken"
                    short: null
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: ""
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.positional({
                    key: "broken"
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: null
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.positional({
                    key: "broken"
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: ""
                    help: null
                })
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("adversarial", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array(
                        {
                            key: "first"
                            long: "first"
                            short: "x"
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        },
                        {
                            key: "second"
                            long: "second"
                            short: "x"
                            minValues: 0
                            maxValues: 0
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: null
                            help: null
                        }
                    )
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array(
                        {
                            key: "same"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        },
                        {
                            key: "same"
                            minOccurrences: 0
                            maxOccurrences: 1
                            valueName: "ARG"
                            help: null
                        }
                    )
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: 7
                    long: "jobs"
                    short: "j"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "mañana"
                    short: "j"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "jobs"
                    short: "-"
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool_name"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.command({
                    name: "tool"
                    help: null
                    options: {}
                    positionals: Array()
                    subcommands: Array()
                })
            })

            Assertions.signals(Error, () => {
                CommandLine.option({
                    key: "jobs"
                    long: "jobs"
                    short: "j"
                    minValues: 1.0
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            })

            Assertions.signals(Error, () => {
                child: {
                    name: "run"
                    help: null
                    options: Array({
                        key: "broken"
                        long: "broken"
                        short: null
                        minValues: 0
                        maxValues: 0
                        minOccurrences: 0
                        valueName: null
                        help: null
                    })
                    positionals: Array()
                    subcommands: Array()
                }

                CommandLine.command({
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array(child)
                })
            })

            Assertions.signals(Error, () => {
                children: Array(null)
                root: {
                    name: "tool"
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: children
                }
                children[0] = root
                CommandLine.command(root)
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
