CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

target: CommandLine.positional({
    key: "target"
    minOccurrences: 1
    maxOccurrences: null
    valueName: "target-name"
    help: "Target to install"
})

deep: CommandLine.command({
    name: "deep"
    help: "Grandchild only"
    options: Array()
    positionals: Array()
    subcommands: Array()
})

install: CommandLine.command({
    name: "install"
    help: "Install targets"
    options: Array()
    positionals: Array(target)
    subcommands: Array(deep)
})

package: CommandLine.command({
    name: "package"
    help: "Package operations"
    options: Array()
    positionals: Array()
    subcommands: Array(install)
})

root: CommandLine.command({
    name: "tool"
    help: "Root"
    options: Array()
    positionals: Array()
    subcommands: Array(package)
})

expected:
    "Usage: tool package install target-name [target-name]... [COMMAND]\n\n" +
    "Install targets\n\n" +
    "Arguments:\n" +
    "  target-name [target-name]...\n" +
    "    Target to install\n\n" +
    "Commands:\n" +
    "  deep\n" +
    "    Grandchild only"

rendered: CommandLine.renderHelp(
    root,
    Array("package", "install")
)

require(rendered == expected)
require(rendered == "Usage: tool package install target-name [target-name]... [COMMAND]\n\nInstall targets\n\nArguments:\n  target-name [target-name]...\n    Target to install\n\nCommands:\n  deep\n    Grandchild only")

minimal: CommandLine.command({
    name: "empty"
    help: null
    options: Array()
    positionals: Array()
    subcommands: Array()
})

require(CommandLine.renderHelp(minimal, Array()) == "Usage: empty")

require(reject(() => {
    CommandLine.renderHelp(root, Array("Package"))
}))

require(reject(() => {
    CommandLine.renderHelp(root, Array("package", "missing"))
}))

require(reject(() => {
    CommandLine.renderHelp(root, {})
}))

require(reject(() => {
    CommandLine.renderHelp(root, Array(1))
}))

true
