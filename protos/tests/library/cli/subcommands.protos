Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parse subcommand deep", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            target: CommandLine.positional({
                key: "target"
                minOccurrences: 1
                maxOccurrences: 1
                valueName: "TARGET"
                help: null
            })

            install: CommandLine.command({
                name: "install"
                help: null
                options: Array()
                positionals: Array(target)
                subcommands: Array()
            })

            package: CommandLine.command({
                name: "package"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array(install)
            })

            root: CommandLine.command({
                name: "tool"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array(package)
            })

            parsed: CommandLine.parse(
                root,
                Array("package", "install", "artifact")
            )

            require(parsed.arguments.size() == 3)
            require(parsed.command.name == "tool")
            require(parsed.command.tokenIndex === null)
            require(parsed.command.positionals.size() == 0)

            packageResult: parsed.command.subcommand
            require(packageResult.name == "package")
            require(packageResult.tokenIndex == 0)
            require(packageResult.positionals.size() == 0)

            installResult: packageResult.subcommand
            require(installResult.name == "install")
            require(installResult.tokenIndex == 1)
            require(installResult.positionals.size() == 1)
            require(installResult.positionals[0].key == "target")
            require(installResult.positionals[0].value == "artifact")
            require(installResult.positionals[0].tokenIndex == 2)
            require(installResult.subcommand === null)

            require(reject(() => {
                packageResult.name = "changed"
            }))

            require(reject(() => {
                installResult.positionals[0].value = "changed"
            }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse subcommand delimiter", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            tail: CommandLine.positional({
                key: "tail"
                minOccurrences: 0
                maxOccurrences: null
                valueName: "ARG"
                help: null
            })

            run: CommandLine.command({
                name: "run"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array()
            })

            root: CommandLine.command({
                name: "tool"
                help: null
                options: Array()
                positionals: Array(tail)
                subcommands: Array(run)
            })

            escaped: CommandLine.parse(root, Array("--", "run", "other"))

            require(escaped.command.endOfOptionsIndex == 0)
            require(escaped.command.subcommand === null)
            require(escaped.command.positionals.size() == 2)
            require(escaped.command.positionals[0].key == "tail")
            require(escaped.command.positionals[0].value == "run")
            require(escaped.command.positionals[0].tokenIndex == 1)
            require(escaped.command.positionals[1].value == "other")
            require(escaped.command.positionals[1].tokenIndex == 2)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse subcommand options", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            flag: (key, longName) => {
                CommandLine.option({
                    key: key
                    long: longName
                    short: null
                    minValues: 0
                    maxValues: 0
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: null
                    help: null
                })
            }

            valued: (key, longName) => {
                CommandLine.option({
                    key: key
                    long: longName
                    short: null
                    minValues: 1
                    maxValues: 1
                    minOccurrences: 0
                    maxOccurrences: 1
                    valueName: "VALUE"
                    help: null
                })
            }

            rootOnly: flag("root", "root")
            childOnly: flag("child", "child")
            shared: flag("verbose", "verbose")
            output: valued("output", "output")

            run: CommandLine.command({
                name: "run"
                help: null
                options: Array(childOnly, shared)
                positionals: Array()
                subcommands: Array()
            })

            root: CommandLine.command({
                name: "tool"
                help: null
                options: Array(rootOnly, shared, output)
                positionals: Array()
                subcommands: Array(run)
            })

            scoped: CommandLine.parse(
                root,
                Array("--root", "--verbose", "run", "--child", "--verbose")
            )

            require(scoped.command.options.size() == 2)
            require(scoped.command.options[0].key == "root")
            require(scoped.command.options[0].tokenIndex == 0)
            require(scoped.command.options[1].key == "verbose")
            require(scoped.command.options[1].tokenIndex == 1)

            require(scoped.command.subcommand.name == "run")
            require(scoped.command.subcommand.tokenIndex == 2)
            require(scoped.command.subcommand.options.size() == 2)
            require(scoped.command.subcommand.options[0].key == "child")
            require(scoped.command.subcommand.options[0].tokenIndex == 3)
            require(scoped.command.subcommand.options[1].key == "verbose")
            require(scoped.command.subcommand.options[1].tokenIndex == 4)

            require(reject(() => {
                CommandLine.parse(root, Array("run", "--root"))
            }))

            valueWins: CommandLine.parse(root, Array("--output", "run"))
            require(valueWins.command.subcommand === null)
            require(valueWins.command.options.size() == 1)
            require(valueWins.command.options[0].key == "output")
            require(valueWins.command.options[0].value == "run")
            require(valueWins.command.options[0].tokenIndex == 0)
            require(valueWins.command.options[0].valueTokenIndex == 1)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse subcommands d115", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            positional: (key, minimum, maximum) => {
                CommandLine.positional({
                    key: key
                    minOccurrences: minimum
                    maxOccurrences: maximum
                    valueName: key
                    help: null
                })
            }

            leaf: (name) => {
                CommandLine.command({
                    name: name
                    help: null
                    options: Array()
                    positionals: Array()
                    subcommands: Array()
                })
            }

            run: leaf("run")

            optionalParent: CommandLine.command({
                name: "tool"
                help: null
                options: Array()
                positionals: Array(positional("target", 0, 1))
                subcommands: Array(run)
            })

            optionalSelected: CommandLine.parse(optionalParent, Array("run"))
            require(optionalSelected.command.positionals.size() == 0)
            require(optionalSelected.command.subcommand.name == "run")
            require(optionalSelected.command.subcommand.tokenIndex == 0)
            require(optionalSelected.command.subcommand.subcommand === null)

            requiredParent: CommandLine.command({
                name: "tool"
                help: null
                options: Array()
                positionals: Array(positional("config", 1, 1))
                subcommands: Array(run)
            })

            requiredConsumesName: CommandLine.parse(requiredParent, Array("run"))
            require(requiredConsumesName.command.subcommand === null)
            require(requiredConsumesName.command.positionals.size() == 1)
            require(requiredConsumesName.command.positionals[0].key == "config")
            require(requiredConsumesName.command.positionals[0].value == "run")
            require(requiredConsumesName.command.positionals[0].tokenIndex == 0)

            requiredThenChild:
                CommandLine.parse(requiredParent, Array("config.toml", "run"))
            require(requiredThenChild.command.positionals.size() == 1)
            require(requiredThenChild.command.positionals[0].value == "config.toml")
            require(requiredThenChild.command.subcommand.name == "run")
            require(requiredThenChild.command.subcommand.tokenIndex == 1)

            d111Parent: CommandLine.command({
                name: "tool"
                help: null
                options: Array()
                positionals: Array(
                    positional("A", 0, 1),
                    positional("B", 1, 1)
                )
                subcommands: Array(run)
            })

            d111Selected: CommandLine.parse(d111Parent, Array("x", "run"))
            require(d111Selected.command.positionals.size() == 1)
            require(d111Selected.command.positionals[0].key == "B")
            require(d111Selected.command.positionals[0].value == "x")
            require(d111Selected.command.subcommand.name == "run")
            require(d111Selected.command.subcommand.tokenIndex == 1)

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
