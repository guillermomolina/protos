Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("help rendering d118", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            option: (
                key,
                longName,
                shortName,
                minValues,
                minOccurrences,
                maxOccurrences,
                valueName,
                help
            ) => {
                CommandLine.option({
                    key: key
                    long: longName
                    short: shortName
                    minValues: minValues
                    maxValues: minValues
                    minOccurrences: minOccurrences
                    maxOccurrences: maxOccurrences
                    valueName: valueName
                    help: help
                })
            }

            positional: (key, minimum, maximum, valueName, help) => {
                CommandLine.positional({
                    key: key
                    minOccurrences: minimum
                    maxOccurrences: maximum
                    valueName: valueName
                    help: help
                })
            }

            build: CommandLine.command({
                name: "build"
                help: "Build a package"
                options: Array()
                positionals: Array()
                subcommands: Array()
            })

            test: CommandLine.command({
                name: "test"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array()
            })

            root: CommandLine.command({
                name: "tool"
                help: "Tool root"
                options: Array(
                    option("verbose", "verbose", "v", 0, 0, 1, null, "Verbose output"),
                    option("output", "output", "o", 1, 1, 1, "FILE", "Output file"),
                    option("define", "define", null, 1, 1, null, "NAME", null),
                    option("quiet", null, "q", 0, 0, 1, null, "Quiet mode")
                )
                positionals: Array(
                    positional("input", 1, 1, "INPUT", "Input file"),
                    positional("mode", 0, 1, "MODE", null),
                    positional("extra", 0, null, "EXTRA", "Additional inputs")
                )
                subcommands: Array(build, test)
            })

            expected:
                "Usage: tool --output FILE --define NAME [--define NAME]... [OPTIONS] INPUT [MODE] [EXTRA]... [COMMAND]\n\n" +
                "Tool root\n\n" +
                "Arguments:\n" +
                "  INPUT\n" +
                "    Input file\n" +
                "  [MODE]\n" +
                "  [EXTRA]...\n" +
                "    Additional inputs\n\n" +
                "Options:\n" +
                "  -v, --verbose\n" +
                "    Verbose output\n" +
                "  -o, --output FILE (required)\n" +
                "    Output file\n" +
                "  --define NAME (required, repeatable)\n" +
                "  -q\n" +
                "    Quiet mode\n\n" +
                "Commands:\n" +
                "  build\n" +
                "    Build a package\n" +
                "  test"

            rendered: CommandLine.renderHelp(root, Array())

            Assertions.require(rendered == expected)
            Assertions.require(rendered == CommandLine.renderHelp(root, Array()))
            Assertions.require(rendered.size() == expected.size())

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("help rendering path d118", () => {
        tool009LegacyCase: () => {
            CommandLine: import("std:cli/CommandLine")

            target: CommandLine.positional({
                key: "target"
                minOccurrences: 1
                maxOccurrences: null
                valueName: "target-name"
                help: "Target to install"
            })

            deep: CommandLine.command({
                name: "deep"
                help: "Grandchild only"
                options: Array()
                positionals: Array()
                subcommands: Array()
            })

            install: CommandLine.command({
                name: "install"
                help: "Install targets"
                options: Array()
                positionals: Array(target)
                subcommands: Array(deep)
            })

            package: CommandLine.command({
                name: "package"
                help: "Package operations"
                options: Array()
                positionals: Array()
                subcommands: Array(install)
            })

            root: CommandLine.command({
                name: "tool"
                help: "Root"
                options: Array()
                positionals: Array()
                subcommands: Array(package)
            })

            expected:
                "Usage: tool package install target-name [target-name]... [COMMAND]\n\n" +
                "Install targets\n\n" +
                "Arguments:\n" +
                "  target-name [target-name]...\n" +
                "    Target to install\n\n" +
                "Commands:\n" +
                "  deep\n" +
                "    Grandchild only"

            rendered: CommandLine.renderHelp(
                root,
                Array("package", "install")
            )

            Assertions.require(rendered == expected)
            Assertions.require(rendered == "Usage: tool package install target-name [target-name]... [COMMAND]\n\nInstall targets\n\nArguments:\n  target-name [target-name]...\n    Target to install\n\nCommands:\n  deep\n    Grandchild only")

            minimal: CommandLine.command({
                name: "empty"
                help: null
                options: Array()
                positionals: Array()
                subcommands: Array()
            })

            Assertions.require(CommandLine.renderHelp(minimal, Array()) == "Usage: empty")

            Assertions.signals(Error, () => {
                CommandLine.renderHelp(root, Array("Package"))
            })

            Assertions.signals(Error, () => {
                CommandLine.renderHelp(root, Array("package", "missing"))
            })

            Assertions.signals(Error, () => {
                CommandLine.renderHelp(root, {})
            })

            Assertions.signals(Error, () => {
                CommandLine.renderHelp(root, Array(1))
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
