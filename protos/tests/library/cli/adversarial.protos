CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

require(reject(() => {
    CommandLine.command({
        name: "tool"
        help: null
        options: Array(
            {
                key: "first"
                long: "first"
                short: "x"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            },
            {
                key: "second"
                long: "second"
                short: "x"
                minValues: 0
                maxValues: 0
                minOccurrences: 0
                maxOccurrences: 1
                valueName: null
                help: null
            }
        )
        positionals: Array()
        subcommands: Array()
    })
}))

