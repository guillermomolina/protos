require(reject(() => {
    child: {
        name: "run"
        help: null
        options: Array({
            key: "broken"
            long: "broken"
            short: null
            minValues: 0
            maxValues: 0
            minOccurrences: 0
            valueName: null
            help: null
        })
        positionals: Array()
        subcommands: Array()
    }

    CommandLine.command({
        name: "tool"
        help: null
        options: Array()
        positionals: Array()
        subcommands: Array(child)
    })
}))

require(reject(() => {
    children: Array(null)
    root: {
        name: "tool"
        help: null
        options: Array()
        positionals: Array()
        subcommands: children
    }
    children[0] = root
    CommandLine.command(root)
}))

true
