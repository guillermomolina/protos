CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

flag: CommandLine.option({
    key: "verbose"
    long: "verbose"
    short: "v"
    minValues: 0
    maxValues: 0
    minOccurrences: 0
    maxOccurrences: 1
    valueName: null
    help: null
})

value: CommandLine.option({
    key: "output"
    long: "output"
    short: "o"
    minValues: 1
    maxValues: 1
    minOccurrences: 1
    maxOccurrences: 1
    valueName: "VALUE"
    help: null
})

target: CommandLine.positional({
    key: "target"
    minOccurrences: 1
    maxOccurrences: 1
    valueName: "TARGET"
    help: null
})

spec: CommandLine.command({
    name: "tool"
    help: null
    options: Array(flag, value)
    positionals: Array(target)
    subcommands: Array()
})

require(reject(() => {
    CommandLine.parse(spec, Array("--unknown", "--output", "x", "target"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("-x", "--output", "x", "target"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("-vo", "x", "target"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("--output"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("target"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("--output", "a", "--output", "b", "target"))
}))

require(reject(() => {
    CommandLine.parse(spec, Array("--verbose=value", "--output", "x", "target"))
}))

require(reject(() => {
    CommandLine.parse(
        CommandLine.command({
            name: "tool"
            help: null
            options: Array()
            positionals: Array(target)
            subcommands: Array()
        }),
        Array()
    )
}))

require(reject(() => {
    CommandLine.parse(
        CommandLine.command({
            name: "tool"
            help: null
            options: Array()
            positionals: Array()
            subcommands: Array()
        }),
        Array("unexpected")
    )
}))

require(reject(() => {
    CommandLine.parse(
        CommandLine.command({
            name: "tool"
            help: null
            options: Array()
            positionals: Array()
            subcommands: Array()
        }),
        Array("-")
    )
}))

require(reject(() => {
    CommandLine.parse(
        CommandLine.command({
            name: "tool"
            help: null
            options: Array()
            positionals: Array()
            subcommands: Array()
        }),
        {}
    )
}))

require(reject(() => {
    CommandLine.parse(
        CommandLine.command({
            name: "tool"
            help: null
            options: Array()
            positionals: Array()
            subcommands: Array()
        }),
        Array(1)
    )
}))

true
