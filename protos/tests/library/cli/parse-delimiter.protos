CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

output: CommandLine.option({
    key: "output"
    long: "output"
    short: "o"
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "VALUE"
    help: null
})

tail: CommandLine.positional({
    key: "tail"
    minOccurrences: 0
    maxOccurrences: null
    valueName: "ARG"
    help: null
})

spec: CommandLine.command({
    name: "tool"
    help: null
    options: Array(output)
    positionals: Array(tail)
    subcommands: Array()
})

delimited: CommandLine.parse(
    spec,
    Array("--output=value", "--", "--unknown", "-x", "plain")
)

require(delimited.command.options.size() == 1)
require(delimited.command.options[0].value == "value")
require(delimited.command.options[0].tokenIndex == 0)
require(delimited.command.options[0].valueTokenIndex == 0)
require(delimited.command.endOfOptionsIndex == 1)
require(delimited.command.positionals.size() == 3)
require(delimited.command.positionals[0].value == "--unknown")
require(delimited.command.positionals[0].tokenIndex == 2)
require(delimited.command.positionals[1].value == "-x")
require(delimited.command.positionals[1].tokenIndex == 3)
require(delimited.command.positionals[2].value == "plain")
require(delimited.command.positionals[2].tokenIndex == 4)

literalDelimiterValue: CommandLine.parse(
    spec,
    Array("--output", "--", "tail")
)

require(literalDelimiterValue.command.options.size() == 1)
require(literalDelimiterValue.command.options[0].value == "--")
require(literalDelimiterValue.command.options[0].tokenIndex == 0)
require(literalDelimiterValue.command.options[0].valueTokenIndex == 1)
require(literalDelimiterValue.command.endOfOptionsIndex === null)
require(literalDelimiterValue.command.positionals.size() == 1)
require(literalDelimiterValue.command.positionals[0].value == "tail")
require(literalDelimiterValue.command.positionals[0].tokenIndex == 2)

true
