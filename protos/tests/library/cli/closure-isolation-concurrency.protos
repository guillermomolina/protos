CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

tag: CommandLine.option({
    key: "tag"
    long: "tag"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "VALUE"
    help: null
})

sharedSpec: CommandLine.command({
    name: "shared"
    help: null
    options: Array(tag)
    positionals: Array()
    subcommands: Array()
})

// Two simultaneously live parses of the same frozen spec must have completely
// invocation-local indexes, occurrence counts, argv snapshots and result nodes.
firstFuture: (() => {
    CommandLine.parse(sharedSpec, Array("--tag", "first"))
}).future()

secondFuture: (() => {
    CommandLine.parse(sharedSpec, Array("--tag", "second"))
}).future()

first: firstFuture.value()
second: secondFuture.value()

require(first !== second)
require(first.arguments !== second.arguments)
require(first.command !== second.command)
require(first.command.options !== second.command.options)
require(first.command.options[0] !== second.command.options[0])

require(first.command.options.size() == 1)
require(second.command.options.size() == 1)
require(first.command.options[0].key == "tag")
require(second.command.options[0].key == "tag")
require(first.command.options[0].value == "first")
require(second.command.options[0].value == "second")
require(first.command.options[0].tokenIndex == 0)
require(second.command.options[0].tokenIndex == 0)
require(first.command.options[0].valueTokenIndex == 1)
require(second.command.options[0].valueTokenIndex == 1)

// Separate specs may reuse the same command-line spelling with unrelated logical
// identities. A global parser registry/index would make this observation unsafe.
leftOption: CommandLine.option({
    key: "leftKey"
    long: "shared"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "LEFT"
    help: null
})

rightOption: CommandLine.option({
    key: "rightKey"
    long: "shared"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "RIGHT"
    help: null
})

leftSpec: CommandLine.command({
    name: "left"
    help: null
    options: Array(leftOption)
    positionals: Array()
    subcommands: Array()
})

rightSpec: CommandLine.command({
    name: "right"
    help: null
    options: Array(rightOption)
    positionals: Array()
    subcommands: Array()
})

leftFuture: (() => {
    CommandLine.parse(leftSpec, Array("--shared", "L"))
}).future()

rightFuture: (() => {
    CommandLine.parse(rightSpec, Array("--shared", "R"))
}).future()

left: leftFuture.value()
right: rightFuture.value()

require(left.command.options[0].key == "leftKey")
require(left.command.options[0].value == "L")
require(right.command.options[0].key == "rightKey")
require(right.command.options[0].value == "R")

// Pure help rendering is likewise invocation-local and deterministic.
leftHelpFuture: (() => {
    CommandLine.renderHelp(leftSpec, Array())
}).future()

rightHelpFuture: (() => {
    CommandLine.renderHelp(rightSpec, Array())
}).future()

leftHelp: leftHelpFuture.value()
rightHelp: rightHelpFuture.value()

require(leftHelp == "Usage: left [OPTIONS]\n\nOptions:\n  --shared LEFT")
require(rightHelp == "Usage: right [OPTIONS]\n\nOptions:\n  --shared RIGHT")

// A later parse still sees no retained occurrence or registry state.
again: CommandLine.parse(sharedSpec, Array("--tag", "again"))
require(again.command.options.size() == 1)
require(again.command.options[0].value == "again")

true
