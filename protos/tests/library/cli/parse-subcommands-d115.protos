CommandLine: import("std:cli/CommandLine")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

positional: (key, minimum, maximum) => {
    CommandLine.positional({
        key: key
        minOccurrences: minimum
        maxOccurrences: maximum
        valueName: key
        help: null
    })
}

leaf: (name) => {
    CommandLine.command({
        name: name
        help: null
        options: Array()
        positionals: Array()
        subcommands: Array()
    })
}

run: leaf("run")

optionalParent: CommandLine.command({
    name: "tool"
    help: null
    options: Array()
    positionals: Array(positional("target", 0, 1))
    subcommands: Array(run)
})

optionalSelected: CommandLine.parse(optionalParent, Array("run"))
require(optionalSelected.command.positionals.size() == 0)
require(optionalSelected.command.subcommand.name == "run")
require(optionalSelected.command.subcommand.tokenIndex == 0)
require(optionalSelected.command.subcommand.subcommand === null)

requiredParent: CommandLine.command({
    name: "tool"
    help: null
    options: Array()
    positionals: Array(positional("config", 1, 1))
    subcommands: Array(run)
})

requiredConsumesName: CommandLine.parse(requiredParent, Array("run"))
require(requiredConsumesName.command.subcommand === null)
require(requiredConsumesName.command.positionals.size() == 1)
require(requiredConsumesName.command.positionals[0].key == "config")
require(requiredConsumesName.command.positionals[0].value == "run")
require(requiredConsumesName.command.positionals[0].tokenIndex == 0)

requiredThenChild:
    CommandLine.parse(requiredParent, Array("config.toml", "run"))
require(requiredThenChild.command.positionals.size() == 1)
require(requiredThenChild.command.positionals[0].value == "config.toml")
require(requiredThenChild.command.subcommand.name == "run")
require(requiredThenChild.command.subcommand.tokenIndex == 1)

d111Parent: CommandLine.command({
    name: "tool"
    help: null
    options: Array()
    positionals: Array(
        positional("A", 0, 1),
        positional("B", 1, 1)
    )
    subcommands: Array(run)
})

d111Selected: CommandLine.parse(d111Parent, Array("x", "run"))
require(d111Selected.command.positionals.size() == 1)
require(d111Selected.command.positionals[0].key == "B")
require(d111Selected.command.positionals[0].value == "x")
require(d111Selected.command.subcommand.name == "run")
require(d111Selected.command.subcommand.tokenIndex == 1)

true
