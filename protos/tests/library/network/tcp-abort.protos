// The integrated TCP conformance fixture supplies an authentic local `connection` and `emptyBytes`.
// Ordinary network value corpora have no socket grant; this file creates no authority.
Assertions: import("std:test/assertions")
Test: import("std:test/test")

tests: [
    Test("explicit TCP abort public contract", () => {
        local: connection.localEndpoint()
        remote: connection.remoteEndpoint()
        protocol: connection.parent()
        Assertions.require(protocol.hasSlot("abort"))
        Assertions.require(!protocol.hasSlot("_coreTcpAbortBridge"))
        Assertions.require(Error.handle(
            () => { protocol.abort(); false },
            (error) => { error.parent() === Error }
        ))
        Assertions.require(Error.handle(
            () => { connection.abort(1); false },
            (error) => { error.parent() === Error }
        ))
        first: connection.abort()
        second: connection.abort()
        Assertions.require(first !== second)
        Assertions.require(first.value() === connection)
        Assertions.require(second.value() === connection)
        Assertions.require(connection.close().value() === connection)
        Assertions.require(connection.abort().value() === connection)
        Assertions.require(connection.localEndpoint() == local)
        Assertions.require(connection.remoteEndpoint() == remote)
        Assertions.require(IOLifecycleError.handle(
            () => { connection.read(1).value(); false },
            (error) => { true }
        ))
        Assertions.require(IOLifecycleError.handle(
            () => { connection.write(emptyBytes).value(); false },
            (error) => { true }
        ))
    })
]
tests.freeze()
