IpAddresses: import("std:network/IpAddresses")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

zero: IpAddresses.parse("0.0.0.0")
require(IpAddress.recognizes(zero))
require(zero.version == 4)
require(zero.bits == 0)
require(IpAddresses.format(zero) == "0.0.0.0")

loopback: IpAddresses.parse("127.0.0.1")
require(loopback.version == 4)
require(loopback.bits == 2130706433)
require(IpAddresses.format(loopback) == "127.0.0.1")

documentation: IpAddresses.parse("192.0.2.1")
require(documentation.bits == 3221225985)
require(IpAddresses.format(documentation) == "192.0.2.1")

maximum: IpAddresses.parse("255.255.255.255")
require(maximum.bits == 4294967295)
require(IpAddresses.format(maximum) == "255.255.255.255")

constructed: IpAddresses.v4(10, 20, 30, 40)
formatted: IpAddresses.format(constructed)
require(formatted == "10.20.30.40")

reparsed: IpAddresses.parse(formatted)
require(reparsed == constructed)
require(reparsed !== constructed)

canonical: IpAddresses.format(IpAddresses.parse("203.0.113.9"))
require(canonical == "203.0.113.9")

true
