IpAddresses: import("std:network/IpAddresses")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

zero: IpAddresses.v6(0, 0, 0, 0, 0, 0, 0, 0)
require(IpAddress.recognizes(zero))
require(zero.parent() === IpAddress)
require(zero.version == 6)
require(zero.bits == 0)

documentation: IpAddresses.v6(8193, 3512, 0, 0, 0, 0, 0, 1)
require(documentation.version == 6)
require(documentation.bits == 42540766411282592856903984951653826561)

maximum: IpAddresses.v6(
    65535, 65535, 65535, 65535,
    65535, 65535, 65535, 65535
)
require(maximum.bits == 340282366920938463463374607431768211455)

fresh: IpAddresses.v6(8193, 3512, 0, 0, 0, 0, 0, 1)
require(fresh == documentation)
require(fresh !== documentation)

true
