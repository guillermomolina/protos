Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("ipv4 invalid", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            // Shape/cardinality.
            require(reject(() => { IpAddresses.parse("") }))
            require(reject(() => { IpAddresses.parse("1.2.3") }))
            require(reject(() => { IpAddresses.parse("127.1") }))
            require(reject(() => { IpAddresses.parse("1.2.3.4.5") }))
            require(reject(() => { IpAddresses.parse(".1.2.3") }))
            require(reject(() => { IpAddresses.parse("1..2.3") }))
            require(reject(() => { IpAddresses.parse("1.2.3.") }))

            // Strict decimal spelling and range.
            require(reject(() => { IpAddresses.parse("01.2.3.4") }))
            require(reject(() => { IpAddresses.parse("1.02.3.4") }))
            require(reject(() => { IpAddresses.parse("1.2.003.4") }))
            require(reject(() => { IpAddresses.parse("256.0.0.1") }))
            require(reject(() => { IpAddresses.parse("1.2.3.999") }))
            require(reject(() => { IpAddresses.parse("-1.2.3.4") }))
            require(reject(() => { IpAddresses.parse("+1.2.3.4") }))
            require(reject(() => { IpAddresses.parse("0x7f.0.0.1") }))
            require(reject(() => { IpAddresses.parse("0300.0.0.1") }))

            // No whitespace, Unicode-digit substitution, or hostname interpretation.
            require(reject(() => { IpAddresses.parse(" 1.2.3.4") }))
            require(reject(() => { IpAddresses.parse("1.2.3.4 ") }))
            require(reject(() => { IpAddresses.parse("١.2.3.4") }))
            require(reject(() => { IpAddresses.parse("example.com") }))

            // Exact String receiver domain.
            require(reject(() => { IpAddresses.parse(1234) }))
            require(reject(() => { IpAddresses.parse({}) }))
            require(reject(() => { IpAddresses.parse(null) }))

            require(reject(() => { IpAddresses.format({}) }))
            require(reject(() => { IpAddresses.format(1234) }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("ipv6 invalid", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            require(reject(() => { IpAddresses.parse(":::") }))
            require(reject(() => { IpAddresses.parse("1::2::3") }))
            require(reject(() => { IpAddresses.parse("1:2:3:4:5:6:7:8:9") }))
            require(reject(() => { IpAddresses.parse("1:2:3:4:5:6:7") }))
            require(reject(() => { IpAddresses.parse("1:2:3:4:5:6:7:8::") }))
            require(reject(() => { IpAddresses.parse("12345::") }))
            require(reject(() => { IpAddresses.parse("gggg::1") }))
            require(reject(() => { IpAddresses.parse(":1:2:3:4:5:6:7") }))
            require(reject(() => { IpAddresses.parse("1:2:3:4:5:6:7:") }))

            // Embedded dotted-decimal tail must itself be strict IPv4 and final.
            require(reject(() => { IpAddresses.parse("::ffff:192.0.2.256") }))
            require(reject(() => { IpAddresses.parse("::ffff:192.168.001.1") }))
            require(reject(() => { IpAddresses.parse("1.2.3.4::") }))
            require(reject(() => { IpAddresses.parse("::ffff:192.0.2.1:5") }))

            // Scope, brackets, whitespace and non-ASCII hexadecimal substitutes are not
            // numeric IpAddress syntax in LIB005.
            require(reject(() => { IpAddresses.parse("fe80::1%3") }))
            require(reject(() => { IpAddresses.parse("fe80::1%eth0") }))
            require(reject(() => { IpAddresses.parse("[::1]") }))
            require(reject(() => { IpAddresses.parse(" ::1") }))
            require(reject(() => { IpAddresses.parse("::1 ") }))
            require(reject(() => { IpAddresses.parse("２００１:db8::1") }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("arity rejection", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            require(reject(() => { IpAddresses.v4(1, 2, 3) }))
            require(reject(() => { IpAddresses.v4(1, 2, 3, 4, 5) }))
            require(reject(() => { IpAddresses.v6(1, 2, 3, 4, 5, 6, 7) }))
            require(reject(() => { IpAddresses.v6(1, 2, 3, 4, 5, 6, 7, 8, 9) }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("domain rejection", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            require(reject(() => { IpAddresses.v4(-1, 0, 0, 0) }))
            require(reject(() => { IpAddresses.v4(0, 256, 0, 0) }))
            require(reject(() => { IpAddresses.v4(0, 0, -1, 0) }))
            require(reject(() => { IpAddresses.v4(0, 0, 0, 256) }))
            require(reject(() => { IpAddresses.v4(1.0, 0, 0, 0) }))

            // This is a known-valid delegated numeric lookalike shape in Core conformance:
            // the object delegates to the ordinary Integer value 1, whose parent is Integer.
            // Lookup can therefore find Integer protocol, but strict receiver validation
            // must reject the object itself as not being an actual Integer value.
            delegatedIntegerLookalike: (1) {}
            require(reject(() => {
                IpAddresses.v4(delegatedIntegerLookalike, 0, 0, 0)
            }))

            require(reject(() => {
                IpAddresses.v6(-1, 0, 0, 0, 0, 0, 0, 0)
            }))
            require(reject(() => {
                IpAddresses.v6(0, 65536, 0, 0, 0, 0, 0, 0)
            }))
            require(reject(() => {
                IpAddresses.v6(1.0, 0, 0, 0, 0, 0, 0, 0)
            }))

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
