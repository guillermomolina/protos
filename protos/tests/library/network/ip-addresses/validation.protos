Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("ipv4 invalid", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            // Shape/cardinality.
            Assertions.signals(Error, () => { IpAddresses.parse("") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3") })
            Assertions.signals(Error, () => { IpAddresses.parse("127.1") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3.4.5") })
            Assertions.signals(Error, () => { IpAddresses.parse(".1.2.3") })
            Assertions.signals(Error, () => { IpAddresses.parse("1..2.3") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3.") })

            // Strict decimal spelling and range.
            Assertions.signals(Error, () => { IpAddresses.parse("01.2.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.02.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.003.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("256.0.0.1") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3.999") })
            Assertions.signals(Error, () => { IpAddresses.parse("-1.2.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("+1.2.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("0x7f.0.0.1") })
            Assertions.signals(Error, () => { IpAddresses.parse("0300.0.0.1") })

            // No whitespace, Unicode-digit substitution, or hostname interpretation.
            Assertions.signals(Error, () => { IpAddresses.parse(" 1.2.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3.4 ") })
            Assertions.signals(Error, () => { IpAddresses.parse("١.2.3.4") })
            Assertions.signals(Error, () => { IpAddresses.parse("example.com") })

            // Exact String receiver domain.
            Assertions.signals(Error, () => { IpAddresses.parse(1234) })
            Assertions.signals(Error, () => { IpAddresses.parse({}) })
            Assertions.signals(Error, () => { IpAddresses.parse(null) })

            Assertions.signals(Error, () => { IpAddresses.format({}) })
            Assertions.signals(Error, () => { IpAddresses.format(1234) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("ipv6 invalid", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            Assertions.signals(Error, () => { IpAddresses.parse(":::") })
            Assertions.signals(Error, () => { IpAddresses.parse("1::2::3") })
            Assertions.signals(Error, () => { IpAddresses.parse("1:2:3:4:5:6:7:8:9") })
            Assertions.signals(Error, () => { IpAddresses.parse("1:2:3:4:5:6:7") })
            Assertions.signals(Error, () => { IpAddresses.parse("1:2:3:4:5:6:7:8::") })
            Assertions.signals(Error, () => { IpAddresses.parse("12345::") })
            Assertions.signals(Error, () => { IpAddresses.parse("gggg::1") })
            Assertions.signals(Error, () => { IpAddresses.parse(":1:2:3:4:5:6:7") })
            Assertions.signals(Error, () => { IpAddresses.parse("1:2:3:4:5:6:7:") })

            // Embedded dotted-decimal tail must itself be strict IPv4 and final.
            Assertions.signals(Error, () => { IpAddresses.parse("::ffff:192.0.2.256") })
            Assertions.signals(Error, () => { IpAddresses.parse("::ffff:192.168.001.1") })
            Assertions.signals(Error, () => { IpAddresses.parse("1.2.3.4::") })
            Assertions.signals(Error, () => { IpAddresses.parse("::ffff:192.0.2.1:5") })

            // Scope, brackets, whitespace and non-ASCII hexadecimal substitutes are not
            // numeric IpAddress syntax in LIB005.
            Assertions.signals(Error, () => { IpAddresses.parse("fe80::1%3") })
            Assertions.signals(Error, () => { IpAddresses.parse("fe80::1%eth0") })
            Assertions.signals(Error, () => { IpAddresses.parse("[::1]") })
            Assertions.signals(Error, () => { IpAddresses.parse(" ::1") })
            Assertions.signals(Error, () => { IpAddresses.parse("::1 ") })
            Assertions.signals(Error, () => { IpAddresses.parse("２００１:db8::1") })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("arity rejection", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            Assertions.signals(Error, () => { IpAddresses.v4(1, 2, 3) })
            Assertions.signals(Error, () => { IpAddresses.v4(1, 2, 3, 4, 5) })
            Assertions.signals(Error, () => { IpAddresses.v6(1, 2, 3, 4, 5, 6, 7) })
            Assertions.signals(Error, () => { IpAddresses.v6(1, 2, 3, 4, 5, 6, 7, 8, 9) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("domain rejection", () => {
        tool009LegacyCase: () => {
            IpAddresses: import("std:network/IpAddresses")

            Assertions.signals(Error, () => { IpAddresses.v4(-1, 0, 0, 0) })
            Assertions.signals(Error, () => { IpAddresses.v4(0, 256, 0, 0) })
            Assertions.signals(Error, () => { IpAddresses.v4(0, 0, -1, 0) })
            Assertions.signals(Error, () => { IpAddresses.v4(0, 0, 0, 256) })
            Assertions.signals(Error, () => { IpAddresses.v4(1.0, 0, 0, 0) })

            // This is a known-valid delegated numeric lookalike shape in Core conformance:
            // the object delegates to the ordinary Integer value 1, whose parent is Integer.
            // Lookup can therefore find Integer protocol, but strict receiver validation
            // must reject the object itself as not being an actual Integer value.
            delegatedIntegerLookalike: (1) {}
            Assertions.signals(Error, () => {
                IpAddresses.v4(delegatedIntegerLookalike, 0, 0, 0)
            })

            Assertions.signals(Error, () => {
                IpAddresses.v6(-1, 0, 0, 0, 0, 0, 0, 0)
            })
            Assertions.signals(Error, () => {
                IpAddresses.v6(0, 65536, 0, 0, 0, 0, 0, 0)
            })
            Assertions.signals(Error, () => {
                IpAddresses.v6(1.0, 0, 0, 0, 0, 0, 0, 0)
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("octet construction rejects lookalike and out of range components", () => {
        IpAddresses: import("std:network/IpAddresses")

        Assertions.signals(Error, () => {
            IpAddresses.v4(0, 0, 0, 256)
        })
        Assertions.signals(Error, () => {
            IpAddresses.v4(0, 0, 0, 1.0)
        })
        Assertions.signals(Error, () => {
            IpAddresses.v6(0, 0, 0, 0, 0, 0, 0, (1) {})
        })
        Assertions.signals(Error, () => {
            IpAddresses.v6(0, 0, 0, 0, 0, 0, 0, -1)
        })
        Assertions.signals(Error, () => {
            IpAddresses.format((IpAddresses.IpAddress) {
                version: 4
                bits: 1
            })
        })

        Assertions.require(IpAddresses.v4(255, 255, 255, 255).bits == 4294967295)
        Assertions.require(IpAddresses.v6(0, 0, 0, 0, 0, 0, 0, 65535).bits == 65535)
    })
]
tests.freeze()
