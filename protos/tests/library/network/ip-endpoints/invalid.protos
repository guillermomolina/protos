IpEndpoints: import("std:network/IpEndpoints")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

// Missing/extra outer syntax.
require(reject(() => { IpEndpoints.parse("") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1") }))
require(reject(() => { IpEndpoints.parse(":443") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1::443") }))
require(reject(() => { IpEndpoints.parse("[::1]443") }))
require(reject(() => { IpEndpoints.parse("[::1]::443") }))
require(reject(() => { IpEndpoints.parse("[::1]:443:5") }))
require(reject(() => { IpEndpoints.parse("[::1") }))

// Address-family envelope rules.
require(reject(() => { IpEndpoints.parse("2001:db8::1:443") }))
require(reject(() => { IpEndpoints.parse("::ffff:192.0.2.1:443") }))
require(reject(() => { IpEndpoints.parse("[192.0.2.1]:443") }))
require(reject(() => { IpEndpoints.parse("[fe80::1%3]:443") }))

// Numeric-only address and port surface.
require(reject(() => { IpEndpoints.parse("example.com:443") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:https") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:0") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:00000") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:65536") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:+443") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:-1") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1: 443") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:443 ") }))
require(reject(() => { IpEndpoints.parse("192.0.2.1:４４３") }))

// Wrong input/formatter families.
require(reject(() => { IpEndpoints.parse(443) }))
require(reject(() => { IpEndpoints.parse({}) }))
require(reject(() => { IpEndpoints.format({}) }))
require(reject(() => { IpEndpoints.format(IpAddress(4, 0)) }))
require(reject(() => { IpEndpoints.format(443) }))

true
