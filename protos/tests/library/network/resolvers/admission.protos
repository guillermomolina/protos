// D223-A1 (NETWORK.md §14.3–14.4): lookupAddresses answers a failed Future,
// never a synchronous signal, for every non-capability receiver and every
// invalid call. The authority-free prototype and its ordinary descendants
// reach no host operation even for admissible names. Admission against a real
// capability is covered by ProtosResolverAuthorityTest.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Resolvers: import("std:network/Resolvers")
Resolver: Resolvers.Resolver
ResolutionError: Resolvers.ResolutionError

// The Error of a failed Future, or null when it did not fail.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

invalid: (future) => {
    failure: failureOf(future)
    (failure !== null) && (failure.parent() === InvalidIOArgument)
}

tests: Array(
    Test("the authority-free prototype rejects admissible and inadmissible names alike", () => {
        Assertions.require(invalid(Resolver.lookupAddresses("example.com")))
        Assertions.require(invalid(Resolver.lookupAddresses("localhost")))
        Assertions.require(invalid(Resolver.lookupAddresses("a..b")))
        Assertions.require(invalid(Resolver.lookupAddresses("127.0.0.1")))
        Assertions.require(invalid(Resolver.lookupAddresses("bücher.example")))
    }),
    Test("descendants of Resolver carry no authority", () => {
        impostor: Resolver {}
        Assertions.require(invalid(impostor.lookupAddresses("example.com")))
        Assertions.require(invalid(impostor.close()))
    }),
    Test("arity and argument family failures are failed Futures", () => {
        Assertions.require(invalid(Resolver.lookupAddresses()))
        Assertions.require(invalid(Resolver.lookupAddresses(42)))
        Assertions.require(invalid(Resolver.lookupAddresses(null)))
        Assertions.require(invalid(Resolver.lookupAddresses("a.com", "b.com")))
    }),
    Test("the Resolver one-label rule is not the TLS two-label rule", () => {
        DnsNames: import("std:network/internal/DnsNames")
        Identity: import("std:tls/internal/Identity")
        asciiOnly: {
            codePoint: (scalar) => {
                Error().signal()
            }
            isNfc: (scalars) => {
                Error().signal()
            }
        }
        Assertions.require(DnsNames.admit(asciiOnly, "LocalHost.", 1, false).text == "localhost")
        Assertions.require(Identity.reference(asciiOnly, "localhost") === null)
        Assertions.require(DnsNames.admit(asciiOnly, "*.example.com", 1, false) === null)
        Assertions.require(DnsNames.admit(asciiOnly, "*.example.com", 2, true) !== null)
        Assertions.require(DnsNames.numericLiteral("192.0.2.1"))
        Assertions.require(!DnsNames.numericLiteral("example.com"))
    })
)
tests.freeze()
