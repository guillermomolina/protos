// D223-A1 (NETWORK.md §14.6–14.7, 14.10): the data a lookup publishes is
// ordinary frozen IpAddress data that composes explicitly with numeric
// endpoints; ResolutionError occurrences carry only a kind.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Resolvers: import("std:network/Resolvers")
Resolver: Resolvers.Resolver
ResolutionError: Resolvers.ResolutionError

// The Error of a failed Future, or null when it did not fail.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

invalid: (future) => {
    failure: failureOf(future)
    (failure !== null) && (failure.parent() === InvalidIOArgument)
}

IpAddresses: import("std:network/IpAddresses")
IpEndpoint: import("std:network/IpEndpoints").IpEndpoint

tests: Array(
    Test("resolved address candidates compose explicitly into IpEndpoints", () => {
        candidates: Array(IpAddresses.parse("192.0.2.10"), IpAddresses.parse("2001:db8::1"))
        endpoint: IpEndpoint(candidates[0], 443)
        Assertions.require(endpoint.address == candidates[0])
        Assertions.require(endpoint.port == 443)
        Assertions.require(IpEndpoint(candidates[1], 443).address.version == 6)
    }),
    Test("Network offers no hostname connect", () => {
        Assertions.require(invalid(Network.connectTcp("example.com")))
    }),
    Test("each ResolutionError kind is a distinct fresh occurrence", () => {
        kinds: Array("noAddress", "unavailable", "denied", "limit")
        previous: null
        kinds.each((expected) => {
            occurrence: ResolutionError { kind: expected }
            Assertions.require(occurrence.parent() === ResolutionError)
            Assertions.require(occurrence.kind == expected)
            Assertions.require(occurrence !== previous)
            previous = occurrence
        })
        Assertions.require(previous.kind == "limit")
    })
)
tests.freeze()
