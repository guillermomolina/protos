// D223-A1 (NETWORK.md §14.1–14.2): the public surface of std:network/Resolvers
// without any host grant. The bootstrap-local resolver slot is absent here, so
// no name-service work can occur.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Resolvers: import("std:network/Resolvers")
Resolver: Resolvers.Resolver
ResolutionError: Resolvers.ResolutionError

// The Error of a failed Future, or null when it did not fail.
failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

invalid: (future) => {
    failure: failureOf(future)
    (failure !== null) && (failure.parent() === InvalidIOArgument)
}

tests: Array(
    Test("the module exports exactly Resolver and ResolutionError", () => {
        Assertions.require(Resolvers.slotNames().size() == 2)
        Assertions.require(Resolvers.hasSlot("Resolver"))
        Assertions.require(Resolvers.hasSlot("ResolutionError"))
        Assertions.require(Resolver.hasSlot("lookupAddresses"))
        Assertions.require(Resolver.hasSlot("close"))
        Assertions.require(Resolver.slotNames().size() == 2)
    }),
    Test("ResolutionError is an ordinary Error subtype, not a Prelude binding", () => {
        Assertions.require(ResolutionError.parent() === Error)
        Assertions.require(!context.hasSlot("ResolutionError"))
        Assertions.require(!context.hasSlot("Resolver"))
        occurrence: Assertions.signals(ResolutionError, () => {
            (ResolutionError { kind: "noAddress" }).signal()
        })
        Assertions.require(occurrence.kind == "noAddress")
    }),
    Test("importing the module installs no resolver authority", () => {
        Assertions.require(!context.hasSlot("resolver"))
        again: import("std:network/Resolvers")
        Assertions.require(again.Resolver === Resolver)
        Assertions.require(!context.hasSlot("resolver"))
    })
)
tests.freeze()
