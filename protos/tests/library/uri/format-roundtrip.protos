Uri: import("std:uri")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

roundTrip: (text) => {
    require(Uri.format(Uri.parse(text)) == text)
}

roundTrip("")
roundTrip("HTTP://user@example.com:080/a/b?x=%2f#Frag")
roundTrip("mailto:John.Doe@example.com")
roundTrip("urn:example:animal:ferret:nose")
roundTrip("//host:/a?x=#")
roundTrip("//@host/")
roundTrip("scheme:///path")
roundTrip("/a/b")
roundTrip("../g")
roundTrip("?q")
roundTrip("#frag")
roundTrip("http://[2001:db8::1]:80/a")
roundTrip("x://[vF.fe80::a]:123/p?q/r?s#f/g?h")
roundTrip("scheme:path?")
roundTrip("scheme:path#")

true
