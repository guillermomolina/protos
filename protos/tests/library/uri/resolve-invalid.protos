Uri: import("std:uri")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

base: Uri.parse("http://a/b/c")
reference: Uri.parse("g")

require(reject(() => { Uri.resolve() }))
require(reject(() => { Uri.resolve(base) }))
require(reject(() => { Uri.resolve(base, reference, reference) }))
require(reject(() => { Uri.resolve("http://a/", reference) }))
require(reject(() => { Uri.resolve(base, "g") }))

// Base must be RFC absolute-URI: scheme present and fragment absent.
require(reject(() => { Uri.resolve(Uri.parse("/a/b"), reference) }))
require(reject(() => { Uri.resolve(Uri.parse("http://a/b#frag"), reference) }))

badBase: {
    scheme: "http"
    userInfo: null
    host: "a"
    port: null
    path: "/bad path"
    query: null
    fragment: null
}
require(reject(() => { Uri.resolve(badBase, reference) }))

badReference: {
    scheme: null
    userInfo: null
    host: null
    port: null
    path: 1
    query: null
    fragment: null
}
require(reject(() => { Uri.resolve(base, badReference) }))

orphanAuthority: {
    scheme: null
    userInfo: "user"
    host: null
    port: null
    path: "g"
    query: null
    fragment: null
}
require(reject(() => { Uri.resolve(base, orphanAuthority) }))

true
