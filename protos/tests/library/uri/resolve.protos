Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("resolve boundaries", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            preservedBase: Uri.parse("HTTP://User@Example.COM:080/a/b/c?q=%2f")
            preserved: Uri.resolve(preservedBase, Uri.parse("../%2E/x?y=%2f#Frag"))
            Assertions.require(Uri.format(preserved) == "HTTP://User@Example.COM:080/a/%2E/x?y=%2f#Frag")

            // Authority + empty base path uses the RFC merge special case.
            Assertions.require(Uri.format(Uri.resolve(Uri.parse("http://a"), Uri.parse("g"))) == "http://a/g")

            // Rootless absolute-URI bases remain valid bases.
            Assertions.require(Uri.format(Uri.resolve(Uri.parse("urn:a/b/c"), Uri.parse("../d"))) == "urn:a/d")

            // A network-path reference replaces authority while inheriting the base scheme.
            Assertions.require(Uri.format(Uri.resolve(Uri.parse("http://a/b/c"), Uri.parse("//B/x"))) == "http://B/x")

            // Empty query presence replaces an inherited query; a fragment-only reference
            // keeps the base query.
            Assertions.require(Uri.format(Uri.resolve(Uri.parse("http://a/b/c?old"), Uri.parse("?"))) == "http://a/b/c?")
            Assertions.require(Uri.format(Uri.resolve(Uri.parse("http://a/b/c?old"), Uri.parse("#f"))) == "http://a/b/c?old#f")

            // Resolution publishes fresh frozen ordinary data.
            base: Uri.parse("http://a/b/c/d;p?q")
            reference: Uri.parse("../g#f")
            first: Uri.resolve(base, reference)
            second: Uri.resolve(base, reference)
            Assertions.require(first !== second)
            Assertions.require(first.parent() === Object)
            Assertions.require(first.freeze() === first)

            names: first.slotNames()
            Assertions.require(names.size() == 7)
            Assertions.require(names[0] == "fragment")
            Assertions.require(names[1] == "host")
            Assertions.require(names[2] == "path")
            Assertions.require(names[3] == "port")
            Assertions.require(names[4] == "query")
            Assertions.require(names[5] == "scheme")
            Assertions.require(names[6] == "userInfo")

            Assertions.signals(Error, () => { first.path = "/changed" })
            Assertions.signals(Error, () => { first.extra: "value" })
            Assertions.require(Uri.format(first) == "http://a/b/g#f")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("resolve invalid", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            base: Uri.parse("http://a/b/c")
            reference: Uri.parse("g")

            Assertions.signals(Error, () => { Uri.resolve() })
            Assertions.signals(Error, () => { Uri.resolve(base) })
            Assertions.signals(Error, () => { Uri.resolve(base, reference, reference) })
            Assertions.signals(Error, () => { Uri.resolve("http://a/", reference) })
            Assertions.signals(Error, () => { Uri.resolve(base, "g") })

            // Base must be RFC absolute-URI: scheme present and fragment absent.
            Assertions.signals(Error, () => { Uri.resolve(Uri.parse("/a/b"), reference) })
            Assertions.signals(Error, () => { Uri.resolve(Uri.parse("http://a/b#frag"), reference) })

            badBase: {
                scheme: "http"
                userInfo: null
                host: "a"
                port: null
                path: "/bad path"
                query: null
                fragment: null
            }
            Assertions.signals(Error, () => { Uri.resolve(badBase, reference) })

            badReference: {
                scheme: null
                userInfo: null
                host: null
                port: null
                path: 1
                query: null
                fragment: null
            }
            Assertions.signals(Error, () => { Uri.resolve(base, badReference) })

            orphanAuthority: {
                scheme: null
                userInfo: "user"
                host: null
                port: null
                path: "g"
                query: null
                fragment: null
            }
            Assertions.signals(Error, () => { Uri.resolve(base, orphanAuthority) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("resolve rfc3986 abnormal", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            base: Uri.parse("http://a/b/c/d;p?q")

            check: (reference, expected) => {
                actual: Uri.resolve(base, Uri.parse(reference))
                Assertions.require(Uri.format(actual) == expected)
            }

            check("../../../g", "http://a/g")
            check("../../../../g", "http://a/g")
            check("/./g", "http://a/g")
            check("/../g", "http://a/g")
            check("g.", "http://a/b/c/g.")
            check(".g", "http://a/b/c/.g")
            check("g..", "http://a/b/c/g..")
            check("..g", "http://a/b/c/..g")
            check("./../g", "http://a/b/g")
            check("./g/.", "http://a/b/c/g/")
            check("g/./h", "http://a/b/c/g/h")
            check("g/../h", "http://a/b/c/h")
            check("g;x=1/./y", "http://a/b/c/g;x=1/y")
            check("g;x=1/../y", "http://a/b/c/y")

            // Dot-looking syntax in query/fragment is data, not path structure.
            check("g?y/./x", "http://a/b/c/g?y/./x")
            check("g?y/../x", "http://a/b/c/g?y/../x")
            check("g#s/./x", "http://a/b/c/g#s/./x")
            check("g#s/../x", "http://a/b/c/g#s/../x")

            // Strict RFC 3986 resolution: an explicit same-spelled scheme is not demoted
            // to a relative reference.
            check("http:g", "http:g")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("resolve rfc3986 normal", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            base: Uri.parse("http://a/b/c/d;p?q")

            check: (reference, expected) => {
                actual: Uri.resolve(base, Uri.parse(reference))
                Assertions.require(Uri.format(actual) == expected)
            }

            check("g:h", "g:h")
            check("g", "http://a/b/c/g")
            check("./g", "http://a/b/c/g")
            check("g/", "http://a/b/c/g/")
            check("/g", "http://a/g")
            check("//g", "http://g")
            check("?y", "http://a/b/c/d;p?y")
            check("g?y", "http://a/b/c/g?y")
            check("#s", "http://a/b/c/d;p?q#s")
            check("g#s", "http://a/b/c/g#s")
            check("g?y#s", "http://a/b/c/g?y#s")
            check(";x", "http://a/b/c/;x")
            check("g;x", "http://a/b/c/g;x")
            check("g;x?y#s", "http://a/b/c/g;x?y#s")
            check("", "http://a/b/c/d;p?q")
            check(".", "http://a/b/c/")
            check("./", "http://a/b/c/")
            check("..", "http://a/b/")
            check("../", "http://a/b/")
            check("../g", "http://a/b/g")
            check("../..", "http://a/")
            check("../../", "http://a/")
            check("../../g", "http://a/g")

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
