Uri: import("std:uri")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

relative: {
    scheme: null
    userInfo: null
    host: null
    port: null
    path: "a/b"
    query: null
    fragment: null
}
require(Uri.format(relative) == "a/b")

authority: {
    scheme: "HTTP"
    userInfo: ""
    host: "Example.COM"
    port: ""
    path: "/%7e"
    query: ""
    fragment: "Frag"
}
require(Uri.format(authority) == "HTTP://@Example.COM:/%7e?#Frag")

allEmptyPresent: {
    scheme: "x"
    userInfo: ""
    host: ""
    port: ""
    path: ""
    query: ""
    fragment: ""
}
require(Uri.format(allEmptyPresent) == "x://@:?#")

literal: {
    scheme: null
    userInfo: null
    host: "[v1.fe80::a]"
    port: "00080"
    path: "/p"
    query: "q=%2f"
    fragment: null
}
require(Uri.format(literal) == "//[v1.fe80::a]:00080/p?q=%2f")

// format validates structural compatibility, not provenance from parse().
mutableCallerData: {
    scheme: "custom"
    userInfo: null
    host: null
    port: null
    path: "payload"
    query: null
    fragment: null
}
require(Uri.format(mutableCallerData) == "custom:payload")

true
