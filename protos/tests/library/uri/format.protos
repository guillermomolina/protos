Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("format constructed", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            relative: {
                scheme: null
                userInfo: null
                host: null
                port: null
                path: "a/b"
                query: null
                fragment: null
            }
            require(Uri.format(relative) == "a/b")

            authority: {
                scheme: "HTTP"
                userInfo: ""
                host: "Example.COM"
                port: ""
                path: "/%7e"
                query: ""
                fragment: "Frag"
            }
            require(Uri.format(authority) == "HTTP://@Example.COM:/%7e?#Frag")

            allEmptyPresent: {
                scheme: "x"
                userInfo: ""
                host: ""
                port: ""
                path: ""
                query: ""
                fragment: ""
            }
            require(Uri.format(allEmptyPresent) == "x://@:?#")

            literal: {
                scheme: null
                userInfo: null
                host: "[v1.fe80::a]"
                port: "00080"
                path: "/p"
                query: "q=%2f"
                fragment: null
            }
            require(Uri.format(literal) == "//[v1.fe80::a]:00080/p?q=%2f")

            // format validates structural compatibility, not provenance from parse().
            mutableCallerData: {
                scheme: "custom"
                userInfo: null
                host: null
                port: null
                path: "payload"
                query: null
                fragment: null
            }
            require(Uri.format(mutableCallerData) == "custom:payload")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("format invalid", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            validBase: () => {
                {
                    scheme: null
                    userInfo: null
                    host: null
                    port: null
                    path: "a/b"
                    query: null
                    fragment: null
                }
            }

            require(reject(() => { Uri.format() }))
            require(reject(() => { Uri.format(validBase(), validBase()) }))
            require(reject(() => { Uri.format("a/b") }))
            require(reject(() => { Uri.format(null) }))

            missingFragment: {
                scheme: null
                userInfo: null
                host: null
                port: null
                path: "a/b"
                query: null
            }
            require(reject(() => { Uri.format(missingFragment) }))

            badSchemeFamily: validBase()
            badSchemeFamily.scheme = 1
            require(reject(() => { Uri.format(badSchemeFamily) }))

            badPathFamily: validBase()
            badPathFamily.path = 1
            require(reject(() => { Uri.format(badPathFamily) }))

            orphanUserInfo: validBase()
            orphanUserInfo.userInfo = ""
            require(reject(() => { Uri.format(orphanUserInfo) }))

            orphanPort: validBase()
            orphanPort.port = ""
            require(reject(() => { Uri.format(orphanPort) }))

            badScheme: validBase()
            badScheme.scheme = "1bad"
            require(reject(() => { Uri.format(badScheme) }))

            relativeColon: validBase()
            relativeColon.path = "a:b"
            require(reject(() => { Uri.format(relativeColon) }))

            badHost: validBase()
            badHost.host = "exa mple"
            require(reject(() => { Uri.format(badHost) }))

            badLiteral: validBase()
            badLiteral.host = "[v1.]"
            require(reject(() => { Uri.format(badLiteral) }))

            badPort: validBase()
            badPort.host = "host"
            badPort.port = "80x"
            require(reject(() => { Uri.format(badPort) }))

            badPercent: validBase()
            badPercent.path = "/a%GG"
            require(reject(() => { Uri.format(badPercent) }))

            rawUnicode: validBase()
            rawUnicode.path = "/café"
            require(reject(() => { Uri.format(rawUnicode) }))

            rawBackslash: validBase()
            rawBackslash.path = "/a\\b"
            require(reject(() => { Uri.format(rawBackslash) }))

            queryDelimiter: validBase()
            queryDelimiter.query = "a#b"
            require(reject(() => { Uri.format(queryDelimiter) }))

            pathDelimiter: validBase()
            pathDelimiter.path = "/a?b"
            require(reject(() => { Uri.format(pathDelimiter) }))

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("format roundtrip", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            roundTrip: (text) => {
                require(Uri.format(Uri.parse(text)) == text)
            }

            roundTrip("")
            roundTrip("HTTP://user@example.com:080/a/b?x=%2f#Frag")
            roundTrip("mailto:John.Doe@example.com")
            roundTrip("urn:example:animal:ferret:nose")
            roundTrip("//host:/a?x=#")
            roundTrip("//@host/")
            roundTrip("scheme:///path")
            roundTrip("/a/b")
            roundTrip("../g")
            roundTrip("?q")
            roundTrip("#frag")
            roundTrip("http://[2001:db8::1]:80/a")
            roundTrip("x://[vF.fe80::a]:123/p?q/r?s#f/g?h")
            roundTrip("scheme:path?")
            roundTrip("scheme:path#")

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
