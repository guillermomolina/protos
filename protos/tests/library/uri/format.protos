Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("format constructed", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            relative: {
                scheme: null
                userInfo: null
                host: null
                port: null
                path: "a/b"
                query: null
                fragment: null
            }
            Assertions.require(Uri.format(relative) == "a/b")

            authority: {
                scheme: "HTTP"
                userInfo: ""
                host: "Example.COM"
                port: ""
                path: "/%7e"
                query: ""
                fragment: "Frag"
            }
            Assertions.require(Uri.format(authority) == "HTTP://@Example.COM:/%7e?#Frag")

            allEmptyPresent: {
                scheme: "x"
                userInfo: ""
                host: ""
                port: ""
                path: ""
                query: ""
                fragment: ""
            }
            Assertions.require(Uri.format(allEmptyPresent) == "x://@:?#")

            literal: {
                scheme: null
                userInfo: null
                host: "[v1.fe80::a]"
                port: "00080"
                path: "/p"
                query: "q=%2f"
                fragment: null
            }
            Assertions.require(Uri.format(literal) == "//[v1.fe80::a]:00080/p?q=%2f")

            // format validates structural compatibility, not provenance from parse().
            mutableCallerData: {
                scheme: "custom"
                userInfo: null
                host: null
                port: null
                path: "payload"
                query: null
                fragment: null
            }
            Assertions.require(Uri.format(mutableCallerData) == "custom:payload")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("format invalid", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            validBase: () => {
                {
                    scheme: null
                    userInfo: null
                    host: null
                    port: null
                    path: "a/b"
                    query: null
                    fragment: null
                }
            }

            Assertions.signals(Error, () => { Uri.format() })
            Assertions.signals(Error, () => { Uri.format(validBase(), validBase()) })
            Assertions.signals(Error, () => { Uri.format("a/b") })
            Assertions.signals(Error, () => { Uri.format(null) })

            missingFragment: {
                scheme: null
                userInfo: null
                host: null
                port: null
                path: "a/b"
                query: null
            }
            Assertions.signals(Error, () => { Uri.format(missingFragment) })

            badSchemeFamily: validBase()
            badSchemeFamily.scheme = 1
            Assertions.signals(Error, () => { Uri.format(badSchemeFamily) })

            badPathFamily: validBase()
            badPathFamily.path = 1
            Assertions.signals(Error, () => { Uri.format(badPathFamily) })

            orphanUserInfo: validBase()
            orphanUserInfo.userInfo = ""
            Assertions.signals(Error, () => { Uri.format(orphanUserInfo) })

            orphanPort: validBase()
            orphanPort.port = ""
            Assertions.signals(Error, () => { Uri.format(orphanPort) })

            badScheme: validBase()
            badScheme.scheme = "1bad"
            Assertions.signals(Error, () => { Uri.format(badScheme) })

            relativeColon: validBase()
            relativeColon.path = "a:b"
            Assertions.signals(Error, () => { Uri.format(relativeColon) })

            badHost: validBase()
            badHost.host = "exa mple"
            Assertions.signals(Error, () => { Uri.format(badHost) })

            badLiteral: validBase()
            badLiteral.host = "[v1.]"
            Assertions.signals(Error, () => { Uri.format(badLiteral) })

            badPort: validBase()
            badPort.host = "host"
            badPort.port = "80x"
            Assertions.signals(Error, () => { Uri.format(badPort) })

            badPercent: validBase()
            badPercent.path = "/a%GG"
            Assertions.signals(Error, () => { Uri.format(badPercent) })

            rawUnicode: validBase()
            rawUnicode.path = "/café"
            Assertions.signals(Error, () => { Uri.format(rawUnicode) })

            rawBackslash: validBase()
            rawBackslash.path = "/a\\b"
            Assertions.signals(Error, () => { Uri.format(rawBackslash) })

            queryDelimiter: validBase()
            queryDelimiter.query = "a#b"
            Assertions.signals(Error, () => { Uri.format(queryDelimiter) })

            pathDelimiter: validBase()
            pathDelimiter.path = "/a?b"
            Assertions.signals(Error, () => { Uri.format(pathDelimiter) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("format roundtrip", () => {
        tool009LegacyCase: () => {
            Uri: import("std:uri")

            roundTrip: (text) => {
                Assertions.require(Uri.format(Uri.parse(text)) == text)
            }

            roundTrip("")
            roundTrip("HTTP://user@example.com:080/a/b?x=%2f#Frag")
            roundTrip("mailto:John.Doe@example.com")
            roundTrip("urn:example:animal:ferret:nose")
            roundTrip("//host:/a?x=#")
            roundTrip("//@host/")
            roundTrip("scheme:///path")
            roundTrip("/a/b")
            roundTrip("../g")
            roundTrip("?q")
            roundTrip("#frag")
            roundTrip("http://[2001:db8::1]:80/a")
            roundTrip("x://[vF.fe80::a]:123/p?q/r?s#f/g?h")
            roundTrip("scheme:path?")
            roundTrip("scheme:path#")

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
