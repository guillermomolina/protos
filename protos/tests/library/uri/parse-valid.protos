Uri: import("std:uri")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

require(Uri.parse("mailto:John.Doe@example.com").scheme == "mailto")
require(Uri.parse("urn:oasis:names:specification:docbook:dtd:xml:4.1.2").path ==
    "oasis:names:specification:docbook:dtd:xml:4.1.2")

relative: Uri.parse("../a/b?c/d?e#f/g?h")
require(relative.scheme === null)
require(relative.userInfo === null)
require(relative.host === null)
require(relative.port === null)
require(relative.path == "../a/b")
require(relative.query == "c/d?e")
require(relative.fragment == "f/g?h")

require(Uri.parse("/a/b:c").path == "/a/b:c")
require(Uri.parse("a/b:c").path == "a/b:c")
require(Uri.parse("./a:b").path == "./a:b")
require(Uri.parse("a:b").scheme == "a")
require(Uri.parse("a:b").path == "b")

authority: Uri.parse("//user:pass@example.com:443/a")
require(authority.userInfo == "user:pass")
require(authority.host == "example.com")
require(authority.port == "443")
require(authority.path == "/a")

reserved: Uri.parse("scheme:/AZaz09-._~!$&'()*+,;=:@/%41")
require(reserved.path == "/AZaz09-._~!$&'()*+,;=:@/%41")

require(Uri.parse("file:///path").host == "")
require(Uri.parse("http://example.com:").port == "")
require(Uri.parse("http://@example.com").userInfo == "")
require(Uri.parse("http://999.999.999.999/").host == "999.999.999.999")

ipv6: Uri.parse("//[2001:db8::1]:443/path")
require(ipv6.host == "[2001:db8::1]")
require(ipv6.port == "443")
require(Uri.parse("//[::ffff:192.0.2.1]/").host == "[::ffff:192.0.2.1]")
require(Uri.parse("//[1:2:3:4:5:6:192.0.2.1]/").host ==
    "[1:2:3:4:5:6:192.0.2.1]")
require(Uri.parse("//[1:2:3:4:5::192.0.2.1]/").host ==
    "[1:2:3:4:5::192.0.2.1]")
require(Uri.parse("//[::]/").host == "[::]")

ipvFuture: Uri.parse("//[v1.fe80::abcd]/")
require(ipvFuture.host == "[v1.fe80::abcd]")
require(Uri.parse("//[VF.a:b]/").host == "[VF.a:b]")

percentCase: Uri.parse("X:/a%2fb%2F?q=%3a#%4A")
require(percentCase.scheme == "X")
require(percentCase.path == "/a%2fb%2F")
require(percentCase.query == "q=%3a")
require(percentCase.fragment == "%4A")

true
