// LIB024 (D214 C1/S1): std:math/LinearAlgebra construction, numeric admission and indexing.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
LA: import("std:math/LinearAlgebra")
Vector: LA.Vector
Matrix: LA.Matrix

tests: [
    Test("explicit import publishes frozen prototypes", () => {
        again: import("std:math/LinearAlgebra")
        Assertions.require(again.Vector === LA.Vector)
        Assertions.require(again.Matrix === LA.Matrix)
        Assertions.require(Vector(1).parent() === LA.Vector)
        Assertions.require(Matrix(1, 1, 1).parent() === LA.Matrix)
        Assertions.signals(Error, () => { LA.Vector.extra: 1 })
        Assertions.signals(Error, () => { LA.Matrix.extra: 1 })
    }),
    Test("vector construction keeps exactly the supplied elements", () => {
        Assertions.require(Vector().size() == 0)
        three: Vector(3)
        Assertions.require(three.size() == 1)
        Assertions.require(three.at(0) === 3)
        z: Complex(1, 2)
        big: 18446744073709551616
        mixed: Vector(1, big, 1 / 2, 2.5, z)
        Assertions.require(mixed.size() == 5)
        Assertions.require(mixed.at(1) === big)
        Assertions.require(mixed.at(2) === (1 / 2))
        Assertions.require(mixed.at(3) === 2.5)
        Assertions.require(mixed.at(4) === z)
        values: [4, 5, 6]
        spread: Vector(...values)
        Assertions.require(spread.size() == 3)
        Assertions.require(spread[2] === 6)
    }),
    Test("matrix construction is row-major with exact shapes", () => {
        m: Matrix(2, 3, 1, 2, 3, 4, 5, 6)
        Assertions.require(m.rows() == 2)
        Assertions.require(m.columns() == 3)
        Assertions.require(m.at(0, 2) === 3)
        Assertions.require(m.at(1, 0) === 4)
        Assertions.require(Matrix(2, 2, ...[1, 2, 3, 4]).at(1, 1) === 4)
        huge: 1267650600228229401496703205376
        Assertions.require(Matrix(0, 5).rows() == 0)
        Assertions.require(Matrix(0, 5).columns() == 5)
        Assertions.require(Matrix(5, 0).rows() == 5)
        Assertions.require(Matrix(5, 0).columns() == 0)
        Assertions.require(Matrix(huge, 0).rows() === huge)
        Assertions.require(Matrix(0, huge).columns() === huge)
    }),
    Test("construction rejects wrong counts dimensions and impostors", () => {
        Assertions.signals(Error, () => { Matrix() })
        Assertions.signals(Error, () => { Matrix(2) })
        Assertions.signals(Error, () => { Matrix(2, 2, 1, 2, 3) })
        Assertions.signals(Error, () => { Matrix(2, 2, 1, 2, 3, 4, 5) })
        Assertions.signals(Error, () => { Matrix(0, 0, 1) })
        Assertions.signals(Error, () => { Matrix(0 - 1, 0) })
        Assertions.signals(Error, () => { Matrix(1.0, 1, 1) })
        Assertions.signals(Error, () => { Matrix(1 / 2, 1, 1) })
        Assertions.signals(Error, () => { Matrix("1", 1, 1) })
        Assertions.signals(Error, () => { Vector(null) })
        Assertions.signals(Error, () => { Vector(true) })
        Assertions.signals(Error, () => { Vector("1") })
        Assertions.signals(Error, () => { Vector(Object {}) })
        Assertions.signals(Error, () => { Vector(Number {}) })
        Assertions.signals(Error, () => { Vector(Integer {}) })
        Assertions.signals(Error, () => { Vector(1, Vector(1)) })
        Assertions.signals(Error, () => { Matrix(1, 1, Float {}) })
    }),
    Test("indexes are exact in-range Integers", () => {
        v: Vector(10, 20, 30)
        m: Matrix(2, 2, 1, 2, 3, 4)
        Assertions.require(v.at(1) === 20)
        Assertions.require(v[1] === 20)
        bad: [0 - 1, 3, 1.0, 1 / 2, 18446744073709551617, "0", null]
        bad.each((index) => {
            Assertions.signals(Error, () => { v.at(index) })
            Assertions.signals(Error, () => { v[index] })
            Assertions.signals(Error, () => { v.atPut(index, 0) })
            Assertions.signals(Error, () => { m.at(index, 0) })
            Assertions.signals(Error, () => { m.at(0, index) })
            Assertions.signals(Error, () => { m.atPut(index, 0, 0) })
        })
        Assertions.signals(Error, () => { m.at(2, 0) })
        Assertions.signals(Error, () => { m.at(0, 2) })
        // m[row] lowers to at(row), which Matrix rejects; m[row, column] is not syntax.
        Assertions.signals(Error, () => { m[0] })
        Assertions.signals(Error, () => { v.at() })
        Assertions.signals(Error, () => { v.size(1) })
        Assertions.require(v.at(0) === 10)
        Assertions.require(m.at(1, 1) === 4)
    }),
    Test("atPut validates frozen then bounds then value atomically", () => {
        v: Vector(1, 2)
        m: Matrix(1, 2, 1, 2)
        Assertions.signals(Error, () => { v.atPut(5, "x") })
        Assertions.signals(Error, () => { v.atPut(0, "x") })
        Assertions.signals(Error, () => { v.atPut(0, Number {}) })
        Assertions.signals(Error, () => { m.atPut(1, 0, "x") })
        Assertions.signals(Error, () => { m.atPut(0, 0, Integer {}) })
        Assertions.require(v.at(0) === 1)
        Assertions.require(m.at(0, 0) === 1)

        v.close()
        m.close()
        half: 1 / 2
        Assertions.require(v.atPut(1, half) === half)
        Assertions.require(m.atPut(0, 1, half) === half)
        Assertions.require(v.at(1) === half)
        Assertions.require(m.at(0, 1) === half)
        Assertions.require(v.size() == 2)

        v.freeze()
        m.freeze()
        Assertions.signals(Error, () => { v.atPut(9, "x") })
        Assertions.signals(Error, () => { v.atPut(0, 7) })
        Assertions.signals(Error, () => { m.atPut(9, 9, "x") })
        Assertions.signals(Error, () => { m.atPut(0, 0, 7) })
        Assertions.require(v.at(0) === 1)
        Assertions.require(m.at(0, 0) === 1)
    })
]
tests.freeze()
