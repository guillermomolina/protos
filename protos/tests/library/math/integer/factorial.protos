IntegerMath: import("std:math/Integer")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

require(IntegerMath.factorial(0) == 1)
require(IntegerMath.factorial(1) == 1)
require(IntegerMath.factorial(2) == 2)
require(IntegerMath.factorial(5) == 120)
require(IntegerMath.factorial(10) == 3628800)
require(IntegerMath.factorial(21) == 51090942171709440000)
require(IntegerMath.factorial(100) == 93326215443944152681699238856266700490715968264381621468592963895217599993229915608941463976156518286253697920827223758251185210916864000000000000000000000000)

true
