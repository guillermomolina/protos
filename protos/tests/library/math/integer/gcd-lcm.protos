Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("gcd lcm", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            Assertions.require(IntegerMath.gcd(0, 0) == 0)
            Assertions.require(IntegerMath.gcd(0, 42) == 42)
            Assertions.require(IntegerMath.gcd(42, 0) == 42)
            Assertions.require(IntegerMath.gcd(54, 24) == 6)
            Assertions.require(IntegerMath.gcd(-54, 24) == 6)
            Assertions.require(IntegerMath.gcd(54, -24) == 6)
            Assertions.require(IntegerMath.gcd(-54, -24) == 6)
            Assertions.require(IntegerMath.gcd(17, 13) == 1)

            Assertions.require(IntegerMath.lcm(0, 0) == 0)
            Assertions.require(IntegerMath.lcm(0, 42) == 0)
            Assertions.require(IntegerMath.lcm(42, 0) == 0)
            Assertions.require(IntegerMath.lcm(21, 6) == 42)
            Assertions.require(IntegerMath.lcm(-21, 6) == 42)
            Assertions.require(IntegerMath.lcm(21, -6) == 42)
            Assertions.require(IntegerMath.lcm(-21, -6) == 42)
            Assertions.require(IntegerMath.lcm(17, 13) == 221)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("arity rejection", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            Assertions.signals(Error, () => { IntegerMath.gcd() })
            Assertions.signals(Error, () => { IntegerMath.gcd(1) })
            Assertions.signals(Error, () => { IntegerMath.gcd(1, 2, 3) })

            Assertions.signals(Error, () => { IntegerMath.lcm() })
            Assertions.signals(Error, () => { IntegerMath.lcm(1) })
            Assertions.signals(Error, () => { IntegerMath.lcm(1, 2, 3) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("domain rejection", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            delegatedIntegerLookalike: (1) {}

            Assertions.signals(Error, () => { IntegerMath.gcd(6.0, 9) })
            Assertions.signals(Error, () => { IntegerMath.gcd("6", 9) })
            Assertions.signals(Error, () => { IntegerMath.gcd(delegatedIntegerLookalike, 9) })

            Assertions.signals(Error, () => { IntegerMath.lcm(6.0, 9) })
            Assertions.signals(Error, () => { IntegerMath.lcm(6, null) })
            Assertions.signals(Error, () => { IntegerMath.lcm(delegatedIntegerLookalike, 9) })

            // Both arguments remain part of the domain even when one mathematical value is zero.

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("large values", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            // 2^80, well beyond every signed/unsigned 64-bit range.
            unit: 1208925819614629174706176
            fifteenUnits: 18133887294219437620592640
            twentyOneUnits: 25387442211907212668829696
            threeUnits: 3626777458843887524118528
            oneHundredFiveUnits: 126937211059536063344148480

            Assertions.require(IntegerMath.gcd(fifteenUnits, twentyOneUnits) == threeUnits)
            Assertions.require(IntegerMath.gcd(0 - fifteenUnits, twentyOneUnits) == threeUnits)
            Assertions.require(IntegerMath.lcm(fifteenUnits, twentyOneUnits) == oneHundredFiveUnits)
            Assertions.require(IntegerMath.lcm(0 - fifteenUnits, twentyOneUnits) == oneHundredFiveUnits)

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
