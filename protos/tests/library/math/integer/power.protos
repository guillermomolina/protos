IntegerMath: import("std:math/Integer")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

require(IntegerMath.pow(0, 0) == 1)
require(IntegerMath.pow(0, 5) == 0)
require(IntegerMath.pow(2, 0) == 1)
require(IntegerMath.pow(2, 10) == 1024)
require(IntegerMath.pow(-2, 3) == -8)
require(IntegerMath.pow(-2, 4) == 16)
require(IntegerMath.pow(2, 100) == 1267650600228229401496703205376)

require(IntegerMath.powMod(0, 0, 1) == 0)
require(IntegerMath.powMod(0, 0, 7) == 1)
require(IntegerMath.powMod(0, 5, 7) == 0)
require(IntegerMath.powMod(2, 10, 1000) == 24)
require(IntegerMath.powMod(-2, 3, 5) == 2)
require(IntegerMath.powMod(-2, 4, 5) == 1)
require(IntegerMath.powMod(123456789, 1234567, 1000000007) == 365593914)
require(IntegerMath.powMod(-123456789, 1234567, 1000000007) == 634406093)

true
