Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("power", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            Assertions.require(IntegerMath.pow(0, 0) == 1)
            Assertions.require(IntegerMath.pow(0, 5) == 0)
            Assertions.require(IntegerMath.pow(2, 0) == 1)
            Assertions.require(IntegerMath.pow(2, 10) == 1024)
            Assertions.require(IntegerMath.pow(-2, 3) == -8)
            Assertions.require(IntegerMath.pow(-2, 4) == 16)
            Assertions.require(IntegerMath.pow(2, 100) == 1267650600228229401496703205376)

            Assertions.require(IntegerMath.powMod(0, 0, 1) == 0)
            Assertions.require(IntegerMath.powMod(0, 0, 7) == 1)
            Assertions.require(IntegerMath.powMod(0, 5, 7) == 0)
            Assertions.require(IntegerMath.powMod(2, 10, 1000) == 24)
            Assertions.require(IntegerMath.powMod(-2, 3, 5) == 2)
            Assertions.require(IntegerMath.powMod(-2, 4, 5) == 1)
            Assertions.require(IntegerMath.powMod(123456789, 1234567, 1000000007) == 365593914)
            Assertions.require(IntegerMath.powMod(-123456789, 1234567, 1000000007) == 634406093)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("power domain rejection", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            delegatedIntegerLookalike: (2) {}

            Assertions.signals(Error, () => { IntegerMath.pow(2.0, 3) })
            Assertions.signals(Error, () => { IntegerMath.pow(2, 3.0) })
            Assertions.signals(Error, () => { IntegerMath.pow(delegatedIntegerLookalike, 3) })
            Assertions.signals(Error, () => { IntegerMath.pow(2, delegatedIntegerLookalike) })
            Assertions.signals(Error, () => { IntegerMath.pow(2, -1) })

            Assertions.signals(Error, () => { IntegerMath.powMod(2.0, 3, 5) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3.0, 5) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3, 5.0) })
            Assertions.signals(Error, () => { IntegerMath.powMod(delegatedIntegerLookalike, 3, 5) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, delegatedIntegerLookalike, 5) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3, delegatedIntegerLookalike) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, -1, 5) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3, 0) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3, -5) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("power arity rejection", () => {
        tool009LegacyCase: () => {
            IntegerMath: import("std:math/Integer")

            Assertions.signals(Error, () => { IntegerMath.pow() })
            Assertions.signals(Error, () => { IntegerMath.pow(2) })
            Assertions.signals(Error, () => { IntegerMath.pow(2, 3, 4) })

            Assertions.signals(Error, () => { IntegerMath.powMod() })
            Assertions.signals(Error, () => { IntegerMath.powMod(2) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3) })
            Assertions.signals(Error, () => { IntegerMath.powMod(2, 3, 5, 7) })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
