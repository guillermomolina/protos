IntegerMath: import("std:math/Integer")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

require(reject(() => { IntegerMath.pow() }))
require(reject(() => { IntegerMath.pow(2) }))
require(reject(() => { IntegerMath.pow(2, 3, 4) }))

require(reject(() => { IntegerMath.powMod() }))
require(reject(() => { IntegerMath.powMod(2) }))
require(reject(() => { IntegerMath.powMod(2, 3) }))
require(reject(() => { IntegerMath.powMod(2, 3, 5, 7) }))

true
