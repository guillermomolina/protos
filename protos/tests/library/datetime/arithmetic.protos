Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Date: import("std:datetime/Date")
Time: import("std:datetime/Time")
LocalDateTime: import("std:datetime/LocalDateTime")
Period: import("std:datetime/Period")
Duration: import("std:datetime/Duration")

// Requires that applying `period` to `start` reaches `expected`, and that
// subtracting the negated period reaches it too.
requireAdd: (start, period, expected) => {
    Assertions.require(Period.addToDate(period, start) == expected)
    Assertions.require(Period.subtractFromDate(Period.negate(period), start) == expected)
    true
}

rejectsAdd: (start, period) => {
    Assertions.signals(Error, () => {
        Period.addToDate(period, start)
    })
    true
}

tests: [
    Test("month and year application clamps to the end of the month", () => {
        requireAdd(Date(2025, 1, 31), Period(0, 1, 0), Date(2025, 2, 28))
        requireAdd(Date(2024, 1, 31), Period(0, 1, 0), Date(2024, 2, 29))
        requireAdd(Date(2024, 2, 29), Period(1, 0, 0), Date(2025, 2, 28))
        requireAdd(Date(2024, 2, 29), Period(4, 0, 0), Date(2028, 2, 29))
        requireAdd(Date(2024, 3, 31), Period(0, -1, 0), Date(2024, 2, 29))
        Assertions.require(Period.subtractFromDate(Period(0, 1, 0), Date(2024, 3, 31)) == Date(2024, 2, 29))
        requireAdd(Date(2025, 3, 31), Period(0, 1, 0), Date(2025, 4, 30))
        requireAdd(Date(2025, 5, 31), Period(0, -1, 0), Date(2025, 4, 30))
        requireAdd(Date(2025, 4, 30), Period(0, 1, 0), Date(2025, 5, 30))
        requireAdd(Date(2025, 8, 31), Period(0, 1, 0), Date(2025, 9, 30))
        requireAdd(Date(2025, 6, 15), Period(0, 0, 0), Date(2025, 6, 15))
    }),
    Test("application crosses years and year zero", () => {
        requireAdd(Date(2024, 11, 30), Period(0, 3, 0), Date(2025, 2, 28))
        requireAdd(Date(2025, 1, 15), Period(0, -1, 0), Date(2024, 12, 15))
        requireAdd(Date(2024, 12, 31), Period(0, 0, 1), Date(2025, 1, 1))
        requireAdd(Date(2000, 1, 31), Period(0, 120, 0), Date(2010, 1, 31))
        requireAdd(Date(2000, 1, 31), Period(-5, 60, 0), Date(2000, 1, 31))
        requireAdd(Date(2000, 3, 15), Period(0, -27, 0), Date(1997, 12, 15))
        requireAdd(Date(1, 1, 15), Period(0, -1, 0), Date(0, 12, 15))
        requireAdd(Date(1, 3, 31), Period(-1, -1, 0), Date(0, 2, 29))
        requireAdd(Date(-1, 12, 31), Period(0, 0, 1), Date(0, 1, 1))
        requireAdd(Date(0, 2, 29), Period(-1, 0, 0), Date(-1, 2, 28))
        requireAdd(Date(0, 3, 1), Period(0, 0, -1), Date(0, 2, 29))
        requireAdd(Date(-1, 1, 1), Period(2, 0, 0), Date(1, 1, 1))
        requireAdd(Date(2000, 1, 1), Period(0, 0, 146097), Date(2400, 1, 1))
        requireAdd(Date(2000, 1, 1), Period(0, 0, -1), Date(1999, 12, 31))
        requireAdd(Date(2024, 1, 1), Period(0, 0, 366), Date(2025, 1, 1))
    }),
    Test("years and months combine before one clamp", () => {
        // Clamping after the year (2025-02-28) and again after the month would
        // reach 2025-03-28; the combined displacement never visits February.
        requireAdd(Date(2024, 2, 29), Period(1, 1, 0), Date(2025, 3, 29))
        requireAdd(Date(2024, 2, 29), Period(-1, 1, 0), Date(2023, 3, 29))
        Assertions.require(Period.addToDate(Period(0, 1, 0), Period.addToDate(Period(1, 0, 0), Date(2024, 2, 29))) ==
            Date(2025, 3, 28))
    }),
    Test("days apply after the clamp", () => {
        // Days first would reach 2025-01-31 and then clamp to 2025-02-28.
        requireAdd(Date(2025, 1, 30), Period(0, 1, 1), Date(2025, 3, 1))
        // Days first would reach 2024-03-30 and then 2024-02-29.
        requireAdd(Date(2024, 3, 31), Period(0, -1, -1), Date(2024, 2, 28))
        requireAdd(Date(2025, 1, 31), Period(0, 1, -28), Date(2025, 1, 31))
        requireAdd(Date(2024, 2, 29), Period(1, 0, 1), Date(2025, 3, 1))
    }),
    Test("repeated application may differ from one combined application", () => {
        start: Date(2025, 1, 31)
        month: Period(0, 1, 0)
        twice: Period.addToDate(month, Period.addToDate(month, start))
        once: Period.addToDate(Period(0, 2, 0), start)
        Assertions.require(twice == Date(2025, 3, 28))
        Assertions.require(once == Date(2025, 3, 31))
        Assertions.require((twice == once) === false)
    }),
    Test("subtraction applies the negated period", () => {
        periods: [Period(1, 2, 3), Period(-1, 13, -40), Period(0, 1, 0), Period(0, 0, 0)]
        dates: [Date(2024, 3, 31), Date(0, 2, 29), Date(2025, 12, 31)]
        periods.each((period) => {
            dates.each((date) => {
                Assertions.require(Period.subtractFromDate(period, date) ==
                    Period.addToDate(Period.negate(period), date))
            })
        })
        Assertions.require(Period.subtractFromDate(Period(1, 1, 1), Date(2025, 3, 30)) == Date(2024, 2, 28))
    }),
    Test("final dates outside the supported years signal", () => {
        requireAdd(Date(9999, 12, 31), Period(0, 0, 0), Date(9999, 12, 31))
        requireAdd(Date(-9999, 1, 1), Period(0, 0, 0), Date(-9999, 1, 1))
        rejectsAdd(Date(9999, 12, 31), Period(0, 0, 1))
        rejectsAdd(Date(9999, 12, 1), Period(0, 1, 0))
        rejectsAdd(Date(9999, 1, 1), Period(1, 0, 0))
        rejectsAdd(Date(-9999, 1, 1), Period(0, 0, -1))
        rejectsAdd(Date(-9999, 1, 15), Period(0, -1, 0))
        rejectsAdd(Date(-9999, 6, 1), Period(-1, 0, 0))
        rejectsAdd(Date(2000, 1, 1), Period(20000, 0, 0))
        rejectsAdd(Date(2000, 1, 1), Period(0, 0, 1180591620717411303424))
        rejectsAdd(Date(2000, 1, 1), Period(0, -1180591620717411303424, 0))
        Assertions.signals(Error, () => {
            Period.subtractFromDate(Period(0, 0, 1), Date(-9999, 1, 1))
        })
        // Only the final date is range-checked: the month displacement reaches
        // 10000-01-15 and the day displacement returns inside the range.
        requireAdd(Date(9999, 12, 15), Period(0, 1, -31), Date(9999, 12, 15))
    }),
    Test("application requires a period and a date", () => {
        Assertions.signals(Error, () => {
            Period.addToDate(Date(2000, 1, 1), Period(0, 0, 1))
        })
        // A Duration is not a calendar amount.
        Assertions.signals(Error, () => {
            Period.addToDate(Duration(86400000000000), Date(2000, 1, 1))
        })
        // A Time has no date on which to interpret a period.
        Assertions.signals(Error, () => {
            Period.addToDate(Period(0, 0, 1), Time(12, 0, 0, 0))
        })
        Assertions.signals(Error, () => {
            Period.addToLocalDateTime(Period(0, 0, 1), Date(2000, 1, 1))
        })
        Assertions.signals(Error, () => {
            Period.subtractFromDate(null, Date(2000, 1, 1))
        })
    }),
    Test("local date-time application changes only the date", () => {
        time: Time(23, 59, 59, 999999999)
        start: LocalDateTime(Date(2024, 1, 31), time)

        added: Period.addToLocalDateTime(Period(0, 1, 0), start)
        Assertions.require(added == LocalDateTime(Date(2024, 2, 29), time))
        Assertions.require(added.time === time)
        Assertions.require(added.hasSlot("offset") == false)
        Assertions.require(added.hasSlot("zone") == false)

        nextDay: Period.addToLocalDateTime(Period(0, 0, 1), start)
        Assertions.require(nextDay.date == Date(2024, 2, 1))
        Assertions.require(nextDay.time === time)

        subtracted: Period.subtractFromLocalDateTime(Period(0, 1, 1), LocalDateTime(Date(2024, 3, 31), time))
        Assertions.require(subtracted.date == Date(2024, 2, 28))
        Assertions.require(subtracted.time === time)
        Assertions.require(subtracted ==
            Period.addToLocalDateTime(Period(0, -1, -1), LocalDateTime(Date(2024, 3, 31), time)))

        Assertions.require(start.date == Date(2024, 1, 31))
        Assertions.signals(Error, () => {
            Period.addToLocalDateTime(Period(0, 0, 1), LocalDateTime(Date(9999, 12, 31), time))
        })
    })
]
