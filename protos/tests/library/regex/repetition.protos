Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Regex: import("std:regex/Regex")

requireSpan: (found, first, last) => {
    Assertions.require(found !== null)
    Assertions.require(found.start(0) == first)
    Assertions.require(found.end(0) == last)
    true
}

tests: [
    Test("?, *, and + repeat with greedy or lazy priority", () => {
        requireSpan(Regex.compile("a?").fullMatch(""), 0, 0)
        requireSpan(Regex.compile("a?").fullMatch("a"), 0, 1)
        Assertions.require(Regex.compile("a?").fullMatch("aa") === null)
        requireSpan(Regex.compile("a??").search("a"), 0, 0)
        requireSpan(Regex.compile("a*").fullMatch("aaaa"), 0, 4)
        Assertions.require(Regex.compile("a+").fullMatch("") === null)
        requireSpan(Regex.compile("a+").fullMatch("a"), 0, 1)
        requireSpan(Regex.compile("(?:ab)+").search("ababa"), 0, 4)
        requireSpan(Regex.compile("(?:ab)+?").search("ababa"), 0, 2)
    }),
    Test("bounded repetition counts iterations exactly", () => {
        Assertions.require(Regex.compile("a{3}").fullMatch("aaa") !== null)
        Assertions.require(Regex.compile("a{3}").fullMatch("aa") === null)
        Assertions.require(Regex.compile("a{3}").fullMatch("aaaa") === null)
        requireSpan(Regex.compile("a{2,3}").search("aaaa"), 0, 3)
        requireSpan(Regex.compile("a{2,3}?").search("aaaa"), 0, 2)
        Assertions.require(Regex.compile("a{2,3}").search("a") === null)
        requireSpan(Regex.compile("a{2,}").search("aaaaa"), 0, 5)
        requireSpan(Regex.compile("a{2,}?").search("aaaaa"), 0, 2)
        requireSpan(Regex.compile("a{0,2}").search("aaa"), 0, 2)
        requireSpan(Regex.compile("a{1}b").search("aab"), 1, 3)
        requireSpan(Regex.compile("a{0}b").fullMatch("b"), 0, 1)
        requireSpan(Regex.compile("(?:ab){2}").fullMatch("abab"), 0, 4)
        requireSpan(Regex.compile("😀{2}").search("x😀😀😀"), 1, 3)
    }),
    Test("nested repetition keeps independent counts", () => {
        Assertions.require(Regex.compile("(?:a{2}){3}").fullMatch("aaaaaa") !== null)
        Assertions.require(Regex.compile("(?:a{2}){3}").fullMatch("aaaaa") === null)
        Assertions.require(Regex.compile("(?:a{2}){3}").fullMatch("aaaaaaa") === null)
        Assertions.require(Regex.compile("(?:a{2,3}b){2}").fullMatch("aabaaab") !== null)
        Assertions.require(Regex.compile("(?:a{2,3}b){2}").fullMatch("abaab") === null)
        requireSpan(Regex.compile("(?:a+b{1,2}){2,}").search("abbabbab"), 0, 8)
        requireSpan(Regex.compile("(?:(?:a|b){2}c)*").search("abcbac"), 0, 6)
    }),
    Test("nullable repetition terminates", () => {
        Array("(?:)*", "(?:)+", "(?:){1000000000}", "(?:){3,}", "(a*)*", "(a*)+", "(?:a?)*", "(?:a?)+", "(^)*",
            "(\\b)*", "(?:a*|b)*", "((a*)*)*", "(?:a?){5}", "(?:$|a)*", "(?:\\b|a)*").each((source) => {
            pattern: Regex.compile(source)
            requireSpan(pattern.search(""), 0, 0)
            Assertions.require(pattern.search("bcd") !== null)
            Assertions.require(pattern.findAll("aab").size() > 0)
        })
        Assertions.require(Regex.compile("(\\b)+").search("") === null)
        requireSpan(Regex.compile("(\\b)+").search(" a"), 1, 1)
        requireSpan(Regex.compile("(a*)*").fullMatch("aaa"), 0, 3)
        requireSpan(Regex.compile("(?:a?)*").fullMatch("aa"), 0, 2)
        requireSpan(Regex.compile("(?:a|){5,}").fullMatch("aa"), 0, 2)
        requireSpan(Regex.compile("(?:a?){3}").fullMatch("a"), 0, 1)
        requireSpan(Regex.compile("(?:){1000000000}").fullMatch(""), 0, 0)
        Assertions.require(Regex.compile("(?:){1000000000}").fullMatch("a") === null)
        requireSpan(Regex.compile("(?:\\b){1000000000}a").search(" a"), 1, 2)
        requireSpan(Regex.compile("(?:^){1000000000,}x").search("x"), 0, 1)
        Assertions.require(Regex.compile("(?:^){1000000000}x").search("yx") === null)
    }),
    Test("huge counted repetition runs without expansion", () => {
        Assertions.require(Regex.compile("a{1000000000}").search("aaaa") === null)
        requireSpan(Regex.compile("a{0,1000000000}").fullMatch("aaaa"), 0, 4)
        requireSpan(Regex.compile("a{2,1000000000}?").search("aaaa"), 0, 2)
        requireSpan(Regex.compile("a{1,1000000000}").search("baaab"), 1, 4)
        Assertions.require(Regex.compile("(?:a{1000000000}){1000000000}").search("aaa") === null)
        Assertions.require(Regex.compile("x{99999999999999999999}").search("xx") === null)
        requireSpan(Regex.compile("x{0,99999999999999999999}y").search("xxy"), 0, 3)
        requireSpan(Regex.compile("(?:(?:a{1000}){1000}){0,1}b").search("ab"), 1, 2)
    })
]
