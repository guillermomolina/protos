Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Regex: import("std:regex/Regex")

// Requires `fields` to be exactly `expected`, in order.
requireFields: (fields, ...expected) => {
    Assertions.require(Array.recognizes(fields))
    Assertions.require(fields.size() == expected.size())
    index: 0
    (() => index < fields.size()).whileTrue() {
        Assertions.require(fields[index] == expected[index])
        index = index + 1
    }
    true
}

tests: [
    Test("split removes delimiters and keeps every field", () => {
        requireFields(Regex.compile(",").split("a,b"), "a", "b")
        requireFields(Regex.compile(",").split("a,b,c"), "a", "b", "c")
        requireFields(Regex.compile("\\s*;\\s*").split("a ; b;c  ;d"), "a", "b", "c", "d")
        requireFields(Regex.compile("ab|a").split("xabyaz"), "x", "y", "z")
    }),
    Test("split keeps leading, interior, and trailing empty fields", () => {
        requireFields(Regex.compile(",").split("a,,b,"), "a", "", "b", "")
        requireFields(Regex.compile(",").split(",a"), "", "a")
        requireFields(Regex.compile(",").split("a,"), "a", "")
        requireFields(Regex.compile(",").split(",a,"), "", "a", "")
        requireFields(Regex.compile(",").split(",,"), "", "", "")
        requireFields(Regex.compile(",").split(","), "", "")
    }),
    Test("split without a match answers the whole subject", () => {
        requireFields(Regex.compile(",").split("abc"), "abc")
        requireFields(Regex.compile(",").split(""), "")
    }),
    Test("zero-width delimiters remove no input", () => {
        requireFields(Regex.compile("").split("ab"), "", "a", "b", "")
        requireFields(Regex.compile("").split(""), "", "")
        requireFields(Regex.compile("").split("😀é"), "", "😀", "é", "")
        requireFields(Regex.compile("\\b").split("ab cd"), "", "ab", " ", "cd", "")
        requireFields(Regex.compile("x*").split("axxb"), "", "a", "", "b", "")
        requireFields(Regex.compileWithFlags("^", "m").split("a\nb"), "", "a\n", "b")
        requireFields(Regex.compile("$").split("ab"), "ab", "")
    }),
    Test("delimiter captures are not inserted", () => {
        requireFields(Regex.compile("(,)").split("a,b,c"), "a", "b", "c")
        requireFields(Regex.compile("(?<sep>[,;])(x)?").split("a,b;xc"), "a", "b", "c")
        requireFields(Regex.compile("(,)|(\\+)").split("1,2+3"), "1", "2", "3")
    }),
    Test("split works on Unicode scalars without normalization", () => {
        requireFields(Regex.compile("é").split("aébéc"), "a", "b", "c")
        requireFields(Regex.compile("😀").split("😀a😀😀b"), "", "a", "", "b")
        requireFields(Regex.compile(",").split("😀,e\u{301},€"), "😀", "e\u{301}", "€")
        requireFields(Regex.compile("\u{301}").split("e\u{301}a"), "e", "a")
        requireFields(Regex.compile("é").split("e\u{301}"), "e\u{301}")
    }),
    Test("split answers a fresh Array and leaves the Pattern unchanged", () => {
        pattern: Regex.compile(",")
        first: pattern.split("a,b")
        first[0] = "changed"
        requireFields(pattern.split("a,b"), "a", "b")
        Assertions.require(pattern.source == ",")
    }),
    Test("split rejects non-String subjects", () => {
        pattern: Regex.compile(",")
        requireRejected: (value) => {
            Assertions.signals(Error, () => { pattern.split(value) })
        }
        Array(null, 1, Encoding.UTF8.encode("a,b"), Array("a,b")).each(requireRejected)
        true
    })
]
