Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Regex: import("std:regex/Regex")

// Answers the start offsets of every match of `pattern` in `text`.
starts: (pattern, text) => {
    found: pattern.findAll(text)
    result: Array(...found)
    index: 0
    (() => index < found.size()).whileTrue() {
        result[index] = found[index].start(0)
        index = index + 1
    }
    result
}

requireStarts: (pattern, text, ...expected) => {
    actual: starts(pattern, text)
    Assertions.require(actual.size() == expected.size())
    index: 0
    (() => index < actual.size()).whileTrue() {
        Assertions.require(actual[index] == expected[index])
        index = index + 1
    }
    true
}

// LF, CR, NEL, LINE SEPARATOR, and PARAGRAPH SEPARATOR.
terminators: Array("\u{A}", "\u{D}", "\u{85}", "\u{2028}", "\u{2029}")

tests: [
    Test("\\A and \\z match only at the text edges", () => {
        Assertions.require(Regex.compile("\\Aa").search("ba") === null)
        Assertions.require(Regex.compile("\\Ab").search("ab") === null)
        Assertions.require(Regex.compile("\\Aa").search("ab").start(0) == 0)
        Assertions.require(Regex.compile("a\\z").search("ab") === null)
        Assertions.require(Regex.compile("a\\z").search("ba").start(0) == 1)
        Assertions.require(Regex.compile("a\\z").search("a\n") === null)
        requireStarts(Regex.compileWithFlags("\\A", "m"), "a\nb", 0)
        requireStarts(Regex.compileWithFlags("\\z", "m"), "a\nb", 3)
    }),
    Test("^ and $ without m match only at the text edges", () => {
        Assertions.require(Regex.compile("^b").search("a\nb") === null)
        Assertions.require(Regex.compile("a$").search("a\n") === null)
        Assertions.require(Regex.compile("a$").search("ba").start(0) == 1)
        requireStarts(Regex.compile("^"), "a\nb", 0)
        requireStarts(Regex.compile("$"), "a\nb\n", 4)
        requireStarts(Regex.compile("$"), "", 0)
    }),
    Test("^ and $ with m match at every line boundary", () => {
        terminators.each((terminator) => {
            text: "a" + terminator + "b"
            requireStarts(Regex.compileWithFlags("^", "m"), text, 0, 2)
            requireStarts(Regex.compileWithFlags("$", "m"), text, 1, 3)
            Assertions.require(Regex.compileWithFlags("^b", "m").search(text).start(0) == 2)
            Assertions.require(Regex.compileWithFlags("a$", "m").search(text).end(0) == 1)
        })
        requireStarts(Regex.compileWithFlags("^", "m"), "\n\n", 0, 1, 2)
        requireStarts(Regex.compileWithFlags("$", "m"), "\n\n", 0, 1, 2)
    }),
    Test("CRLF is one line boundary for ^ and $", () => {
        crlf: "a\u{D}\u{A}b"
        requireStarts(Regex.compileWithFlags("^", "m"), crlf, 0, 3)
        requireStarts(Regex.compileWithFlags("$", "m"), crlf, 1, 4)
        Assertions.require(Regex.compileWithFlags("\u{D}^", "m").search(crlf) === null)
        Assertions.require(Regex.compileWithFlags("$\u{A}", "m").search(crlf) === null)
        Assertions.require(Regex.compileWithFlags("$\u{D}\u{A}^", "m").search(crlf).start(0) == 1)
        // LF followed by CR is two sequences.
        requireStarts(Regex.compileWithFlags("^", "m"), "\u{A}\u{D}", 0, 1, 2)
        requireStarts(Regex.compileWithFlags("$", "m"), "\u{A}\u{D}", 0, 1, 2)
        requireStarts(Regex.compileWithFlags("^", "m"), "\u{D}\u{A}\u{D}\u{A}", 0, 2, 4)
    }),
    Test("dot excludes line terminators unless s is present", () => {
        dot: Regex.compile(".")
        dotAll: Regex.compileWithFlags(".", "s")
        terminators.each((terminator) => {
            Assertions.require(dot.search(terminator) === null)
            Assertions.require(dotAll.fullMatch(terminator) !== null)
        })
        Assertions.require(dot.search("\nx").start(0) == 1)
        Assertions.require(dot.fullMatch("😀") !== null)
        Assertions.require(Regex.compileWithFlags("a.b", "s").fullMatch("a\u{D}b") !== null)
    }),
    Test("\\b and \\B separate word and non-word scalars", () => {
        word: Regex.compile("\\bfoo\\b")
        Assertions.require(word.search("a foo.").start(0) == 2)
        Assertions.require(word.search("afoo") === null)
        Assertions.require(word.search("foo_") === null)
        Assertions.require(Regex.compile("\\Boo").search("foo").start(0) == 1)
        requireStarts(Regex.compile("\\b"), "ab cd", 0, 2, 3, 5)
        requireStarts(Regex.compile("\\B"), "ab cd", 1, 4)
        requireStarts(Regex.compile("\\b"), "")
        requireStarts(Regex.compile("\\B"), "", 0)
        requireStarts(Regex.compile("\\b"), "-")
        requireStarts(Regex.compile("\\B"), "-", 0, 1)
    }),
    Test("word boundaries use the Unicode word set", () => {
        // Alphabetic, Mark, Decimal_Number, Connector_Punctuation, Join_Control.
        Array("é", "日", "\u{301}", "٣", "_", "‿", "\u{200D}").each((wordScalar) => {
            Assertions.require(Regex.compile("a\\B").search("a" + wordScalar) !== null)
            Assertions.require(Regex.compile("a\\b").search("a" + wordScalar) === null)
            requireStarts(Regex.compile("\\b"), " " + wordScalar + " ", 1, 2)
        })
        Array("-", " ", "😀", "\u{200E}").each((otherScalar) => {
            Assertions.require(Regex.compile("a\\b").search("a" + otherScalar) !== null)
        })
        Assertions.require(Regex.compile("e\\b").search("e\u{301}") === null)
        Assertions.require(Regex.compileWithFlags("\\bé\\b", "i").search("x É y").start(0) == 2)
    })
]
