Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Regex: import("std:regex/Regex")

// Requires group `key` of `found` to capture `text` over [first, last).
requireGroup: (found, key, first, last, text) => {
    Assertions.require(found.start(key) == first)
    Assertions.require(found.end(key) == last)
    Assertions.require(found.group(key) == text)
    true
}

requireAbsent: (found, key) => {
    Assertions.require(found.group(key) === null)
    Assertions.require(found.start(key) === null)
    Assertions.require(found.end(key) === null)
    true
}

tests: [
    Test("group 0 is the whole selected match", () => {
        found: Regex.compile("b+").search("abbc")
        Assertions.require(found.captureCount == 0)
        requireGroup(found, 0, 1, 3, "bb")
        groups: found.groups()
        Assertions.require(groups.size() == 1)
        Assertions.require(groups[0] == "bb")
        Assertions.require(found.namedGroups().size() == 0)
    }),
    Test("numbered and named groups share one numbering", () => {
        found: Regex.compile("(?<year>\\d{4})-(?<month>\\d{2})-(\\d{2})").search("on 2026-10-06!")
        requireGroup(found, 0, 3, 13, "2026-10-06")
        requireGroup(found, 1, 3, 7, "2026")
        requireGroup(found, "year", 3, 7, "2026")
        requireGroup(found, 2, 8, 10, "10")
        requireGroup(found, "month", 8, 10, "10")
        requireGroup(found, 3, 11, 13, "06")
        named: found.namedGroups()
        Assertions.require(named.size() == 2)
        Assertions.require(named["year"] == "2026")
        Assertions.require(named["month"] == "10")
        Assertions.signals(Error, () => { found.group("day") })
        Assertions.signals(Error, () => { found.group(4) })
        Assertions.signals(Error, () => { found.start(-1) })
    }),
    Test("nested groups report their own spans", () => {
        found: Regex.compile("((a)(b(c)))").fullMatch("abc")
        requireGroup(found, 1, 0, 3, "abc")
        requireGroup(found, 2, 0, 1, "a")
        requireGroup(found, 3, 1, 3, "bc")
        requireGroup(found, 4, 2, 3, "c")
    }),
    Test("groups outside the selected path do not participate", () => {
        found: Regex.compile("(a)|(?<b>b)").search("xb")
        requireAbsent(found, 1)
        requireGroup(found, 2, 1, 2, "b")
        groups: found.groups()
        Assertions.require(groups[1] === null)
        Assertions.require(found.namedGroups()["b"] == "b")
        unnamed: Regex.compile("(?<n>x)?y").search("y")
        requireAbsent(unnamed, "n")
        Assertions.require(unnamed.namedGroups().containsKey("n"))
        Assertions.require(unnamed.namedGroups()["n"] === null)
        requireAbsent(Regex.compile("(a){0}b").fullMatch("b"), 1)
    }),
    Test("empty participating groups have equal start and end", () => {
        found: Regex.compile("a(x*)b").fullMatch("ab")
        requireGroup(found, 1, 1, 1, "")
        requireGroup(Regex.compile("()").search("é"), 1, 0, 0, "")
        requireGroup(Regex.compile("é(?<e>)").search("😀é"), "e", 2, 2, "")
    }),
    Test("repeated groups report their last selected participation", () => {
        requireGroup(Regex.compile("(a)+").fullMatch("aaa"), 1, 2, 3, "a")
        requireGroup(Regex.compile("(a|b)*").fullMatch("abba"), 1, 3, 4, "a")
        alternating: Regex.compile("((a)|(b))+").fullMatch("ab")
        requireGroup(alternating, 1, 1, 2, "b")
        requireGroup(alternating, 2, 0, 1, "a")
        requireGroup(alternating, 3, 1, 2, "b")
        requireGroup(Regex.compile("(?:(a)|b)+").fullMatch("ab"), 1, 0, 1, "a")
        requireGroup(Regex.compile("(a{1,2}){2}").fullMatch("aaa"), 1, 2, 3, "a")
        requireGroup(Regex.compile("(?:(\\w)\\d){3}").fullMatch("a1b2c3"), 1, 4, 5, "c")
    }),
    Test("empty optional iterations follow greedy or lazy priority", () => {
        // `a` cannot consume at offset 0 of either subject.
        Array("", "b").each((subject) => {
            requireGroup(Regex.compile("(a?)*").search(subject), 0, 0, 0, "")
            requireGroup(Regex.compile("(a?)*").search(subject), 1, 0, 0, "")
            requireGroup(Regex.compile("(a?)+").search(subject), 1, 0, 0, "")
            requireGroup(Regex.compile("(a?)+?").search(subject), 1, 0, 0, "")
            requireGroup(Regex.compile("(a?)?").search(subject), 1, 0, 0, "")
            requireGroup(Regex.compile("(a?){2,}").search(subject), 1, 0, 0, "")
            lazy: Regex.compile("(a?)*?").search(subject)
            requireGroup(lazy, 0, 0, 0, "")
            requireAbsent(lazy, 1)
            requireAbsent(Regex.compile("(a?)??").search(subject), 1)
        })
        requireGroup(Regex.compile("(a?)*").fullMatch(""), 1, 0, 0, "")
        requireAbsent(Regex.compile("(a?)*?").fullMatch(""), 1)
        // After consuming iterations, a greedy loop still takes the empty one.
        requireGroup(Regex.compile("(a?)*").fullMatch("aa"), 1, 2, 2, "")
        requireGroup(Regex.compile("(a?)+").fullMatch("aa"), 1, 2, 2, "")
        requireGroup(Regex.compile("(a?)*?").fullMatch("aa"), 1, 1, 2, "a")
        requireGroup(Regex.compile("(a?)+?").fullMatch("aa"), 1, 1, 2, "a")
        // The empty iteration ends the repetition, so traversal terminates.
        Array("(a?)*", "(a?)+", "(a?)*?", "(a?)+?").each((source) => {
            Assertions.require(Regex.compile(source).findAll("bb").size() == 3)
        })
        Assertions.require(Regex.compile("(a?)*").findAll("aab").size() == 3)
    }),
    Test("capture spans count Unicode scalars and keep text unnormalized", () => {
        found: Regex.compile("(é+)(😀)(e\u{301})").search("xéé😀e\u{301}y")
        requireGroup(found, 0, 1, 6, "éé😀e\u{301}")
        requireGroup(found, 1, 1, 3, "éé")
        requireGroup(found, 2, 3, 4, "😀")
        requireGroup(found, 3, 4, 6, "e\u{301}")
        split: Regex.compile("(.)(.)").fullMatch("e\u{301}")
        requireGroup(split, 1, 0, 1, "e")
        requireGroup(split, 2, 1, 2, "\u{301}")
        requireGroup(Regex.compile("(\\p{So}+)").search("a😀👍b"), 1, 1, 3, "😀👍")
    }),
    Test("snapshots and Matches are isolated from callers", () => {
        pattern: Regex.compile("(?<x>a)(b)")
        found: pattern.search("ab")
        groups: found.groups()
        groups[0] = "changed"
        groups[1] = null
        Assertions.require(found.group(0) == "ab")
        Assertions.require(found.groups()[1] == "a")
        named: found.namedGroups()
        named["x"] = "changed"
        named["y"] = "added"
        Assertions.require(found.namedGroups().size() == 1)
        Assertions.require(found.namedGroups()["x"] == "a")
        Assertions.signals(Error, () => { found.extra: 1 })
        Assertions.signals(Error, () => { found.captureCount = 0 })
        Array("program", "bounds", "texts", "before", "after", "capturesHistory", "iterator", "replace").each((name) => {
            Assertions.require(found.hasSlot(name) == false)
        })
        again: pattern.search("ab")
        Assertions.require((again === found) == false)
        Assertions.require(again.group(1) == "a")
    })
]
