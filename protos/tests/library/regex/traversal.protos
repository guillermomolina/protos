Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Regex: import("std:regex/Regex")

// Requires `matches` to have the given [start, end) spans, flattened.
requireSpans: (matches, ...spans) => {
    Assertions.require(matches.size() * 2 == spans.size())
    index: 0
    (() => index < matches.size()).whileTrue() {
        Assertions.require(matches[index].start(0) == spans[2 * index])
        Assertions.require(matches[index].end(0) == spans[2 * index + 1])
        index = index + 1
    }
    true
}

// Answers the first digit run of `text`, leaving the traversal non-locally.
firstNumber: (pattern, text, visits) => {
    pattern.eachMatch(text, (found) => {
        visits[0] = visits[0] + 1
        ^found.group(0)
    })
    null
}

tests: [
    Test("findAll answers a fresh Array of non-overlapping matches", () => {
        none: Regex.compile("z").findAll("abc")
        Assertions.require(none.size() == 0)
        digits: Regex.compile("\\d+").findAll("a1b22c333")
        requireSpans(digits, 1, 2, 3, 5, 6, 9)
        Assertions.require(digits[2].group(0) == "333")
        requireSpans(Regex.compile("aa").findAll("aaaaa"), 0, 2, 2, 4)
        requireSpans(Regex.compile("a|aa").findAll("aaa"), 0, 1, 1, 2, 2, 3)
        requireSpans(Regex.compile("😀").findAll("😀a😀"), 0, 1, 2, 3)
        Assertions.require(Regex.compile("z").findAll("").size() == 0)
    }),
    Test("zero-width matches advance by one scalar", () => {
        requireSpans(Regex.compile("").findAll("ab"), 0, 0, 1, 1, 2, 2)
        requireSpans(Regex.compile("").findAll(""), 0, 0)
        requireSpans(Regex.compile("").findAll("😀é"), 0, 0, 1, 1, 2, 2)
        requireSpans(Regex.compile("x*").findAll("axxb"), 0, 0, 1, 3, 3, 3, 4, 4)
        requireSpans(Regex.compile("a*?").findAll("aa"), 0, 0, 1, 1, 2, 2)
        requireSpans(Regex.compile("\\b").findAll("ab c"), 0, 0, 2, 2, 3, 3, 4, 4)
    }),
    Test("a zero-width match at the end is emitted once", () => {
        requireSpans(Regex.compile("$").findAll("ab"), 2, 2)
        requireSpans(Regex.compile("\\z").findAll("😀"), 1, 1)
        requireSpans(Regex.compile("b*$").findAll("abb"), 1, 3, 3, 3)
        requireSpans(Regex.compileWithFlags("$", "m").findAll("a\n"), 1, 1, 2, 2)
    }),
    Test("findAll results are independent of the Pattern and of each other", () => {
        pattern: Regex.compile("(a)(?<b>b)?")
        first: pattern.findAll("aab")
        first[0] = null
        second: pattern.findAll("aab")
        requireSpans(second, 0, 1, 1, 3)
        Assertions.require(second[0].group("b") === null)
        Assertions.require(second[1].group("b") == "b")
        Assertions.require((second[1] === first[1]) == false)
        second[1].groups()[0] = "changed"
        Assertions.require(second[1].group(0) == "ab")
        Assertions.require(pattern.source == "(a)(?<b>b)?")
    }),
    Test("eachMatch visits matches in order and answers null", () => {
        visited: Map()
        count: 0
        result: Regex.compile("\\w+").eachMatch("one, two três", (found) => {
            visited[count] = found.group(0)
            count = count + 1
            "ignored"
        })
        Assertions.require(result === null)
        Assertions.require(count == 3)
        Assertions.require(visited[0] == "one")
        Assertions.require(visited[1] == "two")
        Assertions.require(visited[2] == "três")
        empties: 0
        Regex.compile("").eachMatch("ab", (found) => {
            Assertions.require(found.start(0) == empties)
            empties = empties + 1
        })
        Assertions.require(empties == 3)
    }),
    Test("eachMatch invokes the block only for actual matches", () => {
        Assertions.require(Regex.compile("z").eachMatch("abc", 42) === null)
        Assertions.signals(Error, () => { Regex.compile("a").eachMatch("abc", 42) })
    }),
    Test("eachMatch propagates block Errors and non-local returns", () => {
        visits: 0
        Assertions.signals(Error, () => {
            Regex.compile("a").eachMatch("aaa", (found) => {
                visits = visits + 1
                Error().signal()
            })
        })
        Assertions.require(visits == 1)
        counter: [0]
        Assertions.require(firstNumber(Regex.compile("\\d+"), "ab12cd34", counter) == "12")
        Assertions.require(counter[0] == 1)
        Assertions.require(firstNumber(Regex.compile("\\d+"), "none", counter) === null)
        Assertions.require(counter[0] == 1)
    })
]
