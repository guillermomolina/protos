Assertions: import("std:test/assertions")
Test: import("std:test/test")
JWT: import("std:auth/jwt")
JSON: import("std:json/json")
Instant: import("std:datetime/instant")

fixtureToken: "eyJhbGciOiJIUzI1NiIsInR5cCI6InJlYWx3b3JsZC1hY2Nlc3Mrand0In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicHJvdG9zLXJlYWx3b3JsZCIsInN1YiI6InVzZXItaWQtNDIiLCJpYXQiOjE3OTQwOTYwMDAsIm5iZiI6MTc5NDA5NjAwMCwiZXhwIjoxNzk0MDk5NjAwLCJqdGkiOiJpZC03In0.ClxaP-9Ot2XonmcSAQYbQ9ji7hbWNah62Yp059YFyl0"

key: () => {
    result: Encoding.UTF8.encode("")
    for(i, 0, 32) { result.add(i) }
    result
}

policy: () => {
    {
        issuer: "https://issuer.example"
        audience: "protos-realworld"
        type: "realworld-access+jwt"
        maxLifetimeSeconds: 3600
        clockSkewSeconds: 0
    }
}

claims: () => {
    JSON.object(
        "iss", JSON.string("https://issuer.example"),
        "aud", JSON.string("protos-realworld"),
        "sub", JSON.string("user-id-42"),
        "iat", JSON.number(1794096000, 0),
        "nbf", JSON.number(1794096000, 0),
        "exp", JSON.number(1794099600, 0),
        "jti", JSON.string("id-7")
    )
}

now: () => Instant(1794097000 * 1000000000)

tests: [
    Test("independent HS256 fixture verifies", () => {
        result: JWT.verify(fixtureToken, key(), policy(), now())
        Assertions.require(result.kind == "object")
        Assertions.require(result.value["sub"].value == "user-id-42")
        Assertions.require(result.value["jti"].value == "id-7")
        Assertions.require(result.value["exp"].value.coefficient == 1794099600)
    }),
    Test("issuing ordered structured claims matches independent fixture", () => {
        issued: JWT.issue(claims(), key(), policy(), now())
        Assertions.require(issued == fixtureToken)
    }),
    Test("issued tokens roundtrip without ambient clock", () => {
        token: JWT.issue(claims(), key(), policy(), now())
        verified: JWT.verify(token, key(), policy(), now())
        Assertions.require(verified.kind == "object")
        Assertions.require(verified.value["iss"].value == "https://issuer.example")
        Assertions.require(verified.value["aud"].value == "protos-realworld")
    }),
    Test("public API exposes exactly three members", () => {
        Assertions.require(JWT.slotNames().size() == 3)
        Assertions.require(JWT.hasSlot("issue"))
        Assertions.require(JWT.hasSlot("verify"))
        Assertions.require(JWT.hasSlot("JwtError"))
    })
]
tests.freeze()
