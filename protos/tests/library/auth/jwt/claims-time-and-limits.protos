Assertions: import("std:test/assertions")
Test: import("std:test/test")
JWT: import("std:auth/jwt")
JSON: import("std:json/json")
Instant: import("std:datetime/instant")

key: () => {
    result: Encoding.UTF8.encode("")
    for(i, 0, 32) { result.add(i) }
    result
}

policy: () => {
    {
        issuer: "issuer"
        audience: "audience"
        type: "access+jwt"
        maxLifetimeSeconds: 3600
        clockSkewSeconds: 0
    }
}

claims: (issuedAt, expiresAt) => {
    JSON.object(
        "iss", JSON.string("issuer"),
        "aud", JSON.string("audience"),
        "sub", JSON.string("subject"),
        "iat", JSON.number(issuedAt, 0),
        "exp", JSON.number(expiresAt, 0)
    )
}

now: () => Instant(1000000000000)

Base64url: import("std:text/base64url")
HMAC: import("std:crypto/hmac_sha256")

signedPayload: (payloadText) => {
    header: Base64url.encode(
        Encoding.UTF8.encode("{\"alg\":\"HS256\",\"typ\":\"access+jwt\"}")
    )
    payload: Base64url.encode(Encoding.UTF8.encode(payloadText))
    input: header + "." + payload
    tag: Base64url.encode(
        HMAC.digest(key(), Encoding.Latin1.encode(input))
    )
    input + "." + tag
}

// ASCII-only fixtures keep String length equal to UTF-8 octet length.
repeatAscii: (character, count) => {
    result: ""
    index: 0
    while(index < count) {
        result = result + character
        index = index + 1
    }
    result
}

signParts: (headerText, payloadText) => {
    header: Base64url.encode(Encoding.UTF8.encode(headerText))
    payload: Base64url.encode(Encoding.UTF8.encode(payloadText))
    signingInput: header + "." + payload
    signature: Base64url.encode(
        HMAC.digest(key(), Encoding.Latin1.encode(signingInput))
    )
    signingInput + "." + signature
}

validPayload: () => {
    "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"exp\":1100}"
}

// Add JSON whitespace before the final object delimiter.
// The resulting payload is valid JSON with an exact byte count.
paddedPayload: (targetBytes) => {
    base: validPayload()
    count: targetBytes - base.size()
    if(count < 0) {
        Error().signal()
    }

    prefix: ""
    index: 0
    while(index < base.size() - 1) {
        prefix = prefix + base[index]
        index = index + 1
    }

    prefix + repeatAscii(" ", count) + "}"
}

headerForType: (type) => {
    "{\"alg\":\"HS256\",\"typ\":\"" + type + "\"}"
}

// Root object contributes one level. Fifteen nested arrays reach
// the allowed container depth of sixteen; sixteen arrays reach seventeen.
nestedPayload: (arrayLevels) => {
    prefix: "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"exp\":1100,\"nested\":"
    prefix +
        repeatAscii("[", arrayLevels) +
        "0" +
        repeatAscii("]", arrayLevels) +
        "}"
}

tests: [
    Test("missing trusted policy fields fail before signing", () => {
        missingIssuer: {
            audience: "audience"
            type: "access+jwt"
            maxLifetimeSeconds: 3600
        }
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), missingIssuer, now())
        })

        missingLifetime: {
            issuer: "issuer"
            audience: "audience"
            type: "access+jwt"
        }
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), missingLifetime, now())
        })
    }),
    Test("policy rejects invalid text and numeric fields", () => {
        wrongType: policy()
        wrongType.type = ""
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), wrongType, now())
        })

        wrongLifetime: policy()
        wrongLifetime.maxLifetimeSeconds = 0
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), wrongLifetime, now())
        })

        fractionalLifetime: policy()
        fractionalLifetime.maxLifetimeSeconds = 3600.0
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), fractionalLifetime, now())
        })

        wrongSkew: policy()
        wrongSkew.clockSkewSeconds = -1
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), wrongSkew, now())
        })
    }),
    Test("invalid Instant is an issuer configuration failure", () => {
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), policy(), 1000)
        })
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), policy(), null)
        })
    }),
    Test("depth sixteen is accepted for issue and authenticated verify", () => {
        payload: nestedPayload(15)
        source: JSON.parse(payload)
        instant: now()

        issued: JWT.issue(source, key(), policy(), instant)
        Assertions.require(
            JWT.verify(issued, key(), policy(), instant).kind == "object"
        )

        independentlySigned: signedPayload(payload)
        Assertions.require(
            JWT.verify(independentlySigned, key(), policy(), instant).kind == "object"
        )
    }),
    Test("depth seventeen fails before issue serialization and after authentication", () => {
        payload: nestedPayload(16)
        source: JSON.parse(payload)
        instant: now()

        Assertions.signals(Error, () => {
            JWT.issue(source, key(), policy(), instant)
        })

        independentlySigned: signedPayload(payload)
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(independentlySigned, key(), policy(), instant)
        })
    }),
    Test("oversized structured decimal representation rejects before encoding", () => {
        hugeExponent: 1 << 14000

        source: JSON.object(
            "iss", JSON.string("issuer"),
            "aud", JSON.string("audience"),
            "sub", JSON.string("subject"),
            "iat", JSON.number(900, 0),
            "exp", JSON.number(1100, 0),
            "extra", JSON.number(0, hugeExponent)
        )

        Assertions.signals(Error, () => {
            JWT.issue(source, key(), policy(), now())
        })
    }),
    Test("issuer-controlled oversized String fails before JSON encoding", () => {
        hugeSubject: repeatAscii("x", 4097)

        source: JSON.object(
            "iss", JSON.string("issuer"),
            "aud", JSON.string("audience"),
            "sub", JSON.string(hugeSubject),
            "iat", JSON.number(900, 0),
            "exp", JSON.number(1100, 0)
        )

        Assertions.signals(Error, () => {
            JWT.issue(source, key(), policy(), now())
        })
    }),
    Test("decoded payload limit accepts 4096 and rejects 4097", () => {
        exact: paddedPayload(4096)
        tooLarge: paddedPayload(4097)

        Assertions.require(Encoding.UTF8.encode(exact).size() == 4096)
        Assertions.require(Encoding.UTF8.encode(tooLarge).size() == 4097)

        header: headerForType("access+jwt")

        good: signParts(header, exact)
        bad: signParts(header, tooLarge)

        Assertions.require(
            JWT.verify(good, key(), policy(), now()).kind == "object"
        )

        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(bad, key(), policy(), now())
        })
    }),
    Test("decoded protected-header limit accepts 1024 and rejects 1025", () => {
        // Preserve the trusted policy and the JOSE member values.
        // JSON whitespace changes only the decoded header's size.
        base: headerForType("access+jwt")
        fixedLength: Encoding.UTF8.encode(base).size()

        exactHeader: "{\"alg\":\"HS256\",\"typ\":\"access+jwt\"" +
            repeatAscii(" ", 1024 - fixedLength) + "}"

        tooLargeHeader: "{\"alg\":\"HS256\",\"typ\":\"access+jwt\"" +
            repeatAscii(" ", 1025 - fixedLength) + "}"

        Assertions.require(
            Encoding.UTF8.encode(exactHeader).size() == 1024
        )
        Assertions.require(
            Encoding.UTF8.encode(tooLargeHeader).size() == 1025
        )

        good: signParts(exactHeader, validPayload())
        bad: signParts(tooLargeHeader, validPayload())

        Assertions.require(
            JWT.verify(good, key(), policy(), now()).kind == "object"
        )

        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(bad, key(), policy(), now())
        })
    }),
    Test("oversized and maximum-length malformed compact tokens reject", () => {
        // Both are deliberately invalid JWTs, but exercise the exact
        // compact framing threshold before any JSON interpretation.
        atLimit: repeatAscii("A", 8188) + ".A.A"
        aboveLimit: repeatAscii("A", 8189) + ".A.A"

        Assertions.require(
            Encoding.UTF8.encode(atLimit).size() == 8192
        )
        Assertions.require(
            Encoding.UTF8.encode(aboveLimit).size() == 8193
        )

        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(atLimit, key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(aboveLimit, key(), policy(), now())
        })
    }),
    Test("signed missing mandatory claims fail", () => {
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{}"), key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{\"iss\":\"issuer\"}"), key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{\"iss\":\"issuer\",\"aud\":\"audience\"}"), key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"\"}"), key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900}"), key(), policy(), now())
        })
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(signedPayload("{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"exp\":900}"), key(), policy(), now())
        })
    }),
    Test("signed fractional NumericDate fails exact admission", () => {
        candidate: signedPayload(
            "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900.1,\"exp\":1100}"
        )
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(candidate, key(), policy(), now())
        })
    }),
    Test("audience array requires an exact matching String", () => {
        good: signedPayload(
            "{\"iss\":\"issuer\",\"aud\":[\"other\",\"audience\"],\"sub\":\"subject\",\"iat\":900,\"exp\":1100}"
        )
        Assertions.require(
            JWT.verify(good, key(), policy(), now()).kind == "object"
        )

        bad: signedPayload(
            "{\"iss\":\"issuer\",\"aud\":[\"other\"],\"sub\":\"subject\",\"iat\":900,\"exp\":1100}"
        )
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(bad, key(), policy(), now())
        })

        empty: signedPayload(
            "{\"iss\":\"issuer\",\"aud\":[],\"sub\":\"subject\",\"iat\":900,\"exp\":1100}"
        )
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(empty, key(), policy(), now())
        })
    }),
    Test("authenticated not-before after the clock is rejected", () => {
        payload: "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"nbf\":1001,\"exp\":1100}"
        candidate: signedPayload(payload)

        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(candidate, key(), policy(), now())
        })
    }),
    Test("authenticated expiration equality is rejected", () => {
        payload: "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"exp\":1000}"
        candidate: signedPayload(payload)

        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(candidate, key(), policy(), now())
        })
    }),
    Test("authenticated expiration one nanosecond earlier is valid", () => {
        payload: "{\"iss\":\"issuer\",\"aud\":\"audience\",\"sub\":\"subject\",\"iat\":900,\"exp\":1000}"
        candidate: signedPayload(payload)
        instant: Instant(999999999999)

        Assertions.require(
            JWT.verify(candidate, key(), policy(), instant).kind == "object"
        )
    }),
    Test("expiration equality is rejected at zero skew", () => {
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1000), key(), policy(), now())
        })
    }),
    Test("nanosecond before expiration is valid", () => {
        instant: Instant(999999999999)
        token: JWT.issue(claims(900, 1000), key(), policy(), instant)
        verified: JWT.verify(token, key(), policy(), instant)
        Assertions.require(verified.value["exp"].value.coefficient == 1000)
    }),
    Test("future issue time and excessive lifetime fail", () => {
        Assertions.signals(Error, () => {
            JWT.issue(claims(1001, 1200), key(), policy(), now())
        })
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 5000), key(), policy(), now())
        })
    }),
    Test("key size admission is strict", () => {
        small: Encoding.UTF8.encode("")
        for(i, 0, 31) { small.add(i) }
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), small, policy(), now())
        })
        valid: key()
        Assertions.require(
            String.recognizes(
                JWT.issue(claims(900, 1100), valid, policy(), now())
            )
        )
        large: Encoding.UTF8.encode("")
        for(i, 0, 4097) { large.add(0) }
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), large, policy(), now())
        })
    }),
    Test("maximum 4096-byte signing key is accepted", () => {
        largest: Encoding.UTF8.encode("")
        for(i, 0, 4096) {
            largest.add(i % 256)
        }

        instant: now()
        token: JWT.issue(claims(900, 1100), largest, policy(), instant)

        Assertions.require(
            JWT.verify(token, largest, policy(), instant).kind == "object"
        )
    }),
    Test("clock skew policy is bounded", () => {
        p: policy()
        p.clockSkewSeconds = 300
        token: JWT.issue(claims(900, 1100), key(), p, now())
        Assertions.require(String.recognizes(token))
        p.clockSkewSeconds = 301
        Assertions.signals(Error, () => {
            JWT.issue(claims(900, 1100), key(), p, now())
        })
    }),
    Test("fractional NumericDate is not an Integer", () => {
        bad: JSON.object(
            "iss", JSON.string("issuer"),
            "aud", JSON.string("audience"),
            "sub", JSON.string("subject"),
            "iat", JSON.number(9001, -1),
            "exp", JSON.number(1100, 0)
        )
        Assertions.signals(Error, () => {
            JWT.issue(bad, key(), policy(), now())
        })
    }),
    Test("integral decimal NumericDate is accepted", () => {
        exact: JSON.object(
            "iss", JSON.string("issuer"),
            "aud", JSON.string("audience"),
            "sub", JSON.string("subject"),
            "iat", JSON.number(9000, -1),
            "exp", JSON.number(11000, -1)
        )
        Assertions.require(
            String.recognizes(JWT.issue(exact, key(), policy(), now()))
        )
    })
]
tests.freeze()
