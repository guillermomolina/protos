Assertions: import("std:test/assertions")
Test: import("std:test/test")
JWT: import("std:auth/jwt")
Instant: import("std:datetime/instant")

token: "eyJhbGciOiJIUzI1NiIsInR5cCI6InJlYWx3b3JsZC1hY2Nlc3Mrand0In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicHJvdG9zLXJlYWx3b3JsZCIsInN1YiI6InVzZXItaWQtNDIiLCJpYXQiOjE3OTQwOTYwMDAsIm5iZiI6MTc5NDA5NjAwMCwiZXhwIjoxNzk0MDk5NjAwLCJqdGkiOiJpZC03In0.ClxaP-9Ot2XonmcSAQYbQ9ji7hbWNah62Yp059YFyl0"

key: () => {
    result: Encoding.UTF8.encode("")
    for(i, 0, 32) { result.add(i) }
    result
}

policy: () => {
    {
        issuer: "https://issuer.example"
        audience: "protos-realworld"
        type: "realworld-access+jwt"
        maxLifetimeSeconds: 3600
    }
}

now: () => Instant(1794097000000000000)

JSON: import("std:json/json")
Base64url: import("std:text/base64url")
HMAC: import("std:crypto/hmac_sha256")

// Construct a genuinely signed compact JWS from exact test-only text.
// These helpers never use JWT.issue, so malformed headers remain possible.
signedRaw: (headerText, payloadText) => {
    header: Base64url.encode(Encoding.UTF8.encode(headerText))
    payload: Base64url.encode(Encoding.UTF8.encode(payloadText))
    input: header + "." + payload
    signature: Base64url.encode(
        HMAC.digest(key(), Encoding.Latin1.encode(input))
    )
    input + "." + signature
}

fixturePayload: "{\"iss\":\"https://issuer.example\",\"aud\":\"protos-realworld\",\"sub\":\"user-id-42\",\"iat\":1794096000,\"exp\":1794099600}"

rejectSignedHeader: (headerText) => {
    candidate: signedRaw(headerText, fixturePayload)
    Assertions.signals(JWT.JwtError, () => {
        JWT.verify(candidate, key(), policy(), now())
    })
}

tests: [
    Test("signed algorithm confusion and forbidden JOSE parameters", () => {
                rejectSignedHeader("{\"alg\":\"none\",\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"alg\":\"RS256\",\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"alg\":\"ES256\",\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"alg\":null,\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"alg\":7,\"typ\":\"realworld-access+jwt\"}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"kid\":\"attacker\"}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"jku\":\"https://attacker.example/key\"}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"jwk\":{}}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"x5u\":\"https://attacker.example/cert\"}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"crit\":[\"exp\"]}")
        rejectSignedHeader("{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\",\"b64\":false}")
    }),
    Test("signed duplicate and escaped-equivalent JOSE keys", () => {
        rejectSignedHeader(
            "{\"alg\":\"HS256\",\"alg\":\"none\",\"typ\":\"realworld-access+jwt\"}"
        )
        rejectSignedHeader(
            "{\"alg\":\"HS256\",\"\\u0061lg\":\"none\",\"typ\":\"realworld-access+jwt\"}"
        )
    }),
    Test("validly signed payload with duplicate claims is rejected", () => {
        duplicate: "{\"iss\":\"https://issuer.example\",\"aud\":\"protos-realworld\",\"sub\":\"user-id-42\",\"sub\":\"attacker\",\"iat\":1794096000,\"exp\":1794099600}"
        candidate: signedRaw(
            "{\"alg\":\"HS256\",\"typ\":\"realworld-access+jwt\"}",
            duplicate
        )
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(candidate, key(), policy(), now())
        })
    }),
    Test("validly signed reordered JSON member names verify", () => {
        header: "{\"typ\":\"realworld-access+jwt\",\"alg\":\"HS256\"}"
        payload: "{\"exp\":1794099600,\"sub\":\"user-id-42\",\"iat\":1794096000,\"aud\":\"protos-realworld\",\"iss\":\"https://issuer.example\"}"
        candidate: signedRaw(header, payload)
        claims: JWT.verify(candidate, key(), policy(), now())
        Assertions.require(claims.value["sub"].value == "user-id-42")
    }),
    Test("unsigned and malformed compact representations fail", () => {
                Assertions.signals(JWT.JwtError, () => {
                JWT.verify("", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("abc", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a.b", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a.b.", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify(".b.c", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a..c", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a.b.c.d", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("é.b.c", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a+.b.c", key(), policy(), now())
            })
        Assertions.signals(JWT.JwtError, () => {
                JWT.verify("a=.b.c", key(), policy(), now())
            })
    }),
    Test("HS256 signature tampering fails", () => {
        replacement: "eyJhbGciOiJIUzI1NiIsInR5cCI6InJlYWx3b3JsZC1hY2Nlc3Mrand0In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicHJvdG9zLXJlYWx3b3JsZCIsInN1YiI6InVzZXItaWQtNDIiLCJpYXQiOjE3OTQwOTYwMDAsIm5iZiI6MTc5NDA5NjAwMCwiZXhwIjoxNzk0MDk5NjAwLCJqdGkiOiJpZC03In0.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(replacement, key(), policy(), now())
        })
    }),
    Test("wrong key fails authentication", () => {
        wrong: Encoding.UTF8.encode("")
        for(i, 0, 32) { wrong.add(255 - i) }
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(token, wrong, policy(), now())
        })
    }),
    Test("wrong protected type fails", () => {
        other: policy()
        other.type = "other+jwt"
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(token, key(), other, now())
        })
    }),
    Test("invalid trusted verification arguments remain ordinary Errors", () => {
        Assertions.signals(Error, () => {
            JWT.verify(token, key(), policy(), null)
        })

        Assertions.signals(Error, () => {
            JWT.verify(token, key(), null, now())
        })

        Assertions.signals(Error, () => {
            JWT.verify(token, Encoding.UTF8.encode("short"), policy(), now())
        })
    }),
    Test("fresh JWT failures have distinct identity", () => {
        first: null
        second: null
        Error.handle(
            () => { JWT.verify("bad", key(), policy(), now()) },
            (error) => { first = error }
        )
        Error.handle(
            () => { JWT.verify("bad", key(), policy(), now()) },
            (error) => { second = error }
        )
        Assertions.require(first !== null)
        Assertions.require(second !== null)
        Assertions.require(first !== second)
        Assertions.require(first.parent() === JWT.JwtError)
        Assertions.require(second.parent() === JWT.JwtError)
    })
]
tests.freeze()
