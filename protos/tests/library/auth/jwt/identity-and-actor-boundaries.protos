Assertions: import("std:test/assertions")
Test: import("std:test/test")
JWT: import("std:auth/jwt")
JSON: import("std:json/json")
Instant: import("std:datetime/instant")

key: () => {
    bytes: Encoding.UTF8.encode("")
    for(i, 0, 32) { bytes.add(i) }
    bytes
}

policy: () => {
    {
        issuer: "issuer"
        audience: "audience"
        type: "access+jwt"
        maxLifetimeSeconds: 3600
    }
}

claims: () => JSON.object(
    "iss", JSON.string("issuer"),
    "aud", JSON.string("audience"),
    "sub", JSON.string("actor-independent"),
    "iat", JSON.number(900, 0),
    "exp", JSON.number(1100, 0)
)

tests: [
    Test("independent verification returns fresh JSON nodes", () => {
        instant: Instant(1000000000000)
        token: JWT.issue(claims(), key(), policy(), instant)
        first: JWT.verify(token, key(), policy(), instant)
        second: JWT.verify(token, key(), policy(), instant)
        Assertions.require(first !== second)
        Assertions.require(first.value !== second.value)
        Assertions.require(first.value["sub"] !== second.value["sub"])
    }),
    Test("import does not acquire clock, network or key authority", () => {
        Assertions.require(JWT.hasSlot("now") == false)
        Assertions.require(JWT.hasSlot("clock") == false)
        Assertions.require(JWT.hasSlot("key") == false)
        Assertions.require(JWT.hasSlot("network") == false)
        Assertions.require(JWT.hasSlot("session") == false)
    }),
    Test("mutating a caller key does not change an issued token", () => {
        instant: Instant(1000000000000)
        supplied: key()
        token: JWT.issue(claims(), supplied, policy(), instant)
        supplied[0] = 255
        Assertions.require(
            JWT.verify(token, key(), policy(), instant).kind == "object"
        )
        Assertions.signals(JWT.JwtError, () => {
            JWT.verify(token, supplied, policy(), instant)
        })
    })
]
tests.freeze()
