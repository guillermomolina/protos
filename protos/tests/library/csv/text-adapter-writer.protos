CSV: import("std:csv/CSV")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

reject: (body) => {
    Error.handle(
        () => {
            body()
            false
        },
        (error) => {
            true
        }
    )
}

sink: ""
writes: 0
writer: null
writer = {
    writeText: (text) => {
        (() => {
            sink = sink + text
            writes = writes + 1
            writer
        }).future()
    }
}

stream: CSV.writeRows(writer)
first: stream.feed(Array("a", "b"))
second: first.then((resolvedStream) => {
    require(resolvedStream === stream)
    stream.feed(Array("x,y", "q\"z"))
})
finished: second.then((resolvedStream) => {
    require(resolvedStream === stream)
    stream.finish()
})

finished.then((resolvedStream) => {
    require(resolvedStream === stream)
    require(sink == "a,b\r\n\"x,y\",\"q\"\"z\"\r\n")
    require(writes == 3)
    require(reject(() => { stream.feed(Array("late")) }))
    require(reject(() => { stream.finish() }))
    true
})
