Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("text adapter overlap", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            readerCalls: 0
            reader: {
                readText: () => {
                    readerCalls = readerCalls + 1
                    (() => { "a\n" }).future()
                }
            }
            input: CSV.readRows(reader, (row) => { null })
            firstRead: input.read()
            Assertions.signals(Error, () => { input.read() })
            Assertions.require(readerCalls == 1)

            sink: ""
            writer: null
            writer = {
                writeText: (text) => {
                    (() => {
                        sink = sink + text
                        writer
                    }).future()
                }
            }
            output: CSV.writeRows(writer)
            firstWrite: output.feed(Array("a"))
            Assertions.signals(Error, () => { output.feed(Array("b")) })
            Assertions.signals(Error, () => { output.finish() })

            firstRead.then((more) => {
                Assertions.require(more === true)
                firstWrite.then((resolvedOutput) => {
                    Assertions.require(resolvedOutput === output)
                    Assertions.require(sink == "a\r\n")
                    true
                })
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("text adapter reader", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            chunks: Array("a,\"b", ",b\"\r", "\n", "c,d", null)
            index: 0
            reader: {
                readText: () => {
                    chunk: chunks[index]
                    index = index + 1
                    (() => { chunk }).future()
                }
            }

            rows: Map()
            count: 0
            stream: CSV.readRows(reader, (row) => {
                rows[count] = row
                count = count + 1
            })

            step1: stream.read()
            step2: step1.then((more) => {
                Assertions.require(more === true)
                stream.read()
            })
            step3: step2.then((more) => {
                Assertions.require(more === true)
                stream.read()
            })
            step4: step3.then((more) => {
                Assertions.require(more === true)
                stream.read()
            })
            step5: step4.then((more) => {
                Assertions.require(more === true)
                stream.read()
            })

            step5.then((more) => {
                Assertions.require(more === false)
                Assertions.require(count == 2)
                Assertions.require(rows[0].size() == 2)
                Assertions.require(rows[0][0] == "a")
                Assertions.require(rows[0][1] == "b,b")
                Assertions.require(rows[1].size() == 2)
                Assertions.require(rows[1][0] == "c")
                Assertions.require(rows[1][1] == "d")
                Assertions.signals(Error, () => { stream.read() })
                true
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    }),
    Test("text adapter terminal errors", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            badReader: {
                readText: () => {
                    Error().signal()
                }
            }
            input: CSV.readRows(badReader, (row) => { null })
            Assertions.signals(Error, () => { input.read() })
            Assertions.signals(Error, () => { input.read() })

            writerCalls: 0
            badWriter: {
                writeText: (text) => {
                    writerCalls = writerCalls + 1
                    Error().signal()
                }
            }
            output: CSV.writeRows(badWriter)
            Assertions.signals(Error, () => { output.feed(Array("a")) })
            Assertions.require(writerCalls == 1)
            Assertions.signals(Error, () => { output.feed(Array("b")) })
            Assertions.signals(Error, () => { output.finish() })
            Assertions.require(writerCalls == 1)

            invalidWriterCalls: 0
            unusedWriter: {
                writeText: (text) => {
                    invalidWriterCalls = invalidWriterCalls + 1
                    (() => { unusedWriter }).future()
                }
            }
            invalidOutput: CSV.writeRows(unusedWriter)
            Assertions.signals(Error, () => { invalidOutput.feed(Array()) })
            Assertions.require(invalidWriterCalls == 0)
            Assertions.signals(Error, () => { invalidOutput.feed(Array("later")) })
            Assertions.require(invalidWriterCalls == 0)

            Assertions.signals(Error, () => { CSV.readRows() })
            Assertions.signals(Error, () => { CSV.readRows({}, (row) => { null }, 1) })
            Assertions.signals(Error, () => { CSV.writeRows() })
            Assertions.signals(Error, () => { CSV.writeRows({}, {}) })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("text adapter writer", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            sink: ""
            writes: 0
            writer: null
            writer = {
                writeText: (text) => {
                    (() => {
                        sink = sink + text
                        writes = writes + 1
                        writer
                    }).future()
                }
            }

            stream: CSV.writeRows(writer)
            first: stream.feed(Array("a", "b"))
            second: first.then((resolvedStream) => {
                Assertions.require(resolvedStream === stream)
                stream.feed(Array("x,y", "q\"z"))
            })
            finished: second.then((resolvedStream) => {
                Assertions.require(resolvedStream === stream)
                stream.finish()
            })

            finished.then((resolvedStream) => {
                Assertions.require(resolvedStream === stream)
                Assertions.require(sink == "a,b\r\n\"x,y\",\"q\"\"z\"\r\n")
                Assertions.require(writes == 3)
                Assertions.signals(Error, () => { stream.feed(Array("late")) })
                Assertions.signals(Error, () => { stream.finish() })
                true
            })
        }
        Assertions.require(tool009LegacyCase().value() === true)
    })
]
tests.freeze()
