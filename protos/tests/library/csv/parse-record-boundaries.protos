CSV: import("std:csv/CSV")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

empty: CSV.parse("")
require(empty.size() == 0)

blankLf: CSV.parse("\n")
require(blankLf.size() == 1)
require(blankLf[0].size() == 1)
require(blankLf[0][0] == "")

blankCrLf: CSV.parse("\r\n")
require(blankCrLf.size() == 1)
require(blankCrLf[0][0] == "")

blankCr: CSV.parse("\r")
require(blankCr.size() == 1)
require(blankCr[0][0] == "")

twoBlanks: CSV.parse("\n\n")
require(twoBlanks.size() == 2)
require(twoBlanks[0][0] == "")
require(twoBlanks[1][0] == "")

mixed: CSV.parse("a\r\nb\nc\rd")
require(mixed.size() == 4)
require(mixed[0][0] == "a")
require(mixed[1][0] == "b")
require(mixed[2][0] == "c")
require(mixed[3][0] == "d")

trailingSeparator: CSV.parse("a\r\n")
require(trailingSeparator.size() == 1)
require(trailingSeparator[0][0] == "a")

embedded: CSV.parse("\"a\r\nb\",\"c\nd\",\"e\rf\"\r\nz")
require(embedded.size() == 2)
require(embedded[0].size() == 3)
require(embedded[0][0] == "a\r\nb")
require(embedded[0][1] == "c\nd")
require(embedded[0][2] == "e\rf")
require(embedded[1][0] == "z")

emptyQuoted: CSV.parse("\"\"")
require(emptyQuoted.size() == 1)
require(emptyQuoted[0].size() == 1)
require(emptyQuoted[0][0] == "")

true
