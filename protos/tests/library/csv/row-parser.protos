Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("row parser basic", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            rows: Map()
            count: 0
            parser: CSV.rowParser((row) => {
                rows[count] = row
                count = count + 1
            })

            Assertions.require(parser.feed("") === parser)
            Assertions.require(count == 0)
            Assertions.require(parser.feed("a,b\r") === parser)
            Assertions.require(count == 1)
            Assertions.require(rows[0].size() == 2)
            Assertions.require(rows[0][0] == "a")
            Assertions.require(rows[0][1] == "b")

            Assertions.require(parser.feed("") === parser)
            Assertions.require(parser.feed("\n\"c") === parser)
            Assertions.require(count == 1)
            Assertions.require(parser.feed(",d\",\"e\"\"f\"") === parser)
            Assertions.require(count == 1)
            Assertions.require(parser.finish() === parser)

            Assertions.require(count == 2)
            Assertions.require(rows[1].size() == 2)
            Assertions.require(rows[1][0] == "c,d")
            Assertions.require(rows[1][1] == "e\"f")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser boundaries", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            checkSplit: (left, right) => {
                rows: Map()
                count: 0

                parser: CSV.rowParser((row) => {
                    rows[count] = row
                    count = count + 1
                })

                parser.feed(left)
                parser.feed("")
                parser.feed(right)
                parser.finish()

                Assertions.require(count == 3)

                Assertions.require(rows[0].size() == 3)
                Assertions.require(rows[0][0] == "a")
                Assertions.require(rows[0][1] == "b,b")
                Assertions.require(rows[0][2] == "c\"d")

                Assertions.require(rows[1].size() == 2)
                Assertions.require(rows[1][0] == "x\r\ny")
                Assertions.require(rows[1][1] == "z")

                Assertions.require(rows[2].size() == 2)
                Assertions.require(rows[2][0] == "q")
                Assertions.require(rows[2][1] == "")

            }

            checkSplit("", "a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a", ",\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,", "\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"", "b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b", ",b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,", "b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b", "\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\"", ",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",", "\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"", "c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c", "\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"", "\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"", "d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d", "\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"", "\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r", "\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n", "\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"", "x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x", "\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r", "\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\n", "y\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny", "\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\"", ",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",", "z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z", "\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\r", "q,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq", ",")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,", "")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser independence", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            rowsA: Map()
            rowsB: Map()
            countA: 0
            countB: 0

            a: CSV.rowParser((row) => {
                rowsA[countA] = row
                countA = countA + 1
            })

            b: CSV.rowParser((row) => {
                rowsB[countB] = row
                countB = countB + 1
            })

            a.feed("\"left")
            b.feed("right,one\nright,two")
            Assertions.require(countA == 0)
            Assertions.require(countB == 1)

            a.feed(",continued\",x\n")
            Assertions.require(countA == 1)
            Assertions.require(rowsA[0][0] == "left,continued")
            Assertions.require(rowsA[0][1] == "x")

            b.finish()
            Assertions.require(countB == 2)
            Assertions.require(rowsB[0][0] == "right")
            Assertions.require(rowsB[0][1] == "one")
            Assertions.require(rowsB[1][0] == "right")
            Assertions.require(rowsB[1][1] == "two")

            a.finish()
            Assertions.require(countA == 1)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser lifecycle", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            finished: CSV.rowParser((row) => { null })
            finished.feed("a")
            Assertions.require(finished.finish() === finished)
            Assertions.signals(Error, () => { finished.feed("") })
            Assertions.signals(Error, () => { finished.finish() })

            unterminated: CSV.rowParser((row) => { null })
            unterminated.feed("\"abc")
            Assertions.signals(Error, () => { unterminated.finish() })
            Assertions.signals(Error, () => { unterminated.feed("x") })
            Assertions.signals(Error, () => { unterminated.finish() })

            emitted: 0
            malformed: CSV.rowParser((row) => {
                emitted = emitted + 1
            })
            malformed.feed("ok\r\n")
            Assertions.require(emitted == 1)
            Assertions.signals(Error, () => { malformed.feed("\"bad\"x") })
            Assertions.require(emitted == 1)
            Assertions.signals(Error, () => { malformed.feed("\r\n") })
            Assertions.signals(Error, () => { malformed.finish() })
            Assertions.require(emitted == 1)

            consumerCalls: 0
            consumerFailure: CSV.rowParser((row) => {
                consumerCalls = consumerCalls + 1
                Error().signal()
            })
            Assertions.signals(Error, () => { consumerFailure.feed("a\n") })
            Assertions.require(consumerCalls == 1)
            Assertions.signals(Error, () => { consumerFailure.feed("b\n") })
            Assertions.signals(Error, () => { consumerFailure.finish() })
            Assertions.require(consumerCalls == 1)

            flushCount: 0
            flushed: null
            flush: CSV.rowParser((row) => {
                flushCount = flushCount + 1
                flushed = row
            })
            flush.feed("final,row")
            Assertions.require(flushCount == 0)
            flush.finish()
            Assertions.require(flushCount == 1)
            Assertions.require(flushed.size() == 2)
            Assertions.require(flushed[0] == "final")
            Assertions.require(flushed[1] == "row")

            Assertions.signals(Error, () => { CSV.rowParser() })
            Assertions.signals(Error, () => { CSV.rowParser((row) => { null }, (row) => { null }) })

            wrongFeed: CSV.rowParser((row) => { null })
            Assertions.signals(Error, () => { wrongFeed.feed() })
            Assertions.signals(Error, () => { wrongFeed.feed("a", "b") })
            Assertions.signals(Error, () => { wrongFeed.feed(42) })

            wrongFinish: CSV.rowParser((row) => { null })
            Assertions.signals(Error, () => { wrongFinish.finish("x") })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
