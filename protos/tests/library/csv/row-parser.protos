Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("row parser basic", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            rows: Map()
            count: 0
            parser: CSV.rowParser((row) => {
                rows[count] = row
                count = count + 1
            })

            require(parser.feed("") === parser)
            require(count == 0)
            require(parser.feed("a,b\r") === parser)
            require(count == 1)
            require(rows[0].size() == 2)
            require(rows[0][0] == "a")
            require(rows[0][1] == "b")

            require(parser.feed("") === parser)
            require(parser.feed("\n\"c") === parser)
            require(count == 1)
            require(parser.feed(",d\",\"e\"\"f\"") === parser)
            require(count == 1)
            require(parser.finish() === parser)

            require(count == 2)
            require(rows[1].size() == 2)
            require(rows[1][0] == "c,d")
            require(rows[1][1] == "e\"f")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser boundaries", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            checkSplit: (left, right) => {
                rows: Map()
                count: 0

                parser: CSV.rowParser((row) => {
                    rows[count] = row
                    count = count + 1
                })

                parser.feed(left)
                parser.feed("")
                parser.feed(right)
                parser.finish()

                require(count == 3)

                require(rows[0].size() == 3)
                require(rows[0][0] == "a")
                require(rows[0][1] == "b,b")
                require(rows[0][2] == "c\"d")

                require(rows[1].size() == 2)
                require(rows[1][0] == "x\r\ny")
                require(rows[1][1] == "z")

                require(rows[2].size() == 2)
                require(rows[2][0] == "q")
                require(rows[2][1] == "")

            }

            checkSplit("", "a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a", ",\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,", "\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"", "b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b", ",b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,", "b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b", "\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\"", ",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",", "\"c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"", "c\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c", "\"\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"", "\"d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"", "d\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d", "\"\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"", "\r\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r", "\n\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n", "\"x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"", "x\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x", "\r\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r", "\ny\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\n", "y\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny", "\",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\"", ",z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",", "z\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z", "\rq,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\r", "q,")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq", ",")
            checkSplit("a,\"b,b\",\"c\"\"d\"\r\n\"x\r\ny\",z\rq,", "")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser independence", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            rowsA: Map()
            rowsB: Map()
            countA: 0
            countB: 0

            a: CSV.rowParser((row) => {
                rowsA[countA] = row
                countA = countA + 1
            })

            b: CSV.rowParser((row) => {
                rowsB[countB] = row
                countB = countB + 1
            })

            a.feed("\"left")
            b.feed("right,one\nright,two")
            require(countA == 0)
            require(countB == 1)

            a.feed(",continued\",x\n")
            require(countA == 1)
            require(rowsA[0][0] == "left,continued")
            require(rowsA[0][1] == "x")

            b.finish()
            require(countB == 2)
            require(rowsB[0][0] == "right")
            require(rowsB[0][1] == "one")
            require(rowsB[1][0] == "right")
            require(rowsB[1][1] == "two")

            a.finish()
            require(countA == 1)

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("row parser lifecycle", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            require: (condition) => {
                condition.ifFalse(() => {
                    Error().signal()
                })
            }

            reject: (body) => {
                Error.handle(
                    () => {
                        body()
                        false
                    },
                    (error) => {
                        true
                    }
                )
            }

            finished: CSV.rowParser((row) => { null })
            finished.feed("a")
            require(finished.finish() === finished)
            require(reject(() => { finished.feed("") }))
            require(reject(() => { finished.finish() }))

            unterminated: CSV.rowParser((row) => { null })
            unterminated.feed("\"abc")
            require(reject(() => { unterminated.finish() }))
            require(reject(() => { unterminated.feed("x") }))
            require(reject(() => { unterminated.finish() }))

            emitted: 0
            malformed: CSV.rowParser((row) => {
                emitted = emitted + 1
            })
            malformed.feed("ok\r\n")
            require(emitted == 1)
            require(reject(() => { malformed.feed("\"bad\"x") }))
            require(emitted == 1)
            require(reject(() => { malformed.feed("\r\n") }))
            require(reject(() => { malformed.finish() }))
            require(emitted == 1)

            consumerCalls: 0
            consumerFailure: CSV.rowParser((row) => {
                consumerCalls = consumerCalls + 1
                Error().signal()
            })
            require(reject(() => { consumerFailure.feed("a\n") }))
            require(consumerCalls == 1)
            require(reject(() => { consumerFailure.feed("b\n") }))
            require(reject(() => { consumerFailure.finish() }))
            require(consumerCalls == 1)

            flushCount: 0
            flushed: null
            flush: CSV.rowParser((row) => {
                flushCount = flushCount + 1
                flushed = row
            })
            flush.feed("final,row")
            require(flushCount == 0)
            flush.finish()
            require(flushCount == 1)
            require(flushed.size() == 2)
            require(flushed[0] == "final")
            require(flushed[1] == "row")

            require(reject(() => { CSV.rowParser() }))
            require(reject(() => { CSV.rowParser((row) => { null }, (row) => { null }) }))

            wrongFeed: CSV.rowParser((row) => { null })
            require(reject(() => { wrongFeed.feed() }))
            require(reject(() => { wrongFeed.feed("a", "b") }))
            require(reject(() => { wrongFeed.feed(42) }))

            wrongFinish: CSV.rowParser((row) => { null })
            require(reject(() => { wrongFinish.finish("x") }))

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
