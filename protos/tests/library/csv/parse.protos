Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parse basic", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            simple: CSV.parse("alpha,beta,gamma")
            Assertions.require(simple.size() == 1)
            Assertions.require(simple[0].size() == 3)
            Assertions.require(simple[0][0] == "alpha")
            Assertions.require(simple[0][1] == "beta")
            Assertions.require(simple[0][2] == "gamma")

            quoted: CSV.parse("\"a,b\",\"a\"\"b\",plain")
            Assertions.require(quoted.size() == 1)
            Assertions.require(quoted[0].size() == 3)
            Assertions.require(quoted[0][0] == "a,b")
            Assertions.require(quoted[0][1] == "a\"b")
            Assertions.require(quoted[0][2] == "plain")

            empties: CSV.parse(",x,")
            Assertions.require(empties.size() == 1)
            Assertions.require(empties[0].size() == 3)
            Assertions.require(empties[0][0] == "")
            Assertions.require(empties[0][1] == "x")
            Assertions.require(empties[0][2] == "")

            variable: CSV.parse("a\nb,c\nd,e,f")
            Assertions.require(variable.size() == 3)
            Assertions.require(variable[0].size() == 1)
            Assertions.require(variable[1].size() == 2)
            Assertions.require(variable[2].size() == 3)

            whitespace: CSV.parse("  a , b\t,\" c \"")
            Assertions.require(whitespace[0][0] == "  a ")
            Assertions.require(whitespace[0][1] == " b\t")
            Assertions.require(whitespace[0][2] == " c ")

            unicode: CSV.parse("é,雪,\"🙂,ñ\"")
            Assertions.require(unicode[0][0] == "é")
            Assertions.require(unicode[0][1] == "雪")
            Assertions.require(unicode[0][2] == "🙂,ñ")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse invalid", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            Assertions.signals(Error, () => { CSV.parse("a\"b") })
            Assertions.signals(Error, () => { CSV.parse("\"a\"b") })
            Assertions.signals(Error, () => { CSV.parse("\"a") })
            Assertions.signals(Error, () => { CSV.parse("\"a\"\"") })
            Assertions.signals(Error, () => { CSV.parse("a,\"b\"c") })
            Assertions.signals(Error, () => { CSV.parse("\"a\" ,b") })
            Assertions.signals(Error, () => { CSV.parse(" ,\"x\"\"y\"z") })

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("parse record boundaries", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            empty: CSV.parse("")
            Assertions.require(empty.size() == 0)

            blankLf: CSV.parse("\n")
            Assertions.require(blankLf.size() == 1)
            Assertions.require(blankLf[0].size() == 1)
            Assertions.require(blankLf[0][0] == "")

            blankCrLf: CSV.parse("\r\n")
            Assertions.require(blankCrLf.size() == 1)
            Assertions.require(blankCrLf[0][0] == "")

            blankCr: CSV.parse("\r")
            Assertions.require(blankCr.size() == 1)
            Assertions.require(blankCr[0][0] == "")

            twoBlanks: CSV.parse("\n\n")
            Assertions.require(twoBlanks.size() == 2)
            Assertions.require(twoBlanks[0][0] == "")
            Assertions.require(twoBlanks[1][0] == "")

            mixed: CSV.parse("a\r\nb\nc\rd")
            Assertions.require(mixed.size() == 4)
            Assertions.require(mixed[0][0] == "a")
            Assertions.require(mixed[1][0] == "b")
            Assertions.require(mixed[2][0] == "c")
            Assertions.require(mixed[3][0] == "d")

            trailingSeparator: CSV.parse("a\r\n")
            Assertions.require(trailingSeparator.size() == 1)
            Assertions.require(trailingSeparator[0][0] == "a")

            embedded: CSV.parse("\"a\r\nb\",\"c\nd\",\"e\rf\"\r\nz")
            Assertions.require(embedded.size() == 2)
            Assertions.require(embedded[0].size() == 3)
            Assertions.require(embedded[0][0] == "a\r\nb")
            Assertions.require(embedded[0][1] == "c\nd")
            Assertions.require(embedded[0][2] == "e\rf")
            Assertions.require(embedded[1][0] == "z")

            emptyQuoted: CSV.parse("\"\"")
            Assertions.require(emptyQuoted.size() == 1)
            Assertions.require(emptyQuoted[0].size() == 1)
            Assertions.require(emptyQuoted[0][0] == "")

            true
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("arity domain rejection", () => {
        tool009LegacyCase: () => {
            CSV: import("std:csv/CSV")

            Assertions.signals(Error, () => { CSV.parse() })
            Assertions.signals(Error, () => { CSV.parse("a", "b") })
            Assertions.signals(Error, () => { CSV.parse(42) })
            Assertions.signals(Error, () => { CSV.parse(null) })
            Assertions.signals(Error, () => { CSV.parse(Array("a")) })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
]
tests.freeze()
