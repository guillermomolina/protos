CSV: import("std:csv/CSV")

require: (condition) => {
    condition.ifFalse(() => {
        Error().signal()
    })
}

rowsA: Map()
rowsB: Map()
countA: 0
countB: 0

a: CSV.rowParser((row) => {
    rowsA[countA] = row
    countA = countA + 1
})

b: CSV.rowParser((row) => {
    rowsB[countB] = row
    countB = countB + 1
})

a.feed("\"left")
b.feed("right,one\nright,two")
require(countA == 0)
require(countB == 1)

a.feed(",continued\",x\n")
require(countA == 1)
require(rowsA[0][0] == "left,continued")
require(rowsA[0][1] == "x")

b.finish()
require(countB == 2)
require(rowsB[0][0] == "right")
require(rowsB[0][1] == "one")
require(rowsB[1][0] == "right")
require(rowsB[1][1] == "two")

a.finish()
require(countA == 1)

true
