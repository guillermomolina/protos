// I130-B (D220–S12, TLS.md §§2, 3, 4, 6): module surface, Trust construction,
// options and reference-identity admission of std:tls/Client. No TLS octet is
// exchanged here; every inadmissible call must leave the duplex untouched.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
tls: import("std:tls/Client")
IpAddresses: import("std:network/IpAddresses")

// Bytes from lowercase hexadecimal text.
hexBytes: (text) => {
    digits: "0123456789abcdef"
    valueOf: (character) => {
        found: -1
        index: 0
        while(index < 16) {
            if(digits[index] == character) {
                found = index
            }
            index = index + 1
        }
        found
    }
    result: Encoding.Latin1.encode("")
    index: 0
    while(index < text.size()) {
        result.add(valueOf(text[index]) * 16 + valueOf(text[index + 1]))
        index = index + 2
    }
    result
}

// DER of the test fixture "Protos Test Root CA" (src/test/resources/tls/root-ca.pem):
// basicConstraints cA, keyUsage keyCertSign.
rootCaHex: "3082018230820128a00302010202147d0823f568ea6e31f1f725f30954c5a6dca1b8da30" + "0a06082a8648ce3d040302301e311c301a06035504030c1350726f746f73205465737420" + "526f6f742043413020170d3236313032383039303431395a180f32313236313030343039" + "303431395a301e311c301a06035504030c1350726f746f73205465737420526f6f742043" + "413059301306072a8648ce3d020106082a8648ce3d030107034200043579be65dacd6be6" + "f388e78d3e9256c35b09e6bc811bcad2fdf69ba251f75caf299eeacb1d02de80ede4c425" + "ae32156f2242d8f7400c0f89f0c5d22e459553eda3423040300f0603551d130101ff0405" + "30030101ff300e0603551d0f0101ff040403020106301d0603551d0e0416041489e55783" + "29dea317bd455304de84851aa53b4d54300a06082a8648ce3d0403020348003045022033" + "a9fbd94d5bfff5bb0a4a78f91aa46991a6e484fd0a51306c43679fe784db7b0221008d81" + "916b6aefff66ec7a3aa67dd85430436703329b4d3d07ba343012a65f9ded"

// DER of the fixture end-entity "service-leaf" (cA false): never an anchor.
leafHex: "308201f83082019ea003020102020103300a06082a8648ce3d0403023026312430220603" + "5504030c1b50726f746f73205465737420496e7465726d6564696174652043413020170d" + "3236313032383039303431395a180f32313236313030343039303431395a301e311c301a" + "06035504030c13636e2d6f6e6c792e70726f746f732e746573743059301306072a8648ce" + "3d020106082a8648ce3d030107034200041940bc51b420625c562ded9e368025527e9df2" + "8c7fcf927e9b7c9dcf5ff3ad8ac450ed088de6799287094e9234d1793f13ac093f8fcf39" + "086a30d447c9fbe626a381c23081bf300c0603551d130101ff04023000300e0603551d0f" + "0101ff04040302078030130603551d25040c300a06082b06010505070301304a0603551d" + "11044330418213736572766963652e70726f746f732e7465737482122a2e77696c642e70" + "726f746f732e7465737487047f000001871000000000000000000000000000000001301f" + "0603551d2304183016801416eccce878ac5e86f84d63166059f48c428cca51301d060355" + "1d0e04160414d05883e3eb7b998994e816fedcfe09aaf3b8d327300a06082a8648ce3d04" + "03020348003045022100a67eb72fe8fc77b68f6e1973e76767c682a859570ae9dc9b9811" + "3e8153be7cf6022050bfab0048f24229841f735253f75ee158eff6d2c42aa85a9bf3266f" + "e4337dcb"

rootCa: () => {
    hexBytes(rootCaHex)
}

// A duplex that records every call and answers end of input to every read.
quietDuplex: () => {
    reads: 0
    writes: 0
    closes: 0
    fixture: {
        read: (maxBytes) => {
            reads = reads + 1
            (() => { null }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            (() => { fixture }).future()
        }
        close: () => {
            closes = closes + 1
            (() => { null }).future()
        }
        effects: () => {
            reads + writes + closes
        }
    }
    fixture
}

failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

anchors: () => {
    tls.Trust.anchors([rootCa()])
}

// Asserts that both selectors reject the arguments with fresh
// InvalidIOArgument Futures and no effect on the duplex.
assertInadmissible: (duplex, serverIdentity, trust, options) => {
    borrowed: failureOf(tls.Client.handshake(duplex, serverIdentity, trust, options))
    owning: failureOf(tls.Client.handshake.owning(duplex, serverIdentity, trust, options))
    Assertions.require(borrowed.parent() === InvalidIOArgument)
    Assertions.require(owning.parent() === InvalidIOArgument)
    Assertions.require(borrowed !== owning)
}

assertIdentityRejected: (serverIdentity) => {
    dx: quietDuplex()
    assertInadmissible(dx, serverIdentity, anchors(), {})
    Assertions.require(dx.effects() == 0)
}

assertOptionsRejected: (options) => {
    dx: quietDuplex()
    assertInadmissible(dx, "service.protos.test", anchors(), options)
    Assertions.require(dx.effects() == 0)
}

assertConstructorError: (certificates) => {
    Assertions.signals(Error, () => {
        tls.Trust.anchors(certificates)
    })
}

tests: [
    Test("module exports exactly Client, Trust and TlsError", () => {
        names: tls.slotNames()
        Assertions.require(names.size() == 3)
        Assertions.require(tls.hasSlot("Client"))
        Assertions.require(tls.hasSlot("Trust"))
        Assertions.require(tls.hasSlot("TlsError"))
        Assertions.require(!tls.hasSlot("_tlsBackendFacility"))
    }),
    Test("the public names are not Prelude bindings and the facility is private", () => {
        Assertions.signals(SlotNotFound, () => { TlsError })
        Assertions.signals(SlotNotFound, () => { Trust })
        Assertions.signals(SlotNotFound, () => { _tlsBackendFacility })
        Assertions.require(!tls.Client.hasSlot("_tlsBackendFacility"))
    }),
    Test("TlsError delegates directly to Error", () => {
        Assertions.require(tls.TlsError.parent() === Error)
    }),
    Test("repeated import answers the same Actor-local module instance", () => {
        Assertions.require(import("std:tls/Client") === tls)
    }),
    Test("Trust constructors answer fresh descriptors without slots", () => {
        first: tls.Trust.javaCacerts()
        second: tls.Trust.javaCacerts()
        Assertions.require(first !== second)
        Assertions.require(first.slotNames().size() == 0)
        Assertions.require(tls.Trust.system() !== tls.Trust.system())
        Assertions.require(anchors() !== anchors())
    }),
    Test("Trust.anchors rejects malformed arguments synchronously", () => {
        assertConstructorError(null)
        assertConstructorError(rootCa())
        assertConstructorError([])
        assertConstructorError(["not bytes"])
        assertConstructorError([Encoding.Latin1.encode("")])
        assertConstructorError([Encoding.Latin1.encode("-----BEGIN CERTIFICATE-----")])
        trailing: rootCa()
        trailing.add(0)
        assertConstructorError([trailing])
    }),
    Test("Trust.anchors accepts only usable CA certificates", () => {
        assertConstructorError([hexBytes(leafHex)])
        assertConstructorError([rootCa(), hexBytes(leafHex)])
    }),
    Test("Trust.anchors enforces the count bound", () => {
        certificate: rootCa()
        many: []
        index: 0
        while(index < 257) {
            many = Array(...many, certificate)
            index = index + 1
        }
        assertConstructorError(many)
    }),
    Test("Trust.anchors enforces the per-certificate size bound", () => {
        oversized: rootCa()
        while(oversized.size() <= 65536) {
            oversized.add(0)
        }
        assertConstructorError([oversized])
    }),
    Test("Trust.anchors snapshots the Array and every member", () => {
        certificate: rootCa()
        list: [certificate]
        trust: tls.Trust.anchors(list)
        certificate.add(0)
        // Core Arrays keep a fixed length; replacing the element mutates it.
        list.atPut(0, "not bytes")
        // The snapshot still admits and resolves: the handshake reaches the
        // transport and fails only on its end of input.
        dx: quietDuplex()
        failure: failureOf(tls.Client.handshake(dx, "service.protos.test", trust, {}))
        Assertions.require(failure.parent() === tls.TlsError)
        Assertions.require(failure.kind != "trustUnavailable")
        Assertions.require(dx.effects() > 0)
    }),
    Test("a descriptor-shaped object is not a trust descriptor", () => {
        dx: quietDuplex()
        assertInadmissible(dx, "service.protos.test", {}, {})
        assertInadmissible(dx, "service.protos.test", null, {})
        Assertions.require(dx.effects() == 0)
    }),
    Test("the duplex must provide read and write, and owning also close", () => {
        writeOnly: {
            write: (bytes) => {
                (() => { null }).future()
            }
            close: () => {
                (() => { null }).future()
            }
        }
        assertInadmissible(writeOnly, "service.protos.test", anchors(), {})
        noClose: {
            read: (maxBytes) => {
                (() => { null }).future()
            }
            write: (bytes) => {
                (() => { null }).future()
            }
        }
        // The inherited Object.close is not a Closable close.
        failure: failureOf(tls.Client.handshake.owning(noClose, "service.protos.test", anchors(), {}))
        Assertions.require(failure.parent() === InvalidIOArgument)
    }),
    Test("DNS references must be ASCII LDH names of at least two labels", () => {
        assertIdentityRejected(42)
        assertIdentityRejected("localhost")
        assertIdentityRejected("")
        assertIdentityRejected(".")
        assertIdentityRejected("a..b")
        assertIdentityRejected(".a.b")
        assertIdentityRejected("-a.b")
        assertIdentityRejected("a-.b")
        assertIdentityRejected("a_b.test")
        assertIdentityRejected("*.protos.test")
        assertIdentityRejected("a.b..")
        assertIdentityRejected("bücher.test")
        assertIdentityRejected("a.b c")
    }),
    Test("DNS labels and names are bounded", () => {
        label: ""
        while(label.size() < 64) {
            label = label + "a"
        }
        assertIdentityRejected(label + ".test")
        name: "a"
        while(name.size() < 254) {
            name = name + ".a"
        }
        assertIdentityRejected(name)
    }),
    Test("numeric IP literal Strings are not references", () => {
        assertIdentityRejected("127.0.0.1")
        assertIdentityRejected("127.0.0.1.")
        assertIdentityRejected("::1")
    }),
    Test("reserved LDH labels other than xn-- A-labels are inadmissible", () => {
        assertIdentityRejected("ab--cd.example")
        assertIdentityRejected("ab--cd.test")
        assertIdentityRejected("a1--b.test")
    }),
    Test("Unicode U-label input is rejected, never converted", () => {
        assertIdentityRejected("bücher.example")
        assertIdentityRejected("faß.example")
        assertIdentityRejected("テスト.test")
        assertIdentityRejected("xn--bcher-kva.bücher.example")
    }),
    Test("malformed A-labels and invalid Punycode are inadmissible", () => {
        // Truncated digits, delimiter-only payload, an invalid first digit.
        assertIdentityRejected("xn--zz.test")
        assertIdentityRejected("xn--.test")
        assertIdentityRejected("xn---kva.test")
        // Arithmetic overflow and a decoded surrogate (U+D800).
        assertIdentityRejected("xn--999999999999.test")
        assertIdentityRejected("xn--en32g.test")
        assertIdentityRejected("xn--dn32ge.test")
        assertIdentityRejected("xn--ib9b.test")
        // An A-label of 64 octets.
        long: "xn--"
        while(long.size() < 64) {
            long = long + "a"
        }
        assertIdentityRejected(long + ".test")
    }),
    Test("A-labels whose U-label violates IDNA2008 are inadmissible", () => {
        // U+0080, a control: DISALLOWED.
        assertIdentityRejected("xn--a.test")
        // "aÜ": U+00DC is unstable under NFKC case folding.
        assertIdentityRejected("xn--a-kfa.test")
        // "a" U+0378: unassigned.
        assertIdentityRejected("xn--a-qib.test")
        // "bu" U+0308 "cher": not NFC.
        assertIdentityRejected("xn--bucher-xyd.test")
        // U+0308 "bc": a leading combining mark.
        assertIdentityRejected("xn--bc-tub.test")
        // "ab--ü": hyphens in the third and fourth U-label positions.
        assertIdentityRejected("xn--ab---3ra.test")
    }),
    Test("CONTEXTJ, CONTEXTO and Bidi violations are inadmissible", () => {
        // "a" U+200C "b": ZWNJ without a virama or joining context.
        assertIdentityRejected("xn--ab-j1t.test")
        // "a" U+00B7 "b": MIDDLE DOT not between two "l".
        assertIdentityRejected("xn--ab-0ea.test")
        // "a" U+30FB "b": KATAKANA MIDDLE DOT without Hiragana, Katakana or Han.
        assertIdentityRejected("xn--ab-3n4a.test")
        // "a" U+05D0: a left-to-right label holding a right-to-left letter.
        assertIdentityRejected("xn--a-0hc.test")
        // A label beginning with a digit in a name with a Hebrew label.
        assertIdentityRejected("1a.xn--4dbrk0ce")
    }),
    Test("a reference is never a wildcard, even over A-labels", () => {
        assertIdentityRejected("*.xn--bcher-kva.example")
        assertIdentityRejected("xn--*.example")
    }),
    Test("valid A-labels are admitted in any ASCII case with a terminal dot", () => {
        admitted: (serverIdentity) => {
            future: tls.Client.handshake(quietDuplex(), serverIdentity, tls.Trust.system(), {})
            failure: failureOf(future)
            Assertions.require(failure.parent() === tls.TlsError)
            Assertions.require(failure.kind == "trustUnavailable")
        }
        // bücher, faß, l·l, ישראל, テスト, рф.
        admitted("xn--bcher-kva.example")
        admitted("XN--BCHER-KVA.Example")
        admitted("www.xn--bcher-kva.example.")
        admitted("xn--fa-hia.example")
        admitted("xn--ll-0ea.example")
        admitted("xn--4dbrk0ce.example")
        admitted("xn--zckzah.test")
        admitted("service.XN--p1ai")
    }),
    Test("NR-LDH names, case, a terminal dot and IpAddress values are admitted", () => {
        admitted: (serverIdentity) => {
            future: tls.Client.handshake(quietDuplex(), serverIdentity, tls.Trust.system(), {})
            failure: failureOf(future)
            // Admitted: the Task ran and failed on trust, not on admission.
            Assertions.require(failure.parent() === tls.TlsError)
            Assertions.require(failure.kind == "trustUnavailable")
        }
        admitted("a-b--c.test")
        admitted("xn-a.test")
        admitted("Service.Protos.TEST")
        admitted("service.protos.test.")
        admitted("1a.example")
        admitted(IpAddresses.v4(127, 0, 0, 1))
        admitted(IpAddresses.parse("::1"))
    }),
    Test("options must be an ordinary object", () => {
        assertOptionsRejected(null)
        assertOptionsRejected([])
        assertOptionsRejected("options")
    }),
    Test("options reject unknown fields and invalid values", () => {
        assertOptionsRejected({ minimumVersion: "1.1" })
        assertOptionsRejected({ minimumVersion: 1.3 })
        assertOptionsRejected({ alpn: "h2" })
        assertOptionsRejected({ alpn: false })
        assertOptionsRejected({ maxHandshakeBytes: 0 })
        assertOptionsRejected({ maxHandshakeBytes: 2147483648 })
        assertOptionsRejected({ maxQueuedWriteBytes: -1 })
        assertOptionsRejected({ maxQueuedWriteBytes: "1" })
        assertOptionsRejected({ timeout: 1 })
    }),
    Test("options reject a recognized field obtained only by delegation", () => {
        base: {
            minimumVersion: "1.3"
        }
        delegated: base {}
        assertOptionsRejected(delegated)
    }),
    Test("every documented option value is admitted", () => {
        accepted: (options) => {
            failure: failureOf(tls.Client.handshake(quietDuplex(), "service.protos.test", tls.Trust.system(), options))
            Assertions.require(failure.kind == "trustUnavailable")
        }
        accepted({})
        accepted({ minimumVersion: "1.2" })
        accepted({ minimumVersion: "1.3" })
        accepted({ alpn: "http/1.1" })
        accepted({ alpn: null })
        bounds: {
            maxHandshakeBytes: 1
            maxQueuedWriteBytes: 2147483647
        }
        accepted(bounds)
    }),
    Test("invalid admission answers fresh failed Futures without effects", () => {
        dx: quietDuplex()
        first: tls.Client.handshake(dx, "localhost", anchors(), {})
        second: tls.Client.handshake(dx, "localhost", anchors(), {})
        Assertions.require(first !== second)
        Assertions.require(failureOf(first) !== failureOf(second))
        Assertions.require(dx.effects() == 0)
    })
]
