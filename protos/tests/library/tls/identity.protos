// I130-B (D220–S12, TLS.md §4, RFC 9525 §6.3): the portable reference-identity
// policy of std:tls/Client, exercised directly with controlled subjectAltName
// inputs. The internal module is an unpublished implementation artifact; these
// cases need no certificate.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
Identity: import("std:tls/internal/Identity")
IpAddresses: import("std:network/IpAddresses")

// Whether reference matches a peer presenting exactly the DNS-ID presented.
matchesDns: (reference, presented) => {
    Identity.matches(Identity.reference(reference), [presented], [])
}

tests: [
    Test("a wildcard is the whole leftmost label and matches exactly one label", () => {
        Assertions.require(matchesDns("host.test", "*.test"))
        Assertions.require(!matchesDns("a.host.test", "*.test"))
        Assertions.require(matchesDns("api.wild.protos.test", "*.wild.protos.test"))
        Assertions.require(!matchesDns("wild.protos.test", "*.wild.protos.test"))
    }),
    Test("partial-label, embedded and multiple wildcards never match", () => {
        Assertions.require(!matchesDns("host.test", "h*.test"))
        Assertions.require(!matchesDns("host.test", "*st.test"))
        Assertions.require(!matchesDns("a.host.test", "*.*.test"))
        Assertions.require(!matchesDns("a.host.test", "a.*.test"))
        Assertions.require(!matchesDns("host.test", "*"))
    }),
    Test("DNS-IDs compare ASCII case-insensitively with one terminal dot removed", () => {
        Assertions.require(matchesDns("Service.Protos.Test", "SERVICE.protos.TEST"))
        Assertions.require(matchesDns("service.protos.test.", "service.protos.test"))
        Assertions.require(!matchesDns("service.protos.test", "service.protos"))
    }),
    Test("presented DNS-IDs with a reserved LDH label are ineligible", () => {
        Assertions.require(!matchesDns("host.test", "*.xn--bcher-kva.test"))
        Assertions.require(!matchesDns("ab.test", "ab--.test"))
        // The reference itself stays valid; only the reserved DNS-ID is skipped.
        Assertions.require(Identity.matches(Identity.reference("host.test"), ["xn--zz.test", "host.test"], []))
    }),
    Test("non-ASCII presented DNS-IDs never match", () => {
        Assertions.require(!matchesDns("host.test", "höst.test"))
    }),
    Test("IP references match exact SAN octets only", () => {
        loopback: Identity.reference(IpAddresses.v4(127, 0, 0, 1))
        Assertions.require(loopback.sni === null)
        exact: Encoding.Latin1.encode("")
        exact.add(127)
        exact.add(0)
        exact.add(0)
        exact.add(1)
        Assertions.require(Identity.matches(loopback, [], [exact]))
        // A DNS-ID spelling the address is never an IP identity.
        Assertions.require(!Identity.matches(loopback, ["127.0.0.1"], []))
        mapped: Encoding.Latin1.encode("")
        index: 0
        while(index < 10) {
            mapped.add(0)
            index = index + 1
        }
        mapped.add(255)
        mapped.add(255)
        mapped.add(127)
        mapped.add(0)
        mapped.add(0)
        mapped.add(1)
        Assertions.require(!Identity.matches(loopback, [], [mapped]))
    }),
    Test("a DNS reference sends its normalized name as SNI", () => {
        Assertions.require(Identity.reference("Service.Protos.Test.").sni == "service.protos.test")
        Assertions.require(Identity.reference("xn--bcher-kva.test") === null)
    })
]
