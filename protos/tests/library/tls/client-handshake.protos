// I130-B (D220–S12, TLS.md §§2.1, 3, 8, 9, 10): handshake Task outcomes that
// need no TLS peer, over a scripted duplex: fail-closed trust before any
// octet, conservative failure kinds, limits, truncation, transport Error
// identity, cancellation and borrowed/owning custody. Successful handshakes
// against a real peer are covered by ProtosTlsClientIntegrationTest.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")
tls: import("std:tls/Client")

// Bytes from lowercase hexadecimal text.
hexBytes: (text) => {
    digits: "0123456789abcdef"
    valueOf: (character) => {
        found: -1
        index: 0
        while(index < 16) {
            if(digits[index] == character) {
                found = index
            }
            index = index + 1
        }
        found
    }
    result: Encoding.Latin1.encode("")
    index: 0
    while(index < text.size()) {
        result.add(valueOf(text[index]) * 16 + valueOf(text[index + 1]))
        index = index + 2
    }
    result
}

// DER of the test fixture "Protos Test Root CA" (src/test/resources/tls/root-ca.pem).
rootCaHex: "3082018230820128a00302010202147d0823f568ea6e31f1f725f30954c5a6dca1b8da30" + "0a06082a8648ce3d040302301e311c301a06035504030c1350726f746f73205465737420" + "526f6f742043413020170d3236313032383039303431395a180f32313236313030343039" + "303431395a301e311c301a06035504030c1350726f746f73205465737420526f6f742043" + "413059301306072a8648ce3d020106082a8648ce3d030107034200043579be65dacd6be6" + "f388e78d3e9256c35b09e6bc811bcad2fdf69ba251f75caf299eeacb1d02de80ede4c425" + "ae32156f2242d8f7400c0f89f0c5d22e459553eda3423040300f0603551d130101ff0405" + "30030101ff300e0603551d0f0101ff040403020106301d0603551d0e0416041489e55783" + "29dea317bd455304de84851aa53b4d54300a06082a8648ce3d0403020348003045022033" + "a9fbd94d5bfff5bb0a4a78f91aa46991a6e484fd0a51306c43679fe784db7b0221008d81" + "916b6aefff66ec7a3aa67dd85430436703329b4d3d07ba343012a65f9ded"

anchors: () => {
    tls.Trust.anchors([hexBytes(rootCaHex)])
}

service: "service.protos.test"

// Scripted duplex: each read answers the next queued chunk (null once they
// are exhausted); writes are counted.
duplexOf: (chunks) => {
    next: 0
    reads: 0
    writes: 0
    written: 0
    closes: 0
    readFailure: null
    closeFailure: null
    fixture: null
    fixture = {
        read: (maxBytes) => {
            reads = reads + 1
            failure: readFailure
            result: null
            if(next < chunks.size()) {
                result = chunks[next]
                next = next + 1
            }
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                result
            }).future()
        }
        write: (bytes) => {
            writes = writes + 1
            written = written + bytes.size()
            (() => { fixture }).future()
        }
        close: () => {
            closes = closes + 1
            failure: closeFailure
            (() => {
                if(failure !== null) {
                    failure.signal()
                }
                null
            }).future()
        }
        failReadsWith: (error) => {
            readFailure = error
        }
        failCloseWith: (error) => {
            closeFailure = error
        }
        readCount: () => { reads }
        writeCount: () => { writes }
        writtenBytes: () => { written }
        closeCount: () => { closes }
    }
    fixture
}

failureOf: (future) => {
    caught: null
    Error.handle(
        () => {
            future.value()
        },
        (error) => {
            caught = error
            error
        }
    )
    caught
}

cancelledOf: (future) => {
    Cancelled.handle(
        () => {
            future.value()
            false
        },
        (cancellation) => {
            true
        }
    )
}

kindOf: (future) => {
    failure: failureOf(future)
    Assertions.require(failure.parent() === tls.TlsError)
    Assertions.require(failure.hasSlot("kind"))
    failure.kind
}

garbage: () => {
    Encoding.Latin1.encode("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
}

tests: [
    Test("Trust.system fails with trustUnavailable before any octet", () => {
        dx: duplexOf([])
        Assertions.require(kindOf(tls.Client.handshake(dx, service, tls.Trust.system(), {})) == "trustUnavailable")
        Assertions.require(dx.readCount() == 0)
        Assertions.require(dx.writeCount() == 0)
        Assertions.require(dx.closeCount() == 0)
    }),
    Test("Trust.javaCacerts never falls back: unavailable material writes nothing", () => {
        dx: duplexOf([garbage()])
        kind: kindOf(tls.Client.handshake(dx, service, tls.Trust.javaCacerts(), {}))
        // Usable cacerts reach the peer and fail on its garbage; unusable
        // cacerts fail closed before the ClientHello.
        if(kind == "trustUnavailable") {
            Assertions.require(dx.writeCount() == 0)
            Assertions.require(dx.readCount() == 0)
        } else {
            Assertions.require(kind == "handshakeFailure")
            Assertions.require(dx.writeCount() > 0)
        }
    }),
    Test("an admitted handshake answers a fresh Future each time", () => {
        first: tls.Client.handshake(duplexOf([]), service, tls.Trust.system(), {})
        second: tls.Client.handshake(duplexOf([]), service, tls.Trust.system(), {})
        Assertions.require(first !== second)
        Assertions.require(failureOf(first) !== failureOf(second))
    }),
    Test("non-TLS peer octets are a general handshake failure", () => {
        dx: duplexOf([garbage()])
        Assertions.require(kindOf(tls.Client.handshake(dx, service, anchors(), {})) == "handshakeFailure")
        Assertions.require(dx.writeCount() >= 1)
        Assertions.require(dx.closeCount() == 0)
    }),
    Test("end of transport input during the handshake is truncated, not null", () => {
        dx: duplexOf([])
        Assertions.require(kindOf(tls.Client.handshake(dx, service, anchors(), {})) == "truncated")
        Assertions.require(dx.readCount() >= 1)
        Assertions.require(dx.closeCount() == 0)
    }),
    Test("a transport read Error is preserved with its identity", () => {
        dx: duplexOf([])
        transport: IOError {}
        dx.failReadsWith(transport)
        failure: failureOf(tls.Client.handshake(dx, service, anchors(), {}))
        Assertions.require(failure === transport)
    }),
    Test("maxHandshakeBytes bounds handshake octets before they are written", () => {
        dx: duplexOf([])
        bounds: {
            maxHandshakeBytes: 1
        }
        Assertions.require(kindOf(tls.Client.handshake(dx, service, anchors(), bounds)) == "limit")
        Assertions.require(dx.writeCount() == 0)
    }),
    Test("maxHandshakeBytes also bounds received handshake octets", () => {
        dx: duplexOf([])
        sent: tls.Client.handshake(dx, service, anchors(), {})
        failureOf(sent)
        bounds: {
            maxHandshakeBytes: dx.writtenBytes() + 1
        }
        dy: duplexOf([garbage()])
        Assertions.require(kindOf(tls.Client.handshake(dy, service, anchors(), bounds)) == "limit")
        Assertions.require(dy.writeCount() == 1)
    }),
    Test("an owning handshake closes the duplex exactly once on failure", () => {
        failing: duplexOf([garbage()])
        Assertions.require(kindOf(tls.Client.handshake.owning(failing, service, anchors(), {})) == "handshakeFailure")
        Assertions.require(failing.closeCount() == 1)
        untrusted: duplexOf([])
        Assertions.require(kindOf(tls.Client.handshake.owning(untrusted, service, tls.Trust.system(), {})) == "trustUnavailable")
        Assertions.require(untrusted.closeCount() == 1)
        Assertions.require(untrusted.writeCount() == 0)
    }),
    Test("a borrowed handshake never closes the duplex", () => {
        dx: duplexOf([garbage()])
        failureOf(tls.Client.handshake(dx, service, anchors(), {}))
        failureOf(tls.Client.handshake(duplexOf([]), service, tls.Trust.system(), {}))
        Assertions.require(dx.closeCount() == 0)
    }),
    Test("cancelling an owning handshake before it starts closes the duplex once", () => {
        dx: duplexOf([])
        future: tls.Client.handshake.owning(dx, service, anchors(), {})
        future.cancel()
        Assertions.require(cancelledOf(future))
        Assertions.require(dx.closeCount() == 1)
        Assertions.require(dx.writeCount() == 0)
    }),
    Test("cancelling a borrowed handshake leaves the duplex open", () => {
        dx: duplexOf([])
        future: tls.Client.handshake(dx, service, anchors(), {})
        future.cancel()
        Assertions.require(cancelledOf(future))
        Assertions.require(dx.closeCount() == 0)
    }),
    Test("a failing owned close never replaces the primary handshake Error", () => {
        closeError: IOError {}
        failing: duplexOf([garbage()])
        failing.failCloseWith(closeError)
        failure: failureOf(tls.Client.handshake.owning(failing, service, anchors(), {}))
        Assertions.require(failure !== closeError)
        Assertions.require(failure.parent() === tls.TlsError)
        Assertions.require(failure.kind == "handshakeFailure")
        Assertions.require(failing.closeCount() == 1)
        untrusted: duplexOf([])
        untrusted.failCloseWith(closeError)
        trustFailure: failureOf(tls.Client.handshake.owning(untrusted, service, tls.Trust.system(), {}))
        Assertions.require(trustFailure.kind == "trustUnavailable")
        Assertions.require(untrusted.closeCount() == 1)
    }),
    Test("the primary transport Error keeps its identity over a failing close", () => {
        transport: IOError {}
        dx: duplexOf([])
        dx.failReadsWith(transport)
        dx.failCloseWith(IOError {})
        Assertions.require(failureOf(tls.Client.handshake.owning(dx, service, anchors(), {})) === transport)
        Assertions.require(dx.closeCount() == 1)
    }),
    Test("a cancelled owning handshake whose close fails fails with the close Error", () => {
        closeError: IOError {}
        dx: duplexOf([])
        dx.failCloseWith(closeError)
        future: tls.Client.handshake.owning(dx, service, anchors(), {})
        future.cancel()
        // Not Cancelled: the cleanup Error supersedes the cancellation unwind.
        Assertions.require(failureOf(future) === closeError)
        Assertions.require(dx.closeCount() == 1)
    }),
    Test("every failure is a fresh TlsError occurrence with an own kind", () => {
        first: failureOf(tls.Client.handshake(duplexOf([]), service, anchors(), {}))
        second: failureOf(tls.Client.handshake(duplexOf([]), service, anchors(), {}))
        Assertions.require(first !== second)
        Assertions.require(first.kind == second.kind)
        Assertions.require(!tls.TlsError.hasSlot("kind"))
    })
]
