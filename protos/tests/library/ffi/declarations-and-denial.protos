Assertions: import("std:test/assertions")
Test: import("std:test/test")
FFI: import("std:ffi")
Arrays: import("std:collections/array")

tests: [
    Test("extracted declaration helpers keep return homes and private state", () => {
        pointer: FFI.pointer(FFI.i32)
        nullable: FFI.nullable(pointer)
        Assertions.require(FFI.sizeOf(nullable) == FFI.sizeOf(pointer))
        prototype: {}
        Assertions.require(FFI.prototype(FFI.i32, prototype) === prototype)
        Assertions.require(FFI.prototype(FFI.i32, prototype) === prototype)
        Assertions.require(FFI.layoutOf(prototype) === FFI.i32)
        for(name in Array("descriptors", "owners", "associations", "pointerTypes",
                "storages", "layouts", "nativeContext", "providerContext",
                "_ffiObjectRecognitionFacility", "_ffiNativeContextFacility")) {
            Assertions.require(FFI.hasSlot(name) === false)
        }
        Assertions.signals(Error, () => FFI.sizeOf({}))
    }),
    Test("import is authority free and cached", () => {
        Assertions.require(FFI === import("std:ffi"))
        Assertions.signals(Error, () => import("ffi:sqlite3"))
    }),
    Test("scalar descriptors are stable ordinary frozen objects", () => {
        values: Array(
            FFI.void,
            FFI.i8, FFI.u8,
            FFI.i16, FFI.u16,
            FFI.i32, FFI.u32,
            FFI.i64, FFI.u64,
            FFI.f32, FFI.f64,
            FFI.sizeT, FFI.utf8z)
        Assertions.require(FFI.i32 === FFI.i32)
        Assertions.require(FFI.i32 !== FFI.i64)
        for(value in values) {
            Assertions.require(value.parent() === Object)
            Assertions.signals(Error, () => { value.extra: 1 })
        }
        null
    }),
    Test("public surface contains exactly the approved members", () => {
        expected: Array(
            "void",
            "i8", "u8", "i16", "u16",
            "i32", "u32", "i64", "u64",
            "f32", "f64", "sizeT", "utf8z",
            "opaque", "nullable", "owned", "out",
            "bind", "bindPreserving", "release",
            "field", "struct", "union", "array", "pointer",
            "borrowedPointer", "addressOf",
            "sizeOf", "alignOf", "offsetOf",
            "prototype", "layoutOf", "cType",
            "allocate", "slice", "view", "assumeExtent",
            "unionArm", "readFields", "writeFields", "readAs", "writeFrom")
        names: FFI.slotNames()
        Assertions.require(names.size() == expected.size())
        for(name in expected) {
            Assertions.require(Arrays.contains(names, name))
        }
        null
    }),
    Test("descriptor constructors reject incompatible domains", () => {
        for(value in Array(null, false, 1, "i32", {}, Array(), FFI.i32)) {
            Assertions.signals(Error, () => FFI.nullable(value))
            Assertions.signals(Error, () => FFI.owned(value, "free", FFI.void))
        }
        for(value in Array(null, false, {}, FFI.void, FFI.utf8z, FFI.out(FFI.i32))) {
            Assertions.signals(Error, () => FFI.out(value))
        }
        Assertions.signals(Error, () => FFI.out(FFI.i32, FFI.i64))
    }),
    Test("local library impersonation is rejected", () => {
        fake: {
            opaque: (name) => {}
            signature: (returns) => {}
        }
        for(library in Array(null, false, 7, "sqlite3", {}, fake)) {
            Assertions.signals(Error, () => FFI.opaque(library, "counter"))
            Assertions.signals(Error, () => FFI.bind(library, "symbol", FFI.i32, Array()))
        }
        Assertions.signals(Error, () => FFI.opaque(fake, 1))
    }),
    Test("parameter sequences and descriptors are validated", () => {
        for(parameters in Array(null, false, {}, "i32")) {
            Assertions.signals(Error, () => FFI.bind(null, "f", FFI.i32, parameters))
        }
        for(parameters in Array(Array({}), Array(FFI.void), Array(null))) {
            Assertions.signals(Error, () => FFI.bind(null, "f", FFI.i32, parameters))
        }
        Assertions.signals(Error, () => FFI.bind(null, 1, FFI.i32, Array()))
        Assertions.signals(Error, () => FFI.bind(null, "f", {}, Array()))
    }),
    Test("borrowed pointer declarations are authority free", () => {
        pointer: FFI.pointer(FFI.u8)
        borrowed: FFI.borrowedPointer(pointer)
        Assertions.require(borrowed.parent() === Object)
        Assertions.require(borrowed !== FFI.borrowedPointer(pointer))
        Assertions.signals(Error, () => { borrowed.extra: 1 })
        Assertions.require(FFI.out(borrowed) !== null)
        Assertions.require(FFI.out(pointer) !== null)
        Assertions.require(FFI.out(FFI.nullable(pointer)) !== null)
        for(value in Array(null, false, 1, {}, FFI.u8, FFI.void, FFI.nullable(pointer),
                borrowed, FFI.struct(Array(FFI.field("a", FFI.u8))))) {
            Assertions.signals(Error, () => FFI.borrowedPointer(value))
        }
        Assertions.signals(Error, () => FFI.borrowedPointer())
        Assertions.signals(Error, () => FFI.borrowedPointer(pointer, pointer))
        Assertions.signals(Error, () => FFI.sizeOf(borrowed))
        Assertions.signals(Error, () => FFI.pointer(borrowed))
        Assertions.signals(Error, () => FFI.field("p", borrowed))
        Assertions.signals(Error, () => FFI.bind(null, "f", FFI.i32, Array(borrowed)))
    }),
    Test("addressOf accepts only active published owned handles", () => {
        for(value in Array(null, false, 1, 140737488355328, "x", {}, Array(), FFI.i32,
                FFI.pointer(FFI.void), FFI.out(FFI.i32))) {
            Assertions.signals(Error, () => FFI.addressOf(value))
        }
        Assertions.signals(Error, () => FFI.addressOf())
        null
    }),
    Test("release accepts only active published owned handles", () => {
        for(value in Array(null, false, 1, {}, Array(), FFI.i32, FFI.out(FFI.i32))) {
            Assertions.signals(Error, () => FFI.release(value))
        }
        null
    })
]
tests.freeze()
