Assertions: import("std:test/assertions")
Test: import("std:test/test")
Base64url: import("std:text/base64url")

bytes: (value, count) => {
    result: Encoding.UTF8.encode("")
    index: 0
    while(index < count) {
        result.add(value)
        index = index + 1
    }
    result
}

tests: [
    Test("invalid input domains", () => {
        Assertions.signals(Error, () => { Base64url.encode("abc") })
        Assertions.signals(Error, () => { Base64url.encode(Array(1, 2)) })
        Assertions.signals(Error, () => { Base64url.encode(null) })
        Assertions.signals(Error, () => { Base64url.decode(null) })
        Assertions.signals(Error, () => { Base64url.decode(Array()) })
        Assertions.signals(Error, () => { Base64url.decode(123) })
    }),
    Test("strict alphabet and unpadded grammar", () => {
        Assertions.signals(Error, () => {
            Base64url.decode("+w")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("/w")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg=")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg==")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("A")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("AAAAA")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Z g")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg ")
        })
        Assertions.signals(Error, () => {
            Base64url.decode(" Zg")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg\n")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg\r")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg\t")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("é")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("中")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg/")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg+")
        })
        Assertions.signals(Error, () => {
            Base64url.decode("Zg_=")
        })
    }),
    Test("decoded Bytes have independent identity and remain open", () => {
        a: Base64url.decode("AA")
        b: Base64url.decode("AA")
        Assertions.require(a !== b)
        Assertions.require(a.size() == 1)
        Assertions.require(a[0] == 0)
        a.add(255)
        Assertions.require(a.size() == 2)
        Assertions.require(b.size() == 1)
    }),
    Test("source Bytes are not mutated or retained", () => {
        source: bytes(255, 4)
        encoded: Base64url.encode(source)
        Assertions.require(source.size() == 4)
        Assertions.require(source[0] == 255)
        source.add(0)
        Assertions.require(encoded == "_____w")
    }),
    Test("large codec input has no JWT-specific cap", () => {
        source: bytes(128, 10000)
        result: Base64url.decode(Base64url.encode(source))
        Assertions.require(result.size() == 10000)
        Assertions.require(result[0] == 128)
        Assertions.require(result[9999] == 128)
    }),
    Test("real Bytes preserve all binary octets", () => {
        source: bytes(255, 2)
        encoded: Base64url.encode(source)
        restored: Base64url.decode(encoded)

        Assertions.require(encoded == "__8")
        Assertions.require(restored.size() == 2)
        Assertions.require(restored[0] == 255)
        Assertions.require(restored[1] == 255)
        Assertions.require(restored !== source)
    })

]
tests.freeze()
