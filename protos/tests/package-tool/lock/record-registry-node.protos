Lock: import("self:LockDocument")
record: Lock.parseRecord(
    "registry-node registry \"pkg\" \"1.2.3\" locator \"community/pkg\" authority \"public\" content protos-package-tree-v1 sha256:abcd"
)
ok: record.kind == "registry-node"
(record.ref.kind == "registry").ifFalse(() => { ok = false })
(record.ref.version.text == "1.2.3").ifFalse(() => { ok = false })
(record.locator == "community/pkg").ifFalse(() => { ok = false })
(record.authority == "public").ifFalse(() => { ok = false })
(record.content.algorithm == "sha256").ifFalse(() => { ok = false })
(record.content.hex == "abcd").ifFalse(() => { ok = false })
ok
