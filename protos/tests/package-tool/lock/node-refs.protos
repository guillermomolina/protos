Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("node-ref-workspace-roundtrip", () => {
        Syntax: import("self:LockSyntax")
        ref: Syntax.parseNodeRef("workspace \"root package\"")
        ok: ref.kind == "workspace"
        (ref.packageId == "root package").ifFalse(() => { ok = false })
        (Syntax.renderNodeRef(ref) == "workspace \"root package\"").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("node-ref-registry-roundtrip", () => {
        Syntax: import("self:LockSyntax")
        ref: Syntax.parseNodeRef("registry \"pkg\" \"2.0.0-rc.1\"")
        ok: ref.kind == "registry"
        (ref.packageId == "pkg").ifFalse(() => { ok = false })
        (ref.version.text == "2.0.0-rc.1").ifFalse(() => { ok = false })
        (ref.version.major == 2).ifFalse(() => { ok = false })
        (Syntax.renderNodeRef(ref) == "registry \"pkg\" \"2.0.0-rc.1\"").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("node-ref-git-roundtrip", () => {
        Syntax: import("self:LockSyntax")
        ref: Syntax.parseNodeRef("git \"pkg\" \"012345abcdef\"")
        ok: ref.kind == "git"
        (ref.packageId == "pkg").ifFalse(() => { ok = false })
        (ref.revision == "012345abcdef").ifFalse(() => { ok = false })
        (Syntax.renderNodeRef(ref) == "git \"pkg\" \"012345abcdef\"").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("node-ref-unknown-kind-error", () => {
        Syntax: import("self:LockSyntax")
        Assertions.signals(Error, () => {
            Syntax.parseNodeRef("other \"pkg\"")
        })
    }),
    Test("node-ref-registry-invalid-version-error", () => {
        Syntax: import("self:LockSyntax")
        Assertions.signals(Error, () => {
            Syntax.parseNodeRef("registry \"pkg\" \"1.2\"")
        })
    }),
    Test("node-ref-extra-token-error", () => {
        Syntax: import("self:LockSyntax")
        Assertions.signals(Error, () => {
            Syntax.parseNodeRef("workspace \"pkg\" extra")
        })
    })
]
tests.freeze()
