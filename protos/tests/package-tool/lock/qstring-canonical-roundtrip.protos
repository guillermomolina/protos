Syntax: import("self:LockSyntax")
valueBytes: Encoding.UTF8.encode("A")
valueBytes.add(10)
valueBytes.add(34)
valueBytes.add(92)
valueBytes.add(127)
value: Encoding.UTF8.decode(valueBytes)

expectedBytes: Encoding.UTF8.encode("")
expectedBytes.add(34)
expectedBytes.add(65)
expectedBytes.add(92)
expectedBytes.add(117)
expectedBytes.add(48)
expectedBytes.add(48)
expectedBytes.add(48)
expectedBytes.add(97)
expectedBytes.add(92)
expectedBytes.add(34)
expectedBytes.add(92)
expectedBytes.add(92)
expectedBytes.add(92)
expectedBytes.add(117)
expectedBytes.add(48)
expectedBytes.add(48)
expectedBytes.add(55)
expectedBytes.add(102)
expectedBytes.add(34)
expected: Encoding.UTF8.decode(expectedBytes)

rendered: Syntax.renderQstring(value)
ok: rendered == expected
(Syntax.parseQstring(rendered) == value).ifFalse(() => { ok = false })
ok
