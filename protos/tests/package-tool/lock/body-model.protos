Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("body-root-only", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root-pkg\"\n"
        model: Lock.parse(text)
        ok: model.root.kind == "workspace"
        (model.root.packageId == "root-pkg").ifFalse(() => { ok = false })
        (model.workspaceMembers.size() == 0).ifFalse(() => { ok = false })
        (model.registryNodes.size() == 0).ifFalse(() => { ok = false })
        (model.gitNodes.size() == 0).ifFalse(() => { ok = false })
        (model.dependencies.size() == 0).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("body-complete-model", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root-pkg\"\n" +
            "workspace-member \"libs/util\" workspace \"util-pkg\"\n" +
            "registry-node registry \"json-pkg\" \"2.3.1\" locator \"community/json\" authority \"protos-public\" content protos-package-tree-v1 sha256:aaaa\n" +
            "git-node git \"git-pkg\" \"abc123\" fetch \"https://example.invalid/git.git\" content protos-package-tree-v1 sha256:bbbb\n" +
            "dependency workspace \"root-pkg\" alias \"json\" target registry \"json-pkg\" \"2.3.1\"\n" +
            "dependency workspace \"util-pkg\" alias \"gitdep\" target git \"git-pkg\" \"abc123\"\n"
        model: Lock.parse(text)
        ok: model.workspaceMembers.size() == 1
        (model.registryNodes.size() == 1).ifFalse(() => { ok = false })
        (model.gitNodes.size() == 1).ifFalse(() => { ok = false })
        (model.dependencies.size() == 2).ifFalse(() => { ok = false })
        (model.registryNodes[0].locator == "community/json").ifFalse(() => { ok = false })
        (model.registryNodes[0].authority == "protos-public").ifFalse(() => { ok = false })
        (model.registryNodes[0].content.method == "protos-package-tree-v1").ifFalse(() => { ok = false })
        (model.gitNodes[0].fetch == "https://example.invalid/git.git").ifFalse(() => { ok = false })
        (model.dependencies[1].alias == "gitdep").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("body-out-of-order-structural", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "dependency workspace \"root-pkg\" alias \"json\" target registry \"json-pkg\" \"1.0.0\"\n" +
            "registry-node registry \"json-pkg\" \"1.0.0\" locator \"json\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n" +
            "root workspace \"root-pkg\"\n"
        model: Lock.parseStructural(text)
        Assertions.require(
            (model.root.packageId == "root-pkg") &&
                (model.dependencies.size() == 1)
        )
    }),
    Test("record-registry-node", () => {
        Lock: import("self:LockDocument")
        record: Lock.parseRecord(
            "registry-node registry \"pkg\" \"1.2.3\" locator \"community/pkg\" authority \"public\" content protos-package-tree-v1 sha256:abcd"
        )
        ok: record.kind == "registry-node"
        (record.ref.kind == "registry").ifFalse(() => { ok = false })
        (record.ref.version.text == "1.2.3").ifFalse(() => { ok = false })
        (record.locator == "community/pkg").ifFalse(() => { ok = false })
        (record.authority == "public").ifFalse(() => { ok = false })
        (record.content.algorithm == "sha256").ifFalse(() => { ok = false })
        (record.content.hex == "abcd").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("record-git-node", () => {
        Lock: import("self:LockDocument")
        record: Lock.parseRecord(
            "git-node git \"pkg\" \"deadbeef\" fetch \"https://example.invalid/repo.git\" content protos-package-tree-v1 sha256:abcd"
        )
        ok: record.kind == "git-node"
        (record.ref.kind == "git").ifFalse(() => { ok = false })
        (record.ref.revision == "deadbeef").ifFalse(() => { ok = false })
        (record.fetch == "https://example.invalid/repo.git").ifFalse(() => { ok = false })
        (record.content.method == "protos-package-tree-v1").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("record-dependency", () => {
        Lock: import("self:LockDocument")
        record: Lock.parseRecord(
            "dependency workspace \"root\" alias \"json\" target registry \"pkg\" \"1.0.0\""
        )
        ok: record.kind == "dependency"
        (record.declaring.kind == "workspace").ifFalse(() => { ok = false })
        (record.declaring.packageId == "root").ifFalse(() => { ok = false })
        (record.alias == "json").ifFalse(() => { ok = false })
        (record.target.kind == "registry").ifFalse(() => { ok = false })
        (record.target.version.text == "1.0.0").ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
