Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("header-lines-only", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        lines: Syntax.headerLines(text)
        ok: lines.size() == 4
        (lines[0] == "lock-format 1").ifFalse(() => { ok = false })
        (lines[1] == "resolver-version 1").ifFalse(() => { ok = false })
        (lines[2] == "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef").ifFalse(() => { ok = false })
        (lines[3] == "").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-lock-format-line", () => {
        Syntax: import("self:LockSyntax")
        parsed: Syntax.parseLockFormatLine("lock-format 1")
        ok: parsed.value == 1
        (parsed.text == "1").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-resolver-version-line", () => {
        Syntax: import("self:LockSyntax")
        parsed: Syntax.parseResolverVersionLine("resolver-version 1")
        ok: parsed.value == 1
        (parsed.text == "1").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-resolution-input-line", () => {
        Syntax: import("self:LockSyntax")
        parsed: Syntax.parseResolutionInputLine("resolution-input protos-resolution-input-v1 sha256:0123456789abcdef")
        ok: parsed.method == "protos-resolution-input-v1"
        (parsed.algorithm == "sha256").ifFalse(() => { ok = false })
        (parsed.hex == "0123456789abcdef").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-sequence-no-object", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        lines: Syntax.headerLines(text)
        lockFormatRecord: Syntax.parseLockFormatLine(lines[0])
        resolverVersionRecord: Syntax.parseResolverVersionLine(lines[1])
        resolutionInputRecord: Syntax.parseResolutionInputLine(lines[2])
        ok: lockFormatRecord.value == 1
        (resolverVersionRecord.value == 1).ifFalse(() => { ok = false })
        (resolutionInputRecord.method == "protos-resolution-input-v1").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-object-compose-isolated", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        lines: Syntax.headerLines(text)
        lf: Syntax.parseLockFormatLine(lines[0])
        rv: Syntax.parseResolverVersionLine(lines[1])
        ri: Syntax.parseResolutionInputLine(lines[2])

        lfValue: lf.value
        lfText: lf.text
        rvValue: rv.value
        rvText: rv.text
        methodValue: ri.method
        algorithmValue: ri.algorithm
        hexValue: ri.hex

        header: {
            lockFormat: lfValue
            lockFormatText: lfText
            resolverVersion: rvValue
            resolverVersionText: rvText
            resolutionMethod: methodValue
            digestAlgorithm: algorithmValue
            digestHex: hexValue
        }

        ok: header.lockFormat == 1
        (header.lockFormatText == "1").ifFalse(() => { ok = false })
        (header.resolverVersion == 1).ifFalse(() => { ok = false })
        (header.resolutionMethod == "protos-resolution-input-v1").ifFalse(() => { ok = false })
        (header.digestAlgorithm == "sha256").ifFalse(() => { ok = false })
        (header.digestHex == "0123456789abcdef").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("header-parse-call-only", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        Syntax.parseHeader(text)
        Assertions.require(true)
    }),
    Test("header-field-lock-format", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.lockFormat == 1)
    }),
    Test("header-field-lock-format-text", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.lockFormatText == "1")
    }),
    Test("header-field-resolver-version", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.resolverVersion == 1)
    }),
    Test("header-field-resolver-version-text", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.resolverVersionText == "1")
    }),
    Test("header-field-resolution-method", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.resolutionMethod == "protos-resolution-input-v1")
    }),
    Test("header-field-digest-algorithm", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.digestAlgorithm == "sha256")
    }),
    Test("header-field-digest-hex", () => {
        Syntax: import("self:LockSyntax")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n"
        header: Syntax.parseHeader(text)
        Assertions.require(header.digestHex == "0123456789abcdef")
    })
]
tests.freeze()
