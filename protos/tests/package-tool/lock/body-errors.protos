Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("body-missing-root-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "registry-node registry \"pkg\" \"1.0.0\" locator \"pkg\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-root-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "root workspace \"other\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-member-declaration-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "workspace-member \"libs/a\" workspace \"a\"\n" +
            "workspace-member \"libs/a\" workspace \"b\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-member-ref-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "workspace-member \"libs/a\" workspace \"same\"\n" +
            "workspace-member \"libs/b\" workspace \"same\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-root-repeated-as-member-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "workspace-member \".\" workspace \"root\"\n" +
            "root workspace \"root\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-registry-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "registry-node registry \"pkg\" \"1.0.0\" locator \"pkg\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n" +
            "registry-node registry \"pkg\" \"1.0.0\" locator \"renamed/pkg\" authority \"public\" content protos-package-tree-v1 sha256:bbbb\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-git-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "git-node git \"pkg\" \"abc\" fetch \"https://one.invalid/repo\" content protos-package-tree-v1 sha256:aaaa\n" +
            "git-node git \"pkg\" \"abc\" fetch \"https://two.invalid/repo\" content protos-package-tree-v1 sha256:bbbb\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-duplicate-dependency-alias-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "registry-node registry \"a\" \"1.0.0\" locator \"a\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n" +
            "registry-node registry \"b\" \"1.0.0\" locator \"b\" authority \"public\" content protos-package-tree-v1 sha256:bbbb\n" +
            "dependency workspace \"root\" alias \"dep\" target registry \"a\" \"1.0.0\"\n" +
            "dependency workspace \"root\" alias \"dep\" target registry \"b\" \"1.0.0\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-dangling-declaring-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "registry-node registry \"pkg\" \"1.0.0\" locator \"pkg\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n" +
            "dependency workspace \"missing\" alias \"dep\" target registry \"pkg\" \"1.0.0\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-dangling-target-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "dependency workspace \"root\" alias \"dep\" target git \"missing\" \"abc\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-blank-line-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-unknown-record-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "artifact \"x\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-registry-wrong-field-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "registry-node registry \"pkg\" \"1.0.0\" location \"pkg\" authority \"public\" content protos-package-tree-v1 sha256:aaaa\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-git-missing-content-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "git-node git \"pkg\" \"abc\" fetch \"https://example.invalid/repo\"\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    }),
    Test("body-content-uppercase-digest-error", () => {
        Lock: import("self:LockDocument")
        text:
            "lock-format 1\n" +
            "resolver-version 1\n" +
            "resolution-input protos-resolution-input-v1 sha256:0123456789abcdef\n\n" +
            "root workspace \"root\"\n" +
            "registry-node registry \"pkg\" \"1.0.0\" locator \"pkg\" authority \"public\" content protos-package-tree-v1 sha256:abCD\n"
        Assertions.signals(Error, () => {
            Lock.parse(text)
        })
    })
]
tests.freeze()
