Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("primitive-line-bare", () => {
        Syntax: import("self:LockSyntax")
        tokens: Syntax.lineTokens("lock-format 1")
        ok: tokens.size() == 2
        (tokens[0].text == "lock-format").ifFalse(() => { ok = false })
        (tokens[1].text == "1").ifFalse(() => { ok = false })
        tokens[0].quoted.ifTrue(() => { ok = false })
        tokens[1].quoted.ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("primitive-decimal", () => {
        Syntax: import("self:LockSyntax")
        token: Syntax.lineTokens("123")[0]
        parsed: Syntax.parseDecimalToken(token)
        ok: parsed.value == 123
        (parsed.text == "123").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("primitive-method", () => {
        Syntax: import("self:LockSyntax")
        token: Syntax.lineTokens("protos-resolution-input-v1")[0]
        Assertions.require(Syntax.parseMethodToken(token) == "protos-resolution-input-v1")
    }),
    Test("primitive-digest", () => {
        Syntax: import("self:LockSyntax")
        token: Syntax.lineTokens("sha256:0123456789abcdef")[0]
        parsed: Syntax.parseDigestToken(token)
        ok: parsed.algorithm == "sha256"
        (parsed.hex == "0123456789abcdef").ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
