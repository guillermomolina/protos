Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("qstring-canonical-roundtrip", () => {
        Syntax: import("self:LockSyntax")
        valueBytes: Encoding.UTF8.encode("A")
        valueBytes.add(10)
        valueBytes.add(34)
        valueBytes.add(92)
        valueBytes.add(127)
        value: Encoding.UTF8.decode(valueBytes)

        expectedBytes: Encoding.UTF8.encode("")
        expectedBytes.add(34)
        expectedBytes.add(65)
        expectedBytes.add(92)
        expectedBytes.add(117)
        expectedBytes.add(48)
        expectedBytes.add(48)
        expectedBytes.add(48)
        expectedBytes.add(97)
        expectedBytes.add(92)
        expectedBytes.add(34)
        expectedBytes.add(92)
        expectedBytes.add(92)
        expectedBytes.add(92)
        expectedBytes.add(117)
        expectedBytes.add(48)
        expectedBytes.add(48)
        expectedBytes.add(55)
        expectedBytes.add(102)
        expectedBytes.add(34)
        expected: Encoding.UTF8.decode(expectedBytes)

        rendered: Syntax.renderQstring(value)
        ok: rendered == expected
        (Syntax.parseQstring(rendered) == value).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("line-tokenization", () => {
        Syntax: import("self:LockSyntax")
        tokens: Syntax.lineTokens("dependency workspace \"root package\" alias \"json api\" target git \"pkg\" \"abc123\"")
        ok: tokens.size() == 9
        (tokens[0].text == "dependency").ifFalse(() => { ok = false })
        tokens[0].quoted.ifTrue(() => { ok = false })
        tokens[2].quoted.ifFalse(() => { ok = false })
        (tokens[2].text == "root package").ifFalse(() => { ok = false })
        (tokens[4].text == "json api").ifFalse(() => { ok = false })
        (tokens[8].text == "abc123").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("qstring-noncanonical-short-escape-error", () => {
        Syntax: import("self:LockSyntax")
        bytes: Encoding.UTF8.encode("")
        bytes.add(34)
        bytes.add(92)
        bytes.add(110)
        bytes.add(34)
        Assertions.signals(Error, () => {
            Syntax.parseQstring(Encoding.UTF8.decode(bytes))
        })
    }),
    Test("qstring-unnecessary-unicode-error", () => {
        Syntax: import("self:LockSyntax")
        bytes: Encoding.UTF8.encode("")
        bytes.add(34)
        bytes.add(92)
        bytes.add(117)
        bytes.add(48)
        bytes.add(48)
        bytes.add(52)
        bytes.add(49)
        bytes.add(34)
        Assertions.signals(Error, () => {
            Syntax.parseQstring(Encoding.UTF8.decode(bytes))
        })
    }),
    Test("qstring-uppercase-hex-error", () => {
        Syntax: import("self:LockSyntax")
        bytes: Encoding.UTF8.encode("")
        bytes.add(34)
        bytes.add(92)
        bytes.add(117)
        bytes.add(48)
        bytes.add(48)
        bytes.add(55)
        bytes.add(70)
        bytes.add(34)
        Assertions.signals(Error, () => {
            Syntax.parseQstring(Encoding.UTF8.decode(bytes))
        })
    }),
    Test("line-double-space-error", () => {
        Syntax: import("self:LockSyntax")
        Assertions.signals(Error, () => {
            Syntax.lineTokens("root  workspace")
        })
    }),
    Test("line-tab-error", () => {
        Syntax: import("self:LockSyntax")
        bytes: Encoding.UTF8.encode("root")
        bytes.add(9)
        bytes.add(119)
        Assertions.signals(Error, () => {
            Syntax.lineTokens(Encoding.UTF8.decode(bytes))
        })
    })
]
tests.freeze()
