Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("digest-varuint-boundaries", () => {
        Identity: import("self:ContentIdentity")

        captured: projectTreeFilesystem.captureTree(Path.relative()).value()
        actual: Identity.digest(captured)

        ok: true
        (actual.method == "protos-package-tree-v1").ifFalse(() => {
            ok = false
        })
        (actual.algorithm == "sha256").ifFalse(() => {
            ok = false
        })
        (actual.hex == "4ae0bad7f7915a5e6db1ad4bb29ee71351fcf812b562b41da34f99b8fd4b8f02").ifFalse(() => {
            ok = false
        })
        Assertions.require(ok)
    })
]
tests.freeze()
