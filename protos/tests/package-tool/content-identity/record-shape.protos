Identity: import("self:ContentIdentity")

captured: filesystem.captureTree(Path.relative()).value()
records: Identity.collectRecords(captured)

(records.size() == 1).ifFalse(() => {
    Error().signal()
})

record: records.at(0)

record.hasSlot("pathBytes").ifFalse(() => {
    Error().signal()
})
record.hasSlot("content").ifFalse(() => {
    Error().signal()
})

(record.pathBytes.size() == 11).ifFalse(() => {
    Error().signal()
})
(record.content.size() == 0).ifFalse(() => {
    Error().signal()
})

true
