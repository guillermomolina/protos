Identity: import("self:ContentIdentity")

check: (value, expected) => {
    actual: Identity.varuint(value)
    ok: actual.size() == expected.size()
    index: 0

    expected.each((octet) => {
        ok.ifTrue(() => {
            (actual.at(index) == octet).ifFalse(() => {
                ok = false
            })
        })
        index = index + 1
    })

    ok.ifFalse(() => {
        Error().signal()
    })
}

check(0, Array(0))
check(1, Array(1))
check(127, Array(127))
check(128, Array(128, 1))
check(255, Array(255, 1))
check(300, Array(172, 2))
check(16384, Array(128, 128, 1))
check(
    1180591620717411303424,
    Array(128, 128, 128, 128, 128, 128, 128, 128, 128, 128, 1)
)
true
