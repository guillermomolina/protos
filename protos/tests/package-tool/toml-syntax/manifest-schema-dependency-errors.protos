Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("manifest-schema-final-array-of-tables-dependency-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[[dependencies.bad]]\npath = \"../p\"\n")
        })
    }),
    Test("manifest-schema-final-cross-section-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.good]\npath = \"../p\"\n[workspace]\nmembers = [\"same\", \"same\"]\n")
        })
    }),
    Test("manifest-schema-final-declaration-not-table-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies]\nbad = \"no\"\n")
        })
    }),
    Test("manifest-schema-final-dependencies-not-table-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\npackage = { id = \"pkg\", version = \"1.0.0\" }\ndependencies = \"no\"\n")
        })
    }),
    Test("manifest-schema-final-dependency-unknown-field-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\npath = \"../p\"\nvisibility = \"public\"\n")
        })
    }),
    Test("manifest-schema-final-empty-declaration-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\n")
        })
    }),
    Test("manifest-schema-final-empty-git-value-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\ngit = \"g\"\nrev = \"\"\n")
        })
    }),
    Test("manifest-schema-final-empty-path-value-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\npath = \"\"\n")
        })
    }),
    Test("manifest-schema-final-empty-registry-value-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\nauthority = \"\"\npackage = \"p\"\nversion = \"v\"\n")
        })
    }),
    Test("manifest-schema-final-git-incomplete-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\ngit = \"https://example.invalid/p.git\"\n")
        })
    }),
    Test("manifest-schema-final-mixed-git-path-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\ngit = \"g\"\nrev = \"r\"\npath = \"../p\"\n")
        })
    }),
    Test("manifest-schema-final-mixed-registry-git-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\nauthority = \"a\"\npackage = \"p\"\nversion = \"v\"\ngit = \"g\"\nrev = \"r\"\n")
        })
    }),
    Test("manifest-schema-final-registry-incomplete-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[dependencies.bad]\npackage = \"community/parser\"\nversion = \"^1.0.0\"\n")
        })
    })
]
tests.freeze()
