Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("manifest-schema-sections-compatibility-missing-language-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[compatibility]\n")
        })
    }),
    Test("manifest-schema-sections-compatibility-not-table-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseSections("manifest-version = 1\ncompatibility = \"0.1\"\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-sections-compatibility-unknown-field-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[compatibility]\nlanguage = \"0.1\"\ntoolchain = \"x\"\n")
        })
    }),
    Test("manifest-schema-sections-complete", () => {
        Schema: import("self:ManifestSchemaV1")
        model: Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\nlocator = \"community/pkg\"\n[compatibility]\nlanguage = \">=0.1\"\n[exports]\nWidget = \"Widget\"\nParser = \"parser/Parser\"\n[dependencies.deferred]\nfuture-field = \"owned-by-c5d\"\n[workspace]\nmembers = [\"app\", \"parser\"]\n")
        ok: model.package.locator == "community/pkg"
        (model.compatibility.language == ">=0.1").ifFalse(() => { ok = false })
        (model.exports["Widget"] == "Widget").ifFalse(() => { ok = false })
        (model.exports["Parser"] == "parser/Parser").ifFalse(() => { ok = false })
        (model.workspace.members.size() == 2).ifFalse(() => { ok = false })
        (model.workspace.members[0] == "app").ifFalse(() => { ok = false })
        (model.workspace.members[1] == "parser").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("manifest-schema-sections-empty-collections", () => {
        Schema: import("self:ManifestSchemaV1")
        model: Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[exports]\n[workspace]\nmembers = []\n")
        ok: model.compatibility === null
        model.exports.containsKey("anything").ifTrue(() => { ok = false })
        (model.workspace.members.size() == 0).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("manifest-schema-sections-exports-non-string-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n[exports]\nWidget = 1\n")
        })
    }),
    Test("manifest-schema-sections-exports-not-table-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseSections("manifest-version = 1\nexports = []\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-sections-minimal", () => {
        Schema: import("self:ManifestSchemaV1")
        model: Schema.parseSections("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        ok: model.package.id == "pkg"
        (model.package.version == "1.0.0").ifFalse(() => { ok = false })
        (model.package.locator === null).ifFalse(() => { ok = false })
        (model.compatibility === null).ifFalse(() => { ok = false })
        model.exports.containsKey("anything").ifTrue(() => { ok = false })
        (model.workspace === null).ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
