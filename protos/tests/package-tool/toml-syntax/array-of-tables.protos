Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("document-table-array-of-tables-basic", () => {
        Document: import("self:TomlDocument")
        root: Document.table("[[products]]\nname = \"Hammer\"\n[[products]]\n[[products]]\nname = \"Nail\"\n")
        products: root.value["products"]
        ok: products.kind == "array"
        (products.value.size() == 3).ifFalse(() => { ok = false })
        (products.value[0].kind == "table").ifFalse(() => { ok = false })
        (products.value[0].value["name"].value == "Hammer").ifFalse(() => { ok = false })
        (products.value[1].value.size() == 0).ifFalse(() => { ok = false })
        (products.value[2].value["name"].value == "Nail").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-array-of-tables-nested-latest", () => {
        Document: import("self:TomlDocument")
        root: Document.table("[[fruits]]\nname = \"apple\"\n[fruits.physical]\ncolor = \"red\"\n[[fruits.varieties]]\nname = \"red delicious\"\n[[fruits.varieties]]\nname = \"granny smith\"\n[[fruits]]\nname = \"banana\"\n[[fruits.varieties]]\nname = \"plantain\"\n")
        fruits: root.value["fruits"].value
        (apple, banana): fruits
        appleVarieties: apple.value["varieties"].value
        bananaVarieties: banana.value["varieties"].value
        ok: fruits.size() == 2
        (apple.value["name"].value == "apple").ifFalse(() => { ok = false })
        (apple.value["physical"].value["color"].value == "red").ifFalse(() => { ok = false })
        (appleVarieties.size() == 2).ifFalse(() => { ok = false })
        (appleVarieties[0].value["name"].value == "red delicious").ifFalse(() => { ok = false })
        (appleVarieties[1].value["name"].value == "granny smith").ifFalse(() => { ok = false })
        (banana.value["name"].value == "banana").ifFalse(() => { ok = false })
        (banana.value.containsKey("physical")).ifTrue(() => { ok = false })
        (bananaVarieties.size() == 1).ifFalse(() => { ok = false })
        (bananaVarieties[0].value["name"].value == "plantain").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-array-of-tables-implicit-super-later", () => {
        Document: import("self:TomlDocument")
        root: Document.table("[[catalog.products]]\nname = \"hammer\"\n[catalog]\nowner = \"tools\"\n")
        catalog: root.value["catalog"]
        products: catalog.value["products"]
        ok: catalog.kind == "table"
        (catalog.value["owner"].value == "tools").ifFalse(() => { ok = false })
        (products.kind == "array").ifFalse(() => { ok = false })
        (products.value.size() == 1).ifFalse(() => { ok = false })
        (products.value[0].value["name"].value == "hammer").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-array-of-tables-static-array-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("fruits = []\n[[fruits]]\nname = \"apple\"\n")
        })
    }),
    Test("document-table-array-of-tables-table-to-array-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("[fruits]\nname = \"group\"\n[[fruits]]\nname = \"apple\"\n")
        })
    }),
    Test("document-table-array-of-tables-array-to-table-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("[[fruits]]\nname = \"apple\"\n[fruits]\nowner = \"x\"\n")
        })
    }),
    Test("document-table-array-of-tables-child-before-parent-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("[fruit.physical]\ncolor = \"red\"\n[[fruit]]\nname = \"apple\"\n")
        })
    }),
    Test("document-table-array-of-tables-nested-array-to-table-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("[[fruits]]\nname = \"apple\"\n[[fruits.varieties]]\nname = \"red\"\n[fruits.varieties]\nname = \"green\"\n")
        })
    }),
    Test("document-table-array-of-tables-nested-table-to-array-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("[[fruits]]\nname = \"apple\"\n[fruits.physical]\ncolor = \"red\"\n[[fruits.physical]]\ncolor = \"green\"\n")
        })
    }),
    Test("document-table-array-of-tables-inline-parent-conflict-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.table("fruit = { name = \"apple\" }\n[[fruit.varieties]]\nname = \"red\"\n")
        })
    })
]
tests.freeze()
