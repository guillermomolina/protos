Schema: import("self:ManifestSchemaV1")
model: Schema.parse("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\nlocator = \"community/pkg\"\n[compatibility]\nlanguage = \">=0.1\"\n[exports]\nParser = \"parser/Parser\"\n[dependencies.registry]\nauthority = \"protos-public\"\npackage = \"community/parser\"\nversion = \"^2.1.0\"\n[dependencies.metrics]\ngit = \"https://example.invalid/metrics.git\"\nrev = \"0123456789abcdef\"\n[dependencies.fixture]\npath = \"../fixture\"\n[workspace]\nmembers = [\"app\", \"parser\"]\n")
ok: model.package.locator == "community/pkg"
(model.compatibility.language == ">=0.1").ifFalse(() => { ok = false })
(model.exports.at("Parser") == "parser/Parser").ifFalse(() => { ok = false })
(model.dependencies.size() == 3).ifFalse(() => { ok = false })
(model.dependencies.at("registry").authority == "protos-public").ifFalse(() => { ok = false })
(model.dependencies.at("registry").package == "community/parser").ifFalse(() => { ok = false })
(model.dependencies.at("registry").version == "^2.1.0").ifFalse(() => { ok = false })
(model.dependencies.at("metrics").git == "https://example.invalid/metrics.git").ifFalse(() => { ok = false })
(model.dependencies.at("metrics").rev == "0123456789abcdef").ifFalse(() => { ok = false })
(model.dependencies.at("fixture").path == "../fixture").ifFalse(() => { ok = false })
(model.workspace.members.size() == 2).ifFalse(() => { ok = false })
ok
