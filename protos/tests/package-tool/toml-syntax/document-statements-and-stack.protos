Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("document-statements-basic", () => {
        Document: import("self:TomlDocument")
        items: Document.statements("manifest-version = 1\n[package]\nid = \"pkg#1\"# trailing\nversion = \"1.0.0\"\n")
        ok: items.size() == 4
        (items[0] == "manifest-version = 1").ifFalse(() => { ok = false })
        (items[1] == "[package]").ifFalse(() => { ok = false })
        (items[2] == "id = \"pkg#1\"").ifFalse(() => { ok = false })
        (items[3] == "version = \"1.0.0\"").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-statements-nested", () => {
        Document: import("self:TomlDocument")
        items: Document.statements("values = [1,\n# inside array\n2]\nmeta = { name = \"x#y\", enabled = true }\n")
        ok: items.size() == 2
        (items[0] == "values = [1,\n\n2]").ifFalse(() => { ok = false })
        (items[1] == "meta = { name = \"x#y\", enabled = true }").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-statements-multiline", () => {
        Document: import("self:TomlDocument")
        items: Document.statements("text = \"\"\"\nalpha # data\nbeta\n\"\"\"\n[package]\n")
        ok: items.size() == 2
        (items[0] == "text = \"\"\"\nalpha # data\nbeta\n\"\"\"").ifFalse(() => { ok = false })
        (items[1] == "[package]").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-statements-crlf", () => {
        Document: import("self:TomlDocument")
        items: Document.statements("a = 1\r\n# comment\r\nb = \"c\"\r\n")
        ok: items.size() == 2
        (items[0] == "a = 1").ifFalse(() => { ok = false })
        (items[1] == "b = \"c\"").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-statements-unclosed-string-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.statements("name = \"unterminated\n")
        })
    }),
    Test("document-statements-unbalanced-array-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.statements("values = [1, 2\n")
        })
    }),
    Test("document-statements-stray-close-error", () => {
        Document: import("self:TomlDocument")
        Assertions.signals(Error, () => {
            Document.statements("values = 1]\n")
        })
    }),
    Test("document-table-long-flat-stack-regression", () => {
        Document: import("self:TomlDocument")
        root: Document.table("k0 = 0\nk1 = 1\nk2 = 2\nk3 = 3\nk4 = 4\nk5 = 5\nk6 = 6\nk7 = 7\nk8 = 8\nk9 = 9\nk10 = 10\nk11 = 11\nk12 = 12\nk13 = 13\nk14 = 14\nk15 = 15\nk16 = 16\nk17 = 17\nk18 = 18\nk19 = 19\nk20 = 20\nk21 = 21\nk22 = 22\nk23 = 23\nk24 = 24\nk25 = 25\nk26 = 26\nk27 = 27\nk28 = 28\nk29 = 29\nk30 = 30\nk31 = 31\nk32 = 32\nk33 = 33\nk34 = 34\nk35 = 35\nk36 = 36\nk37 = 37\nk38 = 38\nk39 = 39\nk40 = 40\nk41 = 41\nk42 = 42\nk43 = 43\nk44 = 44\nk45 = 45\nk46 = 46\nk47 = 47\nk48 = 48\nk49 = 49\nk50 = 50\nk51 = 51\nk52 = 52\nk53 = 53\nk54 = 54\nk55 = 55\nk56 = 56\nk57 = 57\nk58 = 58\nk59 = 59\nk60 = 60\nk61 = 61\nk62 = 62\nk63 = 63\nk64 = 64\nk65 = 65\nk66 = 66\nk67 = 67\nk68 = 68\nk69 = 69\nk70 = 70\nk71 = 71\nk72 = 72\nk73 = 73\nk74 = 74\nk75 = 75\nk76 = 76\nk77 = 77\nk78 = 78\nk79 = 79\nk80 = 80\nk81 = 81\nk82 = 82\nk83 = 83\nk84 = 84\nk85 = 85\nk86 = 86\nk87 = 87\nk88 = 88\nk89 = 89\nk90 = 90\nk91 = 91\nk92 = 92\nk93 = 93\nk94 = 94\nk95 = 95\n")
        ok: root.kind == "table"
        (root.value.size() == 96).ifFalse(() => { ok = false })
        (root.value["k0"].value == 0).ifFalse(() => { ok = false })
        (root.value["k95"].value == 95).ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
