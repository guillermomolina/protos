Toml: import("self:TomlSyntax")
a: Toml.value("1_000")
b: Toml.value("0xDEAD_BEEF")
c: Toml.value("0o755")
d: Toml.value("0b1010")
ok: a.kind == "integer"
(a.value == 1000).ifFalse(() => { ok = false })
(b.value == 3735928559).ifFalse(() => { ok = false })
(c.value == 493).ifFalse(() => { ok = false })
(d.value == 10).ifFalse(() => { ok = false })
ok
