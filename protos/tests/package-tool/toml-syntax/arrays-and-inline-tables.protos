Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("array-comments-trailing-comma", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("[\n  \"a\", # first\n  'b',\n]")
        values: parsed.value
        ok: parsed.kind == "array"
        (values.size() == 2).ifFalse(() => { ok = false })
        (values[0].value == "a").ifFalse(() => { ok = false })
        (values[1].value == "b").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("array-two-values", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("[1, 2]")
        ok: parsed.kind == "array"
        (parsed.value.size() == 2).ifFalse(() => { ok = false })
        (parsed.value[0].value == 1).ifFalse(() => { ok = false })
        (parsed.value[1].value == 2).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("inline-table-dotted", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("{ package = \"community/parser\", source.rev = 'abc', public = true }")
        root: parsed.value
        source: root["source"].value
        ok: parsed.kind == "table"
        (root["package"].value == "community/parser").ifFalse(() => { ok = false })
        (source["rev"].value == "abc").ifFalse(() => { ok = false })
        (root["public"].value === true).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("nested-array", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("[[1, 2], [3]]")
        ok: parsed.kind == "array"
        (parsed.value.size() == 2).ifFalse(() => { ok = false })
        (parsed.value[0].value[1].value == 2).ifFalse(() => { ok = false })
        (parsed.value[1].value[0].value == 3).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("inline-table-trailing-comma-error", () => {
        Toml: import("self:TomlSyntax")
        Assertions.signals(Error, () => {
            Toml.value("{ a = 1, }")
        })
    }),
    Test("inline-table-duplicate-error", () => {
        Toml: import("self:TomlSyntax")
        Assertions.signals(Error, () => {
            Toml.value("{ a = 1, a = 2 }")
        })
    })
]
tests.freeze()
