Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("manifest-schema-base-empty-id-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\n[package]\nid = \"\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-base-empty-locator-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\nlocator = \"\"\n")
        })
    }),
    Test("manifest-schema-base-empty-version-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"\"\n")
        })
    }),
    Test("manifest-schema-base-locator-and-known-optional", () => {
        Schema: import("self:ManifestSchemaV1")
        model: Schema.parseBase("manifest-version = 1\n[package]\nid = \"pkg-id\"\nversion = \"1.2.3\"\nlocator = \"community/pkg\"\n[compatibility]\nfuture-field = 7\n")
        ok: model.package.id == "pkg-id"
        (model.package.locator == "community/pkg").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("manifest-schema-base-manifest-version-type-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = \"1\"\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-base-minimal", () => {
        Schema: import("self:ManifestSchemaV1")
        model: Schema.parseBase("manifest-version = 1\n[package]\nid = \"pkg-id\"\nversion = \"1.2.3\"\n")
        ok: model.package.id == "pkg-id"
        (model.package.version == "1.2.3").ifFalse(() => { ok = false })
        (model.package.locator === null).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("manifest-schema-base-missing-manifest-version-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-base-missing-package-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\n")
        })
    }),
    Test("manifest-schema-base-package-not-table-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\npackage = \"pkg\"\n")
        })
    }),
    Test("manifest-schema-base-package-unknown-field-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\nname = \"wrong-field\"\n")
        })
    }),
    Test("manifest-schema-base-unknown-root-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 1\nunknown = true\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    }),
    Test("manifest-schema-base-unsupported-generation-error", () => {
        Schema: import("self:ManifestSchemaV1")
        Assertions.signals(Error, () => {
            Schema.parseBase("manifest-version = 2\n[package]\nid = \"pkg\"\nversion = \"1.0.0\"\n")
        })
    })
]
tests.freeze()
