Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("key-bare-dotted", () => {
        Toml: import("self:TomlSyntax")
        parts: Toml.keyPath("dependencies . parser-core")
        ok: parts.size() == 2
        (parts[0] == "dependencies").ifFalse(() => { ok = false })
        (parts[1] == "parser-core").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("key-quoted-unicode", () => {
        Toml: import("self:TomlSyntax")
        parts: Toml.keyPath("\"site.name\" . 'ʞ'")
        ok: parts.size() == 2
        (parts[0] == "site.name").ifFalse(() => { ok = false })
        (parts[1] == "ʞ").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("integer-radix", () => {
        Toml: import("self:TomlSyntax")
        a: Toml.value("1_000")
        b: Toml.value("0xDEAD_BEEF")
        c: Toml.value("0o755")
        d: Toml.value("0b1010")
        ok: a.kind == "integer"
        (a.value == 1000).ifFalse(() => { ok = false })
        (b.value == 3735928559).ifFalse(() => { ok = false })
        (c.value == 493).ifFalse(() => { ok = false })
        (d.value == 10).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("integer-boundary", () => {
        Toml: import("self:TomlSyntax")
        min: Toml.value("-9223372036854775808")
        max: Toml.value("9223372036854775807")
        ok: min.kind == "integer"
        (min.value == -9223372036854775808).ifFalse(() => { ok = false })
        (max.value == 9223372036854775807).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("unsupported-scalars", () => {
        Toml: import("self:TomlSyntax")
        float: Toml.value("1.5")
        date: Toml.value("1979-05-27")
        large: Toml.value("9223372036854775808")
        ok: float.kind == "unsupported"
        (date.kind == "unsupported").ifFalse(() => { ok = false })
        (large.kind == "unsupported").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("invalid-key-error", () => {
        Toml: import("self:TomlSyntax")
        Assertions.signals(Error, () => {
            Toml.keyPath("a..b")
        })
    }),
    Test("signed-radix-unsupported", () => {
        Toml: import("self:TomlSyntax")
        a: Toml.value("+0x1")
        b: Toml.value("-0b1")
        ok: a.kind == "unsupported"
        (b.kind == "unsupported").ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
