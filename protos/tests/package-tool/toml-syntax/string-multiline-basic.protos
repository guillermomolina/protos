Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("string-multiline-basic", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("\"\"\"\nalpha\nbeta\n\"\"\"")
        ok: parsed.kind == "string"
        (parsed.value == "alpha\nbeta\n").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("string-multiline-basic-quotes", () => {
        Toml: import("self:TomlSyntax")
        a: Toml.value("\"\"\"one \" two\"\"\"")
        b: Toml.value("\"\"\"one \"\" two\"\"\"")
        ok: a.value == "one \" two"
        (b.value == "one \"\" two").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("string-multiline-basic-too-many-closing-quotes-error", () => {
        Toml: import("self:TomlSyntax")
        Assertions.signals(Error, () => {
            Toml.value("\"\"\"x\"\"\"\"\"\"")
        })
    }),
    Test("string-multiline-closing-quotes", () => {
        Toml: import("self:TomlSyntax")
        a: Toml.value("\"\"\"x\"\"\"\"")
        b: Toml.value("\"\"\"x\"\"\"\"\"")
        c: Toml.value("'''x''''")
        d: Toml.value("'''x'''''")
        ok: a.value == "x\""
        (b.value == "x\"\"").ifFalse(() => { ok = false })
        (c.value == "x'").ifFalse(() => { ok = false })
        (d.value == "x''").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("string-multiline-continuation", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("\"\"\"alpha \\\n    beta\"\"\"")
        ok: parsed.kind == "string"
        (parsed.value == "alpha beta").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("string-multiline-crlf", () => {
        Toml: import("self:TomlSyntax")
        parsed: Toml.value("\"\"\"\r\nalpha\r\nbeta\"\"\"")
        ok: parsed.kind == "string"
        (parsed.value == "alpha\nbeta").ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
