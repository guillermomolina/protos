Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("document-table-basic", () => {
        Document: import("self:TomlDocument")
        root: Document.table("manifest-version = 1\n[package]\nid = \"pkg-1\"\nversion = \"1.2.3\"\n")
        version: root.value["manifest-version"]
        package: root.value["package"]
        ok: root.kind == "table"
        (version.kind == "integer").ifFalse(() => { ok = false })
        (version.value == 1).ifFalse(() => { ok = false })
        (package.kind == "table").ifFalse(() => { ok = false })
        (package.value["id"].value == "pkg-1").ifFalse(() => { ok = false })
        (package.value["version"].value == "1.2.3").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-dotted-equivalence", () => {
        Document: import("self:TomlDocument")
        dotted: Document.table("[dependencies]\nparser.authority = \"public\"\nparser.package = \"community/parser\"\nparser.version = \"^2.1.0\"\n")
        expanded: Document.table("[dependencies.parser]\nauthority = \"public\"\npackage = \"community/parser\"\nversion = \"^2.1.0\"\n")
        a: dotted.value["dependencies"].value["parser"].value
        b: expanded.value["dependencies"].value["parser"].value
        ok: a["authority"].value == b["authority"].value
        (a["package"].value == b["package"].value).ifFalse(() => { ok = false })
        (a["version"].value == b["version"].value).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-inline-equivalence", () => {
        Document: import("self:TomlDocument")
        inline: Document.table("dependencies = { parser = { authority = \"public\", package = \"community/parser\", version = \"^2.1.0\" } }\n")
        expanded: Document.table("[dependencies.parser]\nauthority = \"public\"\npackage = \"community/parser\"\nversion = \"^2.1.0\"\n")
        a: inline.value["dependencies"].value["parser"].value
        b: expanded.value["dependencies"].value["parser"].value
        ok: a["authority"].value == b["authority"].value
        (a["package"].value == b["package"].value).ifFalse(() => { ok = false })
        (a["version"].value == b["version"].value).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-super-after-subtable", () => {
        Document: import("self:TomlDocument")
        root: Document.table("[x.y.z]\nleaf = 1\n[x]\nroot-value = 2\n")
        x: root.value["x"].value
        ok: x["root-value"].value == 2
        (x["y"].value["z"].value["leaf"].value == 1).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-subtable-under-dotted", () => {
        Document: import("self:TomlDocument")
        root: Document.table("[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n[fruit.apple.texture]\nsmooth = true\n")
        apple: root.value["fruit"].value["apple"].value
        ok: apple["color"].value == "red"
        (apple["taste"].value["sweet"].value == true).ifFalse(() => { ok = false })
        (apple["texture"].value["smooth"].value == true).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-quoted-equals", () => {
        Document: import("self:TomlDocument")
        root: Document.table("site.\"a=b\" = \"x=y\"\n")
        value: root.value["site"].value["a=b"]
        ok: value.kind == "string"
        (value.value == "x=y").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("document-table-unsupported-value", () => {
        Document: import("self:TomlDocument")
        root: Document.table("ratio = 1.5\n")
        value: root.value["ratio"]
        ok: value.kind == "unsupported"
        (value.value == "1.5").ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
