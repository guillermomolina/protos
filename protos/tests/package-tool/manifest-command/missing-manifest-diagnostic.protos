Command: import("self:ManifestCommand")
makeWriter: () => {
    state: Map()
    state["lines"] = Array()
    {
        state: state
        writeLine: (text) => {
            state["lines"] = Array(...state["lines"], text)
            { value: () => null }
        }
    }
}
outWriter: makeWriter()
errWriter: makeWriter()

Error.handle(() => {
    Command.run(filesystem, outWriter, errWriter)
    false
}, (error) => {
    outLines: outWriter.state["lines"]
    errLines: errWriter.state["lines"]
    ok: outLines.size() == 0
    (errLines.size() == 1).ifFalse(() => { ok = false })
    (errLines.size() == 1).ifTrue(() => {
        (errLines[0] == "protos.toml: cannot read as UTF-8").ifFalse(() => { ok = false })
    })
    ok
})
