Version: import("self:ReleaseVersion")
v: Version.parse("2.0.0-alpha.1.rc-2")
ok: true
(v.prerelease.size() == 3).ifFalse(() => { ok = false })
(v.prerelease.at(0).numeric === false).ifFalse(() => { ok = false })
(v.prerelease.at(0).text === "alpha").ifFalse(() => { ok = false })
(v.prerelease.at(1).numeric === true).ifFalse(() => { ok = false })
(v.prerelease.at(1).number == 1).ifFalse(() => { ok = false })
(v.prerelease.at(2).text === "rc-2").ifFalse(() => { ok = false })
ok
