Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("release-version-semver-precedence", () => {
        Version: import("self:ReleaseVersion")
        ordered: Array(
            "1.0.0-alpha",
            "1.0.0-alpha.1",
            "1.0.0-alpha.beta",
            "1.0.0-beta",
            "1.0.0-beta.2",
            "1.0.0-beta.11",
            "1.0.0-rc.1",
            "1.0.0"
        )

        ok: true
        previous: null
        ordered.each((text) => {
            current: Version.parse(text)
            (previous === null).ifFalse(() => {
                (Version.compare(previous, current) == -1).ifFalse(() => {
                    ok = false
                })
            })
            previous = current
        })
        Assertions.require(ok)
    }),
    Test("release-version-core-precedence", () => {
        Version: import("self:ReleaseVersion")
        ok: true
        (Version.compareText("1.9.9", "2.0.0") == -1).ifFalse(() => { ok = false })
        (Version.compareText("2.0.0", "2.1.0") == -1).ifFalse(() => { ok = false })
        (Version.compareText("2.1.0", "2.1.1") == -1).ifFalse(() => { ok = false })
        (Version.compareText("3.4.5", "3.4.5") == 0).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("release-version-prerelease-ascii", () => {
        Version: import("self:ReleaseVersion")
        ok: true
        (Version.compareText("1.0.0-A", "1.0.0-a") == -1).ifFalse(() => { ok = false })
        (Version.compareText("1.0.0-1", "1.0.0-A") == -1).ifFalse(() => { ok = false })
        (Version.compareText("1.0.0-alpha", "1.0.0-alpha.0") == -1).ifFalse(() => { ok = false })
        Version.parse("1.0.0-0A-")
        Assertions.require(ok)
    })
]
tests.freeze()
