Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("selection-exact", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.require(
            Selection.selectText(
                "1.4.2",
                Array("2.0.0", "1.4.2", "1.4.1")
            ) === "1.4.2"
        )
    }),
    Test("selection-caret-highest", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.require(
            Selection.selectText(
                "^1.4.2",
                Array("1.4.2", "1.9.9", "1.5.0", "2.0.0", "1.4.1")
            ) === "1.9.9"
        )
    }),
    Test("selection-interval-highest", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.require(
            Selection.selectText(
                ">=1.4.2 <1.8.0",
                Array("1.4.2", "1.7.9", "1.6.0", "1.8.0", "1.3.9")
            ) === "1.7.9"
        )
    }),
    Test("selection-prerelease-explicit-stable-wins", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.require(
            Selection.selectText(
                "^2.0.0-rc.1",
                Array("2.0.0-rc.2", "2.1.0-beta.1", "2.0.0", "2.5.0", "3.0.0")
            ) === "2.5.0"
        )
    }),
    Test("selection-prerelease-only", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.require(
            Selection.selectText(
                "^2.0.0-rc.1",
                Array("2.0.0-rc.1", "2.1.0-beta.1", "2.0.0-rc.9")
            ) === "2.0.0-rc.9"
        )
    }),
    Test("selection-order-independent", () => {
        Selection: import("self:FreshVersionSelection")
        left: Selection.selectText(
            "^1.0.0",
            Array("1.8.0", "1.2.0", "1.9.1", "1.0.0")
        )
        right: Selection.selectText(
            "^1.0.0",
            Array("1.0.0", "1.9.1", "1.2.0", "1.8.0")
        )
        Assertions.require(left === right)
    }),
    Test("selection-no-match-error", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.signals(Error, () => {
            Selection.selectText(
                "^1.4.2",
                Array("1.4.1", "2.0.0")
            )
        })
    }),
    Test("selection-empty-error", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.signals(Error, () => {
            Selection.selectText(
                "^1.4.2",
                Array()
            )
        })
    }),
    Test("selection-invalid-candidate-error", () => {
        Selection: import("self:FreshVersionSelection")
        Assertions.signals(Error, () => {
            Selection.selectText(
                "^1.4.2",
                Array("1.5.0", "v1.6.0")
            )
        })
    })
]
tests.freeze()
