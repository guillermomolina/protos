Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("release-version-build-metadata-is-package-policy", () => {
        Version: import("self:ReleaseVersion")
        SemVer: import("std:semver/SemVer")
        generic: SemVer.parse("1.2.3+build")
        Assertions.require(generic.build.size() == 1)
        Assertions.signals(Error, () => {
            Version.parse("1.2.3+build")
        })
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-alpha+build")
        })
    }),
    Test("release-version-agrees-with-std-semver-precedence", () => {
        Version: import("self:ReleaseVersion")
        SemVer: import("std:semver/SemVer")
        texts: Array(
            "1.0.0-alpha",
            "1.0.0-alpha.1",
            "1.0.0-alpha.beta",
            "1.0.0-beta.11",
            "1.0.0-rc.1",
            "1.0.0",
            "123456789012345678901234567890.0.0-99999999999999999999"
        )
        ok: true
        texts.each((left) => {
            texts.each((right) => {
                expected: SemVer.comparePrecedence(SemVer.parse(left), SemVer.parse(right))
                (Version.compareText(left, right) == expected).ifFalse(() => { ok = false })
            })
        })
        Assertions.require(ok)
    }),
    Test("release-version-large-prerelease-identifier", () => {
        Version: import("self:ReleaseVersion")
        v: Version.parse("1.0.0-alpha.123456789012345678901234567890")
        ok: true
        (v.prerelease[1].numeric === true).ifFalse(() => { ok = false })
        (v.prerelease[1].number == 123456789012345678901234567890).ifFalse(() => { ok = false })
        (v.prerelease[1].text == "123456789012345678901234567890").ifFalse(() => { ok = false })
        (v.text == "1.0.0-alpha.123456789012345678901234567890").ifFalse(() => { ok = false })
        (Version.compareText(
            "1.0.0-alpha.123456789012345678901234567889",
            "1.0.0-alpha.123456789012345678901234567890"
        ) == -1).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("release-version-compares-internal-core-bound", () => {
        Version: import("self:ReleaseVersion")
        bound: {
            major: 1
            minor: 0
            patch: 0
            prerelease: null
            text: null
        }
        ok: true
        (Version.compare(Version.parse("1.0.0-rc.1"), bound) == -1).ifFalse(() => { ok = false })
        (Version.compare(Version.parse("1.0.0"), bound) == 0).ifFalse(() => { ok = false })
        (Version.compare(Version.parse("0.9.9"), bound) == -1).ifFalse(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
