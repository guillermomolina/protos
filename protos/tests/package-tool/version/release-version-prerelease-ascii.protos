Version: import("self:ReleaseVersion")
ok: true
(Version.compareText("1.0.0-A", "1.0.0-a") == -1).ifFalse(() => { ok = false })
(Version.compareText("1.0.0-1", "1.0.0-A") == -1).ifFalse(() => { ok = false })
(Version.compareText("1.0.0-alpha", "1.0.0-alpha.0") == -1).ifFalse(() => { ok = false })
Version.parse("1.0.0-0A-")
ok
