Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("release-version-leading-zero-major-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("01.2.3")
        })
    }),
    Test("release-version-leading-zero-minor-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.02.3")
        })
    }),
    Test("release-version-leading-zero-patch-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.03")
        })
    }),
    Test("release-version-missing-patch-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2")
        })
    }),
    Test("release-version-v-prefix-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("v1.2.3")
        })
    }),
    Test("release-version-build-metadata-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3+linux")
        })
    }),
    Test("release-version-empty-prerelease-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-")
        })
    }),
    Test("release-version-empty-prerelease-id-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-alpha..1")
        })
    }),
    Test("release-version-leading-zero-prerelease-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-01")
        })
    }),
    Test("release-version-invalid-prerelease-char-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-alpha_1")
        })
    }),
    Test("release-version-extra-core-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3.4")
        })
    }),
    Test("release-version-whitespace-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse(" 1.2.3")
        })
    }),
    Test("release-version-nonascii-prerelease-error", () => {
        Version: import("self:ReleaseVersion")
        Assertions.signals(Error, () => {
            Version.parse("1.2.3-á")
        })
    })
]
tests.freeze()
