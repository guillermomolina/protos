Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("constraint-caret-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        Constraint.parse("^1.4.2")
        Assertions.require(true)
    }),
    Test("constraint-caret-major", () => {
        Constraint: import("self:DependencyConstraint")
        c: Constraint.parse("^1.4.2")
        ok: true
        (c.kind === "caret").ifFalse(() => { ok = false })
        (c.lower.major == 1).ifFalse(() => { ok = false })
        (c.upper.major == 2).ifFalse(() => { ok = false })
        (c.upper.minor == 0).ifFalse(() => { ok = false })
        (c.upper.patch == 0).ifFalse(() => { ok = false })
        Constraint.satisfiesText("^1.4.2", "1.4.2").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^1.4.2", "1.9.9").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^1.4.2", "1.4.1").ifTrue(() => { ok = false })
        Constraint.satisfiesText("^1.4.2", "2.0.0").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-zero-minor", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText("^0.4.2", "0.4.2").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^0.4.2", "0.4.99").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^0.4.2", "0.4.1").ifTrue(() => { ok = false })
        Constraint.satisfiesText("^0.4.2", "0.5.0").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-zero-patch", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText("^0.0.7", "0.0.7").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^0.0.7", "0.0.8").ifTrue(() => { ok = false })
        Constraint.satisfiesText("^0.0.7", "0.0.6").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-zero-zero", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText("^0.0.0", "0.0.0").ifFalse(() => { ok = false })
        Constraint.satisfiesText("^0.0.0", "0.0.1").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-prerelease-parse", () => {
        Constraint: import("self:DependencyConstraint")
        c: Constraint.parse("^2.0.0-rc.1")
        ok: true
        (c.kind === "caret").ifFalse(() => { ok = false })
        (c.lower.prerelease.size() == 2).ifFalse(() => { ok = false })
        (c.upper.major == 3).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-prerelease-satisfaction-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.require(Constraint.satisfiesText("^2.0.0-rc.1", "2.0.0"))
    }),
    Test("constraint-caret-candidate-prerelease-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText("^1.4.2", "1.5.0-beta.1").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-caret-empty-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse("^")
        })
    })
]
tests.freeze()
