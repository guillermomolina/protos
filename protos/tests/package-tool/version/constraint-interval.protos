Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("constraint-interval-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        Constraint.parse(">=1.4.2 <2.0.0")
        Assertions.require(true)
    }),
    Test("constraint-interval-basic", () => {
        Constraint: import("self:DependencyConstraint")
        c: Constraint.parse(">=1.4.2 <1.8.0")
        ok: true
        (c.kind === "interval").ifFalse(() => { ok = false })
        (c.lower.lower === true).ifFalse(() => { ok = false })
        (c.lower.inclusive === true).ifFalse(() => { ok = false })
        (c.upper.lower === false).ifFalse(() => { ok = false })
        (c.upper.inclusive === false).ifFalse(() => { ok = false })
        Constraint.satisfiesText(">=1.4.2 <1.8.0", "1.4.2").ifFalse(() => { ok = false })
        Constraint.satisfiesText(">=1.4.2 <1.8.0", "1.7.9").ifFalse(() => { ok = false })
        Constraint.satisfiesText(">=1.4.2 <1.8.0", "1.4.1").ifTrue(() => { ok = false })
        Constraint.satisfiesText(">=1.4.2 <1.8.0", "1.8.0").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-interval-exclusive-inclusive", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText(">1.4.2 <=1.7.9", "1.4.2").ifTrue(() => { ok = false })
        Constraint.satisfiesText(">1.4.2 <=1.7.9", "1.4.3").ifFalse(() => { ok = false })
        Constraint.satisfiesText(">1.4.2 <=1.7.9", "1.7.9").ifFalse(() => { ok = false })
        Constraint.satisfiesText(">1.4.2 <=1.7.9", "1.8.0").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-interval-reversed-conjunction", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText("<2.0.0 >=1.0.0", "1.5.0").ifFalse(() => { ok = false })
        Constraint.satisfiesText("<2.0.0 >=1.0.0", "2.0.0").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-interval-tab-separator", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.require(Constraint.satisfiesText(">=1.0.0	<2.0.0", "1.5.0"))
    }),
    Test("constraint-interval-prerelease-parse", () => {
        Constraint: import("self:DependencyConstraint")
        c: Constraint.parse(">=2.0.0-rc.1 <2.0.0")
        ok: true
        (c.kind === "interval").ifFalse(() => { ok = false })
        (c.lower.version.prerelease.size() == 2).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-interval-prerelease-satisfaction-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.require(Constraint.satisfiesText(">=2.0.0-rc.1 <2.0.0", "2.0.0-rc.2"))
    }),
    Test("constraint-interval-candidate-prerelease-deferred-error", () => {
        Constraint: import("self:DependencyConstraint")
        ok: true
        Constraint.satisfiesText(">=1.0.0 <2.0.0", "1.5.0-beta.1").ifTrue(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-interval-open-lower-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse(">=1.0.0")
        })
    }),
    Test("constraint-interval-open-upper-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse("<2.0.0")
        })
    }),
    Test("constraint-interval-same-side-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse(">=1.0.0 >1.5.0")
        })
    }),
    Test("constraint-interval-three-comparisons-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse(">=1.0.0 <2.0.0 <3.0.0")
        })
    }),
    Test("constraint-interval-trailing-space-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse(">=1.0.0 <2.0.0 ")
        })
    }),
    Test("constraint-interval-spaced-operator-error", () => {
        Constraint: import("self:DependencyConstraint")
        Assertions.signals(Error, () => {
            Constraint.parse(">= 1.0.0 <2.0.0")
        })
    })
]
tests.freeze()
