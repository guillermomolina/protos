// D171/PLAT012: each external package arrives as a host-captured read-only Filesystem
// (externalCaptures, provisioned by the Java host harness); the guest has no capture selector.
capturedFor: (packageId) => {
    found: null
    externalCaptures.each((capture) => {
        (capture.packageId == packageId).ifTrue(() => {
            found = capture.filesystem
        })
    })
    (found === null).ifTrue(() => {
        Error().signal()
    })
    found
}

Plan: import("self:ExecutionPlan")
LockFile: import("self:LockFile")
Identity: import("self:ContentIdentity")

verifiedAll: (lock) => {
    result: Array()

    append: (node) => {
        captured:
            capturedFor(node.ref.packageId)

        verified:
            Identity.verify(
                captured,
                node.content
            )

        result =
            Array(
                ...result,
                {
                    ref: node.ref
                    content: node.content
                    filesystem: verified
                }
            )
    }

    lock.registryNodes.each((node) => {
        append(node)
    })
    lock.gitNodes.each((node) => {
        append(node)
    })

    result
}

lock: LockFile.load(projectTreeFilesystem)
verified: verifiedAll(lock)
plan:
    Plan.buildV2FromVerifiedCaptures(
        projectTreeFilesystem,
        verified
    )

true
