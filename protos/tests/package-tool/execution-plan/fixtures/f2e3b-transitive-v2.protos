Plan: import("self:ExecutionPlan")
LockFile: import("self:LockFile")
Identity: import("self:ContentIdentity")

pathFor: (ref) => {
    Path.relative()
        .child("external")
        .child(ref.packageId)
}

verifiedAll: (lock) => {
    result: Array()

    append: (node) => {
        captured:
            projectTreeFilesystem
                .captureTree(pathFor(node.ref))
                .value()

        verified:
            Identity.verify(
                captured,
                node.content
            )

        result =
            Array(
                ...result,
                {
                    ref: node.ref
                    content: node.content
                    filesystem: verified
                }
            )
    }

    lock.registryNodes.each((node) => {
        append(node)
    })
    lock.gitNodes.each((node) => {
        append(node)
    })

    result
}

lock: LockFile.load(projectTreeFilesystem)
verified: verifiedAll(lock)
plan:
    Plan.buildV2FromVerifiedCaptures(
        projectTreeFilesystem,
        verified
    )

ok: plan.generation == 2
(plan.packages.size() == 4).ifFalse(() => { ok = false })
(plan.dependencies.size() == 3).ifFalse(() => { ok = false })

foundA: false
foundB: false
foundC: false

plan.packages.each((package) => {
    (package.ref.kind == "registry").ifTrue(() => {
        (package.ref.packageId == "external-a").ifTrue(() => {
            foundA = package.exports["PublicA"] == "ThingA"
        })
        (package.ref.packageId == "external-b").ifTrue(() => {
            foundB = package.exports["PublicB"] == "ThingB"
        })
    })

    (package.ref.kind == "git").ifTrue(() => {
        (package.ref.packageId == "external-c").ifTrue(() => {
            foundC = package.exports["PublicC"] == "ThingC"
        })
    })
})

foundA.ifFalse(() => { ok = false })
foundB.ifFalse(() => { ok = false })
foundC.ifFalse(() => { ok = false })

rootEdge: false
registryEdge: false
gitEdge: false

plan.dependencies.each((edge) => {
    (edge.declaring.kind == "workspace").ifTrue(() => {
        (edge.alias == "reg").ifTrue(() => {
            rootEdge = edge.target.kind == "registry"
        })
    })

    (edge.declaring.kind == "registry").ifTrue(() => {
        (edge.declaring.packageId == "external-a").ifTrue(() => {
            (edge.alias == "depreg").ifTrue(() => {
                registryEdge = edge.target.kind == "registry"
            })
            (edge.alias == "depgit").ifTrue(() => {
                gitEdge = edge.target.kind == "git"
            })
        })
    })
})

rootEdge.ifFalse(() => { ok = false })
registryEdge.ifFalse(() => { ok = false })
gitEdge.ifFalse(() => { ok = false })

ok
