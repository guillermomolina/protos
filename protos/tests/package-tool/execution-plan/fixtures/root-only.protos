Plan: import("self:ExecutionPlan")
plan: Plan.build(projectTreeFilesystem)

ok: plan.generation == 1
(plan.root.kind == "workspace").ifFalse(() => { ok = false })
(plan.root.packageId == "root").ifFalse(() => { ok = false })
(plan.packages.size() == 1).ifFalse(() => { ok = false })
(plan.dependencies.size() == 0).ifFalse(() => { ok = false })

package: plan.packages.at(0)
(package.location == "").ifFalse(() => { ok = false })
(package.exports.at("Main") == "app/Main").ifFalse(() => { ok = false })
(package.exports.at("Alias") == "app/Main").ifFalse(() => { ok = false })
ok
