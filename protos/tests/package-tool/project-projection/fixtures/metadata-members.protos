Metadata: import("self:ProjectMetadata")

digest:
    Metadata.digest(
        projectTreeFilesystem,
        Array(
            {
                location: "z"
                packageId: "z-pkg"
            },
            {
                location: "a"
                packageId: "a-pkg"
            }
        )
    )

ok: digest.method == "protos-project-metadata-v1"
(digest.algorithm == "sha256").ifFalse(() => { ok = false })
(digest.hex == "dde95b306f57fc6ac4c85e36d09fc07f1c07fb4472c62dff9874fd6e2b58b434").ifFalse(() => {
    ok = false
})
ok
