Version: import("self:ReleaseVersion")
Constraint: import("self:DependencyConstraint")
Input: import("self:ResolutionInput")

manifest: (packageId, versionText, compatibility, dependencies) => {
    {
        packageId: packageId
        version: Version.parse(versionText)
        compatibility: compatibility
        dependencies: dependencies
    }
}

member: (location, packageId, manifestValue) => {
    {
        location: location
        packageId: packageId
        manifest: manifestValue
    }
}

pathDependency:
    {
        alias: "local"
        kind: "path"
        targetLocation: "libs/a"
        targetPackageId: "a-pkg"
    }

root:
    {
        languageCompatibility: "0.1"
        root: manifest("root", "1.0.0", null, Array(pathDependency))
        members: Array(
            member(
                "libs/a",
                "a-pkg",
                manifest("a-pkg", "1.0.0", null, Array())
            )
        )
    }

expectedLine:
    "dependency root \"local\" path member \"libs/a\" \"a-pkg\"\n"

text: Input.text(root)
bytes: Encoding.UTF8.encode(text)
needle: Encoding.UTF8.encode(expectedLine)

found: false
start: 0
(text == (
    "protos-resolution-input-v1\n" +
    "language \"0.1\"\n" +
    "manifest root \"root\" \"1.0.0\" compatibility none\n" +
    expectedLine +
    "manifest member \"libs/a\" \"a-pkg\" \"1.0.0\" compatibility none\n"
)).ifTrue(() => {
    found = true
})
found
