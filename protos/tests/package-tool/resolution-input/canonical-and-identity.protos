Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("canonical-root", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        root:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.0.0", null, Array())
                members: Array()
            }

        expected:
            "protos-resolution-input-v1\n" +
            "language \"0.1\"\n" +
            "manifest root \"root\" \"1.0.0\" compatibility none\n"

        digest: Input.digest(root)
        ok: Input.text(root) == expected
        (digest.method == "protos-resolution-input-v1").ifFalse(() => { ok = false })
        (digest.algorithm == "sha256").ifFalse(() => { ok = false })
        (digest.hex == "7041a8afff9ffd0879673557d5c88e47b5fa7f577b369165679d8899f382f579").ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("canonical-complete", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        registryConstraint: Constraint.parse("<2.0.0\t>=1.0.0")

        rootDependencies: Array(
            {
                alias: "reg"
                kind: "registry"
                authority: "public"
                packageId: "pkg"
                constraint: registryConstraint
            },
            {
                alias: "git"
                kind: "git"
                repository: "https://example.invalid/repo.git"
                revision: "abc123"
            }
        )

        aDependencies: Array(
            {
                alias: "rootdep"
                kind: "path"
                targetLocation: ""
                targetPackageId: "root"
            }
        )

        root:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.2.3", "0.1", rootDependencies)
                members: Array(
                    member(
                        "libs/z",
                        "z-pkg",
                        manifest("z-pkg", "3.0.0", "0.1", Array())
                    ),
                    member(
                        "libs/a",
                        "a-pkg",
                        manifest("a-pkg", "0.1.0", null, aDependencies)
                    )
                )
            }

        expected:
            "protos-resolution-input-v1\n" +
            "language \"0.1\"\n" +
            "manifest root \"root\" \"1.2.3\" compatibility \"0.1\"\n" +
            "dependency root \"git\" git \"https://example.invalid/repo.git\" \"abc123\"\n" +
            "dependency root \"reg\" registry \"public\" \"pkg\" constraint interval >= \"1.0.0\" < \"2.0.0\"\n" +
            "manifest member \"libs/a\" \"a-pkg\" \"0.1.0\" compatibility none\n" +
            "dependency member \"libs/a\" \"rootdep\" path root \"root\"\n" +
            "manifest member \"libs/z\" \"z-pkg\" \"3.0.0\" compatibility \"0.1\"\n"

        digest: Input.digest(root)
        ok: Input.text(root) == expected
        (digest.hex == "71131b4e01d5c5fe6e4a7c8f8ecca39f90f323e0d060f8bddc08662edc96802b").ifFalse(() => { ok = false })
        (Encoding.UTF8.decode(Input.bytes(root)) == expected).ifFalse(() => { ok = false })
        Assertions.require(ok)
    }),
    Test("constraint-equivalence", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        dependencyWith: (constraint) => {
            {
                alias: "dep"
                kind: "registry"
                authority: "public"
                packageId: "pkg"
                constraint: constraint
            }
        }

        rootWith: (constraint) => {
            {
                languageCompatibility: "0.1"
                root: manifest(
                    "root",
                    "1.0.0",
                    null,
                    Array(dependencyWith(constraint))
                )
                members: Array()
            }
        }

        left: rootWith(Constraint.parse(">=1.0.0 <2.0.0"))
        right: rootWith(Constraint.parse("<2.0.0\t>=1.0.0"))

        leftText: Input.text(left)
        rightText: Input.text(right)

        ok: leftText == rightText
        (Input.digest(left).hex == Input.digest(right).hex).ifFalse(() => {
            ok = false
        })
        Assertions.require(ok)
    }),
    Test("compatibility-affects-digest", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        withoutRestriction:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.0.0", null, Array())
                members: Array()
            }

        withRestriction:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.0.0", "0.1", Array())
                members: Array()
            }

        Assertions.require(Input.digest(withoutRestriction).hex != Input.digest(withRestriction).hex)
    }),
    Test("path-member-target", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        pathDependency:
            {
                alias: "local"
                kind: "path"
                targetLocation: "libs/a"
                targetPackageId: "a-pkg"
            }

        root:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.0.0", null, Array(pathDependency))
                members: Array(
                    member(
                        "libs/a",
                        "a-pkg",
                        manifest("a-pkg", "1.0.0", null, Array())
                    )
                )
            }

        expectedLine:
            "dependency root \"local\" path member \"libs/a\" \"a-pkg\"\n"

        text: Input.text(root)
        bytes: Encoding.UTF8.encode(text)
        needle: Encoding.UTF8.encode(expectedLine)

        found: false
        start: 0
        (text == (
            "protos-resolution-input-v1\n" +
            "language \"0.1\"\n" +
            "manifest root \"root\" \"1.0.0\" compatibility none\n" +
            expectedLine +
            "manifest member \"libs/a\" \"a-pkg\" \"1.0.0\" compatibility none\n"
        )).ifTrue(() => {
            found = true
        })
        Assertions.require(found)
    }),
    Test("matches-header", () => {
        Version: import("self:ReleaseVersion")
        Constraint: import("self:DependencyConstraint")
        Input: import("self:ResolutionInput")

        manifest: (packageId, versionText, compatibility, dependencies) => {
            {
                packageId: packageId
                version: Version.parse(versionText)
                compatibility: compatibility
                dependencies: dependencies
            }
        }

        member: (location, packageId, manifestValue) => {
            {
                location: location
                packageId: packageId
                manifest: manifestValue
            }
        }

        root:
            {
                languageCompatibility: "0.1"
                root: manifest("root", "1.0.0", null, Array())
                members: Array()
            }

        matching:
            {
                lockFormat: 1
                resolverVersion: 1
                resolutionMethod: "protos-resolution-input-v1"
                digestAlgorithm: "sha256"
                digestHex: "7041a8afff9ffd0879673557d5c88e47b5fa7f577b369165679d8899f382f579"
            }

        wrongDigest:
            {
                lockFormat: 1
                resolverVersion: 1
                resolutionMethod: "protos-resolution-input-v1"
                digestAlgorithm: "sha256"
                digestHex: "00"
            }

        wrongResolver:
            {
                lockFormat: 1
                resolverVersion: 2
                resolutionMethod: "protos-resolution-input-v1"
                digestAlgorithm: "sha256"
                digestHex: "7041a8afff9ffd0879673557d5c88e47b5fa7f577b369165679d8899f382f579"
            }

        ok: Input.matchesHeader(root, matching)
        (Input.matchesHeader(root, wrongDigest)).ifTrue(() => { ok = false })
        (Input.matchesHeader(root, wrongResolver)).ifTrue(() => { ok = false })
        Assertions.require(ok)
    })
]
tests.freeze()
