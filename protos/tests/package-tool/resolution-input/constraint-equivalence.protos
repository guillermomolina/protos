Version: import("self:ReleaseVersion")
Constraint: import("self:DependencyConstraint")
Input: import("self:ResolutionInput")

manifest: (packageId, versionText, compatibility, dependencies) => {
    {
        packageId: packageId
        version: Version.parse(versionText)
        compatibility: compatibility
        dependencies: dependencies
    }
}

member: (location, packageId, manifestValue) => {
    {
        location: location
        packageId: packageId
        manifest: manifestValue
    }
}

dependencyWith: (constraint) => {
    {
        alias: "dep"
        kind: "registry"
        authority: "public"
        packageId: "pkg"
        constraint: constraint
    }
}

rootWith: (constraint) => {
    {
        languageCompatibility: "0.1"
        root: manifest(
            "root",
            "1.0.0",
            null,
            Array(dependencyWith(constraint))
        )
        members: Array()
    }
}

left: rootWith(Constraint.parse(">=1.0.0 <2.0.0"))
right: rootWith(Constraint.parse("<2.0.0\t>=1.0.0"))

leftText: Input.text(left)
rightText: Input.text(right)

ok: leftText == rightText
(Input.digest(left).hex == Input.digest(right).hex).ifFalse(() => {
    ok = false
})
ok
