ioFails: (work) => {
    failed: false
    IOError.handle(() => {
        work()
        null
    }, (error) => {
        failed = true
        null
    })
    failed
}

readText: (fs, path) => {
    file: fs.open(path).value()
    reader: TextReader.owning(file, Encoding.UTF8)
    text: reader.readText().value()
    reader.close().value()
    text
}

rootPath: Path.relative()
stablePath: rootPath.child("stable.txt")
nestedPath: rootPath.child("nested")
childPath: nestedPath.child("child.txt")
linkPath: rootPath.child("opaque-link")

first: captured.entries(rootPath).value()
second: captured.entries(rootPath).value()
ok: first.size() == 3
((first === second) == false).ifFalse(() => { ok = false })

captured.hasSlot("close").ifTrue(() => { ok = false })

stableCount: 0
nestedCount: 0
linkCount: 0

first.each((entry) => {
    recognized: false

    (entry.name == "stable.txt").ifTrue(() => {
        recognized = true
        (entry.kind == "regular").ifFalse(() => { ok = false })
        stableCount = stableCount + 1
    })

    (entry.name == "nested").ifTrue(() => {
        recognized = true
        (entry.kind == "directory").ifFalse(() => { ok = false })
        nestedCount = nestedCount + 1
    })

    (entry.name == "opaque-link").ifTrue(() => {
        recognized = true
        (entry.kind == "link").ifFalse(() => { ok = false })
        linkCount = linkCount + 1
    })

    recognized.ifFalse(() => { ok = false })
})

(readText(captured, stablePath) == "before").ifFalse(() => { ok = false })
(readText(captured, stablePath) == "before").ifFalse(() => { ok = false })
(readText(captured, childPath) == "nested-before").ifFalse(() => { ok = false })

ioFails(() => captured.open(linkPath).value()).ifFalse(() => { ok = false })
writeOptions: {
    read: false
    write: true
}
writeFailed: ioFails(() => captured.open(stablePath, writeOptions).value())
writeFailed.ifFalse(() => { ok = false })
replaceFailed: ioFails(() => captured.replace(stablePath, rootPath.child("replacement.txt")).value())
replaceFailed.ifFalse(() => { ok = false })
ioFails(() => captured.remove(stablePath).value()).ifFalse(() => { ok = false })

subtree: captured.captureTree(nestedPath).value()
subtree.hasSlot("close").ifTrue(() => { ok = false })
(subtree.entries(Path.relative()).value().size() == 1).ifFalse(() => { ok = false })
subtreeReadOk: readText(subtree, Path.relative().child("child.txt")) == "nested-before"
subtreeReadOk.ifFalse(() => { ok = false })

(stableCount == 1).ifFalse(() => { ok = false })
(nestedCount == 1).ifFalse(() => { ok = false })
(linkCount == 1).ifFalse(() => { ok = false })
ok
