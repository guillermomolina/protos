first: filesystem.entries(Path.relative()).value()
second: filesystem.entries(Path.relative()).value()

ok: first.size() == 3
((first === second) == false).ifFalse(() => { ok = false })
regularCount: 0
directoryCount: 0
linkCount: 0

first.each((entry) => {
    descriptorShapeOk: entry.parent() === Object
    entry.hasSlot("name").ifFalse(() => { descriptorShapeOk = false })
    entry.hasSlot("kind").ifFalse(() => { descriptorShapeOk = false })
    descriptorShapeOk.ifFalse(() => { ok = false })

    recognized: false

    (entry.name == "MixedCase.txt").ifTrue(() => {
        recognized = true
        (entry.kind == "regular").ifFalse(() => { ok = false })
        regularCount = regularCount + 1
    })

    (entry.name == "nested").ifTrue(() => {
        recognized = true
        (entry.kind == "directory").ifFalse(() => { ok = false })
        directoryCount = directoryCount + 1
    })

    (entry.name == "opaque-link").ifTrue(() => {
        recognized = true
        (entry.kind == "link").ifFalse(() => { ok = false })
        linkCount = linkCount + 1
    })

    recognized.ifFalse(() => { ok = false })

    mutationFailed: false
    Error.handle(() => {
        entry.name = "changed"
        ok = false
        null
    }, (error) => {
        mutationFailed = true
        null
    })
    mutationFailed.ifFalse(() => { ok = false })
})

(regularCount == 1).ifFalse(() => { ok = false })
(directoryCount == 1).ifFalse(() => { ok = false })
(linkCount == 1).ifFalse(() => { ok = false })
ok
