path: Path.relative().child("end.bin")
options: {
    read: true
    write: true
}
file: filesystem.open(path, options).value()
endPosition: file.seekToEnd().value()
file.write(Encoding.Latin1.encode("D")).value()
positionAfterWrite: file.position().value()

reader: filesystem.open(path).value()
bytes: reader.read(10).value()
reader.close().value()
file.close().value()

(endPosition == 3) &&
    (positionAfterWrite == 4) &&
    (bytes.size() == 4) &&
    (bytes[0] == 65) &&
    (bytes[1] == 66) &&
    (bytes[2] == 67) &&
    (bytes[3] == 68)
