path: Path.relative().child("truncate.bin")
options: {
    read: true
    write: true
}
file: filesystem.open(path, options).value()
file.seek(5).value()
truncateResult: file.truncate(2).value()
position: file.position().value()
size: file.size().value()

reader: filesystem.open(path).value()
remaining: reader.read(10).value()
reader.close().value()
file.close().value()

(truncateResult === file).and() {
    (position == 5).and() {
        (size == 2).and() {
            (remaining.size() == 2).and() {
                (remaining.at(0) == 1).and() {
                    remaining.at(1) == 2
                }
            }
        }
    }
}
