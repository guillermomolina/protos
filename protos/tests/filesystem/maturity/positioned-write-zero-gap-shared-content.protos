path: Path.relative().child("gap.bin")
options: {
    read: true
    write: true
}
writer: filesystem.open(path, options).value()
writer.seek(4).value()
writeResult: writer.write(Encoding.Latin1.encode("Z")).value()
position: writer.position().value()
size: writer.size().value()

reader: filesystem.open(path).value()
bytes: reader.read(10).value()
reader.close().value()
writer.close().value()

(writeResult === writer) &&
    (position == 5) &&
    (size == 5) &&
    (bytes.size() == 5) &&
    (bytes[0] == 65) &&
    (bytes[1] == 66) &&
    (bytes[2] == 0) &&
    (bytes[3] == 0) &&
    (bytes[4] == 90)
