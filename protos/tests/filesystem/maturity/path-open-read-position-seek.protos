path: Path.relative().child("alpha.bin")
file: filesystem.open(path).value()
first: file.read(2).value()
positionAfterRead: file.position().value()
seekResult: file.seek(1).value()
second: file.read(2).value()
size: file.size().value()
file.close().value()

(first.size() == 2) &&
    (first.at(0) == 10) &&
    (first.at(1) == 20) &&
    (positionAfterRead == 2) &&
    (seekResult == 1) &&
    (second.size() == 2) &&
    (second.at(0) == 20) &&
    (second.at(1) == 30) &&
    (size == 4)
