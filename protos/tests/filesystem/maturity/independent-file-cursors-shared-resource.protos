path: Path.relative().child("shared.bin")
firstFile: filesystem.open(path).value()
secondFile: filesystem.open(path).value()

firstByte: firstFile.read(1).value()
secondPositionBefore: secondFile.position().value()
secondBytes: secondFile.read(2).value()
firstPositionAfter: firstFile.position().value()
secondPositionAfter: secondFile.position().value()

firstFile.close().value()
secondFile.close().value()

(firstByte.size() == 1) &&
    (firstByte.at(0) == 7) &&
    (secondPositionBefore == 0) &&
    (secondBytes.size() == 2) &&
    (secondBytes.at(0) == 7) &&
    (secondBytes.at(1) == 8) &&
    (firstPositionAfter == 1) &&
    (secondPositionAfter == 2)
