binarySearch: (items, target, low, high) => {
    found: null
    mid: 0
    current: 0

    while(low <= high && found === null) {
        mid = low + (high - low).div(2)
        current = items[mid]

        if(current == target) {
            found = mid
        } else {
            if(current < target) {
                low = mid + 1
            } else {
                high = mid - 1
            }
        }
    }

    found
}

values: [1, 3, 5, 7, 9]

print(binarySearch(values, 7, 0, values.size() - 1))

missing: binarySearch(values, 4, 0, values.size() - 1)

if(missing === null) {
    print("not found")
} else {
    print(missing)
}
