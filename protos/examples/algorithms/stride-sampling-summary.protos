// DOC016: reconcile sampled readings in forward and reverse order.

// Seven chronological readings, oldest first.
readings: [12, 18, 11, 21, 15, 26, 17]

// Count threshold alerts using ordinary collection iteration.
alerts: 0

for(reading in readings) {
    if(reading >= 20) {
        alerts = alerts + 1
    }
}

// Sample even positions from oldest to newest.
forwardTotal: 0

for(index, 0, readings.size(), 2) {
    forwardTotal = forwardTotal + readings[index]
}

// Visit those same positions from newest to oldest.
// The stop bound is exclusive, so -1 includes index zero.
backwardTotal: 0

for(index, readings.size() - 1, -1, -2) {
    backwardTotal = backwardTotal + readings[index]
}

// The sampled values are 12, 11, 15 and 17.
print(alerts)                         // 2
print(forwardTotal)                   // 55
print(backwardTotal == forwardTotal)  // true
