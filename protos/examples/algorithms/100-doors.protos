Arrays: import("std:collections/Array")
Range: import("std:collections/Range")

doorsAfterPasses: (passes) => {
    doors: []

    Range.each(0, 100, (index) => {
        doors = Arrays.append(doors, false)
    })

    pass: 1
    door: 0
    index: 0

    while(pass <= passes) {
        door = pass

        while(door <= 100) {
            index = door - 1
            doors[index] = !doors[index]
            door = door + pass
        }

        pass = pass + 1
    }

    doors
}

finalDoors: doorsAfterPasses(100)

Range.each(0, 100, (index) => {
    if(finalDoors[index]) {
        print(index + 1)
    }
})
