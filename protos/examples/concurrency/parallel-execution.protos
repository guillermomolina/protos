// Isolated parallel execution: closure.parallel() runs the computation in a
// fresh isolated P domain, with no implicit access to the caller's mutable
// lexical state. Inputs cross the boundary explicitly, and the result is
// observed through an ordinary Future.

// The projected closure has no lexical edge back to the caller, so data is
// passed as an argument rather than captured from the surrounding source.
multiplier: 6

scale: (value, factor) => {
    value * factor
}

// parallel(...) returns a Future in the caller's execution domain; value()
// observes it. Changing `multiplier` after this point cannot affect the
// already-snapshotted P input.
print(scale.parallel(7, multiplier).value())

// The std:collections/Array parallel algorithms are Standard Library
// conveniences composed from the same isolation model (closure.parallel plus
// Future.all). Workers may run in any physical order, but every operation below
// is deterministic across machines and schedulers. Trailing arguments after the
// worker are passed to it explicitly, because workers cannot capture caller
// state.
Arrays: import("std:collections/Array")

source: Array(3, 1, 4, 1, 5, 9, 2, 6)

// parallelMap preserves logical source order.
squares: Arrays.parallelMap(source, (value) => {
    value * value
})
print(squares.value())

// parallelFilter preserves source order; the predicate must answer exact
// canonical true or false.
evens: Arrays.parallelFilter(source, (value) => {
    value.mod(2) == 0
})
print(evens.value())

// parallelFindIndex selects the lowest matching logical index, not the
// fastest worker, and null means no element matched.
firstEven: Arrays.parallelFindIndex(source, (value) => {
    value.mod(2) == 0
})
print(firstEven.value())

noMatch: Arrays.parallelFindIndex(source, (value, limit) => {
    value > limit
}, 100)
print(noMatch.value())

// parallelReduce combines adjacent pairs round by round, so scheduling does
// not choose the parenthesization. Do not assume sequential left-fold
// semantics; an empty source reduces to null.
sum: Arrays.parallelReduce(source, (a, b) => {
    a + b
})
print(sum.value())

emptySum: Arrays.parallelReduce(Array(), (a, b) => {
    a + b
})
print(emptySum.value())

// parallelSort is deterministic and stable.
sorted: Arrays.parallelSort(source, (a, b) => {
    a < b
})
print(sorted.value())
