// Asynchrony belongs to closure execution: future() schedules this closure.
initial: (() => { 20 }).future()

// then() always returns another Future and automatically flattens a Future
// returned by the transform.
doubled: initial.then((value) => { value * 2 })
answer: doubled.then((value) => {
    (() => { value + 2 }).future()
})

// value() is the ordinary Future observation/suspension operation.
print(answer.value())
