// Classify response codes locally; no network request is performed.
classifyStatus: (status) => {
    match(status) {
        200: "success"
        201: "created"
        400: "invalid request"
        404: "not found"
        503: "retry later"
        Any: "unknown status"
    }
}

// Each code and its classification occupy consecutive output lines.
for(status in [200, 201, 400, 404, 503, 999]) {
    print(status)                 // 200, 201, 400, 404, 503, 999 in order
    print(classifyStatus(status)) // success, created, invalid request,
                                  // not found, retry later, unknown status
}

print(classifyStatus(200) == "success")         // true; known code
print(classifyStatus(999) == "unknown status")  // true; fallback
print(classifyStatus(404) == "not found")       // true; intermediate case
