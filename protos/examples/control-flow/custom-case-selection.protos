// Reuse an existing cases Map with ordinary callable actions.
handler: () => 5
cases: %{
    1: handler
    Any: () => 0
}
print(1.caseOf(cases)) // 5; the existing handler is invoked
print(2.caseOf(cases)) // 0; the same table is reused

// A direct callable action and a contextual Closure-valued expression differ.
print(1.caseOf(%{ Any: handler })) // 5
selected: match(1) { Any: handler }
print(selected === handler) // true; the implicit action returns handler
print(selected())           // 5; the returned Closure can be invoked later

// A custom caseOf receives the ordinary table and chooses what to do with it.
subject: {
    caseOf: (cases) => cases
}
received: match(subject) {
    1: 2
    3: x => x
}
print(received.size()) // 2; this method returned the Map without selecting
print(received[1]())   // 2; invoke the implicit action later
print(received[3](4))  // 4; invoke the explicit action with a capture argument
