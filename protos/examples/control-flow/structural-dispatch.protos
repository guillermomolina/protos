// Array dispatch: ordinary Array matchers require an exact length.
processMessage: (message) => {
    match(message) {
        ["add", Capture, Capture]: (a, b) => a + b
        ["echo", Capture]: value => value
        ["reset"]: 0
        Any: null
    }
}

print(processMessage(["add", 10, 20]))              // 30
print(processMessage(["echo", "hello"]))            // hello
print(processMessage(["reset"]))                    // 0
print(processMessage(["unknown"]))                  // null
print(processMessage(["add", 10, 20]) == 30)        // true
print(processMessage(["echo", "hello"]) == "hello") // true
print(processMessage(["reset"]) == 0)              // true
print(processMessage(["unknown"]) === null)        // true
print(processMessage(["reset", 1]) === null)        // true; length differs

// Map dispatch: ordinary Map matchers require associations, ignoring extras.
processMapMessage: (message) => {
    match(message) {
        (%{
            "kind": "data"
            "payload": Capture
        }): payload => payload

        (%{
            "kind": "ping"
        }): "pong"

        Any: null
    }
}

data: %{
    "kind": "data"
    "payload": 42
}
withExtra: %{
    "kind": "data"
    "payload": 73
    "trace": "ignored"
}
ping: %{ "kind": "ping" }
missing: %{ "kind": "data" }
unknown: %{ "kind": "other" }

print(processMapMessage(data))                  // 42
print(processMapMessage(withExtra))             // 73
print(processMapMessage(ping))                  // pong
print(processMapMessage(missing) === null)      // true; payload is required
print(processMapMessage(unknown) === null)      // true
print(processMapMessage(data) == 42)            // true
print(processMapMessage(withExtra) == 73)       // true; open matching
print(processMapMessage(ping) == "pong")        // true
