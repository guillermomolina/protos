// Only invoiceTotal and separateContexts become public own slots.
Rules: import("./Rules.protos")
Rates: import("dep:rates/Rates")
privateDiscount: 3

this.invoiceTotal: (subtotal) => {
    subtotal + Rules.handling - privateDiscount + Rates.delivery()
}
this.separateContexts: context !== this
