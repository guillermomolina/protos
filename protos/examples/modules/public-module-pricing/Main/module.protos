// A small service accessed through the package MODULE resolver.
Prices: import("self:Prices")
Again: import("self:Prices")

if(Prices !== Again) { fail() }
if(!Prices.separateContexts) { fail() }
if(Prices.quote(40) != 42) { fail() }

writer: TextWriter(process.stdout(), process.stdoutEncoding())
writer.writeLine("price=42").value()
