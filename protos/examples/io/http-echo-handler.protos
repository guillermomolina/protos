//! The handler module of `http-loopback-hosting.protos`, installed by the
//! embedding host as `app:echo`. Each Worker Actor imports its own instance.

/// Answers the request body unchanged, reading it incrementally.
///
/// The host's `maxRequestBodyBytes` is enforced on two paths. A declared
/// `Content-Length` above it is rejected before this handler runs, with a
/// best-effort 413. A chunked body that exceeds it while being read instead
/// fails the `request.body.read` that reaches the limit with a fresh HttpError
/// of kind "requestLimit"; the server then attempts a 413 only if the final
/// response was not yet committed.
handle: (request) => {
    received: Encoding.Latin1.encode("")
    piece: request.body.read(1024).value()
    while(piece !== null) {
        piece.each((octet) => {
            received.add(octet)
        })
        piece = request.body.read(1024).value()
    }
    response: {
        status: 200
        headers: [["Content-Type", Encoding.Latin1.encode("application/octet-stream")]]
        body: received
    }
    response
}
