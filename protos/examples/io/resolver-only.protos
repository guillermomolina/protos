// Manual, host-dependent name resolution without TCP authority.
// bin/protos --allow-resolver protos/examples/io/resolver-only.protos
// No Network, Java or FFI is needed. This file is outside the print-example sweep.

addresses: (() => {
    resolver.lookupAddresses("example.org").value()
}).ensure(() => {
    resolver.close().value()
})

// IpAddress values are ordinary transferable data; inspecting them opens no connection.
addresses.each((address) => {
    address.version
})
addresses
