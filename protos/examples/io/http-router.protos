// Authority-free Router example. Runs in the standalone CLI.
// The resulting handler is an ordinary callable suitable for std:http/Server.

Router: import("std:http/Router").Router

handler: Router.compile([
    {
        method: "GET"
        path: "/"
        handle: (request, match) => {
            {
                status: 200
                headers: []
                body: Encoding.UTF8.encode("home")
            }
        }
    },
    {
        method: "GET"
        path: "/projects/{name}"
        handle: (request, match) => {
            {
                status: 200
                headers: []
                body: Encoding.UTF8.encode(
                    "project=" + match.params["name"] + ";query=" + match.query
                )
            }
        }
    }
])

requestOf: (method, target) => {
    {
        method: method
        target: Encoding.Latin1.encode(target)
    }
}

matched: handler(requestOf("GET", "/projects/protos?view=short"))
missing: handler(requestOf("GET", "/missing"))

(matched.status == 200) &&
    (Encoding.UTF8.decode(matched.body) == "project=protos;query=view=short") &&
    (missing.status == 404) &&
    (missing.body === null)
