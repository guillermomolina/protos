// One-shot HTTPS request with explicitly granted Network and Resolver.
//
// Requires a Java Polyglot embedding that grants both bootstrap-local
// capabilities, outbound connectivity, and accessible Java cacerts.
// The standalone CLI does not provide these grants.
// This is a manual example; automated tests must use local fixtures.

UrlClient: import("std:http/UrlClient").UrlClient
Trust: import("std:tls/Client").Trust

authorities: {
    network: network
    resolver: resolver
    trust: Trust.javaCacerts()
}

request: {
    method: "GET"
    headers: [
        ["Accept", Encoding.Latin1.encode("application/vnd.github+json")],
        ["User-Agent", Encoding.Latin1.encode("protos-url-client-example")],
        ["X-GitHub-Api-Version", Encoding.Latin1.encode("2022-11-28")]
    ]
    body: null
}

// The UrlClient resolves the URL host with the explicitly supplied Resolver,
// connects through Network, authenticates TLS using the original hostname,
// and buffers the HTTP response before its callback-scoped body retires.
response: UrlClient.requestOne(
    authorities,
    "https://api.github.com/repos/guillermomolina/protos",
    request,
    null
).value()

// An embedding can observe this result; the standalone CLI has no
// Network or Resolver authority to execute this example.
(response.status == 200) && (response.body.size() > 0)
