// Perform an HTTP GET over a TCP connection the application opens itself.
//
// Requires the bootstrap-local `network` capability, which the standalone CLI
// does not grant: a Java Polyglot embedding with socket access runs this
// program, and it answers true on success. To stay self-contained it also
// plays the origin server on loopback with std:http/Server.

Server: import("std:http/Server").Server
Client: import("std:http/Client").Client
IpAddress: import("std:network/IpAddresses").IpAddress
IpEndpoint: import("std:network/IpEndpoints").IpEndpoint

loopback: IpAddress(4, 2130706433)    // 127.0.0.1

handler: (request) => {
    response: {
        status: 200
        headers: [["Content-Type", Encoding.Latin1.encode("text/plain")]]
        body: Encoding.UTF8.encode("hello over TCP")
    }
    response
}
request: {
    method: "GET"
    target: Encoding.Latin1.encode("/")
    headers: [["Host", Encoding.Latin1.encode("127.0.0.1")], ["Accept", Encoding.Latin1.encode("text/plain")]]
    body: null
}
onResponse: (response) => {
    received: Encoding.Latin1.encode("")
    piece: response.body.read(1024).value()
    while(piece !== null) {
        piece.each((octet) => {
            received.add(octet)
        })
        piece = response.body.read(1024).value()
    }
    result: {
        status: response.status
        text: Encoding.UTF8.decode(received)
    }
    result
}

listenRequest: {
    ipVersion: 4
    address: loopback
    port: null
}
listener: network.listenTcp(listenRequest).value()

// --- The origin: accept one connection and serve one request on it.
origin: (() => {
    accepted: listener.accept().value()
    Server.serveOne.owning(accepted, handler, null).value()
}).future()

answer: (() => {
    // --- The client: no URL, no DNS. Connect to a numeric endpoint, then
    // lend the connection to the Client for exactly one exchange.
    connection: network.connectTcp(IpEndpoint(loopback, listener.localPort())).value()
    // Borrowed: the connection stays ours, so we close it ourselves.
    exchanged: (() => {
        Client.exchangeOne(connection, request, onResponse, null).value()
    }).ensure(() => {
        connection.close().value()
    })
    // Success also requires the origin to have served and closed its side; a
    // server failure signals here and becomes the program's failure.
    origin.value()
    exchanged
}).ensure(() => {
    // After success the origin is already terminal and cancel() changes
    // nothing. After a failure, cancel() wakes the origin from whatever it
    // awaits, and closing the listener ends any accept still pending, so the
    // final wait always terminates. That wait only lets the origin's owning
    // cleanup finish; its outcome must not replace the failure that got us here.
    origin.cancel()
    (() => {
        listener.close().value()
    }).ensure(() => {
        Error.handle(
            () => {
                origin.value()
            },
            (error) => {
                error
            }
        )
    })
})

(answer.status == 200) && (answer.text == "hello over TCP")
