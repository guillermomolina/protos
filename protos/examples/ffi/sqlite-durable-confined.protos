// Proposed D256 API; run from an installed portable JVM distribution.
// The host must first provision application.db.identity (see the SQLite guide).
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
db: SQLite.openDurable(sqlite, "application.db")
(() => {
    create: db.prepare("CREATE TABLE IF NOT EXISTS samples (id INTEGER PRIMARY KEY, label TEXT)")
    (() => { Assertions.require(!create.step()) }).ensure(() => create.close().value())
    db.begin()
    insert: db.prepare("INSERT INTO samples(id, label) VALUES (?1, ?2)")
    (() => {
        insert.bind(1, 42).bind(2, "durable SQLite")
        Assertions.require(!insert.step())
    }).ensure(() => insert.close().value())
    db.commit()
    query: db.prepare("SELECT label FROM samples WHERE id = ?1")
    (() => {
        query.bind(1, 42)
        Assertions.require(query.step())
        Assertions.require(query.column(0) == "durable SQLite")
        Assertions.require(!query.step())
    }).ensure(() => query.close().value())
}).ensure(() => db.close().value())
