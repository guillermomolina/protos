// Query an in-memory SQLite database from Protos through the optional FFM
// provider (I144). Every C function is declared below in Protos; the provider
// contains no SQLite-specific Java.
//
// This is a demonstration of the low-level provider operations, not a
// SQLite library: a real application should prefer the future LIB029
// library (connections, statements, transactions) once it exists.
//
//   bin/protos --foreign-provider-path /path/to/protos-ffm-provider.jar \
//       protos/examples/ffi/sqlite-memory-query.protos
//
// Success: no standard output, exit status 0. `:memory:` keeps the example
// free of database files and of filesystem permissions.
// See protos/examples/ffi/README.md.

Assertions: import("std:test/assertions")
sqlite: import("ffi:sqlite3")

// Builds a C signature from an ordinary Protos Array of descriptors, one
// `param` at a time. The Array stays in Protos; it never crosses the SPI.
signature: (returns, parameters) => {
    composed: sqlite.signature(returns)
    parameters.each((parameter) => {
        composed = sqlite.param(composed, parameter)
    })
    composed
}

// Copies a borrowed region into ordinary Protos Bytes. Bytes has no prelude
// constructor: an empty Bytes comes from the standard encoder and grows
// through `add`. No UTF-8 is interpreted on the way.
copyBytes: (region, length) => {
    copied: sqlite.copy(region, length)
    bytes: Encoding.UTF8.encode("")
    index: 0
    while(index < copied.size) {
        bytes.add(copied[index])
        index = index + 1
    }
    bytes
}

SQLITE_OK: 0
SQLITE_ROW: 100
SQLITE_DONE: 101
SQLITE_OPEN_READWRITE_CREATE: 6

// ---- Types: a connection and a statement, each with its destructor

dbType: sqlite.opaque("sqlite3")
stmtType: sqlite.opaque("sqlite3_stmt")
db: sqlite.owned(dbType, "sqlite3_close_v2", sqlite.i32)
stmt: sqlite.owned(stmtType, "sqlite3_finalize", sqlite.i32)

// C NULL for `const char *zVfs` and `const char **pzTail`: nullable pointers
// of private types that no binding produces, so only `null` is admitted.
vfsName: sqlite.nullable(sqlite.opaque("sqlite3_vfs_name"))
sqlTail: sqlite.nullable(sqlite.opaque("sqlite3_sql_tail"))

// ---- C declarations

open: sqlite.bind("sqlite3_open_v2",
    signature(sqlite.i32, Array(sqlite.utf8z, sqlite.out(db), sqlite.i32, vfsName)))
prepare: sqlite.bind("sqlite3_prepare_v2",
    signature(sqlite.i32, Array(dbType, sqlite.utf8z, sqlite.i32, sqlite.out(stmt), sqlTail)))
step: sqlite.bind("sqlite3_step", signature(sqlite.i32, Array(stmtType)))

// Column readers that return scalars do not touch earlier borrowed regions:
// they are declared `preserving`, a trusted statement about SQLite's ABI.
columnInt64: sqlite.bind("sqlite3_column_int64",
    sqlite.preserving(signature(sqlite.i64, Array(stmtType, sqlite.i32))))
columnDouble: sqlite.bind("sqlite3_column_double",
    sqlite.preserving(signature(sqlite.f64, Array(stmtType, sqlite.i32))))
columnBytes: sqlite.bind("sqlite3_column_bytes",
    sqlite.preserving(signature(sqlite.i32, Array(stmtType, sqlite.i32))))
// Text and blob pointers are memory owned by SQLite: borrowed regions.
columnText: sqlite.bind("sqlite3_column_text",
    signature(sqlite.borrowed, Array(stmtType, sqlite.i32)))
columnBlob: sqlite.bind("sqlite3_column_blob",
    signature(sqlite.borrowed, Array(stmtType, sqlite.i32)))

// ---- Open the in-memory database

opened: open(":memory:", SQLITE_OPEN_READWRITE_CREATE, null)
// [status, connection]: the status is data; checking it is our job.
Assertions.require(opened[0] == SQLITE_OK)
connection: opened[1]

// ---- Prepare and run one query

prepared: prepare(connection, "SELECT 40 + 2, 1.5 * 2, 'caf\u{E9}', x'00ff10'", -1, null)
Assertions.require(prepared[0] == SQLITE_OK)
statement: prepared[1]

Assertions.require(step(statement) == SQLITE_ROW)

// Numeric columns arrive as ordinary Integer and Float values.
Assertions.require(columnInt64(statement, 0) == 42)
Assertions.require(columnDouble(statement, 1) == 3.0)

// Text: pointer, then length (preserving), then the bounded copy, in this
// order. The octets are the UTF-8 encoding SQLite stored: "caf" + C3 A9.
text: copyBytes(columnText(statement, 2), columnBytes(statement, 2))
Assertions.require(text.size() == 5)
Assertions.require((text[0] == 99) && (text[2] == 102) && (text[3] == 195) && (text[4] == 169))

// Blob: the same pattern; binary data, including a zero octet.
blob: copyBytes(columnBlob(statement, 3), columnBytes(statement, 3))
Assertions.require(blob.size() == 3)
Assertions.require((blob[0] == 0) && (blob[1] == 255) && (blob[2] == 16))

// One row only.
Assertions.require(step(statement) == SQLITE_DONE)

// ---- Release: statement first, then the connection

Assertions.require(sqlite.release(statement) == SQLITE_OK)   // sqlite3_finalize
Assertions.require(sqlite.release(connection) == SQLITE_OK)  // sqlite3_close_v2
