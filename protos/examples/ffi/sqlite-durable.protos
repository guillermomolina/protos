// Supply one database filename; this example owns/replaces only durable_demo.
// Requires the portable JVM FFM provider and explicit sqlite3 authorization.
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
args: process.args()
Assertions.require(args.size() == 1)
path: args[0]
verify: (db) => {
    query: db.prepare("SELECT id, name, payload FROM durable_demo ORDER BY id")
    (() => {
        count: 0
        query.each((row) => {
            count = count + 1
            Assertions.require(row[0] == count)
            expected: "first"
            if(count == 2) { expected = "second" }
            Assertions.require(row[1] == expected)
            Assertions.require(Encoding.Latin1.decode(row[2]) == "\u{0}\u{FF}")
        })
        Assertions.require(count == 2)
    }).ensure(() => query.close().value())
}
db: SQLite.openFile(path)
(() => {
    db.busyTimeout(250)
    db.begin()
    create: db.prepare("CREATE TABLE IF NOT EXISTS durable_demo(id INTEGER PRIMARY KEY, name TEXT, payload BLOB)")
    (() => { Assertions.require(create.step() === false) }).ensure(() => create.close().value())
    clear: db.prepare("DELETE FROM durable_demo")
    (() => { Assertions.require(clear.step() === false) }).ensure(() => clear.close().value())
    insert: db.prepare("INSERT INTO durable_demo VALUES(?1, ?2, ?3)")
    (() => {
        insert.bind(1, 1).bind(2, "first").bind(3, Encoding.Latin1.encode("\u{0}\u{FF}"))
        Assertions.require(insert.step() === false)
        // Reset keeps the BLOB binding; only id and name change.
        insert.reset().bind(1, 2).bind(2, "second")
        Assertions.require(insert.step() === false)
    }).ensure(() => insert.close().value())
    Assertions.require(db.inTransaction())
    db.commit()
    Assertions.require(!db.inTransaction())

    db.begin()
    update: db.prepare("UPDATE durable_demo SET name=?1 WHERE id=?2")
    (() => {
        update.bind(1, "temporary").bind(2, 1)
        Assertions.require(update.step() === false)
    }).ensure(() => update.close().value())
    db.rollback()
    verify(db)
}).ensure(() => db.close().value())

reopened: SQLite.openFile(path, "readOnly")
(() => { verify(reopened) }).ensure(() => reopened.close().value())
