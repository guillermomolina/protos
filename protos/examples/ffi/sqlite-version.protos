// Smoke test for the optional FFM provider (I144): call one C function of
// the host-authorized SQLite library, declared here in Protos.
//
//   bin/protos --foreign-provider-path /path/to/protos-ffm-provider.jar \
//       protos/examples/ffi/sqlite-version.protos
//
// Success: no standard output, exit status 0. Without the provider JAR the
// `ffi:sqlite3` import fails and the exit status is non-zero.
// See protos/examples/ffi/README.md.

Assertions: import("std:test/assertions")
sqlite: import("ffi:sqlite3")

// int sqlite3_libversion_number(void);
version: sqlite.bind(
    "sqlite3_libversion_number",
    sqlite.signature(sqlite.i32)
)

Assertions.require(version() >= 3000000)
