// Run in a second JVM after sqlite-durable-confined.protos with the same grant.
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
db: SQLite.openDurable(sqlite, "application.db")
(() => {
    query: db.prepare("SELECT id, label FROM samples")
    (() => {
        Assertions.require(query.step())
        row: query.row()
        Assertions.require((row[0] == 42) && (row[1] == "durable SQLite"))
        Assertions.require(!query.step())
    }).ensure(() => query.close().value())
}).ensure(() => db.close().value())
