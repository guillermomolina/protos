// LIB028 public API example. Authorize the optional provider explicitly:
// bin/protos --foreign-provider-path /path/to/protos-ffm-provider.jar \
//     protos/examples/ffi/sqlite-version-public.protos
// Trusted Linux x86-64 native code, portable JVM with JDK 25 only.

Assertions: import("std:test/assertions")
FFI: import("std:ffi")
sqlite: import("ffi:sqlite3")

// int sqlite3_libversion_number(void); the Java backend knows no such symbol.
version: FFI.bind(sqlite, "sqlite3_libversion_number", FFI.i32, Array())
number: version()
Assertions.require(Integer.recognizes(number))
Assertions.require(number >= 3000000)
