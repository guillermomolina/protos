// DOC024 cookbook: query and filter numeric records with prepared parameters.
// Host: --foreign-provider-path <protos-ffm-provider.jar>; Linux x86-64 JVM/JDK25.
// Numeric binds and one INSERT reused through reset()/clearBindings() (LIB030).
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
db: SQLite.openMemory()
(() => {
    create: db.prepare("CREATE TABLE readings (id INTEGER, value REAL, flag INTEGER)")
    (() => { Assertions.require(create.step() === false) }).ensure(() => create.close().value())

    // One prepared INSERT is reused. The first execution binds and steps;
    // every later one resets, rebinds and steps.
    insert: db.prepare("INSERT INTO readings VALUES (?1, ?2, ?3);")
    (() => {
        insert.bind(1, 4).bind(2, 0.5).bind(3, 20)
        Assertions.require(insert.step() === false)
        for(reading in Array(Array(2, 2.5, 10), Array(5, 4.0, 30))) {
            insert.reset().bind(1, reading[0]).bind(2, reading[1]).bind(3, reading[2])
            Assertions.require(insert.step() === false)
        }
        // clearBindings() here deliberately turns the unbound flag into SQL NULL.
        for(reading in Array(Array(1, 1.5), Array(3, 3.25))) {
            insert.reset().clearBindings().bind(1, reading[0]).bind(2, reading[1])
            Assertions.require(insert.step() === false)
        }
    }).ensure(() => insert.close().value())

    // A numeric predicate; ORDER BY makes the traversal deterministic.
    query: db.prepare("SELECT id, value, flag FROM readings WHERE value >= ?1 AND id <= ?2 ORDER BY id")
    expected: Array(2, 3, 5)
    seen: 0
    total: 0.0
    (() => {
        query.bind(1, 2.0).bind(2, 5)
        query.each((row) => {
            Assertions.require(Float.recognizes(row[1]))
            Assertions.require(row[0] == expected[seen])
            seen = seen + 1
            total = total + row[1]
            if(row[0] == 3) { Assertions.require(row[2] === null) }
            if(row[0] == 5) { Assertions.require(row[2] == 30) }
        })
    }).ensure(() => query.close().value())
    Assertions.require(seen == 3)
    Assertions.require(total == 9.75)

    // Single-row aggregate read with step and column.
    missing: db.prepare("SELECT count(*) FROM readings WHERE flag IS NULL")
    (() => {
        Assertions.require(missing.step())
        Assertions.require(missing.column(0) == 2)
        Assertions.require(missing.step() === false)
    }).ensure(() => missing.close().value())
}).ensure(() => db.close().value())
