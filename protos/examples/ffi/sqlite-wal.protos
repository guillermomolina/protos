// This example creates, deletes rows from and inserts data only into wal_demo.
// PRAGMA journal_mode=WAL changes journaling for the entire database;
// WAL persists across connections and reopenings.
// PRAGMA synchronous=FULL configures only the current connection;
// future connections must not be assumed to inherit it automatically.
// For these reasons, supply a disposable SQLite database filename.
// WAL/FULL durability depends on SQLite, VFS, filesystem and storage;
// this is not a universal guarantee against physical power loss.
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
args: process.args()
Assertions.require(args.size() == 1)
path: args[0]
verify: (connection) => {
    query: connection.prepare("SELECT id, label FROM wal_demo ORDER BY id")
    (() => {
        Assertions.require(query.step())
        Assertions.require(query.column(0) == 1)
        Assertions.require(query.column(1) == "committed")
        Assertions.require(query.step() === false)
    }).ensure(() => query.close().value())
}
db: SQLite.openFile(path)
(() => {
    db.busyTimeout(250)
    // A PRAGMA request is not proof that SQLite selected the requested mode.
    journal: db.prepare("PRAGMA journal_mode=WAL")
    (() => {
        Assertions.require(journal.step())
        Assertions.require(journal.column(0) == "wal")
        Assertions.require(journal.step() === false)
    }).ensure(() => journal.close().value())
    sync: db.prepare("PRAGMA synchronous=FULL")
    (() => { Assertions.require(sync.step() === false) }).ensure(() => sync.close().value())
    policy: db.prepare("PRAGMA synchronous")
    (() => {
        Assertions.require(policy.step())
        Assertions.require(policy.column(0) == 2) // SQLite FULL
        Assertions.require(policy.step() === false)
    }).ensure(() => policy.close().value())
    create: db.prepare("CREATE TABLE IF NOT EXISTS wal_demo(id INTEGER PRIMARY KEY, label TEXT)")
    (() => { Assertions.require(create.step() === false) }).ensure(() => create.close().value())

    // Replacing this table's rows in one transaction makes repeated runs safe.
    db.begin()
    clear: db.prepare("DELETE FROM wal_demo")
    (() => { Assertions.require(clear.step() === false) }).ensure(() => clear.close().value())
    insert: db.prepare("INSERT INTO wal_demo VALUES(?1, ?2)")
    (() => {
        insert.bind(1, 1).bind(2, "committed")
        Assertions.require(insert.step() === false)
    }).ensure(() => insert.close().value())
    db.commit()
    Assertions.require(!db.inTransaction())
    verify(db)
}).ensure(() => db.close().value())

// SQLite manages its sidecars; the application never deletes them.
reopened: SQLite.openFile(path, "readOnly")
(() => {
    journal: reopened.prepare("PRAGMA journal_mode")
    (() => {
        Assertions.require(journal.step())
        Assertions.require(journal.column(0) == "wal")
        Assertions.require(journal.step() === false)
    }).ensure(() => journal.close().value())

    verify(reopened)
}).ensure(() => reopened.close().value())
