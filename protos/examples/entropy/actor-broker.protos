// I157 / D243-C: secure Entropy broker through ordinary ActorRef messages.
//
// Launch as a RootActor message service:
//     bin/protos --allow-entropy --service=service protos/examples/entropy/actor-broker.protos
//
// The initial module alone receives `entropy`. Child Actors do not inherit
// that capability and cannot receive it through Actor transfer. A client
// sends a request to the RootActor and receives ordinary Bytes by value.
//
// For HTTP Host.owningWithFactory, pass only a communication reference:
//     dependencies: { service: rootGroup }
// Never put `entropy` in Worker initialization. A Worker may call:
//     dependencies.service.request("bytes", 16).value()
// in an ordinary suspendible request-handling turn.

ProcessStreams: import("std:io/process_streams")

// The bootstrap binding runs once, installs a behavior and returns.
// No pending entropy Future is observed during service initialization.
service: () => {
    out: ProcessStreams.stdoutWriter(process)
    rootGroup: Actor.group(Actor.current())

    visitor: Actor.spawn("./actor-broker.protos", "visitor")
    visitor.send("fetch", rootGroup)

    behavior: {
        bytes: (count) => {
            // This is an ordinary service message turn, not bootstrap.
            // The generated Bytes may cross Actor boundaries by value.
            entropy.bytes(count).value()
        }

        report: (message) => {
            // Report only sizes/status, never generated octets.
            out.writeLine(message).value()
            null
        }
    }

    behavior
}

// Runs in the visitor's distinct Actor, without bootstrap Entropy authority.
visitor: () => {
    hasAmbientEntropy: context.hasSlot("entropy")

    behavior: {
        fetch: (serviceRef) => {
            // Requesting results is not transferring the Entropy grant.
            sixteen: serviceRef.request("bytes", 16).value()
            thirtyTwo: serviceRef.request("bytes", 32).value()

            valid: !hasAmbientEntropy &&
                (sixteen.size() == 16) &&
                (thirtyTwo.size() == 32)

            status: "failed"
            if(valid) {
                status = "ok"
            }

            serviceRef.send("report", "entropy-broker " + status)
            null
        }
    }

    behavior
}
