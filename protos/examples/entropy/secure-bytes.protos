// I157 / D243-C: host-granted secure random bytes.
//
// Execute as a normal direct-entry program:
//     bin/protos --allow-entropy protos/examples/entropy/secure-bytes.protos
//
// `entropy` is a bootstrap-local capability granted only to the initial
// RootActor. Importing a module never creates the grant.
//
// Every positive-length operation returns Future<Bytes> immediately.
// Secure material is private: this example never prints or logs the octets.

first: entropy.bytes(16)
second: entropy.bytes(32)

// Future.then automatically flattens a Future returned by its callback.
// Only the ordinary RootActor execution observes the Futures.
sizes: first.then((sixteen) => {
    second.then((thirtyTwo) => {
        [sixteen.size(), thirtyTwo.size()]
    })
}).value()

// Close the grant after both Futures have produced their complete Bytes.
// Closing returns another Future; it releases no other host capabilities.
entropy.close().value()

// The only observable result is [16, 32], not the generated secret material.
sizes
