// Create and triage incident records using named optional fields.
// Standard Object.call forwards labels to this prototype's init Closure.
Incident: {
    init: (ticketId, team, severity: 1, state: "open") => {
        this.ticketId: ticketId
        this.team: team
        this.severity: severity
        this.state: state
    }
}

// Positional id/team fields stay fixed; optional fields can be reordered.
// The second call names every required field and keeps its defaults.
incidents: [
    Incident(401, "platform", state: "triage", severity: 5),
    Incident(team: "payments", ticketId: 402),
    Incident(403, "platform", severity: 4)
]

countEscalations: (items, minimumSeverity: 4) => {
    count: 0
    for(item in items) {
        if(item.severity >= minimumSeverity) {
            count = count + 1
        }
    }
    count
}

print(incidents[0].parent() === Incident)
print(incidents[0].ticketId == 401 && incidents[0].state == "triage")
print(incidents[1].ticketId == 402 && incidents[1].state == "open")
print(incidents[1].severity == 1 && incidents[2].severity == 4)
print(countEscalations(incidents, minimumSeverity: 4) == 2)
print(countEscalations(incidents, minimumSeverity: 5) == 1)
