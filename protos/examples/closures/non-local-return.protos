// Find the first value above a threshold, leaving the enclosing
// function immediately rather than merely leaving the callback.
findFirstAbove: (items, threshold, trace) => {
    items.each((item) => {
        trace.visited = trace.visited + 1

        if(item > threshold) {
            return item
        }
    })

    null
}

// The previous spelling has exactly the same behavior.
findFirstAboveCaret: (items, threshold) => {
    items.each((item) => {
        if(item > threshold) {
            ^item
        }
    })

    null
}

// Grouping preserves an ordinary binding named return.
ordinaryReturnName: () => {
    return: (value) => value * 2
    (return)(21)
}

trace: { visited: 0 }

print(findFirstAbove([1, 3, 5], 2, trace))
print(trace.visited)
print(findFirstAboveCaret([1, 3, 5], 2))
print(findFirstAbove([1, 2], 9, { visited: 0 }) === null)
print(ordinaryReturnName())
