Math: import("std:math/Math")
Range: import("std:collections/Range")

compose: (f, g) => {
    (value) => {
        f(g(value))
    }
}

// The first function is the preexisting built-in Math.sqrt; the rest are user-defined.
functions: [Math.sqrt, (x) => { x * 2.0 }, (x) => { x + 4.0 }]
inverses: [(x) => { x * x }, (x) => { x / 2.0 }, (x) => { x - 4.0 }]

Range.each(0, functions.size(), (index) => {
    print(compose(functions[index], inverses[index])(9.0))
})
