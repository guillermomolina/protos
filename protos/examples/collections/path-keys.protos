// Equal Path values are one Map key but remain two IdentityMap keys.
a: Path.relative().child("same")
b: Path.relative().child("same")
byValue: Map()
byValue.atPut(a, 10)
byValue.atPut(b, 20)
byIdentity: IdentityMap()
byIdentity.atPut(a, 10)
byIdentity.atPut(b, 20)
print(byValue.size())
print(byIdentity.size())
