// Pair ordered item names with available stock counts; unpaired tails are
// intentionally ignored, and the source Arrays are unchanged.
Arrays: import("std:collections/Array")

items: Array("red", "blue", "red", "gold")
counts: Array(5, 2, 9)
pairs: Arrays.zip(items, counts)
stockGroups: Arrays.partition(pairs, (pair) => { pair[1] >= 5 })
labelsAndCounts: Arrays.flatMap(pairs, (pair) => { Array(pair[0], pair[1]) })
uniqueItems: Arrays.distinct(items)

print(pairs.size() == 3 && items.size() == 4 && counts.size() == 3)
print(pairs[0][0] == "red" && pairs[0][1] == 5)
print(pairs[2][0] == "red" && pairs[2][1] == 9)
print(pairs[0] !== pairs[2])
print(stockGroups[0].size() == 2 && stockGroups[1].size() == 1)
print(stockGroups[1][0][0] == "blue")
print(labelsAndCounts.size() == 6 && labelsAndCounts[5] == 9)
print(uniqueItems.size() == 3 && uniqueItems[2] == "gold")
print(Arrays.contains(uniqueItems, "blue"))
