// Apply a linear transformation to a point and verify it two ways, with exact
// Integer arithmetic from std:math/LinearAlgebra. Expected output: -1, 2, then true.

LA: import("std:math/LinearAlgebra")
Vector: LA.Vector
Matrix: LA.Matrix

// A quarter turn counterclockwise, as row-major data: rows [0, -1] and [1, 0].
rotate: Matrix(2, 2, 0, -1, 1, 0)
point: Vector(2, 1)

turned: rotate.matvec(point)
print(turned[0])
print(turned[1])

// Check 1: four quarter turns compose to the identity.
fullTurn: rotate.matmul(rotate).matmul(rotate).matmul(rotate)
same: fullTurn.matvec(point)

// Check 2: a rotation's transpose undoes it.
back: rotate.transpose().matvec(turned)

verified: (turned[0] == -1) && (turned[1] == 2) &&
    (same[0] == 2) && (same[1] == 1) &&
    (back[0] == 2) && (back[1] == 1)
// A wrong result must fail the program, not print false.
if(!verified) {
    Error().signal()
}
print(verified)
