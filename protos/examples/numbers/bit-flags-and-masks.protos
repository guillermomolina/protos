// Portable permission flags using ordinary Integer operations.
// Expected output: six true lines.

readFlag: 1 << 0
writeFlag: 1 << 1
executeFlag: 1 << 2

permissions: readFlag | writeFlag
canWrite: (permissions & writeFlag) != 0

// Set, clear and toggle permissions.
granted: permissions | executeFlag
withoutWrite: granted & (~writeFlag)
toggledRead: permissions ~ readFlag
restored: toggledRead ~ readFlag

// Integer has no implicit width.
// An explicit mask keeps the low 32 bits.
mask32: 4294967295
all32: (~0) & mask32

// Pack and extract two octets.
packed: (255 << 8) | 17
highByte: (packed >> 8) & 255
lowByte: packed & 255

verified:
    canWrite &&
    (permissions == 3) &&
    (granted == 7) &&
    (withoutWrite == 5) &&
    ((withoutWrite & writeFlag) == 0) &&
    (toggledRead == writeFlag) &&
    (restored == permissions) &&
    (all32 == mask32) &&
    (highByte == 255) &&
    (lowByte == 17) &&
    ((-3) >> 1 == -2) &&
    (1 << 64 == 18446744073709551616)

if(!verified) {
    Error().signal()
}

print(canWrite)
print(withoutWrite == 5)
print(toggledRead == writeFlag)
print(restored == permissions)
print((highByte == 255) && (lowByte == 17))
print(verified)
