// Exact rational arithmetic, Float mixing, Complex components, and square roots.
// Each print is a small executable check; the expected output is eight true lines.
Math: import("std:math/Math")
IntegerMath: import("std:math/Integer")

half: 1 / 2
z: Complex(3, 4)

print((half + half) === 1)
print(((half + 0.25) === 0.75))
print((half == 0.5) && !(half === 0.5))
print((1 / 10) != 0.1)
print(z.real() === 3)
print(z.imaginary() === 4)
print(Math.sqrt(1 / 4) === half)
print((Math.sqrt(-4) === Complex(0, 2)) && (IntegerMath.gcd(84, 30) === 6))
