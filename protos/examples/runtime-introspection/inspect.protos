// Requires explicit runtime inspection authorization.
// Run with: protos --inspect examples/runtime-introspection/inspect.protos

Inspect: import("std:inspect")

sum: (limit) => {
    i: 0
    total: 0

    while(i < limit) {
        total = total + i
        i = i + 1
    }

    total
}

print(Inspect.bytecode(sum))
print(Inspect.truffleTree(sum))

print(Inspect.representation(123))
print(Inspect.representation([1, 2, 3]))
print(Inspect.representation(sum))
