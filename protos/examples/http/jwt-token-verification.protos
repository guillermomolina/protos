//! Verify an independent HS256 compact token and reject tampering.
//! Uses no HTTP connection, listener, clock or network capability.

JWT: import("std:auth/jwt")
Instant: import("std:datetime/instant")

// Public deterministic fixture key 00..1f, not a production secret.
testKey: Encoding.UTF8.encode("")
for(i, 0, 32) {
    testKey.add(i)
}

policy: {
    issuer: "https://issuer.example"
    audience: "protos-realworld"
    type: "realworld-access+jwt"
    maxLifetimeSeconds: 3600
}

trustedNow: Instant(1794097000 * 1000000000)

// Independently generated HMAC-SHA256 reference (D246-C).
validToken: "eyJhbGciOiJIUzI1NiIsInR5cCI6InJlYWx3b3JsZC1hY2Nlc3Mrand0In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicHJvdG9zLXJlYWx3b3JsZCIsInN1YiI6InVzZXItaWQtNDIiLCJpYXQiOjE3OTQwOTYwMDAsIm5iZiI6MTc5NDA5NjAwMCwiZXhwIjoxNzk0MDk5NjAwLCJqdGkiOiJpZC03In0.ClxaP-9Ot2XonmcSAQYbQ9ji7hbWNah62Yp059YFyl0"

// Same header and payload, but a forged complete 32-octet tag.
tamperedToken: "eyJhbGciOiJIUzI1NiIsInR5cCI6InJlYWx3b3JsZC1hY2Nlc3Mrand0In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoicHJvdG9zLXJlYWx3b3JsZCIsInN1YiI6InVzZXItaWQtNDIiLCJpYXQiOjE3OTQwOTYwMDAsIm5iZiI6MTc5NDA5NjAwMCwiZXhwIjoxNzk0MDk5NjAwLCJqdGkiOiJpZC03In0.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

verified: JWT.verify(validToken, testKey, policy, trustedNow)

rejected: false

Error.handle(
    () => {
        JWT.verify(tamperedToken, testKey, policy, trustedNow)
    },
    (error) => {
        rejected = error.parent() === JWT.JwtError
    }
)

// Claims are accessible only after verification. A caller must still
// perform application-specific authorization.
(verified.value["sub"].value == "user-id-42") && rejected
