//! Encode an original synthetic sitemap using ordinary caller-created XML records.
XML: import("std:xml/xml")
uri: "http://www.sitemaps.org/schemas/sitemap/0.9"
expandedName: (local) => { { namespaceURI: uri; localName: local; prefix: null } }
location: {
    kind: "element"; name: expandedName("loc"); attributes: []; namespaceDeclarations: []
    children: [{ kind: "text"; value: "https://example.invalid/?a=1&b=2" }]
}
url: { kind: "element"; name: expandedName("url"); attributes: []; namespaceDeclarations: []; children: [location] }
elementRoot: {
    kind: "element"; name: expandedName("urlset"); attributes: []
    namespaceDeclarations: [{ prefix: null; namespaceURI: uri }]; children: [url]
}
document: { kind: "document"; declaration: null; prolog: []; root: elementRoot; epilog: [] }
XML.encode(document)
