//! Query original synthetic Atom data without acquiring external authority.
XML: import("std:xml/xml")
atom: "http://www.w3.org/2005/Atom"
document: XML.parse("<feed xmlns='http://www.w3.org/2005/Atom'><entry><title>A &amp; B</title><author><name>Ada</name></author><link href='https://example.invalid/news'/></entry></feed>")
entry: XML.firstElement(document.root, atom, "entry")
authorElement: XML.firstElement(entry, atom, "author")
{
    title: XML.textContent(XML.firstElement(entry, atom, "title"))
    author: XML.textContent(XML.firstElement(authorElement, atom, "name"))
    link: XML.attribute(XML.firstElement(entry, atom, "link"), null, "href")
}
