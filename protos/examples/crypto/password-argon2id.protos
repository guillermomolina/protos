// I160 / D245-C: password hashing with explicitly granted secure entropy.
// Run: bin/protos --allow-entropy protos/examples/crypto/password-argon2id.protos
//
// Never print the password, salt, record or derived tag. Password records are
// sensitive application data. This example prints Boolean checks only.

Password: import("std:crypto/password")

// This authority exists only when the host explicitly grants it.
record: Password.hash("example passphrase", entropy).value()

valid: Password.verify("example passphrase", record).value()
invalid: Password.verify("incorrect passphrase", record).value()
upToDate: !Password.needsRehash(record)

if(!(valid && !invalid && upToDate)) {
    Error().signal()
}

print(valid)
print(!invalid)
print(upToDate)
