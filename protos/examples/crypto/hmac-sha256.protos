// I159 / D244-C: authenticate the exact octets of a message.
//
// Run:
// bin/protos protos/examples/crypto/hmac-sha256.protos
//
// This fixed key is PUBLIC DEMONSTRATION DATA. Never use a fixed,
// published key for production authentication. Real applications
// require unpredictable keys, secure custody, rotation and protocol
// rules for replay prevention.
//
// Expected output: four true lines.

HMAC: import("std:crypto/hmac_sha256")

key: Encoding.UTF8.encode("public-demonstration-key")
outgoing: Encoding.UTF8.encode("method=POST;path=/articles;body=hello")

// Sender: calculate the full 32-octet tag.
tag: HMAC.digest(key, outgoing)

// Receiver: authenticate the exact received bytes.
received: Encoding.UTF8.encode("method=POST;path=/articles;body=hello")
accepted: HMAC.verify(key, received, tag)

// A change anywhere in the message invalidates the tag.
changed: Encoding.UTF8.encode("method=POST;path=/articles;body=goodbye")
changedRejected: !HMAC.verify(key, changed, tag)

// A different key cannot authenticate this tag.
otherKey: Encoding.UTF8.encode("different-demonstration-key")
wrongKeyRejected: !HMAC.verify(otherKey, received, tag)

// Truncated-prefix verification is deliberately unsupported.
truncated: Encoding.UTF8.encode("")
index: 0
while(index < 16) {
    truncated.add(tag[index])
    index = index + 1
}
truncationRejected: !HMAC.verify(key, received, truncated)

verified:
    accepted &&
    changedRejected &&
    wrongKeyRejected &&
    truncationRejected &&
    (tag.size() == 32)

if(!verified) {
    Error().signal()
}

// Only Boolean outcomes are printed, never key or tag octets.
print(accepted)
print(changedRejected)
print(wrongKeyRejected)
print(truncationRejected)
