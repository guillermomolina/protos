// Object.parent() signals an Error, so the walk stops at the root Object.
respondsToThing: (candidate) => {
    current: candidate
    found: false
    done: false

    while(!done) {
        if(current.hasSlot("thing")) {
            found = true
            done = true
        } else {
            if(current === Object) {
                done = true
            } else {
                current = current.parent()
            }
        }
    }

    found
}

delegator: {
    delegate: null

    operation: () => {
        delegate: this.delegate
        result: "default implementation"

        if(delegate !== null) {
            if(respondsToThing(delegate)) {
                result = delegate.thing()
            }
        }

        result
    }
}

print(delegator.operation())

delegator.delegate = {}
print(delegator.operation())

delegator.delegate = {
    thing: () => {
        "delegate implementation"
    }
}
print(delegator.operation())

thingPrototype: {
    thing: () => {
        "delegate implementation"
    }
}
thingChild: thingPrototype {}
delegator.delegate = thingChild
print(delegator.operation())
