// Client.exchangeOne performs exactly one request/response exchange on a
// duplex you supply. The Client never opens a connection; here the duplex is
// in memory and plays a server that answers with a chunked body.

http: import("std:http/Client")
MemoryDuplex: import("./memory-duplex.protos")

duplex: MemoryDuplex.of(
    "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nHello \r\n7\r\nProtos!\r\n0\r\n\r\n"
)

// Exactly one Host field is required. The target, header values and body
// are Bytes; the Client adds Content-Length and Connection: close itself.
request: {
    method: "GET"
    target: Encoding.Latin1.encode("/greeting")
    headers: [["Host", Encoding.Latin1.encode("example.org")]]
    body: null
}

escaped: null

// onResponse runs once, for the final response. Its body is a ByteReadable
// decoded on demand: read it here, piece by piece, before returning.
onResponse: (response) => {
    print(response.status)
    received: Encoding.Latin1.encode("")
    piece: response.body.read(4).value()
    while(piece !== null) {
        // Reads may be shorter than requested; null marks the end of the body.
        print(Encoding.Latin1.decode(piece))
        piece.each((octet) => {
            received.add(octet)
        })
        piece = response.body.read(4).value()
    }
    escaped = response.body
    // The callback's ordinary result becomes the result of the exchange.
    Encoding.UTF8.decode(received)
}

// The owning variant takes custody of the duplex and closes it exactly once,
// whatever the outcome.
text: http.Client.exchangeOne.owning(duplex, request, onResponse, null).value()
print(text)
print(duplex.written())
print(duplex.releaseCount())

// The exchange retired when onResponse returned, so the body is no longer
// readable, even though it escaped the callback.
late: IOLifecycleError.handle(
    () => {
        escaped.read(4).value()
        "still readable"
    },
    (error) => {
        "retired"
    }
)
print(late)
