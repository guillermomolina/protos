//! Issue and verify a strict HS256 JWT without ambient authority.
//! A test key is explicitly injected, never generated or read implicitly.
//! Verification authenticates claims but does not authorize account actions.

JWT: import("std:auth/jwt")
JSON: import("std:json/json")
Instant: import("std:datetime/instant")
Base64url: import("std:text/base64url")
HMAC: import("std:crypto/hmac_sha256")

// Deterministic public test fixture; never embed real signing keys in source.
testKey: Encoding.UTF8.encode("")
for(i, 0, 32) {
    testKey.add(i)
}

policy: {
    issuer: "https://issuer.example"
    audience: "protos-realworld"
    type: "realworld-access+jwt"
    maxLifetimeSeconds: 3600
    clockSkewSeconds: 0
}

claims: JSON.object(
    "iss", JSON.string("https://issuer.example"),
    "aud", JSON.string("protos-realworld"),
    "sub", JSON.string("user-id-42"),
    "iat", JSON.number(1794096000, 0),
    "nbf", JSON.number(1794096000, 0),
    "exp", JSON.number(1794099600, 0),
    "jti", JSON.string("id-7")
)

// Explicit injected test time; no clock capability is consulted.
trustedNow: Instant(1794097000 * 1000000000)

token: JWT.issue(claims, testKey, policy, trustedNow)
authenticatedClaims: JWT.verify(token, testKey, policy, trustedNow)

subject: authenticatedClaims.value["sub"].value

// Authorization is a separate application decision.
// A verified subject is not automatically allowed to administer accounts.
canAdministerAccounts: false

(subject == "user-id-42") &&
    (authenticatedClaims.kind == "object") &&
    (canAdministerAccounts == false)
