// Server.serveOne processes exactly one HTTP/1.1 request on a duplex you
// supply. It never listens on a port, so this lesson uses an in-memory duplex
// and runs under the standalone CLI.

http: import("std:http/Server")
MemoryDuplex: import("./memory-duplex.protos")

duplex: MemoryDuplex.of("GET /hello?name=Protos HTTP/1.1\r\nHost: localhost\r\n\r\n")

// The handler receives exactly one Request object. The method and version
// are Strings; the target and every header value are raw Bytes.
handler: (request) => {
    print(request.method)
    print(Encoding.Latin1.decode(request.target))
    print(request.version)
    print(request.headers[0][0])

    // A Response is an ordinary object. Header values and the body are Bytes,
    // never Strings. The server adds Content-Length and Connection itself.
    response: {
        status: 200
        headers: [["Content-Type", Encoding.Latin1.encode("text/plain; charset=utf-8")]]
        body: Encoding.UTF8.encode("Hello from Protos")
    }
    response
}

// serveOne answers a Future that resolves to null once the response has been
// written and the session has retired. Waiting for it is up to the caller.
http.Server.serveOne(duplex, handler, null).value()

print(duplex.written())

// The borrowed variant never closes the duplex: closing it is still the
// caller's job. Server.serveOne.owning would have released it.
print(duplex.releaseCount())
