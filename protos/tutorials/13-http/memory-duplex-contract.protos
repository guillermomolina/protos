// A check of the support module `memory-duplex.protos`, not a lesson: the
// lessons rely on it behaving as a real ByteReadable, ByteWritable, Closable
// value (BYTE_IO.md §§5-6, IO_CORE.md §8). Any failed check signals an Error.

Assertions: import("std:test/Assertions")
MemoryDuplex: import("./memory-duplex.protos")

duplex: MemoryDuplex.of("abc")

// Invalid arguments fail the returned Future, before any effect.
Assertions.signals(InvalidIOArgument, () => {
    duplex.read(0).value()
})
Assertions.signals(InvalidIOArgument, () => {
    duplex.read("2").value()
})
Assertions.signals(InvalidIOArgument, () => {
    duplex.write("text").value()
})

// Reads answer 1 to maxBytes octets in order, then null.
Assertions.require(Encoding.Latin1.decode(duplex.read(2).value()) == "ab")
Assertions.require(Encoding.Latin1.decode(duplex.read(2).value()) == "c")
Assertions.require(duplex.read(2).value() === null)

// A write resolves to the duplex and keeps the octets it was given, even when
// the caller mutates its Bytes afterwards.
source: Encoding.Latin1.encode("xy")
Assertions.require(duplex.write(source).value() === duplex)
source.add(122)
Assertions.require(duplex.written() == "xy")

// Close is idempotent: each call answers a fresh Future resolving to the
// duplex, and only the first one releases it.
firstClose: duplex.close()
secondClose: duplex.close()
Assertions.require(firstClose !== secondClose)
Assertions.require(firstClose.value() === duplex)
Assertions.require(secondClose.value() === duplex)
Assertions.require(duplex.closeCalls() == 2)
Assertions.require(duplex.releaseCount() == 1)

// After the close cutover, reads and writes are rejected.
Assertions.signals(IOLifecycleError, () => {
    duplex.read(1).value()
})
Assertions.signals(IOLifecycleError, () => {
    duplex.write(source).value()
})
Assertions.require(duplex.written() == "xy")

print("memory-duplex follows the byte-I/O and close contracts")
