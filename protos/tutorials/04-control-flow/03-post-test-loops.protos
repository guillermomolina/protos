// Post-test: the BODY Closure is the receiver and runs before the condition.
// Suffix until is the ordinary body-Closure.untilTrue(condition) send.
attempts: 0
last: {
    attempts = attempts + 1
    attempts * 10
} until(attempts >= 3)
print(last) // 30: last body value

// The explicit untilTrue message produces the same kind of result.
i: 0
explicit: (() => {
    i = i + 1
    i
}).untilTrue(() => i >= 2)
print(explicit) // 2

// untilFalse stops when its CONDITION Closure returns canonical false.
remaining: 2
inverse: (() => {
    remaining = remaining - 1
    remaining
}).untilFalse(() => remaining > 0)
print(inverse) // 0

// Post-test looping always executes its body at least once.
once: { "once" } until(true)
print(once)
