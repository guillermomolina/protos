// Pre-test: the condition is checked before each body activation.
// Contextual while is the ordinary condition-Closure.whileTrue(body) send.
n: 0
last: while(n < 3) {
    n = n + 1
    n * 10
}
print(last) // 30: last body value

// The explicit whileTrue form has the same meaning.
i: 0
explicit: (() => i < 2).whileTrue() {
    i = i + 1
    i
}
print(explicit) // 2

// whileFalse still receives a CONDITION Closure; it loops while false.
remaining: 2
inverse: (() => remaining == 0).whileFalse() {
    remaining = remaining - 1
    remaining
}
print(inverse) // 0

// A pre-test loop can skip its body and return canonical null.
skipped: while(false) {
    print("not reached")
}
print(skipped === null) // true
