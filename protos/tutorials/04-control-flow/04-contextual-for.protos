// DOC016: contextual for delegates to ordinary each and eachStep.

// Generic iteration over an Array.
numbers: [3, 1, 4]
total: 0

arrayResult: for(number in numbers) {
    total = total + number
}

print("array total")
print(total)                 // 8
print(arrayResult === numbers) // true

// Ascending: start included, stop excluded.
print("ascending")
for(i, 0, 5) {
    print(i)
}

// Descending: ordinary Range construction selects InvertedRange.
print("descending")
for(i, 5, 0) {
    print(i)
}

// Explicit negative step.
print("descending step")
for(i, 10, 0, -2) {
    print(i)
}

// Both the upper bound and step may be computed at runtime.
limit: 7
stride: 3

print("dynamic step")
for(i, 0, limit, stride) {
    print(i)
}

// A for binder is a Closure parameter, not the outer slot.
i: 99
binderTotal: 0

for(i, 0, 3) {
    binderTotal = binderTotal + i
}

print("binder scope")
print(i)            // 99
print(binderTotal)  // 3

// The explicit ordinary each call has the same behavior.
explicitTotal: 0

numbers.each(number => {
    explicitTotal = explicitTotal + number
})

print("same as each")
print(total == explicitTotal) // true
