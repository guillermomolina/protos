// Composing one-to-many mapping, pairing, stable partitioning, and deduplication.
Arrays: import("std:collections/array")

source: Array(1, 2, 2, 3)
expanded: Arrays.flatMap(source, (x) => { Array(x, x * 10) })
paired: Arrays.zip(source, Array("a", "b", "c"))
groups: Arrays.partition(source, (x) => { (x % 2) == 0 })
unique: Arrays.distinct(source)

// flatMap flattens just one level; each returned chunk must be an Array.
print(expanded.size() == 8 && expanded[0] == 1 && expanded[7] == 30)
// zip truncates to the shortest input and creates new two-element Arrays.
print(paired.size() == 3 && paired[0][0] == 1 && paired[2][1] == "c")
print(paired[0] !== paired[1])
// partition returns [matches, rejects] with stable original order.
print(groups.size() == 2 && groups[0].size() == 2)
print(groups[0][0] == 2 && groups[0][1] == 2)
print(groups[1].size() == 2 && groups[1][0] == 1 && groups[1][1] == 3)
// distinct retains the first representative using Set hash and == semantics.
print(unique.size() == 3 && unique[0] == 1 && unique[2] == 3)
print(source.size() == 4 && source[2] == 2)

// All callbacks read the snapshot, even when an earlier callback changes the
// source's indexed contents. The source is still mutable; the snapshot is not.
changing: Array(1, 2, 3)
snapshotted: Arrays.flatMap(changing, (x) => {
    if(x == 1) {
        changing[2] = 99
    }
    Array(x)
})
print(snapshotted[2] == 3 && changing[2] == 99)
