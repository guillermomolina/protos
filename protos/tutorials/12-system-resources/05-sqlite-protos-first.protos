// The host explicitly authorizes the external FFM provider and ffi:sqlite3.
// std:ffi supplies reusable declarations and owned release; std:sqlite owns
// SQL validation, connections, statements, rows, error handling and cleanup.
// :memory: acquires no Protos Filesystem grant. The trusted in-process C
// library still has process authority: this is not a native-code sandbox.
// Numeric/NULL input binds are supported; TEXT/BLOB inputs await a separately
// approved native lifetime policy. SQL must contain no semicolon or NUL.
Assertions: import("std:test/assertions")
SQLite: import("std:sqlite")
db: SQLite.openMemory()
(() => {
    statement: db.prepare("SELECT ?1, ?2, ?3, 'copied text', x'00ff'")
    (() => {
        statement.bind(1, 42).bind(2, 2.5).bind(3, null)
        held: null
        statement.each((row) => {
            // No borrowed pointer survives into this ordinary Protos callback.
            // The complete row is independent before the callback starts.
            held = row
        })
        Assertions.require(held[0] == 42)
        Assertions.require(held[1] == 2.5)
        Assertions.require(held[2] === null)
        Assertions.require(held[3] == "copied text")
        Assertions.require(held[4][1] == 255)
    }).ensure(() => statement.close().value())
    // Statements close before their parent. Closing the connection also
    // retires any remaining statements; neither native release is retried.
}).ensure(() => db.close().value())
