// SOURCE: every top-level binding belongs to its importable context.
// The leading name internalPricingRule is only a convention:
// SOURCE does not hide top-level bindings.

basePrice: 40
shipping: 7
discount: 5

internalPricingRule: "flat discount"

total: () => {
    basePrice + shipping - discount
}
