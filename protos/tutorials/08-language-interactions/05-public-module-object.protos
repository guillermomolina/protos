// DOC020 lesson 05: a MODULE returns its own public object.
//
// Run from the repository root:
// bin/protos protos/tutorials/08-language-interactions/05-public-module-object.protos
//
// std:collections/range is a real MODULE. Its module.protos
// explicitly publishes Range and InvertedRange using this.Name:.

Ranges: import("std:collections/range")
Again: import("std:collections/range")

// Repeated imports return the same Actor-local MODULE object.
print(Ranges === Again)

// Published values retain their original identities.
print(Ranges.Range === Range)
print(Ranges.InvertedRange === InvertedRange)

// The public MODULE object is not the published Range prototype.
print(Ranges === Ranges.Range)

// The MODULE initializer's ordinary top-level bindings belong to
// its separate private context, not to this public module object.
