// Structural equality and individual identity compose differently with maps.
left: Path.relative().child("docs")
right: Path.relative().child("docs")
print(left == right)
print(left === right)
byValue: Map()
byValue[left] = 1
byValue[right] = 2
print(byValue.size())
byIdentity: IdentityMap()
byIdentity[left] = 1
byIdentity[right] = 2
print(byIdentity.size())
