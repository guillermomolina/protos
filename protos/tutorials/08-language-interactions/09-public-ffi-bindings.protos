// Tutorial: bind C functions through the public std:ffi MODULE.
// Authorize the optional provider explicitly on the portable JVM CLI:
// bin/protos --foreign-provider-path /path/to/protos-ffm-provider.jar \
//     protos/tutorials/08-language-interactions/09-public-ffi-bindings.protos
// Requires Linux x86-64, Java 25/GraalVM 25.5 and shared libsqlite3.so.0.
// Success is an empty output stream and exit status 0.

FFI: import("std:ffi")
Assertions: import("std:test/assertions")
sqlite: import("ffi:sqlite3")

// ---- 1. A C function with no arguments becomes an ordinary Closure

version: FFI.bind(sqlite, "sqlite3_libversion_number", FFI.i32, Array())
Assertions.require(version.parent() === Object)
versionNumber: version()
Assertions.require(Integer.recognizes(versionNumber))
Assertions.require(versionNumber >= 3000000)

// ---- 2. String parameters use the strict input-only utf8z descriptor

complete: FFI.bind(sqlite, "sqlite3_complete", FFI.i32, Array(FFI.utf8z))
Assertions.require(complete("SELECT 1;") == 1)
Assertions.require(complete("SELECT 1") == 0)
Assertions.require(complete("SELECT 'caf\u{E9}';") == 1)

// C return codes are data. A nonzero comparison result is not an Error.
compareIgnoringCase: FFI.bind(
    sqlite,
    "sqlite3_strnicmp",
    FFI.i32,
    Array(FFI.utf8z, FFI.utf8z, FFI.i32))
Assertions.require(compareIgnoringCase("MiXeD", "mixed", 5) == 0)
comparison: compareIgnoringCase("alpha", "beta", 5)
Assertions.require(Integer.recognizes(comparison))
Assertions.require(comparison != 0)

// ---- 3. Each declaration produces a distinct Closure; argument Arrays snapshot

sameSymbolAgain: FFI.bind(sqlite, "sqlite3_libversion_number", FFI.i32, Array())
Assertions.require(sameSymbolAgain !== version)
Assertions.require(sameSymbolAgain.parent() === Object)

parameters: Array(FFI.utf8z)
snapshottedComplete: FFI.bind(sqlite, "sqlite3_complete", FFI.i32, parameters)
parameters[0] = FFI.i32
Assertions.require(snapshottedComplete("SELECT 1;") == 1)

// ---- 4. Admission errors happen before entering C

ordinary: (body) => {
    error: Assertions.signals(Error, body)
    Assertions.require(error.parent() === Error)
}

ordinary(() => complete())
ordinary(() => complete("SELECT 1;", "extra"))
ordinary(() => complete(42))
ordinary(() => compareIgnoringCase("a", "a", 2147483648))
ordinary(() => complete("SELECT\u{0}1;"))

// ---- 5. Symbol resolution after provider entry is a ForeignError

missingSymbol: Assertions.signals(ForeignError, () => FFI.bind(
    sqlite, "protos_doc023_symbol_that_does_not_exist", FFI.i32, Array()))
Assertions.require(missingSymbol.parent() === ForeignError)
Assertions.require(ForeignError.parent() === Error)
