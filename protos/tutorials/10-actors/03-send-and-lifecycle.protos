worker: Actor.spawn("std:collections/Set", "call")
finished: worker.termination()

// send does not return the handler result. The following request is issued by the
// same Actor to the same concrete destination, so it cannot overtake this send.
worker.send("atPut", "ready", true)
print(worker.request("size").value())

worker.stop()
print(finished.value() === worker)
