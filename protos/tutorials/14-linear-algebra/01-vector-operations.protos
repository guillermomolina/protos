// Vectors come from one explicit import. Bind the prototype to a local name
// first: `LA.Vector(1)` would be a message send to a slot holding a prototype,
// not a Closure, and would signal an Error.

LA: import("std:math/LinearAlgebra")
Vector: LA.Vector

v: Vector(1, 2, 3)
w: Vector(4, 5, 6)

// Indexing is zero-based. `v[i]` is the ordinary `at` protocol: v.at(i).
print(v.size())
print(v[0])

// add, scale and copy answer fresh Vectors and never change their operands.
sum: v.add(w)            // 5, 7, 9
doubled: v.scale(2)      // 2, 4, 6
snapshot: v.copy()

// Indexed assignment is the ordinary `atPut` protocol: v.atPut(0, 10).
// It mutates this one Vector only.
v[0] = 10
print(v[0])

// dot is the inner product: 1*4 + 2*5 + 3*6 for the original elements.
product: snapshot.dot(w)
print(product)

verified: (v.size() == 3) &&
    (v[0] == 10) &&
    (snapshot[0] == 1) &&
    (sum[0] == 5) && (sum[2] == 9) &&
    (doubled[1] == 4) &&
    (product == 32)
// A wrong result must fail the program, not print false.
if(!verified) {
    Error().signal()
}
print(verified)
