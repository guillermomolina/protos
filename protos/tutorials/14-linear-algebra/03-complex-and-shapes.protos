// Elements are ordinary Protos Numbers, so exact Fractions and Complex values
// keep their usual arithmetic. Shapes must match exactly.

LA: import("std:math/LinearAlgebra")
Vector: LA.Vector
Matrix: LA.Matrix

// Fractions stay exact: 1/2 * 2 + 1/3 * 3 is exactly 2.
exact: Vector(1 / 2, 1 / 3).dot(Vector(2, 3))
print(exact)

// dot is Hermitian: it conjugates the receiver's elements only.
i: Complex(0, 1)
hermitian: Vector(i).dot(Vector(i))                   // conj(i) * i == 1
// matvec and matmul conjugate nothing.
plain: Matrix(1, 1, i).matvec(Vector(i))[0]           // i * i == -1
print(hermitian)
print(plain)

// A shape mismatch signals an Error; nothing is broadcast or padded. The
// guarded block contains only the mismatched add, so an Error here is that
// shape rejection; if add unexpectedly succeeds, the block answers
// "accepted" and the final check below fails the program.
mismatch: Error.handle(
    () => {
        Vector(1, 2).add(Vector(1))
        "accepted"
    },
    (error) => {
        "rejected"
    }
)
print(mismatch)

// An empty contraction is the exact Integer 0, not 0.0.
empty: Vector().dot(Vector())
print(empty)

verified: (exact === 2) &&
    (hermitian === 1) &&
    (plain === -1) &&
    (mismatch == "rejected") &&
    (empty === 0)
// A wrong result must fail the program, not print false.
if(!verified) {
    Error().signal()
}
print(verified)
