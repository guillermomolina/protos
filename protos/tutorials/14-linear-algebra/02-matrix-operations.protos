// A Matrix takes its dimensions first, then exactly rows * columns values in
// row-major order. Elements are read with at(row, column); there is no
// m[row, column] form.

LA: import("std:math/LinearAlgebra")
Vector: LA.Vector
Matrix: LA.Matrix

// Rows: [1, 2, 3] and [4, 5, 6].
m: Matrix(2, 3, 1, 2, 3, 4, 5, 6)
print(m.rows())
print(m.columns())
print(m.at(1, 0))

// matvec: each result element is one row times the Vector.
image: m.matvec(Vector(1, 0, 1))     // 1 + 3, 4 + 6
print(image[1])

// matmul: a 2 × 3 times a 3 × 2 Matrix is 2 × 2.
n: Matrix(3, 2, 7, 8, 9, 10, 11, 12)
product: m.matmul(n)                 // rows [58, 64] and [139, 154]

// Multiplying by a unit Vector selects one column: column 0, then column 1.
first: product.matvec(Vector(1, 0))
second: product.matvec(Vector(0, 1))
print(first[0])
print(second[1])

// transpose answers a new 3 × 2 Matrix; m itself is unchanged.
t: m.transpose()

verified: (m.rows() == 2) && (m.columns() == 3) &&
    (image.size() == 2) && (image[0] == 4) && (image[1] == 10) &&
    (product.rows() == 2) && (product.columns() == 2) &&
    (first[0] == 58) && (second[0] == 64) &&
    (first[1] == 139) && (second[1] == 154) &&
    (t.rows() == 3) && (t.columns() == 2) && (t.at(2, 1) == 6)
// A wrong result must fail the program, not print false.
if(!verified) {
    Error().signal()
}
print(verified)
