source: (() => { 20 }).future()

// then() schedules a continuation after successful resolution. If a transform
// returns another Future, the destination adopts that Future's eventual outcome.
result: source.then((value) => {
    (() => { value * 2 + 2 }).future()
})

print(result.value())
