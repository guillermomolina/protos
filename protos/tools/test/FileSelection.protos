Manifest: import("self:Manifest")

selectionError: () => {
    Error().signal()
}

associationMatches: (association, corpusId, casePath) => {
    (association.size() == 2).ifFalse(() => {
        selectionError()
    })

    associationCorpus: association[0]
    associationPath: association[1]

    ("" + associationCorpus === associationCorpus).ifFalse(() => {
        selectionError()
    })
    ("" + associationPath === associationPath).ifFalse(() => {
        selectionError()
    })

    (associationCorpus == corpusId) &&
        (associationPath == casePath)
}

// D151: selection never reconstructs CaseSpec. Matching CaseSpecs are retained
// by identity and in their original TestPlan order.
selectPlan: (corpusId, plan, associations) => {
    selectedCases: Array()

    Manifest.planCases(plan).each((spec) => {
        selected: false

        associations.each((association) => {
            associationMatches(
                association,
                corpusId,
                Manifest.casePath(spec)
            ).ifTrue(() => {
                selected = true
            })
        })

        selected.ifTrue(() => {
            selectedCases = Array(...selectedCases, spec)
        })
    })

    selectedCases.freeze()

    selectedPlan: Array(selectedCases)
    selectedPlan.freeze()
    selectedPlan
}
