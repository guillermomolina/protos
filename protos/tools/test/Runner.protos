Manifest: import("self:Manifest")

readSource: (spec, filesystem) => {
    file: filesystem.open(Manifest.pathValue(Manifest.casePath(spec))).value()
    bytes: Encoding.UTF8.encode("")

    // File is one ordered logical-position domain. Issue a bounded read window,
    // then await it as a group. This preserves the standard File ordering while
    // avoiding one Protos recursive frame per 64 KiB read.
    batchTemplate: Array(null)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)

    done: false
    readBatch: null
    readBatch = () => {
        pending: Array(...batchTemplate)
        issueIndex: 0
        batchTemplate.each((ignored) => {
            pending.atPut(issueIndex, file.read(65536))
            issueIndex = issueIndex + 1
        })

        chunks: Future.all(...pending).value()
        chunks.each((chunk) => {
            done.ifFalse(() => {
                (chunk === null).ifTrue(() => {
                    done = true
                })
                (chunk === null).ifFalse(() => {
                    chunk.each((octet) => {
                        bytes.add(octet)
                    })
                })
            })
        })

        done.ifFalse(() => {
            readBatch()
        })
    }

    readBatch()
    file.close().value()

    // Decode once after byte accumulation so a UTF-8 scalar split across two
    // File.read results is not treated as two independent codec inputs.
    Encoding.UTF8.decode(bytes)
}

resultTuple: (...items) => {
    items
}

resultPassed: (result) => {
    result.at(0)
}

resultObservation: (result) => {
    result.at(1)
}

isSimpleExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "boolean"
    (kind === "null").ifTrue(() => { supported = true })
    (kind === "integer").ifTrue(() => { supported = true })
    (kind === "fixed-integer").ifTrue(() => { supported = true })
    (kind === "float-bits").ifTrue(() => { supported = true })
    (kind === "float-nan").ifTrue(() => { supported = true })
    (kind === "error-parent").ifTrue(() => { supported = true })
    (kind === "error").ifTrue(() => { supported = true })
    supported
}

isClosureErrorParentFreshExpectation: (spec) => {
    Manifest.caseExpectation(spec) === "closure-error-parent-fresh"
}

isFutureResolvedExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "future-integer"
    (kind === "future-null").ifTrue(() => { supported = true })
    (kind === "future-boolean").ifTrue(() => { supported = true })
    supported
}

isFutureTerminalExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "future-error"
    (kind === "future-error-parent").ifTrue(() => { supported = true })
    (kind === "future-cancelled").ifTrue(() => { supported = true })
    supported
}

isFutureStoredObservationExpectation: (spec) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity") &&
    (Manifest.caseExpected(spec) === "stored:Error")
}

futureObservationPolicyMode: (policy) => {
    policy.at(0)
}

futureObservationPolicyParent: (policy) => {
    policy.at(1)
}

futureObservationPolicyParentName: (policy) => {
    policy.at(2)
}

parseFutureObservationPolicy: (text) => {
    source: Encoding.UTF8.encode(text)
    modeBytes: Encoding.UTF8.encode("")
    parentBytes: Encoding.UTF8.encode("")
    separatorSeen: false

    source.each((octet) => {
        (octet == 58).ifTrue(() => {
            separatorSeen.ifTrue(() => { policyError() })
            separatorSeen = true
        })
        (octet == 58).ifFalse(() => {
            separatorSeen.ifTrue(() => {
                parentBytes.add(octet)
            })
            separatorSeen.ifFalse(() => {
                modeBytes.add(octet)
            })
        })
    })

    separatorSeen.ifFalse(() => { policyError() })
    (modeBytes.size() == 0).ifTrue(() => { policyError() })
    (parentBytes.size() == 0).ifTrue(() => { policyError() })

    mode: Encoding.UTF8.decode(modeBytes)
    supportedMode: mode === "stored"
    (mode === "fresh").ifTrue(() => {
        supportedMode = true
    })
    supportedMode.ifFalse(() => { policyError() })

    parentName: Encoding.UTF8.decode(parentBytes)
    parent: standardErrorPrototype(parentName)
    resultTuple(mode, parent, parentName)
}

isDExpectation: (spec) => {
    supported: isSimpleExpectation(spec)
    isClosureErrorParentFreshExpectation(spec).ifTrue(() => {
        supported = true
    })
    supported
}

policyError: () => {
    Error().signal()
}

futureStoredObservationInspectorSource: () => {
    "(subject) => {\n" +
    "    storedError: subject.slotValue(\"error\")\n" +
    "    observe: subject.slotValue(\"observe\")\n" +
    "    same: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            same = (caught === storedError) && (caught.parent() === Error)\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    same\n" +
    "}"
}

evaluateFutureStoredObservation: (spec, source, inspectorExecutor) => {
    isFutureStoredObservationExpectation(spec).ifFalse(() => {
        policyError()
    })

    observation: inspectorExecutor(
        source,
        futureStoredObservationInspectorSource()
    )

    passed: observation.state === "completed"
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed.ifTrue(() => {
        passed = observation.value === true
    })

    resultTuple(passed, observation)
}

futureFreshObservationInspectorSource: (expectedParentName) => {
    "(subject) => {\n" +
    "    observe: subject.slotValue(\"observe\")\n" +
    "    first: null\n" +
    "    second: null\n" +
    "    firstCaught: false\n" +
    "    secondCaught: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            first = caught\n" +
    "            firstCaught = true\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            second = caught\n" +
    "            secondCaught = true\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    passed: firstCaught && secondCaught\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = first.parent() === " + expectedParentName + "\n" +
    "    })\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = second.parent() === " + expectedParentName + "\n" +
    "    })\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = first !== second\n" +
    "    })\n" +
    "    passed\n" +
    "}"
}

evaluateFutureFreshObservation: (spec, source, inspectorExecutor) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity").ifFalse(() => {
        policyError()
    })

    policy: parseFutureObservationPolicy(Manifest.caseExpected(spec))
    (futureObservationPolicyMode(policy) === "fresh").ifFalse(() => {
        policyError()
    })

    expectedParentName: futureObservationPolicyParentName(policy)
    observation: inspectorExecutor(
        source,
        futureFreshObservationInspectorSource(expectedParentName)
    )

    passed: observation.state === "completed"
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed.ifTrue(() => {
        passed = observation.value === true
    })

    resultTuple(passed, observation)
}

evaluateFutureObservation: (spec, source, inspectorExecutor) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity").ifFalse(() => {
        policyError()
    })

    policy: parseFutureObservationPolicy(Manifest.caseExpected(spec))
    mode: futureObservationPolicyMode(policy)
    evaluation: null

    (mode === "stored").ifTrue(() => {
        evaluation = evaluateFutureStoredObservation(
            spec,
            source,
            inspectorExecutor
        )
    })
    (mode === "fresh").ifTrue(() => {
        evaluation = evaluateFutureFreshObservation(
            spec,
            source,
            inspectorExecutor
        )
    })

    (evaluation === null).ifTrue(() => {
        policyError()
    })
    evaluation
}

parseExpectedInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 0).ifTrue(() => { policyError() })

    value: 0
    negative: false
    digits: 0
    first: true

    source.each((octet) => {
        sign: false
        first.ifTrue(() => {
            (octet == 45).ifTrue(() => {
                negative = true
                sign = true
            })
            (octet == 43).ifTrue(() => {
                sign = true
            })
        })

        sign.ifFalse(() => {
            invalid: octet < 48
            (octet > 57).ifTrue(() => { invalid = true })
            invalid.ifTrue(() => { policyError() })
            value = value * 10 + (octet - 48)
            digits = digits + 1
        })
        first = false
    })

    (digits == 0).ifTrue(() => { policyError() })
    negative.ifTrue(() => { value = 0 - value })
    value
}

parseExpectedFloatBits: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 16).ifFalse(() => { policyError() })

    value: 0
    source.each((octet) => {
        digit: -1

        decimal: (octet >= 48) && (octet <= 57)
        decimal.ifTrue(() => {
            digit = octet - 48
        })

        lower: (octet >= 97) && (octet <= 102)
        lower.ifTrue(() => {
            digit = octet - 87
        })

        upper: (octet >= 65) && (octet <= 70)
        upper.ifTrue(() => {
            digit = octet - 55
        })

        (digit < 0).ifTrue(() => { policyError() })
        value = value * 16 + digit
    })

    value
}

binary64PowerOfTwo: (exponent) => {
    invalid: exponent < -1074
    (exponent > 971).ifTrue(() => { invalid = true })
    invalid.ifTrue(() => { policyError() })

    remaining: exponent
    base: 2.0
    (remaining < 0).ifTrue(() => {
        remaining = 0 - remaining
        base = 0.5
    })

    result: 1.0
    factor: base

    step: null
    step = () => {
        (remaining > 0).ifTrue(() => {
            (remaining.mod(2) == 1).ifTrue(() => {
                result = result * factor
            })

            remaining = remaining.div(2)
            (remaining > 0).ifTrue(() => {
                factor = factor * factor
            })
            step()
        })
    }

    step()
    result
}

floatFromExpectedBits: (rawBits) => {
    // Enforce the D3C2A domain: one ordinary unbounded Integer raw pattern.
    rawBits.div(1)
    (rawBits < 0).ifTrue(() => { policyError() })
    (rawBits > 18446744073709551615).ifTrue(() => { policyError() })

    signBit: 9223372036854775808
    fractionUnit: 4503599627370496

    negative: rawBits >= signBit
    magnitude: rawBits
    negative.ifTrue(() => {
        magnitude = rawBits - signBit
    })

    exponentBits: magnitude.div(fractionUnit)
    fractionBits: magnitude.mod(fractionUnit)

    special: exponentBits == 2047
    result: 0.0

    special.ifTrue(() => {
        // NaN payload/sign bits are not portable Protos semantics. Retained
        // NaN expectations belong to float-nan, never float-bits.
        (fractionBits == 0).ifFalse(() => { policyError() })
        result = 1.0 / 0.0
    })

    special.ifFalse(() => {
        significand: fractionBits
        binaryExponent: -1074

        (exponentBits > 0).ifTrue(() => {
            significand = fractionUnit + fractionBits
            binaryExponent = exponentBits - 1075
        })

        // significand is <= 2^53-1, so Float(Integer) is exact. The final
        // product is the encoded binary64 value itself and therefore exact.
        result =
            Float(significand) *
            binary64PowerOfTwo(binaryExponent)
    })

    negative.ifTrue(() => {
        result = result.negated()
    })

    result
}

matchesExpectedFloatBits: (rawBits, value) => {
    value === floatFromExpectedBits(rawBits)
}

fixedIntegerFamilyPrototype: (name) => {
    result: null
    known: false

    (name === "UInt8").ifTrue(() => {
        result = UInt8
        known = true
    })
    (name === "Int8").ifTrue(() => {
        result = Int8
        known = true
    })
    (name === "UInt16").ifTrue(() => {
        result = UInt16
        known = true
    })
    (name === "Int16").ifTrue(() => {
        result = Int16
        known = true
    })
    (name === "UInt32").ifTrue(() => {
        result = UInt32
        known = true
    })
    (name === "Int32").ifTrue(() => {
        result = Int32
        known = true
    })
    (name === "UInt64").ifTrue(() => {
        result = UInt64
        known = true
    })
    (name === "Int64").ifTrue(() => {
        result = Int64
        known = true
    })

    known.ifFalse(() => { policyError() })
    result
}

parseExpectedFixedInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    familyBytes: Encoding.UTF8.encode("")
    valueBytes: Encoding.UTF8.encode("")
    separatorSeen: false

    source.each((octet) => {
        (octet == 58).ifTrue(() => {
            separatorSeen.ifTrue(() => { policyError() })
            separatorSeen = true
        })
        (octet == 58).ifFalse(() => {
            separatorSeen.ifTrue(() => {
                valueBytes.add(octet)
            })
            separatorSeen.ifFalse(() => {
                familyBytes.add(octet)
            })
        })
    })

    separatorSeen.ifFalse(() => { policyError() })
    (familyBytes.size() == 0).ifTrue(() => { policyError() })
    (valueBytes.size() == 0).ifTrue(() => { policyError() })

    familyName: Encoding.UTF8.decode(familyBytes)
    valueText: Encoding.UTF8.decode(valueBytes)
    family: fixedIntegerFamilyPrototype(familyName)
    family(parseExpectedInteger(valueText))
}

standardErrorPrototype: (name) => {
    result: null
    known: false

    (name === "Error").ifTrue(() => {
        result = Error
        known = true
    })
    (name === "SlotNotFound").ifTrue(() => {
        result = SlotNotFound
        known = true
    })
    (name === "InvalidSuper").ifTrue(() => {
        result = InvalidSuper
        known = true
    })
    (name === "InvalidReturn").ifTrue(() => {
        result = InvalidReturn
        known = true
    })
    (name === "Cancelled").ifTrue(() => {
        result = Cancelled
        known = true
    })
    (name === "FutureResolutionCycle").ifTrue(() => {
        result = FutureResolutionCycle
        known = true
    })
    (name === "RequestOutcomeUncertain").ifTrue(() => {
        result = RequestOutcomeUncertain
        known = true
    })
    (name === "NonTransferableValue").ifTrue(() => {
        result = NonTransferableValue
        known = true
    })
    (name === "NonParallelValue").ifTrue(() => {
        result = NonParallelValue
        known = true
    })
    (name === "InvalidPredicateResult").ifTrue(() => {
        result = InvalidPredicateResult
        known = true
    })
    (name === "InvalidComparatorResult").ifTrue(() => {
        result = InvalidComparatorResult
        known = true
    })
    (name === "InvalidComparatorOrder").ifTrue(() => {
        result = InvalidComparatorOrder
        known = true
    })
    (name === "ParallelRegionOverlap").ifTrue(() => {
        result = ParallelRegionOverlap
        known = true
    })
    (name === "ParallelRegionInUse").ifTrue(() => {
        result = ParallelRegionInUse
        known = true
    })
    (name === "ParallelRegionOutsideP").ifTrue(() => {
        result = ParallelRegionOutsideP
        known = true
    })
    (name === "IOError").ifTrue(() => {
        result = IOError
        known = true
    })
    (name === "InvalidIOArgument").ifTrue(() => {
        result = InvalidIOArgument
        known = true
    })
    (name === "IOLifecycleError").ifTrue(() => {
        result = IOLifecycleError
        known = true
    })
    (name === "IOCapacityExhausted").ifTrue(() => {
        result = IOCapacityExhausted
        known = true
    })
    (name === "EncodingError").ifTrue(() => {
        result = EncodingError
        known = true
    })
    (name === "LineTooLong").ifTrue(() => {
        result = LineTooLong
        known = true
    })

    known.ifFalse(() => { policyError() })
    result
}

futureResolvedWrapperSource: (source, kind, expected) => {
    expectedExpression: ""
    known: false

    (kind === "future-integer").ifTrue(() => {
        // Validate the retained decimal before treating it as source text.
        parseExpectedInteger(expected)
        expectedExpression = expected
        known = true
    })

    (kind === "future-null").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })
        expectedExpression = "null"
        known = true
    })

    (kind === "future-boolean").ifTrue(() => {
        (expected === "true").ifTrue(() => {
            expectedExpression = "true"
            known = true
        })
        (expected === "false").ifTrue(() => {
            expectedExpression = "false"
            known = true
        })
    })

    known.ifFalse(() => { policyError() })

    // The retained source is evaluated in an immediately-invoked Closure used
    // as the argument expression, before the expectation-private bindings below
    // exist. A live Future therefore never crosses the detached execution
    // boundary: Future.value() and any suspension/resume happen in this child.
    prefix:
        "((candidate, expectedValue) => {\n" +
        "    futureCandidate: false\n" +
        "    Error.handle(\n" +
        "        () => {\n" +
        "            futureCandidate = candidate.parent() === Future\n" +
        "            null\n" +
        "        },\n" +
        "        (error) => {\n" +
        "            futureCandidate = false\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    passed: false\n" +
        "    futureCandidate.ifTrue(() => {\n" +
        "        resolved: false\n" +
        "        value: null\n" +
        "        Error.handle(\n" +
        "            () => {\n" +
        "                value = candidate.value()\n" +
        "                resolved = true\n" +
        "                null\n" +
        "            },\n" +
        "            (error) => {\n" +
        "                resolved = false\n" +
        "                null\n" +
        "            }\n" +
        "        )\n" +
        "\n" +
        "        passed = resolved\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = value === expectedValue\n" +
        "        })\n" +
        "    })\n" +
        "\n" +
        "    passed\n" +
        "})((() => {\n"

    suffix:
        "\n})(), " +
        expectedExpression +
        ")\n"

    prefix + source + suffix
}

evaluateFutureResolved: (spec, source, executor) => {
    isFutureResolvedExpectation(spec).ifFalse(() => {
        policyError()
    })

    wrappedSource: futureResolvedWrapperSource(
        source,
        Manifest.caseExpectation(spec),
        Manifest.caseExpected(spec)
    )
    observation: executor(wrappedSource)

    passed: observation.state === "completed"
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed.ifTrue(() => {
        passed = observation.value === true
    })

    resultTuple(passed, observation)
}


futureTerminalWrapperSource: (source, kind, expected) => {
    modeText: ""
    expectedParentExpression: "Error"

    (kind === "future-error").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })
        modeText = "0"
    })

    (kind === "future-error-parent").ifTrue(() => {
        // Validate before using the retained prototype name as source text.
        standardErrorPrototype(expected)
        expectedParentExpression = expected
        modeText = "1"
    })

    (kind === "future-cancelled").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })
        expectedParentExpression = "Cancelled"
        modeText = "2"
    })

    (modeText == "").ifTrue(() => { policyError() })

    // Core Future semantics make repeated value() observations sufficient to
    // distinguish terminal FAILED from CANCELLED without any Test-only state
    // reflection. FAILED re-signals the exact stored Error object; CANCELLED
    // creates a fresh standard Cancelled occurrence for each observation.
    prefix:
        "((candidate, mode, expectedParent) => {\n" +
        "    futureCandidate: false\n" +
        "    Error.handle(\n" +
        "        () => {\n" +
        "            futureCandidate = candidate.parent() === Future\n" +
        "            null\n" +
        "        },\n" +
        "        (error) => {\n" +
        "            futureCandidate = false\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    first: null\n" +
        "    second: null\n" +
        "    firstCaught: false\n" +
        "    secondCaught: false\n" +
        "\n" +
        "    futureCandidate.ifTrue(() => {\n" +
        "        Error.handle(\n" +
        "            () => {\n" +
        "                candidate.value()\n" +
        "                null\n" +
        "            },\n" +
        "            (error) => {\n" +
        "                first = error\n" +
        "                firstCaught = true\n" +
        "                null\n" +
        "            }\n" +
        "        )\n" +
        "\n" +
        "        Error.handle(\n" +
        "            () => {\n" +
        "                candidate.value()\n" +
        "                null\n" +
        "            },\n" +
        "            (error) => {\n" +
        "                second = error\n" +
        "                secondCaught = true\n" +
        "                null\n" +
        "            }\n" +
        "        )\n" +
        "    })\n" +
        "\n" +
        "    passed: futureCandidate && firstCaught && secondCaught\n" +
        "\n" +
        "    (mode == 0).ifTrue(() => {\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = first === second\n" +
        "        })\n" +
        "    })\n" +
        "\n" +
        "    (mode == 1).ifTrue(() => {\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = first === second\n" +
        "        })\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = first.parent() === expectedParent\n" +
        "        })\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = second.parent() === expectedParent\n" +
        "        })\n" +
        "    })\n" +
        "\n" +
        "    (mode == 2).ifTrue(() => {\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = (first === second) === false\n" +
        "        })\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = first.parent() === expectedParent\n" +
        "        })\n" +
        "        passed.ifTrue(() => {\n" +
        "            passed = second.parent() === expectedParent\n" +
        "        })\n" +
        "    })\n" +
        "\n" +
        "    passed\n" +
        "})((() => {\n"

    suffix:
        "\n})(), " +
        modeText +
        ", " +
        expectedParentExpression +
        ")\n"

    prefix + source + suffix
}

evaluateFutureTerminal: (spec, source, executor) => {
    isFutureTerminalExpectation(spec).ifFalse(() => {
        policyError()
    })

    wrappedSource: futureTerminalWrapperSource(
        source,
        Manifest.caseExpectation(spec),
        Manifest.caseExpected(spec)
    )
    observation: executor(wrappedSource)

    passed: observation.state === "completed"
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed.ifTrue(() => {
        passed = observation.value === true
    })

    resultTuple(passed, observation)
}

closureErrorParentFreshWrapperSource: (source, expected) => {
    // Validate before using the retained prototype name as a source identifier.
    standardErrorPrototype(expected)

    prefix:
        "((candidate, expectedParent) => {\n" +
        "    first: null\n" +
        "    second: null\n" +
        "    firstCaught: false\n" +
        "    secondCaught: false\n" +
        "\n" +
        "    Error.handle(\n" +
        "        candidate,\n" +
        "        (error) => {\n" +
        "            first = error\n" +
        "            firstCaught = true\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    Error.handle(\n" +
        "        candidate,\n" +
        "        (error) => {\n" +
        "            second = error\n" +
        "            secondCaught = true\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    passed: firstCaught && secondCaught\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = first.parent() === expectedParent\n" +
        "    })\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = second.parent() === expectedParent\n" +
        "    })\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = (first === second) === false\n" +
        "    })\n" +
        "    passed\n" +
        "})((() => {\n"

    suffix:
        "\n})(), " +
        expected +
        ")\n"

    prefix + source + suffix
}

evaluateClosureErrorParentFresh: (spec, source, executor) => {
    isClosureErrorParentFreshExpectation(spec).ifFalse(() => {
        policyError()
    })

    expected: Manifest.caseExpected(spec)
    wrappedSource: closureErrorParentFreshWrapperSource(
        source,
        expected
    )
    observation: executor(wrappedSource)

    passed: observation.state === "completed"
    passed.ifTrue(() => {
        passed = observation.error === null
    })
    passed.ifTrue(() => {
        passed = observation.value === true
    })

    resultTuple(passed, observation)
}

evaluateSimple: (spec, source, executor) => {
    isSimpleExpectation(spec).ifFalse(() => { policyError() })

    kind: Manifest.caseExpectation(spec)
    expected: Manifest.caseExpected(spec)
    observation: executor(source)
    passed: false

    (kind === "boolean").ifTrue(() => {
        expectedKnown: expected === "true"
        expectedValue: true
        (expected === "false").ifTrue(() => {
            expectedKnown = true
            expectedValue = false
        })
        expectedKnown.ifFalse(() => { policyError() })

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = observation.value === expectedValue
        })
    })

    (kind === "null").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = observation.value === null
        })
    })

    (kind === "integer").ifTrue(() => {
        expectedValue: parseExpectedInteger(expected)

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = observation.value === expectedValue
        })
    })

    (kind === "fixed-integer").ifTrue(() => {
        expectedValue: parseExpectedFixedInteger(expected)

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = observation.value === expectedValue
        })
    })

    (kind === "float-bits").ifTrue(() => {
        rawBits: parseExpectedFloatBits(expected)

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = matchesExpectedFloatBits(rawBits, observation.value)
        })
    })

    (kind === "float-nan").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })

        // Core v0.1 has one semantic Float NaN value even when host payload/sign
        // representations differ. Construct it through ordinary Float arithmetic
        // and use primitive semantic identity so non-Float values cannot match.
        expectedNaN: 0.0 / 0.0

        passed = observation.state === "completed"
        passed.ifTrue(() => {
            passed = observation.error === null
        })
        passed.ifTrue(() => {
            passed = observation.value === expectedNaN
        })
    })

    (kind === "error-parent").ifTrue(() => {
        expectedParent: standardErrorPrototype(expected)

        passed = observation.state === "failed"
        passed.ifTrue(() => {
            passed = observation.value === null
        })
        passed.ifTrue(() => {
            (observation.error === null).ifTrue(() => {
                passed = false
            })
        })
        passed.ifTrue(() => {
            passed = observation.error.parent() === expectedParent
        })
    })

    (kind === "error").ifTrue(() => {
        (expected === "-").ifFalse(() => { policyError() })

        passed = observation.state === "failed"
        passed.ifTrue(() => {
            passed = observation.value === null
        })
        passed.ifTrue(() => {
            (observation.error === null).ifTrue(() => {
                passed = false
            })
        })
    })

    resultTuple(passed, observation)
}

evaluateDCase: (spec, source, executor) => {
    closureFresh: isClosureErrorParentFreshExpectation(spec)
    evaluation: null

    closureFresh.ifTrue(() => {
        evaluation = evaluateClosureErrorParentFresh(
            spec,
            source,
            executor
        )
    })
    closureFresh.ifFalse(() => {
        evaluation = evaluateSimple(spec, source, executor)
    })

    evaluation
}

caseRunTuple: (...items) => {
    items
}

caseRunSpec: (caseRun) => {
    caseRun.at(0)
}

caseRunEvaluation: (caseRun) => {
    caseRun.at(1)
}

runTuple: (...items) => {
    items
}

runCaseResults: (run) => {
    run.at(0)
}

runSelectedCount: (run) => {
    run.at(1)
}

runPassedCount: (run) => {
    run.at(2)
}

runSkippedCount: (run) => {
    run.at(3)
}

runAllPassed: (run) => {
    runPassedCount(run) == runSelectedCount(run)
}

runSimpleWithLoader: (plan, sourceLoader, executor) => {
    cases: Manifest.planCases(plan)

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        present.ifTrue(() => {
            left: resultChunks.at(level)
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        })
        present.ifFalse(() => {
            resultChunks.atPut(level, chunk)
            (level > maxChunkLevel).ifTrue(() => {
                maxChunkLevel = level
            })
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        (level >= 0).ifTrue(() => {
            nextResult: result
            resultChunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...resultChunks.at(level))
            })
            finalResult = collectChunks(level - 1, nextResult)
        })
        finalResult
    }

    // Future.all() supplies one already-resolved seed Future. Array.each itself
    // never suspends: it only attaches the next continuation to the prior Future.
    // The dependency chain therefore preserves manifest order without retaining
    // one recursive Protos call frame per selected case.
    chain: Future.all()

    cases.each((spec) => {
        supported: isDExpectation(spec)
        supported.ifTrue(() => {
            previous: chain
            chain = previous.then((ignored) => {
                source: sourceLoader(spec)
                evaluation: evaluateDCase(spec, source, executor)
                carryChunk(Array(caseRunTuple(spec, evaluation)), 0)
                null
            })
        })
    })

    chain.value()

    caseResults: resultTuple(...collectChunks(maxChunkLevel, Array()))
    passedCount: 0
    caseResults.each((caseRun) => {
        resultPassed(caseRunEvaluation(caseRun)).ifTrue(() => {
            passedCount = passedCount + 1
        })
    })

    skippedCount: 0
    cases.each((spec) => {
        isDExpectation(spec).ifFalse(() => {
            skippedCount = skippedCount + 1
        })
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        skippedCount
    )
}

runSimple: (plan, filesystem, executor) => {
    runSimpleWithLoader(
        plan,
        (spec) => { readSource(spec, filesystem) },
        executor
    )
}
