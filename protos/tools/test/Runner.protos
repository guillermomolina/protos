Manifest: import("self:Manifest")
ResourceBinding: import("self:ResourceBinding")
ResourceReservation: import("self:ResourceReservation")
ResourceCatalog: import("self:ResourceCatalog")

readSource: (spec, filesystem) => {
    file: filesystem.open(Manifest.pathValue(Manifest.casePath(spec))).value()
    bytes: Encoding.UTF8.encode("")

    // File is one ordered logical-position domain. Issue a bounded read window,
    // then await it as a group. This preserves the standard File ordering while
    // avoiding one Protos recursive frame per 64 KiB read.
    batchTemplate: Array(null)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)

    done: false
    readBatch: null
    readBatch = () => {
        pending: Array(...batchTemplate)
        issueIndex: 0
        batchTemplate.each((ignored) => {
            pending[issueIndex] = file.read(65536)
            issueIndex = issueIndex + 1
        })

        chunks: Future.all(...pending).value()
        chunks.each((chunk) => {
            done.ifFalse(() => {
                if(chunk === null) {
                    done = true
                }
                (chunk === null).ifFalse(() => {
                    chunk.each((octet) => {
                        bytes.add(octet)
                    })
                })
            })
        })

        done.ifFalse(() => {
            readBatch()
        })
    }

    readBatch()
    file.close().value()

    // Decode once after byte accumulation so a UTF-8 scalar split across two
    // File.read results is not treated as two independent codec inputs.
    Encoding.UTF8.decode(bytes)
}

resultTuple: (...items) => {
    items
}

resultPassed: (result) => {
    result[0]
}

resultObservation: (result) => {
    result[1]
}

isSimpleExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "boolean"
    if(kind === "null") { supported = true }
    if(kind === "integer") { supported = true }
    if(kind === "float-bits") { supported = true }
    if(kind === "float-nan") { supported = true }
    if(kind === "error-parent") { supported = true }
    if(kind === "error") { supported = true }
    supported
}

isClosureErrorParentFreshExpectation: (spec) => {
    Manifest.caseExpectation(spec) === "closure-error-parent-fresh"
}

isFutureResolvedExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "future-integer"
    if(kind === "future-integer-one-of") { supported = true }
    if(kind === "future-null") { supported = true }
    if(kind === "future-boolean") { supported = true }
    supported
}

isFutureTerminalExpectation: (spec) => {
    kind: Manifest.caseExpectation(spec)
    supported: kind === "future-error"
    if(kind === "future-error-parent") { supported = true }
    if(kind === "future-cancelled") { supported = true }
    supported
}

isFutureStoredObservationExpectation: (spec) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity") &&
    (Manifest.caseExpected(spec) === "stored:Error")
}

futureObservationPolicyMode: (policy) => {
    policy[0]
}

futureObservationPolicyParent: (policy) => {
    policy[1]
}

futureObservationPolicyParentName: (policy) => {
    policy[2]
}

parseFutureObservationPolicy: (text) => {
    source: Encoding.UTF8.encode(text)
    modeBytes: Encoding.UTF8.encode("")
    parentBytes: Encoding.UTF8.encode("")
    separatorSeen: false

    source.each((octet) => {
        if(octet == 58) {
            if(separatorSeen) { policyError() }
            separatorSeen = true
        }
        (octet == 58).ifFalse(() => {
            if(separatorSeen) {
                parentBytes.add(octet)
            }
            separatorSeen.ifFalse(() => {
                modeBytes.add(octet)
            })
        })
    })

    separatorSeen.ifFalse(() => { policyError() })
    if(modeBytes.size() == 0) { policyError() }
    if(parentBytes.size() == 0) { policyError() }

    mode: Encoding.UTF8.decode(modeBytes)
    supportedMode: mode === "stored"
    if(mode === "fresh") {
        supportedMode = true
    }
    supportedMode.ifFalse(() => { policyError() })

    parentName: Encoding.UTF8.decode(parentBytes)
    parent: standardErrorPrototype(parentName)
    resultTuple(mode, parent, parentName)
}

isDExpectation: (spec) => {
    supported: isSimpleExpectation(spec)
    if(isClosureErrorParentFreshExpectation(spec)) {
        supported = true
    }
    if(isFutureResolvedExpectation(spec)) {
        supported = true
    }
    if(isFutureTerminalExpectation(spec)) {
        supported = true
    }
    if(Manifest.caseExpectation(spec) === "future-observation-error-identity") {
        supported = true
    }
    supported
}

policyError: () => {
    Error().signal()
}

futureStoredObservationInspectorSource: () => {
    "(subject) => {\n" +
    "    storedError: subject.slotValue(\"error\")\n" +
    "    observe: subject.slotValue(\"observe\")\n" +
    "    same: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            same = (caught === storedError) && (caught.parent() === Error)\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    same\n" +
    "}"
}

evaluateFutureStoredObservation: (spec, source, inspectorExecutor) => {
    isFutureStoredObservationExpectation(spec).ifFalse(() => {
        policyError()
    })

    observation: inspectorExecutor(
        source,
        futureStoredObservationInspectorSource()
    )

    passed: observation.state === "completed"
    if(passed) {
        passed = observation.error === null
    }
    if(passed) {
        passed = observation.value === true
    }

    resultTuple(passed, observation)
}

futureFreshObservationInspectorSource: (expectedParentName) => {
    "(subject) => {\n" +
    "    observe: subject.slotValue(\"observe\")\n" +
    "    first: null\n" +
    "    second: null\n" +
    "    firstCaught: false\n" +
    "    secondCaught: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            first = caught\n" +
    "            firstCaught = true\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            observe()\n" +
    "            null\n" +
    "        },\n" +
    "        (caught) => {\n" +
    "            second = caught\n" +
    "            secondCaught = true\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    passed: firstCaught && secondCaught\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = first.parent() === " + expectedParentName + "\n" +
    "    })\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = second.parent() === " + expectedParentName + "\n" +
    "    })\n" +
    "    passed.ifTrue(() => {\n" +
    "        passed = first !== second\n" +
    "    })\n" +
    "    passed\n" +
    "}"
}

evaluateFutureFreshObservation: (spec, source, inspectorExecutor) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity").ifFalse(() => {
        policyError()
    })

    policy: parseFutureObservationPolicy(Manifest.caseExpected(spec))
    (futureObservationPolicyMode(policy) === "fresh").ifFalse(() => {
        policyError()
    })

    expectedParentName: futureObservationPolicyParentName(policy)
    observation: inspectorExecutor(
        source,
        futureFreshObservationInspectorSource(expectedParentName)
    )

    passed: observation.state === "completed"
    if(passed) {
        passed = observation.error === null
    }
    if(passed) {
        passed = observation.value === true
    }

    resultTuple(passed, observation)
}

evaluateFutureObservation: (spec, source, inspectorExecutor) => {
    (Manifest.caseExpectation(spec) === "future-observation-error-identity").ifFalse(() => {
        policyError()
    })

    policy: parseFutureObservationPolicy(Manifest.caseExpected(spec))
    mode: futureObservationPolicyMode(policy)
    evaluation: null

    if(mode === "stored") {
        evaluation = evaluateFutureStoredObservation(
            spec,
            source,
            inspectorExecutor
        )
    }
    if(mode === "fresh") {
        evaluation = evaluateFutureFreshObservation(
            spec,
            source,
            inspectorExecutor
        )
    }

    if(evaluation === null) {
        policyError()
    }
    evaluation
}

parseExpectedInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    if(source.size() == 0) { policyError() }

    value: 0
    negative: false
    digits: 0
    first: true

    source.each((octet) => {
        sign: false
        if(first) {
            if(octet == 45) {
                negative = true
                sign = true
            }
            if(octet == 43) {
                sign = true
            }
        }

        sign.ifFalse(() => {
            invalid: octet < 48
            if(octet > 57) { invalid = true }
            if(invalid) { policyError() }
            value = value * 10 + (octet - 48)
            digits = digits + 1
        })
        first = false
    })

    if(digits == 0) { policyError() }
    if(negative) { value = 0 - value }
    value
}

parseExpectedFloatBits: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 16).ifFalse(() => { policyError() })

    value: 0
    source.each((octet) => {
        digit: -1

        decimal: (octet >= 48) && (octet <= 57)
        if(decimal) {
            digit = octet - 48
        }

        lower: (octet >= 97) && (octet <= 102)
        if(lower) {
            digit = octet - 87
        }

        upper: (octet >= 65) && (octet <= 70)
        if(upper) {
            digit = octet - 55
        }

        if(digit < 0) { policyError() }
        value = value * 16 + digit
    })

    value
}

binary64PowerOfTwo: (exponent) => {
    invalid: exponent < -1074
    if(exponent > 971) { invalid = true }
    if(invalid) { policyError() }

    remaining: exponent
    base: 2.0
    if(remaining < 0) {
        remaining = 0 - remaining
        base = 0.5
    }

    result: 1.0
    factor: base

    step: null
    step = () => {
        if(remaining > 0) {
            if(remaining.mod(2) == 1) {
                result = result * factor
            }

            remaining = remaining.div(2)
            if(remaining > 0) {
                factor = factor * factor
            }
            step()
        }
    }

    step()
    result
}

floatFromExpectedBits: (rawBits) => {
    // Enforce the D3C2A domain: one ordinary unbounded Integer raw pattern.
    Integer.recognizes(rawBits).ifFalse(() => {
        policyError()
    })
    if(rawBits < 0) { policyError() }
    if(rawBits > 18446744073709551615) { policyError() }

    signBit: 9223372036854775808
    fractionUnit: 4503599627370496

    negative: rawBits >= signBit
    magnitude: rawBits
    if(negative) {
        magnitude = rawBits - signBit
    }

    exponentBits: magnitude.div(fractionUnit)
    fractionBits: magnitude.mod(fractionUnit)

    special: exponentBits == 2047
    result: 0.0

    if(special) {
        // NaN payload/sign bits are not portable Protos semantics. Retained
        // NaN expectations belong to float-nan, never float-bits.
        (fractionBits == 0).ifFalse(() => { policyError() })
        result = 1.0 / 0.0
    }

    special.ifFalse(() => {
        significand: fractionBits
        binaryExponent: -1074

        if(exponentBits > 0) {
            significand = fractionUnit + fractionBits
            binaryExponent = exponentBits - 1075
        }

        // significand is <= 2^53-1, so Float(Integer) is exact. The final
        // product is the encoded binary64 value itself and therefore exact.
        result =
            Float(significand) *
            binary64PowerOfTwo(binaryExponent)
    })

    if(negative) {
        result = -result
    }

    result
}

matchesExpectedFloatBits: (rawBits, value) => {
    value === floatFromExpectedBits(rawBits)
}

standardErrorPrototype: (name) => {
    result: null
    known: false

    if(name === "Error") {
        result = Error
        known = true
    }
    if(name === "SlotNotFound") {
        result = SlotNotFound
        known = true
    }
    if(name === "InvalidSuper") {
        result = InvalidSuper
        known = true
    }
    if(name === "InvalidReturn") {
        result = InvalidReturn
        known = true
    }
    if(name === "Cancelled") {
        result = Cancelled
        known = true
    }
    if(name === "FutureResolutionCycle") {
        result = FutureResolutionCycle
        known = true
    }
    if(name === "RequestOutcomeUncertain") {
        result = RequestOutcomeUncertain
        known = true
    }
    if(name === "NonTransferableValue") {
        result = NonTransferableValue
        known = true
    }
    if(name === "NonParallelValue") {
        result = NonParallelValue
        known = true
    }
    if(name === "ForeignError") {
        result = ForeignError
        known = true
    }
    if(name === "InvalidPredicateResult") {
        result = InvalidPredicateResult
        known = true
    }
    if(name === "InvalidComparatorResult") {
        result = InvalidComparatorResult
        known = true
    }
    if(name === "InvalidComparatorOrder") {
        result = InvalidComparatorOrder
        known = true
    }
    if(name === "IOError") {
        result = IOError
        known = true
    }
    if(name === "InvalidIOArgument") {
        result = InvalidIOArgument
        known = true
    }
    if(name === "IOLifecycleError") {
        result = IOLifecycleError
        known = true
    }
    if(name === "IOCapacityExhausted") {
        result = IOCapacityExhausted
        known = true
    }
    if(name === "EncodingError") {
        result = EncodingError
        known = true
    }
    if(name === "LineTooLong") {
        result = LineTooLong
        known = true
    }

    known.ifFalse(() => { policyError() })
    result
}

integerOneOfComparisonSource: (text) => {
    source: Encoding.UTF8.encode(text)
    if(source.size() == 0) { policyError() }

    token: Encoding.UTF8.encode("")
    comparison: ""
    count: 0

    flush: () => {
        if(token.size() == 0) { policyError() }
        element: Encoding.UTF8.decode(token)
        parseExpectedInteger(element)

        // parseExpectedInteger intentionally accepts the retained Java-owner +N spelling,
        // while Protos has unary minus but no unary plus. Strip only that validated leading +
        // when embedding the inert Integer literal into the inspector source.
        literalBytes: Encoding.UTF8.encode("")
        tokenIndex: 0
        token.each((octet) => {
            leadingPlus: (tokenIndex == 0) && (octet == 43)
            leadingPlus.ifFalse(() => { literalBytes.add(octet) })
            tokenIndex = tokenIndex + 1
        })
        literal: Encoding.UTF8.decode(literalBytes)

        if(count > 0) {
            comparison = comparison + " || "
        }
        comparison = comparison + "(value === " + literal + ")"
        count = count + 1
        token = Encoding.UTF8.encode("")
    }

    source.each((octet) => {
        if(octet == 44) {
            flush()
        }
        (octet == 44).ifFalse(() => {
            token.add(octet)
        })
    })
    flush()

    if(count == 0) { policyError() }
    comparison
}

futureResolvedInspectorSource: (kind, expected) => {
    expectedExpression: ""
    comparisonExpression: "value === expectedValue"
    known: false

    if(kind === "future-integer") {
        parseExpectedInteger(expected)
        expectedExpression = expected
        known = true
    }

    if(kind === "future-integer-one-of") {
        comparisonExpression = integerOneOfComparisonSource(expected)
        expectedExpression = "null"
        known = true
    }

    if(kind === "future-null") {
        (expected === "-").ifFalse(() => { policyError() })
        expectedExpression = "null"
        known = true
    }

    if(kind === "future-boolean") {
        if(expected === "true") {
            expectedExpression = "true"
            known = true
        }
        if(expected === "false") {
            expectedExpression = "false"
            known = true
        }
    }

    known.ifFalse(() => { policyError() })

    "(candidate) => {\n" +
    "    expectedValue: " + expectedExpression + "\n" +
    "    futureCandidate: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            futureCandidate = candidate.parent() === Future\n" +
    "            null\n" +
    "        },\n" +
    "        (error) => {\n" +
    "            futureCandidate = false\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    passed: false\n" +
    "    futureCandidate.ifTrue(() => {\n" +
    "        resolved: false\n" +
    "        value: null\n" +
    "        Error.handle(\n" +
    "            () => {\n" +
    "                value = candidate.value()\n" +
    "                resolved = true\n" +
    "                null\n" +
    "            },\n" +
    "            (error) => {\n" +
    "                resolved = false\n" +
    "                null\n" +
    "            }\n" +
    "        )\n" +
    "        passed = resolved\n" +
    "        passed.ifTrue(() => {\n" +
    "            passed = " + comparisonExpression + "\n" +
    "        })\n" +
    "    })\n" +
    "    passed\n" +
    "}"
}

evaluateFutureResolved: (spec, source, inspectorExecutor) => {
    isFutureResolvedExpectation(spec).ifFalse(() => {
        policyError()
    })

    observation: inspectorExecutor(
        source,
        futureResolvedInspectorSource(
            Manifest.caseExpectation(spec),
            Manifest.caseExpected(spec)
        )
    )

    passed: observation.state === "completed"
    if(passed) {
        passed = observation.error === null
    }
    if(passed) {
        passed = observation.value === true
    }

    resultTuple(passed, observation)
}


futureTerminalInspectorSource: (kind, expected) => {
    modeText: ""
    expectedParentExpression: "Error"

    if(kind === "future-error") {
        (expected === "-").ifFalse(() => { policyError() })
        modeText = "0"
    }

    if(kind === "future-error-parent") {
        standardErrorPrototype(expected)
        expectedParentExpression = expected
        modeText = "1"
    }

    if(kind === "future-cancelled") {
        (expected === "-").ifFalse(() => { policyError() })
        expectedParentExpression = "Cancelled"
        modeText = "2"
    }

    if(modeText == "") { policyError() }

    "(candidate) => {\n" +
    "    mode: " + modeText + "\n" +
    "    expectedParent: " + expectedParentExpression + "\n" +
    "    futureCandidate: false\n" +
    "    Error.handle(\n" +
    "        () => {\n" +
    "            futureCandidate = candidate.parent() === Future\n" +
    "            null\n" +
    "        },\n" +
    "        (error) => {\n" +
    "            futureCandidate = false\n" +
    "            null\n" +
    "        }\n" +
    "    )\n" +
    "    first: null\n" +
    "    second: null\n" +
    "    firstCaught: false\n" +
    "    secondCaught: false\n" +
    "    futureCandidate.ifTrue(() => {\n" +
    "        Error.handle(\n" +
    "            () => {\n" +
    "                candidate.value()\n" +
    "                null\n" +
    "            },\n" +
    "            (error) => {\n" +
    "                first = error\n" +
    "                firstCaught = true\n" +
    "                null\n" +
    "            }\n" +
    "        )\n" +
    "        Error.handle(\n" +
    "            () => {\n" +
    "                candidate.value()\n" +
    "                null\n" +
    "            },\n" +
    "            (error) => {\n" +
    "                second = error\n" +
    "                secondCaught = true\n" +
    "                null\n" +
    "            }\n" +
    "        )\n" +
    "    })\n" +
    "    passed: futureCandidate && firstCaught && secondCaught\n" +
    "    (mode == 0).ifTrue(() => {\n" +
    "        passed.ifTrue(() => { passed = first === second })\n" +
    "    })\n" +
    "    (mode == 1).ifTrue(() => {\n" +
    "        passed.ifTrue(() => { passed = first === second })\n" +
    "        passed.ifTrue(() => { passed = first.parent() === expectedParent })\n" +
    "        passed.ifTrue(() => { passed = second.parent() === expectedParent })\n" +
    "    })\n" +
    "    (mode == 2).ifTrue(() => {\n" +
    "        passed.ifTrue(() => { passed = (first === second) === false })\n" +
    "        passed.ifTrue(() => { passed = first.parent() === expectedParent })\n" +
    "        passed.ifTrue(() => { passed = second.parent() === expectedParent })\n" +
    "    })\n" +
    "    passed\n" +
    "}"
}

evaluateFutureTerminal: (spec, source, inspectorExecutor) => {
    isFutureTerminalExpectation(spec).ifFalse(() => {
        policyError()
    })

    observation: inspectorExecutor(
        source,
        futureTerminalInspectorSource(
            Manifest.caseExpectation(spec),
            Manifest.caseExpected(spec)
        )
    )

    passed: observation.state === "completed"
    if(passed) {
        passed = observation.error === null
    }
    if(passed) {
        passed = observation.value === true
    }

    resultTuple(passed, observation)
}


closureErrorParentFreshWrapperSource: (source, expected) => {
    // Validate before using the retained prototype name as a source identifier.
    standardErrorPrototype(expected)

    prefix:
        "((candidate, expectedParent) => {\n" +
        "    first: null\n" +
        "    second: null\n" +
        "    firstCaught: false\n" +
        "    secondCaught: false\n" +
        "\n" +
        "    Error.handle(\n" +
        "        candidate,\n" +
        "        (error) => {\n" +
        "            first = error\n" +
        "            firstCaught = true\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    Error.handle(\n" +
        "        candidate,\n" +
        "        (error) => {\n" +
        "            second = error\n" +
        "            secondCaught = true\n" +
        "            null\n" +
        "        }\n" +
        "    )\n" +
        "\n" +
        "    passed: firstCaught && secondCaught\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = first.parent() === expectedParent\n" +
        "    })\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = second.parent() === expectedParent\n" +
        "    })\n" +
        "    passed.ifTrue(() => {\n" +
        "        passed = (first === second) === false\n" +
        "    })\n" +
        "    passed\n" +
        "})((() => {\n"

    suffix:
        "\n})(), " +
        expected +
        ")\n"

    prefix + source + suffix
}

evaluateClosureErrorParentFresh: (spec, source, executor) => {
    isClosureErrorParentFreshExpectation(spec).ifFalse(() => {
        policyError()
    })

    expected: Manifest.caseExpected(spec)
    wrappedSource: closureErrorParentFreshWrapperSource(
        source,
        expected
    )
    observation: executor(wrappedSource)

    passed: observation.state === "completed"
    if(passed) {
        passed = observation.error === null
    }
    if(passed) {
        passed = observation.value === true
    }

    resultTuple(passed, observation)
}

evaluateSimple: (spec, source, executor) => {
    isSimpleExpectation(spec).ifFalse(() => { policyError() })

    kind: Manifest.caseExpectation(spec)
    expected: Manifest.caseExpected(spec)
    observation: executor(source)
    passed: false

    if(kind === "boolean") {
        expectedKnown: expected === "true"
        expectedValue: true
        if(expected === "false") {
            expectedKnown = true
            expectedValue = false
        }
        expectedKnown.ifFalse(() => { policyError() })

        passed = observation.state === "completed"
        if(passed) {
            passed = observation.error === null
        }
        if(passed) {
            passed = observation.value === expectedValue
        }
    }

    if(kind === "null") {
        (expected === "-").ifFalse(() => { policyError() })

        passed = observation.state === "completed"
        if(passed) {
            passed = observation.error === null
        }
        if(passed) {
            passed = observation.value === null
        }
    }

    if(kind === "integer") {
        expectedValue: parseExpectedInteger(expected)

        passed = observation.state === "completed"
        if(passed) {
            passed = observation.error === null
        }
        if(passed) {
            passed = observation.value === expectedValue
        }
    }

    if(kind === "float-bits") {
        rawBits: parseExpectedFloatBits(expected)

        passed = observation.state === "completed"
        if(passed) {
            passed = observation.error === null
        }
        if(passed) {
            passed = matchesExpectedFloatBits(rawBits, observation.value)
        }
    }

    if(kind === "float-nan") {
        (expected === "-").ifFalse(() => { policyError() })

        // Core v0.1 has one semantic Float NaN value even when host payload/sign
        // representations differ. Construct it through ordinary Float arithmetic
        // and use primitive semantic identity so non-Float values cannot match.
        expectedNaN: 0.0 / 0.0

        passed = observation.state === "completed"
        if(passed) {
            passed = observation.error === null
        }
        if(passed) {
            passed = observation.value === expectedNaN
        }
    }

    if(kind === "error-parent") {
        expectedParent: standardErrorPrototype(expected)

        passed = observation.state === "failed"
        if(passed) {
            passed = observation.value === null
        }
        if(passed) {
            if(observation.error === null) {
                passed = false
            }
        }
        if(passed) {
            passed = observation.error.parent() === expectedParent
        }
    }

    if(kind === "error") {
        (expected === "-").ifFalse(() => { policyError() })

        passed = observation.state === "failed"
        if(passed) {
            passed = observation.value === null
        }
        if(passed) {
            if(observation.error === null) {
                passed = false
            }
        }
    }

    resultTuple(passed, observation)
}

evaluateDCase: (spec, source, executor, inspectorExecutor) => {
    evaluation: null

    if(isFutureResolvedExpectation(spec)) {
        if(inspectorExecutor === null) { policyError() }
        evaluation = evaluateFutureResolved(spec, source, inspectorExecutor)
    }

    if(evaluation === null) {
        if(isFutureTerminalExpectation(spec)) {
            if(inspectorExecutor === null) { policyError() }
            evaluation = evaluateFutureTerminal(spec, source, inspectorExecutor)
        }
    }

    if(evaluation === null) {
        if(Manifest.caseExpectation(spec) === "future-observation-error-identity") {
            if(inspectorExecutor === null) { policyError() }
            evaluation = evaluateFutureObservation(spec, source, inspectorExecutor)
        }
    }

    if(evaluation === null) {
        closureFresh: isClosureErrorParentFreshExpectation(spec)
        if(closureFresh) {
            evaluation = evaluateClosureErrorParentFresh(spec, source, executor)
        }
        closureFresh.ifFalse(() => {
            evaluation = evaluateSimple(spec, source, executor)
        })
    }

    evaluation
}

caseRunTuple: (...items) => {
    items
}

caseRunSpec: (caseRun) => {
    caseRun[0]
}

caseRunEvaluation: (caseRun) => {
    caseRun[1]
}

runTuple: (...items) => {
    items
}

runCaseResults: (run) => {
    run[0]
}

runSelectedCount: (run) => {
    run[1]
}

runPassedCount: (run) => {
    run[2]
}

runSkippedCount: (run) => {
    run[3]
}

runAllPassed: (run) => {
    runPassedCount(run) == runSelectedCount(run)
}

runSimpleWithLoader: (plan, sourceLoader, executor, inspectorExecutor) => {
    cases: Manifest.planCases(plan)

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        if(present) {
            left: resultChunks[level]
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        }
        present.ifFalse(() => {
            resultChunks[level] = chunk
            if(level > maxChunkLevel) {
                maxChunkLevel = level
            }
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        if(level >= 0) {
            nextResult: result
            if(resultChunks.containsKey(level)) {
                nextResult = Array(...result, ...resultChunks[level])
            }
            finalResult = collectChunks(level - 1, nextResult)
        }
        finalResult
    }

    // Future.all() supplies one already-resolved seed Future. Array.each itself
    // never suspends: it only attaches the next continuation to the prior Future.
    // The dependency chain therefore preserves manifest order without retaining
    // one recursive Protos call frame per selected case.
    chain: Future.all()

    cases.each((spec) => {
        supported: isDExpectation(spec)
        if(supported) {
            previous: chain
            chain = previous.then((ignored) => {
                source: sourceLoader(spec)
                evaluation: evaluateDCase(spec, source, executor, inspectorExecutor)
                carryChunk(Array(caseRunTuple(spec, evaluation)), 0)
                null
            })
        }
    })

    chain.value()

    caseResults: resultTuple(...collectChunks(maxChunkLevel, Array()))
    passedCount: 0
    caseResults.each((caseRun) => {
        if(resultPassed(caseRunEvaluation(caseRun))) {
            passedCount = passedCount + 1
        }
    })

    skippedCount: 0
    cases.each((spec) => {
        isDExpectation(spec).ifFalse(() => {
            skippedCount = skippedCount + 1
        })
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        skippedCount
    )
}


// TOOL002-H2B1 bounded simple-case scheduling kernel.
//
// Admission is owned directly by the current Test Tool runner task. No
// Future.then continuation task and no per-case Closure.future worker is created
// by this scheduler. Each wave admits at most maxInFlight exact executions, then
// performs one deterministic Future.all(...).value() wait before projecting
// already-rematerialized observations in TestPlan order. The standard whileTrue
// protocol owns suspension/replay of the wave loops; D055 keeps jobs defaults,
// host carriers, resources, timeout/kill, retry and remote policy deferred.
runBoundedSimpleWithLoader: (
    plan,
    sourceLoader,
    executorAsync,
    maxInFlight
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        policyError()
    })
    (maxInFlight > 0).ifFalse(() => {
        policyError()
    })

    cases: Manifest.planCases(plan)
    selectedCases: Array()
    cases.each((spec) => {
        if(isSimpleExpectation(spec)) {
            selectedCases = Array(...selectedCases, spec)
        }
    })

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        if(present) {
            left: resultChunks[level]
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        }
        present.ifFalse(() => {
            resultChunks[level] = chunk
            if(level > maxChunkLevel) {
                maxChunkLevel = level
            }
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        if(level >= 0) {
            nextResult: result
            if(resultChunks.containsKey(level)) {
                nextResult = Array(...result, ...resultChunks[level])
            }
            finalResult = collectChunks(level - 1, nextResult)
        }
        finalResult
    }

    nextIndex: 0
    while(nextIndex < selectedCases.size()) {
        waveSpecs: Array()
        waveSources: Array()
        pending: Array()
        admitted: 0

        while(
            (admitted < maxInFlight) &&
            (nextIndex < selectedCases.size())
        ) {
            spec: selectedCases[nextIndex]
            source: sourceLoader(spec)

            waveSpecs = Array(...waveSpecs, spec)
            waveSources = Array(...waveSources, source)
            pending = Array(...pending, executorAsync(source))

            admitted = admitted + 1
            nextIndex = nextIndex + 1
        }

        observations: Future.all(...pending).value()

        resultIndex: 0
        while(resultIndex < observations.size()) {
            spec: waveSpecs[resultIndex]
            source: waveSources[resultIndex]
            observation: observations[resultIndex]
            evaluation: evaluateSimple(
                spec,
                source,
                (ignoredSource) => { observation }
            )
            carryChunk(Array(caseRunTuple(spec, evaluation)), 0)
            resultIndex = resultIndex + 1
        }
    }

    caseResults: resultTuple(...collectChunks(maxChunkLevel, Array()))
    passedCount: 0
    caseResults.each((caseRun) => {
        if(resultPassed(caseRunEvaluation(caseRun))) {
            passedCount = passedCount + 1
        }
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        cases.size() - selectedCases.size()
    )
}

runBoundedSimple: (
    plan,
    filesystem,
    executorAsync,
    maxInFlight
) => {
    runBoundedSimpleWithLoader(
        plan,
        (spec) => { readSource(spec, filesystem) },
        executorAsync,
        maxInFlight
    )
}


// TOOL002-H2B2 complete bounded D-case scheduling over D055 async exact execution.
//
// This layer owns admission only. Existing Runner policy continues to decide which
// cases require ordinary exact execution, closure-preserving source wrapping or
// live-result inspection. A mixed wave shares one maxInFlight bound across both
// executionAsync and executionInspectAsync. The scheduler creates no Future.then
// coordination Task and no per-case Closure.future worker.
scheduleDCaseAsync: (
    spec,
    source,
    executorAsync,
    inspectorExecutorAsync
) => {
    pending: null

    if(isFutureResolvedExpectation(spec)) {
        if(inspectorExecutorAsync === null) { policyError() }
        pending = inspectorExecutorAsync(
            source,
            futureResolvedInspectorSource(
                Manifest.caseExpectation(spec),
                Manifest.caseExpected(spec)
            )
        )
    }

    if(pending === null) {
        if(isFutureTerminalExpectation(spec)) {
            if(inspectorExecutorAsync === null) { policyError() }
            pending = inspectorExecutorAsync(
                source,
                futureTerminalInspectorSource(
                    Manifest.caseExpectation(spec),
                    Manifest.caseExpected(spec)
                )
            )
        }
    }

    if(pending === null) {
        if(Manifest.caseExpectation(spec) === "future-observation-error-identity") {
            if(inspectorExecutorAsync === null) { policyError() }
            policy: parseFutureObservationPolicy(Manifest.caseExpected(spec))
            inspectorSource: null

            if(futureObservationPolicyMode(policy) === "stored") {
                inspectorSource = futureStoredObservationInspectorSource()
            }
            if(futureObservationPolicyMode(policy) === "fresh") {
                inspectorSource = futureFreshObservationInspectorSource(
                    futureObservationPolicyParentName(policy)
                )
            }
            if(inspectorSource === null) { policyError() }
            pending = inspectorExecutorAsync(source, inspectorSource)
        }
    }

    if(pending === null) {
        if(isClosureErrorParentFreshExpectation(spec)) {
            pending = executorAsync(
                closureErrorParentFreshWrapperSource(
                    source,
                    Manifest.caseExpected(spec)
                )
            )
        }
    }

    if(pending === null) {
        if(isSimpleExpectation(spec)) {
            pending = executorAsync(source)
        }
    }

    if(pending === null) { policyError() }
    pending
}

evaluateDObservation: (spec, source, observation) => {
    evaluateDCase(
        spec,
        source,
        (ignoredSource) => { observation },
        (ignoredSource, ignoredInspector) => { observation }
    )
}

runBoundedWithLoader: (
    plan,
    sourceLoader,
    executorAsync,
    inspectorExecutorAsync,
    maxInFlight
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        policyError()
    })
    (maxInFlight > 0).ifFalse(() => {
        policyError()
    })

    cases: Manifest.planCases(plan)
    selectedCases: Array()
    cases.each((spec) => {
        if(isDExpectation(spec)) {
            selectedCases = Array(...selectedCases, spec)
        }
    })

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        if(present) {
            left: resultChunks[level]
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        }
        present.ifFalse(() => {
            resultChunks[level] = chunk
            if(level > maxChunkLevel) {
                maxChunkLevel = level
            }
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        if(level >= 0) {
            nextResult: result
            if(resultChunks.containsKey(level)) {
                nextResult = Array(...result, ...resultChunks[level])
            }
            finalResult = collectChunks(level - 1, nextResult)
        }
        finalResult
    }

    nextIndex: 0
    while(nextIndex < selectedCases.size()) {
        waveSpecs: Array()
        waveSources: Array()
        pending: Array()
        admitted: 0

        while(
            (admitted < maxInFlight) &&
            (nextIndex < selectedCases.size())
        ) {
            spec: selectedCases[nextIndex]
            source: sourceLoader(spec)

            waveSpecs = Array(...waveSpecs, spec)
            waveSources = Array(...waveSources, source)
            pending = Array(
                ...pending,
                scheduleDCaseAsync(
                    spec,
                    source,
                    executorAsync,
                    inspectorExecutorAsync
                )
            )

            admitted = admitted + 1
            nextIndex = nextIndex + 1
        }

        observations: Future.all(...pending).value()

        resultIndex: 0
        while(resultIndex < observations.size()) {
            spec: waveSpecs[resultIndex]
            source: waveSources[resultIndex]
            observation: observations[resultIndex]
            evaluation: evaluateDObservation(spec, source, observation)
            carryChunk(Array(caseRunTuple(spec, evaluation)), 0)
            resultIndex = resultIndex + 1
        }
    }

    caseResults: resultTuple(...collectChunks(maxChunkLevel, Array()))
    passedCount: 0
    caseResults.each((caseRun) => {
        if(resultPassed(caseRunEvaluation(caseRun))) {
            passedCount = passedCount + 1
        }
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        cases.size() - selectedCases.size()
    )
}


// TOOL002-I8C: D105 fixed-H-window resource-round composition.
//
// Private alternate Runner entrypoint. Public Main remains on the resource-free
// H path until later D076 provider/capability boundaries are implemented.
runBoundedWithResourcesWithLoader: (
    plan,
    resourceCatalog,
    sourceLoader,
    executorAsync,
    inspectorExecutorAsync,
    maxInFlight
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        policyError()
    })
    (maxInFlight > 0).ifFalse(() => {
        policyError()
    })

    cases: Manifest.planCases(plan)
    selectedCases: Array()
    cases.each((spec) => {
        if(isDExpectation(spec)) {
            selectedCases = Array(...selectedCases, spec)
        }
    })

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        if(present) {
            left: resultChunks[level]
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        }
        present.ifFalse(() => {
            resultChunks[level] = chunk
            if(level > maxChunkLevel) {
                maxChunkLevel = level
            }
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        if(level >= 0) {
            nextResult: result
            if(resultChunks.containsKey(level)) {
                nextResult = Array(...result, ...resultChunks[level])
            }
            finalResult = collectChunks(level - 1, nextResult)
        }
        finalResult
    }

    reservationState: ResourceReservation.newState(resourceCatalog)

    nextIndex: 0
    while(nextIndex < selectedCases.size()) {
        // D105 immutable logical H window.
        windowSpecs: Array()
        windowSources: Array()
        windowBindings: Array()
        windowResults: Array()
        windowCount: 0

        while(
            (windowCount < maxInFlight) &&
            (nextIndex < selectedCases.size())
        ) {
            spec: selectedCases[nextIndex]
            source: sourceLoader(spec)
            bindings: ResourceBinding.bindCase(spec, resourceCatalog)

            windowSpecs = Array(...windowSpecs, spec)
            windowSources = Array(...windowSources, source)
            windowBindings = Array(...windowBindings, bindings)
            windowResults = Array(...windowResults, null)

            windowCount = windowCount + 1
            nextIndex = nextIndex + 1
        }

        remainingInWindow: windowCount

        while(remainingInWindow > 0) {
            roundIndexes: Array()
            roundReservations: Array()
            pending: Array()

            // Stable TestPlan-order scan with same-window backfill.
            windowIndex: 0
            while(windowIndex < windowCount) {
                if(windowResults[windowIndex] === null) {
                    reservation: ResourceReservation.tryReserve(
                        windowBindings[windowIndex],
                        reservationState
                    )

                    (reservation === null).ifFalse(() => {
                        spec: windowSpecs[windowIndex]
                        source: windowSources[windowIndex]

                        roundIndexes = Array(...roundIndexes, windowIndex)
                        roundReservations = Array(
                            ...roundReservations,
                            reservation
                        )
                        pending = Array(
                            ...pending,
                            scheduleDCaseAsync(
                                spec,
                                source,
                                executorAsync,
                                inspectorExecutorAsync
                            )
                        )
                    })
                }

                windowIndex = windowIndex + 1
            }

            // I8A static feasibility plus an empty prior-round boundary must
            // make progress. Fail closed rather than spin if invariants regress.
            if(pending.size() == 0) {
                policyError()
            }

            observations: Future.all(...pending).value()

            // H/D055 async completion is the terminal execution barrier used by
            // D105. Release the whole round before any rescan.
            releaseIndex: 0
            while(releaseIndex < roundReservations.size()) {
                ResourceReservation.release(
                    roundReservations[releaseIndex],
                    reservationState
                )
                releaseIndex = releaseIndex + 1
            }

            (
                ResourceReservation.activeReservationCount(reservationState) == 0
            ).ifFalse(() => {
                policyError()
            })

            resultIndex: 0
            while(resultIndex < observations.size()) {
                resultWindowIndex: roundIndexes[resultIndex]
                spec: windowSpecs[resultWindowIndex]
                source: windowSources[resultWindowIndex]
                observation: observations[resultIndex]
                evaluation: evaluateDObservation(spec, source, observation)

                windowResults[resultWindowIndex] =
                    caseRunTuple(spec, evaluation)

                remainingInWindow = remainingInWindow - 1
                resultIndex = resultIndex + 1
            }
        }

        // Emit only after the whole fixed H window completes, in logical order.
        resultWindowIndex: 0
        while(resultWindowIndex < windowCount) {
            caseRun: windowResults[resultWindowIndex]
            if(caseRun === null) {
                policyError()
            }
            carryChunk(Array(caseRun), 0)
            resultWindowIndex = resultWindowIndex + 1
        }
    }

    caseResults: resultTuple(...collectChunks(maxChunkLevel, Array()))
    passedCount: 0
    caseResults.each((caseRun) => {
        if(resultPassed(caseRunEvaluation(caseRun))) {
            passedCount = passedCount + 1
        }
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        cases.size() - selectedCases.size()
    )
}

runBoundedWithResources: (
    plan,
    resourceCatalog,
    filesystem,
    executorAsync,
    inspectorExecutorAsync,
    maxInFlight
) => {
    runBoundedWithResourcesWithLoader(
        plan,
        resourceCatalog,
        (spec) => { readSource(spec, filesystem) },
        executorAsync,
        inspectorExecutorAsync,
        maxInFlight
    )
}

// TOOL002-I8D4C3: private D108 terminal-completion resource scheduler.
//
// This is intentionally a new private Runner entrypoint rather than a mutation
// of I8C's historical runBoundedWithResourcesWithLoader contract. It composes:
// - H's unchanged resource-free async fast path;
// - C1 resourceful ordinary callback for non-empty bindings;
// - C2 resourceful live-inspection callback for non-empty bindings;
// - I8B release only after D108 reports capacitySafe;
// - complete admitted-round drain before infrastructure cutover;
// - no same-window rescan and no later fixed-H window after infrastructure failure.
//
// The returned carrier is an internal preservation envelope, not final CLI
// reporting policy. D108 explicitly leaves final reporting wording/carrier to a
// later bounded integration.
//
// envelope:
//   [ordered guest CaseRuns,
//    ordinary unsupported/skipped count,
//    ordered [CaseSpec, AttemptCompletion] infrastructure evidence,
//    ordered selected CaseSpecs never admitted because of cutover,
//    active I8B reservation count retained after terminal drain]
d108RunEnvelope: (...items) => {
    items
}

d108RunCaseResults: (run) => {
    run[0]
}

d108RunSkippedCount: (run) => {
    run[1]
}

d108RunInfrastructureAttempts: (run) => {
    run[2]
}

d108RunCutoverCases: (run) => {
    run[3]
}

d108RunRetainedReservationCount: (run) => {
    run[4]
}

d108RunInfrastructureFailed: (run) => {
    d108RunInfrastructureAttempts(run).size() > 0
}

d108InfrastructureAttempt: (...items) => {
    items
}

d108InfrastructureAttemptSpec: (attempt) => {
    attempt[0]
}

d108InfrastructureAttemptCompletion: (attempt) => {
    attempt[1]
}

// Only a completely healthy D108 envelope may project back into the historical
// ordinary runTuple. Infrastructure-aborted partial evidence is deliberately
// not coerced into passed/failed/skipped guest semantics.
d108RunHealthyRun: (run) => {
    if(d108RunInfrastructureFailed(run)) {
        policyError()
    }
    (d108RunCutoverCases(run).size() == 0).ifFalse(() => {
        policyError()
    })
    (d108RunRetainedReservationCount(run) == 0).ifFalse(() => {
        policyError()
    })

    caseResults: d108RunCaseResults(run)
    passedCount: 0
    caseResults.each((caseRun) => {
        if(resultPassed(caseRunEvaluation(caseRun))) {
            passedCount = passedCount + 1
        }
    })

    runTuple(
        caseResults,
        caseResults.size(),
        passedCount,
        d108RunSkippedCount(run)
    )
}

d108Scheduled: (...items) => {
    items
}

d108ScheduledFuture: (scheduled) => {
    scheduled[0]
}

d108ScheduledResourceful: (scheduled) => {
    scheduled[1]
}

scheduleD108CaseAsync: (
    spec,
    source,
    bindings,
    executorAsync,
    inspectorExecutorAsync,
    resourceExecutorAsync,
    resourceInspectorExecutorAsync,
    caseAuthorityExecutorAsync
) => {
    resourceful: bindings.size() > 0
    descriptor: Manifest.caseAuthorityDescriptor(spec)
    pending: null

    (descriptor === null).ifFalse(() => {
        // D133 generation 1 keeps per-case authority distinct from D077
        // resource/provider provisioning. TOOL005-B3B currently requires no
        // ResourceRequirement on project-tree cases.
        if(resourceful) {
            policyError()
        }
        if(caseAuthorityExecutorAsync === null) {
            policyError()
        }
        (
            Manifest.caseAuthorityKind(descriptor) === "project-tree"
        ).ifFalse(() => {
            policyError()
        })

        pending = scheduleDCaseAsync(
            spec,
            source,
            (executionSource) => {
                caseAuthorityExecutorAsync(
                    executionSource,
                    descriptor
                )
            },
            null
        )
    })

    if(descriptor === null) {
        if(resourceful) {
            if(resourceExecutorAsync === null) {
                policyError()
            }

            providerBindings:
                ResourceBinding.providerRequestSnapshot(bindings)

            resourceInspector: null
            (resourceInspectorExecutorAsync === null).ifFalse(() => {
                resourceInspector = (executionSource, inspectorSource) => {
                    resourceInspectorExecutorAsync(
                        executionSource,
                        inspectorSource,
                        providerBindings
                    )
                }
            })

            pending = scheduleDCaseAsync(
                spec,
                source,
                (executionSource) => {
                    resourceExecutorAsync(
                        executionSource,
                        providerBindings
                    )
                },
                resourceInspector
            )
        }

        resourceful.ifFalse(() => {
            pending = scheduleDCaseAsync(
                spec,
                source,
                executorAsync,
                inspectorExecutorAsync
            )
        })
    }

    d108Scheduled(pending, resourceful)
}

runD108WithResourcesWithLoader: (
    plan,
    resourceCatalog,
    sourceLoader,
    executorAsync,
    inspectorExecutorAsync,
    resourceExecutorAsync,
    resourceInspectorExecutorAsync,
    maxInFlight,
    terminalObserver,
    caseAuthorityExecutorAsync,
    lifecycleObserver
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        policyError()
    })
    (maxInFlight > 0).ifFalse(() => {
        policyError()
    })

    cases: Manifest.planCases(plan)
    selectedCases: Array()
    cases.each((spec) => {
        if(isDExpectation(spec)) {
            selectedCases = Array(...selectedCases, spec)
        }
    })

    resultChunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: resultChunks.containsKey(level)
        if(present) {
            left: resultChunks[level]
            resultChunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        }
        present.ifFalse(() => {
            resultChunks[level] = chunk
            if(level > maxChunkLevel) {
                maxChunkLevel = level
            }
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        if(level >= 0) {
            nextResult: result
            if(resultChunks.containsKey(level)) {
                nextResult = Array(...result, ...resultChunks[level])
            }
            finalResult = collectChunks(level - 1, nextResult)
        }
        finalResult
    }

    reservationState:
        ResourceReservation.newState(resourceCatalog)

    infrastructureAttempts: Array()
    cutoverCases: Array()
    invocationInfrastructureFailed: false

    nextIndex: 0
    while(
        (nextIndex < selectedCases.size()) &&
        invocationInfrastructureFailed.not()
    ) {
        // D105 immutable fixed H window.
        windowSpecs: Array()
        windowSources: Array()
        windowBindings: Array()
        windowResults: Array()
        windowAttempted: Array()
        windowCount: 0

        while(
            (windowCount < maxInFlight) &&
            (nextIndex < selectedCases.size())
        ) {
            spec: selectedCases[nextIndex]
            source: sourceLoader(spec)
            bindings:
                ResourceBinding.bindCase(spec, resourceCatalog)

            windowSpecs = Array(...windowSpecs, spec)
            windowSources = Array(...windowSources, source)
            windowBindings = Array(...windowBindings, bindings)
            windowResults = Array(...windowResults, null)
            windowAttempted = Array(...windowAttempted, false)

            windowCount = windowCount + 1
            nextIndex = nextIndex + 1
        }

        remainingInWindow: windowCount

        while(
            (remainingInWindow > 0) &&
            invocationInfrastructureFailed.not()
        ) {
            roundIndexes: Array()
            roundReservations: Array()
            roundResourceful: Array()
            pending: Array()

            // Stable TestPlan-order scan with same-window backfill.
            windowIndex: 0
            while(windowIndex < windowCount) {
                if(windowResults[windowIndex] === null) {
                    reservation:
                        ResourceReservation.tryReserve(
                            windowBindings[windowIndex],
                            reservationState
                        )

                    (reservation === null).ifFalse(() => {
                        spec: windowSpecs[windowIndex]
                        source: windowSources[windowIndex]

                        (lifecycleObserver === null).ifFalse(() => {
                            lifecycleObserver(
                                "started",
                                spec,
                                null
                            )
                        })

                        scheduled:
                            scheduleD108CaseAsync(
                                spec,
                                source,
                                windowBindings[windowIndex],
                                executorAsync,
                                inspectorExecutorAsync,
                                resourceExecutorAsync,
                                resourceInspectorExecutorAsync,
                                caseAuthorityExecutorAsync
                            )

                        windowAttempted[windowIndex] = true
                        roundIndexes =
                            Array(...roundIndexes, windowIndex)
                        roundReservations =
                            Array(...roundReservations, reservation)
                        roundResourceful =
                            Array(
                                ...roundResourceful,
                                d108ScheduledResourceful(scheduled)
                            )
                        pending =
                            Array(
                                ...pending,
                                d108ScheduledFuture(scheduled)
                            )
                    })
                }

                windowIndex = windowIndex + 1
            }

            // I8A feasibility + D105 prior release must guarantee progress while
            // the invocation is still healthy.
            if(pending.size() == 0) {
                policyError()
            }

            // D108 terminal barrier: C1/C2 resourceful Futures resolve only after
            // Process/host/provider lifecycle terminality. Future.all therefore
            // drains every already-admitted sibling before any release/cutover.
            observations: Future.all(...pending).value()

            roundInfrastructureFailed: false

            resultIndex: 0
            while(resultIndex < observations.size()) {
                resultWindowIndex: roundIndexes[resultIndex]
                spec: windowSpecs[resultWindowIndex]
                source: windowSources[resultWindowIndex]
                reservation: roundReservations[resultIndex]
                resourceful: roundResourceful[resultIndex]

                completionValue: observations[resultIndex]
                guestObservation: completionValue
                infrastructureFailed: false
                capacitySafe: true

                // D134: both D077 resourceful attempts and D133 CaseAuthority
                // attempts return terminal guest+infrastructure envelopes.
                // Only D077 owns capacity disposition.
                infrastructureEnvelope: resourceful
                (
                    Manifest.caseAuthorityDescriptor(spec) === null
                ).ifFalse(() => {
                    infrastructureEnvelope = true
                })

                if(infrastructureEnvelope) {
                    infrastructureFailed =
                        completionValue.infrastructureFailed
                    guestObservation =
                        completionValue.guestObservation

                    if(resourceful) {
                        capacitySafe =
                            completionValue.capacitySafe

                        // UNSAFE without infrastructure evidence is not a valid
                        // D108 terminal disposition.
                        if(
                            capacitySafe.not() &&
                            infrastructureFailed.not()
                        ) {
                            policyError()
                        }
                    }

                    if(infrastructureFailed) {
                        roundInfrastructureFailed = true
                        infrastructureAttempts =
                            Array(
                                ...infrastructureAttempts,
                                d108InfrastructureAttempt(
                                    spec,
                                    completionValue
                                )
                            )
                    }
                }

                // I8B release is permitted only after terminal completion proves
                // reuse safety. Resource-free empty reservations remain no-op.
                if(capacitySafe) {
                    ResourceReservation.release(
                        reservation,
                        reservationState
                    )
                }

                // Preserve guest evidence if it exists, even if cleanup later
                // produced infrastructure failure. Never fabricate a guest
                // passed/failed result when no guest observation exists.
                evaluation: null
                (guestObservation === null).ifFalse(() => {
                    evaluation =
                        evaluateDObservation(
                            spec,
                            source,
                            guestObservation
                        )

                    windowResults[resultWindowIndex] =
                        caseRunTuple(spec, evaluation)
                    remainingInWindow = remainingInWindow - 1
                })

                if(
                    (guestObservation === null) &&
                    infrastructureFailed.not()
                ) {
                    policyError()
                }

                // D174: lifecycle terminality is observable only after the
                // existing D108 terminal/reconciliation boundary.
                (lifecycleObserver === null).ifFalse(() => {
                    lifecycleObserver(
                        "terminal",
                        spec,
                        evaluation
                    )
                })

                // TOOL004-B / D120: this observer sees only attempts that have
                // crossed D108's terminal barrier and had capacity/result state
                // reconciled. It remains presentation-neutral and optional.
                (terminalObserver === null).ifFalse(() => {
                    terminalObserver(
                        spec,
                        evaluation,
                        infrastructureFailed
                    )
                })

                resultIndex = resultIndex + 1
            }

            if(roundInfrastructureFailed) {
                invocationInfrastructureFailed = true
            }

            // On a healthy round every reservation, including resourceful ones,
            // must have become safely reusable before the D105 rescan.
            if(invocationInfrastructureFailed.not()) {
                (
                    ResourceReservation.activeReservationCount(
                        reservationState
                    ) == 0
                ).ifFalse(() => {
                    policyError()
                })
            }
        }

        // Preserve every guest CaseRun that really exists, always in logical
        // TestPlan/window order. In a healthy window every slot must exist.
        resultWindowIndex: 0
        while(resultWindowIndex < windowCount) {
            caseRun: windowResults[resultWindowIndex]

            if(caseRun === null) {
                if(invocationInfrastructureFailed.not()) {
                    policyError()
                }
            }

            (caseRun === null).ifFalse(() => {
                carryChunk(Array(caseRun), 0)
            })

            resultWindowIndex = resultWindowIndex + 1
        }

        if(invocationInfrastructureFailed) {
            // Only cases never admitted in the affected H window belong to the
            // cutover set. An admitted provisioning failure is represented by
            // infrastructureAttempts, not fabricated as a skipped/not-admitted
            // guest result.
            cutoverIndex: 0
            while(cutoverIndex < windowCount) {
                if(windowAttempted[cutoverIndex].not()) {
                    cutoverCases =
                        Array(
                            ...cutoverCases,
                            windowSpecs[cutoverIndex]
                        )
                }
                cutoverIndex = cutoverIndex + 1
            }

            // D108 whole-invocation fail-stop: no later H window, including
            // resource-free cases, is started.
            laterIndex: nextIndex
            while(laterIndex < selectedCases.size()) {
                cutoverCases =
                    Array(
                        ...cutoverCases,
                        selectedCases[laterIndex]
                    )
                laterIndex = laterIndex + 1
            }
        }
    }

    caseResults:
        resultTuple(...collectChunks(maxChunkLevel, Array()))

    retainedReservationCount:
        ResourceReservation.activeReservationCount(
            reservationState
        )

    if(invocationInfrastructureFailed.not()) {
        (retainedReservationCount == 0).ifFalse(() => {
            policyError()
        })
    }

    d108RunEnvelope(
        caseResults,
        cases.size() - selectedCases.size(),
        resultTuple(...infrastructureAttempts),
        resultTuple(...cutoverCases),
        retainedReservationCount
    )
}

runD108WithResources: (
    plan,
    resourceCatalog,
    filesystem,
    executorAsync,
    inspectorExecutorAsync,
    resourceExecutorAsync,
    resourceInspectorExecutorAsync,
    maxInFlight,
    terminalObserver,
    caseAuthorityExecutorAsync,
    lifecycleObserver
) => {
    runD108WithResourcesWithLoader(
        plan,
        resourceCatalog,
        (spec) => { readSource(spec, filesystem) },
        executorAsync,
        inspectorExecutorAsync,
        resourceExecutorAsync,
        resourceInspectorExecutorAsync,
        maxInFlight,
        terminalObserver,
        caseAuthorityExecutorAsync,
        lifecycleObserver
    )
}


// TOOL002-I8D5B / D114: stable Test Tool outer outcome projection.
//
// Healthy runs preserve the historical runTuple unchanged under the "completed"
// tag. D108 infrastructure cutover projects to a distinct "infrastructure-aborted"
// tag with the five independently ratified evidence categories. No guest result is
// synthesized here and no CLI exit/reporting policy is executed here.

testRunInfrastructureAbortPayload: (...items) => {
    resultTuple(...items)
}

testRunInfrastructureAbortExecutedCaseRuns: (payload) => {
    payload[0]
}

testRunInfrastructureAbortOrdinaryUnsupportedCount: (payload) => {
    payload[1]
}

testRunInfrastructureAbortAttempts: (payload) => {
    payload[2]
}

testRunInfrastructureAbortCutoverNotAdmittedCases: (payload) => {
    payload[3]
}

testRunInfrastructureAbortRetainedUnsafeReservationCount: (payload) => {
    payload[4]
}

testRunOutcome: (...items) => {
    resultTuple(...items)
}

testRunOutcomeCompleted: (run) => {
    testRunOutcomeCompletedWithExit(run, 0)
}

testRunOutcomeInfrastructureAborted: (
    executedCaseRuns,
    ordinaryUnsupportedCount,
    infrastructureAttempts,
    cutoverNotAdmittedCases,
    retainedUnsafeReservationCount
) => {
    testRunOutcome(
        "infrastructure-aborted",
        null,
        testRunInfrastructureAbortPayload(
            executedCaseRuns,
            ordinaryUnsupportedCount,
            infrastructureAttempts,
            cutoverNotAdmittedCases,
            retainedUnsafeReservationCount
        ),
        3
    )
}

testRunOutcomeStatus: (outcome) => {
    outcome[0]
}

testRunOutcomeRun: (outcome) => {
    outcome[1]
}

testRunOutcomeInfrastructureAbort: (outcome) => {
    outcome[2]
}

testRunOutcomeFromD108: (d108Run) => {
    projected: null

    if(d108RunInfrastructureFailed(d108Run)) {
        projected =
            testRunOutcomeInfrastructureAborted(
                d108RunCaseResults(d108Run),
                d108RunSkippedCount(d108Run),
                d108RunInfrastructureAttempts(d108Run),
                d108RunCutoverCases(d108Run),
                d108RunRetainedReservationCount(d108Run)
            )
    }

    d108RunInfrastructureFailed(d108Run).ifFalse(() => {
        projected =
            testRunOutcomeCompleted(
                d108RunHealthyRun(d108Run)
            )
    })

    projected
}


// TOOL002-I8D5C / D116: N-plan invocation aggregation and final D114 CLI classification.

testRunOutcomeCompletedWithExit: (run, exitCode) => {
    ((exitCode == 0) || (exitCode == 1)).ifFalse(() => {
        policyError()
    })

    testRunOutcome(
        "completed",
        run,
        null,
        exitCode
    )
}

testRunOutcomeExitCode: (outcome) => {
    outcome[3]
}

testRunOutcomeCompletedAcrossRuns: (
    primaryRun,
    executedRuns
) => {
    if(executedRuns.size() == 0) {
        policyError()
    }

    primarySeen: false
    allHealthy: true

    executedRuns.each((run) => {
        if(run === primaryRun) {
            primarySeen = true
        }
        runAllPassed(run).ifFalse(() => {
            allHealthy = false
        })
    })

    primarySeen.ifFalse(() => {
        policyError()
    })

    exitCode: 0
    allHealthy.ifFalse(() => {
        exitCode = 1
    })

    testRunOutcomeCompletedWithExit(
        primaryRun,
        exitCode
    )
}

selectedDCaseSpecs: (plan) => {
    selected: Array()
    Manifest.planCases(plan).each((spec) => {
        if(isDExpectation(spec)) {
            selected = Array(...selected, spec)
        }
    })
    resultTuple(...selected)
}

testRunOutcomeInfrastructureAbortedAcrossInvocation: (
    completedRuns,
    abortedD108,
    laterPlans
) => {
    d108RunInfrastructureFailed(abortedD108).ifFalse(() => {
        policyError()
    })

    executedCaseRuns: Array()
    ordinaryUnsupportedCount: 0

    completedRuns.each((run) => {
        executedCaseRuns =
            Array(
                ...executedCaseRuns,
                ...runCaseResults(run)
            )
        ordinaryUnsupportedCount =
            ordinaryUnsupportedCount +
            runSkippedCount(run)
    })

    executedCaseRuns =
        Array(
            ...executedCaseRuns,
            ...d108RunCaseResults(abortedD108)
        )
    ordinaryUnsupportedCount =
        ordinaryUnsupportedCount +
        d108RunSkippedCount(abortedD108)

    cutoverNotAdmitted:
        Array(...d108RunCutoverCases(abortedD108))

    laterPlans.each((plan) => {
        cutoverNotAdmitted =
            Array(
                ...cutoverNotAdmitted,
                ...selectedDCaseSpecs(plan)
            )
    })

    testRunOutcomeInfrastructureAborted(
        resultTuple(...executedCaseRuns),
        ordinaryUnsupportedCount,
        d108RunInfrastructureAttempts(abortedD108),
        resultTuple(...cutoverNotAdmitted),
        d108RunRetainedReservationCount(abortedD108)
    )
}

runBounded: (
    plan,
    filesystem,
    executorAsync,
    inspectorExecutorAsync,
    maxInFlight
) => {
    runBoundedWithLoader(
        plan,
        (spec) => { readSource(spec, filesystem) },
        executorAsync,
        inspectorExecutorAsync,
        maxInFlight
    )
}

runSimple: (plan, filesystem, executor, inspectorExecutor) => {
    runSimpleWithLoader(
        plan,
        (spec) => { readSource(spec, filesystem) },
        executor,
        inspectorExecutor
    )
}
