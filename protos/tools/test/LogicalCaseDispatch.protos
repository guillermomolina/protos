//! TOOL009-B current logical-only Case dispatch.
//!
//! Repository production is logical-only: every corpus's TestPlan is
//! suite-native. This module owns the two pieces of glue Main.protos needs to
//! turn one already-discovered suite-native spec into an executable logical
//! Case: projecting its inert source association, and resolving its D125
//! ExecutionRequirementId to the bound suite-native execution route at the
//! LogicalCaseRunner executorAsync boundary.

Manifest: import("self:Manifest")

dispatchError: () => {
    Error().signal()
}

// TOOL009 Package Non-TOML Publication 2: a project-tree suite-native spec's
// D133 CaseAuthority descriptor travels as a third sourceAssociation element.
// Distinct project identities sharing one fixture sourcePath therefore remain
// distinct source associations rather than collapsing into one logical
// record; project identity is not obsolete once suite-native.
sourceAssociation: (corpusId, spec) => {
    String.recognizes(corpusId).ifFalse(() => {
        dispatchError()
    })
    (corpusId == "").ifTrue(() => {
        dispatchError()
    })

    descriptor: Manifest.caseAuthorityDescriptor(spec)

    association:
        Array(
            corpusId,
            Manifest.casePath(spec)
        )

    (descriptor === null).ifFalse(() => {
        association =
            Array(
                corpusId,
                Manifest.casePath(spec),
                descriptor
            )
    })

    association.freeze()
}

// TOOL009-D transport boundary.
//
// LogicalCasePlan/CasePlan entries stay inert and test-neutral (D152/D153):
// they carry a source association and a selector only, never a host
// execution requirement. The authoritative D125 ExecutionRequirementId for a
// logical Case instead lives on the SuiteGraph leaf that owns its corpus. This
// dispatcher resolves that requirement to its already-installed D125
// testExecutionRequirementBindings entry only at the LogicalCaseRunner
// executorAsync boundary, so no guest Case ever observes host execution
// infrastructure and no parallel requirement registry is introduced.
//
// corpusExecutionRequirements maps corpusId -> ExecutionRequirementId, built
// once by the caller from the resolved SuiteGraph leaves. A requirement whose
// binding has no suite-native logical Case execution route yet fails closed
// rather than silently falling back to a different requirement's mechanics.
logicalCaseExecutorAsync: (
    corpusExecutionRequirements,
    testExecutionRequirementBindings
) => {
    (sourceAssociation, source, signature, selector) => {
        // A third element, when present, is the D133 project-tree CaseAuthority
        // descriptor. This dispatcher does not decode it; it forwards
        // sourceAssociation intact to the bound execution requirement's
        // logicalCaseExecutionAsync, which is the sole authority that decodes
        // and provisions it.
        (
            (sourceAssociation.size() == 2) ||
            (sourceAssociation.size() == 3)
        ).ifFalse(() => {
            dispatchError()
        })

        corpusId: sourceAssociation[0]

        corpusExecutionRequirements.containsKey(corpusId).ifFalse(() => {
            dispatchError()
        })

        requirementId: corpusExecutionRequirements[corpusId]

        testExecutionRequirementBindings.hasSlot(requirementId).ifFalse(() => {
            dispatchError()
        })

        binding: testExecutionRequirementBindings.slotValue(requirementId)

        binding.hasSlot("logicalCaseExecutionAsync").ifFalse(() => {
            dispatchError()
        })

        binding.logicalCaseExecutionAsync(
            sourceAssociation,
            source,
            signature,
            selector
        )
    }
}
