Manifest: import("self:Manifest")
Runner: import("self:Runner")
Progress: import("self:Progress")
Options: import("self:Options")
ResourceCatalog: import("self:ResourceCatalog")
SuiteGraph: import("self:SuiteGraph")
RepositorySuite: import("self:RepositorySuite")
RepositoryCorpusPlans: import("self:RepositoryCorpusPlans")

arguments: process.args()
jobs: Options.jobs(arguments)
resourceCatalogPath: Options.resourceCatalogPath(arguments)

resourceCatalog: ResourceCatalog.empty()
(resourceCatalogPath === null).ifFalse(() => {
    resourceCatalogBytes: catalogAcquirer(resourceCatalogPath)
    resourceCatalogText: Encoding.UTF8.decode(resourceCatalogBytes)
    resourceCatalog = ResourceCatalog.parse(resourceCatalogText)
})

progressWriter:
    TextWriter(process.stderr(), process.stderrEncoding())

emitProgress: (line) => {
    progressWriter.writeLine(line).value()
    null
}

progressPhases: Array()

startProgress: (phaseName, phasePlan) => {
    state: Progress.beginPlan(
        phaseName,
        phasePlan,
        emitProgress
    )
    progressPhases = Array(...progressPhases, state)
    state
}

// Presentation stays separate from D123 SuiteId, D126 CorpusId and D125
// ExecutionRequirementId authority. These four historical labels are retained
// only for exact output compatibility while execution order comes from the graph.
phaseNames: Array(
    "main",
    "process-snapshot",
    "actor",
    "group",
    "package-toml",
    "uri",
    "csv",
    "cli",
    "math-integer",
    "crypto-sha256",
    "network-ip-addresses",
    "network-ip-endpoints",
    "package-tool-version",
    "package-tool-lock",
    "package-tool-resolution-input",
    "package-tool-resolution-root",
    "package-tool-execution-plan",
    "package-tool-project-projection"
)
phaseNames.freeze()

leaves: SuiteGraph.flattenLeaves(RepositorySuite.root)
(leaves.size() == phaseNames.size()).ifFalse(() => {
    Error().signal()
})

// D126/D125: resolve and validate the complete invocation corpus + execution
// binding set before any TestPlan case may be scheduled. SuiteId selects neither
// source authority nor host execution route.
resolvedSuites: Array()
resolveIndex: 0
(() => resolveIndex < leaves.size()).while() {
    leaf: leaves[resolveIndex]
    corpus: leaf.corpus
    requirement: leaf.executionRequirement

    testCorpusBindings.hasSlot(corpus).ifFalse(() => {
        Error().signal()
    })
    corpusBinding: testCorpusBindings.slotValue(corpus)
    Array(
        "filesystem",
        "planLoader"
    ).each((slotName) => {
        corpusBinding.hasSlot(slotName).ifFalse(() => {
            Error().signal()
        })
    })

    planLoader: corpusBinding.planLoader
    supportedLoader: planLoader === "manifest"
    (planLoader === "package-toml").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        supportedLoader = true
        // D132: the CorpusBinding supplies the explicit logical case
        // namespace; a case-outcomes binding without one fails closed
        // before scheduling.
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
    })
    (planLoader === "project-tree").ifTrue(() => {
        supportedLoader = true
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
        corpusBinding.hasSlot("caseAuthorityExecutionAsync").ifFalse(() => {
            Error().signal()
        })
    })
    supportedLoader.ifFalse(() => {
        Error().signal()
    })

    testExecutionRequirementBindings.hasSlot(requirement).ifFalse(() => {
        Error().signal()
    })
    binding: testExecutionRequirementBindings.slotValue(requirement)
    binding.hasSlot("executionAsync").ifFalse(() => {
        Error().signal()
    })

    resolved: {
        leaf: leaf
        phaseName: phaseNames[resolveIndex]
        corpusBinding: corpusBinding
        binding: binding
    }
    resolved.freeze()
    resolvedSuites = Array(...resolvedSuites, resolved)
    resolveIndex = resolveIndex + 1
}
resolvedSuites.freeze()

// D126: materialize every current TestPlan through its CorpusBinding before
// scheduling begins. Loader/source mechanics never come from ExecutionBinding.
plannedSuites: Array()
planIndex: 0
(() => planIndex < resolvedSuites.size()).while() {
    resolved: resolvedSuites[planIndex]
    corpusBinding: resolved.corpusBinding
    planLoader: corpusBinding.planLoader
    suitePlan: null

    (planLoader === "manifest").ifTrue(() => {
        suitePlan = Manifest.load(corpusBinding.filesystem)
    })
    (planLoader === "package-toml").ifTrue(() => {
        suitePlan = Manifest.loadPackageToml(corpusBinding.filesystem)
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        suitePlan = RepositoryCorpusPlans.load(resolved.leaf.corpus)
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        suitePlan = Manifest.loadCaseOutcomes(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (planLoader === "project-tree").ifTrue(() => {
        suitePlan = Manifest.loadProjectTreeCases(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (suitePlan === null).ifTrue(() => {
        Error().signal()
    })

    planned: {
        leaf: resolved.leaf
        phaseName: resolved.phaseName
        corpusBinding: corpusBinding
        binding: resolved.binding
        plan: suitePlan
    }
    planned.freeze()
    plannedSuites = Array(...plannedSuites, planned)
    planIndex = planIndex + 1
}
plannedSuites.freeze()

completedRuns: Array()
primaryRun: null
finalOutcome: null
invocationAborted: false

suiteIndex: 0
(() =>
    (suiteIndex < plannedSuites.size()) &&
    invocationAborted.not()
).while() {
    planned: plannedSuites[suiteIndex]
    corpusBinding: planned.corpusBinding
    binding: planned.binding
    suiteProgress: startProgress(planned.phaseName, planned.plan)

    caseAuthorityExecutorAsync: null
    corpusBinding.hasSlot("caseAuthorityExecutionAsync").ifTrue(() => {
        caseAuthorityExecutorAsync =
            corpusBinding.caseAuthorityExecutionAsync
    })

    executionInspectAsync: null
    binding.hasSlot("executionInspectAsync").ifTrue(() => {
        executionInspectAsync = binding.executionInspectAsync
    })

    resourceExecutionAsync: null
    binding.hasSlot("resourceExecutionAsync").ifTrue(() => {
        resourceExecutionAsync = binding.resourceExecutionAsync
    })

    resourceExecutionInspectAsync: null
    binding.hasSlot("resourceExecutionInspectAsync").ifTrue(() => {
        resourceExecutionInspectAsync =
            binding.resourceExecutionInspectAsync
    })

    suiteD108: Runner.runD108WithResources(
        planned.plan,
        resourceCatalog,
        corpusBinding.filesystem,
        binding.executionAsync,
        executionInspectAsync,
        resourceExecutionAsync,
        resourceExecutionInspectAsync,
        jobs,
        Progress.observer(suiteProgress),
        caseAuthorityExecutorAsync
    )

    infrastructureFailed:
        Runner.d108RunInfrastructureFailed(suiteD108)

    Progress.finishPhase(
        suiteProgress,
        infrastructureFailed
    )

    infrastructureFailed.ifTrue(() => {
        laterPlans: Array()
        laterIndex: suiteIndex + 1
        (() => laterIndex < plannedSuites.size()).while() {
            laterPlans = Array(
                ...laterPlans,
                plannedSuites[laterIndex].plan
            )
            laterIndex = laterIndex + 1
        }

        finalOutcome =
            Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
                completedRuns,
                suiteD108,
                laterPlans
            )
        invocationAborted = true
    })

    infrastructureFailed.ifFalse(() => {
        healthyRun: Runner.d108RunHealthyRun(suiteD108)
        completedRuns = Array(...completedRuns, healthyRun)
        (primaryRun === null).ifTrue(() => {
            primaryRun = healthyRun
        })
    })

    suiteIndex = suiteIndex + 1
}

invocationAborted.not().ifTrue(() => {
    finalOutcome =
        Runner.testRunOutcomeCompletedAcrossRuns(
            primaryRun,
            completedRuns
        )
})

Progress.finishInvocation(
    progressPhases,
    Runner.testRunOutcomeStatus(finalOutcome),
    emitProgress
)

writer: TextWriter(process.stdout(), process.stdoutEncoding())
writer.writeLine("Protos test tool bootstrap").value()
writer.writeLine(process.args()[0]).value()

finalOutcome
