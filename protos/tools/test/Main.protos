Manifest: import("self:Manifest")
Runner: import("self:Runner")
Progress: import("self:Progress")
Options: import("self:Options")
FileSelection: import("self:FileSelection")
ResourceCatalog: import("self:ResourceCatalog")
ResourceRequirements: import("self:ResourceRequirements")
SuiteGraph: import("self:SuiteGraph")
RepositorySuite: import("self:RepositorySuite")
RepositoryCorpusPlans: import("self:RepositoryCorpusPlans")
Discovery: import("self:Discovery")
CasePlan: import("self:LogicalCasePlan")
LogicalCaseRunner: import("self:LogicalCaseRunner")
LogicalCaseResult: import("self:LogicalCaseResult")
LogicalCaseDispatch: import("self:LogicalCaseDispatch")

arguments: process.args()
jobs: Options.jobs(arguments)
resourceCatalogPath: Options.resourceCatalogPath(arguments)
filePaths: Options.filePaths(arguments)
directoryPaths: Options.directoryPaths(arguments)

resourceCatalog: ResourceCatalog.empty()
(resourceCatalogPath === null).ifFalse(() => {
    resourceCatalogBytes: catalogAcquirer(resourceCatalogPath)
    resourceCatalogText: Encoding.UTF8.decode(resourceCatalogBytes)
    resourceCatalog = ResourceCatalog.parse(resourceCatalogText)
})

progressWriter:
    TextWriter(process.stderr(), process.stderrEncoding())

emitProgress: (line) => {
    progressWriter.writeLine(line).value()
    null
}

progressPhases: Array()

startProgress: (
    phaseName,
    totalLogicalCases
) => {
    state: Progress.begin(
        phaseName,
        totalLogicalCases,
        emitProgress
    )
    progressPhases = Array(...progressPhases, state)
    state
}

// Presentation stays separate from D123 SuiteId, D126 CorpusId and D125
// ExecutionRequirementId authority. These four historical labels are retained
// only for exact output compatibility while execution order comes from the graph.
phaseNames: Array(
    "main",
    "process-snapshot",
    "actor",
    "group",
    "package-toml",
    "uri",
    "csv",
    "cli",
    "math-integer",
    "crypto-sha256",
    "network-ip-addresses",
    "network-ip-endpoints",
    "package-tool-version",
    "package-tool-lock",
    "package-tool-resolution-input",
    "package-tool-content-identity",
    "package-tool-resolution-input-lock",
    "package-tool-resolution-root",
    "package-tool-execution-plan",
    "package-tool-project-projection"
)
phaseNames.freeze()

leaves: SuiteGraph.flattenLeaves(RepositorySuite.root)
(leaves.size() == phaseNames.size()).ifFalse(() => {
    Error().signal()
})

// D126/D125: resolve and validate the complete invocation corpus + execution
// binding set before any TestPlan case may be scheduled. SuiteId selects neither
// source authority nor host execution route.
resolvedSuites: Array()
resolveIndex: 0
(() => resolveIndex < leaves.size()).while() {
    leaf: leaves[resolveIndex]
    corpus: leaf.corpus
    requirement: leaf.executionRequirement

    testCorpusBindings.hasSlot(corpus).ifFalse(() => {
        Error().signal()
    })
    corpusBinding: testCorpusBindings.slotValue(corpus)
    Array(
        "filesystem",
        "planLoader"
    ).each((slotName) => {
        corpusBinding.hasSlot(slotName).ifFalse(() => {
            Error().signal()
        })
    })

    planLoader: corpusBinding.planLoader
    supportedLoader: planLoader === "manifest"
    (planLoader === "package-toml").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        supportedLoader = true
        // D132: the CorpusBinding supplies the explicit logical case
        // namespace; a case-outcomes binding without one fails closed
        // before scheduling.
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
    })
    (planLoader === "project-tree").ifTrue(() => {
        supportedLoader = true
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
    })
    supportedLoader.ifFalse(() => {
        Error().signal()
    })

    testExecutionRequirementBindings.hasSlot(requirement).ifFalse(() => {
        Error().signal()
    })
    binding: testExecutionRequirementBindings.slotValue(requirement)
    binding.hasSlot("executionAsync").ifFalse(() => {
        Error().signal()
    })

    resolved: {
        leaf: leaf
        phaseName: phaseNames[resolveIndex]
        corpusBinding: corpusBinding
        binding: binding
    }
    resolved.freeze()
    resolvedSuites = Array(...resolvedSuites, resolved)
    resolveIndex = resolveIndex + 1
}
resolvedSuites.freeze()

// D126: materialize every current TestPlan through its CorpusBinding before
// scheduling begins. Loader/source mechanics never come from ExecutionBinding.
plannedSuites: Array()
planIndex: 0
(() => planIndex < resolvedSuites.size()).while() {
    resolved: resolvedSuites[planIndex]
    corpusBinding: resolved.corpusBinding
    planLoader: corpusBinding.planLoader
    suitePlan: null

    (planLoader === "manifest").ifTrue(() => {
        suitePlan = Manifest.load(corpusBinding.filesystem)
    })
    (planLoader === "package-toml").ifTrue(() => {
        suitePlan = Manifest.loadPackageToml(corpusBinding.filesystem)
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        suitePlan = RepositoryCorpusPlans.load(resolved.leaf.corpus)
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        suitePlan = Manifest.loadCaseOutcomes(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (planLoader === "project-tree").ifTrue(() => {
        suitePlan = Manifest.loadProjectTreeCases(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (suitePlan === null).ifTrue(() => {
        Error().signal()
    })

    resourceRequirementsApplies: planLoader === "manifest"
    (planLoader === "package-toml").ifTrue(() => {
        resourceRequirementsApplies = true
    })
    resourceRequirementsApplies.ifTrue(() => {
        suitePlan = ResourceRequirements.loadFromCorpus(
            corpusBinding.filesystem,
            suitePlan
        )
    })

    planned: {
        leaf: resolved.leaf
        phaseName: resolved.phaseName
        corpusBinding: corpusBinding
        binding: resolved.binding
        plan: suitePlan
    }
    planned.freeze()
    plannedSuites = Array(...plannedSuites, planned)
    planIndex = planIndex + 1
}
plannedSuites.freeze()

// TOOL009 selection remains a projection over fully materialized authoritative
// TestPlans. Host resolver output supplies only logical source associations;
// neither file nor directory selection performs filesystem test discovery.
selectorMatchesAnyPlan: (
    selectedFileAssociations,
    selectedDirectoryAssociations
) => {
    matched: false

    plannedSuites.each((planned) => {
        FileSelection.planHasMatch(
            planned.leaf.corpus,
            planned.plan,
            selectedFileAssociations,
            selectedDirectoryAssociations
        ).ifTrue(() => {
            matched = true
        })
    })

    matched
}

fileAssociations: []
filePaths.each((filePath) => {
    resolvedAssociations: fileSourceResolver(filePath)

    selectorMatchesAnyPlan(
        resolvedAssociations,
        []
    ).ifFalse(() => {
        Error().signal()
    })

    fileAssociations = [
        ...fileAssociations,
        ...resolvedAssociations
    ]
})
fileAssociations.freeze()

directoryAssociations: []
directoryPaths.each((directoryPath) => {
    resolvedAssociations:
        directorySourceResolver(directoryPath)

    selectorMatchesAnyPlan(
        [],
        resolvedAssociations
    ).ifFalse(() => {
        Error().signal()
    })

    directoryAssociations = [
        ...directoryAssociations,
        ...resolvedAssociations
    ]
})
directoryAssociations.freeze()

selectorsActive:
    (filePaths.size() > 0) ||
    (directoryPaths.size() > 0)

// Unfiltered execution retains the exact pre-selection TestPlan set.
executionSuites: plannedSuites

selectorsActive.ifTrue(() => {
    selectedSuites: []

    plannedSuites.each((planned) => {
        selectedPlan:
            FileSelection.selectPlanWithDirectories(
                planned.leaf.corpus,
                planned.plan,
                fileAssociations,
                directoryAssociations
            )

        (Manifest.planCases(selectedPlan).size() > 0).ifTrue(() => {
            selected: {
                leaf: planned.leaf
                phaseName: planned.phaseName
                corpusBinding: planned.corpusBinding
                binding: planned.binding
                plan: selectedPlan
            }
            selected.freeze()
            selectedSuites = [
                ...selectedSuites,
                selected
            ]
        })
    })

    // Every explicit selector was already required to match independently.
    // Retain this as a fail-closed aggregate invariant before progress or
    // scheduling begins.
    (selectedSuites.size() == 0).ifTrue(() => {
        Error().signal()
    })

    selectedSuites.freeze()
    executionSuites = selectedSuites
})

// TOOL009-B: repository production is logical-only. Every corpus's TestPlan is
// required to be suite-native; there is no legacy CaseSpec partition, no D108
// repository execution branch and no legacy/logical outcome merge. A plan
// carrying anything other than a suite-native Case fails closed here rather
// than falling back to D108.
logicalExecutionSuites: Array()
logicalProjections: Array()
logicalCaseMetadata: Array()
logicalSourceSpecs: Map()

// TOOL009-D: the D125 ExecutionRequirementId a logical Case must execute
// under is authoritative on its SuiteGraph leaf, not on the inert CasePlan
// entry produced by discovery. Recording it here by corpusId lets the single
// flat LogicalCaseRunner.run() call below still dispatch each Case to its
// own corpus's execution requirement.
corpusExecutionRequirements: Map()

executionSuiteIndex: 0
executionSuites.each((planned) => {
    corpusExecutionRequirements[planned.leaf.corpus] =
        planned.leaf.executionRequirement

    logicalCaseCount: 0

    Manifest.planCases(planned.plan).each((spec) => {
        (Manifest.caseExpectation(spec) == "suite-native").ifFalse(() => {
            Error().signal()
        })

        // D153 case-environment provisioning remains separately deferred for
        // D077 resource requirements: a suite-native Case may still carry
        // none of those. TOOL009 Package Non-TOML Publication 2 additionally
        // permits a well-formed D133 project-tree CaseAuthority descriptor to
        // accompany a suite-native spec; the descriptor travels onward
        // through sourceAssociation below rather than being rejected here.
        (Manifest.caseRequirements(spec).size() == 0).ifFalse(() => {
            Error().signal()
        })

        descriptor: Manifest.caseAuthorityDescriptor(spec)
        (descriptor === null).ifFalse(() => {
            (Manifest.caseAuthorityKind(descriptor) == "project-tree").ifFalse(() => {
                Error().signal()
            })
            (Manifest.caseAuthorityIsolation(descriptor) == "case").ifFalse(() => {
                Error().signal()
            })
            (Manifest.caseAuthorityLifecycle(descriptor) == "case").ifFalse(() => {
                Error().signal()
            })
        })

        corpusId: planned.leaf.corpus
        sourcePath: Manifest.casePath(spec)

        // TOOL009 Package Non-TOML Publication 2: distinct project-tree
        // project identities may reuse the same fixture source path value.
        // The per-corpus source-spec lookup is therefore keyed by that
        // source path and then by fixtureKey ("" when the spec carries no
        // D133 CaseAuthority descriptor, otherwise the descriptor's fixture
        // identity), so distinct authorities never collapse into one
        // logical record.
        fixtureKey: ""
        (descriptor === null).ifFalse(() => {
            fixtureKey = Manifest.caseAuthorityFixtureIdentity(descriptor)
        })

        corpusSpecs: null

        logicalSourceSpecs.containsKey(corpusId).ifTrue(() => {
            corpusSpecs = logicalSourceSpecs[corpusId]
        })

        logicalSourceSpecs.containsKey(corpusId).ifFalse(() => {
            corpusSpecs = Map()
            logicalSourceSpecs[corpusId] = corpusSpecs
        })

        sourceSpecs: null

        corpusSpecs.containsKey(sourcePath).ifTrue(() => {
            sourceSpecs = corpusSpecs[sourcePath]
        })

        corpusSpecs.containsKey(sourcePath).ifFalse(() => {
            sourceSpecs = Map()
            corpusSpecs[sourcePath] = sourceSpecs
        })

        sourceSpecs.containsKey(fixtureKey).ifTrue(() => {
            Error().signal()
        })
        sourceSpecs[fixtureKey] = spec

        association:
            LogicalCaseDispatch.sourceAssociation(
                corpusId,
                spec
            )

        discoverySource:
            Runner.readSource(
                spec,
                planned.corpusBinding.filesystem
            )

        projection:
            logicalCaseDiscovery(
                association,
                discoverySource
            )

        projectionCases:
            Discovery.projectionPlan(
                projection
            )

        // A suite-native Case must transfer at least one logical Case.
        (projectionCases.size() == 0).ifTrue(() => {
            Error().signal()
        })

        logicalProjections =
            Array(
                ...logicalProjections,
                projection
            )

        projectionCases.each((ignored) => {
            metadata:
                Array(
                    executionSuiteIndex,
                    spec
                )
            metadata.freeze()

            logicalCaseMetadata =
                Array(
                    ...logicalCaseMetadata,
                    metadata
                )

            logicalCaseCount =
                logicalCaseCount + 1
        })
    })

    suite: {
        leaf: planned.leaf
        phaseName: planned.phaseName
        corpusBinding: planned.corpusBinding
        binding: planned.binding
        logicalCaseCount: logicalCaseCount
    }
    suite.freeze()

    logicalExecutionSuites =
        Array(
            ...logicalExecutionSuites,
            suite
        )

    executionSuiteIndex =
        executionSuiteIndex + 1
})

logicalExecutionSuites.freeze()
logicalProjections.freeze()
logicalCaseMetadata.freeze()
executionSuites = logicalExecutionSuites

logicalResults: Array()
logicalResults.freeze()

// D174: lifecycle observation exists before suite-native Case execution.
// Presentation policy is deliberately separate and remains unchanged here.
//
// D176: `caseLifecycleSink` is the Test-Tool-internal host watchdog. It owns
// the stalled in-flight diagnostic entirely, so normal Tool output stays the
// compact D120 aggregate progress above.
invocationLifecycle:
    Progress.beginLifecycle(
        caseLifecycleSink
    )

logicalCaseDisplayReference: (entry) => {
    association:
        CasePlan.sourceAssociation(entry)

    reference:
        association[0] + ":" +
        association[1] + "::" +
        CasePlan.selector(entry)

    reference
}

logicalLifecycleObserver:
    Progress.lifecycleObserver(
        invocationLifecycle,
        logicalCaseDisplayReference
    )

(logicalProjections.size() > 0).ifTrue(() => {
    logicalCompletions:
        LogicalCaseRunner.run(
            logicalProjections,
            (entry) => {
                association:
                    CasePlan.sourceAssociation(
                        entry
                    )

                (
                    (association.size() == 2) ||
                    (association.size() == 3)
                ).ifFalse(() => {
                    Error().signal()
                })

                corpusId: association[0]
                sourcePath: association[1]

                String.recognizes(corpusId).ifFalse(() => {
                    Error().signal()
                })
                String.recognizes(sourcePath).ifFalse(() => {
                    Error().signal()
                })

                // TOOL009 Package Non-TOML Publication 2: reconstruct the same
                // fixtureKey the discovery-time lookup was stored under.
                fixtureKey: ""
                (association.size() == 3).ifTrue(() => {
                    fixtureKey =
                        Manifest.caseAuthorityFixtureIdentity(
                            association[2]
                        )
                })

                logicalSourceSpecs.containsKey(corpusId).ifFalse(() => {
                    Error().signal()
                })

                corpusSpecs:
                    logicalSourceSpecs[corpusId]

                corpusSpecs.containsKey(sourcePath).ifFalse(() => {
                    Error().signal()
                })

                sourceSpecs:
                    corpusSpecs[sourcePath]

                sourceSpecs.containsKey(fixtureKey).ifFalse(() => {
                    Error().signal()
                })

                testCorpusBindings.hasSlot(corpusId).ifFalse(() => {
                    Error().signal()
                })

                sourceBinding:
                    testCorpusBindings.slotValue(
                        corpusId
                    )

                // Re-read immediately before each fresh Process execution.
                // Discovery source text is deliberately not cached across the
                // D153 rematerialization boundary.
                Runner.readSource(
                    sourceSpecs[fixtureKey],
                    sourceBinding.filesystem
                )
            },
            LogicalCaseDispatch.logicalCaseExecutorAsync(
                corpusExecutionRequirements,
                testExecutionRequirementBindings
            ),
            jobs,
            logicalLifecycleObserver
        ).value()

    logicalResults =
        LogicalCaseResult.projectAll(
            logicalCompletions
        )
})

(Progress.inFlightCount(invocationLifecycle) == 0).ifFalse(() => {
    Error().signal()
})

(logicalResults.size() == logicalCaseMetadata.size()).ifFalse(() => {
    Error().signal()
})

logicalResultsBySuite: Array()
executionSuites.each((ignored) => {
    logicalResultsBySuite =
        Array(
            ...logicalResultsBySuite,
            Array()
        )
})

logicalResultIndex: 0
logicalResults.each((result) => {
    metadata:
        logicalCaseMetadata[
            logicalResultIndex
        ]

    targetSuiteIndex: metadata[0]
    spec: metadata[1]

    pair: Array(spec, result)
    pair.freeze()

    logicalResultsBySuite[targetSuiteIndex] =
        Array(
            ...logicalResultsBySuite[targetSuiteIndex],
            pair
        )

    logicalResultIndex =
        logicalResultIndex + 1
})

logicalResultsBySuite.each((group) => {
    group.freeze()
})
logicalResultsBySuite.freeze()

suiteIndex: 0
(() => suiteIndex < executionSuites.size()).while() {
    planned: executionSuites[suiteIndex]
    suiteProgress:
        startProgress(
            planned.phaseName,
            planned.logicalCaseCount
        )

    suiteInfrastructureFailed: false
    logicalObserver:
        Progress.observer(
            suiteProgress
        )

    logicalResultsBySuite[suiteIndex].each((pair) => {
        spec: pair[0]
        logicalResult: pair[1]

        classification:
            LogicalCaseResult.classification(
                logicalResult
            )

        evaluation: null
        resultInfrastructureFailed: false

        (classification == "pass").ifTrue(() => {
            evaluation =
                Runner.resultTuple(
                    true,
                    null
                )
        })

        (classification == "fail").ifTrue(() => {
            evaluation =
                Runner.resultTuple(
                    false,
                    null
                )
        })

        (classification == "tool-error").ifTrue(() => {
            resultInfrastructureFailed = true
            suiteInfrastructureFailed = true
        })

        logicalObserver(
            spec,
            evaluation,
            resultInfrastructureFailed
        )
    })

    Progress.finishPhase(
        suiteProgress,
        suiteInfrastructureFailed
    )

    suiteIndex = suiteIndex + 1
}

(Progress.inFlightCount(invocationLifecycle) == 0).ifFalse(() => {
    Error().signal()
})

// D155 precedence, derived solely from the current Logical Case result
// projection: any tool error => infrastructure-aborted/3; otherwise any guest
// failure => completed/1; otherwise completed/0.
logicalExitCode: LogicalCaseResult.exitCode(logicalResults)

finalOutcome: null

(logicalExitCode == 3).ifTrue(() => {
    finalOutcome =
        Runner.testRunOutcome(
            "infrastructure-aborted",
            null,
            null,
            3
        )
})

(logicalExitCode == 3).ifFalse(() => {
    finalOutcome =
        Runner.testRunOutcomeCompletedWithExit(
            null,
            logicalExitCode
        )
})

Progress.finishInvocation(
    progressPhases,
    Runner.testRunOutcomeStatus(finalOutcome),
    emitProgress
)

writer: TextWriter(process.stdout(), process.stdoutEncoding())
writer.writeLine("Protos test tool bootstrap").value()
writer.writeLine(process.args()[0]).value()

finalOutcome
