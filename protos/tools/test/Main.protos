Manifest: import("self:Manifest")
Runner: import("self:Runner")
Progress: import("self:Progress")
Options: import("self:Options")
ResourceCatalog: import("self:ResourceCatalog")

arguments: process.args()
jobs: Options.jobs(arguments)
resourceCatalogPath: Options.resourceCatalogPath(arguments)

resourceCatalog: ResourceCatalog.empty()
(resourceCatalogPath === null).ifFalse(() => {
    resourceCatalogBytes: catalogAcquirer(resourceCatalogPath)
    resourceCatalogText: Encoding.UTF8.decode(resourceCatalogBytes)
    resourceCatalog = ResourceCatalog.parse(resourceCatalogText)
})

plan: Manifest.load(filesystem)
packageTomlPlan: Manifest.loadPackageToml(packageTomlFilesystem)
actorPlan: Manifest.load(actorFilesystem)
groupPlan: Manifest.load(groupFilesystem)

progressWriter:
    TextWriter(process.stderr(), process.stderrEncoding())

emitProgress: (line) => {
    progressWriter.writeLine(line).value()
    null
}

progressPhases: Array()

startProgress: (phaseName, phasePlan) => {
    state: Progress.beginPlan(
        phaseName,
        phasePlan,
        emitProgress
    )
    progressPhases = Array(...progressPhases, state)
    state
}

completedRuns: Array()
primaryRun: null
finalOutcome: null
invocationAborted: false

primaryProgress: startProgress("main", plan)

primaryD108: Runner.runD108WithResources(
    plan,
    resourceCatalog,
    filesystem,
    executionAsync,
    executionInspectAsync,
    resourceExecutionAsync,
    resourceExecutionInspectAsync,
    jobs,
    Progress.observer(primaryProgress)
)

Progress.finishPhase(
    primaryProgress,
    Runner.d108RunInfrastructureFailed(primaryD108)
)

Runner.d108RunInfrastructureFailed(primaryD108).ifTrue(() => {
    finalOutcome =
        Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
            completedRuns,
            primaryD108,
            Array(actorPlan, groupPlan, packageTomlPlan)
        )
    invocationAborted = true
})

invocationAborted.not().ifTrue(() => {
    primaryRun = Runner.d108RunHealthyRun(primaryD108)
    completedRuns = Array(...completedRuns, primaryRun)

    actorProgress: startProgress("actor", actorPlan)

    actorD108: Runner.runD108WithResources(
        actorPlan,
        resourceCatalog,
        actorFilesystem,
        actorExecutionAsync,
        actorExecutionInspectAsync,
        actorResourceExecutionAsync,
        actorResourceExecutionInspectAsync,
        jobs,
        Progress.observer(actorProgress)
    )

    Progress.finishPhase(
        actorProgress,
        Runner.d108RunInfrastructureFailed(actorD108)
    )

    Runner.d108RunInfrastructureFailed(actorD108).ifTrue(() => {
        finalOutcome =
            Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
                completedRuns,
                actorD108,
                Array(groupPlan, packageTomlPlan)
            )
        invocationAborted = true
    })

    invocationAborted.not().ifTrue(() => {
        actorRun: Runner.d108RunHealthyRun(actorD108)
        completedRuns = Array(...completedRuns, actorRun)

        groupProgress: startProgress("group", groupPlan)

        groupD108: Runner.runD108WithResources(
            groupPlan,
            resourceCatalog,
            groupFilesystem,
            groupExecutionAsync,
            groupExecutionInspectAsync,
            groupResourceExecutionAsync,
            groupResourceExecutionInspectAsync,
            jobs,
            Progress.observer(groupProgress)
        )

        Progress.finishPhase(
            groupProgress,
            Runner.d108RunInfrastructureFailed(groupD108)
        )

        Runner.d108RunInfrastructureFailed(groupD108).ifTrue(() => {
            finalOutcome =
                Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
                    completedRuns,
                    groupD108,
                    Array(packageTomlPlan)
                )
            invocationAborted = true
        })

        invocationAborted.not().ifTrue(() => {
            groupRun: Runner.d108RunHealthyRun(groupD108)
            completedRuns = Array(...completedRuns, groupRun)

            packageTomlProgress:
                startProgress("package-toml", packageTomlPlan)

            packageTomlD108: Runner.runD108WithResources(
                packageTomlPlan,
                resourceCatalog,
                packageTomlFilesystem,
                packageExecutionAsync,
                packageExecutionInspectAsync,
                packageResourceExecutionAsync,
                packageResourceExecutionInspectAsync,
                jobs,
                Progress.observer(packageTomlProgress)
            )

            Progress.finishPhase(
                packageTomlProgress,
                Runner.d108RunInfrastructureFailed(packageTomlD108)
            )

            Runner.d108RunInfrastructureFailed(packageTomlD108).ifTrue(() => {
                finalOutcome =
                    Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
                        completedRuns,
                        packageTomlD108,
                        Array()
                    )
                invocationAborted = true
            })

            invocationAborted.not().ifTrue(() => {
                packageTomlRun:
                    Runner.d108RunHealthyRun(packageTomlD108)
                completedRuns =
                    Array(...completedRuns, packageTomlRun)

                finalOutcome =
                    Runner.testRunOutcomeCompletedAcrossRuns(
                        primaryRun,
                        completedRuns
                    )
            })
        })
    })
})

Progress.finishInvocation(
    progressPhases,
    Runner.testRunOutcomeStatus(finalOutcome),
    emitProgress
)

writer: TextWriter(process.stdout(), process.stdoutEncoding())
writer.writeLine("Protos test tool bootstrap")
writer.writeLine(process.args()[0])

finalOutcome
