Manifest: import("self:Manifest")
Runner: import("self:Runner")
Progress: import("self:Progress")
Options: import("self:Options")
FileSelection: import("self:FileSelection")
ResourceCatalog: import("self:ResourceCatalog")
ResourceRequirements: import("self:ResourceRequirements")
SuiteGraph: import("self:SuiteGraph")
RepositorySuite: import("self:RepositorySuite")
RepositoryCorpusPlans: import("self:RepositoryCorpusPlans")
Discovery: import("self:Discovery")
CasePlan: import("self:LogicalCasePlan")
LogicalCaseRunner: import("self:LogicalCaseRunner")
LogicalCaseResult: import("self:LogicalCaseResult")
LogicalCaseMigration: import("self:LogicalCaseMigration")

arguments: process.args()
jobs: Options.jobs(arguments)
resourceCatalogPath: Options.resourceCatalogPath(arguments)
filePath: Options.filePath(arguments)

resourceCatalog: ResourceCatalog.empty()
(resourceCatalogPath === null).ifFalse(() => {
    resourceCatalogBytes: catalogAcquirer(resourceCatalogPath)
    resourceCatalogText: Encoding.UTF8.decode(resourceCatalogBytes)
    resourceCatalog = ResourceCatalog.parse(resourceCatalogText)
})

progressWriter:
    TextWriter(process.stderr(), process.stderrEncoding())

emitProgress: (line) => {
    progressWriter.writeLine(line).value()
    null
}

progressPhases: Array()

startProgress: (
    phaseName,
    phasePlan,
    additionalLogicalCases
) => {
    state: Progress.begin(
        phaseName,
        Progress.selectedCount(phasePlan) +
            additionalLogicalCases,
        emitProgress
    )
    progressPhases = Array(...progressPhases, state)
    state
}

// Presentation stays separate from D123 SuiteId, D126 CorpusId and D125
// ExecutionRequirementId authority. These four historical labels are retained
// only for exact output compatibility while execution order comes from the graph.
phaseNames: Array(
    "main",
    "process-snapshot",
    "actor",
    "group",
    "package-toml",
    "uri",
    "csv",
    "cli",
    "math-integer",
    "crypto-sha256",
    "network-ip-addresses",
    "network-ip-endpoints",
    "package-tool-version",
    "package-tool-lock",
    "package-tool-resolution-input",
    "package-tool-content-identity",
    "package-tool-resolution-input-lock",
    "package-tool-resolution-root",
    "package-tool-execution-plan",
    "package-tool-project-projection"
)
phaseNames.freeze()

leaves: SuiteGraph.flattenLeaves(RepositorySuite.root)
(leaves.size() == phaseNames.size()).ifFalse(() => {
    Error().signal()
})

// D126/D125: resolve and validate the complete invocation corpus + execution
// binding set before any TestPlan case may be scheduled. SuiteId selects neither
// source authority nor host execution route.
resolvedSuites: Array()
resolveIndex: 0
(() => resolveIndex < leaves.size()).while() {
    leaf: leaves[resolveIndex]
    corpus: leaf.corpus
    requirement: leaf.executionRequirement

    testCorpusBindings.hasSlot(corpus).ifFalse(() => {
        Error().signal()
    })
    corpusBinding: testCorpusBindings.slotValue(corpus)
    Array(
        "filesystem",
        "planLoader"
    ).each((slotName) => {
        corpusBinding.hasSlot(slotName).ifFalse(() => {
            Error().signal()
        })
    })

    planLoader: corpusBinding.planLoader
    supportedLoader: planLoader === "manifest"
    (planLoader === "package-toml").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        supportedLoader = true
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        supportedLoader = true
        // D132: the CorpusBinding supplies the explicit logical case
        // namespace; a case-outcomes binding without one fails closed
        // before scheduling.
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
    })
    (planLoader === "project-tree").ifTrue(() => {
        supportedLoader = true
        corpusBinding.hasSlot("caseNamespace").ifFalse(() => {
            Error().signal()
        })
        corpusBinding.hasSlot("caseAuthorityExecutionAsync").ifFalse(() => {
            Error().signal()
        })
    })
    supportedLoader.ifFalse(() => {
        Error().signal()
    })

    testExecutionRequirementBindings.hasSlot(requirement).ifFalse(() => {
        Error().signal()
    })
    binding: testExecutionRequirementBindings.slotValue(requirement)
    binding.hasSlot("executionAsync").ifFalse(() => {
        Error().signal()
    })

    resolved: {
        leaf: leaf
        phaseName: phaseNames[resolveIndex]
        corpusBinding: corpusBinding
        binding: binding
    }
    resolved.freeze()
    resolvedSuites = Array(...resolvedSuites, resolved)
    resolveIndex = resolveIndex + 1
}
resolvedSuites.freeze()

// D126: materialize every current TestPlan through its CorpusBinding before
// scheduling begins. Loader/source mechanics never come from ExecutionBinding.
plannedSuites: Array()
planIndex: 0
(() => planIndex < resolvedSuites.size()).while() {
    resolved: resolvedSuites[planIndex]
    corpusBinding: resolved.corpusBinding
    planLoader: corpusBinding.planLoader
    suitePlan: null

    (planLoader === "manifest").ifTrue(() => {
        suitePlan = Manifest.load(corpusBinding.filesystem)
    })
    (planLoader === "package-toml").ifTrue(() => {
        suitePlan = Manifest.loadPackageToml(corpusBinding.filesystem)
    })
    (planLoader === "repository-explicit").ifTrue(() => {
        suitePlan = RepositoryCorpusPlans.load(resolved.leaf.corpus)
    })
    (planLoader === "case-outcomes").ifTrue(() => {
        suitePlan = Manifest.loadCaseOutcomes(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (planLoader === "project-tree").ifTrue(() => {
        suitePlan = Manifest.loadProjectTreeCases(
            corpusBinding.filesystem,
            corpusBinding.caseNamespace
        )
    })
    (suitePlan === null).ifTrue(() => {
        Error().signal()
    })

    resourceRequirementsApplies: planLoader === "manifest"
    (planLoader === "package-toml").ifTrue(() => {
        resourceRequirementsApplies = true
    })
    resourceRequirementsApplies.ifTrue(() => {
        suitePlan = ResourceRequirements.loadFromCorpus(
            corpusBinding.filesystem,
            suitePlan
        )
    })

    planned: {
        leaf: resolved.leaf
        phaseName: resolved.phaseName
        corpusBinding: corpusBinding
        binding: resolved.binding
        plan: suitePlan
    }
    planned.freeze()
    plannedSuites = Array(...plannedSuites, planned)
    planIndex = planIndex + 1
}
plannedSuites.freeze()

// D151: unfiltered execution retains the exact pre-selection TestPlan set.
// Only an explicit --file selector creates a filtered execution view.
executionSuites: plannedSuites

(filePath === null).ifFalse(() => {
    fileAssociations: fileSourceResolver(filePath)
    selectedSuites: Array()

    plannedSuites.each((planned) => {
        selectedPlan: FileSelection.selectPlan(
            planned.leaf.corpus,
            planned.plan,
            fileAssociations
        )

        (Manifest.planCases(selectedPlan).size() > 0).ifTrue(() => {
            selected: {
                leaf: planned.leaf
                phaseName: planned.phaseName
                corpusBinding: planned.corpusBinding
                binding: planned.binding
                plan: selectedPlan
            }
            selected.freeze()
            selectedSuites = Array(...selectedSuites, selected)
        })
    })

    // D151 zero-match is a selection/configuration error and therefore occurs
    // before progress state exists or any case reaches the scheduler.
    (selectedSuites.size() == 0).ifTrue(() => {
        Error().signal()
    })

    selectedSuites.freeze()
    executionSuites = selectedSuites
})

// D152 M2 temporary mixed-ownership bridge.
//
// Every suite-native source is removed from incumbent ownership before either
// runner is scheduled. D153 discovery for the complete selected suite-native
// set is completed first. The resulting logical Cases are then scheduled as
// one flat global plan, independent of the historical corpus/phase topology.
migrationExecutionSuites: Array()
logicalProjections: Array()
logicalCaseMetadata: Array()
logicalSourceSpecs: Map()

migrationSuiteIndex: 0
executionSuites.each((planned) => {
    split:
        LogicalCaseMigration.splitPlan(
            planned.plan
        )

    nativeSpecs:
        LogicalCaseMigration.suiteNativeSpecs(
            split
        )

    logicalCaseCount: 0

    nativeSpecs.each((spec) => {
        corpusId: planned.leaf.corpus
        sourcePath: Manifest.casePath(spec)

        corpusSpecs: null

        logicalSourceSpecs.containsKey(corpusId).ifTrue(() => {
            corpusSpecs = logicalSourceSpecs[corpusId]
        })

        logicalSourceSpecs.containsKey(corpusId).ifFalse(() => {
            corpusSpecs = Map()
            logicalSourceSpecs[corpusId] = corpusSpecs
        })

        corpusSpecs.containsKey(sourcePath).ifTrue(() => {
            Error().signal()
        })
        corpusSpecs[sourcePath] = spec

        sourceAssociation:
            LogicalCaseMigration.sourceAssociation(
                corpusId,
                spec
            )

        discoverySource:
            Runner.readSource(
                spec,
                planned.corpusBinding.filesystem
            )

        projection:
            logicalCaseDiscovery(
                sourceAssociation,
                discoverySource
            )

        projectionCases:
            Discovery.projectionPlan(
                projection
            )

        // A migration marker must transfer at least one logical Case. Otherwise
        // the bounded M2 change would silently leave the source with no owner.
        (projectionCases.size() == 0).ifTrue(() => {
            Error().signal()
        })

        logicalProjections =
            Array(
                ...logicalProjections,
                projection
            )

        projectionCases.each((ignored) => {
            metadata:
                Array(
                    migrationSuiteIndex,
                    spec
                )
            metadata.freeze()

            logicalCaseMetadata =
                Array(
                    ...logicalCaseMetadata,
                    metadata
                )

            logicalCaseCount =
                logicalCaseCount + 1
        })
    })

    migrated: {
        leaf: planned.leaf
        phaseName: planned.phaseName
        corpusBinding: planned.corpusBinding
        binding: planned.binding
        plan:
            LogicalCaseMigration.legacyPlan(
                split
            )
        logicalCaseCount: logicalCaseCount
    }
    migrated.freeze()

    migrationExecutionSuites =
        Array(
            ...migrationExecutionSuites,
            migrated
        )

    migrationSuiteIndex =
        migrationSuiteIndex + 1
})

migrationExecutionSuites.freeze()
logicalProjections.freeze()
logicalCaseMetadata.freeze()
executionSuites = migrationExecutionSuites

logicalResults: Array()
logicalResults.freeze()

(logicalProjections.size() > 0).ifTrue(() => {
    logicalCompletions:
        LogicalCaseRunner.run(
            logicalProjections,
            (entry) => {
                association:
                    CasePlan.sourceAssociation(
                        entry
                    )

                (association.size() == 2).ifFalse(() => {
                    Error().signal()
                })

                corpusId: association[0]
                sourcePath: association[1]

                String.recognizes(corpusId).ifFalse(() => {
                    Error().signal()
                })
                String.recognizes(sourcePath).ifFalse(() => {
                    Error().signal()
                })

                logicalSourceSpecs.containsKey(corpusId).ifFalse(() => {
                    Error().signal()
                })

                corpusSpecs:
                    logicalSourceSpecs[corpusId]

                corpusSpecs.containsKey(sourcePath).ifFalse(() => {
                    Error().signal()
                })

                testCorpusBindings.hasSlot(corpusId).ifFalse(() => {
                    Error().signal()
                })

                sourceBinding:
                    testCorpusBindings.slotValue(
                        corpusId
                    )

                // Re-read immediately before each fresh Process execution.
                // Discovery source text is deliberately not cached across the
                // D153 rematerialization boundary.
                Runner.readSource(
                    corpusSpecs[sourcePath],
                    sourceBinding.filesystem
                )
            },
            logicalCaseExecutionAsync,
            jobs
        ).value()

    logicalResults =
        LogicalCaseResult.projectAll(
            logicalCompletions
        )
})

(logicalResults.size() == logicalCaseMetadata.size()).ifFalse(() => {
    Error().signal()
})

logicalResultsBySuite: Array()
executionSuites.each((ignored) => {
    logicalResultsBySuite =
        Array(
            ...logicalResultsBySuite,
            Array()
        )
})

logicalResultIndex: 0
logicalResults.each((result) => {
    metadata:
        logicalCaseMetadata[
            logicalResultIndex
        ]

    targetSuiteIndex: metadata[0]
    spec: metadata[1]

    pair: Array(spec, result)
    pair.freeze()

    logicalResultsBySuite[targetSuiteIndex] =
        Array(
            ...logicalResultsBySuite[targetSuiteIndex],
            pair
        )

    logicalResultIndex =
        logicalResultIndex + 1
})

logicalResultsBySuite.each((group) => {
    group.freeze()
})
logicalResultsBySuite.freeze()

completedRuns: Array()
primaryRun: null
finalOutcome: null
invocationAborted: false

suiteIndex: 0
(() =>
    (suiteIndex < executionSuites.size()) &&
    invocationAborted.not()
).while() {
    planned: executionSuites[suiteIndex]
    corpusBinding: planned.corpusBinding
    binding: planned.binding
    suiteProgress:
        startProgress(
            planned.phaseName,
            planned.plan,
            planned.logicalCaseCount
        )

    caseAuthorityExecutorAsync: null
    corpusBinding.hasSlot("caseAuthorityExecutionAsync").ifTrue(() => {
        caseAuthorityExecutorAsync =
            corpusBinding.caseAuthorityExecutionAsync
    })

    executionInspectAsync: null
    binding.hasSlot("executionInspectAsync").ifTrue(() => {
        executionInspectAsync = binding.executionInspectAsync
    })

    resourceExecutionAsync: null
    binding.hasSlot("resourceExecutionAsync").ifTrue(() => {
        resourceExecutionAsync = binding.resourceExecutionAsync
    })

    resourceExecutionInspectAsync: null
    binding.hasSlot("resourceExecutionInspectAsync").ifTrue(() => {
        resourceExecutionInspectAsync =
            binding.resourceExecutionInspectAsync
    })

    suiteD108: null
    infrastructureFailed: false

    (Manifest.planCases(planned.plan).size() > 0).ifTrue(() => {
        suiteD108 =
            Runner.runD108WithResources(
                planned.plan,
                resourceCatalog,
                corpusBinding.filesystem,
                binding.executionAsync,
                executionInspectAsync,
                resourceExecutionAsync,
                resourceExecutionInspectAsync,
                jobs,
                Progress.observer(suiteProgress),
                caseAuthorityExecutorAsync
            )

        infrastructureFailed =
            Runner.d108RunInfrastructureFailed(
                suiteD108
            )
    })

    logicalInfrastructureFailed: false
    logicalObserver:
        Progress.observer(
            suiteProgress
        )

    logicalResultsBySuite[suiteIndex].each((pair) => {
        spec: pair[0]
        logicalResult: pair[1]

        classification:
            LogicalCaseResult.classification(
                logicalResult
            )

        evaluation: null
        resultInfrastructureFailed: false

        (classification == "pass").ifTrue(() => {
            evaluation =
                Runner.resultTuple(
                    true,
                    null
                )
        })

        (classification == "fail").ifTrue(() => {
            evaluation =
                Runner.resultTuple(
                    false,
                    null
                )
        })

        (classification == "tool-error").ifTrue(() => {
            resultInfrastructureFailed = true
            logicalInfrastructureFailed = true
        })

        logicalObserver(
            spec,
            evaluation,
            resultInfrastructureFailed
        )
    })

    Progress.finishPhase(
        suiteProgress,
        infrastructureFailed ||
            logicalInfrastructureFailed
    )

    infrastructureFailed.ifTrue(() => {
        laterPlans: Array()
        laterIndex: suiteIndex + 1
        (() => laterIndex < executionSuites.size()).while() {
            laterPlans = Array(
                ...laterPlans,
                executionSuites[laterIndex].plan
            )
            laterIndex = laterIndex + 1
        }

        finalOutcome =
            Runner.testRunOutcomeInfrastructureAbortedAcrossInvocation(
                completedRuns,
                suiteD108,
                laterPlans
            )
        invocationAborted = true
    })

    (
        !infrastructureFailed &&
        (suiteD108 !== null)
    ).ifTrue(() => {
        healthyRun:
            Runner.d108RunHealthyRun(
                suiteD108
            )

        completedRuns =
            Array(
                ...completedRuns,
                healthyRun
            )

        (primaryRun === null).ifTrue(() => {
            primaryRun = healthyRun
        })
    })

    suiteIndex = suiteIndex + 1
}

(!invocationAborted).ifTrue(() => {
    (completedRuns.size() > 0).ifTrue(() => {
        finalOutcome =
            Runner.testRunOutcomeCompletedAcrossRuns(
                primaryRun,
                completedRuns
            )
    })

    (completedRuns.size() == 0).ifTrue(() => {
        finalOutcome =
            LogicalCaseMigration.neutralLegacyOutcome()
    })
})

finalOutcome =
    LogicalCaseMigration.mergeOutcome(
        finalOutcome,
        logicalResults
    )

Progress.finishInvocation(
    progressPhases,
    Runner.testRunOutcomeStatus(finalOutcome),
    emitProgress
)

writer: TextWriter(process.stdout(), process.stdoutEncoding())
writer.writeLine("Protos test tool bootstrap").value()
writer.writeLine(process.args()[0]).value()

finalOutcome
