//! Temporary TOOL009 M2 mixed-ownership migration scaffold.
//!
//! This module exists only while D152 M2 incrementally transfers production
//! sources from the incumbent manifest runner to suite-native logical Cases.
//! M3/M4 must remove this module and every `suite-native` manifest marker.

Manifest: import("self:Manifest")
FileSelection: import("self:FileSelection")
LogicalCaseResult: import("self:LogicalCaseResult")
Runner: import("self:Runner")

migrationError: () => {
    Error().signal()
}

isSuiteNativeSpec: (spec) => {
    Manifest.caseExpectation(spec) == "suite-native"
}

// Result layout:
// [legacyPlan, orderedSuiteNativeSpecs]
splitPlan: (plan) => {
    legacyCases: Array()
    suiteNativeSpecs: Array()

    Manifest.planCases(plan).each((spec) => {
        suiteNative: isSuiteNativeSpec(spec)

        suiteNative.ifTrue(() => {
            // D153 case-environment provisioning remains separately deferred.
            // M2 therefore migrates only cases with no incumbent per-case
            // resource or authority requirements.
            (Manifest.caseRequirements(spec).size() == 0).ifFalse(() => {
                migrationError()
            })
            (Manifest.caseAuthorityDescriptor(spec) === null).ifFalse(() => {
                migrationError()
            })

            suiteNativeSpecs =
                Array(
                    ...suiteNativeSpecs,
                    spec
                )
        })

        suiteNative.ifFalse(() => {
            legacyCases =
                Array(
                    ...legacyCases,
                    spec
                )
        })
    })

    legacyCases.freeze()
    suiteNativeSpecs.freeze()

    legacyPlan: Array(legacyCases)
    legacyPlan.freeze()

    result:
        Array(
            legacyPlan,
            suiteNativeSpecs
        )
    result.freeze()
}

legacyPlan: (split) => {
    split[0]
}

suiteNativeSpecs: (split) => {
    split[1]
}

sourceAssociation: (corpusId, spec) => {
    String.recognizes(corpusId).ifFalse(() => {
        migrationError()
    })
    (corpusId == "").ifTrue(() => {
        migrationError()
    })

    association:
        Array(
            corpusId,
            Manifest.casePath(spec)
        )
    association.freeze()
}

// D151 selection over sources whose incumbent CaseSpecs have already been
// removed from the legacy execution plan by splitPlan.
selectSuiteNativeSpecs: (
    corpusId,
    specs,
    associations
) => {
    selected: Array()

    specs.each((spec) => {
        retained: false

        associations.each((association) => {
            FileSelection.associationMatches(
                association,
                corpusId,
                Manifest.casePath(spec)
            ).ifTrue(() => {
                retained = true
            })
        })

        retained.ifTrue(() => {
            selected =
                Array(
                    ...selected,
                    spec
                )
        })
    })

    selected.freeze()
}

// TOOL009-D transport boundary.
//
// LogicalCasePlan/CasePlan entries stay inert and test-neutral (D152/D153):
// they carry a source association and a selector only, never a host
// execution requirement. The authoritative D125 ExecutionRequirementId for a
// logical Case instead lives on the SuiteGraph leaf that owns its corpus. This
// dispatcher resolves that requirement to its already-installed D125
// testExecutionRequirementBindings entry only at the LogicalCaseRunner
// executorAsync boundary, so no guest Case ever observes host execution
// infrastructure and no parallel requirement registry is introduced.
//
// corpusExecutionRequirements maps corpusId -> ExecutionRequirementId, built
// once by the caller from the resolved SuiteGraph leaves. A requirement whose
// binding has no suite-native logical Case execution route yet (every
// requirement other than "protos/test/ordinary" as of TOOL009-D) fails closed
// rather than silently falling back to a different requirement's mechanics.
logicalCaseExecutorAsync: (
    corpusExecutionRequirements,
    testExecutionRequirementBindings
) => {
    (sourceAssociation, source, signature, selector) => {
        (sourceAssociation.size() == 2).ifFalse(() => {
            migrationError()
        })

        corpusId: sourceAssociation[0]

        corpusExecutionRequirements.containsKey(corpusId).ifFalse(() => {
            migrationError()
        })

        requirementId: corpusExecutionRequirements[corpusId]

        testExecutionRequirementBindings.hasSlot(requirementId).ifFalse(() => {
            migrationError()
        })

        binding: testExecutionRequirementBindings.slotValue(requirementId)

        binding.hasSlot("logicalCaseExecutionAsync").ifFalse(() => {
            migrationError()
        })

        binding.logicalCaseExecutionAsync(
            sourceAssociation,
            source,
            signature,
            selector
        )
    }
}

// Neutral incumbent side used when --file selects only suite-native Cases.
neutralLegacyOutcome: () => {
    Runner.testRunOutcomeCompletedWithExit(
        null,
        0
    )
}

// Temporary M2 top-level reconciliation. D155 precedence is:
// any tool error => infrastructure-aborted/3;
// otherwise any guest failure => completed/1;
// otherwise completed/0.
mergeOutcome: (
    legacyOutcome,
    logicalResults
) => {
    legacyStatus:
        Runner.testRunOutcomeStatus(
            legacyOutcome
        )

    legacyExit:
        Runner.testRunOutcomeExitCode(
            legacyOutcome
        )

    logicalExit:
        LogicalCaseResult.exitCode(
            logicalResults
        )

    merged: null

    (legacyStatus == "infrastructure-aborted").ifTrue(() => {
        (legacyExit == 3).ifFalse(() => {
            migrationError()
        })

        merged = legacyOutcome
    })

    (legacyStatus == "completed").ifTrue(() => {
        (
            (legacyExit == 0) ||
            (legacyExit == 1)
        ).ifFalse(() => {
            migrationError()
        })

        (logicalExit == 3).ifTrue(() => {
            merged =
                Runner.testRunOutcome(
                    "infrastructure-aborted",
                    null,
                    null,
                    3
                )
        })

        (logicalExit == 3).ifFalse(() => {
            mergedExit: legacyExit

            (logicalExit == 1).ifTrue(() => {
                mergedExit = 1
            })

            merged =
                Runner.testRunOutcomeCompletedWithExit(
                    Runner.testRunOutcomeRun(
                        legacyOutcome
                    ),
                    mergedExit
                )
        })
    })

    (merged === null).ifTrue(() => {
        migrationError()
    })

    merged
}
