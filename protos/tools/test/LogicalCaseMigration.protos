//! TOOL009 mixed-ownership migration bridge.
//!
//! This module partitions an incumbent CaseSpec plan into a legacy Runner
//! plan and inert suite-native logical Case specs, projects inert logical
//! Case source associations, dispatches suite-native execution through the
//! corpus's bound execution requirement, and reconciles legacy and logical
//! outcomes under D155 precedence. It remains production infrastructure
//! while any Package Tool corpus retains legacy CaseSpecs; it does not
//! disappear merely because a corpus has been fully migrated to suite-native
//! ownership.

Manifest: import("self:Manifest")
LogicalCaseResult: import("self:LogicalCaseResult")
Runner: import("self:Runner")

migrationError: () => {
    Error().signal()
}

isSuiteNativeSpec: (spec) => {
    Manifest.caseExpectation(spec) == "suite-native"
}

// Result layout:
// [legacyPlan, orderedSuiteNativeSpecs]
splitPlan: (plan) => {
    legacyCases: Array()
    suiteNativeSpecs: Array()

    Manifest.planCases(plan).each((spec) => {
        suiteNative: isSuiteNativeSpec(spec)

        suiteNative.ifTrue(() => {
            // D153 case-environment provisioning remains separately deferred
            // for D077 resource requirements: a suite-native Case may still
            // carry none of those. TOOL009 Package Non-TOML Publication 2
            // additionally permits a well-formed D133 project-tree
            // CaseAuthority descriptor to accompany a suite-native spec; the
            // descriptor travels onward through sourceAssociation below
            // rather than being rejected here.
            (Manifest.caseRequirements(spec).size() == 0).ifFalse(() => {
                migrationError()
            })

            descriptor: Manifest.caseAuthorityDescriptor(spec)
            (descriptor === null).ifFalse(() => {
                (Manifest.caseAuthorityKind(descriptor) == "project-tree").ifFalse(() => {
                    migrationError()
                })
                (Manifest.caseAuthorityIsolation(descriptor) == "case").ifFalse(() => {
                    migrationError()
                })
                (Manifest.caseAuthorityLifecycle(descriptor) == "case").ifFalse(() => {
                    migrationError()
                })
            })

            suiteNativeSpecs =
                Array(
                    ...suiteNativeSpecs,
                    spec
                )
        })

        suiteNative.ifFalse(() => {
            legacyCases =
                Array(
                    ...legacyCases,
                    spec
                )
        })
    })

    legacyCases.freeze()
    suiteNativeSpecs.freeze()

    legacyPlan: Array(legacyCases)
    legacyPlan.freeze()

    result:
        Array(
            legacyPlan,
            suiteNativeSpecs
        )
    result.freeze()
}

legacyPlan: (split) => {
    split[0]
}

suiteNativeSpecs: (split) => {
    split[1]
}

// TOOL009 Package Non-TOML Publication 2: a project-tree suite-native spec's
// D133 CaseAuthority descriptor travels as a third sourceAssociation element.
// Distinct project identities sharing one fixture sourcePath therefore remain
// distinct source associations rather than collapsing into one logical
// record; project identity is not obsolete once suite-native.
sourceAssociation: (corpusId, spec) => {
    String.recognizes(corpusId).ifFalse(() => {
        migrationError()
    })
    (corpusId == "").ifTrue(() => {
        migrationError()
    })

    descriptor: Manifest.caseAuthorityDescriptor(spec)

    association:
        Array(
            corpusId,
            Manifest.casePath(spec)
        )

    (descriptor === null).ifFalse(() => {
        association =
            Array(
                corpusId,
                Manifest.casePath(spec),
                descriptor
            )
    })

    association.freeze()
}

// TOOL009-D transport boundary.
//
// LogicalCasePlan/CasePlan entries stay inert and test-neutral (D152/D153):
// they carry a source association and a selector only, never a host
// execution requirement. The authoritative D125 ExecutionRequirementId for a
// logical Case instead lives on the SuiteGraph leaf that owns its corpus. This
// dispatcher resolves that requirement to its already-installed D125
// testExecutionRequirementBindings entry only at the LogicalCaseRunner
// executorAsync boundary, so no guest Case ever observes host execution
// infrastructure and no parallel requirement registry is introduced.
//
// corpusExecutionRequirements maps corpusId -> ExecutionRequirementId, built
// once by the caller from the resolved SuiteGraph leaves. A requirement whose
// binding has no suite-native logical Case execution route yet (every
// requirement other than "protos/test/ordinary" as of TOOL009-D) fails closed
// rather than silently falling back to a different requirement's mechanics.
logicalCaseExecutorAsync: (
    corpusExecutionRequirements,
    testExecutionRequirementBindings
) => {
    (sourceAssociation, source, signature, selector) => {
        // A third element, when present, is the D133 project-tree CaseAuthority
        // descriptor (TOOL009 Package Non-TOML Publication 2). This dispatcher
        // does not decode it; it forwards sourceAssociation intact to the bound
        // execution requirement's logicalCaseExecutionAsync, which is the sole
        // authority that decodes and provisions it.
        (
            (sourceAssociation.size() == 2) ||
            (sourceAssociation.size() == 3)
        ).ifFalse(() => {
            migrationError()
        })

        corpusId: sourceAssociation[0]

        corpusExecutionRequirements.containsKey(corpusId).ifFalse(() => {
            migrationError()
        })

        requirementId: corpusExecutionRequirements[corpusId]

        testExecutionRequirementBindings.hasSlot(requirementId).ifFalse(() => {
            migrationError()
        })

        binding: testExecutionRequirementBindings.slotValue(requirementId)

        binding.hasSlot("logicalCaseExecutionAsync").ifFalse(() => {
            migrationError()
        })

        binding.logicalCaseExecutionAsync(
            sourceAssociation,
            source,
            signature,
            selector
        )
    }
}

// Neutral incumbent side used when --file selects only suite-native Cases.
neutralLegacyOutcome: () => {
    Runner.testRunOutcomeCompletedWithExit(
        null,
        0
    )
}

// Temporary M2 top-level reconciliation. D155 precedence is:
// any tool error => infrastructure-aborted/3;
// otherwise any guest failure => completed/1;
// otherwise completed/0.
mergeOutcome: (
    legacyOutcome,
    logicalResults
) => {
    legacyStatus:
        Runner.testRunOutcomeStatus(
            legacyOutcome
        )

    legacyExit:
        Runner.testRunOutcomeExitCode(
            legacyOutcome
        )

    logicalExit:
        LogicalCaseResult.exitCode(
            logicalResults
        )

    merged: null

    (legacyStatus == "infrastructure-aborted").ifTrue(() => {
        (legacyExit == 3).ifFalse(() => {
            migrationError()
        })

        merged = legacyOutcome
    })

    (legacyStatus == "completed").ifTrue(() => {
        (
            (legacyExit == 0) ||
            (legacyExit == 1)
        ).ifFalse(() => {
            migrationError()
        })

        (logicalExit == 3).ifTrue(() => {
            merged =
                Runner.testRunOutcome(
                    "infrastructure-aborted",
                    null,
                    null,
                    3
                )
        })

        (logicalExit == 3).ifFalse(() => {
            mergedExit: legacyExit

            (logicalExit == 1).ifTrue(() => {
                mergedExit = 1
            })

            merged =
                Runner.testRunOutcomeCompletedWithExit(
                    Runner.testRunOutcomeRun(
                        legacyOutcome
                    ),
                    mergedExit
                )
        })
    })

    (merged === null).ifTrue(() => {
        migrationError()
    })

    merged
}
