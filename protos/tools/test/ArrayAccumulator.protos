//! PERF031-I: Test Tool-internal order-preserving Array accumulation.
//!
//! Ordinary Array has no append, so growing a result with
//! `Array(...previous, value)` copies the whole prefix on every step. This
//! binary-carry accumulator (the technique SuiteGraph.flatten,
//! Manifest.loadWithParser and Options.projectArguments use privately) keeps
//! chunks keyed by merge level, merges equal-size chunks older-before-newer,
//! and copies each element O(log N) times in total. `finish` returns a fresh
//! ordinary Array holding exactly the appended references in append order;
//! freezing it remains the caller's decision. Map order is never consulted:
//! chunks are read by explicit level.

create: () => {
    {
        chunks: Map()
        maxLevel: -1
    }
}

append: (accumulator, value) => {
    chunk: Array(value)
    level: 0

    // A chunk already at this level holds older elements, so it goes first.
    (() => accumulator.chunks.containsKey(level)).whileTrue() {
        chunk = Array(...accumulator.chunks[level], ...chunk)
        accumulator.chunks.remove(level)
        level = level + 1
    }

    accumulator.chunks[level] = chunk
    (level > accumulator.maxLevel).ifTrue(() => {
        accumulator.maxLevel = level
    })

    null
}

// Higher levels hold older elements, so chunks are concatenated from the
// highest level down. The accumulator itself is left unchanged.
finish: (accumulator) => {
    result: Array()
    level: accumulator.maxLevel

    (() => level >= 0).whileTrue() {
        accumulator.chunks.containsKey(level).ifTrue(() => {
            result = Array(...result, ...accumulator.chunks[level])
        })
        level = level - 1
    }

    result
}
