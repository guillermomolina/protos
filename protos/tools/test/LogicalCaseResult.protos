Arrays: import("std:collections/Array")

policyError: () => {
    Error().signal()
}

classificationForCompletion: (completion) => {
    completion.hasSlot("phase").ifFalse(() => {
        policyError()
    })
    completion.hasSlot("observation").ifFalse(() => {
        policyError()
    })

    phase: completion.phase
    observation: completion.observation

    String.recognizes(phase).ifFalse(() => {
        policyError()
    })

    observation.hasSlot("state").ifFalse(() => {
        policyError()
    })

    state: observation.state
    String.recognizes(state).ifFalse(() => {
        policyError()
    })

    classification: null

    if(phase == "rematerialization-error") {
        classification = "tool-error"
    }

    // BUG020: the logical Case's execution itself failed (LogicalCaseRunner).
    if(phase == "execution-error") {
        classification = "tool-error"
    }

    if(phase == "case-execution") {
        if(state == "completed") {
            classification = "pass"
        }

        if(state == "failed") {
            classification = "fail"
        }

        if(state == "cancelled") {
            classification = "tool-error"
        }
    }

    if(classification === null) {
        policyError()
    }

    classification
}

project: (completion) => {
    result: Array(
        classificationForCompletion(completion),
        completion
    )
    result.freeze()
}

classification: (result) => {
    result[0]
}

completion: (result) => {
    result[1]
}

projectAll: (completions) => {
    Array.recognizes(completions).ifFalse(() => {
        policyError()
    })

    results:
        Arrays.map(completions, (completion) => {
            project(completion)
        })

    results.freeze()
}

exitCode: (results) => {
    Array.recognizes(results).ifFalse(() => {
        policyError()
    })

    code: 0

    results.each((result) => {
        kind: classification(result)

        if(kind == "fail") {
            if(code == 0) {
                code = 1
            }
        }

        if(kind == "tool-error") {
            code = 3
        }

        if(
            !(kind == "pass") &&
            !(kind == "fail") &&
            !(kind == "tool-error")
        ) {
            policyError()
        }
    })

    code
}
