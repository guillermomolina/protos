Arrays: import("std:collections/Array")

policyError: () => {
    Error().signal()
}

classificationForCompletion: (completion) => {
    completion.hasSlot("phase").ifFalse(() => {
        policyError()
    })
    completion.hasSlot("observation").ifFalse(() => {
        policyError()
    })

    phase: completion.phase
    observation: completion.observation

    String.recognizes(phase).ifFalse(() => {
        policyError()
    })

    observation.hasSlot("state").ifFalse(() => {
        policyError()
    })

    state: observation.state
    String.recognizes(state).ifFalse(() => {
        policyError()
    })

    classification: null

    (phase == "rematerialization-error").ifTrue(() => {
        classification = "tool-error"
    })

    (phase == "case-execution").ifTrue(() => {
        (state == "completed").ifTrue(() => {
            classification = "pass"
        })

        (state == "failed").ifTrue(() => {
            classification = "fail"
        })

        (state == "cancelled").ifTrue(() => {
            classification = "tool-error"
        })
    })

    (classification === null).ifTrue(() => {
        policyError()
    })

    classification
}

project: (completion) => {
    result: Array(
        classificationForCompletion(completion),
        completion
    )
    result.freeze()
}

classification: (result) => {
    result[0]
}

completion: (result) => {
    result[1]
}

projectAll: (completions) => {
    Array.recognizes(completions).ifFalse(() => {
        policyError()
    })

    results:
        Arrays.map(completions, (completion) => {
            project(completion)
        })

    results.freeze()
}

exitCode: (results) => {
    Array.recognizes(results).ifFalse(() => {
        policyError()
    })

    code: 0

    results.each((result) => {
        kind: classification(result)

        (kind == "fail").ifTrue(() => {
            (code == 0).ifTrue(() => {
                code = 1
            })
        })

        (kind == "tool-error").ifTrue(() => {
            code = 3
        })

        (
            !(kind == "pass") &&
            !(kind == "fail") &&
            !(kind == "tool-error")
        ).ifTrue(() => {
            policyError()
        })
    })

    code
}
