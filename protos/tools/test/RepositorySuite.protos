//! TOOL005-B1 inert repository-owned Test Tool suite descriptor.
//! Membership/SuiteIds follow D122/D123; executable leaves carry mandatory
//! D126 CorpusId and D125 ExecutionRequirementId in separate logical namespaces.

SuiteGraph: import("self:SuiteGraph")

root: SuiteGraph.suite(
    "protos/repository",
    Array(
        SuiteGraph.leaf(
            "protos/conformance",
            "protos/corpus/conformance",
            "protos/test/ordinary"
        ),
        SuiteGraph.leaf(
            "protos/actor",
            "protos/corpus/actor",
            "protos/test/actor"
        ),
        SuiteGraph.leaf(
            "protos/group",
            "protos/corpus/group",
            "protos/test/group"
        ),
        SuiteGraph.leaf(
            "protos/package-toml",
            "protos/corpus/package-toml",
            "protos/test/package"
        )
    )
)
