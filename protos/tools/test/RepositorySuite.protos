// TOOL011 repository progress presentation policy. Progress groups are a
// presentation projection over final retained Logical Cases only: they never
// select a CorpusId, ExecutionRequirementId, schedule, Process or Case identity.
// Every policy violation fails closed; there is no catch-all group.
//
// TOOL012: a subdivided conformance group presents no group under its own
// name. Each of its Cases presents under "<name>/<directory>", where directory
// is the Case's D153 selector without its final segment (for toml-official,
// the upstream toml-test direction and directory such as "invalid/array",
// "encoder/spec-1.1.0" or, for root-level Cases, "valid"), keeping every group
// within 100 Logical Cases without a per-Case table or a dependency on
// scheduling.

repositoryLeafIdPrefix: "protos/"
conformanceLeafId: "protos/conformance"

policyError: () => {
    Error().signal()
}

// One conformance progress group. A casePath belongs to it when the path's
// directory equals or lies below one of `subtrees`, or equals exactly one of
// `directories`.
progressGroupDescriptor: (name, subtrees, directories, subdivided) => {
    subtreeValues: Array(...subtrees)
    subtreeValues.freeze()
    directoryValues: Array(...directories)
    directoryValues.freeze()

    descriptor: {
        name: name
        subtrees: subtreeValues
        directories: directoryValues
        subdivided: subdivided
    }
    descriptor.freeze()
}

conformanceProgressGroup: (name, subtrees, directories) => {
    progressGroupDescriptor(name, subtrees, directories, false)
}

// TOOL012: membership is matched exactly as for conformanceProgressGroup; only
// presentation is subdivided by selector directory.
subdividedConformanceProgressGroup: (name, subtrees) => {
    progressGroupDescriptor(name, subtrees, Array(), true)
}

// The single ordered source of truth for both conformance group order and
// membership by the directory of the authoritative Manifest.casePath. Every
// conformance casePath must match exactly one descriptor.
conformanceProgressGroups: Array(
    conformanceProgressGroup(
        "conformance/values",
        Array(
            "integer",
            "float",
            "numeric-conversion",
            "boolean",
            "numeric-equality",
            "equality",
            "collections",
            "number",
            "string",
            "bytes"
        ),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/object-model",
        Array(
            "call",
            "object",
            "reflection",
            "object-structural",
            "matching",
            "execution-context"
        ),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/control-concurrency",
        Array("error", "control", "future"),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/io",
        Array("path", "encoding", "text-reader", "text-writer", "network"),
        Array()
    ),
    subdividedConformanceProgressGroup(
        "conformance/standard-library/toml-official",
        Array("library/toml/official")
    ),
    // Only sources directly in library/toml; library/toml/official has its own
    // group, and any other library/toml subdirectory fails closed.
    conformanceProgressGroup(
        "conformance/standard-library/toml",
        Array(),
        Array("library/toml")
    ),
    conformanceProgressGroup(
        "conformance/standard-library/collections",
        Array("library/collections"),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/standard-library/data-text-test",
        Array("library/json", "library/text", "library/test"),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/language-surface",
        Array("core-surface", "surface-sugar"),
        Array()
    ),
    conformanceProgressGroup(
        "conformance/regression-maturity",
        Array("regression", "maturity"),
        Array()
    )
)
conformanceProgressGroups.freeze()

isConformanceLeaf: (leaf) => {
    leaf.id == conformanceLeafId
}

// No Standard Library String prefix facility exists, so the scalar comparison
// mirrors FileSelection.pathWithinDirectory.
hasPrefix: (text, prefix) => {
    matches: text.size() >= prefix.size()
    index: 0
    (() => matches && (index < prefix.size())).whileTrue() {
        matches = text[index] == prefix[index]
        index = index + 1
    }
    matches
}

substringFrom: (text, start) => {
    result: ""
    index: start
    (() => index < text.size()).whileTrue() {
        result = result + text[index]
        index = index + 1
    }
    result
}

// An ordinary repository leaf presents under its SuiteId without the exact
// "protos/" prefix.
ordinaryProgressGroupName: (leaf) => {
    id: leaf.id
    (id.size() > repositoryLeafIdPrefix.size()).ifFalse(() => {
        policyError()
    })
    hasPrefix(id, repositoryLeafIdPrefix).ifFalse(() => {
        policyError()
    })
    substringFrom(id, repositoryLeafIdPrefix.size())
}

// A conformance casePath must contain a non-empty directory.
pathDirectory: (casePath) => {
    directory: ""
    pending: ""
    separatorFound: false

    index: 0
    (() => index < casePath.size()).whileTrue() {
        character: casePath[index]
        (character == "/").ifTrue(() => {
            (pending.size() == 0).ifTrue(() => {
                policyError()
            })
            separatorFound.ifTrue(() => {
                directory = directory + "/"
            })
            directory = directory + pending
            pending = ""
            separatorFound = true
        })
        (character == "/").ifFalse(() => {
            pending = pending + character
        })
        index = index + 1
    }

    separatorFound.ifFalse(() => {
        policyError()
    })
    directory
}

groupOwnsDirectory: (group, directory) => {
    owns: false
    group.subtrees.each((subtree) => {
        (directory == subtree).ifTrue(() => {
            owns = true
        })
        hasPrefix(directory, subtree + "/").ifTrue(() => {
            owns = true
        })
    })
    group.directories.each((exact) => {
        (directory == exact).ifTrue(() => {
            owns = true
        })
    })
    owns
}

// TOOL012: the directory of a D153 selector, under the same fail-closed rules
// as a casePath directory, with a non-empty final segment.
selectorDirectory: (selector) => {
    (selector.size() > 0).ifFalse(() => {
        policyError()
    })
    (selector[selector.size() - 1] == "/").ifTrue(() => {
        policyError()
    })
    pathDirectory(selector)
}

// A conformance casePath must match exactly one descriptor.
conformanceDescriptorIndex: (casePath) => {
    directory: pathDirectory(casePath)
    matches: Array()
    descriptorIndex: 0

    conformanceProgressGroups.each((group) => {
        groupOwnsDirectory(group, directory).ifTrue(() => {
            matches = Array(...matches, descriptorIndex)
        })
        descriptorIndex = descriptorIndex + 1
    })

    (matches.size() == 1).ifFalse(() => {
        policyError()
    })
    matches[0]
}

caseGroupName: (group, selector) => {
    name: group.name
    group.subdivided.ifTrue(() => {
        name = name + "/" + selectorDirectory(selector)
    })
    name
}

/// Answers the progress grouping one repository leaf presents for `caseKeys`,
/// its final retained Logical Cases in plan order, each an
/// Array(casePath, selector), as a frozen object with `names`, the ordered
/// progress group names, and `caseGroupIndexes`, aligned with `caseKeys`, the
/// index within `names` of the group owning each Case. Conformance names follow
/// descriptor order; a subdivided descriptor contributes its subgroup names in
/// order of first retained Case, so only subgroups owning a retained Case
/// appear.
// PERF031-F: every casePath is matched against the descriptors exactly once,
// subgroup names are collected in a single pass over `caseKeys`, and
// membership tests use local Maps keyed by name under the same `==` String
// equality the linear searches used. No Map iteration order is consumed; all
// presentation order comes from descriptor order and Case order.
progressGroupAssignment: (leaf, caseKeys) => {
    names: null
    caseGroupIndexes: null

    isConformanceLeaf(leaf).ifTrue(() => {
        // Every casePath is validated against the descriptors before any
        // selector is examined.
        caseDescriptorIndexes: Arrays.map(caseKeys, (key) => {
            (casePath, ignoredSelector): key
            conformanceDescriptorIndex(casePath)
        })

        caseNames: Arrays.map(caseKeys, (ignored) => null)
        descriptorSubgroups: Arrays.map(conformanceProgressGroups, (ignored) => Array())
        descriptorSeen: Arrays.map(conformanceProgressGroups, (ignored) => Map())

        caseIndex: 0
        caseKeys.each((key) => {
            caseDescriptorIndex: caseDescriptorIndexes[caseIndex]
            caseGroup: conformanceProgressGroups[caseDescriptorIndex]
            (ignoredPath, selector): key
            caseName: caseGroupName(caseGroup, selector)
            caseNames[caseIndex] = caseName
            caseGroup.subdivided.ifTrue(() => {
                seen: descriptorSeen[caseDescriptorIndex]
                seen.containsKey(caseName).ifFalse(() => {
                    seen[caseName] = true
                    descriptorSubgroups[caseDescriptorIndex] =
                        Array(...descriptorSubgroups[caseDescriptorIndex], caseName)
                })
            })
            caseIndex = caseIndex + 1
        })

        // Descriptor order, deduplicated against every earlier name exactly
        // as the former linear search over the accumulated names did.
        names = Array()
        known: Map()
        descriptorIndex: 0
        conformanceProgressGroups.each((group) => {
            group.subdivided.ifFalse(() => {
                names = Array(...names, group.name)
                // The lowest index answers a repeated name, as findIndex did.
                known.containsKey(group.name).ifFalse(() => {
                    known[group.name] = names.size() - 1
                })
            })
            group.subdivided.ifTrue(() => {
                descriptorSubgroups[descriptorIndex].each((name) => {
                    known.containsKey(name).ifFalse(() => {
                        names = Array(...names, name)
                        known[name] = names.size() - 1
                    })
                })
            })
            descriptorIndex = descriptorIndex + 1
        })

        caseGroupIndexes = Arrays.map(caseNames, (name) => {
            known.containsKey(name).ifFalse(() => {
                policyError()
            })
            known[name]
        })
    })
    isConformanceLeaf(leaf).ifFalse(() => {
        names = Array(ordinaryProgressGroupName(leaf))
        caseGroupIndexes = Arrays.map(caseKeys, (ignored) => 0)
    })

    names.freeze()
    caseGroupIndexes.freeze()

    assignment: {
        names: names
        caseGroupIndexes: caseGroupIndexes
    }
    assignment.freeze()
}

/// Answers the ordered progress group names one repository leaf presents for
/// `caseKeys`, exactly the `names` of progressGroupAssignment.
progressGroupNames: (leaf, caseKeys) => {
    progressGroupAssignment(leaf, caseKeys).names
}

/// Answers the name of the progress group owning one Case of a leaf, identified
/// by its authoritative casePath and D153 selector.
progressGroupName: (leaf, casePath, selector) => {
    name: null

    isConformanceLeaf(leaf).ifTrue(() => {
        name =
            caseGroupName(
                conformanceProgressGroups[conformanceDescriptorIndex(casePath)],
                selector
            )
    })
    isConformanceLeaf(leaf).ifFalse(() => {
        name = ordinaryProgressGroupName(leaf)
    })

    name
}

/// Answers the index, within `names` as answered by progressGroupNames, of the
/// progress group owning one Case of that leaf. A Case whose group is absent
/// from `names` fails closed.
progressGroupIndex: (leaf, names, casePath, selector) => {
    name: progressGroupName(leaf, casePath, selector)
    groupIndex: Arrays.findIndex(names, (candidate) => candidate == name)
    (groupIndex === null).ifTrue(() => {
        policyError()
    })
    groupIndex
}
