// TOOL002-I6C: pure D077 resource-requirements schema parser.
//
// The private shared TOML import is resolved while this bundled Test Tool module
// is initialized. Exported Closures capture the imported Document module and do
// not attempt a private import under an exact-source caller.
Document: import("tool-shared:Toml10/TomlDocument")
Manifest: import("self:Manifest")

fail: () => {
    Error().signal()
}

frozenTuple: (...items) => {
    items
}

tableEntries: (node) => {
    (node.kind == "table").ifFalse(() => {
        fail()
    })
    node.value
}

requiredNode: (entries, name) => {
    entries.containsKey(name).ifFalse(() => {
        fail()
    })
    entries[name]
}

stringValue: (node) => {
    (node.kind == "string").ifFalse(() => {
        fail()
    })
    node.value
}

checkAllowed: (entries, allowed) => {
    entries.each((name, ignoredValue) => {
        allowed.containsKey(name).ifFalse(() => {
            fail()
        })
    })
}

declaration: (caseName, requirementValue) => {
    frozenTuple(caseName, requirementValue)
}

declarationCase: (declarationValue) => {
    declarationValue[0]
}

declarationRequirement: (declarationValue) => {
    declarationValue[1]
}

parse: (text) => {
    rootEntries: tableEntries(Document.table(text))

    rootAllowed: Map()
    rootAllowed["resource-requirements-version"] = true
    rootAllowed["requirement"] = true
    checkAllowed(rootEntries, rootAllowed)

    versionNode: requiredNode(rootEntries, "resource-requirements-version")
    (versionNode.kind == "integer").ifFalse(() => {
        fail()
    })
    (versionNode.value == 1).ifFalse(() => {
        fail()
    })

    declarations: Array()
    seenByCase: Map()

    rootEntries.containsKey("requirement").ifTrue(() => {
        requirementNodes: rootEntries["requirement"]
        (requirementNodes.kind == "array").ifFalse(() => {
            fail()
        })

        requirementNodes.value.each((requirementNode) => {
            entries: tableEntries(requirementNode)
            allowed: Map()
            allowed["case"] = true
            allowed["key"] = true
            allowed["mode"] = true
            allowed["units"] = true
            checkAllowed(entries, allowed)

            caseName: stringValue(requiredNode(entries, "case"))
            ignoredCasePathValidation: Manifest.pathValue(caseName)
            key: stringValue(requiredNode(entries, "key"))
            mode: stringValue(requiredNode(entries, "mode"))

            units: null
            entries.containsKey("units").ifTrue(() => {
                unitsNode: entries["units"]
                (unitsNode.kind == "integer").ifFalse(() => {
                    fail()
                })
                units = unitsNode.value
            })

            requirementValue: Manifest.requirement(key, mode, units)

            seenKeys: null
            seenByCase.containsKey(caseName).ifTrue(() => {
                seenKeys = seenByCase[caseName]
            })
            seenByCase.containsKey(caseName).ifFalse(() => {
                seenKeys = Map()
                seenByCase[caseName] = seenKeys
            })
            seenKeys.containsKey(key).ifTrue(() => {
                fail()
            })
            seenKeys[key] = true

            declarations = Array(
                ...declarations,
                declaration(caseName, requirementValue)
            )
        })
    })

    frozenTuple(...declarations)
}
// TOOL002-I6D: D091 strict full-TestPlan referential join.
//
// `plan` is the complete associated TestPlan. Every declaration must resolve to
// exactly one existing CaseSpec before any later filtering/sharding stage. The
// requirements document cannot create cases; output case order/cardinality are
// inherited from the complete input plan.
attachToPlan: (plan, declarations) => {
    cases: Manifest.planCases(plan)
    caseById: Map()
    ambiguousCaseIds: Map()

    cases.each((spec) => {
        id: Manifest.caseId(spec)
        caseById.containsKey(id).ifTrue(() => {
            ambiguousCaseIds[id] = true
        })
        caseById.containsKey(id).ifFalse(() => {
            caseById[id] = spec
        })
    })

    requirementsByCase: Map()
    declarations.each((declarationValue) => {
        id: declarationCase(declarationValue)

        caseById.containsKey(id).ifFalse(() => {
            fail()
        })
        ambiguousCaseIds.containsKey(id).ifTrue(() => {
            fail()
        })

        attached: Array()
        requirementsByCase.containsKey(id).ifTrue(() => {
            attached = requirementsByCase[id]
        })
        attached = Array(...attached, declarationRequirement(declarationValue))
        requirementsByCase[id] = attached
    })

    joinedCases: Array()
    cases.each((spec) => {
        id: Manifest.caseId(spec)
        attached: Array()
        requirementsByCase.containsKey(id).ifTrue(() => {
            attached = requirementsByCase[id]
        })
        joinedCases = Array(
            ...joinedCases,
            Manifest.caseSpecWithRequirements(spec, attached)
        )
    })

    frozenTuple(frozenTuple(...joinedCases))
}

// TOOL002-I6E: D094 exact corpus-root resource-requirements sidecar acquisition.
//
// This remains a private Test Tool planning helper. Public Main wiring stays
// deferred until D076 resource admission/reservation can prevent a resourceful
// CaseSpec from starting without its complete required-resource reservation.
readCorpusRequirementsText: (filesystem) => {
    file: filesystem.open(
        Path.relative().child("resource-requirements.toml")
    ).value()
    reader: TextReader.owning(file, Encoding.UTF8)
    text: ""

    readNext: null
    readNext = () => {
        chunk: reader.readText().value()
        (chunk === null).ifFalse(() => {
            text = text + chunk
            readNext()
        })
    }

    Error.handle(() => {
        readNext()
    }, (error) => {
        reader.close().value()
        error.signal()
    })

    reader.close().value()
    text
}

// Discover only the exact direct child selected by D094. True absence preserves
// the supplied complete TestPlan unchanged. Presence is fail-closed: the exact
// entry must be a regular file, and every later open/read/TOML/schema/D091 join
// failure propagates rather than being reinterpreted as absence.
loadFromCorpus: (filesystem, plan) => {
    entries: filesystem.entries(Path.relative()).value()
    present: false
    presentKind: null

    entries.each((entry) => {
        (entry.name == "resource-requirements.toml").ifTrue(() => {
            present.ifTrue(() => {
                fail()
            })
            present = true
            presentKind = entry.kind
        })
    })

    result: plan
    present.ifTrue(() => {
        (presentKind == "regular").ifFalse(() => {
            fail()
        })

        text: readCorpusRequirementsText(filesystem)
        declarations: parse(text)
        result = attachToPlan(plan, declarations)
    })
    result
}
