Arrays: import("std:collections/Array")
Discovery: import("self:Discovery")
CasePlan: import("self:LogicalCasePlan")

run: (
    projections,
    sourceLoader,
    executorAsync,
    maxInFlight,
    lifecycleObserver = null
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        fail()
    })
    (maxInFlight > 0).ifFalse(() => {
        fail()
    })

    workItems: Array()

    projections.each((projection) => {
        signature:
            Discovery.projectionSignature(
                projection
            )

        cases:
            Discovery.projectionPlan(
                projection
            )

        sourceItems:
            Arrays.map(cases, (entry) => {
                item: Array(signature, entry)
                item.freeze()
            })

        workItems =
            Array(
                ...workItems,
                ...sourceItems
            )
    })

    workItems.freeze()

    results:
        Arrays.map(workItems, (ignored) => {
            null
        })

    nextIndex: 0

    runLane: () => {
        (() => nextIndex < workItems.size()).while(() => {
            index: nextIndex
            nextIndex = nextIndex + 1

            item: workItems[index]
            signature: item[0]
            entry: item[1]
            source: sourceLoader(entry)

            (lifecycleObserver === null).ifFalse(() => {
                lifecycleObserver(
                    "started",
                    entry,
                    null
                )
            })

            completion:
                executorAsync(
                    CasePlan.sourceAssociation(entry),
                    source,
                    signature,
                    CasePlan.selector(entry)
                ).value()

            (lifecycleObserver === null).ifFalse(() => {
                lifecycleObserver(
                    "terminal",
                    entry,
                    completion
                )
            })

            results[index] = completion
        })

        null
    }

    laneCount: maxInFlight
    (laneCount > workItems.size()).ifTrue(() => {
        laneCount = workItems.size()
    })

    lanes: Array()

    laneIndex: 0
    (() => laneIndex < laneCount).while(() => {
        lanes = Array(
            ...lanes,
            runLane.future()
        )
        laneIndex = laneIndex + 1
    })

    Future.all(...lanes).then((ignored) => {
        results.freeze()
    })
}
