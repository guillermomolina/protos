Arrays: import("std:collections/Array")
Discovery: import("self:Discovery")
CasePlan: import("self:LogicalCasePlan")

// `completionObserver`, when supplied, is called `(index, completion)` the
// instant one logical Case crosses this runner's terminal barrier, using the
// same stable logical `index` this Case occupies in the returned `results`
// array. It is the narrow, presentation-neutral counterpart of the D120
// `terminalObserver` seam already established on the D108 path in
// `Runner.protos`: it exists so a caller can drive incremental progress
// while physical executions are still in flight, without waiting for
// `results` to be complete and without changing the stable logical index
// each completion is stored at.
//
// BUG020: a logical Case whose execution Future fails instead of producing a
// completion still crosses the terminal barrier, as an "execution-error"
// completion carrying that Error, so the Case stays attributable and the
// remaining Cases keep running. Cancellation is not a Case outcome and
// propagates unchanged.
executionErrorCompletion: (error) => {
    observation: {
        state: "failed"
        error: error
    }
    observation.freeze()

    completion: {
        phase: "execution-error"
        observation: observation
    }
    completion.freeze()
}

run: (
    projections,
    executorAsync,
    maxInFlight,
    lifecycleObserver = null,
    completionObserver = null
) => {
    Integer.recognizes(maxInFlight).ifFalse(() => {
        fail()
    })
    (maxInFlight > 0).ifFalse(() => {
        fail()
    })

    workItems: Array()

    projections.each((projection) => {
        signature:
            Discovery.projectionSignature(
                projection
            )

        cases:
            Discovery.projectionPlan(
                projection
            )

        sourceItems:
            Arrays.map(cases, (entry) => {
                item: Array(signature, entry)
                item.freeze()
            })

        workItems =
            Array(
                ...workItems,
                ...sourceItems
            )
    })

    workItems.freeze()

    results:
        Arrays.map(workItems, (ignored) => {
            null
        })

    nextIndex: 0

    runLane: () => {
        (() => nextIndex < workItems.size()).whileTrue(() => {
            index: nextIndex
            nextIndex = nextIndex + 1

            item: workItems[index]
            (signature, entry): item

            (lifecycleObserver === null).ifFalse(() => {
                lifecycleObserver(
                    "started",
                    entry,
                    null
                )
            })

            completion: null

            Error.handle(() => {
                completion =
                    executorAsync(
                        CasePlan.sourceAssociation(entry),
                        signature,
                        CasePlan.selector(entry)
                    ).value()
            }, (error) => {
                (error.parent() === Cancelled).ifTrue(() => {
                    error.signal()
                })

                completion = executionErrorCompletion(error)
            })

            (lifecycleObserver === null).ifFalse(() => {
                lifecycleObserver(
                    "terminal",
                    entry,
                    completion
                )
            })

            (completionObserver === null).ifFalse(() => {
                completionObserver(
                    index,
                    completion
                )
            })

            results[index] = completion
        })

        null
    }

    laneCount: maxInFlight
    (laneCount > workItems.size()).ifTrue(() => {
        laneCount = workItems.size()
    })

    lanes: Array()

    laneIndex: 0
    (() => laneIndex < laneCount).whileTrue(() => {
        lanes = Array(
            ...lanes,
            runLane.future()
        )
        laneIndex = laneIndex + 1
    })

    Future.all(...lanes).then((ignored) => {
        results.freeze()
    })
}
