fail: () => {
    Error().signal()
}

// Rest capture is a fresh frozen standard Array. D2 uses that existing Core
// semantic to materialize inert plan data without Java-owned CaseSpec/TestPlan
// representations.
frozenTuple: (...items) => {
    items
}

splitFields: (line) => {
    source: Encoding.UTF8.encode(line)
    fields: Array()
    field: Encoding.UTF8.encode("")

    source.each((octet) => {
        (octet == 9).ifTrue(() => {
            fields = Array(...fields, Encoding.UTF8.decode(field))
            field = Encoding.UTF8.encode("")
        })
        (octet == 9).ifFalse(() => {
            field.add(octet)
        })
    })

    Array(...fields, Encoding.UTF8.decode(field))
}

fieldArray: (line) => {
    fields: splitFields(line)
    (fields.size() == 3).ifFalse(() => {
        fail()
    })
    fields
}

packageTomlFieldArray: (line) => {
    fields: splitFields(line)
    (fields.size() == 2).ifFalse(() => {
        fail()
    })
    fields
}

pathValue: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 0).ifTrue(() => {
        fail()
    })

    path: Path.relative()
    component: Encoding.UTF8.encode("")

    finishComponent: () => {
        (component.size() == 0).ifTrue(() => {
            fail()
        })
        name: Encoding.UTF8.decode(component)
        invalid: name == "."
        (name == "..").ifTrue(() => {
            invalid = true
        })
        invalid.ifTrue(() => {
            fail()
        })
        path = path.child(name)
        component = Encoding.UTF8.encode("")
    }

    source.each((octet) => {
        invalid: octet == 0
        (octet == 92).ifTrue(() => {
            invalid = true
        })
        invalid.ifTrue(() => {
            fail()
        })

        (octet == 47).ifTrue(() => {
            finishComponent()
        })
        (octet == 47).ifFalse(() => {
            component.add(octet)
        })
    })

    finishComponent()
    path
}

// Private CaseSpec tuple layout. Consumers use the named accessors below.
caseSpec: (fields) => {
    path: fields[0]
    ignoredCanonicalValidation: pathValue(path)
    expectation: fields[1]
    expected: fields[2]

    (expectation.size() == 0).ifTrue(() => {
        fail()
    })

    frozenTuple(path, path, expectation, expected)
}

packageTomlCaseSpec: (fields) => {
    path: fields[0]
    ignoredCanonicalValidation: pathValue(path)
    retainedExpectation: fields[1]

    expectation: ""
    expected: ""
    known: false

    (retainedExpectation == "true").ifTrue(() => {
        expectation = "boolean"
        expected = "true"
        known = true
    })
    (retainedExpectation == "error").ifTrue(() => {
        expectation = "error"
        expected = "-"
        known = true
    })
    known.ifFalse(() => {
        fail()
    })

    caseId: "package-tool/toml-syntax/" + path
    frozenTuple(caseId, path, expectation, expected)
}

caseId: (spec) => {
    spec[0]
}

casePath: (spec) => {
    spec[1]
}

caseExpectation: (spec) => {
    spec[2]
}

caseExpected: (spec) => {
    spec[3]
}

parseLine: (line) => {
    bytes: Encoding.UTF8.encode(line)
    ignore: bytes.size() == 0
    ignore.ifFalse(() => {
        (bytes[0] == 35).ifTrue(() => {
            ignore = true
        })
    })

    result: null
    ignore.ifFalse(() => {
        result = caseSpec(fieldArray(line))
    })
    result
}

parsePackageTomlLine: (line) => {
    bytes: Encoding.UTF8.encode(line)
    ignore: bytes.size() == 0
    ignore.ifFalse(() => {
        (bytes[0] == 35).ifTrue(() => {
            ignore = true
        })
    })

    result: null
    ignore.ifFalse(() => {
        result = packageTomlCaseSpec(packageTomlFieldArray(line))
    })
    result
}

planCases: (plan) => {
    plan[0]
}

loadWithParser: (filesystem, parser) => {
    file: filesystem.open(Path.relative().child("manifest.tsv")).value()
    reader: TextReader.owning(file, Encoding.UTF8)

    chunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: chunks.containsKey(level)
        present.ifTrue(() => {
            left: chunks[level]
            chunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        })
        present.ifFalse(() => {
            chunks[level] = chunk
            (level > maxChunkLevel).ifTrue(() => {
                maxChunkLevel = level
            })
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        (level >= 0).ifTrue(() => {
            nextResult: result
            chunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...chunks[level])
            })
            finalResult = collectChunks(level - 1, nextResult)
        })
        finalResult
    }

    // Issue a bounded window of ordered readLine operations at once. TextReader
    // preserves invocation order for outstanding reads, and Future.all gives one
    // suspension/aggregation point for the complete window. This turns the former
    // one-recursive-frame-per-row traversal into one frame per 512 rows while
    // preserving readLine's LF/CR/CRLF framing and maxBytes semantics.
    batchTemplate: Array(null)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)

    done: false
    readBatch: null
    readBatch = () => {
        pending: Array(...batchTemplate)
        issueIndex: 0
        batchTemplate.each((ignored) => {
            pending[issueIndex] = reader.readLine(65536)
            issueIndex = issueIndex + 1
        })

        lines: Future.all(...pending).value()
        lines.each((line) => {
            done.ifFalse(() => {
                (line === null).ifTrue(() => {
                    done = true
                })
                (line === null).ifFalse(() => {
                    parsed: parser(line)
                    (parsed === null).ifFalse(() => {
                        carryChunk(Array(parsed), 0)
                    })
                })
            })
        })

        done.ifFalse(() => {
            readBatch()
        })
    }

    readBatch()
    reader.close().value()

    cases: frozenTuple(...collectChunks(maxChunkLevel, Array()))
    frozenTuple(cases)
}

load: (filesystem) => {
    loadWithParser(filesystem, parseLine)
}

loadPackageToml: (filesystem) => {
    loadWithParser(filesystem, parsePackageTomlLine)
}
