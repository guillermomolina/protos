fail: () => {
    Error().signal()
}

// Rest capture is a fresh frozen standard Array. D2 uses that existing Core
// semantic to materialize inert plan data without Java-owned CaseSpec/TestPlan
// representations.
frozenTuple: (...items) => {
    items
}

splitFields: (line) => {
    source: Encoding.UTF8.encode(line)
    fields: Array()
    field: Encoding.UTF8.encode("")

    source.each((octet) => {
        (octet == 9).ifTrue(() => {
            fields = Array(...fields, Encoding.UTF8.decode(field))
            field = Encoding.UTF8.encode("")
        })
        (octet == 9).ifFalse(() => {
            field.add(octet)
        })
    })

    Array(...fields, Encoding.UTF8.decode(field))
}

fieldArray: (line) => {
    fields: splitFields(line)
    (fields.size() == 3).ifFalse(() => {
        fail()
    })
    fields
}

packageTomlFieldArray: (line) => {
    fields: splitFields(line)
    (fields.size() == 2).ifFalse(() => {
        fail()
    })
    fields
}

pathValue: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 0).ifTrue(() => {
        fail()
    })

    path: Path.relative()
    component: Encoding.UTF8.encode("")

    finishComponent: () => {
        (component.size() == 0).ifTrue(() => {
            fail()
        })
        name: Encoding.UTF8.decode(component)
        invalid: name == "."
        (name == "..").ifTrue(() => {
            invalid = true
        })
        invalid.ifTrue(() => {
            fail()
        })
        path = path.child(name)
        component = Encoding.UTF8.encode("")
    }

    source.each((octet) => {
        invalid: octet == 0
        (octet == 92).ifTrue(() => {
            invalid = true
        })
        invalid.ifTrue(() => {
            fail()
        })

        (octet == 47).ifTrue(() => {
            finishComponent()
        })
        (octet == 47).ifFalse(() => {
            component.add(octet)
        })
    })

    finishComponent()
    path
}

// Private CaseSpec tuple layout. Consumers use the named accessors below.
caseSpec: (fields) => {
    path: fields[0]
    ignoredCanonicalValidation: pathValue(path)
    expectation: fields[1]
    expected: fields[2]

    (expectation.size() == 0).ifTrue(() => {
        fail()
    })

    frozenTuple(path, path, expectation, expected, frozenTuple())
}

packageTomlCaseSpec: (fields) => {
    path: fields[0]
    ignoredCanonicalValidation: pathValue(path)
    retainedExpectation: fields[1]

    expectation: ""
    expected: ""
    known: false

    (retainedExpectation == "true").ifTrue(() => {
        expectation = "boolean"
        expected = "true"
        known = true
    })
    (retainedExpectation == "error").ifTrue(() => {
        expectation = "error"
        expected = "-"
        known = true
    })
    known.ifFalse(() => {
        fail()
    })

    caseId: "package-tool/toml-syntax/" + path
    frozenTuple(caseId, path, expectation, expected, frozenTuple())
}

caseId: (spec) => {
    spec[0]
}

casePath: (spec) => {
    spec[1]
}

caseExpectation: (spec) => {
    spec[2]
}

caseExpected: (spec) => {
    spec[3]
}

caseRequirements: (spec) => {
    spec[4]
}

isResourceKeyStartOctet: (octet) => {
    ((octet >= 97) && (octet <= 122)) ||
        ((octet >= 48) && (octet <= 57))
}

isResourceKeyTailOctet: (octet) => {
    isResourceKeyStartOctet(octet) ||
        (octet == 46) ||
        (octet == 95) ||
        (octet == 45)
}

// D077 canonical resource key: segment[/segment...]. Each segment begins with
// lower-case ASCII letter/digit and continues with lower-case ASCII, digit,
// '.', '_' or '-'. Slash is namespace structure only; empty segments fail.
resourceKeyValue: (key) => {
    source: Encoding.UTF8.encode(key)
    size: source.size()
    (size == 0).ifTrue(() => {
        fail()
    })

    segmentStart: true
    index: 0
    (() => index < size).while() {
        octet: source[index]

        (octet == 47).ifTrue(() => {
            segmentStart.ifTrue(() => {
                fail()
            })
            segmentStart = true
        })

        (octet == 47).ifFalse(() => {
            allowed: false
            segmentStart.ifTrue(() => {
                allowed = isResourceKeyStartOctet(octet)
            })
            segmentStart.ifFalse(() => {
                allowed = isResourceKeyTailOctet(octet)
            })
            allowed.ifFalse(() => {
                fail()
            })
            segmentStart = false
        })

        index = index + 1
    }

    segmentStart.ifTrue(() => {
        fail()
    })
    key
}

validateRequirementModeUnits: (mode, units) => {
    // Exercise the strict semantic String receiver domain without converting
    // the mode value. Unknown canonical String modes still fail below.
    ignoredModeStringValidation: mode + ""
    known: false

    (mode == "shared").ifTrue(() => {
        // Core Integer.div has the strict ordinary-unbounded-Integer receiver
        // domain already used by the Standard Library for family validation.
        // It rejects Float, fixed-width values and delegated lookalikes without
        // converting the supplied units.
        units.div(1)
        (units <= 0).ifTrue(() => {
            fail()
        })
        known = true
    })

    (mode == "exclusive").ifTrue(() => {
        (units === null).ifFalse(() => {
            fail()
        })
        known = true
    })

    known.ifFalse(() => {
        fail()
    })
    true
}

// Private inert Requirement tuple selected by D077. I3 validates the canonical
// resource key and I4 validates only the already-ratified mode/units shape.
// CaseSpec attachment and persistent materialization remain later I slices.
requirement: (key, mode, units) => {
    validatedKey: resourceKeyValue(key)
    validateRequirementModeUnits(mode, units)
    frozenTuple(validatedKey, mode, units)
}

requirementKey: (requirement) => {
    requirement[0]
}

requirementMode: (requirement) => {
    requirement[1]
}

requirementUnits: (requirement) => {
    requirement[2]
}

parseLine: (line) => {
    bytes: Encoding.UTF8.encode(line)
    ignore: bytes.size() == 0
    ignore.ifFalse(() => {
        (bytes[0] == 35).ifTrue(() => {
            ignore = true
        })
    })

    result: null
    ignore.ifFalse(() => {
        result = caseSpec(fieldArray(line))
    })
    result
}

parsePackageTomlLine: (line) => {
    bytes: Encoding.UTF8.encode(line)
    ignore: bytes.size() == 0
    ignore.ifFalse(() => {
        (bytes[0] == 35).ifTrue(() => {
            ignore = true
        })
    })

    result: null
    ignore.ifFalse(() => {
        result = packageTomlCaseSpec(packageTomlFieldArray(line))
    })
    result
}

planCases: (plan) => {
    plan[0]
}

loadWithParser: (filesystem, parser) => {
    file: filesystem.open(Path.relative().child("manifest.tsv")).value()
    reader: TextReader.owning(file, Encoding.UTF8)

    chunks: Map()
    maxChunkLevel: -1

    carryChunk: null
    carryChunk = (chunk, level) => {
        present: chunks.containsKey(level)
        present.ifTrue(() => {
            left: chunks[level]
            chunks.remove(level)
            carryChunk(Array(...left, ...chunk), level + 1)
        })
        present.ifFalse(() => {
            chunks[level] = chunk
            (level > maxChunkLevel).ifTrue(() => {
                maxChunkLevel = level
            })
        })
    }

    collectChunks: null
    collectChunks = (level, result) => {
        finalResult: result
        (level >= 0).ifTrue(() => {
            nextResult: result
            chunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...chunks[level])
            })
            finalResult = collectChunks(level - 1, nextResult)
        })
        finalResult
    }

    // Issue a bounded window of ordered readLine operations at once. TextReader
    // preserves invocation order for outstanding reads, and Future.all gives one
    // suspension/aggregation point for the complete window. This turns the former
    // one-recursive-frame-per-row traversal into one frame per 512 rows while
    // preserving readLine's LF/CR/CRLF framing and maxBytes semantics.
    batchTemplate: Array(null)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)
    batchTemplate = Array(...batchTemplate, ...batchTemplate)

    done: false
    readBatch: null
    readBatch = () => {
        pending: Array(...batchTemplate)
        issueIndex: 0
        batchTemplate.each((ignored) => {
            pending[issueIndex] = reader.readLine(65536)
            issueIndex = issueIndex + 1
        })

        lines: Future.all(...pending).value()
        lines.each((line) => {
            done.ifFalse(() => {
                (line === null).ifTrue(() => {
                    done = true
                })
                (line === null).ifFalse(() => {
                    parsed: parser(line)
                    (parsed === null).ifFalse(() => {
                        carryChunk(Array(parsed), 0)
                    })
                })
            })
        })

        done.ifFalse(() => {
            readBatch()
        })
    }

    readBatch()
    reader.close().value()

    cases: frozenTuple(...collectChunks(maxChunkLevel, Array()))
    frozenTuple(cases)
}

load: (filesystem) => {
    loadWithParser(filesystem, parseLine)
}

loadPackageToml: (filesystem) => {
    loadWithParser(filesystem, parsePackageTomlLine)
}
