//! TOOL005-B2 explicit Test Tool membership for existing Standard Library corpora.
//! No filesystem discovery is used.
//!
//! TOOL009-C: every case in these seven corpora is now `suite-native`; the
//! authoritative test behavior lives in each source's own `std:test/Test`
//! declaration (D152/D153/LIB018/D155), not in this manifest's expectation
//! column.

Manifest: import("self:Manifest")

planFromEntries: (prefix, entries) => {
    cases: Array()
    entries.each((entry) => {
        cases = Array(
            ...cases,
            Manifest.caseSpec(
                Array(
                    prefix + entry[0],
                    entry[1],
                    entry[2]
                )
            )
        )
    })
    cases.freeze()
    plan: Array(cases)
    plan.freeze()
    plan
}

load: (corpusId) => {
    selected: null
    matched: false

    if(corpusId == "protos/corpus/library/uri") {
        selected = planFromEntries(
            "uri/",
            Array(
            Array("parse.protos", "suite-native", "-"),
            Array("format.protos", "suite-native", "-"),
            Array("resolve.protos", "suite-native", "-")
            )
        )
        matched = true
    }

    if(corpusId == "protos/corpus/library/csv") {
        selected = planFromEntries(
            "csv/",
            Array(
            Array("parse.protos", "suite-native", "-"),
            Array("encode.protos", "suite-native", "-"),
            Array("row-parser.protos", "suite-native", "-"),
            Array("text-adapter.protos", "suite-native", "-"),
            Array("integration-and-scale.protos", "suite-native", "-")
            )
        )
        matched = true
    }

    if(corpusId == "protos/corpus/library/cli") {
        selected = planFromEntries(
            "cli/",
            Array(
