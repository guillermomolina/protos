//! TOOL005-B2 explicit Test Tool membership for existing Standard Library corpora.
//! No filesystem discovery is used.
//!
//! TOOL009-C: every case in every corpus of this module is `suite-native`; the
//! authoritative test behavior lives in each source's own `std:test/test`
//! declaration (D152/D153/LIB018/D155), not in this manifest's expectation
//! column.
//!
//! TEST010: membership stays explicit. A new suite-native source joins its
//! corpus only through an entry here; RepositoryCorpusAudit rejects a source
//! left out of, stale in, or repeated in these plans.

Manifest: import("./Manifest.protos")

planFromEntries: (prefix, entries) => {
    cases: Array()
    for(entry in entries) {
        cases = Array(
            ...cases,
            Manifest.caseSpec(
                Array(
                    prefix + entry[0],
                    entry[1],
                    entry[2]
                )
            )
        )
    }
    cases.freeze()
    plan: Array(cases)
    plan.freeze()
    plan
}

load: (corpusId) => {
    selected: null
    matched: false

    if(corpusId == "protos/corpus/library/uri") {
        selected = planFromEntries(
            "uri/",
            Array(
            Array("parse.protos", "suite-native", "-"),
            Array("format.protos", "suite-native", "-"),
            Array("resolve.protos", "suite-native", "-")
            )
        )
        matched = true
    }

    if(corpusId == "protos/corpus/library/csv") {
