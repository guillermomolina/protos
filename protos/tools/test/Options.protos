optionError: () => {
    Error().signal()
}

parsePositiveInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 0).ifTrue(() => { optionError() })

    value: 0
    source.each((octet) => {
        digit: (octet >= 48) && (octet <= 57)
        digit.ifFalse(() => { optionError() })
        value = value * 10 + (octet - 48)
    })

    (value > 0).ifFalse(() => { optionError() })
    value
}

// TOOL002-I7B3A: D069/D099 coordinated Test Tool option traversal.
//
// Both public selectors derive from one parser contract that recognizes both
// value-bearing options. A consumed value token is literal and is never
// reinterpreted by the other option merely because it begins with "-".
parse: (arguments) => {
    jobsValue: 1
    jobsSeen: false
    resourceCatalogPathValue: null
    resourceCatalogSeen: false

    // 0 = no pending value, 1 = --jobs value, 2 = --resource-catalog PATH.
    expectingValue: 0

    arguments.each((argument) => {
        wasExpectingValue: expectingValue

        (wasExpectingValue == 1).ifTrue(() => {
            jobsValue = parsePositiveInteger(argument)
            expectingValue = 0
        })

        (wasExpectingValue == 2).ifTrue(() => {
            resourceCatalogPathValue = argument
            expectingValue = 0
        })

        (wasExpectingValue == 0).ifTrue(() => {
            (argument === "--jobs").ifTrue(() => {
                jobsSeen.ifTrue(() => { optionError() })
                jobsSeen = true
                expectingValue = 1
            })

            (argument === "--resource-catalog").ifTrue(() => {
                resourceCatalogSeen.ifTrue(() => { optionError() })
                resourceCatalogSeen = true
                expectingValue = 2
            })
        })
    })

    (expectingValue == 0).ifFalse(() => { optionError() })
    Array(jobsValue, resourceCatalogPathValue)
}

// D069: one positive logical Test Tool capacity value, defaulting to one.
// Unknown arguments remain ignored exactly as before.
jobs: (arguments) => {
    parse(arguments)[0]
}

// D099/D101: zero or one explicit --resource-catalog PATH selection.
// PATH is returned verbatim; host path interpretation stays behind catalogAcquirer.
resourceCatalogPath: (arguments) => {
    parse(arguments)[1]
}
