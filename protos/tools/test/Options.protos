CommandLine: import("std:cli/CommandLine")

optionError: () => {
    Error().signal()
}

parsePositiveInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    if(source.size() == 0) { optionError() }

    value: 0
    source.each((octet) => {
        digit: (octet >= 48) && (octet <= 57)
        digit.ifFalse(() => { optionError() })
        value = value * 10 + (octet - 48)
    })

    (value > 0).ifFalse(() => { optionError() })
    value
}

jobsOption: CommandLine.option({
    key: "jobs"
    long: "jobs"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "N"
    help: null
})

resourceCatalogOption: CommandLine.option({
    key: "resourceCatalog"
    long: "resource-catalog"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: 1
    valueName: "PATH"
    help: null
})

fileOption: CommandLine.option({
    key: "file"
    long: "file"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: null
    valueName: "FILE"
    help: null
})

directoryOption: CommandLine.option({
    key: "directory"
    long: "directory"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: null
    valueName: "DIR"
    help: null
})

// D185 Case discovery listing flag and repeatable exact CaseRef selector.
listCasesOption: CommandLine.option({
    key: "listCases"
    long: "list-cases"
    short: null
    minValues: 0
    maxValues: 0
    minOccurrences: 0
    maxOccurrences: 1
    valueName: null
    help: null
})

caseOption: CommandLine.option({
    key: "case"
    long: "case"
    short: null
    minValues: 1
    maxValues: 1
    minOccurrences: 0
    maxOccurrences: null
    valueName: "CASE_REF"
    help: null
})

commandSpec: CommandLine.command({
    name: "test"
    help: null
    options: [
        jobsOption,
        resourceCatalogOption,
        fileOption,
        directoryOption,
        listCasesOption,
        caseOption
    ]
    positionals: []
    subcommands: []
})

// LIB011-E adapter boundary.
//
// Generic CommandLine parsing stays strict. TOOL002 historically ignores every
// argument except selected exact separate-token option/value forms. Preserve
// that Tool-owned policy by projecting only those recognized option/value token
// pairs before invoking the strict stdlib parser.
//
// A selected value token is projected literally and is never reinterpreted as a
// second option merely because it begins with "-". Unknown tokens, including
// "--", attached forms such as --jobs=3 and future foreign options, remain
// ignored exactly as before. The selected value-less --list-cases flag is
// projected alone.
projectArguments: (arguments) => {
    newBuilder: () => {
        {
            chunks: Map()
            maxLevel: -1
        }
    }

    carryChunk: null
    carryChunk = (builder, chunk, level) => {
        present: builder.chunks.containsKey(level)

        if(present) {
            left: builder.chunks[level]
            builder.chunks.remove(level)
            carryChunk(builder, Array(...left, ...chunk), level + 1)
        }

        present.ifFalse(() => {
            builder.chunks[level] = chunk
            if(level > builder.maxLevel) {
                builder.maxLevel = level
            }
        })
    }

    appendBuilt: (builder, value) => {
        carryChunk(builder, Array(value), 0)
    }

    collectChunks: null
    collectChunks = (builder, level, result) => {
        finalResult: result

        if(level >= 0) {
            nextResult: result
            if(builder.chunks.containsKey(level)) {
                nextResult = Array(...result, ...builder.chunks[level])
            }
            finalResult = collectChunks(builder, level - 1, nextResult)
        }

        finalResult
    }

    builder: newBuilder()
    expectingSelectedValue: false

    arguments.each((argument) => {
        wasExpectingSelectedValue: expectingSelectedValue

        if(wasExpectingSelectedValue) {
            appendBuilt(builder, argument)
            expectingSelectedValue = false
        }

        wasExpectingSelectedValue.ifFalse(() => {
            selected:
                (argument === "--jobs") ||
                (argument === "--resource-catalog") ||
                (argument === "--file") ||
                (argument === "--directory") ||
                (argument === "--case")

            if(selected) {
                appendBuilt(builder, argument)
                expectingSelectedValue = true
            }

            if(argument === "--list-cases") {
                appendBuilt(builder, argument)
            }
        })
    })

    collectChunks(builder, builder.maxLevel, Array())
}

// D069/D099/D101 coordinated Test Tool option interpretation.
//
// LIB011 now owns structural recognition, separate-value literal consumption,
// occurrence/value cardinality and missing-value rejection according to each
// projected option specification. TOOL002 retains:
// - unknown-argument policy through projectArguments;
// - D069 positive-Integer conversion/default;
// - D099/D101 resource-catalog absence and exact PATH selection.
parse: (arguments) => {
    parsed: CommandLine.parse(commandSpec, projectArguments(arguments))

    jobsValue: 1
    resourceCatalogPathValue: null
    filePathValues: []
    directoryPathValues: []
    listCasesValue: false
    caseRefValues: []

    parsed.command.options.each((occurrence) => {
        if(occurrence.key == "jobs") {
            jobsValue = parsePositiveInteger(occurrence.value)
        }

        if(occurrence.key == "resourceCatalog") {
            resourceCatalogPathValue = occurrence.value
        }

        if(occurrence.key == "file") {
            filePathValues = [
                ...filePathValues,
                occurrence.value
            ]
        }

        if(occurrence.key == "directory") {
            directoryPathValues = [
                ...directoryPathValues,
                occurrence.value
            ]
        }

        if(occurrence.key == "listCases") {
            listCasesValue = true
        }

        if(occurrence.key == "case") {
            caseRefValues = [
                ...caseRefValues,
                occurrence.value
            ]
        }
    })

    filePathValues.freeze()
    directoryPathValues.freeze()
    caseRefValues.freeze()

    [
        jobsValue,
        resourceCatalogPathValue,
        filePathValues,
        directoryPathValues,
        listCasesValue,
        caseRefValues
    ]
}

// D069: one positive logical Test Tool capacity value, defaulting to one.
// Unknown arguments remain ignored exactly as before.
jobs: (arguments) => {
    parse(arguments)[0]
}

// D099/D101: zero or one explicit --resource-catalog PATH selection.
// PATH is returned verbatim; host path interpretation stays behind catalogAcquirer.
resourceCatalogPath: (arguments) => {
    parse(arguments)[1]
}

// TOOL009 focal selector input. Locator interpretation and source authority
// remain outside this module.
filePaths: (arguments) => {
    parse(arguments)[2]
}

directoryPaths: (arguments) => {
    parse(arguments)[3]
}

// D185: --list-cases projects the authoritative CasePlan instead of executing it.
listCases: (arguments) => {
    parse(arguments)[4]
}

// D185 exact CaseRef selectors in CLI order. CLI order never defines plan
// order; ref validation and resolution stay with CaseSelection.
caseRefs: (arguments) => {
    parse(arguments)[5]
}
