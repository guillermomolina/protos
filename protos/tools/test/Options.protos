optionError: () => {
    Error().signal()
}

parsePositiveInteger: (text) => {
    source: Encoding.UTF8.encode(text)
    (source.size() == 0).ifTrue(() => { optionError() })

    value: 0
    source.each((octet) => {
        digit: (octet >= 48) && (octet <= 57)
        digit.ifFalse(() => { optionError() })
        value = value * 10 + (octet - 48)
    })

    (value > 0).ifFalse(() => { optionError() })
    value
}

// D069: --jobs is one positive logical Test Tool capacity value. Unknown
// arguments remain outside this bounded slice so H2B3 does not invent a second
// Test Tool option policy.
jobs: (arguments) => {
    result: 1
    seen: false
    expectingValue: false

    // process.args() is an ordinary canonical Array snapshot. Traverse it with
    // the retained Array.each contract instead of adding an index/while parser.
    arguments.each((argument) => {
        expectingValue.ifTrue(() => {
            result = parsePositiveInteger(argument)
            expectingValue = false
        })

        expectingValue.ifFalse(() => {
            (argument === "--jobs").ifTrue(() => {
                seen.ifTrue(() => { optionError() })
                seen = true
                expectingValue = true
            })
        })
    })

    expectingValue.ifTrue(() => { optionError() })
    result
}

// TOOL002-I7B1: D099/D101 bundled-Protos ownership of the optional resource
// catalog source selector. This slice owns only option spelling/cardinality and
// exact PATH selection. Host acquisition authority remains I7B2.
resourceCatalogPath: (arguments) => {
    result: null
    seen: false
    expectingValue: false

    arguments.each((argument) => {
        // Snapshot the parser state before mutating it so the PATH token is
        // consumed literally and is not reinterpreted as another option even
        // when it begins with "-".
        wasExpectingValue: expectingValue

        wasExpectingValue.ifTrue(() => {
            result = argument
            expectingValue = false
        })

        wasExpectingValue.ifFalse(() => {
            (argument === "--resource-catalog").ifTrue(() => {
                seen.ifTrue(() => { optionError() })
                seen = true
                expectingValue = true
            })
        })
    })

    expectingValue.ifTrue(() => { optionError() })
    result
}
