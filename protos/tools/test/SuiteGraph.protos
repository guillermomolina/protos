//! D122 Candidate F generation-1 inert suite-graph descriptors.

fail: () => {
    Error().signal()
}

validateString: (value) => {
    validated: "" + value
    (validated === value).ifFalse(() => {
        fail()
    })
    value
}

validateId: (value) => {
    validateString(value)
    (value == "").ifTrue(() => {
        fail()
    })
    value
}

validateArray: (value) => {
    (value.parent() === Array).ifFalse(() => {
        fail()
    })
    value
}

/// Creates one inert corpus-leaf descriptor.
leaf: (id) => {
    idValue: validateId(id)
    childrenValue: Array()
    childrenValue.freeze()

    descriptor: {
        kind: "leaf"
        id: idValue
        children: childrenValue
    }
    descriptor.freeze()
}

/// Creates one inert explicit suite-composition descriptor.
suite: (id, children) => {
    idValue: validateId(id)
    validateArray(children)

    childrenValue: Array(...children)
    childrenValue.freeze()

    descriptor: {
        kind: "suite"
        id: idValue
        children: childrenValue
    }
    descriptor.freeze()
}

/// Validates one complete explicit graph and returns leaf IDs in declaration order.
flattenLeafIds: (root) => {
    ids: Map()
    visiting: IdentityMap()

    newBuilder: () => {
        {
            chunks: Map()
            maxLevel: -1
        }
    }

    carryChunk: null
    carryChunk = (builder, chunk, level) => {
        present: builder.chunks.containsKey(level)

        present.ifTrue(() => {
            left: builder.chunks[level]
            builder.chunks.remove(level)
            carryChunk(builder, Array(...left, ...chunk), level + 1)
        })

        present.ifFalse(() => {
            builder.chunks[level] = chunk
            (level > builder.maxLevel).ifTrue(() => {
                builder.maxLevel = level
            })
        })
    }

    appendBuilt: (builder, value) => {
        carryChunk(builder, Array(value), 0)
    }

    collectChunks: null
    collectChunks = (builder, level, result) => {
        finalResult: result

        (level >= 0).ifTrue(() => {
            nextResult: result
            builder.chunks.containsKey(level).ifTrue(() => {
                nextResult = Array(...result, ...builder.chunks[level])
            })
            finalResult = collectChunks(builder, level - 1, nextResult)
        })

        finalResult
    }

    finishBuilder: (builder) => {
        collectChunks(builder, builder.maxLevel, Array())
    }

    required: (candidate, name) => {
        candidate.hasSlot(name).ifFalse(() => {
            fail()
        })
        candidate.slotValue(name)
    }

    builder: newBuilder()
    visit: null
    visit = (node) => {
        visiting.containsKey(node).ifTrue(() => {
            fail()
        })

        kindValue: validateString(required(node, "kind"))
        idValue: validateId(required(node, "id"))

        ids.containsKey(idValue).ifTrue(() => {
            fail()
        })
        ids[idValue] = true
        visiting[node] = true

        knownKind: (kindValue == "leaf") || (kindValue == "suite")
        knownKind.ifFalse(() => {
            fail()
        })

        childrenValue: validateArray(required(node, "children"))

        (kindValue == "leaf").ifTrue(() => {
            (childrenValue.size() == 0).ifFalse(() => {
                fail()
            })
            appendBuilt(builder, idValue)
        })

        (kindValue == "suite").ifTrue(() => {
            index: 0
            (() => index < childrenValue.size()).while() {
                visit(childrenValue[index])
                index = index + 1
            }
        })

        visiting.remove(node)
    }

    visit(root)

    flattened: finishBuilder(builder)
    flattened.freeze()
}
