// D153 / LIB018-0: project one suite-native declaration into the inert ordered
// local selector signature used by Test Tool discovery. Live Test values and
// body Closures never leave this operation.
Arrays: import("std:collections/Array")
Sets: import("std:collections/Set")
LogicalCasePlan: import("self:LogicalCasePlan")

declarationSignature: (tests) => {
    Array.recognizes(tests).ifFalse(() => {
        fail()
    })

    seen: Sets()

    selectors: Arrays.map(tests, (test) => {
        name: test.name

        String.recognizes(name).ifFalse(() => {
            fail()
        })
        (name == "").ifTrue(() => {
            fail()
        })

        Sets.contains(seen, name).ifTrue(() => {
            fail()
        })
        Sets.add(seen, name)

        name
    })

    selectors.freeze()
}

declarationSignatureFromModule: (module) => {
    module.hasSlot("tests").ifFalse(() => {
        fail()
    })

    declarationSignature(module.slotValue("tests"))
}

requireDeclarationSignature: (module, expectedSignature) => {
    Array.recognizes(expectedSignature).ifFalse(() => {
        fail()
    })

    actualSignature: declarationSignatureFromModule(module)

    (actualSignature.size() == expectedSignature.size()).ifFalse(() => {
        fail()
    })

    index: 0
    actualSignature.each((selector) => {
        expected: expectedSignature[index]

        String.recognizes(expected).ifFalse(() => {
            fail()
        })

        (selector == expected).ifFalse(() => {
            fail()
        })

        index = index + 1
    })

    actualSignature
}

resolveSelectedTest: (module, expectedSignature, selector) => {
    String.recognizes(selector).ifFalse(() => {
        fail()
    })
    (selector == "").ifTrue(() => {
        fail()
    })

    signature:
        requireDeclarationSignature(
            module,
            expectedSignature
        )

    selectedIndex:
        Arrays.findIndex(signature, (name) => {
            name == selector
        })

    (selectedIndex === null).ifTrue(() => {
        fail()
    })

    selected: module.slotValue("tests")[selectedIndex]

    selected.hasSlot("call").ifFalse(() => {
        fail()
    })

    selected
}

projectionFromModule: (sourceAssociation, module) => {
    signature: declarationSignatureFromModule(module)
    plan: LogicalCasePlan.build(sourceAssociation, signature)

    projection: Array(signature, plan)
    projection.freeze()
}

projectionSignature: (projection) => {
    projection[0]
}

projectionPlan: (projection) => {
    projection[1]
}

casePlanFromModule: (sourceAssociation, module) => {
    projectionPlan(
        projectionFromModule(
            sourceAssociation,
            module
        )
    )
}
