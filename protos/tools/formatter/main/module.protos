// TOOL010 bootstrap identity and B1 source-layout bridge.
//
// This increment owns no D183 formatting decisions. The bridge only validates
// and exposes the exact mechanical source-layout projection supplied by the
// host. Structural formatting policy is added in the following increment.

this.toolId: "TOOL010"

Structural: import("../Structural.protos")

this.acceptSourceLayout: (layout) => {
    layout.exactSource

    layout.program.kind
    layout.program.path.root
    for(expression in layout.program.expressions) {
        expression.kind
        expression.path.root
    }

    for(token in layout.tokens) {
        token.type
        token.rawText
    }

    for(comment in layout.comments) {
        comment.kind
        comment.rawText
        comment.placement
        comment.preceding
        comment.following
        comment.boundaryKind
        comment.sequenceSeparatorKind
    }

    for(form in layout.structuralForms) {
        form.path.root
        form.path.steps
        form.kind
    }

    for(separator in layout.sequenceSeparators) {
        separator.context
        separator.preceding
        separator.kind
        separator.following
    }

    for(closureForm in layout.closureForms) {
        closureForm.closure
        closureForm.form
    }

    for(trailingClosure in layout.trailingClosures) {
        trailingClosure.call
        trailingClosure.closure
    }

    for(contextualElse in layout.contextualElses) {
        contextualElse.conditional
        contextualElse.elseToken
        contextualElse.falseBranch
    }

    layout
}

this.formatStructural: (layout) => {
    Structural.format(layout)
}

toolId
