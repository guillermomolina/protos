// Comparison policy for independently supplied source-preservation projections.
// Parsing and span-independent canonical equivalence are separate host duties.

requireString: (value) => {
    String.recognizes(value).ifFalse(() => { Error().signal() })
}

requireArray: (value) => {
    Array.recognizes(value).ifFalse(() => { Error().signal() })
}

requireBoolean: (value) => {
    ((value === true) || (value === false)).ifFalse(() => {
        Error().signal()
    })
}

requireOneOf: (value, supported) => {
    requireString(value)
    found: false
    for(item in supported) {
        if(value == item) { found = true }
    }
    found.ifFalse(() => { Error().signal() })
}

validatePath: (path) => {
    if(path !== null) {
        requireString(path.root)
        (path.root.size() > 0).ifFalse(() => { Error().signal() })
        requireArray(path.steps)
        for(step in path.steps) {
            requireString(step.role)
            (step.role.size() > 0).ifFalse(() => { Error().signal() })
            Integer.recognizes(step.index).ifFalse(() => { Error().signal() })
            (step.index >= -1).ifFalse(() => { Error().signal() })
        }
    }
}

requirePath: (path) => {
    if(path === null) { Error().signal() }
    validatePath(path)
}

structuralPathEquivalent: (left, right) => {
    validatePath(left)
    validatePath(right)
    result: (left === null) && (right === null)
    if((left !== null) && (right !== null)) {
        result = (left.root == right.root) &&
            (left.steps.size() == right.steps.size())
        if(result) {
            index: 0
            while(index < left.steps.size()) {
                a: left.steps[index]
                b: right.steps[index]
                result = result && (a.role == b.role) && (a.index == b.index)
                index = index + 1
            }
        }
    }
    result
}

// Validate both complete lists even when their lengths or early fields differ.
// Missing slots and unsupported facts must signal rather than be masked by a
// short-circuited comparison, including when both inputs have the same defect.
orderedEquivalent: (original, candidate, validate, compare) => {
    requireArray(original)
    requireArray(candidate)
    for(item in original) { validate(item) }
    for(item in candidate) { validate(item) }
    result: original.size() == candidate.size()
    if(result) {
        index: 0
        while(index < original.size()) {
            result = compare(original[index], candidate[index]) && result
            index = index + 1
        }
    }
    result
}

validateComment: (comment) => {
    requireOneOf(comment.kind, ["LINE_COMMENT", "BLOCK_COMMENT"])
    requireString(comment.rawText)
    requireOneOf(comment.placement, [
        "OWN_LINE", "END_OF_LINE", "EMBEDDED_BETWEEN_TOKENS"
    ])
    validatePath(comment.preceding)
    validatePath(comment.following)
    requireOneOf(comment.boundaryKind, [
        "NONE", "SEQUENCE_SEPARATOR", "TRAILING_CLOSURE",
        "CONTEXTUAL_WHILE_BEFORE_LPAREN", "CONTEXTUAL_WHILE_AFTER_LPAREN",
        "CONTEXTUAL_IF_BEFORE_LPAREN", "CONTEXTUAL_IF_AFTER_LPAREN",
        "CONTEXTUAL_IF_BEFORE_ELSE", "CONTEXTUAL_IF_AFTER_ELSE",
        "CONTEXTUAL_UNTIL_BEFORE_KEYWORD", "CONTEXTUAL_UNTIL_BEFORE_LPAREN",
        "CONTEXTUAL_UNTIL_AFTER_LPAREN", "CONTEXTUAL_FOR_BEFORE_LPAREN",
        "CONTEXTUAL_FOR_AFTER_LPAREN", "CONTEXTUAL_FOR_BEFORE_IN",
        "CONTEXTUAL_FOR_AFTER_IN", "CONTEXTUAL_FOR_AFTER_BINDER",
        "CONTEXTUAL_FOR_BEFORE_START", "CONTEXTUAL_FOR_AFTER_START",
        "CONTEXTUAL_FOR_BEFORE_STOP", "CONTEXTUAL_FOR_AFTER_STOP",
        "CONTEXTUAL_FOR_BEFORE_STEP", "NON_LOCAL_RETURN_OPERAND",
        "NAMED_ARGUMENT_BEFORE_COLON", "NAMED_ARGUMENT_AFTER_COLON",
        "DOCUMENT_PREFIX", "DOCUMENT_SUFFIX"
    ])
    if(comment.sequenceSeparatorKind !== null) {
        requireOneOf(comment.sequenceSeparatorKind, ["SEMICOLON", "LOGICAL_NEWLINE"])
    }
    ((comment.boundaryKind == "SEQUENCE_SEPARATOR") ==
        (comment.sequenceSeparatorKind !== null)).ifFalse(() => {
        Error().signal()
    })
    requireBoolean(comment.blankLineBefore)
    requireBoolean(comment.blankLineAfter)
}

commentsEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateComment, (left, right) => {
        // Only OWN_LINE blankLineBefore belongs to this comment boundary.
        // Other placements describe the physical line before their owner.
        beforeEquivalent: true
        if(left.placement == "OWN_LINE") {
            beforeEquivalent = left.blankLineBefore == right.blankLineBefore
        }
        (left.kind == right.kind) &&
            (left.rawText == right.rawText) &&
            (left.placement == right.placement) &&
            structuralPathEquivalent(left.preceding, right.preceding) &&
            structuralPathEquivalent(left.following, right.following) &&
            (left.boundaryKind == right.boundaryKind) &&
            (left.sequenceSeparatorKind == right.sequenceSeparatorKind) &&
            beforeEquivalent && (left.blankLineAfter == right.blankLineAfter)
    })
}

validateSeparator: (separator) => {
    requireOneOf(separator.context, [
        "PROGRAM", "CLOSURE_BODY", "OBJECT_BODY", "MAP_CONSTRUCTION"
    ])
    requirePath(separator.preceding)
    requirePath(separator.following)
    requireOneOf(separator.kind, ["SEMICOLON", "LOGICAL_NEWLINE"])
    requireBoolean(separator.blankLine)
}

sequenceSeparatorsEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateSeparator, (left, right) => {
        (left.context == right.context) &&
            structuralPathEquivalent(left.preceding, right.preceding) &&
            structuralPathEquivalent(left.following, right.following) &&
            (left.kind == right.kind) && (left.blankLine == right.blankLine)
    })
}

validateStructuralForm: (form) => {
    requirePath(form.path)
    requireOneOf(form.kind, [
        "GROUP", "ARRAY_CONSTRUCTION", "MAP_CONSTRUCTION",
        "CLOSURE_EXPRESSION_BODY", "CLOSURE_BLOCK_BODY"
    ])
}

structuralFormsEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateStructuralForm, (left, right) => {
        structuralPathEquivalent(left.path, right.path) && (left.kind == right.kind)
    })
}

validateClosureForm: (form) => {
    requirePath(form.closure)
    requireOneOf(form.form, ["BARE", "PARENTHESIZED"])
}

closureFormsEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateClosureForm, (left, right) => {
        structuralPathEquivalent(left.closure, right.closure) &&
            (left.form == right.form)
    })
}

validateTrailingClosure: (attachment) => {
    requirePath(attachment.call)
    requirePath(attachment.closure)
}

trailingClosuresEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateTrailingClosure, (left, right) => {
        structuralPathEquivalent(left.call, right.call) &&
            structuralPathEquivalent(left.closure, right.closure)
    })
}

validateContextualElse: (attachment) => {
    requirePath(attachment.conditional)
    requirePath(attachment.falseBranch)
    Integer.recognizes(attachment.elseToken).ifFalse(() => { Error().signal() })
    (attachment.elseToken >= 0).ifFalse(() => { Error().signal() })
}

contextualElsesEquivalent: (original, candidate) => {
    orderedEquivalent(original, candidate, validateContextualElse, (left, right) => {
        structuralPathEquivalent(left.conditional, right.conditional) &&
            structuralPathEquivalent(left.falseBranch, right.falseBranch) &&
            (left.elseToken == right.elseToken)
    })
}

validateToken: (token) => {
    requireOneOf(token.type, [
        "IDENTIFIER", "NUMBER", "STRING", "THIS", "CONTEXT", "NULL",
        "TRUE", "FALSE", "SUPER", "LPAREN", "RPAREN", "LBRACE", "RBRACE",
        "LBRACKET", "RBRACKET", "DOT", "COMMA", "COLON", "SEMICOLON",
        "EQUALS", "FAT_ARROW", "PLUS", "MINUS", "STAR", "SLASH", "PERCENT",
        "BANG", "LESS", "LESS_EQUAL", "GREATER", "GREATER_EQUAL",
        "DOUBLE_EQUALS", "TRIPLE_EQUALS", "NOT_EQUALS", "NOT_EQUALS_2",
        "AND", "OR", "AMPERSAND", "PIPE", "TILDE", "SHIFT_LEFT",
        "SHIFT_RIGHT", "ELLIPSIS", "CARET", "NEWLINE"
    ])
    requireString(token.rawText)
}

tokensEquivalent: (original, candidate) => {
    requireArray(original)
    requireArray(candidate)
    for(token in original) { validateToken(token) }
    for(token in candidate) { validateToken(token) }
    left: 0
    right: 0
    result: true
    // NEWLINE spellings are formatting-dependent. Required logical
    // separators are compared independently, without normalizing their kind.
    while((left < original.size()) || (right < candidate.size())) {
        while((left < original.size()) && (original[left].type == "NEWLINE")) {
            left = left + 1
        }
        while((right < candidate.size()) && (candidate[right].type == "NEWLINE")) {
            right = right + 1
        }
        if((left < original.size()) && (right < candidate.size())) {
            result = result &&
                (original[left].type == candidate[right].type) &&
                (original[left].rawText == candidate[right].rawText)
            left = left + 1
            right = right + 1
        } else {
            result = result && (left == original.size()) && (right == candidate.size())
            left = original.size()
            right = candidate.size()
        }
    }
    result
}

equivalent: (originalLayout, candidateLayout) => {
    // Evaluate each comparison before combining results so malformed later
    // projections cannot hide behind an earlier, ordinary inequality.
    tokens: tokensEquivalent(originalLayout.tokens, candidateLayout.tokens)
    comments: commentsEquivalent(originalLayout.comments, candidateLayout.comments)
    separators: sequenceSeparatorsEquivalent(
        originalLayout.sequenceSeparators, candidateLayout.sequenceSeparators
    )
    forms: structuralFormsEquivalent(
        originalLayout.structuralForms, candidateLayout.structuralForms
    )
    closures: closureFormsEquivalent(originalLayout.closureForms, candidateLayout.closureForms)
    trailing: trailingClosuresEquivalent(
        originalLayout.trailingClosures, candidateLayout.trailingClosures
    )
    elses: contextualElsesEquivalent(originalLayout.contextualElses, candidateLayout.contextualElses)
    tokens && comments && separators && forms && closures && trailing && elses
}
