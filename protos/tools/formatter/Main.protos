// TOOL010 bootstrap identity and B1 source-layout bridge.
//
// This increment owns no D183 formatting decisions. The bridge only validates
// and exposes the exact mechanical source-layout projection supplied by the
// host. Structural formatting policy is added in the following increment.

toolId: "TOOL010"

Structural: import("self:Structural")

acceptSourceLayout: (layout) => {
    layout.exactSource

    layout.program.kind
    layout.program.path.root
    layout.program.expressions.each((expression) => {
        expression.kind
        expression.path.root
    })

    layout.tokens.each((token) => {
        token.type
        token.rawText
    })

    layout.comments.each((comment) => {
        comment.kind
        comment.rawText
        comment.placement
        comment.preceding
        comment.following
        comment.boundaryKind
        comment.sequenceSeparatorKind
    })

    layout.structuralForms.each((form) => {
        form.path.root
        form.path.steps
        form.kind
    })

    layout.sequenceSeparators.each((separator) => {
        separator.context
        separator.preceding
        separator.kind
        separator.following
    })

    layout.closureForms.each((closureForm) => {
        closureForm.closure
        closureForm.form
    })

    layout.trailingClosures.each((trailingClosure) => {
        trailingClosure.call
        trailingClosure.closure
    })

    layout
}

formatStructural: (layout) => {
    Structural.format(layout)
}

toolId
