// TOOL010 / LM011-B2 structural formatting policy.
//
// This module owns canonical structural source-layout choices. The host supplies
// only the inert B1 Surface/source-preservation projection.
//
// Increment 3B2 covers structural spacing, source-preserved sequence separators,
// Object bodies, Map bodies, ordinary Closures and trailing Closures. Comments
// and soft-100 wrapping remain fail-closed/deferred.

indent: (level) => {
    result: ""
    index: 0

    (() => index < level).whileTrue(() => {
        result = result + "    "
        index = index + 1
    })

    result
}

separatorKind: (layout, left, right) => {
    selected: null

    layout.sequenceSeparators.each((separator) => {
        matches:
            (separator.preceding === left.path) &&
            (separator.following === right.path)

        matches.ifTrue(() => {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = separator.kind
        })
    })

    (selected === null).ifTrue(() => {
        Error().signal()
    })

    selected
}

usesLogicalNewline: (items, layout) => {
    result: false
    index: 1

    (() => index < items.size()).whileTrue(() => {
        kind:
            separatorKind(
                layout,
                items[index - 1],
                items[index]
            )

        (kind == "LOGICAL_NEWLINE").ifTrue(() => {
            result = true
        })

        index = index + 1
    })

    result
}

formatExpression: null

containsNewline: (text) => {
    result: false
    index: 0

    (() => index < text.size()).whileTrue(() => {
        (text[index] == "\n").ifTrue(() => {
            result = true
        })

        index = index + 1
    })

    result
}

fitsAtIndent: (text, level) => {
    result:
        !containsNewline(text)

    result.ifTrue(() => {
        result =
            (indent(level).size() + text.size()) <= 100
    })

    result
}

formatMember: (node, level, layout) => {
    receiver:
        formatExpression(
            node.receiver,
            level,
            layout
        )

    flat:
        receiver +
        "." +
        node.name

    result: flat

    fitsAtIndent(flat, level).ifFalse(() => {
        result =
            receiver +
            "\n" +
            indent(level + 1) +
            "." +
            node.name
    })

    result
}

formatBinary: (node, level, layout) => {
    left:
        formatExpression(
            node.left,
            level,
            layout
        )

    right:
        formatExpression(
            node.right,
            level,
            layout
        )

    flat:
        left +
        " " +
        node.operator +
        " " +
        right

    width:
        indent(level).size() +
        flat.size()

    shouldBreak: false

    containsNewline(left).ifTrue(() => {
        shouldBreak = true
    })

    containsNewline(right).ifTrue(() => {
        shouldBreak = true
    })

    (width > 100).ifTrue(() => {
        shouldBreak = true
    })

    result: flat

    shouldBreak.ifTrue(() => {
        result =
            left +
            " " +
            node.operator +
            "\n" +
            indent(level + 1) +
            right
    })

    result
}

formatArgument: (argument, level, layout) => {
    prefix: ""

    argument.spread.ifTrue(() => {
        prefix = "..."
    })

    prefix +
        formatExpression(
            argument.expression,
            level,
            layout
        )
}

formatArgumentCount: (arguments, count, level, layout) => {
    result: ""
    index: 0

    (() => index < count).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result = result + ", "
        })

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatArguments: (arguments, level, layout) => {
    result: ""
    index: 0

    (() => index < arguments.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result = result + ", "
        })

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatArgumentLines: (arguments, count, level, layout) => {
    result: ""
    index: 0

    (() => index < count).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result =
                result +
                ",\n" +
                indent(level)
        })

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatCallHead: (receiver, arguments, count, level, layout) => {
    flatArguments:
        formatArgumentCount(
            arguments,
            count,
            level,
            layout
        )

    flat:
        receiver +
        "(" +
        flatArguments +
        ")"

    result: flat

    shouldBreak: false

    containsNewline(receiver).ifTrue(() => {
        shouldBreak = true
    })

    containsNewline(flatArguments).ifTrue(() => {
        shouldBreak = true
    })

    (indent(level).size() + flat.size() > 100).ifTrue(() => {
        shouldBreak = true
    })

    ((count > 0) && shouldBreak).ifTrue(() => {
        result =
            receiver +
            "(\n" +
            indent(level + 1) +
            formatArgumentLines(
                arguments,
                count,
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            ")"
    })

    result
}

formatArray: (arguments, level, layout) => {
    flatArguments:
        formatArguments(
            arguments,
            level,
            layout
        )

    flat:
        "[" +
        flatArguments +
        "]"

    result: flat

    shouldBreak: false

    containsNewline(flatArguments).ifTrue(() => {
        shouldBreak = true
    })

    (indent(level).size() + flat.size() > 100).ifTrue(() => {
        shouldBreak = true
    })

    ((arguments.size() > 0) && shouldBreak).ifTrue(() => {
        result =
            "[\n" +
            indent(level + 1) +
            formatArgumentLines(
                arguments,
                arguments.size(),
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            "]"
    })

    result
}

containsPhysicalNewline: (text) => {
    index: 0
    found: false

    (() =>
        (index < text.size()) &&
        (!found)
    ).whileTrue(() => {
        scalar:
            text.at(index)

        ((scalar === "\n") ||
            (scalar === "\r")).ifTrue(() => {
            found = true
        })

        index = index + 1
    })

    found
}

shouldBreakAfterOperator: (
    left,
    beforeOperator,
    operator,
    right,
    level
) => {
    flat:
        left +
        beforeOperator +
        operator +
        " " +
        right

    result:
        indent(level).size() +
        flat.size() >
        100

    multiline:
        containsPhysicalNewline(left) ||
        containsPhysicalNewline(right)

    multiline.ifTrue(() => {
        result = false
    })

    result
}

formatSlotCreation: (node, level, layout) => {
    left:
        formatExpression(
            node.target,
            level,
            layout
        )

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        ": " +
        right

    shouldBreakAfterOperator(
        left,
        "",
        ":",
        right,
        level
    ).ifTrue(() => {
        result =
            left +
            ":\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    })

    result
}

formatMultipleSlotCreation: (node, level, layout) => {
    left:
        "(" +
        formatTargets(
            node.targets,
            level,
            layout
        ) +
        ")"

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        ": " +
        right

    shouldBreakAfterOperator(
        left,
        "",
        ":",
        right,
        level
    ).ifTrue(() => {
        result =
            left +
            ":\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    })

    result
}

formatAssignment: (node, level, layout) => {
    left:
        formatExpression(
            node.target,
            level,
            layout
        )

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        " = " +
        right

    shouldBreakAfterOperator(
        left,
        " ",
        "=",
        right,
        level
    ).ifTrue(() => {
        result =
            left +
            " =\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    })

    result
}

separatorBlankLine: (
    layout,
    preceding,
    following
) => {
    selected: null

    layout.sequenceSeparators.each((separator) => {
        matches:
            (separator.preceding === preceding.path) &&
            (separator.following === following.path)

        matches.ifTrue(() => {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = separator.blankLine
        })
    })

    (selected === null).ifTrue(() => {
        Error().signal()
    })

    selected
}

formatSequenceBoundary: (
    preceding,
    following,
    kind,
    level,
    layout
) => {
    result: ""
    matched: false
    pendingBlankAfter: false
    commentBlankLineSeen: false

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == "SEQUENCE_SEPARATOR") &&
            (comment.preceding === preceding.path) &&
            (comment.following === following.path)

        sameBoundary.ifTrue(() => {
            (kind == "LOGICAL_NEWLINE").ifFalse(() => {
                Error().signal()
            })

            comment.blankLineBefore.ifTrue(() => {
                commentBlankLineSeen = true
            })

            comment.blankLineAfter.ifTrue(() => {
                commentBlankLineSeen = true
            })

            (comment.placement == "END_OF_LINE").ifTrue(() => {
                matched.ifTrue(() => {
                    Error().signal()
                })

                comment.blankLineBefore.ifTrue(() => {
                    Error().signal()
                })

                result =
                    " " +
                    comment.rawText +
                    "\n"

                pendingBlankAfter =
                    comment.blankLineAfter

                matched = true
            })

            (comment.placement == "OWN_LINE").ifTrue(() => {
                matched.ifFalse(() => {
                    result =
                        result +
                        "\n"
                })

                (pendingBlankAfter ||
                    comment.blankLineBefore).ifTrue(() => {
                    result =
                        result +
                        "\n"
                })

                result =
                    result +
                    indent(level) +
                    comment.rawText +
                    "\n"

                pendingBlankAfter =
                    comment.blankLineAfter

                matched = true
            })

            ((comment.placement == "END_OF_LINE") ||
                (comment.placement == "OWN_LINE")).ifFalse(() => {
                Error().signal()
            })
        })
    })

    blankLine:
        separatorBlankLine(
            layout,
            preceding,
            following
        )

    matched.ifTrue(() => {
        (blankLine == commentBlankLineSeen).ifFalse(() => {
            Error().signal()
        })

        pendingBlankAfter.ifTrue(() => {
            result =
                result +
                "\n"
        })

        result =
            result +
            indent(level)
    })

    matched.ifFalse(() => {
        (kind == "SEMICOLON").ifTrue(() => {
            blankLine.ifTrue(() => {
                Error().signal()
            })

            result = "; "
        })

        (kind == "LOGICAL_NEWLINE").ifTrue(() => {
            result =
                "\n" +
                indent(level)

            blankLine.ifTrue(() => {
                result =
                    "\n\n" +
                    indent(level)
            })
        })

        ((kind == "SEMICOLON") ||
            (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
            Error().signal()
        })
    })

    result
}

formatSequence: (sequence, level, layout) => {
    result: ""
    expressions: sequence.expressions
    index: 0

    (() => index < expressions.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            kind:
                separatorKind(
                    layout,
                    expressions[index - 1],
                    expressions[index]
                )

            result =
                result +
                formatSequenceBoundary(
                    expressions[index - 1],
                    expressions[index],
                    kind,
                    level,
                    layout
                )
        })

        result =
            result +
            formatExpression(
                expressions[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatBracedSequence: (sequence, level, layout) => {
    expressions: sequence.expressions
    result: "{}"

    (expressions.size() > 0).ifTrue(() => {
        multiline:
            usesLogicalNewline(
                expressions,
                layout
            )

        multiline.ifTrue(() => {
            result =
                "{\n" +
                indent(level + 1) +
                formatSequence(
                    sequence,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        })

        multiline.ifFalse(() => {
            result =
                "{ " +
                formatSequence(
                    sequence,
                    level + 1,
                    layout
                ) +
                " }"
        })
    })

    result
}

formatMapEntry: (entry, level, layout) => {
    formatExpression(
        entry.key,
        level,
        layout
    ) +
    ": " +
    formatExpression(
        entry.value,
        level,
        layout
    )
}

formatMapEntries: (entries, level, layout) => {
    result: ""
    index: 0

    (() => index < entries.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            kind:
                separatorKind(
                    layout,
                    entries[index - 1],
                    entries[index]
                )

            (kind == "SEMICOLON").ifTrue(() => {
                result = result + "; "
            })

            (kind == "LOGICAL_NEWLINE").ifTrue(() => {
                result =
                    result +
                    "\n" +
                    indent(level)
            })

            ((kind == "SEMICOLON") ||
                (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
                Error().signal()
            })
        })

        result =
            result +
            formatMapEntry(
                entries[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatMap: (entries, level, layout) => {
    result: "%{}"

    (entries.size() > 0).ifTrue(() => {
        multiline:
            usesLogicalNewline(
                entries,
                layout
            )

        multiline.ifTrue(() => {
            result =
                "%{\n" +
                indent(level + 1) +
                formatMapEntries(
                    entries,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        })

        multiline.ifFalse(() => {
            result =
                "%{ " +
                formatMapEntries(
                    entries,
                    level + 1,
                    layout
                ) +
                " }"
        })
    })

    result
}

formatObjectItem: (item, level, layout) => {
    prefix: ""

    item.composition.ifTrue(() => {
        prefix = "..."
    })

    prefix +
        formatExpression(
            item.expression,
            level,
            layout
        )
}

formatObjectItems: (items, level, layout) => {
    result: ""
    index: 0

    (() => index < items.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            kind:
                separatorKind(
                    layout,
                    items[index - 1],
                    items[index]
                )

            (kind == "SEMICOLON").ifTrue(() => {
                result = result + "; "
            })

            (kind == "LOGICAL_NEWLINE").ifTrue(() => {
                result =
                    result +
                    "\n" +
                    indent(level)
            })

            ((kind == "SEMICOLON") ||
                (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
                Error().signal()
            })
        })

        result =
            result +
            formatObjectItem(
                items[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatObjectBody: (items, level, layout) => {
    result: "{}"

    (items.size() > 0).ifTrue(() => {
        multiline:
            usesLogicalNewline(
                items,
                layout
            )

        multiline.ifTrue(() => {
            result =
                "{\n" +
                indent(level + 1) +
                formatObjectItems(
                    items,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        })

        multiline.ifFalse(() => {
            result =
                "{ " +
                formatObjectItems(
                    items,
                    level + 1,
                    layout
                ) +
                " }"
        })
    })

    result
}

formatParameter: (parameter, level, layout) => {
    result: parameter.name

    parameter.rest.ifTrue(() => {
        result = "..." + parameter.name
    })

    (parameter.defaultValue === null).ifFalse(() => {
        result =
            parameter.name +
            " = " +
            formatExpression(
                parameter.defaultValue,
                level,
                layout
            )
    })

    result
}

formatParameterList: (parameters, level, layout) => {
    result: ""
    index: 0

    (() => index < parameters.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result = result + ", "
        })

        result =
            result +
            formatParameter(
                parameters[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatParameterLines: (parameters, level, layout) => {
    result: ""
    index: 0

    (() => index < parameters.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result =
                result +
                ",\n" +
                indent(level)
        })

        result =
            result +
            formatParameter(
                parameters[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatParenthesizedParameters: (parameters, level, layout) => {
    flatParameters:
        formatParameterList(
            parameters,
            level,
            layout
        )

    flat:
        "(" +
        flatParameters +
        ")"

    result: flat

    shouldBreak: false

    containsNewline(flatParameters).ifTrue(() => {
        shouldBreak = true
    })

    (indent(level).size() + flat.size() > 100).ifTrue(() => {
        shouldBreak = true
    })

    ((parameters.size() > 0) && shouldBreak).ifTrue(() => {
        result =
            "(\n" +
            indent(level + 1) +
            formatParameterLines(
                parameters,
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            ")"
    })

    result
}

singleParameterSourceForm: (closure, layout) => {
    selected: null

    layout.closureForms.each((form) => {
        (form.closure === closure.path).ifTrue(() => {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = form.form
        })
    })

    (selected === null).ifTrue(() => {
        Error().signal()
    })

    selected
}

formatClosureParameters: (closure, level, layout) => {
    parameters: closure.parameters
    result: "()"

    (parameters.size() > 0).ifTrue(() => {
        usePreservedSingleForm: false

        (parameters.size() == 1).ifTrue(() => {
            parameter: parameters[0]

            ((!parameter.rest) &&
                (parameter.defaultValue === null)).ifTrue(() => {
                usePreservedSingleForm = true

                form:
                    singleParameterSourceForm(
                        closure,
                        layout
                    )

                (form == "BARE").ifTrue(() => {
                    result = parameter.name
                })

                (form == "PARENTHESIZED").ifTrue(() => {
                    result =
                        formatParenthesizedParameters(
                            parameters,
                            level,
                            layout
                        )
                })

                ((form == "BARE") ||
                    (form == "PARENTHESIZED")).ifFalse(() => {
                    Error().signal()
                })
            })
        })

        usePreservedSingleForm.ifFalse(() => {
            result =
                formatParenthesizedParameters(
                    parameters,
                    level,
                    layout
                )
        })
    })

    result
}

formatClosure: (closure, level, layout) => {
    parameters:
        formatClosureParameters(
            closure,
            level,
            layout
        )

    result: null

    closure.expressionBody.ifTrue(() => {
        (closure.body.expressions.size() == 1).ifFalse(() => {
            Error().signal()
        })

        body:
            formatExpression(
                closure.body.expressions[0],
                level,
                layout
            )

        breakAfterArrow:
            shouldBreakAfterOperator(
                parameters,
                " ",
                "=>",
                body,
                level
            )

        containsPhysicalNewline(parameters).ifTrue(() => {
            breakAfterArrow =
                shouldBreakAfterOperator(
                    ")",
                    " ",
                    "=>",
                    body,
                    level
                )
        })

        breakAfterArrow.ifTrue(() => {
            result =
                parameters +
                " =>\n" +
                indent(level + 1) +
                formatExpression(
                    closure.body.expressions[0],
                    level + 1,
                    layout
                )
        })

        breakAfterArrow.ifFalse(() => {
            result =
                parameters +
                " => " +
                body
        })
    })

    closure.expressionBody.ifFalse(() => {
        result =
            parameters +
            " => " +
            formatBracedSequence(
                closure.body,
                level,
                layout
            )
    })

    result
}

trailingClosurePath: (call, layout) => {
    selected: null

    layout.trailingClosures.each((trailing) => {
        (trailing.call === call.path).ifTrue(() => {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = trailing.closure
        })
    })

    selected
}

formatTrailingClosureSeparator: (
    call,
    closure,
    layout
) => {
    result: " "

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == "TRAILING_CLOSURE") &&
            (comment.preceding === call.path) &&
            (comment.following === closure.path)

        sameBoundary.ifTrue(() => {
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS").ifFalse(() => {
                Error().signal()
            })

            result =
                result +
                comment.rawText +
                " "
        })
    })

    result
}

formatCall: (call, level, layout) => {
    trailingPath:
        trailingClosurePath(
            call,
            layout
        )

    arguments: call.arguments
    receiver:
        formatExpression(
            call.receiver,
            level,
            layout
        )

    result: null

    (trailingPath === null).ifTrue(() => {
        result =
            formatCallHead(
                receiver,
                arguments,
                arguments.size(),
                level,
                layout
            )
    })

    (trailingPath === null).ifFalse(() => {
        (arguments.size() > 0).ifFalse(() => {
            Error().signal()
        })

        ordinaryCount:
            arguments.size() - 1

        trailingArgument:
            arguments[ordinaryCount]

        trailingArgument.spread.ifTrue(() => {
            Error().signal()
        })

        trailingClosure:
            trailingArgument.expression

        ((trailingClosure.kind == "CLOSURE") &&
            (trailingClosure.path === trailingPath)).ifFalse(() => {
            Error().signal()
        })

        ((trailingClosure.parameters.size() == 0) &&
            (!trailingClosure.expressionBody)).ifFalse(() => {
            Error().signal()
        })

        result =
            formatCallHead(
                receiver,
                arguments,
                ordinaryCount,
                level,
                layout
            ) +
            formatTrailingClosureSeparator(
                call,
                trailingClosure,
                layout
            ) +
            formatBracedSequence(
                trailingClosure.body,
                level,
                layout
            )
    })

    (result === null).ifTrue(() => {
        Error().signal()
    })

    result
}

formatTargets: (targets, level, layout) => {
    result: ""
    index: 0

    (() => index < targets.size()).whileTrue(() => {
        (index > 0).ifTrue(() => {
            result = result + ", "
        })

        result =
            result +
            formatExpression(
                targets[index],
                level,
                layout
            )

        index = index + 1
    })

    result
}

formatEmbeddedCommentsAfter: (
    node,
    formatted,
    layout
) => {
    result: formatted

    layout.comments.each((comment) => {
        matches:
            (comment.boundaryKind == "NONE") &&
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS") &&
            (comment.preceding === node.path)

        matches.ifTrue(() => {
            result =
                result +
                " " +
                comment.rawText
        })
    })

    result
}

formatExpression = (node, level, layout) => {
    formatted: null
    kind: node.kind

    (kind == "LITERAL").ifTrue(() => {
        formatted = node.rawText
    })

    (kind == "NAME").ifTrue(() => {
        formatted = node.rawText
    })

    (kind == "INTRINSIC").ifTrue(() => {
        formatted = node.rawText
    })

    (kind == "SEQUENCE").ifTrue(() => {
        formatted =
            formatSequence(
                node,
                level,
                layout
            )
    })

    (kind == "GROUP").ifTrue(() => {
        formatted =
            "(" +
            formatExpression(
                node.expression,
                level,
                layout
            ) +
            ")"
    })

    (kind == "MEMBER").ifTrue(() => {
        formatted =
            formatMember(
                node,
                level,
                layout
            )
    })

    (kind == "CALL").ifTrue(() => {
        formatted =
            formatCall(
                node,
                level,
                layout
            )
    })

    (kind == "ARRAY_CONSTRUCTION").ifTrue(() => {
        formatted =
            formatArray(
                node.arguments,
                level,
                layout
            )
    })

    (kind == "MAP_CONSTRUCTION").ifTrue(() => {
        formatted =
            formatMap(
                node.entries,
                level,
                layout
            )
    })

    (kind == "INDEX").ifTrue(() => {
        formatted =
            formatExpression(
                node.receiver,
                level,
                layout
            ) +
            "[" +
            formatExpression(
                node.index,
                level,
                layout
            ) +
            "]"
    })

    (kind == "UNARY").ifTrue(() => {
        formatted =
            node.operator +
            formatExpression(
                node.operand,
                level,
                layout
            )
    })

    (kind == "BINARY").ifTrue(() => {
        formatted =
            formatBinary(
                node,
                level,
                layout
            )
    })

    (kind == "NON_LOCAL_RETURN").ifTrue(() => {
        formatted =
            "^" +
            formatExpression(
                node.expression,
                level,
                layout
            )
    })

    (kind == "SLOT_CREATION").ifTrue(() => {
        formatted =
            formatSlotCreation(
                node,
                level,
                layout
            )
    })

    (kind == "MULTIPLE_SLOT_CREATION").ifTrue(() => {
        formatted =
            formatMultipleSlotCreation(
                node,
                level,
                layout
            )
    })

    (kind == "ASSIGNMENT").ifTrue(() => {
        formatted =
            formatAssignment(
                node,
                level,
                layout
            )
    })

    (kind == "SUPER_SEND").ifTrue(() => {
        formatted =
            "super." +
            node.message +
            "(" +
            formatArguments(
                node.arguments,
                level,
                layout
            ) +
            ")"
    })

    (kind == "OBJECT").ifTrue(() => {
        body:
            formatObjectBody(
                node.items,
                level,
                layout
            )

        formatted = body

        (node.parent === null).ifFalse(() => {
            formatted =
                formatExpression(
                    node.parent,
                    level,
                    layout
                ) +
                " " +
                body
        })
    })

    (kind == "CLOSURE").ifTrue(() => {
        formatted =
            formatClosure(
                node,
                level,
                layout
            )
    })

    (formatted === null).ifTrue(() => {
        Error().signal()
    })

    formatEmbeddedCommentsAfter(
        node,
        formatted,
        layout
    )
}

formatBody: (layout) => {
    layout.comments.each((comment) => {
        sequenceComment:
            (comment.boundaryKind == "SEQUENCE_SEPARATOR") &&
            ((comment.placement == "OWN_LINE") ||
                (comment.placement == "END_OF_LINE"))

        trailingClosureComment:
            (comment.boundaryKind == "TRAILING_CLOSURE") &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS")

        embeddedComment:
            (comment.boundaryKind == "NONE") &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS") &&
            (comment.preceding !== null)

        (sequenceComment ||
            trailingClosureComment ||
            embeddedComment).ifFalse(() => {
            Error().signal()
        })
    })

    formatExpression(
        layout.program,
        0,
        layout
    )
}

format: (layout) => {
    formatBody(layout) + "\n"
}
