// TOOL010 / LM011-B2 structural formatting policy.
//
// This module owns canonical structural source-layout choices. The host supplies
// only the inert B1 Surface/source-preservation projection.
//
// Increment 3B2 covers structural spacing, source-preserved sequence separators,
// Object bodies, Map bodies, ordinary Closures and trailing Closures. Comments
// and soft-100 wrapping remain fail-closed/deferred.

indent: (level) => {
    result: ""
    index: 0

    while(index < level) {
        result = result + "    "
        index = index + 1
    }

    result
}

separatorKind: (layout, left, right) => {
    selected: null

    layout.sequenceSeparators.each((separator) => {
        matches:
            (separator.preceding === left.path) &&
            (separator.following === right.path)

        if(matches) {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = separator.kind
        }
    })

    if(selected === null) {
        Error().signal()
    }

    selected
}

usesLogicalNewline: (items, layout) => {
    result: false
    index: 1

    while(index < items.size()) {
        kind:
            separatorKind(
                layout,
                items[index - 1],
                items[index]
            )

        if(kind == "LOGICAL_NEWLINE") {
            result = true
        }

        index = index + 1
    }

    result
}

formatExpression: null

containsNewline: (text) => {
    result: false
    index: 0

    while(index < text.size()) {
        if(text[index] == "\n") {
            result = true
        }

        index = index + 1
    }

    result
}

fitsAtIndent: (text, level) => {
    result:
        !containsNewline(text)

    if(result) {
        result =
            (indent(level).size() + text.size()) <= 100
    }

    result
}

formatMember: (node, level, layout) => {
    receiver:
        formatExpression(
            node.receiver,
            level,
            layout
        )

    flat:
        receiver +
        "." +
        node.name

    result: flat

    fitsAtIndent(flat, level).ifFalse(() => {
        result =
            receiver +
            "\n" +
            indent(level + 1) +
            "." +
            node.name
    })

    result
}

formatBinary: (node, level, layout) => {
    left:
        formatExpression(
            node.left,
            level,
            layout
        )

    right:
        formatExpression(
            node.right,
            level,
            layout
        )

    flat:
        left +
        " " +
        node.operator +
        " " +
        right

    width:
        indent(level).size() +
        flat.size()

    shouldBreak: false

    if(containsNewline(left)) {
        shouldBreak = true
    }

    if(containsNewline(right)) {
        shouldBreak = true
    }

    if(width > 100) {
        shouldBreak = true
    }

    result: flat

    if(shouldBreak) {
        result =
            left +
            " " +
            node.operator +
            "\n" +
            indent(level + 1) +
            right
    }

    result
}

formatArgument: (argument, level, layout) => {
    prefix: ""

    if(argument.spread) {
        prefix = "..."
    }

    prefix +
        formatExpression(
            argument.expression,
            level,
            layout
        )
}

formatArgumentCount: (arguments, count, level, layout) => {
    result: ""
    index: 0

    while(index < count) {
        if(index > 0) {
            result = result + ", "
        }

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatArguments: (arguments, level, layout) => {
    result: ""
    index: 0

    while(index < arguments.size()) {
        if(index > 0) {
            result = result + ", "
        }

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatArgumentLines: (arguments, count, level, layout) => {
    result: ""
    index: 0

    while(index < count) {
        if(index > 0) {
            result =
                result +
                ",\n" +
                indent(level)
        }

        result =
            result +
            formatArgument(
                arguments[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatCallHead: (receiver, arguments, count, level, layout) => {
    flatArguments:
        formatArgumentCount(
            arguments,
            count,
            level,
            layout
        )

    flat:
        receiver +
        "(" +
        flatArguments +
        ")"

    result: flat

    shouldBreak: false

    if(containsNewline(receiver)) {
        shouldBreak = true
    }

    if(containsNewline(flatArguments)) {
        shouldBreak = true
    }

    if(indent(level).size() + flat.size() > 100) {
        shouldBreak = true
    }

    if((count > 0) && shouldBreak) {
        result =
            receiver +
            "(\n" +
            indent(level + 1) +
            formatArgumentLines(
                arguments,
                count,
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            ")"
    }

    result
}

formatArray: (arguments, level, layout) => {
    flatArguments:
        formatArguments(
            arguments,
            level,
            layout
        )

    flat:
        "[" +
        flatArguments +
        "]"

    result: flat

    shouldBreak: false

    if(containsNewline(flatArguments)) {
        shouldBreak = true
    }

    if(indent(level).size() + flat.size() > 100) {
        shouldBreak = true
    }

    if((arguments.size() > 0) && shouldBreak) {
        result =
            "[\n" +
            indent(level + 1) +
            formatArgumentLines(
                arguments,
                arguments.size(),
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            "]"
    }

    result
}

containsPhysicalNewline: (text) => {
    index: 0
    found: false

    while(
        (index < text.size()) &&
        (!found)
    ) {
        scalar:
            text.at(index)

        if((scalar === "\n") ||
            (scalar === "\r")) {
            found = true
        }

        index = index + 1
    }

    found
}

shouldBreakAfterOperator: (
    left,
    beforeOperator,
    operator,
    right,
    level
) => {
    flat:
        left +
        beforeOperator +
        operator +
        " " +
        right

    result:
        indent(level).size() +
        flat.size() >
        100

    multiline:
        containsPhysicalNewline(left) ||
        containsPhysicalNewline(right)

    if(multiline) {
        result = false
    }

    result
}

formatSlotCreation: (node, level, layout) => {
    left:
        formatExpression(
            node.target,
            level,
            layout
        )

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        ": " +
        right

    if(shouldBreakAfterOperator(
        left,
        "",
        ":",
        right,
        level
    )) {
        result =
            left +
            ":\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    }

    result
}

formatMultipleSlotCreation: (node, level, layout) => {
    left:
        "(" +
        formatTargets(
            node.targets,
            level,
            layout
        ) +
        ")"

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        ": " +
        right

    if(shouldBreakAfterOperator(
        left,
        "",
        ":",
        right,
        level
    )) {
        result =
            left +
            ":\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    }

    result
}

formatAssignment: (node, level, layout) => {
    left:
        formatExpression(
            node.target,
            level,
            layout
        )

    right:
        formatExpression(
            node.value,
            level,
            layout
        )

    result:
        left +
        " = " +
        right

    if(shouldBreakAfterOperator(
        left,
        " ",
        "=",
        right,
        level
    )) {
        result =
            left +
            " =\n" +
            indent(level + 1) +
            formatExpression(
                node.value,
                level + 1,
                layout
            )
    }

    result
}

separatorBlankLine: (
    layout,
    preceding,
    following
) => {
    selected: null

    layout.sequenceSeparators.each((separator) => {
        matches:
            (separator.preceding === preceding.path) &&
            (separator.following === following.path)

        if(matches) {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = separator.blankLine
        }
    })

    if(selected === null) {
        Error().signal()
    }

    selected
}

formatSequenceBoundary: (
    preceding,
    following,
    kind,
    level,
    layout
) => {
    result: ""
    matched: false
    pendingBlankAfter: false
    commentBlankLineSeen: false

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == "SEQUENCE_SEPARATOR") &&
            (comment.preceding === preceding.path) &&
            (comment.following === following.path)

        if(sameBoundary) {
            (kind == "LOGICAL_NEWLINE").ifFalse(() => {
                Error().signal()
            })

            if(comment.blankLineAfter) {
                commentBlankLineSeen = true
            }

            if(comment.placement == "END_OF_LINE") {
                if(matched) {
                    Error().signal()
                }

                result =
                    " " +
                    comment.rawText +
                    "\n"

                pendingBlankAfter =
                    comment.blankLineAfter

                matched = true
            }

            if(comment.placement == "OWN_LINE") {
                // blankLineBefore is the physical line above the comment's
                // line; for an OWN_LINE comment that line lies inside this
                // boundary, while for an END_OF_LINE comment it precedes the
                // owning expression and belongs to an earlier boundary.
                if(comment.blankLineBefore) {
                    commentBlankLineSeen = true
                }

                matched.ifFalse(() => {
                    result =
                        result +
                        "\n"
                })

                if(pendingBlankAfter ||
                    comment.blankLineBefore) {
                    result =
                        result +
                        "\n"
                }

                result =
                    result +
                    indent(level) +
                    comment.rawText +
                    "\n"

                pendingBlankAfter =
                    comment.blankLineAfter

                matched = true
            }

            ((comment.placement == "END_OF_LINE") ||
                (comment.placement == "OWN_LINE")).ifFalse(() => {
                Error().signal()
            })
        }
    })

    blankLine:
        separatorBlankLine(
            layout,
            preceding,
            following
        )

    if(matched) {
        (blankLine == commentBlankLineSeen).ifFalse(() => {
            Error().signal()
        })

        if(pendingBlankAfter) {
            result =
                result +
                "\n"
        }

        result =
            result +
            indent(level)
    }

    matched.ifFalse(() => {
        if(kind == "SEMICOLON") {
            if(blankLine) {
                Error().signal()
            }

            result = "; "
        }

        if(kind == "LOGICAL_NEWLINE") {
            result =
                "\n" +
                indent(level)

            if(blankLine) {
                result =
                    "\n\n" +
                    indent(level)
            }
        }

        ((kind == "SEMICOLON") ||
            (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
            Error().signal()
        })
    })

    result
}

formatSequence: (sequence, level, layout) => {
    result: ""
    expressions: sequence.expressions
    index: 0

    while(index < expressions.size()) {
        if(index > 0) {
            kind:
                separatorKind(
                    layout,
                    expressions[index - 1],
                    expressions[index]
                )

            result =
                result +
                formatSequenceBoundary(
                    expressions[index - 1],
                    expressions[index],
                    kind,
                    level,
                    layout
                )
        }

        result =
            result +
            formatExpression(
                expressions[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatBracedSequence: (sequence, level, layout) => {
    expressions: sequence.expressions
    result: "{}"

    if(expressions.size() > 0) {
        multiline:
            usesLogicalNewline(
                expressions,
                layout
            )

        if(multiline) {
            result =
                "{\n" +
                indent(level + 1) +
                formatSequence(
                    sequence,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        }

        multiline.ifFalse(() => {
            result =
                "{ " +
                formatSequence(
                    sequence,
                    level + 1,
                    layout
                ) +
                " }"
        })
    }

    result
}

formatMapEntry: (entry, level, layout) => {
    formatExpression(
        entry.key,
        level,
        layout
    ) +
    ": " +
    formatExpression(
        entry.value,
        level,
        layout
    )
}

formatMapEntries: (entries, level, layout) => {
    result: ""
    index: 0

    while(index < entries.size()) {
        if(index > 0) {
            kind:
                separatorKind(
                    layout,
                    entries[index - 1],
                    entries[index]
                )

            if(kind == "SEMICOLON") {
                result = result + "; "
            }

            if(kind == "LOGICAL_NEWLINE") {
                result =
                    result +
                    "\n" +
                    indent(level)
            }

            ((kind == "SEMICOLON") ||
                (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
                Error().signal()
            })
        }

        result =
            result +
            formatMapEntry(
                entries[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatMap: (entries, level, layout) => {
    result: "%{}"

    if(entries.size() > 0) {
        multiline:
            usesLogicalNewline(
                entries,
                layout
            )

        if(multiline) {
            result =
                "%{\n" +
                indent(level + 1) +
                formatMapEntries(
                    entries,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        }

        multiline.ifFalse(() => {
            result =
                "%{ " +
                formatMapEntries(
                    entries,
                    level + 1,
                    layout
                ) +
                " }"
        })
    }

    result
}

formatObjectItem: (item, level, layout) => {
    prefix: ""

    if(item.composition) {
        prefix = "..."
    }

    prefix +
        formatExpression(
            item.expression,
            level,
            layout
        )
}

formatObjectItems: (items, level, layout) => {
    result: ""
    index: 0

    while(index < items.size()) {
        if(index > 0) {
            kind:
                separatorKind(
                    layout,
                    items[index - 1],
                    items[index]
                )

            if(kind == "SEMICOLON") {
                result = result + "; "
            }

            if(kind == "LOGICAL_NEWLINE") {
                result =
                    result +
                    "\n" +
                    indent(level)
            }

            ((kind == "SEMICOLON") ||
                (kind == "LOGICAL_NEWLINE")).ifFalse(() => {
                Error().signal()
            })
        }

        result =
            result +
            formatObjectItem(
                items[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatObjectBody: (items, level, layout) => {
    result: "{}"

    if(items.size() > 0) {
        multiline:
            usesLogicalNewline(
                items,
                layout
            )

        if(multiline) {
            result =
                "{\n" +
                indent(level + 1) +
                formatObjectItems(
                    items,
                    level + 1,
                    layout
                ) +
                "\n" +
                indent(level) +
                "}"
        }

        multiline.ifFalse(() => {
            result =
                "{ " +
                formatObjectItems(
                    items,
                    level + 1,
                    layout
                ) +
                " }"
        })
    }

    result
}

formatParameter: (parameter, level, layout) => {
    result: parameter.name

    if(parameter.rest) {
        result = "..." + parameter.name
    }

    (parameter.defaultValue === null).ifFalse(() => {
        result =
            parameter.name +
            ": " +
            formatExpression(
                parameter.defaultValue,
                level,
                layout
            )
    })

    result
}

formatParameterList: (parameters, level, layout) => {
    result: ""
    index: 0

    while(index < parameters.size()) {
        if(index > 0) {
            result = result + ", "
        }

        result =
            result +
            formatParameter(
                parameters[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatParameterLines: (parameters, level, layout) => {
    result: ""
    index: 0

    while(index < parameters.size()) {
        if(index > 0) {
            result =
                result +
                ",\n" +
                indent(level)
        }

        result =
            result +
            formatParameter(
                parameters[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatParenthesizedParameters: (parameters, level, layout) => {
    flatParameters:
        formatParameterList(
            parameters,
            level,
            layout
        )

    flat:
        "(" +
        flatParameters +
        ")"

    result: flat

    shouldBreak: false

    if(containsNewline(flatParameters)) {
        shouldBreak = true
    }

    if(indent(level).size() + flat.size() > 100) {
        shouldBreak = true
    }

    if((parameters.size() > 0) && shouldBreak) {
        result =
            "(\n" +
            indent(level + 1) +
            formatParameterLines(
                parameters,
                level + 1,
                layout
            ) +
            "\n" +
            indent(level) +
            ")"
    }

    result
}

singleParameterSourceForm: (closure, layout) => {
    selected: null

    layout.closureForms.each((form) => {
        if(form.closure === closure.path) {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = form.form
        }
    })

    if(selected === null) {
        Error().signal()
    }

    selected
}

formatClosureParameters: (closure, level, layout) => {
    parameters: closure.parameters
    result: "()"

    if(parameters.size() > 0) {
        usePreservedSingleForm: false

        if(parameters.size() == 1) {
            parameter: parameters[0]

            if((!parameter.rest) &&
                (parameter.defaultValue === null)) {
                usePreservedSingleForm = true

                form:
                    singleParameterSourceForm(
                        closure,
                        layout
                    )

                if(form == "BARE") {
                    result = parameter.name
                }

                if(form == "PARENTHESIZED") {
                    result =
                        formatParenthesizedParameters(
                            parameters,
                            level,
                            layout
                        )
                }

                ((form == "BARE") ||
                    (form == "PARENTHESIZED")).ifFalse(() => {
                    Error().signal()
                })
            }
        }

        usePreservedSingleForm.ifFalse(() => {
            result =
                formatParenthesizedParameters(
                    parameters,
                    level,
                    layout
                )
        })
    }

    result
}

formatClosure: (closure, level, layout) => {
    parameters:
        formatClosureParameters(
            closure,
            level,
            layout
        )

    result: null

    if(closure.expressionBody) {
        (closure.body.expressions.size() == 1).ifFalse(() => {
            Error().signal()
        })

        body:
            formatExpression(
                closure.body.expressions[0],
                level,
                layout
            )

        breakAfterArrow:
            shouldBreakAfterOperator(
                parameters,
                " ",
                "=>",
                body,
                level
            )

        if(containsPhysicalNewline(parameters)) {
            breakAfterArrow =
                shouldBreakAfterOperator(
                    ")",
                    " ",
                    "=>",
                    body,
                    level
                )
        }

        if(breakAfterArrow) {
            result =
                parameters +
                " =>\n" +
                indent(level + 1) +
                formatExpression(
                    closure.body.expressions[0],
                    level + 1,
                    layout
                )
        }

        breakAfterArrow.ifFalse(() => {
            result =
                parameters +
                " => " +
                body
        })
    }

    closure.expressionBody.ifFalse(() => {
        result =
            parameters +
            " => " +
            formatBracedSequence(
                closure.body,
                level,
                layout
            )
    })

    result
}

trailingClosurePath: (call, layout) => {
    selected: null

    layout.trailingClosures.each((trailing) => {
        if(trailing.call === call.path) {
            (selected === null).ifFalse(() => {
                Error().signal()
            })

            selected = trailing.closure
        }
    })

    selected
}

contextualHeaderComments: (
    node,
    boundaryKind,
    leadingSpace,
    layout
) => {
    result: ""

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == boundaryKind) &&
            (comment.preceding === node.path)

        if(sameBoundary) {
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS").ifFalse(() => {
                Error().signal()
            })

            if(leadingSpace || (result.size() > 0)) {
                result = result + " "
            }

            result = result + comment.rawText
        }
    })

    if(result.size() > 0) {
        result = result + " "
    }

    result
}

// D211: comments between the true branch's closing brace and the paired
// else, or between that else and the false branch's opening brace. The
// separators are spaces only: a logical newline before else would end the
// contextual expression and change its parse.
contextualElseSeparatorComments: (
    node,
    boundaryKind,
    layout
) => {
    result: " "

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == boundaryKind) &&
            (comment.preceding === node.path) &&
            (comment.following === node.falseBranch.path)

        if(sameBoundary) {
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS").ifFalse(() => {
                Error().signal()
            })

            result =
                result +
                comment.rawText +
                " "
        }
    })

    result
}

formatTrailingClosureSeparator: (
    call,
    closure,
    layout
) => {
    result: " "

    layout.comments.each((comment) => {
        sameBoundary:
            (comment.boundaryKind == "TRAILING_CLOSURE") &&
            (comment.preceding === call.path) &&
            (comment.following === closure.path)

        if(sameBoundary) {
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS").ifFalse(() => {
                Error().signal()
            })

            result =
                result +
                comment.rawText +
                " "
        }
    })

    result
}

formatCall: (call, level, layout) => {
    trailingPath:
        trailingClosurePath(
            call,
            layout
        )

    arguments: call.arguments
    receiver:
        formatExpression(
            call.receiver,
            level,
            layout
        )

    result: null

    if(trailingPath === null) {
        result =
            formatCallHead(
                receiver,
                arguments,
                arguments.size(),
                level,
                layout
            )
    }

    (trailingPath === null).ifFalse(() => {
        (arguments.size() > 0).ifFalse(() => {
            Error().signal()
        })

        ordinaryCount:
            arguments.size() - 1

        trailingArgument:
            arguments[ordinaryCount]

        if(trailingArgument.spread) {
            Error().signal()
        }

        trailingClosure:
            trailingArgument.expression

        ((trailingClosure.kind == "CLOSURE") &&
            (trailingClosure.path === trailingPath)).ifFalse(() => {
            Error().signal()
        })

        ((trailingClosure.parameters.size() == 0) &&
            (!trailingClosure.expressionBody)).ifFalse(() => {
            Error().signal()
        })

        result =
            formatCallHead(
                receiver,
                arguments,
                ordinaryCount,
                level,
                layout
            ) +
            formatTrailingClosureSeparator(
                call,
                trailingClosure,
                layout
            ) +
            formatBracedSequence(
                trailingClosure.body,
                level,
                layout
            )
    })

    if(result === null) {
        Error().signal()
    }

    result
}

formatTargets: (targets, level, layout) => {
    result: ""
    index: 0

    while(index < targets.size()) {
        if(index > 0) {
            result = result + ", "
        }

        result =
            result +
            formatExpression(
                targets[index],
                level,
                layout
            )

        index = index + 1
    }

    result
}

formatEmbeddedCommentsAfter: (
    node,
    formatted,
    layout
) => {
    result: formatted

    layout.comments.each((comment) => {
        matches:
            (comment.boundaryKind == "NONE") &&
            (comment.placement ==
                "EMBEDDED_BETWEEN_TOKENS") &&
            (comment.preceding === node.path)

        if(matches) {
            result =
                result +
                " " +
                comment.rawText
        }
    })

    result
}

formatExpression = (node, level, layout) => {
    formatted: null
    kind: node.kind

    if(kind == "LITERAL") {
        formatted = node.rawText
    }

    if(kind == "NAME") {
        formatted = node.rawText
    }

    if(kind == "INTRINSIC") {
        formatted = node.rawText
    }

    if(kind == "SEQUENCE") {
        formatted =
            formatSequence(
                node,
                level,
                layout
            )
    }

    if(kind == "GROUP") {
        formatted =
            "(" +
            formatExpression(
                node.expression,
                level,
                layout
            ) +
            ")"
    }

    if(kind == "MEMBER") {
        formatted =
            formatMember(
                node,
                level,
                layout
            )
    }

    if(kind == "CALL") {
        formatted =
            formatCall(
                node,
                level,
                layout
            )
    }

    if(kind == "CONTEXTUAL_WHILE") {
        formatted =
            "while" +
            contextualHeaderComments(
                node,
                "CONTEXTUAL_WHILE_BEFORE_LPAREN",
                true,
                layout
            ) +
            "(" +
            contextualHeaderComments(
                node,
                "CONTEXTUAL_WHILE_AFTER_LPAREN",
                false,
                layout
            ) +
            formatExpression(
                node.condition,
                level,
                layout
            ) +
            ")" +
            formatTrailingClosureSeparator(
                node,
                node.body,
                layout
            ) +
            formatBracedSequence(
                node.body.body,
                level,
                layout
            )
    }

    if(kind == "CONTEXTUAL_IF") {
        formatted =
            "if" +
            contextualHeaderComments(
                node,
                "CONTEXTUAL_IF_BEFORE_LPAREN",
                true,
                layout
            ) +
            "(" +
            contextualHeaderComments(
                node,
                "CONTEXTUAL_IF_AFTER_LPAREN",
                false,
                layout
            ) +
            formatExpression(
                node.condition,
                level,
                layout
            ) +
            ")" +
            formatTrailingClosureSeparator(
                node,
                node.trueBranch,
                layout
            ) +
            formatBracedSequence(
                node.trueBranch.body,
                level,
                layout
            )

        // The paired else stays on the true branch's closing line.
        (node.falseBranch === null).ifFalse(() => {
            formatted =
                formatted +
                contextualElseSeparatorComments(
                    node,
                    "CONTEXTUAL_IF_BEFORE_ELSE",
                    layout
                ) +
                "else" +
                contextualElseSeparatorComments(
                    node,
                    "CONTEXTUAL_IF_AFTER_ELSE",
                    layout
                ) +
                formatBracedSequence(
                    node.falseBranch.body,
                    level,
                    layout
                )
        })
    }

    if(kind == "ARRAY_CONSTRUCTION") {
        formatted =
            formatArray(
                node.arguments,
                level,
                layout
            )
    }

    if(kind == "MAP_CONSTRUCTION") {
        formatted =
            formatMap(
                node.entries,
                level,
                layout
            )
    }

    if(kind == "INDEX") {
        formatted =
            formatExpression(
                node.receiver,
                level,
                layout
            ) +
            "[" +
            formatExpression(
                node.index,
                level,
                layout
            ) +
            "]"
    }

    if(kind == "UNARY") {
        formatted =
            node.operator +
            formatExpression(
                node.operand,
                level,
                layout
            )
    }

    if(kind == "BINARY") {
        formatted =
            formatBinary(
                node,
                level,
                layout
            )
    }

    if(kind == "NON_LOCAL_RETURN") {
        formatted =
            "^" +
            formatExpression(
                node.expression,
                level,
                layout
            )
    }

    if(kind == "SLOT_CREATION") {
        formatted =
            formatSlotCreation(
                node,
                level,
                layout
            )
    }

    if(kind == "MULTIPLE_SLOT_CREATION") {
        formatted =
            formatMultipleSlotCreation(
                node,
                level,
                layout
            )
    }

    if(kind == "ASSIGNMENT") {
        formatted =
            formatAssignment(
                node,
                level,
                layout
            )
    }

    if(kind == "SUPER_SEND") {
        formatted =
            "super." +
            node.message +
            "(" +
            formatArguments(
                node.arguments,
                level,
                layout
            ) +
            ")"
    }

    if(kind == "OBJECT") {
        body:
            formatObjectBody(
                node.items,
                level,
                layout
            )

        formatted = body

        (node.parent === null).ifFalse(() => {
            formatted =
                formatExpression(
                    node.parent,
                    level,
                    layout
                ) +
                " " +
                body
        })
    }

    if(kind == "CLOSURE") {
        formatted =
            formatClosure(
                node,
                level,
                layout
            )
    }

    if(formatted === null) {
        Error().signal()
    }

    formatEmbeddedCommentsAfter(
        node,
        formatted,
        layout
    )
}

formatBody: (layout) => {
    leadingComments: ""
    pendingSeparator: ""
    trailingComments: ""

    layout.comments.each((comment) => {
        leadingComment:
            (comment.boundaryKind == "DOCUMENT_PREFIX")

        trailingComment:
            (comment.boundaryKind == "DOCUMENT_SUFFIX")

        if(leadingComment) {
            leadingComments =
                leadingComments +
                pendingSeparator +
                comment.rawText

            pendingSeparator = " "

            if((comment.placement == "OWN_LINE") ||
                (comment.placement == "END_OF_LINE")) {
                pendingSeparator = "\n"

                if(comment.blankLineAfter) {
                    pendingSeparator = "\n\n"
                }
            }
        }

        if(trailingComment) {
            separator: " "

            if(comment.placement == "OWN_LINE") {
                separator = "\n"

                if(comment.blankLineBefore) {
                    separator = "\n\n"
                }
            }

            trailingComments =
                trailingComments +
                separator +
                comment.rawText
        }

        sequenceComment:
            (comment.boundaryKind == "SEQUENCE_SEPARATOR") &&
            ((comment.placement == "OWN_LINE") ||
                (comment.placement == "END_OF_LINE"))

        trailingClosureComment:
            (comment.boundaryKind == "TRAILING_CLOSURE") &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS")

        contextualWhileHeaderComment:
            ((comment.boundaryKind ==
                "CONTEXTUAL_WHILE_BEFORE_LPAREN") ||
                (comment.boundaryKind ==
                    "CONTEXTUAL_WHILE_AFTER_LPAREN")) &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS")

        contextualIfComment:
            ((comment.boundaryKind ==
                "CONTEXTUAL_IF_BEFORE_LPAREN") ||
                (comment.boundaryKind ==
                    "CONTEXTUAL_IF_AFTER_LPAREN") ||
                (comment.boundaryKind ==
                    "CONTEXTUAL_IF_BEFORE_ELSE") ||
                (comment.boundaryKind ==
                    "CONTEXTUAL_IF_AFTER_ELSE")) &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS")

        embeddedComment:
            (comment.boundaryKind == "NONE") &&
            (comment.placement == "EMBEDDED_BETWEEN_TOKENS") &&
            (comment.preceding !== null)

        (leadingComment ||
            trailingComment ||
            sequenceComment ||
            trailingClosureComment ||
            contextualWhileHeaderComment ||
            contextualIfComment ||
            embeddedComment).ifFalse(() => {
            Error().signal()
        })
    })

    body:
        formatExpression(
            layout.program,
            0,
            layout
        )

    if(body.size() > 0) {
        leadingComments =
            leadingComments +
            pendingSeparator
    }

    leadingComments + body + trailingComments
}

format: (layout) => {
    formatBody(layout) + "\n"
}
