Version: import("self:ReleaseVersion")

emptyBytes: () => {
    Encoding.UTF8.encode("")
}

isSeparator: (octet) => {
    result: octet == 32
    if(octet == 9) {
        result = true
    }
    result
}

hasPrerelease: (version) => {
    result: true
    if(version.prerelease === null) {
        result = false
    }
    result
}

sameCore: (left, right) => {
    result: left.major == right.major
    if(result) {
        result = left.minor == right.minor
    }
    if(result) {
        result = left.patch == right.patch
    }
    result
}

coreVersion: (major, minor, patch) => {
    {
        major: major
        minor: minor
        patch: patch
        prerelease: null
        text: null
    }
}

caretConstraint: (text, lower) => {
    upper: null
    exactZero: false

    if(lower.major > 0) {
        upper = coreVersion(lower.major + 1, 0, 0)
    }

    if(lower.major == 0) {
        if(lower.minor > 0) {
            upper = coreVersion(0, lower.minor + 1, 0)
        }

        if(lower.minor == 0) {
            if(lower.patch > 0) {
                upper = coreVersion(0, 0, lower.patch + 1)
            }

            if(lower.patch == 0) {
                exactZero = true
            }
        }
    }

    {
        kind: "caret"
        lower: lower
        upper: upper
        exactZero: exactZero
        text: text
    }
}

bytesAfter: (source, start) => {
    result: emptyBytes()
    index: 0
    source.each((octet) => {
        if(index >= start) {
            result.add(octet)
        }
        index = index + 1
    })
    result
}

parseComparison: (token) => {
    if(token.size() < 2) {
        fail()
    }

    first: token[0]
    lower: first == 62
    upper: first == 60

    validDirection: lower
    if(upper) {
        validDirection = true
    }
    validDirection.ifFalse(() => {
        fail()
    })

    inclusive: false
    versionStart: 1

    if(token.size() > 1) {
        if(token[1] == 61) {
            inclusive = true
            versionStart = 2
        }
    }

    if(token.size() <= versionStart) {
        fail()
    }

    version: Version.parse(
        Encoding.UTF8.decode(bytesAfter(token, versionStart))
    )

    {
        lower: lower
        inclusive: inclusive
        version: version
    }
}

intervalConstraint: (text, source) => {
    first: emptyBytes()
    second: emptyBytes()
    inSecond: false
    afterSecond: false

    source.each((octet) => {
        separator: isSeparator(octet)

        if(separator) {
            inSecond.ifFalse(() => {
                if(first.size() == 0) {
                    fail()
                }
                inSecond = true
            })

            if(inSecond) {
                if(second.size() > 0) {
                    afterSecond = true
                }
            }
        }

        separator.ifFalse(() => {
            if(afterSecond) {
                fail()
            }

            if(inSecond) {
                second.add(octet)
            }
            inSecond.ifFalse(() => {
                first.add(octet)
            })
        })
    })

    inSecond.ifFalse(() => {
        fail()
    })
    if(second.size() == 0) {
        fail()
    }
    if(afterSecond) {
        fail()
    }

    left: parseComparison(first)
    right: parseComparison(second)

    if(left.lower === right.lower) {
        fail()
    }

    lower: left
    upper: right
    left.lower.ifFalse(() => {
        lower = right
        upper = left
    })

    {
        kind: "interval"
        lower: lower
        upper: upper
        text: text
    }
}

parse: (text) => {
    source: Encoding.UTF8.encode(text)

    caret: false
    interval: false

    if(source.size() > 0) {
        if(source[0] == 94) {
            caret = true
        }
        if(source[0] == 62) {
            interval = true
        }
        if(source[0] == 60) {
            interval = true
        }
    }

    result: null

    if(caret) {
        lower: Version.parse(
            Encoding.UTF8.decode(bytesAfter(source, 1))
        )
        result = caretConstraint(text, lower)
    }

    caret.ifFalse(() => {
        if(interval) {
            result = intervalConstraint(text, source)
        }

        interval.ifFalse(() => {
            result = {
                kind: "exact"
                version: Version.parse(text)
                text: text
            }
        })
    })

    result
}

comparisonSatisfied: (comparison, candidate) => {
    order: Version.compare(candidate, comparison.version)
    result: false

    if(comparison.lower) {
        result = order == 1
        if(comparison.inclusive) {
            if(order == 0) {
                result = true
            }
        }
    }

    comparison.lower.ifFalse(() => {
        result = order == -1
        if(comparison.inclusive) {
            if(order == 0) {
                result = true
            }
        }
    })

    result
}

prereleaseAdmitted: (constraint, candidate) => {
    admitted: false

    hasPrerelease(candidate).ifFalse(() => {
        admitted = true
    })

    if(hasPrerelease(candidate)) {
        if(constraint.kind === "exact") {
            if(hasPrerelease(constraint.version)) {
                admitted = sameCore(constraint.version, candidate)
            }
        }

        if(constraint.kind === "caret") {
            if(hasPrerelease(constraint.lower)) {
                admitted = sameCore(constraint.lower, candidate)
            }
        }

        if(constraint.kind === "interval") {
            if(hasPrerelease(constraint.lower.version)) {
                admitted = sameCore(constraint.lower.version, candidate)
            }

            admitted.ifFalse(() => {
                if(hasPrerelease(constraint.upper.version)) {
                    admitted = sameCore(constraint.upper.version, candidate)
                }
            })
        }
    }

    admitted
}

caretSatisfied: (constraint, candidate) => {
    result: false

    if(prereleaseAdmitted(constraint, candidate)) {
        if(constraint.exactZero) {
            hasPrerelease(constraint.lower).ifFalse(() => {
                result = Version.compare(constraint.lower, candidate) == 0
            })

            if(hasPrerelease(constraint.lower)) {
                lowerOrder: Version.compare(constraint.lower, candidate)
                upperOrder: Version.compare(candidate, coreVersion(0, 0, 0))

                lowerOk: lowerOrder == -1
                if(lowerOrder == 0) {
                    lowerOk = true
                }

                upperOk: upperOrder == -1
                if(upperOrder == 0) {
                    upperOk = true
                }

                result = lowerOk
                if(result) {
                    result = upperOk
                }
            }
        }

        constraint.exactZero.ifFalse(() => {
            lowerOrder: Version.compare(constraint.lower, candidate)
            upperOrder: Version.compare(candidate, constraint.upper)

            lowerOk: lowerOrder == -1
            if(lowerOrder == 0) {
                lowerOk = true
            }

            result = lowerOk
            if(result) {
                result = upperOrder == -1
            }
        })
    }

    result
}

intervalSatisfied: (constraint, candidate) => {
    result: false

    if(prereleaseAdmitted(constraint, candidate)) {
        result = comparisonSatisfied(constraint.lower, candidate)
        if(result) {
            result = comparisonSatisfied(constraint.upper, candidate)
        }
    }

    result
}

satisfies: (constraint, candidate) => {
    result: false
    known: false

    if(constraint.kind === "exact") {
        known = true
        result = Version.compare(constraint.version, candidate) == 0
    }

    if(constraint.kind === "caret") {
        known = true
        result = caretSatisfied(constraint, candidate)
    }

    if(constraint.kind === "interval") {
        known = true
        result = intervalSatisfied(constraint, candidate)
    }

    known.ifFalse(() => {
        fail()
    })

    result
}

satisfiesText: (constraintText, candidateText) => {
    satisfies(
        parse(constraintText),
        Version.parse(candidateText)
    )
}
