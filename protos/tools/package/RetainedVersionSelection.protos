Version: import("self:ReleaseVersion")
Constraint: import("self:DependencyConstraint")
Fresh: import("self:FreshVersionSelection")

retainedAvailable: (retained, candidates) => {
    available: false

    candidates.each((candidate) => {
        available.ifFalse(() => {
            (Version.compare(retained, candidate) == 0).ifTrue(() => {
                available = true
            })
        })
    })

    available
}

select: (constraint, retained, candidates) => {
    keep: false

    (retained === null).ifFalse(() => {
        retainedAvailable(retained, candidates).ifTrue(() => {
            Constraint.satisfies(constraint, retained).ifTrue(() => {
                keep = true
            })
        })
    })

    result: retained

    keep.ifFalse(() => {
        result = Fresh.select(constraint, candidates)
    })

    result
}

selectText: (constraintText, retainedText, candidateTexts) => {
    constraint: Constraint.parse(constraintText)
    retained: null

    (retainedText === null).ifFalse(() => {
        retained = Version.parse(retainedText)
    })

    candidates: Array()
    candidateTexts.each((candidateText) => {
        candidates = Array(
            ...candidates,
            Version.parse(candidateText)
        )
    })

    select(constraint, retained, candidates).text
}
