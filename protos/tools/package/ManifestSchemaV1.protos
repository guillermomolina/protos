baseFromTable: (root) => {
    tableEntries: (node) => {
        (node.kind == "table").ifFalse(() => {
            fail()
        })
        node.value
    }

    requiredNode: (entries, name) => {
        entries.containsKey(name).ifFalse(() => {
            fail()
        })
        entries[name]
    }

    nonEmptyString: (node) => {
        (node.kind == "string").ifFalse(() => {
            fail()
        })
        value: node.value
        if(value == "") {
            fail()
        }
        value
    }

    checkAllowed: (entries, allowed) => {
        entries.each((name, valueNode) => {
            allowed.containsKey(name).ifFalse(() => {
                fail()
            })
        })
    }

    rootAllowed: Map()
    rootAllowed["manifest-version"] = true
    rootAllowed["package"] = true
    rootAllowed["compatibility"] = true
    rootAllowed["exports"] = true
    rootAllowed["dependencies"] = true
    rootAllowed["workspace"] = true

    rootEntries: tableEntries(root)
    checkAllowed(rootEntries, rootAllowed)

    manifestVersion: requiredNode(rootEntries, "manifest-version")
    (manifestVersion.kind == "integer").ifFalse(() => {
        fail()
    })
    (manifestVersion.value == 1).ifFalse(() => {
        fail()
    })

    packageNode: requiredNode(rootEntries, "package")
    packageEntries: tableEntries(packageNode)
    packageAllowed: Map()
    packageAllowed["id"] = true
    packageAllowed["version"] = true
    packageAllowed["locator"] = true
    checkAllowed(packageEntries, packageAllowed)

    packageId: nonEmptyString(requiredNode(packageEntries, "id"))
    packageVersion: nonEmptyString(requiredNode(packageEntries, "version"))
    packageLocator: null
    if(packageEntries.containsKey("locator")) {
        packageLocator = nonEmptyString(packageEntries["locator"])
    }

    {
        package: {
            id: packageId
            version: packageVersion
            locator: packageLocator
        }
    }
}

parseBase: (text) => {
    TOML: import("std:toml/TOML")
    baseFromTable(TOML.parseDialect(text, "1.0"))
}

sectionsFromTable: (root) => {
    tableEntries: (node) => {
        (node.kind == "table").ifFalse(() => {
            fail()
        })
        node.value
    }

    requiredNode: (entries, name) => {
        entries.containsKey(name).ifFalse(() => {
            fail()
        })
        entries[name]
    }

    nonEmptyString: (node) => {
        (node.kind == "string").ifFalse(() => {
            fail()
        })
        value: node.value
        if(value == "") {
            fail()
        }
        value
    }

    checkAllowed: (entries, allowed) => {
        entries.each((name, valueNode) => {
            allowed.containsKey(name).ifFalse(() => {
                fail()
            })
        })
    }

    base: baseFromTable(root)
    rootEntries: tableEntries(root)

    compatibility: null
    if(rootEntries.containsKey("compatibility")) {
        compatibilityEntries: tableEntries(rootEntries["compatibility"])
        compatibilityAllowed: Map()
        compatibilityAllowed["language"] = true
        checkAllowed(compatibilityEntries, compatibilityAllowed)
        language: nonEmptyString(requiredNode(compatibilityEntries, "language"))
        compatibility = {
            language: language
        }
    }

    exports: Map()
    if(rootEntries.containsKey("exports")) {
        exportEntries: tableEntries(rootEntries["exports"])
        exportEntries.each((name, valueNode) => {
            exports[name] = nonEmptyString(valueNode)
        })
    }

    workspace: null
    if(rootEntries.containsKey("workspace")) {
        workspaceEntries: tableEntries(rootEntries["workspace"])
        workspaceAllowed: Map()
        workspaceAllowed["members"] = true
        checkAllowed(workspaceEntries, workspaceAllowed)

        membersNode: requiredNode(workspaceEntries, "members")
        (membersNode.kind == "array").ifFalse(() => {
            fail()
        })

        members: Array()
        seenMembers: Map()
        membersNode.value.each((memberNode) => {
            member: nonEmptyString(memberNode)
            if(seenMembers.containsKey(member)) {
                fail()
            }
            seenMembers[member] = true
            members = Array(...members, member)
        })

        workspace = {
            members: members
        }
    }

    {
        package: base.package
        compatibility: compatibility
        exports: exports
        workspace: workspace
    }
}

parseSections: (text) => {
    TOML: import("std:toml/TOML")
    sectionsFromTable(TOML.parseDialect(text, "1.0"))
}

fromTable: (root) => {
    tableEntries: (node) => {
        (node.kind == "table").ifFalse(() => {
            fail()
        })
        node.value
    }

    nonEmptyString: (node) => {
        (node.kind == "string").ifFalse(() => {
            fail()
        })
        value: node.value
        if(value == "") {
            fail()
        }
        value
    }

    checkAllowed: (entries, allowed) => {
        entries.each((name, valueNode) => {
            allowed.containsKey(name).ifFalse(() => {
                fail()
            })
        })
    }

    sections: sectionsFromTable(root)
    rootEntries: tableEntries(root)
    dependencies: Map()

    if(rootEntries.containsKey("dependencies")) {
        dependencyEntries: tableEntries(rootEntries["dependencies"])

        dependencyEntries.each((alias, declarationNode) => {
            declarationEntries: tableEntries(declarationNode)
            declarationAllowed: Map()
            declarationAllowed["authority"] = true
            declarationAllowed["package"] = true
            declarationAllowed["version"] = true
            declarationAllowed["git"] = true
            declarationAllowed["rev"] = true
            declarationAllowed["path"] = true
            checkAllowed(declarationEntries, declarationAllowed)

            hasAuthority: declarationEntries.containsKey("authority")
            hasPackage: declarationEntries.containsKey("package")
            hasVersion: declarationEntries.containsKey("version")
            hasGit: declarationEntries.containsKey("git")
            hasRev: declarationEntries.containsKey("rev")
            hasPath: declarationEntries.containsKey("path")

            registryTouched: hasAuthority
            if(hasPackage) { registryTouched = true }
            if(hasVersion) { registryTouched = true }

            registryComplete: hasAuthority
            hasPackage.ifFalse(() => { registryComplete = false })
            hasVersion.ifFalse(() => { registryComplete = false })

            gitTouched: hasGit
            if(hasRev) { gitTouched = true }

            gitComplete: hasGit
            hasRev.ifFalse(() => { gitComplete = false })

            registryValid: registryComplete
            if(gitTouched) { registryValid = false }
            if(hasPath) { registryValid = false }

            gitValid: gitComplete
            if(registryTouched) { gitValid = false }
            if(hasPath) { gitValid = false }

            pathValid: hasPath
            if(registryTouched) { pathValid = false }
            if(gitTouched) { pathValid = false }

            dependency: null
            valid: false

            if(registryValid) {
                dependency = {
                    authority: nonEmptyString(declarationEntries["authority"])
                    package: nonEmptyString(declarationEntries["package"])
                    version: nonEmptyString(declarationEntries["version"])
                }
                valid = true
            }

            if(gitValid) {
                dependency = {
                    git: nonEmptyString(declarationEntries["git"])
                    rev: nonEmptyString(declarationEntries["rev"])
                }
                valid = true
            }

            if(pathValid) {
                dependency = {
                    path: nonEmptyString(declarationEntries["path"])
                }
                valid = true
            }

            valid.ifFalse(() => {
                fail()
            })

            dependencies[alias] = dependency
        })
    }

    {
        package: sections.package
        compatibility: sections.compatibility
        exports: sections.exports
        dependencies: dependencies
        workspace: sections.workspace
    }
}

parse: (text) => {
    TOML: import("std:toml/TOML")
    fromTable(TOML.parseDialect(text, "1.0"))
}
