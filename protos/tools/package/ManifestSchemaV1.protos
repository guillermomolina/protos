baseFromTable: (root) => {
    fail: () => {
        Error().signal()
    }

    tableEntries: (node) => {
        (node.kind == "table").ifFalse(() => {
            fail()
        })
        node.value
    }

    requiredNode: (entries, name) => {
        entries.containsKey(name).ifFalse(() => {
            fail()
        })
        entries.at(name)
    }

    nonEmptyString: (node) => {
        (node.kind == "string").ifFalse(() => {
            fail()
        })
        value: node.value
        (value == "").ifTrue(() => {
            fail()
        })
        value
    }

    checkAllowed: (entries, allowed) => {
        entries.each((name, valueNode) => {
            allowed.containsKey(name).ifFalse(() => {
                fail()
            })
        })
    }

    rootAllowed: Map()
    rootAllowed.atPut("manifest-version", true)
    rootAllowed.atPut("package", true)
    rootAllowed.atPut("compatibility", true)
    rootAllowed.atPut("exports", true)
    rootAllowed.atPut("dependencies", true)
    rootAllowed.atPut("workspace", true)

    rootEntries: tableEntries(root)
    checkAllowed(rootEntries, rootAllowed)

    manifestVersion: requiredNode(rootEntries, "manifest-version")
    (manifestVersion.kind == "integer").ifFalse(() => {
        fail()
    })
    (manifestVersion.value == 1).ifFalse(() => {
        fail()
    })

    packageNode: requiredNode(rootEntries, "package")
    packageEntries: tableEntries(packageNode)
    packageAllowed: Map()
    packageAllowed.atPut("id", true)
    packageAllowed.atPut("version", true)
    packageAllowed.atPut("locator", true)
    checkAllowed(packageEntries, packageAllowed)

    packageId: nonEmptyString(requiredNode(packageEntries, "id"))
    packageVersion: nonEmptyString(requiredNode(packageEntries, "version"))
    packageLocator: null
    packageEntries.containsKey("locator").ifTrue(() => {
        packageLocator = nonEmptyString(packageEntries.at("locator"))
    })

    {
        package: {
            id: packageId
            version: packageVersion
            locator: packageLocator
        }
    }
}

parseBase: (text) => {
    Document: import("self:TomlDocument")
    baseFromTable(Document.table(text))
}

sectionsFromTable: (root) => {
    fail: () => {
        Error().signal()
    }

    tableEntries: (node) => {
        (node.kind == "table").ifFalse(() => {
            fail()
        })
        node.value
    }

    requiredNode: (entries, name) => {
        entries.containsKey(name).ifFalse(() => {
            fail()
        })
        entries.at(name)
    }

    nonEmptyString: (node) => {
        (node.kind == "string").ifFalse(() => {
            fail()
        })
        value: node.value
        (value == "").ifTrue(() => {
            fail()
        })
        value
    }

    checkAllowed: (entries, allowed) => {
        entries.each((name, valueNode) => {
            allowed.containsKey(name).ifFalse(() => {
                fail()
            })
        })
    }

    base: baseFromTable(root)
    rootEntries: tableEntries(root)

    compatibility: null
    rootEntries.containsKey("compatibility").ifTrue(() => {
        compatibilityEntries: tableEntries(rootEntries.at("compatibility"))
        compatibilityAllowed: Map()
        compatibilityAllowed.atPut("language", true)
        checkAllowed(compatibilityEntries, compatibilityAllowed)
        language: nonEmptyString(requiredNode(compatibilityEntries, "language"))
        compatibility = {
            language: language
        }
    })

    exports: Map()
    rootEntries.containsKey("exports").ifTrue(() => {
        exportEntries: tableEntries(rootEntries.at("exports"))
        exportEntries.each((name, valueNode) => {
            exports.atPut(name, nonEmptyString(valueNode))
        })
    })

    workspace: null
    rootEntries.containsKey("workspace").ifTrue(() => {
        workspaceEntries: tableEntries(rootEntries.at("workspace"))
        workspaceAllowed: Map()
        workspaceAllowed.atPut("members", true)
        checkAllowed(workspaceEntries, workspaceAllowed)

        membersNode: requiredNode(workspaceEntries, "members")
        (membersNode.kind == "array").ifFalse(() => {
            fail()
        })

        members: Array()
        seenMembers: Map()
        membersNode.value.each((memberNode) => {
            member: nonEmptyString(memberNode)
            seenMembers.containsKey(member).ifTrue(() => {
                fail()
            })
            seenMembers.atPut(member, true)
            members = Array(...members, member)
        })

        workspace = {
            members: members
        }
    })

    {
        package: base.package
        compatibility: compatibility
        exports: exports
        workspace: workspace
    }
}

parseSections: (text) => {
    Document: import("self:TomlDocument")
    sectionsFromTable(Document.table(text))
}
