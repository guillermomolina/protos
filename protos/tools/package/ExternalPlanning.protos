// I151/D242 SOURCE entry executed by the Java host as an explicitly selected
// bundled Package Tool entry; helpers are imported relatively.
Plan: import("./ExecutionPlan.protos")
Version: import("./ReleaseVersion.protos")
fail: () => { Error().signal() }
verified: Array()
verifiedExternalInputs.each((input) => {
    ref: null
    (input.kind == "registry").ifTrue(() => {
        ref = {
            kind: "registry"
            packageId: input.packageId
            version: Version.parse(input.exact)
        }
    })
    (input.kind == "git").ifTrue(() => {
        ref = {
            kind: "git"
            packageId: input.packageId
            revision: input.exact
        }
    })
    (ref === null).ifTrue(() => { fail() })
    verified = Array(
        ...verified,
        {
            ref: ref
            content: {
                method: input.contentMethod
                algorithm: input.contentAlgorithm
                hex: input.contentHex
            }
            filesystem: input.filesystem
        }
    )
})
Plan.buildV2FromVerifiedCaptures(projectTreeFilesystem, verified)
