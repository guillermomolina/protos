Root: import("self:ResolutionRoot")
LockFile: import("self:LockFile")
Input: import("self:ResolutionInput")
Names: import("self:RuntimeNames")
Syntax: import("self:LockSyntax")
Constraint: import("self:DependencyConstraint")
Manifest: import("self:ManifestCommand")
Version: import("self:ReleaseVersion")

fail: () => {
    Error().signal()
}

workspaceRef: (packageId) => {
    {
        kind: "workspace"
        packageId: packageId
    }
}

workspaceRefMatches: (ref, packageId) => {
    matches: ref.kind == "workspace"
    matches.ifTrue(() => {
        matches = ref.packageId == packageId
    })
    matches
}

packageAt: (packages, location) => {
    found: null

    packages.each((package) => {
        (package.location == location).ifTrue(() => {
            found = package
        })
    })

    (found === null).ifTrue(() => {
        fail()
    })

    found
}

copyExports: (manifest) => {
    result: Map()

    manifest.exports.each((publicName, internalName) => {
        Names.requireLogicalName(publicName)
        Names.requireLogicalName(internalName)
        result[publicName] = internalName
    })

    result
}

lockMemberAt: (lock, declaration) => {
    found: null

    lock.workspaceMembers.each((member) => {
        (member.declaration == declaration).ifTrue(() => {
            found = member
        })
    })

    found
}

lockDependencyAt: (lock, declaringPackageId, alias) => {
    found: null

    lock.dependencies.each((dependency) => {
        workspaceRefMatches(
            dependency.declaring,
            declaringPackageId
        ).ifTrue(() => {
            (dependency.alias == alias).ifTrue(() => {
                found = dependency
            })
        })
    })

    found
}

countLockDependencies: (lock, declaringPackageId) => {
    count: 0

    lock.dependencies.each((dependency) => {
        workspaceRefMatches(
            dependency.declaring,
            declaringPackageId
        ).ifTrue(() => {
            count = count + 1
        })
    })

    count
}

validatePackageDependencies: (lock, package) => {
    currentDependencies: package.projected.dependencies

    (countLockDependencies(lock, package.packageId) == currentDependencies.size()).ifFalse(() => {
        fail()
    })

    planDependencies: Array()

    currentDependencies.each((dependency) => {
        Names.requireAlias(dependency.alias)

        (dependency.kind == "path").ifFalse(() => {
            fail()
        })

        locked:
            lockDependencyAt(
                lock,
                package.packageId,
                dependency.alias
            )

        (locked === null).ifTrue(() => {
            fail()
        })

        workspaceRefMatches(
            locked.target,
            dependency.targetPackageId
        ).ifFalse(() => {
            fail()
        })

        planDependencies =
            Array(
                ...planDependencies,
                {
                    declaring: workspaceRef(package.packageId)
                    alias: dependency.alias
                    target: workspaceRef(dependency.targetPackageId)
                }
            )
    })

    planDependencies
}

copyNodeRef: (ref) => {
    Syntax.parseNodeRef(Syntax.renderNodeRef(ref))
}

nodeRefKey: (ref) => {
    Syntax.renderNodeRef(ref)
}

copyContentIdentity: (content) => {
    {
        method: content.method
        algorithm: content.algorithm
        hex: content.hex
    }
}

sameContentIdentity: (left, right) => {
    same: left.method == right.method
    same.ifTrue(() => {
        same = left.algorithm == right.algorithm
    })
    same.ifTrue(() => {
        same = left.hex == right.hex
    })
    same
}

copyExternalExports: (exports) => {
    result: Map()

    exports.each((publicName, internalName) => {
        Names.requireLogicalName(publicName)
        Names.requireLogicalName(internalName)
        result[publicName] = internalName
    })

    result
}

lockedExternalNodeAt: (lock, ref) => {
    found: null
    key: nodeRefKey(ref)

    lock.registryNodes.each((node) => {
        (nodeRefKey(node.ref) == key).ifTrue(() => {
            found = node
        })
    })

    lock.gitNodes.each((node) => {
        (nodeRefKey(node.ref) == key).ifTrue(() => {
            found = node
        })
    })

    found
}

validateV2WorkspaceDependencies: (lock, package) => {
    currentDependencies: package.projected.dependencies

    (countLockDependencies(lock, package.packageId) == currentDependencies.size()).ifFalse(() => {
        fail()
    })

    result: Array()

    currentDependencies.each((dependency) => {
        Names.requireAlias(dependency.alias)

        locked:
            lockDependencyAt(
                lock,
                package.packageId,
                dependency.alias
            )

        (locked === null).ifTrue(() => {
            fail()
        })

        known: false

        (dependency.kind == "path").ifTrue(() => {
            known = true
            workspaceRefMatches(
                locked.target,
                dependency.targetPackageId
            ).ifFalse(() => {
                fail()
            })
        })

        (dependency.kind == "registry").ifTrue(() => {
            known = true

            (locked.target.kind == "registry").ifFalse(() => {
                fail()
            })

            lockedNode: lockedExternalNodeAt(lock, locked.target)
            (lockedNode === null).ifTrue(() => {
                fail()
            })

            (lockedNode.authority == dependency.authority).ifFalse(() => {
                fail()
            })
            (lockedNode.locator == dependency.packageId).ifFalse(() => {
                fail()
            })
            Constraint.satisfies(
                dependency.constraint,
                locked.target.version
            ).ifFalse(() => {
                fail()
            })
        })

        (dependency.kind == "git").ifTrue(() => {
            known = true

            (locked.target.kind == "git").ifFalse(() => {
                fail()
            })

            lockedNode: lockedExternalNodeAt(lock, locked.target)
            (lockedNode === null).ifTrue(() => {
                fail()
            })

            (lockedNode.fetch == dependency.repository).ifFalse(() => {
                fail()
            })
            (locked.target.revision == dependency.revision).ifFalse(() => {
                fail()
            })
        })

        known.ifFalse(() => {
            fail()
        })

        result =
            Array(
                ...result,
                {
                    declaring: workspaceRef(package.packageId)
                    alias: dependency.alias
                    target: copyNodeRef(locked.target)
                }
            )
    })

    result
}

sameNodeRef: (left, right) => {
    nodeRefKey(left) == nodeRefKey(right)
}

lockDependencyAtRef: (lock, declaringRef, alias) => {
    found: null
    count: 0

    lock.dependencies.each((dependency) => {
        sameNodeRef(
            dependency.declaring,
            declaringRef
        ).ifTrue(() => {
            (dependency.alias == alias).ifTrue(() => {
                found = dependency
                count = count + 1
            })
        })
    })

    (count > 1).ifTrue(() => {
        fail()
    })

    found
}

countLockDependenciesAtRef: (lock, declaringRef) => {
    count: 0

    lock.dependencies.each((dependency) => {
        sameNodeRef(
            dependency.declaring,
            declaringRef
        ).ifTrue(() => {
            count = count + 1
        })
    })

    count
}

prepareVerifiedExternalPackage: (
    lock,
    resolutionRoot,
    verified
) => {
    kind: verified.ref.kind
    external: kind == "registry"
    (kind == "git").ifTrue(() => {
        external = true
    })
    external.ifFalse(() => {
        fail()
    })

    lockedNode: lockedExternalNodeAt(lock, verified.ref)
    (lockedNode === null).ifTrue(() => {
        fail()
    })

    sameContentIdentity(
        verified.content,
        lockedNode.content
    ).ifFalse(() => {
        fail()
    })

    // F2E2 owns the fact that this is the same already-verified immutable
    // capture. F2E3B reads the manifest through that capability and does not
    // retain the Filesystem in the inert result.
    manifest: Manifest.load(verified.filesystem)

    (manifest.workspace === null).ifFalse(() => {
        // D057: workspace is mutable-root/development-only under the current
        // immutable package model, including an empty members declaration.
        fail()
    })

    (manifest.package.id == lockedNode.ref.packageId).ifFalse(() => {
        fail()
    })

    manifestVersion: Version.parse(manifest.package.version)

    (lockedNode.ref.kind == "registry").ifTrue(() => {
        (Version.compare(
            manifestVersion,
            lockedNode.ref.version
        ) == 0).ifFalse(() => {
            fail()
        })
    })

    // For exact-Git nodes the package release value remains validated metadata;
    // the locked exact revision, not package.version, is Git node identity.

    (manifest.compatibility === null).ifFalse(() => {
        (manifest.compatibility.language ==
            resolutionRoot.languageCompatibility).ifFalse(() => {
            fail()
        })
    })

    {
        ref: copyNodeRef(lockedNode.ref)
        content: copyContentIdentity(lockedNode.content)
        exports: copyExternalExports(manifest.exports)
        manifest: manifest
    }
}

validateV2ExternalDependencies: (lock, package) => {
    currentDependencies: package.manifest.dependencies

    (countLockDependenciesAtRef(
        lock,
        package.ref
    ) == currentDependencies.size()).ifFalse(() => {
        fail()
    })

    result: Array()

    currentDependencies.each((alias, declaration) => {
        Names.requireAlias(alias)
        kind: Root.dependencyKind(declaration)

        (kind == "path").ifTrue(() => {
            // D056: immutable registry/Git packages cannot operationalize path.
            fail()
        })

        locked:
            lockDependencyAtRef(
                lock,
                package.ref,
                alias
            )

        (locked === null).ifTrue(() => {
            fail()
        })

        known: false

        (kind == "registry").ifTrue(() => {
            known = true

            (locked.target.kind == "registry").ifFalse(() => {
                fail()
            })

            lockedTarget: lockedExternalNodeAt(lock, locked.target)
            (lockedTarget === null).ifTrue(() => {
                fail()
            })

            (lockedTarget.authority == declaration.authority).ifFalse(() => {
                fail()
            })
            (lockedTarget.locator == declaration.package).ifFalse(() => {
                fail()
            })
            Constraint.satisfies(
                Constraint.parse(declaration.version),
                locked.target.version
            ).ifFalse(() => {
                fail()
            })
        })

        (kind == "git").ifTrue(() => {
            known = true

            (locked.target.kind == "git").ifFalse(() => {
                fail()
            })

            lockedTarget: lockedExternalNodeAt(lock, locked.target)
            (lockedTarget === null).ifTrue(() => {
                fail()
            })

            (lockedTarget.fetch == declaration.git).ifFalse(() => {
                fail()
            })
            (locked.target.revision == declaration.rev).ifFalse(() => {
                fail()
            })
        })

        known.ifFalse(() => {
            fail()
        })

        result =
            Array(
                ...result,
                {
                    declaring: copyNodeRef(package.ref)
                    alias: alias
                    target: copyNodeRef(locked.target)
                }
            )
    })

    result
}

// F2E3 bounded constructor: generation-2 planning for already-verified immutable
// external leaf packages. The supplied descriptors are inert data only; the
// caller remains responsible for admitting them from F2E2 verified custody.
// External-declared dependency validation remains later F2E3 work.
buildV2FromVerifiedLeaves: (projectTreeFilesystem, verifiedExternalPackages) => {
    state: Root.assembleState(projectTreeFilesystem)
    resolutionRoot: state.resolutionRoot
    lock: LockFile.load(projectTreeFilesystem)

    Input.matchesHeader(resolutionRoot, lock.header).ifFalse(() => {
        fail()
    })

    workspaceRefMatches(
        lock.root,
        resolutionRoot.root.packageId
    ).ifFalse(() => {
        fail()
    })

    (lock.workspaceMembers.size() == resolutionRoot.members.size()).ifFalse(() => {
        fail()
    })

    resolutionRoot.members.each((member) => {
        locked: lockMemberAt(lock, member.location)

        (locked === null).ifTrue(() => {
            fail()
        })

        workspaceRefMatches(
            locked.ref,
            member.packageId
        ).ifFalse(() => {
            fail()
        })
    })

    // This bounded slice admits only external leaves. A later F2E3 slice will
    // validate dependencies declared by the same verified external captures.
    lock.dependencies.each((dependency) => {
        (dependency.declaring.kind == "workspace").ifFalse(() => {
            fail()
        })
    })

    lockedExternal: Map()

    lock.registryNodes.each((node) => {
        key: nodeRefKey(node.ref)
        lockedExternal.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal[key] = node
    })

    lock.gitNodes.each((node) => {
        key: nodeRefKey(node.ref)
        lockedExternal.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal[key] = node
    })

    verifiedByRef: Map()

    verifiedExternalPackages.each((verified) => {
        kind: verified.ref.kind
        external: kind == "registry"
        (kind == "git").ifTrue(() => {
            external = true
        })
        external.ifFalse(() => {
            fail()
        })

        key: nodeRefKey(verified.ref)

        verifiedByRef.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal.containsKey(key).ifFalse(() => {
            fail()
        })

        lockedNode: lockedExternal[key]
        sameContentIdentity(
            verified.content,
            lockedNode.content
        ).ifFalse(() => {
            fail()
        })

        verifiedByRef[key] = verified
    })

    (verifiedByRef.size() == lockedExternal.size()).ifFalse(() => {
        fail()
    })

    rootPackage: packageAt(state.packages, "")
    planPackages:
        Array(
            {
                ref: workspaceRef(rootPackage.packageId)
                location: ""
                exports: copyExports(rootPackage.manifest)
            }
        )

    lock.workspaceMembers.each((lockedMember) => {
        package:
            packageAt(
                state.packages,
                lockedMember.declaration
            )

        (package.packageId == lockedMember.ref.packageId).ifFalse(() => {
            fail()
        })

        planPackages =
            Array(
                ...planPackages,
                {
                    ref: workspaceRef(package.packageId)
                    location: package.location
                    exports: copyExports(package.manifest)
                }
            )
    })

    appendExternal: (lockedNode) => {
        key: nodeRefKey(lockedNode.ref)
        verifiedByRef.containsKey(key).ifFalse(() => {
            fail()
        })
        verified: verifiedByRef[key]

        planPackages =
            Array(
                ...planPackages,
                {
                    ref: copyNodeRef(lockedNode.ref)
                    content: copyContentIdentity(lockedNode.content)
                    exports: copyExternalExports(verified.exports)
                }
            )
    }

    lock.registryNodes.each((node) => {
        appendExternal(node)
    })
    lock.gitNodes.each((node) => {
        appendExternal(node)
    })

    planDependencies: Array()

    state.packages.each((package) => {
        packageDependencies:
            validateV2WorkspaceDependencies(
                lock,
                package
            )

        packageDependencies.each((dependency) => {
            planDependencies =
                Array(
                    ...planDependencies,
                    dependency
                )
        })
    })

    (planDependencies.size() == lock.dependencies.size()).ifFalse(() => {
        fail()
    })

    {
        generation: 2
        root: workspaceRef(resolutionRoot.root.packageId)
        packages: planPackages
        dependencies: planDependencies
    }
}

// F2E3B constructor: derive external package policy exclusively from each same-
// capture verified Filesystem. Input Filesystems are consumed during preflight
// but never enter PackageExecutionPlanV2.
buildV2FromVerifiedCaptures: (
    projectTreeFilesystem,
    verifiedExternalPackages
) => {
    state: Root.assembleState(projectTreeFilesystem)
    resolutionRoot: state.resolutionRoot
    lock: LockFile.load(projectTreeFilesystem)

    Input.matchesHeader(resolutionRoot, lock.header).ifFalse(() => {
        fail()
    })

    workspaceRefMatches(
        lock.root,
        resolutionRoot.root.packageId
    ).ifFalse(() => {
        fail()
    })

    (lock.workspaceMembers.size() == resolutionRoot.members.size()).ifFalse(() => {
        fail()
    })

    resolutionRoot.members.each((member) => {
        locked: lockMemberAt(lock, member.location)

        (locked === null).ifTrue(() => {
            fail()
        })

        workspaceRefMatches(
            locked.ref,
            member.packageId
        ).ifFalse(() => {
            fail()
        })
    })

    lockedExternal: Map()

    lock.registryNodes.each((node) => {
        key: nodeRefKey(node.ref)
        lockedExternal.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal[key] = node
    })

    lock.gitNodes.each((node) => {
        key: nodeRefKey(node.ref)
        lockedExternal.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal[key] = node
    })

    preparedByRef: Map()

    verifiedExternalPackages.each((verified) => {
        key: nodeRefKey(verified.ref)

        preparedByRef.containsKey(key).ifTrue(() => {
            fail()
        })
        lockedExternal.containsKey(key).ifFalse(() => {
            fail()
        })

        prepared:
            prepareVerifiedExternalPackage(
                lock,
                resolutionRoot,
                verified
            )

        preparedByRef[key] = prepared
    })

    (preparedByRef.size() == lockedExternal.size()).ifFalse(() => {
        fail()
    })

    rootPackage: packageAt(state.packages, "")
    planPackages:
        Array(
            {
                ref: workspaceRef(rootPackage.packageId)
                location: ""
                exports: copyExports(rootPackage.manifest)
            }
        )

    lock.workspaceMembers.each((lockedMember) => {
        package:
            packageAt(
                state.packages,
                lockedMember.declaration
            )

        (package.packageId == lockedMember.ref.packageId).ifFalse(() => {
            fail()
        })

        planPackages =
            Array(
                ...planPackages,
                {
                    ref: workspaceRef(package.packageId)
                    location: package.location
                    exports: copyExports(package.manifest)
                }
            )
    })

    appendExternal: (lockedNode) => {
        key: nodeRefKey(lockedNode.ref)
        preparedByRef.containsKey(key).ifFalse(() => {
            fail()
        })

        prepared: preparedByRef[key]

        planPackages =
            Array(
                ...planPackages,
                {
                    ref: copyNodeRef(prepared.ref)
                    content: copyContentIdentity(prepared.content)
                    exports: copyExternalExports(prepared.exports)
                }
            )
    }

    lock.registryNodes.each((node) => {
        appendExternal(node)
    })
    lock.gitNodes.each((node) => {
        appendExternal(node)
    })

    planDependencies: Array()

    state.packages.each((package) => {
        packageDependencies:
            validateV2WorkspaceDependencies(
                lock,
                package
            )

        packageDependencies.each((dependency) => {
            planDependencies =
                Array(
                    ...planDependencies,
                    dependency
                )
        })
    })

    lock.registryNodes.each((node) => {
        prepared: preparedByRef[nodeRefKey(node.ref)]
        packageDependencies:
            validateV2ExternalDependencies(
                lock,
                prepared
            )

        packageDependencies.each((dependency) => {
            planDependencies =
                Array(
                    ...planDependencies,
                    dependency
                )
        })
    })

    lock.gitNodes.each((node) => {
        prepared: preparedByRef[nodeRefKey(node.ref)]
        packageDependencies:
            validateV2ExternalDependencies(
                lock,
                prepared
            )

        packageDependencies.each((dependency) => {
            planDependencies =
                Array(
                    ...planDependencies,
                    dependency
                )
        })
    })

    (planDependencies.size() == lock.dependencies.size()).ifFalse(() => {
        fail()
    })

    {
        generation: 2
        root: workspaceRef(resolutionRoot.root.packageId)
        packages: planPackages
        dependencies: planDependencies
    }
}

build: (projectTreeFilesystem) => {
    state: Root.assembleState(projectTreeFilesystem)
    resolutionRoot: state.resolutionRoot
    lock: LockFile.load(projectTreeFilesystem)

    Input.matchesHeader(resolutionRoot, lock.header).ifFalse(() => {
        fail()
    })

    (lock.registryNodes.size() == 0).ifFalse(() => {
        fail()
    })
    (lock.gitNodes.size() == 0).ifFalse(() => {
        fail()
    })

    workspaceRefMatches(
        lock.root,
        resolutionRoot.root.packageId
    ).ifFalse(() => {
        fail()
    })

    (lock.workspaceMembers.size() == resolutionRoot.members.size()).ifFalse(() => {
        fail()
    })

    resolutionRoot.members.each((member) => {
        locked: lockMemberAt(lock, member.location)

        (locked === null).ifTrue(() => {
            fail()
        })

        workspaceRefMatches(
            locked.ref,
            member.packageId
        ).ifFalse(() => {
            fail()
        })
    })

    rootPackage: packageAt(state.packages, "")
    planPackages:
        Array(
            {
                ref: workspaceRef(rootPackage.packageId)
                location: ""
                exports: copyExports(rootPackage.manifest)
            }
        )

    lock.workspaceMembers.each((lockedMember) => {
        package:
            packageAt(
                state.packages,
                lockedMember.declaration
            )

        (package.packageId == lockedMember.ref.packageId).ifFalse(() => {
            fail()
        })

        planPackages =
            Array(
                ...planPackages,
                {
                    ref: workspaceRef(package.packageId)
                    location: package.location
                    exports: copyExports(package.manifest)
                }
            )
    })

    planDependencies: Array()
    state.packages.each((package) => {
        packageDependencies:
            validatePackageDependencies(
                lock,
                package
            )

        packageDependencies.each((dependency) => {
            planDependencies =
                Array(
                    ...planDependencies,
                    dependency
                )
        })
    })

    (planDependencies.size() == lock.dependencies.size()).ifFalse(() => {
        fail()
    })

    {
        generation: 1
        root: workspaceRef(resolutionRoot.root.packageId)
        packages: planPackages
        dependencies: planDependencies
    }
}
