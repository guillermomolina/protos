Schema: import("self:ManifestSchemaV1")

readText: (projectFilesystem) => {
    file: projectFilesystem.open(Path.relative().child("protos.toml")).value()
    reader: TextReader.owning(file, Encoding.UTF8)
    text: ""

    readNext: null
    readNext = () => {
        chunk: reader.readText().value()
        (chunk === null).ifFalse(() => {
            text = text + chunk
            readNext()
        })
    }

    Error.handle(() => {
        readNext()
    }, (error) => {
        reader.close().value()
        error.signal()
    })

    reader.close().value()
    text
}

load: (projectFilesystem) => {
    Schema.parse(readText(projectFilesystem))
}

run: (projectFilesystem, stdoutWriter, stderrWriter) => {
    text: null
    Error.handle(() => {
        text = readText(projectFilesystem)
    }, (error) => {
        stderrWriter.writeLine("protos.toml: cannot read as UTF-8").value()
        error.signal()
    })

    model: null
    Error.handle(() => {
        model = Schema.parse(text)
    }, (error) => {
        stderrWriter.writeLine("protos.toml: invalid TOML/schema v1").value()
        error.signal()
    })

    stdoutWriter.writeLine("protos.toml: valid schema v1").value()
    model
}
