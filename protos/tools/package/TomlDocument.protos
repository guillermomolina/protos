statements: (text) => {
    ignoredStringValidation: text + ""
    source: Encoding.UTF8.encode(text)
    index: 0
    length: source.size()

    result: Array()
    buffer: Encoding.UTF8.encode("")
    significant: false
    squareDepth: 0
    braceDepth: 0
    stringQuote: -1
    multiline: false
    comment: false

    fail: () => {
        Error().signal()
    }

    peek: () => {
        value: -1
        (index < length).ifTrue(() => {
            value = source.at(index)
        })
        value
    }

    take: () => {
        (index >= length).ifTrue(() => {
            fail()
        })
        value: source.at(index)
        index = index + 1
        value
    }

    append: (octet) => {
        buffer.add(octet)
        (octet == 32).ifFalse(() => {
            (octet == 9).ifFalse(() => {
                significant = true
            })
        })
    }

    appendQuotes: null
    appendQuotes = (quote, remaining) => {
        (remaining > 0).ifTrue(() => {
            append(quote)
            appendQuotes(quote, remaining - 1)
        })
    }

    quoteRun: (quote) => {
        look: index
        count: 0

        scan: null
        scan = () => {
            (look < length).ifTrue(() => {
                (source.at(look) == quote).ifTrue(() => {
                    count = count + 1
                    look = look + 1
                    scan()
                })
            })
        }

        scan()
        count
    }

    finish: () => {
        significant.ifTrue(() => {
            result = Array(...result, Encoding.UTF8.decode(buffer))
        })
        buffer = Encoding.UTF8.encode("")
        significant = false
    }

    appendNewline: (include) => {
        first: take()
        (first == 10).ifTrue(() => {
            include.ifTrue(() => { append(10) })
        })
        (first == 13).ifTrue(() => {
            (peek() == 10).ifFalse(() => {
                fail()
            })
            second: take()
            include.ifTrue(() => {
                append(13)
                append(second)
            })
        })
        (first == 10).ifFalse(() => {
            (first == 13).ifFalse(() => {
                fail()
            })
        })
    }

    loop: null
    loop = () => {
        (index < length).ifTrue(() => {
            octet: peek()

            wasComment: comment
            wasComment.ifTrue(() => {
                isNewline: octet == 10
                (octet == 13).ifTrue(() => { isNewline = true })

                isNewline.ifTrue(() => {
                    comment = false
                    nested: squareDepth > 0
                    (braceDepth > 0).ifTrue(() => { nested = true })
                    nested.ifTrue(() => {
                        appendNewline(true)
                    })
                    nested.ifFalse(() => {
                        appendNewline(false)
                        finish()
                    })
                })

                isNewline.ifFalse(() => {
                    index = index + 1
                })
            })

            wasComment.ifFalse(() => {
                wasString: stringQuote >= 0
                wasString.ifTrue(() => {
                    wasMultiline: multiline
                    wasMultiline.ifTrue(() => {
                        // Snapshot this before closing mutates stringQuote.
                        quoteOctet: octet == stringQuote
                        quoteOctet.ifTrue(() => {
                            run: quoteRun(stringQuote)
                            (run >= 3).ifTrue(() => {
                                (run > 5).ifTrue(() => {
                                    fail()
                                })
                                appendQuotes(stringQuote, run)
                                index = index + run
                                stringQuote = -1
                                multiline = false
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                            })
                        })

                        quoteOctet.ifFalse(() => {
                            escapedBasic: stringQuote == 34
                            (octet == 92).ifFalse(() => {
                                escapedBasic = false
                            })

                            escapedBasic.ifTrue(() => {
                                append(take())
                                (index >= length).ifTrue(() => {
                                    fail()
                                })
                                append(take())
                            })

                            escapedBasic.ifFalse(() => {
                                append(take())
                            })
                        })
                    })

                    wasMultiline.ifFalse(() => {
                        isNewline: octet == 10
                        (octet == 13).ifTrue(() => { isNewline = true })
                        isNewline.ifTrue(() => {
                            fail()
                        })

                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        escapedBasic.ifTrue(() => {
                            append(take())
                            (index >= length).ifTrue(() => {
                                fail()
                            })
                            append(take())
                        })

                        escapedBasic.ifFalse(() => {
                            append(take())
                            (octet == stringQuote).ifTrue(() => {
                                stringQuote = -1
                            })
                        })
                    })
                })

                wasString.ifFalse(() => {
                    (octet == 35).ifTrue(() => {
                        comment = true
                        index = index + 1
                    })

                    (octet == 35).ifFalse(() => {
                        isQuote: octet == 34
                        (octet == 39).ifTrue(() => { isQuote = true })

                        isQuote.ifTrue(() => {
                            run: quoteRun(octet)
                            (run >= 3).ifTrue(() => {
                                appendQuotes(octet, 3)
                                index = index + 3
                                stringQuote = octet
                                multiline = true
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                                stringQuote = octet
                                multiline = false
                            })
                        })

                        isQuote.ifFalse(() => {
                            (octet == 91).ifTrue(() => {
                                squareDepth = squareDepth + 1
                                append(take())
                            })
                            (octet == 93).ifTrue(() => {
                                (squareDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                squareDepth = squareDepth - 1
                                append(take())
                            })
                            (octet == 123).ifTrue(() => {
                                braceDepth = braceDepth + 1
                                append(take())
                            })
                            (octet == 125).ifTrue(() => {
                                (braceDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                braceDepth = braceDepth - 1
                                append(take())
                            })

                            structural: octet == 91
                            (octet == 93).ifTrue(() => { structural = true })
                            (octet == 123).ifTrue(() => { structural = true })
                            (octet == 125).ifTrue(() => { structural = true })

                            structural.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => { isNewline = true })

                                isNewline.ifTrue(() => {
                                    nested: squareDepth > 0
                                    (braceDepth > 0).ifTrue(() => { nested = true })
                                    nested.ifTrue(() => {
                                        appendNewline(true)
                                    })
                                    nested.ifFalse(() => {
                                        appendNewline(false)
                                        finish()
                                    })
                                })

                                isNewline.ifFalse(() => {
                                    append(take())
                                })
                            })
                        })
                    })
                })
            })

            loop()
        })
    }

    loop()

    (stringQuote >= 0).ifTrue(() => {
        fail()
    })
    (squareDepth != 0).ifTrue(() => {
        fail()
    })
    (braceDepth != 0).ifTrue(() => {
        fail()
    })

    finish()
    result
}
