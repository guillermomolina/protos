statements: (text) => {
    ignoredStringValidation: text + ""
    source: Encoding.UTF8.encode(text)
    index: 0
    length: source.size()

    result: Array()
    buffer: Encoding.UTF8.encode("")
    significant: false
    squareDepth: 0
    braceDepth: 0
    stringQuote: -1
    multiline: false
    comment: false

    fail: () => {
        Error().signal()
    }

    peek: () => {
        value: -1
        (index < length).ifTrue(() => {
            value = source.at(index)
        })
        value
    }

    take: () => {
        (index >= length).ifTrue(() => {
            fail()
        })
        value: source.at(index)
        index = index + 1
        value
    }

    append: (octet) => {
        buffer.add(octet)
        (octet == 32).ifFalse(() => {
            (octet == 9).ifFalse(() => {
                significant = true
            })
        })
    }

    appendQuotes: null
    appendQuotes = (quote, remaining) => {
        (remaining > 0).ifTrue(() => {
            append(quote)
            appendQuotes(quote, remaining - 1)
        })
    }

    quoteRun: (quote) => {
        look: index
        count: 0

        scan: null
        scan = () => {
            (look < length).ifTrue(() => {
                (source.at(look) == quote).ifTrue(() => {
                    count = count + 1
                    look = look + 1
                    scan()
                })
            })
        }

        scan()
        count
    }

    finish: () => {
        significant.ifTrue(() => {
            result = Array(...result, Encoding.UTF8.decode(buffer))
        })
        buffer = Encoding.UTF8.encode("")
        significant = false
    }

    appendNewline: (include) => {
        first: take()
        (first == 10).ifTrue(() => {
            include.ifTrue(() => { append(10) })
        })
        (first == 13).ifTrue(() => {
            (peek() == 10).ifFalse(() => {
                fail()
            })
            second: take()
            include.ifTrue(() => {
                append(13)
                append(second)
            })
        })
        (first == 10).ifFalse(() => {
            (first == 13).ifFalse(() => {
                fail()
            })
        })
    }

    loop: null
    loop = () => {
        (index < length).ifTrue(() => {
            octet: peek()

            wasComment: comment
            wasComment.ifTrue(() => {
                isNewline: octet == 10
                (octet == 13).ifTrue(() => { isNewline = true })

                isNewline.ifTrue(() => {
                    comment = false
                    nested: squareDepth > 0
                    (braceDepth > 0).ifTrue(() => { nested = true })
                    nested.ifTrue(() => {
                        appendNewline(true)
                    })
                    nested.ifFalse(() => {
                        appendNewline(false)
                        finish()
                    })
                })

                isNewline.ifFalse(() => {
                    index = index + 1
                })
            })

            wasComment.ifFalse(() => {
                wasString: stringQuote >= 0
                wasString.ifTrue(() => {
                    wasMultiline: multiline
                    wasMultiline.ifTrue(() => {
                        // Snapshot this before closing mutates stringQuote.
                        quoteOctet: octet == stringQuote
                        quoteOctet.ifTrue(() => {
                            run: quoteRun(stringQuote)
                            (run >= 3).ifTrue(() => {
                                (run > 5).ifTrue(() => {
                                    fail()
                                })
                                appendQuotes(stringQuote, run)
                                index = index + run
                                stringQuote = -1
                                multiline = false
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                            })
                        })

                        quoteOctet.ifFalse(() => {
                            escapedBasic: stringQuote == 34
                            (octet == 92).ifFalse(() => {
                                escapedBasic = false
                            })

                            escapedBasic.ifTrue(() => {
                                append(take())
                                (index >= length).ifTrue(() => {
                                    fail()
                                })
                                append(take())
                            })

                            escapedBasic.ifFalse(() => {
                                append(take())
                            })
                        })
                    })

                    wasMultiline.ifFalse(() => {
                        isNewline: octet == 10
                        (octet == 13).ifTrue(() => { isNewline = true })
                        isNewline.ifTrue(() => {
                            fail()
                        })

                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        escapedBasic.ifTrue(() => {
                            append(take())
                            (index >= length).ifTrue(() => {
                                fail()
                            })
                            append(take())
                        })

                        escapedBasic.ifFalse(() => {
                            append(take())
                            (octet == stringQuote).ifTrue(() => {
                                stringQuote = -1
                            })
                        })
                    })
                })

                wasString.ifFalse(() => {
                    (octet == 35).ifTrue(() => {
                        comment = true
                        index = index + 1
                    })

                    (octet == 35).ifFalse(() => {
                        isQuote: octet == 34
                        (octet == 39).ifTrue(() => { isQuote = true })

                        isQuote.ifTrue(() => {
                            run: quoteRun(octet)
                            (run >= 3).ifTrue(() => {
                                appendQuotes(octet, 3)
                                index = index + 3
                                stringQuote = octet
                                multiline = true
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                                stringQuote = octet
                                multiline = false
                            })
                        })

                        isQuote.ifFalse(() => {
                            (octet == 91).ifTrue(() => {
                                squareDepth = squareDepth + 1
                                append(take())
                            })
                            (octet == 93).ifTrue(() => {
                                (squareDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                squareDepth = squareDepth - 1
                                append(take())
                            })
                            (octet == 123).ifTrue(() => {
                                braceDepth = braceDepth + 1
                                append(take())
                            })
                            (octet == 125).ifTrue(() => {
                                (braceDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                braceDepth = braceDepth - 1
                                append(take())
                            })

                            structural: octet == 91
                            (octet == 93).ifTrue(() => { structural = true })
                            (octet == 123).ifTrue(() => { structural = true })
                            (octet == 125).ifTrue(() => { structural = true })

                            structural.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => { isNewline = true })

                                isNewline.ifTrue(() => {
                                    nested: squareDepth > 0
                                    (braceDepth > 0).ifTrue(() => { nested = true })
                                    nested.ifTrue(() => {
                                        appendNewline(true)
                                    })
                                    nested.ifFalse(() => {
                                        appendNewline(false)
                                        finish()
                                    })
                                })

                                isNewline.ifFalse(() => {
                                    append(take())
                                })
                            })
                        })
                    })
                })
            })

            loop()
        })
    }

    loop()

    (stringQuote >= 0).ifTrue(() => {
        fail()
    })
    (squareDepth != 0).ifTrue(() => {
        fail()
    })
    (braceDepth != 0).ifTrue(() => {
        fail()
    })

    finish()
    result
}

table: (text) => {
    Toml: import("self:TomlSyntax")
    items: statements(text)

    fail: () => {
        Error().signal()
    }

    node: (kind, value) => {
        result: {
            kind: kind
            value: value
        }
        result
    }

    root: node("table", Map())
    states: IdentityMap()
    states.atPut(root, "root")
    current: root

    isSpace: (octet) => {
        result: octet == 32
        (octet == 9).ifTrue(() => {
            result = true
        })
        result
    }

    decodeRange: (source, start, end) => {
        buffer: Encoding.UTF8.encode("")
        position: start

        copy: null
        copy = () => {
            (position < end).ifTrue(() => {
                buffer.add(source.at(position))
                position = position + 1
                copy()
            })
        }

        copy()
        Encoding.UTF8.decode(buffer)
    }

    trimBounds: (source) => {
        left: 0
        right: source.size()

        trimLeft: null
        trimLeft = () => {
            (left < right).ifTrue(() => {
                isSpace(source.at(left)).ifTrue(() => {
                    left = left + 1
                    trimLeft()
                })
            })
        }

        trimRight: null
        trimRight = () => {
            (right > left).ifTrue(() => {
                isSpace(source.at(right - 1)).ifTrue(() => {
                    right = right - 1
                    trimRight()
                })
            })
        }

        trimLeft()
        trimRight()
        {
            left: left
            right: right
        }
    }

    markInlineTable: (valueNode) => {
        (valueNode.kind == "table").ifTrue(() => {
            states.atPut(valueNode, "inline")
        })
    }

    putDotted: null
    putDotted = (tableNode, parts, position, valueNode) => {
        name: parts.at(position)
        last: position == parts.size() - 1
        entries: tableNode.value

        last.ifTrue(() => {
            entries.containsKey(name).ifTrue(() => {
                fail()
            })
            entries.atPut(name, valueNode)
            markInlineTable(valueNode)
        })

        last.ifFalse(() => {
            child: null
            entries.containsKey(name).ifTrue(() => {
                child = entries.at(name)
                (child.kind == "table").ifFalse(() => {
                    fail()
                })
                states.containsKey(child).ifFalse(() => {
                    fail()
                })
                state: states.at(child)
                (state == "header").ifTrue(() => {
                    fail()
                })
                (state == "inline").ifTrue(() => {
                    fail()
                })
                (state == "implicit").ifTrue(() => {
                    states.atPut(child, "dotted")
                })
            })

            entries.containsKey(name).ifFalse(() => {
                child = node("table", Map())
                entries.atPut(name, child)
                states.atPut(child, "dotted")
            })

            putDotted(child, parts, position + 1, valueNode)
        })
    }

    selectHeader: (parts) => {
        selected: root
        position: 0

        walk: null
        walk = () => {
            name: parts.at(position)
            last: position == parts.size() - 1
            entries: selected.value
            child: null

            entries.containsKey(name).ifTrue(() => {
                child = entries.at(name)
                (child.kind == "table").ifFalse(() => {
                    fail()
                })
                states.containsKey(child).ifFalse(() => {
                    fail()
                })
                state: states.at(child)
                (state == "inline").ifTrue(() => {
                    fail()
                })

                last.ifTrue(() => {
                    (state == "implicit").ifTrue(() => {
                        states.atPut(child, "header")
                    })
                    (state == "implicit").ifFalse(() => {
                        fail()
                    })
                })
            })

            entries.containsKey(name).ifFalse(() => {
                child = node("table", Map())
                entries.atPut(name, child)
                last.ifTrue(() => {
                    states.atPut(child, "header")
                })
                last.ifFalse(() => {
                    states.atPut(child, "implicit")
                })
            })

            selected = child
            last.ifFalse(() => {
                position = position + 1
                walk()
            })
        }

        walk()
        selected
    }

    parseHeader: (statement) => {
        source: Encoding.UTF8.encode(statement)
        bounds: trimBounds(source)
        (bounds.left >= bounds.right).ifTrue(() => {
            fail()
        })
        (source.at(bounds.left) == 91).ifFalse(() => {
            fail()
        })
        (source.at(bounds.right - 1) == 93).ifFalse(() => {
            fail()
        })

        // Arrays of tables are assigned to TOOL001-C4B.
        (bounds.left + 1 < bounds.right).ifTrue(() => {
            (source.at(bounds.left + 1) == 91).ifTrue(() => {
                fail()
            })
        })

        keyText: decodeRange(source, bounds.left + 1, bounds.right - 1)
        Toml.keyPath(keyText)
    }

    parseAssignment: (statement) => {
        source: Encoding.UTF8.encode(statement)
        length: source.size()
        position: 0
        quote: -1
        separator: -1

        scan: null
        scan = () => {
            (position < length).ifTrue(() => {
                (separator < 0).ifTrue(() => {
                    octet: source.at(position)
                    inQuote: quote >= 0

                    inQuote.ifTrue(() => {
                        escaped: quote == 34
                        (octet == 92).ifFalse(() => {
                            escaped = false
                        })

                        escaped.ifTrue(() => {
                            position = position + 1
                            (position >= length).ifTrue(() => {
                                fail()
                            })
                            position = position + 1
                        })

                        escaped.ifFalse(() => {
                            (octet == quote).ifTrue(() => {
                                quote = -1
                            })
                            position = position + 1
                        })
                    })

                    inQuote.ifFalse(() => {
                        isQuote: octet == 34
                        (octet == 39).ifTrue(() => {
                            isQuote = true
                        })

                        isQuote.ifTrue(() => {
                            quote = octet
                            position = position + 1
                        })

                        isQuote.ifFalse(() => {
                            isNewline: octet == 10
                            (octet == 13).ifTrue(() => {
                                isNewline = true
                            })
                            isNewline.ifTrue(() => {
                                fail()
                            })

                            (octet == 61).ifTrue(() => {
                                separator = position
                            })
                            position = position + 1
                        })
                    })

                    scan()
                })
            })
        }

        scan()
        (quote >= 0).ifTrue(() => {
            fail()
        })
        (separator < 0).ifTrue(() => {
            fail()
        })

        keyText: decodeRange(source, 0, separator)
        valueText: decodeRange(source, separator + 1, length)
        {
            path: Toml.keyPath(keyText)
            value: Toml.value(valueText)
        }
    }

    processAt: null
    processAt = (position) => {
        (position < items.size()).ifTrue(() => {
            statement: items.at(position)
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            (bounds.left >= bounds.right).ifTrue(() => {
                fail()
            })

            header: source.at(bounds.left) == 91
            header.ifTrue(() => {
                current = selectHeader(parseHeader(statement))
            })

            header.ifFalse(() => {
                assignment: parseAssignment(statement)
                putDotted(current, assignment.path, 0, assignment.value)
            })

            processAt(position + 1)
        })
    }

    processAt(0)
    root
}
