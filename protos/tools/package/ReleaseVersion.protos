// Package ReleaseVersion policy over the Standard Library SemVer value
// (LIB012-C). std:semver/SemVer owns the SemVer 2.0.0 grammar and precedence;
// this module only narrows the accepted domain to
// MAJOR.MINOR.PATCH[-PRERELEASE] (build metadata is rejected) and projects the
// generic value onto the Package record shape consumed by lock rendering and
// the host ExecutionPlanV2 boundary: Integer major/minor/patch, prerelease null
// or an Array of {numeric, number, text} identifiers, and the source text.

SemVer: import("std:semver/SemVer")

parse: (text) => {
    generic: SemVer.parse(text)
    (generic.build.size() > 0).ifTrue(() => {
        fail()
    })

    prerelease: null
    (generic.prerelease.size() > 0).ifTrue(() => {
        // The text is already validated and carries no build metadata, so the
        // prerelease spelling is every octet after the first "-", and its
        // "."-separated pieces are the identifiers in order.
        pieces: Array()
        current: Encoding.UTF8.encode("")
        inPrerelease: false
        Encoding.UTF8.encode(text).each((octet) => {
            inPrerelease.ifTrue(() => {
                (octet == 46).ifTrue(() => {
                    pieces = Array(...pieces, Encoding.UTF8.decode(current))
                    current = Encoding.UTF8.encode("")
                })
                (octet == 46).ifFalse(() => {
                    current.add(octet)
                })
            })
            inPrerelease.ifFalse(() => {
                inPrerelease = octet == 45
            })
        })
        pieces = Array(...pieces, Encoding.UTF8.decode(current))

        prerelease = Array()
        index: 0
        generic.prerelease.each((identifier) => {
            numeric: Integer.recognizes(identifier)
            number: null
            numeric.ifTrue(() => {
                number = identifier
            })
            prerelease = Array(...prerelease, {
                numeric: numeric
                number: number
                text: pieces[index]
            })
            index = index + 1
        })
    })

    {
        major: generic.major
        minor: generic.minor
        patch: generic.patch
        prerelease: prerelease
        text: text
    }
}

// Projects a Package record (including internally built core bounds whose
// text is null) onto the representation SemVer.comparePrecedence requires.
semVerValue: (version) => {
    identifiers: Array()
    (version.prerelease === null).ifFalse(() => {
        version.prerelease.each((identifier) => {
            value: identifier.text
            identifier.numeric.ifTrue(() => {
                value = identifier.number
            })
            identifiers = Array(...identifiers, value)
        })
    })

    {
        major: version.major
        minor: version.minor
        patch: version.patch
        prerelease: identifiers
        build: Array()
    }
}

compare: (left, right) => {
    SemVer.comparePrecedence(semVerValue(left), semVerValue(right))
}

compareText: (leftText, rightText) => {
    compare(parse(leftText), parse(rightText))
}
