Version: import("self:ReleaseVersion")

emptyBytes: () => {
    Encoding.UTF8.encode("")
}

isDigit: (octet) => {
    result: octet >= 48
    if(octet > 57) {
        result = false
    }
    result
}

isLowerAlpha: (octet) => {
    result: octet >= 97
    if(octet > 122) {
        result = false
    }
    result
}

lowerHexValue: (octet) => {
    result: -1

    if(isDigit(octet)) {
        result = octet - 48
    }

    if(result < 0) {
        if(octet >= 97) {
            if(octet <= 102) {
                result = octet - 87
            }
        }
    }

    result
}

hexOctet: (value) => {
    result: 48 + value
    if(value > 9) {
        result = 87 + value
    }
    result
}

appendToken: (tokens, bytes, quoted) => {
    Array(
        ...tokens,
        {
            quoted: quoted
            text: Encoding.UTF8.decode(bytes)
        }
    )
}

lineTokens: (text) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    source: Encoding.UTF8.encode(text)

    // States:
    // 0 = expecting token
    // 1 = bare token
    // 2 = quoted token
    // 3 = quoted escape
    // 4 = quoted \u00xx digits
    // 5 = immediately after quoted token
    state: 0
    tokens: Array()
    current: emptyBytes()
    unicodeRemaining: 0
    unicodeValue: 0

    source.each((octet) => {
        before: state

        if(before == 0) {
            if(octet == 32) {
                fail()
            }
            if(octet < 33) {
                fail()
            }

            if(octet == 34) {
                state = 2
            }
            (octet == 34).ifFalse(() => {
                if(octet > 126) {
                    fail()
                }
                current.add(octet)
                state = 1
            })
        }

        if(before == 1) {
            if(octet == 32) {
                tokens = appendToken(tokens, current, false)
                current = emptyBytes()
                state = 0
            }

            (octet == 32).ifFalse(() => {
                if(octet < 33) {
                    fail()
                }
                if(octet > 126) {
                    fail()
                }
                if(octet == 34) {
                    fail()
                }
                current.add(octet)
            })
        }

        if(before == 2) {
            if(octet == 34) {
                tokens = appendToken(tokens, current, true)
                current = emptyBytes()
                state = 5
            }

            (octet == 34).ifFalse(() => {
                if(octet == 92) {
                    state = 3
                }

                (octet == 92).ifFalse(() => {
                    invalidControl: octet < 32
                    if(octet == 127) {
                        invalidControl = true
                    }
                    if(invalidControl) {
                        fail()
                    }
                    current.add(octet)
                })
            })
        }

        if(before == 3) {
            if(octet == 34) {
                current.add(34)
                state = 2
            }

            (octet == 34).ifFalse(() => {
                if(octet == 92) {
                    current.add(92)
                    state = 2
                }

                (octet == 92).ifFalse(() => {
                    if(octet == 117) {
                        unicodeRemaining = 4
                        unicodeValue = 0
                        state = 4
                    }

                    (octet == 117).ifFalse(() => {
                        fail()
                    })
                })
            })
        }

        if(before == 4) {
            digit: lowerHexValue(octet)
            if(digit < 0) {
                fail()
            }

            unicodeValue = unicodeValue * 16 + digit
            unicodeRemaining = unicodeRemaining - 1

            if(unicodeRemaining == 0) {
                canonicalControl: unicodeValue < 32
                if(unicodeValue == 127) {
                    canonicalControl = true
                }
                canonicalControl.ifFalse(() => {
                    fail()
                })
                current.add(unicodeValue)
                state = 2
            }
        }

        if(before == 5) {
            (octet == 32).ifFalse(() => {
                fail()
            })
            state = 0
        }
    })

    if(state == 1) {
        tokens = appendToken(tokens, current, false)
        state = 6
    }

    if(state == 5) {
        state = 6
    }

    if(state == 0) {
        if(source.size() > 0) {
            fail()
        }
        state = 6
    }

    (state == 6).ifFalse(() => {
        fail()
    })

    tokens
}

parseQstring: (text) => {
    tokens: lineTokens(text)
    (tokens.size() == 1).ifFalse(() => {
        fail()
    })

    token: tokens[0]
    token.quoted.ifFalse(() => {
        fail()
    })

    token.text
}

renderQstring: (text) => {
    source: Encoding.UTF8.encode(text)
    result: emptyBytes()
    result.add(34)

    source.each((octet) => {
        if(octet == 34) {
            result.add(92)
            result.add(34)
        }

        (octet == 34).ifFalse(() => {
            if(octet == 92) {
                result.add(92)
                result.add(92)
            }

            (octet == 92).ifFalse(() => {
                control: octet < 32
                if(octet == 127) {
                    control = true
                }

                if(control) {
                    result.add(92)
                    result.add(117)
                    result.add(48)
                    result.add(48)
                    result.add(hexOctet(octet.div(16)))
                    result.add(hexOctet(octet.mod(16)))
                }

                control.ifFalse(() => {
                    result.add(octet)
                })
            })
        })
    })

    result.add(34)
    Encoding.UTF8.decode(result)
}

parseDecimalToken: (token) => {
    if(token.quoted) {
        fail()
    }

    source: Encoding.UTF8.encode(token.text)
    if(source.size() == 0) {
        fail()
    }

    if(source.size() > 1) {
        if(source[0] == 48) {
            fail()
        }
    }

    value: 0
    source.each((octet) => {
        isDigit(octet).ifFalse(() => {
            fail()
        })
        value = value * 10 + (octet - 48)
    })

    {
        value: value
        text: token.text
    }
}

validateMethodText: (text) => {
    source: Encoding.UTF8.encode(text)
    if(source.size() == 0) {
        fail()
    }

    index: 0
    source.each((octet) => {
        valid: isLowerAlpha(octet)

        if(index > 0) {
            if(isDigit(octet)) {
                valid = true
            }
            if(octet == 45) {
                valid = true
            }
        }

        valid.ifFalse(() => {
            fail()
        })

        index = index + 1
    })

    text
}

parseMethodToken: (token) => {
    if(token.quoted) {
        fail()
    }
    validateMethodText(token.text)
}

parseDigestToken: (token) => {
    if(token.quoted) {
        fail()
    }

    source: Encoding.UTF8.encode(token.text)
    algorithmBytes: emptyBytes()
    hexBytes: emptyBytes()
    inHex: false

    source.each((octet) => {
        if(octet == 58) {
            if(inHex) {
                fail()
            }
            inHex = true
        }

        (octet == 58).ifFalse(() => {
            if(inHex) {
                if(lowerHexValue(octet) < 0) {
                    fail()
                }
                hexBytes.add(octet)
            }

            inHex.ifFalse(() => {
                algorithmBytes.add(octet)
            })
        })
    })

    inHex.ifFalse(() => {
        fail()
    })
    if(algorithmBytes.size() == 0) {
        fail()
    }
    if(hexBytes.size() == 0) {
        fail()
    }

    algorithm: Encoding.UTF8.decode(algorithmBytes)
    validateMethodText(algorithm)

    {
        algorithm: algorithm
        hex: Encoding.UTF8.decode(hexBytes)
        text: token.text
    }
}

bareEquals: (token, expected) => {
    result: false
    token.quoted.ifFalse(() => {
        result = token.text == expected
    })
    result
}

headerLines: (text) => {
    source: Encoding.UTF8.encode(text)
    lines: Array()
    current: emptyBytes()

    source.each((octet) => {
        if(octet == 10) {
            line: ""
            if(current.size() > 0) {
                line = Encoding.UTF8.decode(current)
            }
            lines = Array(...lines, line)
            current = emptyBytes()
        }

        (octet == 10).ifFalse(() => {
            if(octet == 13) {
                fail()
            }
            current.add(octet)
        })
    })

    (current.size() == 0).ifFalse(() => {
        fail()
    })

    (lines.size() == 4).ifFalse(() => {
        fail()
    })

    (lines[3] == "").ifFalse(() => {
        fail()
    })

    lines
}

parseLockFormatLine: (text) => {
    tokens: lineTokens(text)

    (tokens.size() == 2).ifFalse(() => {
        fail()
    })

    keyword: tokens[0]
    if(keyword.quoted) {
        fail()
    }
    (keyword.text == "lock-format").ifFalse(() => {
        fail()
    })

    parsed: parseDecimalToken(tokens[1])
    (parsed.value == 1).ifFalse(() => {
        fail()
    })

    parsed
}

parseResolverVersionLine: (text) => {
    tokens: lineTokens(text)

    (tokens.size() == 2).ifFalse(() => {
        fail()
    })

    keyword: tokens[0]
    if(keyword.quoted) {
        fail()
    }
    (keyword.text == "resolver-version").ifFalse(() => {
        fail()
    })

    parseDecimalToken(tokens[1])
}

parseResolutionInputLine: (text) => {
    tokens: lineTokens(text)

    (tokens.size() == 3).ifFalse(() => {
        fail()
    })

    keyword: tokens[0]
    if(keyword.quoted) {
        fail()
    }
    (keyword.text == "resolution-input").ifFalse(() => {
        fail()
    })

    parsedMethod: parseMethodToken(tokens[1])
    parsedDigest: parseDigestToken(tokens[2])

    {
        method: parsedMethod
        algorithm: parsedDigest.algorithm
        hex: parsedDigest.hex
    }
}

parseHeader: (text) => {
    lines: headerLines(text)

    lockFormatRecord: parseLockFormatLine(lines[0])
    resolverVersionRecord: parseResolverVersionLine(lines[1])
    resolutionInputRecord: parseResolutionInputLine(lines[2])

    lockFormatValue: lockFormatRecord.value
    lockFormatTextValue: lockFormatRecord.text
    resolverVersionValue: resolverVersionRecord.value
    resolverVersionTextValue: resolverVersionRecord.text
    resolutionMethodValue: resolutionInputRecord.method
    digestAlgorithmValue: resolutionInputRecord.algorithm
    digestHexValue: resolutionInputRecord.hex

    {
        lockFormat: lockFormatValue
        lockFormatText: lockFormatTextValue
        resolverVersion: resolverVersionValue
        resolverVersionText: resolverVersionTextValue
        resolutionMethod: resolutionMethodValue
        digestAlgorithm: digestAlgorithmValue
        digestHex: digestHexValue
    }
}

renderHeader: (header) => {
    "lock-format " + header.lockFormatText + "\n" +
    "resolver-version " + header.resolverVersionText + "\n" +
    "resolution-input " + header.resolutionMethod + " " +
    header.digestAlgorithm + ":" + header.digestHex + "\n\n"
}

nodeRefAt: (tokens, start) => {
    if(start >= tokens.size()) {
        fail()
    }

    kindToken: tokens[start]
    if(kindToken.quoted) {
        fail()
    }

    result: null

    if(kindToken.text == "workspace") {
        if((start + 1) >= tokens.size()) {
            fail()
        }

        packageToken: tokens[start + 1]
        packageToken.quoted.ifFalse(() => {
            fail()
        })

        result = {
            ref: {
                kind: "workspace"
                packageId: packageToken.text
            }
            next: start + 2
        }
    }

    if(kindToken.text == "registry") {
        if((start + 2) >= tokens.size()) {
            fail()
        }

        packageToken: tokens[start + 1]
        versionToken: tokens[start + 2]

        packageToken.quoted.ifFalse(() => {
            fail()
        })
        versionToken.quoted.ifFalse(() => {
            fail()
        })

        version: Version.parse(versionToken.text)

        result = {
            ref: {
                kind: "registry"
                packageId: packageToken.text
                version: version
            }
            next: start + 3
        }
    }

    if(kindToken.text == "git") {
        if((start + 2) >= tokens.size()) {
            fail()
        }

        packageToken: tokens[start + 1]
        revisionToken: tokens[start + 2]

        packageToken.quoted.ifFalse(() => {
            fail()
        })
        revisionToken.quoted.ifFalse(() => {
            fail()
        })

        result = {
            ref: {
                kind: "git"
                packageId: packageToken.text
                revision: revisionToken.text
            }
            next: start + 3
        }
    }

    if(result === null) {
        fail()
    }

    result
}

parseNodeRef: (text) => {
    tokens: lineTokens(text)
    parsed: nodeRefAt(tokens, 0)

    (parsed.next == tokens.size()).ifFalse(() => {
        fail()
    })

    parsed.ref
}

renderNodeRef: (ref) => {
    result: null

    if(ref.kind == "workspace") {
        result = "workspace " + renderQstring(ref.packageId)
    }

    if(ref.kind == "registry") {
        result =
            "registry " +
            renderQstring(ref.packageId) + " " +
            renderQstring(ref.version.text)
    }

    if(ref.kind == "git") {
        result =
            "git " +
            renderQstring(ref.packageId) + " " +
            renderQstring(ref.revision)
    }

    if(result === null) {
        fail()
    }

    result
}
