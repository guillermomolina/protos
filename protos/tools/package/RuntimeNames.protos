isAsciiLetter: (octet) => {
    result: false

    if(octet >= 65) {
        if(octet <= 90) {
            result = true
        }
    }

    result.ifFalse(() => {
        if(octet >= 97) {
            if(octet <= 122) {
                result = true
            }
        }
    })

    result
}

isAsciiDigit: (octet) => {
    result: false
    if(octet >= 48) {
        if(octet <= 57) {
            result = true
        }
    }
    result
}

asciiLower: (octet) => {
    result: octet
    if(octet >= 65) {
        if(octet <= 90) {
            result = octet + 32
        }
    }
    result
}

equalsAsciiIgnoreCase: (left, right) => {
    leftBytes: Encoding.UTF8.encode(left)
    rightBytes: Encoding.UTF8.encode(right)
    equal: leftBytes.size() == rightBytes.size()
    index: 0

    leftBytes.each((octet) => {
        if(equal) {
            (asciiLower(octet) == asciiLower(rightBytes[index])).ifFalse(() => {
                equal = false
            })
        }
        index = index + 1
    })

    equal
}

isReserved: (segment) => {
    result: false
    reserved: Array(
        "CON", "PRN", "AUX", "NUL",
        "COM1", "COM2", "COM3", "COM4", "COM5",
        "COM6", "COM7", "COM8", "COM9",
        "LPT1", "LPT2", "LPT3", "LPT4", "LPT5",
        "LPT6", "LPT7", "LPT8", "LPT9"
    )

    reserved.each((name) => {
        if(equalsAsciiIgnoreCase(segment, name)) {
            result = true
        }
    })

    result
}

requireSegment: (segment) => {
    bytes: Encoding.UTF8.encode(segment)
    if(bytes.size() == 0) {
        fail()
    }

    first: true
    bytes.each((octet) => {
        valid: false

        if(first) {
            valid = isAsciiLetter(octet)
        }

        first.ifFalse(() => {
            valid = isAsciiLetter(octet)
            valid.ifFalse(() => {
                valid = isAsciiDigit(octet)
            })
            valid.ifFalse(() => {
                valid = octet == 95
            })
        })

        valid.ifFalse(() => {
            fail()
        })

        first = false
    })

    if(isReserved(segment)) {
        fail()
    }

    segment
}

requireLogicalName: (name) => {
    source: Encoding.UTF8.encode(name)
    if(source.size() == 0) {
        fail()
    }

    current: Encoding.UTF8.encode("")
    source.each((octet) => {
        if(octet == 47) {
            requireSegment(Encoding.UTF8.decode(current))
            current = Encoding.UTF8.encode("")
        }

        (octet == 47).ifFalse(() => {
            current.add(octet)
        })
    })

    requireSegment(Encoding.UTF8.decode(current))
    name
}

requireAlias: (alias) => {
    requireSegment(alias)
}
