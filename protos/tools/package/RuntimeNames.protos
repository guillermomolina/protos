fail: () => {
    Error().signal()
}

isAsciiLetter: (octet) => {
    result: false

    (octet >= 65).ifTrue(() => {
        (octet <= 90).ifTrue(() => {
            result = true
        })
    })

    result.ifFalse(() => {
        (octet >= 97).ifTrue(() => {
            (octet <= 122).ifTrue(() => {
                result = true
            })
        })
    })

    result
}

isAsciiDigit: (octet) => {
    result: false
    (octet >= 48).ifTrue(() => {
        (octet <= 57).ifTrue(() => {
            result = true
        })
    })
    result
}

asciiLower: (octet) => {
    result: octet
    (octet >= 65).ifTrue(() => {
        (octet <= 90).ifTrue(() => {
            result = octet + 32
        })
    })
    result
}

equalsAsciiIgnoreCase: (left, right) => {
    leftBytes: Encoding.UTF8.encode(left)
    rightBytes: Encoding.UTF8.encode(right)
    equal: leftBytes.size() == rightBytes.size()
    index: 0

    leftBytes.each((octet) => {
        equal.ifTrue(() => {
            (asciiLower(octet) == asciiLower(rightBytes[index])).ifFalse(() => {
                equal = false
            })
        })
        index = index + 1
    })

    equal
}

isReserved: (segment) => {
    result: false
    reserved: Array(
        "CON", "PRN", "AUX", "NUL",
        "COM1", "COM2", "COM3", "COM4", "COM5",
        "COM6", "COM7", "COM8", "COM9",
        "LPT1", "LPT2", "LPT3", "LPT4", "LPT5",
        "LPT6", "LPT7", "LPT8", "LPT9"
    )

    reserved.each((name) => {
        equalsAsciiIgnoreCase(segment, name).ifTrue(() => {
            result = true
        })
    })

    result
}

requireSegment: (segment) => {
    bytes: Encoding.UTF8.encode(segment)
    (bytes.size() == 0).ifTrue(() => {
        fail()
    })

    first: true
    bytes.each((octet) => {
        valid: false

        first.ifTrue(() => {
            valid = isAsciiLetter(octet)
        })

        first.ifFalse(() => {
            valid = isAsciiLetter(octet)
            valid.ifFalse(() => {
                valid = isAsciiDigit(octet)
            })
            valid.ifFalse(() => {
                valid = octet == 95
            })
        })

        valid.ifFalse(() => {
            fail()
        })

        first = false
    })

    isReserved(segment).ifTrue(() => {
        fail()
    })

    segment
}

requireLogicalName: (name) => {
    source: Encoding.UTF8.encode(name)
    (source.size() == 0).ifTrue(() => {
        fail()
    })

    current: Encoding.UTF8.encode("")
    source.each((octet) => {
        (octet == 47).ifTrue(() => {
            requireSegment(Encoding.UTF8.decode(current))
            current = Encoding.UTF8.encode("")
        })

        (octet == 47).ifFalse(() => {
            current.add(octet)
        })
    })

    requireSegment(Encoding.UTF8.decode(current))
    name
}

requireAlias: (alias) => {
    requireSegment(alias)
}
